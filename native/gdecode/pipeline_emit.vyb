// G-decode pipeline stage C: generated token ids -> text -> agent-response JSON.
// Reads native/out/gen_tokens.txt (full sequence from the GPU decode_driver)
// and native/out/prompt_ids.txt (the prompt prefix), detokenizes the generated
// tail with the real Qwen3 tokenizer -> response text, emits a summary
// agent-response contract (Vyb auto-serialization), writes
// native/out/contract_pipeline.json, and round-trips it via from_string.
// Run from repo root with --module-path native/gdecode --module-path native/tokenizer.
import io::{open_read, read_all, open_write, write_str, close}
import tokenizer::{decode}
import contract::{doc_mk_response, doc_to_json, Change, AgentResponse}

// Read all integers from a whitespace-delimited file into Vec<Int>.
read_ints(path<String>)<Vec<Int>> -> {
    out<Vec<Int>> = Vec()
    match (open_read(path)) {
        f -> {
            match (read_all(f)) {
                s -> {
                    cur<Int> = 0
                    in_num<Int> = 0
                    i<Int> = 0
                    n<Int> = s.len()
                    while (i < n) {
                        c<Int> = (s.char_at(i) as Int) & 255
                        if (c >= 48) {
                            if (c <= 57) { cur = cur * 10 + (c - 48); in_num = 1 }
                        } else {
                            if (in_num == 1) { out.push(cur) }
                            cur = 0
                            in_num = 0
                        }
                        i = i + 1
                    }
                    if (in_num == 1) { out.push(cur) }
                }
                ? -> { }
            }
            close(f)
        }
        ? -> { }
    }
    return out
}

main()<Int> -> {
    full<Vec<Int>> = read_ints("native/out/gen_tokens.txt")
    promptN<Int> = read_ints("native/out/prompt_ids.txt").len()
    gen<Vec<Int>> = Vec()
    gi<Int> = promptN
    while (gi < full.len()) {
        gen.push(full.get(gi))
        gi = gi + 1
    }
    rtext<String> = ""
    if (gen.len() > 0) { rtext = decode(gen) }

    mf<Vec<String>> = Vec<String>()
    pc<Vec<Change>> = Vec<Change>()
    resp<AgentResponse> = doc_mk_response("summary",
        "VybForge slice decode completed. (Stand-in model output; this is a reviewable desired-state summary, not an applied configuration.) Generated reponse text: " + rtext,
        mf, pc, false)
    js<String> = doc_to_json(resp)
    match (open_write("native/out/contract_pipeline.json")) {
        f -> { match (write_str(f, js)) { q -> { } ? -> { } } close(f) }
        ? -> { return 3 }
    }
    println("CONTRACT_PIPELINE=")
    println(js)
    back<AgentResponse> = AgentResponse::from_string(js)
    if (doc_to_json(back) == js) { println("PIPELINE_ROUNDTRIP_OK") } else { println("PIPELINE_ROUNDTRIP_DIFF") }
    println("DECODED_PROMPT_TOKENS=")
    println_int(promptN)
    println(" GENERATED_TOKENS=")
    println_int(gen.len())
    println(" DECODED_TEXT=<" + rtext + ">")
    return 0
}
