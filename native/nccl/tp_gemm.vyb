// tp_gemm.vyb -- smallest end-to-end slice of tensor parallelism: shard ONE matmul across the pair,
// all-reduce the partial sums, and check the result against the unsharded computation.
//
// This is the pattern every TP layer reuses: row-parallel splits K, each rank computes a partial
// C[M*N], one all-reduce sums them. If this is correct and its cost matches the prediction, extending
// to real layers is repetition rather than new design.
//
// It also answers the question predictions cannot: does TP actually halve the per-layer time at decode?
// At decode the GEMM is bound by the weight matrix (K*N), so halving K halves each node's weight read.
// The prototype measures both paths rather than arguing about them.
//
//   lefty :  RANK=0 WORLD=2 PORT=18430 ...
//   righty:  RANK=1 WORLD=2 PEER_IP=192.168.192.1 PORT=18430 ...
import io
import env
import time
import tensor::{tensor_init, dev_alloc, module_load_path, module_func, bulk_htod, bulk_dtoh, sync, gemm, htod_i, launch1}
import network::{socket_open, socket_bind, socket_listen, socket_accept, socket_connect, socket_send, socket_recv, socket_close}

share(all)
clock_gettime(clk<CInt>, tp<loc<CVoid>>)<CInt>

share(all)
ncclGetUniqueId(uid<String>)<CInt>

share(all)
ncclCommInitRank(comm<loc<Int>>, nranks<Int>, uid<loc<CVoid>>, rank<Int>)<CInt>

share(all)
ncclAllReduce(sendbuff<Int>, recvbuff<Int>, count<Int>, datatype<CInt>, op<CInt>, comm<Int>, stream<Int>)<CInt>

share(all)
ncclCommDestroy(comm<Int>)<CInt>

share(all)
nccl_sum()<CInt> -> { return 0 }

share(all)
nccl_f64()<CInt> -> { return 8 }

gflops_str(M<Int>, N<Int>, K<Int>, us<Int>)<String> -> {
    fl<Float> = 2.0 * (M as Float) * (N as Float) * (K as Float)
    g<Float> = 0.0
    if (us > 0) { g = fl / ((us as Float) / 1000000.0) / 1000000000.0 }
    return g.to_string()
}

// Launch the blocked fp64 GEMM: gemm_blk fills KSPLIT partials per output, gemm_red sums them in fixed
// order. Deterministic by construction (no atomics) and parallel in the reduction dimension, which is
// what M=1 cannot supply. Returns 0 on success.
share(all)
gemm_blocked(hblk<Int>, hred<Int>, params<Int>, AC<Int>, BC<Int>, CC<Int>, P<Int>,
             M<Int>, N<Int>, K<Int>, KSPLIT<Int>, BCOLS<Int>, threads<Int>)<CInt> -> {
    if (htod_i(params + 0, AC) != 0) { return 1 }
    if (htod_i(params + 8, BC) != 0) { return 2 }
    if (htod_i(params + 16, CC) != 0) { return 3 }
    if (htod_i(params + 24, M) != 0) { return 4 }
    if (htod_i(params + 32, N) != 0) { return 5 }
    if (htod_i(params + 40, K) != 0) { return 6 }
    if (htod_i(params + 48, KSPLIT) != 0) { return 7 }
    if (htod_i(params + 56, BCOLS) != 0) { return 8 }
    if (htod_i(params + 64, P) != 0) { return 9 }
    perblock<Int> = threads * BCOLS
    ntiles<Int> = (N + perblock - 1) / perblock
    blocks<Int> = ntiles * KSPLIT
    if (launch1(hblk, blocks, threads, params) != 0) { return 10 }
    total<Int> = M * N
    rblocks<Int> = (total + threads - 1) / threads
    if (launch1(hred, rblocks, threads, params) != 0) { return 11 }
    return 0
}

clock_ns()<Int> -> {
    ts<Vec<Int>> = Vec()
    ts.push(0)
    ts.push(0)
    freedom {
        hdr<loc<Int>> = from<loc<Int>>(addr(ts))
        dp<Int> = at(hdr)
        if (dp != 0) { clock_gettime(1, from<loc<CVoid>>(dp)) }
    }
    return ts.get(0) * 1000000000 + ts.get(1)
}

blanks(n<Int>)<String> -> {
    s<String> = "0123456789"
    while (s.len() < n) { s = s + s }
    return s.substring(0, n)
}

main()<Int> -> {
    rs<String> = env_get("RANK") else "0"
    ws<String> = env_get("WORLD") else "2"
    ps<String> = env_get("PORT") else "18430"
    peer<String> = env_get("PEER_IP") else "192.168.192.1"
    rank<Int> = rs.to_int()
    world<Int> = ws.to_int()
    port<Int> = ps.to_int()

    # Decode-shaped: few tokens, full hidden, an MoE-sized output. B (the weight) dominates the data.
    ms<String> = env_get("M") else "4"
    ks<String> = env_get("K") else "4096"
    ns2<String> = env_get("N") else "1024"
    M<Int> = ms.to_int()
    K<Int> = ks.to_int()
    N<Int> = ns2.to_int()
    KH<Int> = K / world          # this rank's slice of the reduction dimension
    KOFF<Int> = rank * KH

    if (tensor_init() != 0) { println("TPG_FAIL cuda init"); return 1 }
    println("TPG rank=" + rank.to_string() + " M=" + M.to_string() + " K=" + K.to_string()
        + " N=" + N.to_string() + " KH=" + KH.to_string() + " KOFF=" + KOFF.to_string())

    # ---- rendezvous ----
    uid<String> = blanks(128)
    if (rank == 0) {
        grc<Int> = 0
        freedom { grc = (ncclGetUniqueId(uid) as Int) }
        if (grc != 0) { println("TPG_FAIL getuid"); return 2 }
        fd<Int> = socket_open(2, 1, 0) else 0
        o1<Bool> = socket_bind(fd, "0.0.0.0", port) else false
        o2<Bool> = socket_listen(fd, 4) else false
        if (!o1 || !o2) { println("TPG_FAIL bind/listen"); return 3 }
        println("TPG listening")
        c<Int> = socket_accept(fd) else 0
        socket_send(c, uid)
        socket_close(c)
        socket_close(fd)
    } else {
        d<Int> = socket_open(2, 1, 0) else 0
        oc<Bool> = socket_connect(d, peer, port) else false
        if (!oc) { println("TPG_FAIL connect"); return 4 }
        got<String> = socket_recv(d, 256) else ""
        if (got.len() < 128) { println("TPG_FAIL uid"); return 5 }
        uid = got.substring(0, 128)
        socket_close(d)
    }
    comm<Int> = 0
    var<Int> irc = 0
    freedom { irc = (ncclCommInitRank(loc(comm), world, uid, rank) as Int) }
    if (irc != 0) { println("TPG_FAIL commInitRank rc=" + irc.to_string()); return 6 }

    # ---- deterministic data, IDENTICAL on both ranks (so the reference is comparable) ----
    # A: M*K, B: K*N, both small-magnitude integers so f64 sums are well conditioned.
    Av<Vec<Float>> = Vec()
    ai<Int> = 0
    while (ai < M * K) { Av.push(((ai % 7) - 3) as Float) ; ai = ai + 1 }
    Bv<Vec<Float>> = Vec()
    bi<Int> = 0
    while (bi < K * N) { Bv.push(((bi % 5) - 2) as Float) ; bi = bi + 1 }

    dA<Int> = dev_alloc(M * K * 8)
    dB<Int> = dev_alloc(K * N * 8)
    dC<Int> = dev_alloc(M * N * 8)
    dPart<Int> = dev_alloc(M * N * 8)
    dScr<Int> = dev_alloc(64)
    if (dA == 0 || dB == 0 || dC == 0 || dPart == 0 || dScr == 0) { println("TPG_FAIL alloc"); return 7 }
    if (bulk_htod(dA, view(Av)) != 0) { println("TPG_FAIL htod A"); return 8 }
    if (bulk_htod(dB, view(Bv)) != 0) { println("TPG_FAIL htod B"); return 9 }
    sync()

    fgemm<Int> = module_load_path("native/build/gemm.ptx")
    hgemm<Int> = module_func(fgemm, "gemm")
    if (hgemm == 0) { println("TPG_FAIL kernel"); return 10 }

    # ---- reference: full C = A @ B on one rank ----
    if (gemm(hgemm, dScr, dA, dB, dC, M, N, K, 1.0, 0.0) != 0) { println("TPG_FAIL gemm ref"); return 11 }
    sync()
    refv<Vec<Float>> = bulk_dtoh(dC, M * N)

    # ---- tensor-parallel: each rank computes A[:, KOFF..KOFF+KH) @ B[KOFF.., :] ----
    # A's column slice is strided in row-major, so gather it host-side; B's row slice is contiguous.
    Ah<Vec<Float>> = Vec()
    r0<Int> = 0
    while (r0 < M) {
        c0<Int> = 0
        while (c0 < KH) { Ah.push(Av.get(r0 * K + KOFF + c0)) ; c0 = c0 + 1 }
        r0 = r0 + 1
    }
    Bh<Vec<Float>> = Vec()
    b0<Int> = 0
    while (b0 < KH * N) { Bh.push(Bv.get(KOFF * N + b0)) ; b0 = b0 + 1 }

    dAh<Int> = dev_alloc(M * KH * 8)
    dBh<Int> = dev_alloc(KH * N * 8)
    if (dAh == 0 || dBh == 0) { println("TPG_FAIL alloc half"); return 12 }
    if (bulk_htod(dAh, view(Ah)) != 0) { println("TPG_FAIL htod Ah"); return 13 }
    if (bulk_htod(dBh, view(Bh)) != 0) { println("TPG_FAIL htod Bh"); return 14 }
    sync()

    t0<Int> = clock_ns()
    if (gemm(hgemm, dScr, dAh, dBh, dPart, M, N, KH, 1.0, 0.0) != 0) { println("TPG_FAIL gemm half"); return 15 }
    sync()
    t1<Int> = clock_ns()

    # DIAGNOSTIC (keep): dump this rank's OWN partial before any communication. If the halves are right
    # and the sum is wrong the fault is in comms; if a half is wrong it is the gather/offset arithmetic.
    partv<Vec<Float>> = bulk_dtoh(dPart, M * N)
    println("TPG_PARTIAL rank=" + rank.to_string() + " KOFF=" + KOFF.to_string()
        + " p0=" + partv.get(0).to_string() + " p1=" + partv.get(1).to_string()
        + " pn=" + partv.get(N - 1).to_string())

    # SIX IDENTICAL COLLECTIVES, probing after each. The defect under investigation: the first
    # all-reduce returned the correct sum (4) and a second identical call returned rank 0's input alone
    # (6). A loop shows whether that is "second call always", a one-off, or intermittent -- and whether
    # the wrong value is always rank 0's.
    var<Int> arc = 0
    ci2<Int> = 0
    tw0<Int> = clock_ns()
    while (ci2 < 6) {
        tc0<Int> = clock_ns()
        freedom { arc = (ncclAllReduce(dPart, dC, M * N, nccl_f64(), nccl_sum(), comm, 0) as Int) }
        sync()
        tc1<Int> = clock_ns()
        if (arc != 0) { println("TPG_FAIL collective rc=" + arc.to_string()); return 16 }
        pv<Vec<Float>> = bulk_dtoh(dC, M * N)
        pinv<Vec<Float>> = bulk_dtoh(dPart, M * N)
        println("TPG_COLL rank=" + rank.to_string() + " i=" + ci2.to_string()
            + " out0=" + pv.get(0).to_string() + " in0=" + pinv.get(0).to_string()
            + " us=" + ((tc1 - tc0) / 1000).to_string())
        ci2 = ci2 + 1
    }
    t2<Int> = clock_ns()

    # and time an EMPTY gemm launch to isolate the parameter-packing overhead from the arithmetic
    tp0<Int> = clock_ns()
    # NOTE: this writes to its OWN 8-byte buffer. It used to target dC, which silently overwrote
    # result element 0 with A[0]*B[0] (= 6) after the collectives and before the readback -- the source
    # of the "inconsistent collective" scare. At K=4096 the corrupted value happened to equal the correct
    # sum, so the bug hid; at K=8192 they differ and it showed.
    dTiny<Int> = dev_alloc(8)
    if (dTiny == 0) { println("TPG_FAIL tiny alloc"); return 18 }
    if (gemm(hgemm, dScr, dA, dB, dTiny, 1, 1, 1, 1.0, 0.0) != 0) { println("TPG_FAIL gemm tiny"); return 18 }
    sync()
    tp1<Int> = clock_ns()

    got<Vec<Float>> = bulk_dtoh(dC, M * N)

    # ---- compare: FP sum order differs (two partials vs one reduction), so this is a tolerance test,
    # not a bit-exact one -- and it is stated as such rather than pretended otherwise.
    maxabs<Float> = 0.0
    maxrel<Float> = 0.0
    i<Int> = 0
    while (i < M * N) {
        d<Float> = got.get(i) - refv.get(i)
        if (d < 0.0) { d = 0.0 - d }
        if (d > maxabs) { maxabs = d }
        a<Float> = refv.get(i)
        if (a < 0.0) { a = 0.0 - a }
        if (a > 0.0) {
            rr<Float> = d / a
            if (rr > maxrel) { maxrel = rr }
        }
        i = i + 1
    }

    gemm_us<Int> = (t1 - t0) / 1000
    comm_us<Int> = (t2 - tw0) / 1000
    pack_us<Int> = (tp1 - tp0) / 1000
    if (maxrel < 0.000000001) { println("TPG_TOLERANCE_OK") } else { println("TPG_TOLERANCE_FAIL") }

    # BATCHED LAUNCH TEST -- the number that decides the next fix.
    # Ten launches back-to-back with ONE sync at the end. If the per-call cost collapses, the ~550 us is
    # launch/serialisation overhead and the fix is fewer or batched launches (or a captured graph). If it
    # stays ~550 us, each kernel genuinely takes that long (a latency chain) and the fix is a blocked
    # kernel. Same work, same shape, only the sync pattern differs.
    NB<Int> = 10
    tb0<Int> = clock_ns()
    bi2<Int> = 0
    while (bi2 < NB) {
        if (gemm(hgemm, dScr, dA, dB, dC, M, N, KH, 1.0, 0.0) != 0) { println("TPG_FAIL batch gemm"); return 19 }
        bi2 = bi2 + 1
    }
    sync()
    tb1<Int> = clock_ns()
    batch_us<Int> = (tb1 - tb0) / 1000
    percall_us<Int> = batch_us / NB

    # ---- blocked kernel: phase 1 (KSPLIT partials) + phase 2 (fixed-order reduce) ----
    fblk<Int> = module_load_path("native/build/gemm_blk.ptx")
    hblk<Int> = module_func(fblk, "gemm_blk")
    hred<Int> = module_func(fblk, "gemm_red")
    if (hblk == 0 || hred == 0) { println("TPG_FAIL blocked kernel"); return 20 }

    KSPLIT<Int> = 32
    BCOLS<Int> = 4
    TH<Int> = 256
    dP<Int> = dev_alloc(M * N * KSPLIT * 8)
    dPar<Int> = dev_alloc(72)
    dCB<Int> = dev_alloc(M * N * 8)
    if (dP == 0 || dPar == 0 || dCB == 0) { println("TPG_FAIL blocked alloc"); return 21 }

    if (gemm_blocked(hblk, hred, dPar, dA, dB, dCB, dP, M, N, K, KSPLIT, BCOLS, TH) != 0) {
        println("TPG_FAIL blocked launch"); return 22
    }
    sync()
    gotB<Vec<Float>> = bulk_dtoh(dCB, M * N)

    # compare the blocked result against the unblocked reference (different summation order, so tolerance)
    maxB<Float> = 0.0
    maxRelB<Float> = 0.0
    ib<Int> = 0
    while (ib < M * N) {
        db<Float> = gotB.get(ib) - refv.get(ib)
        if (db < 0.0) { db = 0.0 - db }
        if (db > maxB) { maxB = db }
        ab<Float> = refv.get(ib)
        if (ab < 0.0) { ab = 0.0 - ab }
        if (ab > 0.0) {
            rb<Float> = db / ab
            if (rb > maxRelB) { maxRelB = rb }
        }
        ib = ib + 1
    }

    tb3<Int> = clock_ns()
    if (gemm_blocked(hblk, hred, dPar, dA, dB, dCB, dP, M, N, K, KSPLIT, BCOLS, TH) != 0) {
        println("TPG_FAIL blocked timed"); return 23
    }
    sync()
    tb4<Int> = clock_ns()
    blk_us<Int> = (tb4 - tb3) / 1000

    gflops_blk<String> = gflops_str(M, N, K, blk_us)
    println("TPG_BLOCKED KSPLIT=" + KSPLIT.to_string() + " BCOLS=" + BCOLS.to_string()
        + " us=" + blk_us.to_string() + " gflops=" + gflops_blk
        + " maxabs=" + maxB.to_string() + " maxrel=" + maxRelB.to_string())

    println("TPG_RESULT rank=" + rank.to_string()
        + " gemm_us=" + gemm_us.to_string() + " comm_us=" + comm_us.to_string()
        + " pack_us=" + pack_us.to_string()
        + " gflops=" + gflops_str(M, N, KH, gemm_us)
        + " batch10_us=" + batch_us.to_string() + " percall_us=" + percall_us.to_string()
        + " maxabs=" + maxabs.to_string() + " maxrel=" + maxrel.to_string()
        + " ref0=" + refv.get(0).to_string() + " got0=" + got.get(0).to_string())

    # tolerance: values are O(1e3..1e4) sums of small integers, so f64 error should be ~1e-10 relative



    freedom { ncclCommDestroy(comm) }
    return 0
}
