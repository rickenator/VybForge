# json_emit.vyb — Python-`json.dumps`-compatible emission of a parsed JsonDoc.
#
# json_parse gives us the parsed tree; this module turns a node back into text
# with the exact shapes CPython's json module produces, so a Vyb port can write
# the same bytes as the Python original it replaces:
#
#   json_text_py(d, nid)     -> json.dumps(v)                      {"a": 1, "b": [2, 3]}
#   json_text_tight(d, nid)  -> json.dumps(v, separators=(",", ":"))
#   json_pretty(d, nid)      -> json.dumps(v, indent=2)
#
# Escaping is json.dumps's rule with its default ensure_ascii=True: `"` `\`
# and the control characters (short forms \b \f \n \r \t, else \u00XX), and
# every non-ASCII codepoint as \uXXXX (astral codepoints as a surrogate pair).
#
# Known deviation, inherited from json_parse's storage: numbers are kept as
# Float, so a literal that Python reads as a float but prints non-trivially
# differs — `1e3` -> Vyb "1000", CPython "1000.0"; `3.0` -> Vyb "3", CPython
# "3.0". Whole plain integer literals (`3`, `-7`) agree.
#
#   import json_emit::{json_text_py, json_text_tight, json_pretty, json_escape_py}
import json_parse::{JsonDoc}

# ---- escaping ----

share(all)
hex_digit(v<Int>)<String> -> {
    digits<String> = "0123456789abcdef"
    return digits.substring(v, v + 1)
}

# \uXXXX for a BMP codepoint (the caller handles astral pairs).
share(all)
hex4(cp<Int>)<String> -> {
    return hex_digit((cp >> 12) & 15) + hex_digit((cp >> 8) & 15) +
           hex_digit((cp >> 4) & 15) + hex_digit(cp & 15)
}

share(all)
json_escape_py(s<String>)<String> -> {
    out<String> = ""
    i<Int> = 0
    n<Int> = s.len()
    while (i < n) {
        b<Int> = (s.char_at(i) as Int) & 255
        if (b < 128) {
            if (b == 34) { out = out + "\\\"" }
            else if (b == 92) { out = out + "\\\\" }
            else if (b == 8) { out = out + "\\b" }
            else if (b == 12) { out = out + "\\f" }
            else if (b == 10) { out = out + "\\n" }
            else if (b == 13) { out = out + "\\r" }
            else if (b == 9) { out = out + "\\t" }
            else if (b < 32) { out = out + "\\u00" + hex_digit((b >> 4) & 15) + hex_digit(b & 15) }
            else { out = out + s.substring(i, i + 1) }
            i = i + 1
        } else {
            span<Int> = utf8_span(b)
            cp<Int> = utf8_cp(s, i, span)
            if (cp < 0x10000) {
                out = out + "\\u" + hex4(cp)
            } else {
                e<Int> = cp - 0x10000
                out = out + "\\u" + hex4(0xD800 + (e >> 10)) + "\\u" + hex4(0xDC00 + (e & 1023))
            }
            i = i + span
        }
    }
    return out
}

# Continuation-byte count for a UTF-8 lead byte (invalid leads are treated as a
# single byte and re-encoded as U+FFFD by utf8_cp).
share(all)
utf8_span(b0<Int>)<Int> -> {
    if (b0 >= 240) { return 4 }
    if (b0 >= 224) { return 3 }
    if (b0 >= 192) { return 2 }
    return 1
}

share(all)
cont_byte(s<String>, i<Int>)<Int> -> {
    if (i >= s.len()) { return 0 }
    return (s.char_at(i) as Int) & 63
}

share(all)
utf8_cp(s<String>, i<Int>, span<Int>)<Int> -> {
    b0<Int> = (s.char_at(i) as Int) & 255
    if (span == 1) { return 0xFFFD }
    if (span == 2) { return ((b0 & 31) << 6) | cont_byte(s, i + 1) }
    if (span == 3) { return ((b0 & 15) << 12) | (cont_byte(s, i + 1) << 6) | cont_byte(s, i + 2) }
    return ((b0 & 7) << 18) | (cont_byte(s, i + 1) << 12) | (cont_byte(s, i + 2) << 6) | cont_byte(s, i + 3)
}

# ---- emission ----

share(all)
indent_of(level<Int>)<String> -> {
    out<String> = ""
    i<Int> = 0
    for (i in 0..level - 1) { out = out + "  " }
    return out
}

# Numbers come through the parser's own text form (see the header note).
share(all)
json_num_text(d<JsonDoc>, nid<Int>)<String> -> {
    return d.hstr(nid)
}

# The one recursive emitter. pretty=false is the compact json.dumps shape
# (`, ` / `: `); pretty=true is indent=2 (`,\n` + two spaces per level).
share(all)
emit_value(d<JsonDoc>, nid<Int>, pretty<Bool>, level<Int>)<String> -> {
    k<String> = d.kind(nid)
    if (k == "string") { return "\"" + json_escape_py(d.hstr(nid)) + "\"" }
    if (k == "number") { return json_num_text(d, nid) }
    if (k == "true") { return "true" }
    if (k == "false") { return "false" }
    if (k == "null") { return "null" }
    if (k == "array") { return emit_array(d, nid, pretty, level) }
    if (k == "object") { return emit_object(d, nid, pretty, level) }
    return "null"
}

share(all)
emit_array(d<JsonDoc>, nid<Int>, pretty<Bool>, level<Int>)<String> -> {
    cnt<Int> = d.len(nid)
    if (cnt == 0) { return "[]" }
    out<String> = "["
    i<Int> = 0
    for (i in 0..cnt - 1) {
        if (i > 0) {
            if (pretty) { out = out + "," } else { out = out + ", " }
        }
        if (pretty) { out = out + "\n" + indent_of(level + 1) }
        out = out + emit_value(d, d.elem(nid, i), pretty, level + 1)
    }
    if (pretty) { out = out + "\n" + indent_of(level) }
    return out + "]"
}

share(all)
emit_object(d<JsonDoc>, nid<Int>, pretty<Bool>, level<Int>)<String> -> {
    ks<Vec<String>> = d.keys(nid)
    cnt<Int> = ks.len()
    if (cnt == 0) { return "{}" }
    out<String> = "{"
    j<Int> = 0
    for (j in 0..cnt - 1) {
        key<String> = ks.get(j)
        if (j > 0) {
            if (pretty) { out = out + "," } else { out = out + ", " }
        }
        if (pretty) { out = out + "\n" + indent_of(level + 1) }
        out = out + "\"" + json_escape_py(key) + "\": " + emit_value(d, d.get(nid, key), pretty, level + 1)
    }
    if (pretty) { out = out + "\n" + indent_of(level) }
    return out + "}"
}

share(all)
json_text_py(d<JsonDoc>, nid<Int>)<String> -> {
    return emit_value(d, nid, false, 0)
}

share(all)
json_text_tight(d<JsonDoc>, nid<Int>)<String> -> {
    return emit_tight(d, nid)
}

# Tight form: `,` / `:` with no spaces — json.dumps(separators=(",", ":")).
share(all)
emit_tight(d<JsonDoc>, nid<Int>)<String> -> {
    k<String> = d.kind(nid)
    if (k == "string") { return "\"" + json_escape_py(d.hstr(nid)) + "\"" }
    if (k == "number") { return json_num_text(d, nid) }
    if (k == "true") { return "true" }
    if (k == "false") { return "false" }
    if (k == "null") { return "null" }
    if (k == "array") {
        cnt<Int> = d.len(nid)
        out<String> = "["
        i<Int> = 0
        for (i in 0..cnt - 1) {
            if (i > 0) { out = out + "," }
            out = out + emit_tight(d, d.elem(nid, i))
        }
        return out + "]"
    }
    ks<Vec<String>> = d.keys(nid)
    cnt2<Int> = ks.len()
    out2<String> = "{"
    j<Int> = 0
    for (j in 0..cnt2 - 1) {
        if (j > 0) { out2 = out2 + "," }
        out2 = out2 + "\"" + json_escape_py(ks.get(j)) + "\":" + emit_tight(d, d.get(nid, ks.get(j)))
    }
    return out2 + "}"
}

share(all)
json_pretty(d<JsonDoc>, nid<Int>)<String> -> {
    return emit_value(d, nid, true, 0)
}
