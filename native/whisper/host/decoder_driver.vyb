// decoder_driver.vyb — the Whisper decoder on the GPU, stage by stage.
//
//   ./build.sh decoder            # all decoder stages
//   WHISPER_STAGES=d_embed ./build.sh decoder
//
// Decoder differences from the encoder, all of which the same kernels cover:
//   * self-attention is CAUSAL (attn's `causal` param word)
//   * there is a second attention block whose K/V come from the encoder's final
//     output (the same `attn` entry point, different pointers)
//   * the output projection is TIED to the token embedding (transformers'
//     state_dict has proj_out.weight, the file does not) so there is one table,
//     used twice: once as a gather for the input, once as the transposed head
// Prompt for an English-only model: <|startoftranscript|>, <|notimestamps|>.
import tensor::{tensor_init, module_load_path, module_func, dev_alloc, dev_free,
                htod, htod_i, htod_vec, dtoh, dtoh_i, sync, launch1}
import safetensors::{st_open, st_find, StIndex}
import io::{open_read, read_at, close}
import env::{env_get}

extern "C" {
    cuMemcpyHtoDAsync_v2(dstDevice<Int>, srcHost<CString>, ByteCount<Int>, hStream<Int>)<CInt>
}

D<Int> = 384                // model width
HEADS<Int> = 6
HDIM<Int> = 64
DEC_LAYERS<Int> = 4
FFN<Int> = 1536
VOCAB<Int> = 51864
MAXPOS<Int> = 448
CL<Int> = 2                 // prompt length (start-of-transcript, no-timestamps)
EOT<Int> = 50256

// Chunked loader for the token table. At 51864 x 384 f32 the checkpoint tensor is
// 79.7 MB: reading it into ONE Vyb String and DMAing it in one call is a lot to
// hold at once, so it is widened in ~2M-element pieces (10 of them) and written
// straight into its place in the 159 MB f64 device table.
CHUNK_ELEMS<Int> = 2000000

env(n<String>, d<String>)<String> -> {
    return env_get(n) else d
}

want(name<String>)<Bool> -> {
    list<String> = env("WHISPER_STAGES", "")
    if (list == "") { return true }
    parts<Vec<String>> = list.split(",")
    i<Int> = 0
    for (i in 0..parts.len() - 1) {
        if (parts.get(i) == name) { return true }
    }
    return false
}

bulk(data<String>, dst<Int>, nbytes<Int>)<Int> -> {
    freedom {
        if (cuMemcpyHtoDAsync_v2(dst, data, nbytes, 0) != 0) { return 15 }
    }
    sync()
    return 0
}

pi(pp<Int>, off<Int>, v<Int>)<Int> -> {
    return htod_i(pp + off, v)
}

// Widen + transpose `name` (f32, torch layout (Rows, Cols)) into dOut as f64
// (Cols, Rows). mode 2 of reorder_w. Returns 0 on success.
widen_t(ckpt<String>, ix<StIndex>, name<String>, Rows<Int>, Cols<Int>, dOut<Int>,
        RAW<Int>, ford<Int>, PK<Int>)<Int> -> {
    idx<Int> = st_find(ix, name)
    if (idx < 0) {
        println("MISSING tensor " + name)
        return 1
    }
    nbytes<Int> = ix.dlen.get(idx)
    absoff<Int> = ix.data_base + ix.doff.get(idx)
    data<String> = ""
    match (open_read(ckpt)) {
        f -> {
            match (read_at(f, absoff, nbytes)) {
                s -> { data = s }
                ? -> { }
            }
            close(f)
        }
        ? -> { }
    }
    if (data.len() < nbytes) {
        println("SHORT read " + name)
        return 2
    }
    if (bulk(data, RAW, nbytes) != 0) {
        println("DMA failed " + name)
        return 3
    }
    if (pi(PK, 0, RAW) != 0 || pi(PK, 8, dOut) != 0 || pi(PK, 16, Rows * Cols) != 0 ||
        pi(PK, 24, Rows) != 0 || pi(PK, 32, Cols) != 0 || pi(PK, 40, 2) != 0) { return 4 }
    if (launch1(ford, (Rows * Cols + 255) / 256, 256, PK) != 0) { return 5 }
    sync()
    return 0
}

// Widen `name` (f32, no reorder) into dOut as f64, in pieces. mode 0.
widen_chunked(ckpt<String>, ix<StIndex>, name<String>, N<Int>, dOut<Int>, RAW<Int>,
              ford<Int>, PK<Int>)<Int> -> {
    idx<Int> = st_find(ix, name)
    if (idx < 0) {
        println("MISSING tensor " + name)
        return 1
    }
    absoff<Int> = ix.data_base + ix.doff.get(idx)
    done<Int> = 0
    while (done < N) {
        want<Int> = N - done
        if (want > CHUNK_ELEMS) { want = CHUNK_ELEMS }
        nb<Int> = want * 4
        data<String> = ""
        match (open_read(ckpt)) {
            h -> {
                match (read_at(h, absoff + done * 4, nb)) {
                    s -> { data = s }
                    ? -> { }
                }
                close(h)
            }
            ? -> { }
        }
        if (data.len() < nb) {
            println("SHORT chunk read")
            return 2
        }
        if (bulk(data, RAW, nb) != 0) { return 3 }
        if (pi(PK, 0, RAW) != 0 || pi(PK, 8, dOut + done * 8) != 0 || pi(PK, 16, want) != 0 ||
            pi(PK, 40, 0) != 0) { return 4 }
        if (launch1(ford, (want + 255) / 256, 256, PK) != 0) { return 5 }
        sync()
        done = done + want
    }
    return 0
}

section(name<String>, base<Int>, n<Int>)<Int> -> {
    println("SECTION " + name + " n=")
    println_int(n)
    i<Int> = 0
    for (i in 0..n - 1) {
        println_int((dtoh(base + i * 8) * 1000000.0) as Int)
    }
    return 0
}

main()<Int> -> {
    println("DEC_STAGES begin")
    if (tensor_init() != 0) { println("tensor_init failed"); return 1 }

    henc<Int> = module_load_path(env("WHISPER_ENC_PTX", "native/whisper/build/whisper_enc.ptx"))
    hgemm<Int> = module_load_path(env("WHISPER_GEMM_PTX", "native/build/gemm.ptx"))
    if (henc == 0 || hgemm == 0) { println("cannot load PTX modules"); return 2 }
    femb<Int> = module_func(henc, "embed")
    ford<Int> = module_func(henc, "reorder_w")
    fadd2<Int> = module_func(henc, "add2")
    fgemm<Int> = module_func(hgemm, "gemm")
    if (femb == 0 || ford == 0 || fadd2 == 0 || fgemm == 0) { println("missing kernel"); return 3 }

    PG<Int> = dev_alloc(128)
    PK<Int> = dev_alloc(128)
    DTOK<Int> = dev_alloc(VOCAB * D * 8)          # token table f64 (159 MB)
    DPOS<Int> = dev_alloc(MAXPOS * D * 8)
    DIDS<Int> = dev_alloc(CL * 8)
    DXC<Int> = dev_alloc(CL * D * 8)              # layer input
    DADD<Int> = dev_alloc(CL * D * 8)
    RAW<Int> = dev_alloc(CHUNK_ELEMS * 4 + 65536)
    if (DTOK == 0 || DPOS == 0 || DIDS == 0 || DXC == 0 || DADD == 0 || RAW == 0) {
        println("device alloc failed")
        return 4
    }

    ckpt<String> = env("VYBFORGE_ST_FILE", "/usr/export/LLM/hf/hub/models--openai--whisper-tiny.en/snapshots/87c7102498dcde7456f24cfd30239ca606ed9063/model.safetensors")
    ix<StIndex> = st_open(ckpt)
    if (ix.n <= 0) { println("cannot read checkpoint index"); return 5 }

    # ---- token table (also the tied output head) -----------------------------
    e<Int> = widen_chunked(ckpt, ix, "model.decoder.embed_tokens.weight", VOCAB * D, DTOK, RAW, ford, PK)
    if (e != 0) { println("token table widen failed"); println_int(e); return 6 }
    e = widen_chunked(ckpt, ix, "model.decoder.embed_positions.weight", MAXPOS * D, DPOS, RAW, ford, PK)
    if (e != 0) { println("decoder positions widen failed"); println_int(e); return 7 }

    # ---- prompt: <|startoftranscript|>, <|notimestamps|> ---------------------
    if (htod_i(DIDS + 0, 50257) != 0) { println("id upload failed"); return 8 }
    if (htod_i(DIDS + 8, 50362) != 0) { println("id upload failed"); return 9 }

    if (pi(PK, 0, DTOK) != 0 || pi(PK, 8, DIDS) != 0 || pi(PK, 16, DXC) != 0 ||
        pi(PK, 24, CL) != 0 || pi(PK, 32, D) != 0) {
        println("params pack failed (embed)"); return 10
    }
    if (launch1(femb, (CL * D + 255) / 256, 256, PK) != 0) { println("launch embed failed"); return 11 }
    sync()

    # + decoder positional embedding (elementwise, not a bias add)
    if (pi(PK, 0, DXC) != 0 || pi(PK, 8, DPOS) != 0 || pi(PK, 16, DADD) != 0 || pi(PK, 24, CL * D) != 0) {
        println("params pack failed (pos)"); return 12
    }
    if (launch1(fadd2, (CL * D + 255) / 256, 256, PK) != 0) { println("launch pos add failed"); return 13 }
    sync()
    if (want("d_embed")) { section("d_embed", DADD, CL * D) }

    println("DEC_STAGES done")
    return 0
}
