// p6r12_bfgemm — validate bfgemm_p on a REAL BF16 attention tensor.
//
// Uses layers.3.self_attn.indexer.wk.weight [128, 4096] BF16 (1 MB) — a real
// checkpoint tensor, small enough that the host can hold it and compute a
// reference dot product for a slice of outputs.
//
// Method: upload the BF16 bytes, convert with the EXISTING bf16deq32 kernel to
// get exact f32 values on the host, compute the reference by hand for M=2 rows
// and N=16 outputs over the full K=4096, then compare against bfgemm_p with
// KSP=1 (one split, so the partial buffer IS the result).
// env: P6_DIR
import io::{open_read, read_all, close}
import env::{env_get}
import tensor::{tensor_init, dev_alloc, bulk_htod, bulk_dtoh, sync}
import gx::{gx_read}
import glm_engine::{load_fn, mapdev_build, gx_resolve_tab, launch_kernel, wr_pdev}

main()<Int> -> {
    dir<String> = env_get("P6_DIR") else "/srv/models/hf/hub/models--Mia-AiLab--GLM-5.3-Flash-EXL3-4bpw-TensorFold/snapshots/078455ffe6472f9a52fbc1139f58b9db2881b25c"
    if (tensor_init() != 0) { println("BFG_FAIL cuda"); return 1 }
    fp<Int> = load_fn("native/build/bfgemm.ptx", "bfgemm_p")
    fdq<Int> = load_fn("native/build/bf16.ptx", "bf16deq32")
    finvk<Int> = load_fn("native/build/exl3.ptx", "exl3inv")
    if (fp == 0 || fdq == 0) { println("BFG_FAIL fn p=" + fp.to_string() + " dq=" + fdq.to_string()); return 2 }

    # tab cache (layer 3's table)
    cs<String> = ""
    match (open_read("native/out/gx_tabs.cache")) {
        f -> { match (read_all(f)) { s -> { cs = s } ? -> { return 3 } } close(f) }
        ? -> { println("BFG_FAIL tabcache"); return 3 }
    }
    nl0<Int> = find_from(cs, "\n", 0)
    pos<Int> = nl0 + 1
    tab3<String> = ""
    var<Int> ti = 0
    while (ti < 45) {
        nl<Int> = find_from(cs, "\n", pos)
        if (nl < 0) { println("BFG_FAIL trunc"); return 3 }
        plen<Int> = cs.substring(pos, nl).to_int()
        if (ti == 3) { tab3 = cs.substring(nl + 1, nl + 1 + plen) }
        pos = nl + 1 + plen
        ti = ti + 1
    }

    # try candidate attention tensors until one RESOLVES (found == 1). gx_read
    # returns a correctly-SIZED all-zero buffer when the name is not in the tab,
    # which is indistinguishable from a real zero tensor -- so assert found.
    cand<Vec<String>> = Vec()
    cand.push("model.language_model.layers.3.self_attn.kv_a_proj_with_mqa.weight")
    cand.push("model.language_model.layers.3.self_attn.q_a_proj.weight")
    cand.push("model.language_model.layers.3.self_attn.indexer.wk.weight")
    g0<String> = ""
    var<Int> N = 0
    var<Int> K = 0
    var<Int> ci = 0
    while (ci < cand.len() && g0.len() == 0) {
        w1<Vec<String>> = Vec()
        w1.push(cand.get(ci))
        ge<GxLoc> = gx_resolve_tab(tab3, dir, 83, w1)
        fnd<Int> = ge.found.get(0)
        fsz<Int> = gx_read(ge, 0).len()
        println("BFG try " + cand.get(ci) + " found=" + fnd.to_string() + " bytes=" + fsz.to_string())
        if (fnd == 1 && fsz > 0) {
            # shape from the byte count: BF16 [N][K] with K = 4096 for these
            K = 4096
            N = fsz / 2 / K
            g0 = gx_read(ge, 0)
            println("BFG using N=" + N.to_string() + " K=" + K.to_string())
        }
        ci = ci + 1
    }
    if (g0.len() == 0) { println("BFG_FAIL no attention tensor resolved"); return 4 }

    # ---- device: BF16 copy, and its exact f32 conversion for the reference ----
    dB<Int> = dev_alloc(N * K * 2)
    dF<Int> = dev_alloc(N * K * 4)
    if (dB == 0 || dF == 0) { println("BFG_FAIL alloc"); return 5 }
    cuMemcpyHtoD_v2(dB, g0, N * K * 2)
    sync()
    pbc<Int> = dev_alloc(64)
    wr_pdev(pbc, 0, dB)
    wr_pdev(pbc, 8, dF)
    wr_pdev(pbc, 16, N * K)
    wr_pdev(pbc, 24, 0)
    launch_kernel(fdq, (N * K + 255) / 256, pbc)
    sync()
    WF<Vec<Float>> = bulk_dtoh(dF, N * K)
    println("BFG converted " + (N * K).to_string() + " values; w[0][0]=" + WF.get(0).to_string_precise() + " w[1][1]=" + WF.get(K + 1).to_string_precise())

    # ---- activations M=2, and the host reference ----
    var<Int> M = 2
    xv<Vec<Float>> = Vec()
    var<Int> i = 0
    while (i < M * K) { xv.push(((i % 11) as Float) * 0.0625 - 0.25) ; i = i + 1 }
    dA<Int> = dev_alloc(M * K * 4)
    bulk_htod(dA, view(xv))
    dS<Int> = dev_alloc(M * N * 4)
    pbg<Int> = dev_alloc(96)
    wr_pdev(pbg, 0, dA)
    wr_pdev(pbg, 8, dB)
    wr_pdev(pbg, 16, dS)
    wr_pdev(pbg, 24, M)
    wr_pdev(pbg, 32, N)
    wr_pdev(pbg, 40, K)
    wr_pdev(pbg, 56, 1)
    wr_pdev(pbg, 64, 1)     # TRANSP: the file is [N][K]
    launch_kernel(fp, 1, pbg)
    sync()
    OF<Vec<Float>> = bulk_dtoh(dS, M * N)

    # reference for the first 16 outputs of both rows
    NREFL<Int> = 64
    if (NREFL > N) { NREFL = N }
    var<Int> nbad = 0
    var<Float> mx = 0.0
    var<Int> m = 0
    while (m < M) {
        var<Int> n = 0
        while (n < NREFL) {
            s<Float> = 0.0
            var<Int> k = 0
            while (k < K) {
                s = s + xv.get(m * K + k) * WF.get(n * K + k)
                k = k + 1
            }
            dv<Float> = OF.get(m * N + n) - s
            adv<Float> = dv
            if (adv < 0.0) { adv = 0.0 - adv }
            if (adv > mx) { mx = adv }
            if (adv > 1e-4) { nbad = nbad + 1 }
            n = n + 1
        }
        m = m + 1
    }
    println("BFG_GATE count_over_1e-4=" + nbad.to_string() + " max_abs=" + mx.to_string_precise() + " of " + (M * NREFL).to_string())
    println("BFG o[0]=" + OF.get(0).to_string_precise())
    println("BFG_DONE")
    return 0
}

zero_bytes(n<Int>)<String> -> {
    s<String> = ""
    k<Int> = 0
    while (k < n) { s = s + " " ; k = k + 1 }
    return s
}

find_from(s<String>, needle<String>, start<Int>)<Int> -> {
    n<Int> = s.len()
    m<Int> = needle.len()
    i<Int> = start
    while (i <= n - m) {
        ok<Int> = 1
        j<Int> = 0
        while (j < m) {
            if (s.char_at(i + j) != needle.char_at(j)) { ok = 0 ; j = m }
            j = j + 1
        }
        if (ok == 1) { return i }
        i = i + 1
    }
    return 0 - 1
}
