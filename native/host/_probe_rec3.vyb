// Non-recursive sanity: Vec<simple struct>
struct Leaf {
    tag<Int>,
    sval<String>
}
struct Wrap {
    kids<Vec<Leaf>>
}
main()<Int> -> {
    w<Wrap> = Wrap { kids = Vec() }
    l<Leaf> = Leaf { tag = 3, sval = "x" }
    w.kids.push(l)
    println_int(w.kids.len())
    println(w.kids.get(0).sval)
    return 0
}
