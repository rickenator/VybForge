import io::{open_read, read_all, close}
main()<Int> -> {
    println("hello vyb")
    match (open_read("config/default-state.json")) {
        f -> {
            match (read_all(f)) {
                s -> { println(s) }
                ? -> { println("read failed") }
            }
            close(f)
        }
        ? -> { println("open failed") }
    }
    return 0
}
