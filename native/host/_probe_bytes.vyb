// Probe: build a String from a fixed byte array + String::from_bytes.
// Try addr(arr[0]) and other address expressions.
main()<Int> -> {
    # fixed array of i8
    arr<[:]><i8> = new ([:])<i8>(8)
    arr[0] = 104  # 'h'
    arr[1] = 101  # 'e'
    arr[2] = 108  # 'l'
    arr[3] = 108  # 'l'
    arr[4] = 111  # 'o'

    s<String> = String::from_bytes(addr(arr[0]), 5)
    println(s)

    # try from an Int array too
    a2<[:\0x10]><Int> = new ([:])<Int>(8)
    a2[0] = 119  # 'w'
    a2[1] = 111  # 'o'
    a2[2] = 114  # 'r'
    a2[3] = 108  # 'l'
    a2[4] = 100  # 'd'
    s2<String> = String::from_bytes(addr(a2[0]), 5)
    println(s2)
    return 0
}
