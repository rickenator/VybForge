# glm_l3_hc_check.vyb — the join driver's only new code, isolated: the ATTENTION-site
# hyper-connection mix and apply for layer 3, from raw streams0.
#
#   flat = rms_rows(streams0) -> mv = flat @ hc_attn_fn^T
#   hc_glue(mv, hc_attn_base, hc_attn_scale) -> collapsed / postA / combA
#   h_a       = rms_rows(collapsed, input_layernorm.weight)
#   streams1  = hc_apply(streams0, y_attn, postA, combA)
#
# `y_attn` comes in as a file (the gated attention output) so this check measures ONLY the
# hc mix/apply — the full-layer driver showed streams1 1.3e-3 off the gold while every
# attention stage matched at 1e-11, so the defect is in here.
#
# Run: make -f native/Makefile glm3hc
import io::{open_read, read_at, read_all, open_write, write_str, close}
import env::{env_get}
import safetensors
import gx
import tensor::{tensor_init, dev_alloc, htod_vec, dtoh_vec, sync, gemm}
import vmath::{vexp, vsqrt}

extern "C" {
    cuMemFree_v2(dptr<Int>)<CInt>
    cuMemAlloc_v2(dptr<loc<Int>>, bytesize<Int>)<CInt>
    cuMemcpyHtoD_v2(dstDevice<Int>, srcHost<loc<CVoid>>, ByteCount<Int>)<CInt>
    cuCtxSynchronize()<CInt>
    cuModuleLoadData(hmod<loc<loc<CVoid>>>, image<CString>)<CInt>
    cuModuleGetFunction(hfunc<loc<loc<CVoid>>>, hmod<loc<CVoid>>, name<CString>)<CInt>
    cuda_launch4i(f<loc<CVoid>>, gridX<CUInt>, gridY<CUInt>, gridZ<CUInt>,
                  blockX<CUInt>, blockY<CUInt>, blockZ<CUInt>,
                  a0<Int>, a1<Int>, a2<Int>, a3<Int>)<CInt>
}

R<Int> = 22
H<Int> = 4096
HC<Int> = 4
EPS<Float> = 1e-5
HC_EPS<Float> = 1e-6
SCALE40<Float> = 1099511627776.0

di(v<Float>)<Int> -> {
    return (v * SCALE40) as Int
}

sigmoid(x<Float>)<Float> -> {
    return 1.0 / (1.0 + vexp(0.0 - x))
}

digest(name<String>, v<Vec<Float>>)<String> -> {
    s<Float> = 0.0
    a<Float> = 0.0
    q<Float> = 0.0
    m<Float> = 0.0
    i<Int> = 0
    while (i < v.len()) {
        x<Float> = v.get(i)
        s = s + x
        if (x < 0.0) { a = a - x } else { a = a + x }
        q = q + x * x
        t<Float> = x
        if (t < 0.0) { t = 0.0 - t }
        if (t > m) { m = t }
        i = i + 1
    }
    out<String> = name + " n=" + v.len().to_string() + " sum=" + di(s).to_string() +
                  " abs=" + di(a).to_string() + " sq=" + di(q).to_string() +
                  " max=" + di(m).to_string()
    i = 0
    while (i < 8) {
        hv<Float> = 0.0
        if (i < v.len()) { hv = v.get(i) }
        out = out + " v" + i.to_string() + "=" + di(hv).to_string()
        i = i + 1
    }
    return out
}

rms_rows(x<Vec<Float>>, rows<Int>, D<Int>, w<Vec<Float>>)<Vec<Float>> -> {
    dst<Vec<Float>> = Vec()
    r<Int> = 0
    i<Int> = 0
    while (r < rows) {
        ss<Float> = 0.0
        i = 0
        base<Int> = r * D
        while (i < D) {
            v<Float> = x.get(base + i)
            ss = ss + v * v
            i = i + 1
        }
        inv<Float> = 1.0 / vsqrt(ss / (D as Float) + EPS, 40)
        i = 0
        while (i < D) {
            vv<Float> = x.get(base + i) * inv
            if (w.len() == D) { vv = vv * w.get(i) }
            dst.push(vv)
            i = i + 1
        }
        r = r + 1
    }
    return dst
}

f32_at(raw<String>, idx<Int>)<Float> -> {
    w<Int> = 0
    b<Int> = 0
    while (b < 4) {
        c<Int> = (raw.char_at(idx * 4 + b) as Int) & 255
        w = w | (c << (b * 8))
        b = b + 1
    }
    sign<Float> = 1.0
    if ((w & 2147483648) != 0) { sign = 0.0 - 1.0 }
    ex<Int> = (w >> 23) & 255
    man<Int> = w & 8388607
    v<Float> = 0.0
    if (ex > 0) {
        den<Float> = 1.0 + (man as Float) / 8388608.0
        p2<Float> = 1.0
        e2<Int> = 0
        while (e2 < (ex - 127)) {
            p2 = p2 * 2.0
            e2 = e2 + 1
        }
        while (e2 > (ex - 127)) {
            p2 = p2 / 2.0
            e2 = e2 - 1
        }
        v = sign * den * p2
    }
    return v
}

# ============================================================ device plumbing helpers

alloc_dev(n<Int>)<Int> -> {
    var<Int> p = 0
    freedom {
        if (cuMemAlloc_v2(loc(p), n) != 0) { return 0 }
    }
    return p
}

free_dev(p<Int>)<Int> -> {
    if (p == 0) { return 0 }
    freedom {
        cuMemFree_v2(p)
    }
    return 0
}

deq_bf16(faddr<Int>, raw<String>, n<Int>, z<Int>)<Int> -> {
    var<Int> out = 0
    freedom {
        var<Int> q = 0
        var<Int> o = 0
        if (cuMemAlloc_v2(loc(q), raw.len()) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(o), n * 8) != 0) { return 0 }
        if (cuMemcpyHtoD_v2(q, raw, raw.len()) != 0) { return 0 }
        blocks<Int> = (n + 255) / 256
        if (cuda_launch4i(from<loc<CVoid>>(faddr), blocks, 1, 1, 256, 1, 1, q, o, n, z) != 0) {
            return 0
        }
        cuCtxSynchronize()
        cuMemFree_v2(q)
        out = o
    }
    return out
}

# load a PTX file into a module and return the named function's address as an Int

load_fn(ptx_path<String>, fn_name<String>)<Int> -> {
    ptx<String> = ""
    match (open_read(ptx_path)) {
        f -> { match (read_all(f)) { s -> { ptx = s } ? -> { return 0 } } close(f) }
        ? -> { return 0 }
    }
    var<Int> addr_out = 0
    freedom {
        var<loc<loc<CVoid>>> m = from<loc<loc<CVoid>>>(0)
        if (cuModuleLoadData(loc(m), ptx) != 0) { return 0 }
        var<loc<CVoid>> f = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(f), m, fn_name) != 0) { return 0 }
        addr_out = addr(f)
    }
    return addr_out
}

# hyper-connection mix: streams [R,HC,H] + the [R,24] gemm result -> collapsed/post/comb.
# `res` packs collapsed [R*H], then post [R*HC], then comb [R*HC*HC].

hc_glue(mv<Vec<Float>>, base<Vec<Float>>, scale<Vec<Float>>, streams<Vec<Float>>)<Vec<Float>> -> {
    pre<Vec<Float>> = Vec()
    post<Vec<Float>> = Vec()
    comb<Vec<Float>> = Vec()
    r<Int> = 0
    j<Int> = 0
    n0<Int> = 0
    a<Int> = 0
    b<Int> = 0
    mx<Float> = 0.0
    sm<Float> = 0.0
    it<Int> = 0
    h<Int> = 0
    d<Int> = 0
    p<Float> = 0.0
    v<Float> = 0.0
    n1<Int> = 0
    while (r < R) {
        j = 0
        while (j < HC) {
            pre.push(sigmoid(mv.get(r * 24 + j) * scale.get(0) + base.get(j)) + HC_EPS)
            post.push(2.0 * sigmoid(mv.get(r * 24 + HC + j) * scale.get(1) + base.get(HC + j)))
            j = j + 1
        }
        r = r + 1
    }
    n0 = 0
    while (n0 < R * HC * HC) {
        comb.push(0.0)
        n0 = n0 + 1
    }
    r = 0
    while (r < R) {
        a = 0
        while (a < HC) {
            b = 0
            while (b < HC) {
                comb.set((r * HC + a) * HC + b,
                         mv.get(r * 24 + 2 * HC + a * HC + b) * scale.get(2) +
                         base.get(2 * HC + a * HC + b))
                b = b + 1
            }
            a = a + 1
        }
        r = r + 1
    }
    r = 0
    while (r < R) {
        a = 0
        while (a < HC) {
            # per-ROW max, like gold's softmax(axis=-1, keepdims): a global max underflows
            # the smaller entries of a row whose logits sit far below the global peak, which
            # then differ by whole multiples after the eps floor.
            mx = 0.0 - 1e30
            b<Int> = 0
            while (b < HC) {
                v = comb.get((r * HC + a) * HC + b)
                if (v > mx) { mx = v }
                b = b + 1
            }
            sm = 0.0
            b = 0
            while (b < HC) {
                sm = sm + vexp(comb.get((r * HC + a) * HC + b) - mx)
                b = b + 1
            }
            b = 0
            while (b < HC) {
                comb.set((r * HC + a) * HC + b,
                         vexp(comb.get((r * HC + a) * HC + b) - mx) / sm)
                b = b + 1
            }
            a = a + 1
        }
        a = 0
        while (a < HC) {
            b = 0
            while (b < HC) {
                comb.set((r * HC + a) * HC + b, comb.get((r * HC + a) * HC + b) + HC_EPS)
                b = b + 1
            }
            a = a + 1
        }
        b = 0
        while (b < HC) {
            sm = 0.0
            a = 0
            while (a < HC) {
                sm = sm + comb.get((r * HC + a) * HC + b)
                a = a + 1
            }
            a = 0
            while (a < HC) {
                comb.set((r * HC + a) * HC + b, comb.get((r * HC + a) * HC + b) / (sm + HC_EPS))
                a = a + 1
            }
            b = b + 1
        }
        it = 1
        # gold: softmax -> colsum -> (sinkhorn_iters-1) x {rowsum, colsum}. One colsum pass
        # already happened above and `it` starts at 1, so < 20 is exactly 19 pairs.
        while (it < 20) {
            a = 0
            while (a < HC) {
                sm = 0.0
                b = 0
                while (b < HC) {
                    sm = sm + comb.get((r * HC + a) * HC + b)
                    b = b + 1
                }
                b = 0
                while (b < HC) {
                    comb.set((r * HC + a) * HC + b, comb.get((r * HC + a) * HC + b) / (sm + HC_EPS))
                    b = b + 1
                }
                a = a + 1
            }
            b = 0
            while (b < HC) {
                sm = 0.0
                a = 0
                while (a < HC) {
                    sm = sm + comb.get((r * HC + a) * HC + b)
                    a = a + 1
                }
                a = 0
                while (a < HC) {
                    comb.set((r * HC + a) * HC + b, comb.get((r * HC + a) * HC + b) / (sm + HC_EPS))
                    a = a + 1
                }
                b = b + 1
            }
            it = it + 1
        }
        r = r + 1
    }
    col<Vec<Float>> = Vec()
    n1 = 0
    while (n1 < R * H) {
        col.push(0.0)
        n1 = n1 + 1
    }
    r = 0
    while (r < R) {
        h = 0
        while (h < HC) {
            p = pre.get(r * HC + h)
            d = 0
            while (d < H) {
                col.set(r * H + d, col.get(r * H + d) + p * streams.get((r * HC + h) * H + d))
                d = d + 1
            }
            h = h + 1
        }
        r = r + 1
    }
    res<Vec<Float>> = Vec()
    n1 = 0
    while (n1 < col.len()) {
        res.push(col.get(n1))
        n1 = n1 + 1
    }
    n1 = 0
    while (n1 < post.len()) {
        res.push(post.get(n1))
        n1 = n1 + 1
    }
    n1 = 0
    while (n1 < comb.len()) {
        res.push(comb.get(n1))
        n1 = n1 + 1
    }
    return res
}

hc_apply(streams<Vec<Float>>, y<Vec<Float>>, post<Vec<Float>>, comb<Vec<Float>>)<Vec<Float>> -> {
    dst<Vec<Float>> = Vec()
    r<Int> = 0
    h<Int> = 0
    d<Int> = 0
    j<Int> = 0
    n<Int> = 0
    while (n < R * HC * H) {
        dst.push(0.0)
        n = n + 1
    }
    while (r < R) {
        h = 0
        while (h < HC) {
            d = 0
            while (d < H) {
                acc<Float> = post.get(r * HC + h) * y.get(r * H + d)
                j = 0
                while (j < HC) {
                    acc = acc + comb.get((r * HC + j) * HC + h) * streams.get((r * HC + j) * H + d)
                    j = j + 1
                }
                dst.set((r * HC + h) * H + d, acc)
                d = d + 1
            }
            h = h + 1
        }
        r = r + 1
    }
    return dst
}

exl3_deq(fdeq<Int>, fhgen<Int>, fhad1<Int>, fhad2<Int>,
         trellis<String>, suh<String>, svh<String>, body<String>,
         cw<Int>, ntiles<Int>)<Int> -> {
    tb<Int> = 0
    kn<Int> = 0
    krows<Int> = 0
    nbc<Int> = 0
    nblocks<Int> = 0
    mb<Int> = 0
    hwide<Int> = 0
    bq<Int> = 0
    u<Int> = 0
    ch<Int> = 0
    b<Int> = 0
    pq<Int> = 0
    chq<Int> = 0
    var<Int> out = 0
    tb = trellis.len()
    if (tb < ntiles * 128) { return 0 }
    kn = (ntiles / (cw / 16)) * 16 * cw
    krows = kn / cw
    if ((suh.len() % 8) != 0 || (svh.len() % 8) != 0) { return 0 }
    if (suh.len() != krows * 2 || svh.len() != cw * 2) { return 0 }
    nbc = cw / 128
    nblocks = (kn / cw / 128) * nbc
    mb = 16 + body.len()
    freedom {
        var<Int> qd = 0
        var<Int> td = 0
        var<Int> od = 0
        var<Int> hd = 0
        var<Int> td2 = 0
        var<Int> fd = 0
        var<Int> pd = 0
        var<Int> sud = 0
        var<Int> svd = 0
        if (cuMemAlloc_v2(loc(qd), tb) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(td), mb) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(od), kn * 8) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(hd), 128 * 128 * 8) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(td2), kn * 8) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(fd), kn * 8) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(pd), 64) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(sud), krows * 2) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(svd), cw * 2) != 0) { return 0 }

        # trellis: bulk copy straight from the String
        if (cuMemcpyHtoD_v2(qd, trellis, tb) != 0) { return 0 }
        # map: 16-byte header + the 256-slot body
        var<CInt> rc = 0
        hwide = 0
        bq = 0
        while (bq < 8) {
            hwide = hwide | (((cw >> (bq * 8)) & 255) << (bq * 8))
            bq = bq + 1
        }
        if (cuMemcpyHtoD_v2(td, loc(hwide), 8) != 0) { return 0 }
        hwide = 0
        bq = 0
        while (bq < 8) {
            hwide = hwide | (((ntiles >> (bq * 8)) & 255) << (bq * 8))
            bq = bq + 1
        }
        if (cuMemcpyHtoD_v2(td + 8, loc(hwide), 8) != 0) { return 0 }
        u = 0
        while (u < body.len()) {
            ch = 0
            b = 0
            while (b < 8) {
                ch = ch | ((((body.char_at(u + b) as Int) & 255)) << (b * 8))
                b = b + 1
            }
            if (cuMemcpyHtoD_v2(td + 16 + u, loc(ch), 8) != 0) { return 0 }
            u = u + 8
        }
        # dequant
        if (cuda_launch4i(from<loc<CVoid>>(fdeq), ntiles, 1, 1, 256, 1, 1, qd, td, od, 0) != 0) {
            return 0
        }
        cuCtxSynchronize()
        cuMemFree_v2(qd)
        cuMemFree_v2(td)
        # scales (fp16) to the device
        u = 0
        while (u < suh.len()) {
            ch = 0
            b = 0
            while (b < 8) {
                ch = ch | ((((suh.char_at(u + b) as Int) & 255)) << (b * 8))
                b = b + 1
            }
            if (cuMemcpyHtoD_v2(sud + u, loc(ch), 8) != 0) { return 0 }
            u = u + 8
        }
        u = 0
        while (u < svh.len()) {
            ch = 0
            b = 0
            while (b < 8) {
                ch = ch | ((((svh.char_at(u + b) as Int) & 255)) << (b * 8))
                b = b + 1
            }
            if (cuMemcpyHtoD_v2(svd + u, loc(ch), 8) != 0) { return 0 }
            u = u + 8
        }
        # hgen: H at pd+0
        if (cuMemcpyHtoD_v2(pd + 0, loc(hd), 8) != 0) { return 0 }
        if (cuda_launch4i(from<loc<CVoid>>(fhgen), 64, 1, 1, 256, 1, 1, pd, 0, 0, 0) != 0) {
            return 0
        }
        cuCtxSynchronize()
        # had1: what=od, tmp=td2, H=hd, cw, nbc, nblocks
        pq = 0
        while (pq < 6) {
            chq = 0
            if (pq == 0) { chq = od }
            if (pq == 1) { chq = td2 }
            if (pq == 2) { chq = hd }
            if (pq == 3) { chq = cw }
            if (pq == 4) { chq = nbc }
            if (pq == 5) { chq = nblocks }
            if (cuMemcpyHtoD_v2(pd + pq * 8, loc(chq), 8) != 0) { return 0 }
            pq = pq + 1
        }
        if (cuda_launch4i(from<loc<CVoid>>(fhad1), nblocks * 64, 1, 1, 256, 1, 1, pd, 0, 0, 0) != 0) {
            return 0
        }
        cuCtxSynchronize()
        # had2: tmp=td2, out=fd, H=hd, suh, svh, cw, nbc, nblocks
        pq = 0
        while (pq < 8) {
            chq = 0
            if (pq == 0) { chq = td2 }
            if (pq == 1) { chq = fd }
            if (pq == 2) { chq = hd }
            if (pq == 3) { chq = sud }
            if (pq == 4) { chq = svd }
            if (pq == 5) { chq = cw }
            if (pq == 6) { chq = nbc }
            if (pq == 7) { chq = nblocks }
            if (cuMemcpyHtoD_v2(pd + pq * 8, loc(chq), 8) != 0) { return 0 }
            pq = pq + 1
        }
        if (cuda_launch4i(from<loc<CVoid>>(fhad2), nblocks * 64, 1, 1, 256, 1, 1, pd, 0, 0, 0) != 0) {
            return 0
        }
        cuCtxSynchronize()
        cuMemFree_v2(od)
        cuMemFree_v2(hd)
        cuMemFree_v2(td2)
        cuMemFree_v2(pd)
        cuMemFree_v2(sud)
        cuMemFree_v2(svd)
        out = fd
    }
    return out
}

mm_dev(A<Int>, B<Int>, M<Int>, N<Int>, K<Int>, faddr<Int>)<Int> -> {
    var<Int> C = 0
    var<Int> scr = 0
    C = alloc_dev(M * N * 8)
    scr = alloc_dev(64)
    if (C == 0 || scr == 0) { return 0 }
    if (gemm(faddr, scr, A, B, C, M, N, K, 1.0, 0.0) != 0) { return 0 }
    sync()
    free_dev(scr)
    return C
}


mm_host(x<Vec<Float>>, rows<Int>, K<Int>, B<Int>, N<Int>, faddr<Int>)<Vec<Float>> -> {
    out<Vec<Float>> = Vec()
    var<Int> dA = 0
    dA = alloc_dev(rows * K * 8)
    if (dA == 0) { return out }
    htod_vec(dA, x)
    var<Int> dC = 0
    dC = mm_dev(dA, B, rows, N, K, faddr)
    free_dev(dA)
    if (dC == 0) { return out }
    out = dtoh_vec(dC, rows * N)
    free_dev(dC)
    return out
}

# GLM's log-decay gate: g = sigmoid((f + dt_bias) * exp(A_log)) * (-5), per (head, k-channel)

main()<Int> -> {
    dir<String> = env_get("VYBFORGE_GX_DIR") else "/mnt/apex/rick/vybforge/glm53-checkpoint"
    out<String> = env_get("VYBFORGE_HC_OUT") else "native/out/l3hc_vyb.txt"
    pre<String> = "model.language_model.layers.3."
    total = 83
    i = 0
    j = 0
    fgemm = 0
    fbf = 0
    d_fnA = 0
    d_flat = 0
    d_mv = 0
    d_scr = 0
    t = ""
    cur = ""
    ch = ""

    if (tensor_init() != 0) { println("HC_FAIL no cuda"); return 3 }

    # streams0
    match (open_read("native/out/gold_l3_streams0.txt")) {
        f -> { match (read_all(f)) { s -> { t = s } ? -> { return 6 } } close(f) }
        ? -> { println("HC_FAIL no streams0"); return 6 }
    }
    streams0<Vec<Float>> = Vec()
    i = 0
    while (i <= t.len()) {
        ch = ""
        if (i < t.len()) { ch = t.substring(i, i + 1) }
        if (i == t.len() || ch == " " || ch == "\n") {
            if (cur.len() > 0) {
                streams0.push((cur.to_int() as Float) / SCALE40)
                cur = ""
            }
        } else { cur = cur + ch }
        i = i + 1
    }
    # y_attn
    t = ""
    cur = ""
    match (open_read("native/out/gold_l3_attn.txt")) {
        f -> { match (read_all(f)) { s -> { t = s } ? -> { return 7 } } close(f) }
        ? -> { println("HC_FAIL no attn text"); return 7 }
    }
    yattn<Vec<Float>> = Vec()
    i = 0
    while (i <= t.len()) {
        ch = ""
        if (i < t.len()) { ch = t.substring(i, i + 1) }
        if (i == t.len() || ch == " " || ch == "\n") {
            if (cur.len() > 0) {
                yattn.push((cur.to_int() as Float) / SCALE40)
                cur = ""
            }
        } else { cur = cur + ch }
        i = i + 1
    }
    if (streams0.len() != R * HC * H || yattn.len() != R * H) {
        println("HC_FAIL sizes " + streams0.len().to_string() + " " + yattn.len().to_string())
        return 8
    }

    w<Vec<String>> = Vec()
    w.push(pre + "hc_attn_fn")
    w.push(pre + "hc_attn_base")
    w.push(pre + "hc_attn_scale")
    w.push(pre + "input_layernorm.weight")
    g<GxLoc> = gx_resolve(dir, total, w)
    fbf = load_fn("native/build/bf16.ptx", "bf16deq")
    fgemm = load_fn("native/build/gemm.ptx", "gemm")
    if (fbf == 0 || fgemm == 0) { return 9 }

    d_fnA = deq_bf16(fbf, gx_read(g, 0), 24 * HC * H, HC * H)
    baseA<Vec<Float>> = Vec()
    raw_baseA = gx_read(g, 1)
    j = 0
    while (j < 24) {
        baseA.push(f32_at(raw_baseA, j))
        j = j + 1
    }
    scaleA<Vec<Float>> = Vec()
    raw_scaleA = gx_read(g, 2)
    j = 0
    while (j < 3) {
        scaleA.push(f32_at(raw_scaleA, j))
        j = j + 1
    }
    d_lnA = deq_bf16(fbf, gx_read(g, 3), H, 0)
    in_ln<Vec<Float>> = dtoh_vec(d_lnA, H)

    flat<Vec<Float>> = rms_rows(streams0, R, HC * H, Vec())
    d_flat = alloc_dev(R * HC * H * 8)
    d_mv = alloc_dev(R * 24 * 8)
    d_scr = alloc_dev(64)
    htod_vec(d_flat, flat)
    if (gemm(fgemm, d_scr, d_flat, d_fnA, d_mv, R, 24, HC * H, 1.0, 0.0) != 0) { return 10 }
    sync()
    mv<Vec<Float>> = dtoh_vec(d_mv, R * 24)
    free_dev(d_flat)
    free_dev(d_mv)
    free_dev(d_scr)
    free_dev(d_fnA)

    # dump mv (scaled ints) so the gold side can be diffed element-wise
    mvline<String> = ""
    i = 0
    while (i < mv.len()) {
        mvline = mvline + di(mv.get(i)).to_string() + " "
        i = i + 1
    }
    match (open_write("native/out/l3hc_mv_vyb.txt")) {
        f -> { write_str(f, mvline); close(f) }
        ? -> { return 12 }
    }

    res<Vec<Float>> = hc_glue(mv, baseA, scaleA, streams0)
    collapsed<Vec<Float>> = Vec()
    i = 0
    while (i < R * H) {
        collapsed.push(res.get(i))
        i = i + 1
    }
    postA<Vec<Float>> = Vec()
    i = 0
    while (i < R * HC) {
        postA.push(res.get(R * H + i))
        i = i + 1
    }
    combA<Vec<Float>> = Vec()
    i = 0
    while (i < R * HC * HC) {
        combA.push(res.get(R * H + R * HC + i))
        i = i + 1
    }
    h_a<Vec<Float>> = rms_rows(collapsed, R, H, in_ln)
    streams1<Vec<Float>> = hc_apply(streams0, yattn, postA, combA)

    lines<String> = digest("mv", mv) + "\n" + digest("collapsed", collapsed) + "\n" +
                    digest("postA", postA) + "\n" + digest("combA", combA) + "\n" +
                    digest("h_a", h_a) + "\n" + digest("streams1", streams1) + "\n"
    println(digest("h_a", h_a))
    println(digest("streams1", streams1))
    match (open_write(out)) {
        f -> { write_str(f, lines); close(f) }
        ? -> { return 11 }
    }
    println("HC_OK")
    return 0
}
