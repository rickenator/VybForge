# probe11: the module-global write/read semantics across the boundaries
import probe11mod::{inc, getcount, setval, getval, inc2, inc3, inc4, flagtest, getflag}

gk1<Int> = 0
gl1<Int> = 0

gval<Int> = 0

bump()<Int> -> {
    gval = gval + 1
    return gval
}

getg()<Int> -> {
    return gval
}

main()<Int> -> {
    # A: the module fn increments its own module global; the module getter reads it
    a1<Int> = inc()
    a2<Int> = inc()
    a3<Int> = getcount()
    println("A inc,inc,get: " + a1.to_string() + "," + a2.to_string() + "," + a3.to_string())
    # B: main re-reads the module global via the getter after the incs
    println("B get again: " + getcount().to_string())
    # C: the module fn writes mval via setval; the module getter reads it
    c1<Int> = setval(42)
    c2<Int> = getval()
    println("C set,get: " + c1.to_string() + "," + c2.to_string())
    # D: the main-file fn increments the MAIN's module global; the main-file getter reads it
    d1<Int> = bump()
    d2<Int> = bump()
    d3<Int> = getg()
    println("D bump,bump,getg: " + d1.to_string() + "," + d2.to_string() + "," + d3.to_string())
    # E: main assigns the MAIN's module global directly, then the getter reads it
    gval = 99
    println("E direct-assign then getg: " + getg().to_string())
    # F: main assigns the IMPORTED module global, then the module getter reads it
    mval = 77
    println("F import-assign then getval: " + getval().to_string())
    # G: the nested multi-line if-block assignment in the module fn
    g1<Int> = inc2()
    println("G inc2: " + g1.to_string())
    # H: the nested one-liner if-block assignment
    h1<Int> = inc3()
    println("H inc3: " + h1.to_string())
    # I: the nested while-block assignment
    i1<Int> = inc4()
    println("I inc4: " + i1.to_string())
    # J: the final getter state
    println("J final: " + getcount().to_string())
    # K: the inc calls at the DEEP nesting (8 levels of while)
    w1<Int> = 0
    while (w1 < 1) {
     w2<Int> = 0
     while (w2 < 1) {
      w3<Int> = 0
      while (w3 < 1) {
       w4<Int> = 0
       while (w4 < 1) {
        w5<Int> = 0
        while (w5 < 1) {
         w6<Int> = 0
         while (w6 < 1) {
          w7<Int> = 0
          while (w7 < 1) {
           w8<Int> = 0
           while (w8 < 1) {
            gk1 = inc()
            w8 = 1
           }
           w7 = 1
          }
          w6 = 1
         }
         w5 = 1
        }
        w4 = 1
       }
       w3 = 1
      }
      w2 = 1
     }
     w1 = 1
    }
    println("K deep inc: " + gk1.to_string())
    println("K get after: " + getcount().to_string())
    # L: the inc calls at the deep nesting with the params'd fn
    m1<Int> = 0
    while (m1 < 1) {
     m2<Int> = 0
     while (m2 < 1) {
      m3<Int> = 0
      while (m3 < 1) {
       m4<Int> = 0
       while (m4 < 1) {
        m5<Int> = 0
        while (m5 < 1) {
         m6<Int> = 0
         while (m6 < 1) {
          m7<Int> = 0
          while (m7 < 1) {
           m8<Int> = 0
           while (m8 < 1) {
            gl1 = setval(55)
            m8 = 1
           }
           m7 = 1
          }
          m6 = 1
         }
         m5 = 1
        }
        m4 = 1
       }
       m3 = 1
      }
      m2 = 1
     }
     m1 = 1
    }
    println("L deep setval: " + gl1.to_string())
    println("L getval after: " + getval().to_string())
    ft1<Int> = flagtest()
    ft2<Int> = flagtest()
    fg<Int> = getflag()
    println("M flagtest,flagtest,getflag: " + ft1.to_string() + "," + ft2.to_string() + "," + fg.to_string())
    return 0
}
