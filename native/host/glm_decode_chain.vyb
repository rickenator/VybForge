# glm_decode_chain.vyb -- the FULL 45-layer GLM-5.3-Flash decode chain in one Vyb
# process: a 20-token batched prefill (phase 1) followed by two teacher-forced decode
# steps through all 45 layers (phase 2), with every cache built and carried in-process
# (HANDOFF section 11).
#
#   phase 1  (R = 20): the glm_prefill.vyb sites verbatim -- kda_attn_site /
#            dsa_attn_site / ffn_dense_site / tail_site -- over prompt tokens 0..19,
#            saving as it goes:
#              KDA layers (34): recurrence state [64,128,128] + conv rings [3,8192]
#                               per tensor q/k/v (the last 3 PRE-conv rows)
#              DSA layers (11): ckv [20,512], indexer k [20,128], gsc [20,128]
#   phase 2  (R = 1): tokens ids[20] and ids[21] walked through all 45 layers in
#            order, KDA/DSA dispatch by layer index, appending to the DSA caches and
#            updating the KDA state/rings. The decode math is the gated
#            glm_decode_step.vyb (KDA) / glm_decode_l3.vyb (DSA) step bodies.
#
# The gate is free and exact: prefill token t's per-layer streams equal decode step
# t's per-layer streams element-wise (causal attention makes the stepwise walk
# exact). The reference is the modified prefill's `chain<N>` dumps() lines (last two
# tokens' per-layer streams, 2^40-scaled ints) in native/out/prefill_vyb.txt; this
# driver dumps `d<t>l<n>s2` dumps() lines to native/out/decchain_vyb.txt.
# native/glm53/verify_decode_chain.py compares element-wise and prints
# DECODE_CHAIN_MATCH.
#
# Generated by native/glm53/build_decode_chain.py -- do not hand-edit the copied
# blocks; edit the sources and regenerate.
import io::{open_read, read_at, read_all, open_write, write_str, close}
import env::{env_get}
import safetensors
import gx
import tensor::{tensor_init, module_load_path, module_func, dev_alloc, bulk_htod, bulk_dtoh, sync, gemm}
import vmath::{vexp, vsqrt}
import time::{time_mono_millis}

extern "C" {
    cuMemFree_v2(dptr<Int>)<CInt>
    cuMemAlloc_v2(dptr<loc<Int>>, bytesize<Int>)<CInt>
    cuMemcpyHtoD_v2(dstDevice<Int>, srcHost<loc<CVoid>>, ByteCount<Int>)<CInt>
    cuCtxSynchronize()<CInt>
    cuModuleLoadData(hmod<loc<loc<CVoid>>>, image<CString>)<CInt>
    cuModuleGetFunction(hfunc<loc<loc<CVoid>>>, hmod<loc<CVoid>>, name<CString>)<CInt>
    cuda_launch4i(f<loc<CVoid>>, gridX<CUInt>, gridY<CUInt>, gridZ<CUInt>,
                  blockX<CUInt>, blockY<CUInt>, blockZ<CUInt>,
                  a0<Int>, a1<Int>, a2<Int>, a3<Int>)<CInt>
    malloc_trim(pad<Int>)<CInt>
}

# phase 1 runs R = 20 prompt tokens (the decode steps re-walk tokens 20 and 21, so
# the caches must NOT contain them); phase 2 runs with R = 1 (set in main).
R<Int> = 20
CAPT<Int> = 22          # DSA cache rows per layer slot: 20 prefill + 2 decode
NLAY<Int> = 45
NSLOT<Int> = 34         # KDA layer slots
NDSLOT<Int> = 11        # DSA layer slots
H<Int> = 4096
HC<Int> = 4
HEADS<Int> = 64
KD<Int> = 128
NOPE<Int> = 256
VDIM<Int> = 256
KV_LORA<Int> = 512
Q_LORA<Int> = 1536
IHEADS<Int> = 32
IDIM<Int> = 128
KPOOL<Int> = 4
TOPK<Int> = 2048        # indexer: top-k pool columns
ROUTE_TOPK<Int> = 8     # MoE: experts per token -- the attn site's TOPK is 2048, and
                        # shadowing it here silently made the router pick 288 experts
INTER<Int> = 12288
NE<Int> = 288
EINTER<Int> = 2048
EPS<Float> = 1e-5
LN_EPS<Float> = 1e-6
HC_EPS<Float> = 1e-6
L2_EPS<Float> = 1e-6
GATE_LB<Float> = -5.0
CONV_K<Int> = 4
SCALE40<Float> = 1099511627776.0
SWIGLU_LIMIT<Float> = 10.0
ROUTED_SCALE<Float> = 2.5

# ============================================================ prefill helpers (verbatim)

trim_heap()<Int> -> {
    r<Int> = 0
    freedom {
        r = malloc_trim(0) as Int
    }
    return r
}

vecf()<Vec<Float>> -> {          # a typed empty Vec<Float> (a bare `x = Vec()` infers Vec<Int>)
    e<Vec<Float>> = Vec()
    return e
}

di(v<Float>)<Int> -> {
    return (v * SCALE40) as Int
}

digest(name<String>, v<Vec<Float>>)<String> -> {
    s<Float> = 0.0
    a<Float> = 0.0
    q<Float> = 0.0
    m<Float> = 0.0
    i<Int> = 0
    while (i < v.len()) {
        x<Float> = v.get(i)
        s = s + x
        if (x < 0.0) { a = a - x } else { a = a + x }
        q = q + x * x
        t<Float> = x
        if (t < 0.0) { t = 0.0 - t }
        if (t > m) { m = t }
        i = i + 1
    }
    out<String> = name + " n=" + v.len().to_string() + " sum=" + di(s).to_string() +
                  " abs=" + di(a).to_string() + " sq=" + di(q).to_string() +
                  " max=" + di(m).to_string()
    i = 0
    while (i < 8) {
        hv<Float> = 0.0
        if (i < v.len()) { hv = v.get(i) }
        out = out + " v" + i.to_string() + "=" + di(hv).to_string()
        i = i + 1
    }
    return out
}

sigmoid(x<Float>)<Float> -> {
    return 1.0 / (1.0 + vexp(0.0 - x))
}

# per-row rms over width D, times w when w.len() == D

rms_rows(x<Vec<Float>>, rows<Int>, D<Int>, w<Vec<Float>>)<Vec<Float>> -> {
    dst<Vec<Float>> = Vec()
    r<Int> = 0
    i<Int> = 0
    while (r < rows) {
        ss<Float> = 0.0
        i = 0
        base<Int> = r * D
        while (i < D) {
            v<Float> = x.get(base + i)
            ss = ss + v * v
            i = i + 1
        }
        inv<Float> = 1.0 / vsqrt(ss / (D as Float) + EPS, 40)
        i = 0
        while (i < D) {
            vv<Float> = x.get(base + i) * inv
            if (w.len() == D) { vv = vv * w.get(i) }
            dst.push(vv)
            i = i + 1
        }
        r = r + 1
    }
    return dst
}

# LayerNorm (mean/variance, weight + bias) — the indexer's k_norm is a real LayerNorm

ln_rows(x<Vec<Float>>, rows<Int>, D<Int>, w<Vec<Float>>, b<Vec<Float>>)<Vec<Float>> -> {
    dst<Vec<Float>> = Vec()
    r<Int> = 0
    i<Int> = 0
    while (r < rows) {
        mu<Float> = 0.0
        i = 0
        while (i < D) {
            mu = mu + x.get(r * D + i)
            i = i + 1
        }
        mu = mu / (D as Float)
        vr<Float> = 0.0
        i = 0
        while (i < D) {
            dv<Float> = x.get(r * D + i) - mu
            vr = vr + dv * dv
            i = i + 1
        }
        vr = vr / (D as Float)
        inv<Float> = 1.0 / vsqrt(vr + LN_EPS, 40)
        i = 0
        while (i < D) {
            dst.push((x.get(r * D + i) - mu) * inv * w.get(i) + b.get(i))
            i = i + 1
        }
        r = r + 1
    }
    return dst
}

f32_at(raw<String>, idx<Int>)<Float> -> {
    w<Int> = 0
    b<Int> = 0
    while (b < 4) {
        c<Int> = (raw.char_at(idx * 4 + b) as Int) & 255
        w = w | (c << (b * 8))
        b = b + 1
    }
    sign<Float> = 1.0
    if ((w & 2147483648) != 0) { sign = 0.0 - 1.0 }
    ex<Int> = (w >> 23) & 255
    man<Int> = w & 8388607
    v<Float> = 0.0
    if (ex > 0) {
        den<Float> = 1.0 + (man as Float) / 8388608.0
        p2<Float> = 1.0
        e2<Int> = 0
        while (e2 < (ex - 127)) {
            p2 = p2 * 2.0
            e2 = e2 + 1
        }
        while (e2 > (ex - 127)) {
            p2 = p2 / 2.0
            e2 = e2 - 1
        }
        v = sign * den * p2
    }
    return v
}

# ---------------------------------------------------------------- device plumbing

alloc_dev(n<Int>)<Int> -> {
    var<Int> p = 0
    freedom {
        if (cuMemAlloc_v2(loc(p), n) != 0) { return 0 }
    }
    return p
}

free_dev(p<Int>)<Int> -> {
    if (p == 0) { return 0 }
    freedom {
        cuMemFree_v2(p)
    }
    return 0
}

deq_bf16(faddr<Int>, raw<String>, n<Int>, z<Int>)<Int> -> {
    var<Int> out = 0
    freedom {
        var<Int> q = 0
        var<Int> o = 0
        if (cuMemAlloc_v2(loc(q), raw.len()) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(o), n * 8) != 0) { return 0 }
        if (cuMemcpyHtoD_v2(q, raw, raw.len()) != 0) { return 0 }
        blocks<Int> = (n + 255) / 256
        if (cuda_launch4i(from<loc<CVoid>>(faddr), blocks, 1, 1, 256, 1, 1, q, o, n, z) != 0) {
            return 0
        }
        cuCtxSynchronize()
        cuMemFree_v2(q)
        out = o
    }
    return out
}

load_fn(ptx_path<String>, fn_name<String>)<Int> -> {
    ptx<String> = ""
    match (open_read(ptx_path)) {
        f -> { match (read_all(f)) { s -> { ptx = s } ? -> { return 0 } } close(f) }
        ? -> { return 0 }
    }
    var<Int> addr_out = 0
    freedom {
        var<loc<loc<CVoid>>> m = from<loc<loc<CVoid>>>(0)
        if (cuModuleLoadData(loc(m), ptx) != 0) { return 0 }
        var<loc<CVoid>> f = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(f), m, fn_name) != 0) { return 0 }
        addr_out = addr(f)
    }
    return addr_out
}

mm_dev(A<Int>, B<Int>, M<Int>, N<Int>, K<Int>, faddr<Int>)<Int> -> {
    var<Int> C = 0
    var<Int> scr = 0
    C = alloc_dev(M * N * 8)
    scr = alloc_dev(64)
    if (C == 0 || scr == 0) { return 0 }
    if (gemm(faddr, scr, A, B, C, M, N, K, 1.0, 0.0) != 0) { return 0 }
    sync()
    free_dev(scr)
    return C
}

mm_host(x<Vec<Float>>, rows<Int>, K<Int>, B<Int>, N<Int>, faddr<Int>)<Vec<Float>> -> {
    out<Vec<Float>> = Vec()
    var<Int> dA = 0
    dA = alloc_dev(rows * K * 8)
    if (dA == 0) { return out }
    bulk_htod(dA, view(x))
    var<Int> dC = 0
    dC = mm_dev(dA, B, rows, N, K, faddr)
    free_dev(dA)
    if (dC == 0) { return out }
    out = bulk_dtoh(dC, rows * N)
    free_dev(dC)
    return out
}

silu(x<Float>)<Float> -> {
    return x * (1.0 / (1.0 + vexp(0.0 - x)))
}

l2_rows(x<Vec<Float>>, rows<Int>, D<Int>)<Vec<Float>> -> {
    dst<Vec<Float>> = Vec()
    r<Int> = 0
    i<Int> = 0
    while (r < rows) {
        ss<Float> = 0.0
        i = 0
        while (i < D) {
            v<Float> = x.get(r * D + i)
            ss = ss + v * v
            i = i + 1
        }
        nrm<Float> = vsqrt(ss + L2_EPS, 40)
        i = 0
        while (i < D) {
            dst.push(x.get(r * D + i) / nrm)
            i = i + 1
        }
        r = r + 1
    }
    return dst
}

# NOTE the loop order: `dst` is built by PUSH, so the pushes must follow the array's
# row-major (t*C + c) order — iterating channels outside tokens silently produced a
# transposed result whose digests (sum/abs/sq/max) still matched.

conv_silu(x<Vec<Float>>, rows<Int>, C<Int>, w<Vec<Float>>)<Vec<Float>> -> {
    dst<Vec<Float>> = Vec()
    c<Int> = 0
    t<Int> = 0
    j<Int> = 0
    while (t < rows) {
        c = 0
        while (c < C) {
            acc<Float> = 0.0
            j = 0
            while (j < CONV_K) {
                src<Int> = t + j - (CONV_K - 1)
                if (src >= 0) { acc = acc + x.get(src * C + c) * w.get(c * CONV_K + j) }
                j = j + 1
            }
            dst.push(silu(acc))
            c = c + 1
        }
        t = t + 1
    }
    return dst
}

# f32 -> f64 by hand (host Vyb has no bitcast)

up_bytes(raw<String>, dst<Int>)<Int> -> {
    var<CInt> rc = 0
    freedom {
        rc = cuMemcpyHtoD_v2(dst, raw, raw.len())
    }
    return rc
}

# bf16 -> f64 on the device; z > 0 means the stored layout is (out,in) with in = z,
# so bf16deq writes the transpose [in,out]. Returns the device pointer (0 = failure).

hc_glue(mv<Vec<Float>>, base<Vec<Float>>, scale<Vec<Float>>, streams<Vec<Float>>)<Vec<Float>> -> {
    pre<Vec<Float>> = Vec()
    post<Vec<Float>> = Vec()
    comb<Vec<Float>> = Vec()
    r<Int> = 0
    j<Int> = 0
    n0<Int> = 0
    a<Int> = 0
    b<Int> = 0
    mx<Float> = 0.0
    sm<Float> = 0.0
    it<Int> = 0
    h<Int> = 0
    d<Int> = 0
    p<Float> = 0.0
    v<Float> = 0.0
    n1<Int> = 0
    while (r < R) {
        j = 0
        while (j < HC) {
            pre.push(sigmoid(mv.get(r * 24 + j) * scale.get(0) + base.get(j)) + HC_EPS)
            post.push(2.0 * sigmoid(mv.get(r * 24 + HC + j) * scale.get(1) + base.get(HC + j)))
            j = j + 1
        }
        r = r + 1
    }
    n0 = 0
    while (n0 < R * HC * HC) {
        comb.push(0.0)
        n0 = n0 + 1
    }
    r = 0
    while (r < R) {
        a = 0
        while (a < HC) {
            b = 0
            while (b < HC) {
                comb.set((r * HC + a) * HC + b,
                         mv.get(r * 24 + 2 * HC + a * HC + b) * scale.get(2) +
                         base.get(2 * HC + a * HC + b))
                b = b + 1
            }
            a = a + 1
        }
        r = r + 1
    }
    r = 0
    while (r < R) {
        a = 0
        while (a < HC) {
            # per-ROW max, like gold's softmax(axis=-1, keepdims): a global max underflows
            # the smaller entries of a row whose logits sit far below the global peak, which
            # then differ by whole multiples after the eps floor.
            mx = 0.0 - 1e30
            b<Int> = 0
            while (b < HC) {
                v = comb.get((r * HC + a) * HC + b)
                if (v > mx) { mx = v }
                b = b + 1
            }
            sm = 0.0
            b = 0
            while (b < HC) {
                sm = sm + vexp(comb.get((r * HC + a) * HC + b) - mx)
                b = b + 1
            }
            b = 0
            while (b < HC) {
                comb.set((r * HC + a) * HC + b,
                         vexp(comb.get((r * HC + a) * HC + b) - mx) / sm)
                b = b + 1
            }
            a = a + 1
        }
        a = 0
        while (a < HC) {
            b = 0
            while (b < HC) {
                comb.set((r * HC + a) * HC + b, comb.get((r * HC + a) * HC + b) + HC_EPS)
                b = b + 1
            }
            a = a + 1
        }
        b = 0
        while (b < HC) {
            sm = 0.0
            a = 0
            while (a < HC) {
                sm = sm + comb.get((r * HC + a) * HC + b)
                a = a + 1
            }
            a = 0
            while (a < HC) {
                comb.set((r * HC + a) * HC + b, comb.get((r * HC + a) * HC + b) / (sm + HC_EPS))
                a = a + 1
            }
            b = b + 1
        }
        it = 1
        # gold: softmax -> colsum -> (sinkhorn_iters-1) x {rowsum, colsum}. One colsum pass
        # already happened above and `it` starts at 1, so < 20 is exactly 19 pairs.
        while (it < 20) {
            a = 0
            while (a < HC) {
                sm = 0.0
                b = 0
                while (b < HC) {
                    sm = sm + comb.get((r * HC + a) * HC + b)
                    b = b + 1
                }
                b = 0
                while (b < HC) {
                    comb.set((r * HC + a) * HC + b, comb.get((r * HC + a) * HC + b) / (sm + HC_EPS))
                    b = b + 1
                }
                a = a + 1
            }
            b = 0
            while (b < HC) {
                sm = 0.0
                a = 0
                while (a < HC) {
                    sm = sm + comb.get((r * HC + a) * HC + b)
                    a = a + 1
                }
                a = 0
                while (a < HC) {
                    comb.set((r * HC + a) * HC + b, comb.get((r * HC + a) * HC + b) / (sm + HC_EPS))
                    a = a + 1
                }
                b = b + 1
            }
            it = it + 1
        }
        r = r + 1
    }
    col<Vec<Float>> = Vec()
    n1 = 0
    while (n1 < R * H) {
        col.push(0.0)
        n1 = n1 + 1
    }
    r = 0
    while (r < R) {
        h = 0
        while (h < HC) {
            p = pre.get(r * HC + h)
            d = 0
            while (d < H) {
                col.set(r * H + d, col.get(r * H + d) + p * streams.get((r * HC + h) * H + d))
                d = d + 1
            }
            h = h + 1
        }
        r = r + 1
    }
    res<Vec<Float>> = Vec()
    n1 = 0
    while (n1 < col.len()) {
        res.push(col.get(n1))
        n1 = n1 + 1
    }
    n1 = 0
    while (n1 < post.len()) {
        res.push(post.get(n1))
        n1 = n1 + 1
    }
    n1 = 0
    while (n1 < comb.len()) {
        res.push(comb.get(n1))
        n1 = n1 + 1
    }
    return res
}

dumps(name<String>, v<Vec<Float>>)<String> -> {
    out<String> = name
    i<Int> = 0
    while (i < v.len()) {
        out = out + " " + di(v.get(i)).to_string()
        i = i + 1
    }
    return out
}

# ---------------------------------------------------------------- GPU matmul helpers
# C[M,N] = A[M,K] @ B[K,N] on the device; returns the device pointer (0 on failure).

log_decay(f<Vec<Float>>, dt<Vec<Float>>, alog<Vec<Float>>)<Vec<Float>> -> {
    out<Vec<Float>> = Vec()
    r<Int> = 0
    h<Int> = 0
    c<Int> = 0
    while (r < R) {
        h = 0
        while (h < HEADS) {
            dec<Float> = vexp(alog.get(h))
            c = 0
            while (c < KD) {
                idx<Int> = (r * HEADS + h) * KD + c
                tix<Int> = h * KD + c
                out.push(sigmoid((f.get(idx) + dt.get(tix)) * dec) * GATE_LB)
                c = c + 1
            }
            h = h + 1
        }
        r = r + 1
    }
    return out
}

# the KDA delta-rule recurrence (gdn_ref.kda_recurrent): q,k,v [R,HEADS,KD], g [R,HEADS,KD],
# beta [R,HEADS]; q is already l2-normalised and scaled by 1/sqrt(KD), k l2-normalised.

delta_rule(q<Vec<Float>>, k<Vec<Float>>, v<Vec<Float>>, g<Vec<Float>>, beta<Vec<Float>>)<Vec<Float>> -> {
    out<Vec<Float>> = Vec()
    st<Vec<Float>> = Vec()
    var<Int> n = 0
    while (n < HEADS * KD * KD) {
        st.push(0.0)
        n = n + 1
    }
    n = 0
    while (n < R * HEADS * KD) {
        out.push(0.0)
        n = n + 1
    }
    r<Int> = 0
    h<Int> = 0
    a<Int> = 0
    b<Int> = 0
    while (r < R) {
        h = 0
        while (h < HEADS) {
            # decay the whole state block by exp(g)
            a = 0
            while (a < KD) {
                ge<Float> = vexp(g.get((r * HEADS + h) * KD + a))
                b = 0
                while (b < KD) {
                    st.set((h * KD + a) * KD + b, st.get((h * KD + a) * KD + b) * ge)
                    b = b + 1
                }
                a = a + 1
            }
            be<Float> = beta.get(r * HEADS + h)
            # one sweep over v-channels: delta, state update, read-out (numpy's order)
            b = 0
            while (b < KD) {
                kvb<Float> = 0.0
                a = 0
                while (a < KD) {
                    kvb = kvb + st.get((h * KD + a) * KD + b) * k.get((r * HEADS + h) * KD + a)
                    a = a + 1
                }
                dl<Float> = (v.get((r * HEADS + h) * KD + b) - kvb) * be
                a = 0
                while (a < KD) {
                    st.set((h * KD + a) * KD + b,
                           st.get((h * KD + a) * KD + b) + k.get((r * HEADS + h) * KD + a) * dl)
                    a = a + 1
                }
                rd<Float> = 0.0
                a = 0
                while (a < KD) {
                    rd = rd + st.get((h * KD + a) * KD + b) * q.get((r * HEADS + h) * KD + a)
                    a = a + 1
                }
                out.set((r * HEADS + h) * KD + b, rd)
                b = b + 1
            }
            h = h + 1
        }
        r = r + 1
    }
    return out
}

# gated RMSNorm with the sigmoid (KDA) activation, per (token, head) row of KD, times w

gated_norm(x<Vec<Float>>, z<Vec<Float>>, w<Vec<Float>>)<Vec<Float>> -> {
    out<Vec<Float>> = Vec()
    r<Int> = 0
    h<Int> = 0
    i<Int> = 0
    while (r < R) {
        h = 0
        while (h < HEADS) {
            ss<Float> = 0.0
            i = 0
            while (i < KD) {
                vv<Float> = x.get((r * HEADS + h) * KD + i)
                ss = ss + vv * vv
                i = i + 1
            }
            inv<Float> = 1.0 / vsqrt(ss / (KD as Float) + EPS, 40)
            i = 0
            while (i < KD) {
                idx<Int> = (r * HEADS + h) * KD + i
                out.push(x.get(idx) * inv * w.get(i) * sigmoid(z.get(idx)))
                i = i + 1
            }
            h = h + 1
        }
        r = r + 1
    }
    return out
}

# hyper-connection apply: dst = post ⊗ y + comb^T streams

hc_apply(streams<Vec<Float>>, y<Vec<Float>>, post<Vec<Float>>, comb<Vec<Float>>)<Vec<Float>> -> {
    dst<Vec<Float>> = Vec()
    r<Int> = 0
    h<Int> = 0
    d<Int> = 0
    j<Int> = 0
    n<Int> = 0
    while (n < R * HC * H) {
        dst.push(0.0)
        n = n + 1
    }
    while (r < R) {
        h = 0
        while (h < HC) {
            d = 0
            while (d < H) {
                acc<Float> = post.get(r * HC + h) * y.get(r * H + d)
                j = 0
                while (j < HC) {
                    acc = acc + comb.get((r * HC + j) * HC + h) * streams.get((r * HC + j) * H + d)
                    j = j + 1
                }
                dst.set((r * HC + h) * H + d, acc)
                d = d + 1
            }
            h = h + 1
        }
        r = r + 1
    }
    return dst
}

exl3_deq(fdeq<Int>, fhgen<Int>, fhad1<Int>, fhad2<Int>,
         trellis<String>, suh<String>, svh<String>, body<String>,
         cw<Int>, ntiles<Int>)<Int> -> {
    tb<Int> = 0
    kn<Int> = 0
    krows<Int> = 0
    nbc<Int> = 0
    nblocks<Int> = 0
    mb<Int> = 0
    hwide<Int> = 0
    bq<Int> = 0
    u<Int> = 0
    ch<Int> = 0
    b<Int> = 0
    pq<Int> = 0
    chq<Int> = 0
    var<Int> out = 0
    tb = trellis.len()
    nbody<Int> = body.len()
    nsuh<Int> = suh.len()
    nsvh<Int> = svh.len()
    if (tb < ntiles * 128) { return 0 }
    kn = (ntiles / (cw / 16)) * 16 * cw
    krows = kn / cw
    if ((suh.len() % 8) != 0 || (svh.len() % 8) != 0) { return 0 }
    if (suh.len() != krows * 2 || svh.len() != cw * 2) { return 0 }
    nbc = cw / 128
    nblocks = (kn / cw / 128) * nbc
    mb = 16 + body.len()
    freedom {
        var<Int> qd = 0
        var<Int> td = 0
        var<Int> od = 0
        var<Int> hd = 0
        var<Int> td2 = 0
        var<Int> fd = 0
        var<Int> pd = 0
        var<Int> sud = 0
        var<Int> svd = 0
        if (cuMemAlloc_v2(loc(qd), tb) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(td), mb) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(od), kn * 8) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(hd), 128 * 128 * 8) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(td2), kn * 8) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(fd), kn * 8) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(pd), 64) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(sud), krows * 2) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(svd), cw * 2) != 0) { return 0 }

        # trellis: bulk copy straight from the String
        if (cuMemcpyHtoD_v2(qd, trellis, tb) != 0) { return 0 }
        # map: 16-byte header + the 256-slot body
        var<CInt> rc = 0
        hwide = 0
        bq = 0
        while (bq < 8) {
            hwide = hwide | (((cw >> (bq * 8)) & 255) << (bq * 8))
            bq = bq + 1
        }
        if (cuMemcpyHtoD_v2(td, loc(hwide), 8) != 0) { return 0 }
        hwide = 0
        bq = 0
        while (bq < 8) {
            hwide = hwide | (((ntiles >> (bq * 8)) & 255) << (bq * 8))
            bq = bq + 1
        }
        if (cuMemcpyHtoD_v2(td + 8, loc(hwide), 8) != 0) { return 0 }
        # map body: ONE copy from the String's own buffer (per-8-byte copies cost ~2 us each)
        if (cuMemcpyHtoD_v2(td + 16, body, nbody) != 0) { return 0 }
        # dequant
        if (cuda_launch4i(from<loc<CVoid>>(fdeq), ntiles, 1, 1, 256, 1, 1, qd, td, od, 0) != 0) {
            return 0
        }
        cuCtxSynchronize()
        cuMemFree_v2(qd)
        cuMemFree_v2(td)
        # scales (fp16) to the device: one copy each, same reason as the map body
        if (cuMemcpyHtoD_v2(sud, suh, nsuh) != 0) { return 0 }
        if (cuMemcpyHtoD_v2(svd, svh, nsvh) != 0) { return 0 }
        # hgen: H at pd+0
        if (cuMemcpyHtoD_v2(pd + 0, loc(hd), 8) != 0) { return 0 }
        if (cuda_launch4i(from<loc<CVoid>>(fhgen), 64, 1, 1, 256, 1, 1, pd, 0, 0, 0) != 0) {
            return 0
        }
        cuCtxSynchronize()
        # had1: what=od, tmp=td2, H=hd, cw, nbc, nblocks
        pq = 0
        while (pq < 6) {
            chq = 0
            if (pq == 0) { chq = od }
            if (pq == 1) { chq = td2 }
            if (pq == 2) { chq = hd }
            if (pq == 3) { chq = cw }
            if (pq == 4) { chq = nbc }
            if (pq == 5) { chq = nblocks }
            if (cuMemcpyHtoD_v2(pd + pq * 8, loc(chq), 8) != 0) { return 0 }
            pq = pq + 1
        }
        if (cuda_launch4i(from<loc<CVoid>>(fhad1), nblocks * 64, 1, 1, 256, 1, 1, pd, 0, 0, 0) != 0) {
            return 0
        }
        cuCtxSynchronize()
        # had2: tmp=td2, out=fd, H=hd, suh, svh, cw, nbc, nblocks
        pq = 0
        while (pq < 8) {
            chq = 0
            if (pq == 0) { chq = td2 }
            if (pq == 1) { chq = fd }
            if (pq == 2) { chq = hd }
            if (pq == 3) { chq = sud }
            if (pq == 4) { chq = svd }
            if (pq == 5) { chq = cw }
            if (pq == 6) { chq = nbc }
            if (pq == 7) { chq = nblocks }
            if (cuMemcpyHtoD_v2(pd + pq * 8, loc(chq), 8) != 0) { return 0 }
            pq = pq + 1
        }
        if (cuda_launch4i(from<loc<CVoid>>(fhad2), nblocks * 64, 1, 1, 256, 1, 1, pd, 0, 0, 0) != 0) {
            return 0
        }
        cuCtxSynchronize()
        cuMemFree_v2(od)
        cuMemFree_v2(hd)
        cuMemFree_v2(td2)
        cuMemFree_v2(pd)
        cuMemFree_v2(sud)
        cuMemFree_v2(svd)
        out = fd
    }
    return out
}


# ============================================================ phase-1 sites with state capture
# The prefill sites verbatim, plus borrows that copy the carried decode state out as
# the batched pass goes. The copies are read-only additions: the batched arithmetic
# is untouched, so phase 1's digests are the prefill's.

# delta_rule + the final recurrence state copied to st_out at slot offset
# slot * HEADS * KD * KD (the state after the LAST token of the batch).

delta_rule_cap(q<Vec<Float>>, k<Vec<Float>>, v<Vec<Float>>, g<Vec<Float>>, beta<Vec<Float>>, st_out<their<Vec<Float>>>, capslot<Int>)<Vec<Float>> -> {
    out<Vec<Float>> = Vec()
    st<Vec<Float>> = Vec()
    var<Int> n = 0
    while (n < HEADS * KD * KD) {
        st.push(0.0)
        n = n + 1
    }
    n = 0
    while (n < R * HEADS * KD) {
        out.push(0.0)
        n = n + 1
    }
    r<Int> = 0
    h<Int> = 0
    a<Int> = 0
    b<Int> = 0
    while (r < R) {
        h = 0
        while (h < HEADS) {
            # decay the whole state block by exp(g)
            a = 0
            while (a < KD) {
                ge<Float> = vexp(g.get((r * HEADS + h) * KD + a))
                b = 0
                while (b < KD) {
                    st.set((h * KD + a) * KD + b, st.get((h * KD + a) * KD + b) * ge)
                    b = b + 1
                }
                a = a + 1
            }
            be<Float> = beta.get(r * HEADS + h)
            # one sweep over v-channels: delta, state update, read-out (numpy's order)
            b = 0
            while (b < KD) {
                kvb<Float> = 0.0
                a = 0
                while (a < KD) {
                    kvb = kvb + st.get((h * KD + a) * KD + b) * k.get((r * HEADS + h) * KD + a)
                    a = a + 1
                }
                dl<Float> = (v.get((r * HEADS + h) * KD + b) - kvb) * be
                a = 0
                while (a < KD) {
                    st.set((h * KD + a) * KD + b,
                           st.get((h * KD + a) * KD + b) + k.get((r * HEADS + h) * KD + a) * dl)
                    a = a + 1
                }
                rd<Float> = 0.0
                a = 0
                while (a < KD) {
                    rd = rd + st.get((h * KD + a) * KD + b) * q.get((r * HEADS + h) * KD + a)
                    a = a + 1
                }
                out.set((r * HEADS + h) * KD + b, rd)
                b = b + 1
            }
            h = h + 1
        }
        r = r + 1
    }
    cap<Int> = 0
    while (cap < st.len()) {
        st_out.set(capslot * HEADS * KD * KD + cap, st.get(cap))
        cap = cap + 1
    }
    return out
}

# attn_site + the DSA cache rows (ckv / indexer k / gsc) copied to the layer slot.

attn_site_c(h_a<Vec<Float>>, lpre<String>, fgemm<Int>, fbf<Int>, ckv_out<their<Vec<Float>>>, ik_out<their<Vec<Float>>>, gsc_out<their<Vec<Float>>>, capslot<Int>)<Vec<Float>> -> {
    nonev<Vec<Float>> = Vec()
    a<Int> = 0
    acc<Float> = 0.0
    best<Float> = 0.0
    bestp<Int> = 0
    c<Int> = 0
    d2<Int> = 0
    d_knb<Int> = 0
    d_knw<Int> = 0
    dir<String> = ""
    dot<Float> = 0.0
    first<Int> = 0
    hapath<String> = ""
    hh<Int> = 0
    i<Int> = 0
    j2<Int> = 0
    k2<Int> = 0
    k3<Int> = 0
    last<Int> = 0
    lg<Float> = 0.0
    lines<String> = ""
    mx<Float> = 0.0
    nf<Int> = 0
    npools<Int> = 0
    out<String> = ""
    p<Int> = 0
    pr<Float> = 0.0
    pv<Float> = 0.0
    q2<Int> = 0
    raw_ape<String> = ""
    rl<Float> = 0.0
    sc<Float> = 0.0
    sc_scale<Float> = 0.0
    scale_iq<Float> = 0.0
    select_k<Int> = 0
    selline<String> = ""
    slot<Int> = 0
    sm<Float> = 0.0
    sv<Float> = 0.0
    tcount<Int> = 0
    total<Int> = 0
    tstart<Int> = 0
    tv<Int> = 0
    used<Int> = 0
    vcount<Int> = 0
    total = 0
    nf = 0
    i = 0
    d_knw = 0
    d_knb = 0
    d2 = 0
    hh = 0
    j2 = 0
    npools = 0
    p = 0
    c = 0
    mx = 0.0
    a = 0
    lg = 0.0
    sm = 0.0
    acc = 0.0
    pr = 0.0
    scale_iq = 0.0
    q2 = 0
    dot = 0.0
    rl = 0.0
    select_k = 0
    k2 = 0
    bestp = 0
    best = 0.0
    last = 0
    used = 0
    k3 = 0
    sc = 0.0
    vcount = 0
    tcount = 0
    tstart = 0
    slot = 0
    first = 0
    tv = 0
    sc_scale = 0.0
    sv = 0.0
    pv = 0.0
    dir = env_get("VYBFORGE_GX_DIR") else "/mnt/apex/rick/vybforge/glm53-checkpoint"
    out = env_get("VYBFORGE_L3_OUT") else "native/out/l3_vyb.txt"
    hapath = env_get("VYBFORGE_L3_HA") else "native/out/gold_l3_ha.txt"
    total = 83

    want<Vec<String>> = Vec()
    want.push(lpre + "self_attn.q_a_proj.weight")
    want.push(lpre + "self_attn.q_a_layernorm.weight")
    want.push(lpre + "self_attn.q_b_proj.weight")
    want.push(lpre + "self_attn.kv_a_proj_with_mqa.weight")
    want.push(lpre + "self_attn.kv_a_layernorm.weight")
    want.push(lpre + "self_attn.kv_b_proj.weight")
    want.push(lpre + "self_attn.o_proj.weight")
    want.push(lpre + "self_attn.indexer.wq_b.weight")
    want.push(lpre + "self_attn.indexer.wk.weight")
    want.push(lpre + "self_attn.indexer.k_norm.weight")
    want.push(lpre + "self_attn.indexer.k_norm.bias")
    want.push(lpre + "self_attn.indexer.weights_proj.weight")
    want.push(lpre + "self_attn.indexer.index_kpool_compress_ape")
    want.push(lpre + "self_attn.indexer.index_kpool_compress_gate")

    g<GxLoc> = gx_resolve(dir, total, want)
    nf = 0
    i = 0
    while (i < want.len()) {
        if (g.found.get(i) == 1) { nf = nf + 1 }
        i = i + 1
    }
    if (nf != want.len()) { println("L3_FAIL resolve " + nf.to_string()); return nonev }

    if (tensor_init() != 0) { println("L3_FAIL no cuda"); return nonev }
    fgemm = load_fn("native/build/gemm.ptx", "gemm")
    fbf = load_fn("native/build/bf16.ptx", "bf16deq")
    if (fgemm == 0 || fbf == 0) { println("L3_FAIL kernels"); return nonev }

    lines = ""
    # ---- q_a latent, q_b, kv_a latent ----
    var<Int> d_qa = 0
    var<Int> d_qb = 0
    var<Int> d_kva = 0
    var<Int> d_kvb = 0
    var<Int> d_o = 0
    d_qa = deq_bf16(fbf, gx_read(g, 0), Q_LORA * H, H)
    d_qb = deq_bf16(fbf, gx_read(g, 2), HEADS * NOPE * Q_LORA, Q_LORA)
    d_kva = deq_bf16(fbf, gx_read(g, 3), KV_LORA * H, H)
    d_kvb = deq_bf16(fbf, gx_read(g, 5), HEADS * (NOPE + VDIM) * KV_LORA, 0)
    d_o = deq_bf16(fbf, gx_read(g, 6), HEADS * VDIM * H, HEADS * VDIM)
    if (d_qa == 0 || d_qb == 0 || d_kva == 0 || d_kvb == 0 || d_o == 0) { return nonev }

    qres<Vec<Float>> = mm_host(h_a, R, H, d_qa, Q_LORA, fgemm)
    println(digest("qres", qres))
    lines = lines + digest("qres", qres) + "\n"

    var<Int> d_qaln = 0
    d_qaln = deq_bf16(fbf, gx_read(g, 1), Q_LORA, 0)
    if (d_qaln == 0) { return nonev }
    qaln_w<Vec<Float>> = bulk_dtoh(d_qaln, Q_LORA)
    free_dev(d_qaln)
    qa_ln<Vec<Float>> = rms_rows(qres, R, Q_LORA, qaln_w)
    qfull<Vec<Float>> = mm_host(qa_ln, R, Q_LORA, d_qb, HEADS * NOPE, fgemm)
    println(digest("qb", qfull))
    lines = lines + digest("qb", qfull) + "\n"

    ckraw<Vec<Float>> = mm_host(h_a, R, H, d_kva, KV_LORA, fgemm)
    var<Int> d_kvaln = 0
    d_kvaln = deq_bf16(fbf, gx_read(g, 4), KV_LORA, 0)
    if (d_kvaln == 0) { return nonev }
    kvaln_w<Vec<Float>> = bulk_dtoh(d_kvaln, KV_LORA)
    free_dev(d_kvaln)
    ckv<Vec<Float>> = rms_rows(ckraw, R, KV_LORA, kvaln_w)
    println(digest("ckv", ckv))
    lines = lines + digest("ckv", ckv) + "\n"

    # ---- per-head absorbed keys/values from kv_b ----
    kvb<Vec<Float>> = bulk_dtoh(d_kvb, HEADS * (NOPE + VDIM) * KV_LORA)
    free_dev(d_kvb)
    println(digest("kvb", kvb))
    lines = lines + digest("kvb", kvb) + "\n"

    # ---- indexer: projections ----
    var<Int> d_wqb = 0
    var<Int> d_wk = 0
    var<Int> d_wproj = 0
    var<Int> d_gate = 0
    d_wqb = deq_bf16(fbf, gx_read(g, 7), Q_LORA * IHEADS * IDIM, Q_LORA)
    d_wk = deq_bf16(fbf, gx_read(g, 8), H * IDIM, H)
    d_wproj = deq_bf16(fbf, gx_read(g, 11), H * IHEADS, H)
    d_gate = deq_bf16(fbf, gx_read(g, 13), H * IDIM, H)
    if (d_wqb == 0 || d_wk == 0 || d_wproj == 0 || d_gate == 0) { return nonev }

    qidx<Vec<Float>> = mm_host(qres, R, Q_LORA, d_wqb, IHEADS * IDIM, fgemm)
    kraw<Vec<Float>> = mm_host(h_a, R, H, d_wk, IDIM, fgemm)
    knw<Vec<Float>> = Vec()
    knb<Vec<Float>> = Vec()
    d_knw = deq_bf16(fbf, gx_read(g, 9), IDIM, 0)
    d_knb = deq_bf16(fbf, gx_read(g, 10), IDIM, 0)
    if (d_knw == 0 || d_knb == 0) { return nonev }
    knw = bulk_dtoh(d_knw, IDIM)
    knb = bulk_dtoh(d_knb, IDIM)
    free_dev(d_knw)
    free_dev(d_knb)
    kn<Vec<Float>> = ln_rows(kraw, R, IDIM, knw, knb)
    gsc<Vec<Float>> = mm_host(h_a, R, H, d_gate, IDIM, fgemm)
    # chained-decode capture: this layer's cache rows for the phase-2 walk
    capi<Int> = 0
    while (capi < R * KV_LORA) {
        ckv_out.set(capslot * CAPT * KV_LORA + capi, ckv.get(capi))
        capi = capi + 1
    }
    capi = 0
    while (capi < R * IDIM) {
        ik_out.set(capslot * CAPT * IDIM + capi, kn.get(capi))
        gsc_out.set(capslot * CAPT * IDIM + capi, gsc.get(capi))
        capi = capi + 1
    }
    wproj<Vec<Float>> = mm_host(h_a, R, H, d_wproj, IHEADS, fgemm)
    println(digest("kidx", kn))
    lines = lines + digest("kidx", kn) + "\n"
    println(digest("gsc", gsc))
    lines = lines + digest("gsc", gsc) + "\n"
    println(digest("wproj", wproj))
    lines = lines + digest("wproj", wproj) + "\n"

    # ---- absorbed per-head keys/values: K = ckv @ [uk_h | ...], V = ckv @ [uv_h | ...] ----
    # kvb holds [heads, nope+v, kv_lora]; uk[h] = kvb[h][:NOPE], uv[h] = kvb[h][NOPE:]
    ukm<Vec<Float>> = Vec()          # [KV_LORA, HEADS*NOPE]
    uvm<Vec<Float>> = Vec()          # [KV_LORA, HEADS*VDIM]
    d2 = 0
    while (d2 < KV_LORA * HEADS * NOPE) {
        ukm.push(0.0)
        uvm.push(0.0)
        d2 = d2 + 1
    }
    hh = 0
    while (hh < HEADS) {
        j2 = 0
        while (j2 < NOPE) {
            d2 = 0
            while (d2 < KV_LORA) {
                ukm.set(d2 * (HEADS * NOPE) + hh * NOPE + j2,
                        kvb.get((hh * (NOPE + VDIM) + j2) * KV_LORA + d2))
                uvm.set(d2 * (HEADS * VDIM) + hh * VDIM + j2,
                        kvb.get((hh * (NOPE + VDIM) + NOPE + j2) * KV_LORA + d2))
                d2 = d2 + 1
            }
            j2 = j2 + 1
        }
        hh = hh + 1
    }
    var<Int> d_ukm = 0
    var<Int> d_uvm = 0
    d_ukm = alloc_dev(KV_LORA * HEADS * NOPE * 8)
    d_uvm = alloc_dev(KV_LORA * HEADS * VDIM * 8)
    if (d_ukm == 0 || d_uvm == 0) { return nonev }
    bulk_htod(d_ukm, view(ukm))
    bulk_htod(d_uvm, view(uvm))
    K<Vec<Float>> = mm_host(ckv, R, KV_LORA, d_ukm, HEADS * NOPE, fgemm)
    V<Vec<Float>> = mm_host(ckv, R, KV_LORA, d_uvm, HEADS * VDIM, fgemm)
    free_dev(d_ukm)
    free_dev(d_uvm)
    println(digest("K", K))
    lines = lines + digest("K", K) + "\n"

    # ---- indexer: gpool pooling + per-query pool scores (dsa_ref.indexer_topk) ----
    ape<Vec<Float>> = Vec()
    raw_ape = gx_read(g, 12)
    i = 0
    while (i < KPOOL * IDIM) {
        ape.push(f32_at(raw_ape, i))
        i = i + 1
    }
    npools = R / KPOOL                    # complete pools (a partial tail pool is dropped)
    poolk<Vec<Float>> = Vec()                  # [npools, IDIM]
    d2 = 0
    while (d2 < npools * IDIM) {
        poolk.push(0.0)
        d2 = d2 + 1
    }
    p = 0
    while (p < npools) {
        c = 0
        while (c < IDIM) {
            # softmax over the pool's slots of (gate + ape), per channel
            mx = 0.0 - 1e30
            a = 0
            while (a < KPOOL) {
                lg = gsc.get((p * KPOOL + a) * IDIM + c) + ape.get(a * IDIM + c)
                if (lg > mx) { mx = lg }
                a = a + 1
            }
            sm = 0.0
            a = 0
            while (a < KPOOL) {
                sm = sm + vexp(gsc.get((p * KPOOL + a) * IDIM + c) + ape.get(a * IDIM + c) - mx)
                a = a + 1
            }
            acc = 0.0
            a = 0
            while (a < KPOOL) {
                pr = vexp(gsc.get((p * KPOOL + a) * IDIM + c) + ape.get(a * IDIM + c) - mx) / sm
                acc = acc + pr * kn.get((p * KPOOL + a) * IDIM + c)
                a = a + 1
            }
            poolk.set(p * IDIM + c, acc)
            c = c + 1
        }
        p = p + 1
    }
    println(digest("poolk", poolk))
    lines = lines + digest("poolk", poolk) + "\n"

    # index_scores[q][p] = sum_h w[q][h] * relu(dot(q_idx[q,h], poolk[p]) / sqrt(IDIM))
    isc<Vec<Float>> = Vec()
    d2 = 0
    while (d2 < R * npools) {
        isc.push(0.0)
        d2 = d2 + 1
    }
    scale_iq = 1.0 / vsqrt(IDIM as Float, 40)
    q2 = 0
    while (q2 < R) {
        p = 0
        while (p < npools) {
            acc = 0.0
            hh = 0
            while (hh < IHEADS) {
                dot = 0.0
                c = 0
                while (c < IDIM) {
                    dot = dot + qidx.get((q2 * IHEADS + hh) * IDIM + c) * poolk.get(p * IDIM + c)
                    c = c + 1
                }
                rl = dot * scale_iq
                if (rl < 0.0) { rl = 0.0 }
                acc = acc + wproj.get(q2 * IHEADS + hh) * (1.0 / vsqrt(IHEADS as Float, 40)) * rl
                hh = hh + 1
            }
            isc.set(q2 * npools + p, acc)
            p = p + 1
        }
        q2 = q2 + 1
    }

    # selection per query: candidate pools are those whose LAST token is visible, top
    # select_k = min(TOPK/KPOOL, npools); then the visible tail; -1 pads. One line per
    # query so verify_l3_vyb.py can diff the token sets against the gold's topk.
    sel<Vec<Int>> = Vec()
    d2 = 0
    while (d2 < R * R) {
        sel.push(-1)
        d2 = d2 + 1
    }
    select_k = TOPK / KPOOL
    if (select_k > npools) { select_k = npools }
    q2 = 0
    while (q2 < R) {
        # order candidate pools by score desc (candidates only; partial pools already dropped)
        taken<Vec<Int>> = Vec()
        k2 = 0
        while (k2 < select_k) {
            bestp = -1
            best = 0.0 - 1e30
            p = 0
            while (p < npools) {
                last = p * KPOOL + KPOOL - 1
                used = 0
                k3 = 0
                while (k3 < taken.len()) {
                    if (taken.get(k3) == p) { used = 1 }
                    k3 = k3 + 1
                }
                if (last <= q2 && used == 0) {
                    sc = isc.get(q2 * npools + p)
                    if (sc > best) {
                        best = sc
                        bestp = p
                    }
                }
                p = p + 1
            }
            if (bestp < 0) { k2 = select_k } else {
                taken.push(bestp)
                a = 0
                while (a < KPOOL) {
                    sel.set(q2 * R + taken.len() * KPOOL - KPOOL + a, bestp * KPOOL + a)
                    a = a + 1
                }
                k2 = k2 + 1
            }
        }
        # visible tail: the tokens after the last complete selected pool region
        vcount = q2 + 1
        tcount = vcount % KPOOL
        tstart = vcount - tcount
        a = 0
        while (a < tcount) {
            slot = taken.len() * KPOOL + a
            if (slot < R) { sel.set(q2 * R + slot, tstart + a) }
            a = a + 1
        }
        q2 = q2 + 1
    }
    selline = "sel"
    q2 = 0
    while (q2 < R) {
        selline = selline + " q" + q2.to_string() + "=["
        first = 1
        i = 0
        while (i < R) {
            tv = sel.get(q2 * R + i)
            if (tv >= 0) {
                if (first == 0) { selline = selline + "," }
                selline = selline + tv.to_string()
                first = 0
            }
            i = i + 1
        }
        selline = selline + "]"
        q2 = q2 + 1
    }
    lines = lines + selline + "\n"
    println(selline)

    # ---- masked MLA attention per head, then o_proj ----
    # probs[q][h][i] is materialised once per (query, head): the naive form recomputed the
    # q·k dot inside the value loop, which is O(R^2 * H * VDIM * NOPE) and never finishes.
    sc_scale = 1.0 / vsqrt(NOPE as Float, 40)
    probs<Vec<Float>> = Vec()
    d2 = 0
    while (d2 < R * HEADS * R) {
        probs.push(0.0)
        d2 = d2 + 1
    }
    hh = 0
    while (hh < HEADS) {
        q2 = 0
        while (q2 < R) {
            mx = 0.0 - 1e30
            i = 0
            while (i < R) {
                if (sel.get(q2 * R + i) >= 0) {
                    dot = 0.0
                    c = 0
                    while (c < NOPE) {
                        dot = dot + qfull.get((q2 * HEADS + hh) * NOPE + c) *
                                    K.get((i * HEADS + hh) * NOPE + c)
                        c = c + 1
                    }
                    sv = dot * sc_scale
                    if (sv > mx) { mx = sv }
                }
                i = i + 1
            }
            sm = 0.0
            i = 0
            while (i < R) {
                if (sel.get(q2 * R + i) >= 0) {
                    dot = 0.0
                    c = 0
                    while (c < NOPE) {
                        dot = dot + qfull.get((q2 * HEADS + hh) * NOPE + c) *
                                    K.get((i * HEADS + hh) * NOPE + c)
                        c = c + 1
                    }
                    sm = sm + vexp(dot * sc_scale - mx)
                }
                i = i + 1
            }
            i = 0
            while (i < R) {
                if (sel.get(q2 * R + i) >= 0) {
                    dot = 0.0
                    c = 0
                    while (c < NOPE) {
                        dot = dot + qfull.get((q2 * HEADS + hh) * NOPE + c) *
                                    K.get((i * HEADS + hh) * NOPE + c)
                        c = c + 1
                    }
                    probs.set((q2 * HEADS + hh) * R + i, vexp(dot * sc_scale - mx) / sm)
                }
                i = i + 1
            }
            q2 = q2 + 1
        }
        hh = hh + 1
    }
    ao<Vec<Float>> = Vec()
    d2 = 0
    while (d2 < R * HEADS * VDIM) {
        ao.push(0.0)
        d2 = d2 + 1
    }
    hh = 0
    while (hh < HEADS) {
        q2 = 0
        while (q2 < R) {
            c = 0
            while (c < VDIM) {
                acc = 0.0
                i = 0
                while (i < R) {
                    pv = probs.get((q2 * HEADS + hh) * R + i)
                    if (pv != 0.0) {
                        acc = acc + pv * V.get((i * HEADS + hh) * VDIM + c)
                    }
                    i = i + 1
                }
                ao.set((q2 * HEADS + hh) * VDIM + c, acc)
                c = c + 1
            }
            q2 = q2 + 1
        }
        hh = hh + 1
    }
    println(digest("ao", ao))
    lines = lines + digest("ao", ao) + "\n"
    attn<Vec<Float>> = mm_host(ao, R, HEADS * VDIM, d_o, H, fgemm)
    println(digest("attn", attn))
    lines = lines + digest("attn", attn) + "\n"

    return attn
}

# dsa_attn_site, passing the cache borrows through to attn_site_c.

dsa_attn_site_c(streams0<Vec<Float>>, dir<String>, total<Int>, lpre<String>, fgemm<Int>, fbf<Int>, fdeq<Int>, fhgen<Int>, fhad1<Int>, fhad2<Int>, mapbody<String>, ckv_out<their<Vec<Float>>>, ik_out<their<Vec<Float>>>, gsc_out<their<Vec<Float>>>, slot<Int>)<Vec<Float>> -> {
    nonev<Vec<Float>> = Vec()
    i<Int> = 0
    j<Int> = 0
    nfound<Int> = 0
    d_fnA<Int> = 0
    d_flat<Int> = 0
    d_mv<Int> = 0
    d_scr<Int> = 0
    # ---- hc_attn mix -> collapsed -> input_layernorm -> h_a ----
    w<Vec<String>> = Vec()
    w.push(lpre + "hc_attn_fn")
    w.push(lpre + "hc_attn_base")
    w.push(lpre + "hc_attn_scale")
    w.push(lpre + "input_layernorm.weight")
    g<GxLoc> = gx_resolve(dir, total, w)
    j = 0
    while (j < w.len()) {
        if (g.found.get(j) == 1) { nfound = nfound + 1 }
        j = j + 1
    }
    if (nfound != w.len()) { println("FULL_FAIL resolve " + nfound.to_string()); return nonev }


    d_fnA = deq_bf16(fbf, gx_read(g, 0), 24 * HC * H, HC * H)
    if (d_fnA == 0) { return nonev }
    baseA<Vec<Float>> = Vec()
    raw_baseA = gx_read(g, 1)
    j = 0
    while (j < 24) {
        baseA.push(f32_at(raw_baseA, j))
        j = j + 1
    }
    scaleA<Vec<Float>> = Vec()
    raw_scaleA = gx_read(g, 2)
    j = 0
    while (j < 3) {
        scaleA.push(f32_at(raw_scaleA, j))
        j = j + 1
    }
    d_lnA = deq_bf16(fbf, gx_read(g, 3), H, 0)
    in_ln<Vec<Float>> = bulk_dtoh(d_lnA, H)

    flat<Vec<Float>> = rms_rows(streams0, R, HC * H, Vec())
    d_flat = alloc_dev(R * HC * H * 8)
    d_mv = alloc_dev(R * 24 * 8)
    d_scr = alloc_dev(64)
    if (d_flat == 0 || d_mv == 0 || d_scr == 0) { return nonev }
    bulk_htod(d_flat, view(flat))
    if (gemm(fgemm, d_scr, d_flat, d_fnA, d_mv, R, 24, HC * H, 1.0, 0.0) != 0) { return nonev }
    sync()
    mv<Vec<Float>> = bulk_dtoh(d_mv, R * 24)
    free_dev(d_flat)
    free_dev(d_mv)
    free_dev(d_scr)
    free_dev(d_fnA)

    resA<Vec<Float>> = hc_glue(mv, baseA, scaleA, streams0)
    collapsed<Vec<Float>> = Vec()
    i = 0
    while (i < R * H) {
        collapsed.push(resA.get(i))
        i = i + 1
    }
    postA<Vec<Float>> = Vec()
    i = 0
    while (i < R * HC) {
        postA.push(resA.get(R * H + i))
        i = i + 1
    }
    combA<Vec<Float>> = Vec()
    i = 0
    while (i < R * HC * HC) {
        combA.push(resA.get(R * H + R * HC + i))
        i = i + 1
    }
    h_a<Vec<Float>> = rms_rows(collapsed, R, H, in_ln)
    lines<String> = ""

    # ---- attention site (verbatim from glm_l3_attn_fwd.vyb) ----
    attn<Vec<Float>> = attn_site_c(h_a, lpre, fgemm, fbf, ckv_out, ik_out, gsc_out, slot)
    println(digest("attn", attn))
    lines = lines + digest("h_a", h_a) + "\n" + digest("attn", attn) + "\n"

    # ---- join: hc_apply -> streams1 ----
    streams1<Vec<Float>> = hc_apply(streams0, attn, postA, combA)
    println(digest("streams1", streams1))
    lines = lines + digest("streams1", streams1) + "\n"
    return streams1
}

# kda_attn_site + conv-ring capture (the last 3 PRE-conv rows, oldest first) and the
# recurrence-state capture through delta_rule_cap.

kda_attn_site_c(streams<Vec<Float>>, dir<String>, total<Int>, lpre<String>, fgemm<Int>, fbf<Int>, st_out<their<Vec<Float>>>, capslot<Int>, rq_out<their<Vec<Float>>>, rk_out<their<Vec<Float>>>, rv_out<their<Vec<Float>>>)<Vec<Float>> -> {
    nonev<Vec<Float>> = Vec()
    lines<String> = ""
    nf<Int> = 0
    idtxt<String> = ""
    cur<String> = ""
    ch<String> = ""
    emb_off<Int> = 0
    emb_path<String> = ""
    raw_emb<String> = ""
    r<Int> = 0
    hh<Int> = 0
    d<Int> = 0
    raw_base<String> = ""
    raw_scale<String> = ""
    d_q<Int> = 0
    d_k<Int> = 0
    d_v<Int> = 0
    d_o<Int> = 0
    d_b<Int> = 0
    d_fa<Int> = 0
    d_fb<Int> = 0
    d_ga<Int> = 0
    d_gb<Int> = 0
    raw_dt<String> = ""
    raw_alog<String> = ""
    d_onorm<Int> = 0
    d_ln2<Int> = 0
    d_gate<Int> = 0
    d_up<Int> = 0
    d_down<Int> = 0
    lines = ""
    nf = 0
    want<Vec<String>> = Vec()
    want.push(lpre + "self_attn.q_proj.weight")
    want.push(lpre + "self_attn.k_proj.weight")
    want.push(lpre + "self_attn.v_proj.weight")
    want.push(lpre + "self_attn.o_proj.weight")
    want.push(lpre + "self_attn.b_proj.weight")
    want.push(lpre + "self_attn.f_a_proj.weight")
    want.push(lpre + "self_attn.f_b_proj.weight")
    want.push(lpre + "self_attn.g_a_proj.weight")
    want.push(lpre + "self_attn.g_b_proj.weight")
    want.push(lpre + "self_attn.o_norm.weight")
    want.push(lpre + "self_attn.dt_bias")
    want.push(lpre + "self_attn.A_log")
    want.push(lpre + "input_layernorm.weight")
    want.push(lpre + "post_attention_layernorm.weight")
    want.push(lpre + "hc_attn_fn")
    want.push(lpre + "hc_attn_base")
    want.push(lpre + "hc_attn_scale")
    want.push(lpre + "hc_ffn_fn")
    want.push(lpre + "hc_ffn_base")
    want.push(lpre + "hc_ffn_scale")
    want.push("model.language_model.embed_tokens.weight")
    want.push(lpre + "self_attn.q_conv1d.weight")
    want.push(lpre + "self_attn.k_conv1d.weight")
    want.push(lpre + "self_attn.v_conv1d.weight")

    g<GxLoc> = gx_resolve(dir, total, want)
    i = 0
    while (i < want.len()) {
        if (g.found.get(i) == 1) { nf = nf + 1 }
        i = i + 1
    }
    if (nf != want.len()) { println("L0_FAIL resolve " + nf.to_string()); return nonev }

    if (tensor_init() != 0) { println("L0_FAIL no cuda"); return nonev }
    fgemm = load_fn("native/build/gemm.ptx", "gemm")
    fbf = load_fn("native/build/bf16.ptx", "bf16deq")
    if (fgemm == 0) { println("L0_FAIL gemm.ptx (make gemm)"); return nonev }
    if (fbf == 0) { println("L0_FAIL bf16.ptx (make bf16)"); return nonev }

# ---------------------------------------------------------------- hc mix (attn)
    var<Int> d_fnA = 0
    var<Int> d_fnF = 0
    d_fnA = deq_bf16(fbf, gx_read(g, 14), 24 * HC * H, HC * H)
    if (d_fnA == 0) { return nonev }
    d_fnF = deq_bf16(fbf, gx_read(g, 17), 24 * HC * H, HC * H)
    if (d_fnF == 0) { return nonev }
    base<Vec<Float>> = Vec()
    raw_base = gx_read(g, 15)
    j = 0
    while (j < 24) {
        base.push(f32_at(raw_base, j))
        j = j + 1
    }
    scale<Vec<Float>> = Vec()
    raw_scale = gx_read(g, 16)
    j = 0
    while (j < 3) {
        scale.push(f32_at(raw_scale, j))
        j = j + 1
    }
    baseF<Vec<Float>> = Vec()
    raw_baseF<String> = gx_read(g, 18)
    j = 0
    while (j < 24) {
        baseF.push(f32_at(raw_baseF, j))
        j = j + 1
    }
    scaleF<Vec<Float>> = Vec()
    raw_scaleF<String> = gx_read(g, 19)
    j = 0
    while (j < 3) {
        scaleF.push(f32_at(raw_scaleF, j))
        j = j + 1
    }
    println("hc attn base0=" + di(base.get(0)).to_string() + " scale0=" + di(scale.get(0)).to_string())

    # ---------------------------------------------------------------- hc mix via gemm
    # flat = rms(streams flat) ; mv = flat @ fn^T  ([R,4H] @ [4H,24])
    flat<Vec<Float>> = Vec()
    i = 0
    while (i < streams.len()) {
        flat.push(streams.get(i))
        i = i + 1
    }
    flat = rms_rows(flat, R, HC * H, Vec())
    var<Int> d_flat = 0
    var<Int> d_mv = 0
    var<Int> d_scr = 0
    d_flat = alloc_dev(R * HC * H * 8)
    d_mv = alloc_dev(R * 24 * 8)
    d_scr = alloc_dev(64)
    if (d_flat == 0 || d_mv == 0 || d_scr == 0) { println("L0_FAIL alloc"); return nonev }
    bulk_htod(d_flat, view(flat))
    if (gemm(fgemm, d_scr, d_flat, d_fnA, d_mv, R, 24, HC * H, 1.0, 0.0) != 0) { return nonev }
    sync()
    mv<Vec<Float>> = bulk_dtoh(d_mv, R * 24)
    free_dev(d_flat)
    free_dev(d_mv)
    free_dev(d_scr)
    println(digest("mv_attn", mv))
    lines = lines + digest("mv_attn", mv) + "\n"

    res<Vec<Float>> = hc_glue(mv, base, scale, streams)
    collapsed<Vec<Float>> = Vec()
    i = 0
    while (i < R * H) {
        collapsed.push(res.get(i))
        i = i + 1
    }
    postA<Vec<Float>> = Vec()
    i = 0
    while (i < R * HC) {
        postA.push(res.get(R * H + i))
        i = i + 1
    }
    combA<Vec<Float>> = Vec()
    i = 0
    while (i < R * HC * HC) {
        combA.push(res.get(R * H + R * HC + i))
        i = i + 1
    }
    println(digest("collapsed", collapsed))
    lines = lines + digest("collapsed", collapsed) + "\n"
    println(digest("post_attn", postA))
    lines = lines + digest("post_attn", postA) + "\n"
    println(digest("comb_attn", combA))
    lines = lines + digest("comb_attn", combA) + "\n"
    lines = lines + dumps("combvals", combA) + "\n"

    # ---------------------------------------------------------------- input_layernorm
    var<Int> d_ln = 0
    d_ln = deq_bf16(fbf, gx_read(g, 12), H, 0)
    if (d_ln == 0) { return nonev }
    in_ln<Vec<Float>> = bulk_dtoh(d_ln, H)
    free_dev(d_ln)
    h_a<Vec<Float>> = rms_rows(collapsed, R, H, in_ln)
    println(digest("h", h_a))
    lines = lines + digest("h", h_a) + "\n"
    # =============================================================== KDA attention
    # projections (host batch [R,H] @ [H,out] on the GPU)
    d_q = deq_bf16(fbf, gx_read(g, 0), H * HEADS * KD, H)
    d_k = deq_bf16(fbf, gx_read(g, 1), H * HEADS * KD, H)
    d_v = deq_bf16(fbf, gx_read(g, 2), H * HEADS * KD, H)
    d_o = deq_bf16(fbf, gx_read(g, 3), HEADS * KD * H, HEADS * KD)
    d_b = deq_bf16(fbf, gx_read(g, 4), H * HEADS, H)
    d_fa = deq_bf16(fbf, gx_read(g, 5), H * 128, H)
    d_fb = deq_bf16(fbf, gx_read(g, 6), 128 * HEADS * KD, 128)
    d_ga = deq_bf16(fbf, gx_read(g, 7), H * 128, H)
    d_gb = deq_bf16(fbf, gx_read(g, 8), 128 * HEADS * KD, 128)
    if (d_q == 0 || d_k == 0 || d_v == 0 || d_o == 0 || d_b == 0 || d_fa == 0 || d_fb == 0 || d_ga == 0 || d_gb == 0) {
        println("L0_FAIL weight deq")
        return nonev
    }
    qp<Vec<Float>> = mm_host(h_a, R, H, d_q, HEADS * KD, fgemm)
    kp<Vec<Float>> = mm_host(h_a, R, H, d_k, HEADS * KD, fgemm)
    vp<Vec<Float>> = mm_host(h_a, R, H, d_v, HEADS * KD, fgemm)
    # chained-decode capture: the k=4 conv's 3-row PRE-conv ring = the last three
    # rows of the batched pre-conv projections (oldest first), per tensor q/k/v.
    capr<Int> = 0
    while (capr < CONV_K - 1) {
        capc<Int> = 0
        while (capc < HEADS * KD) {
            rq_out.set(capslot * (CONV_K - 1) * HEADS * KD + capr * HEADS * KD + capc,
                       qp.get((R - (CONV_K - 1) + capr) * HEADS * KD + capc))
            rk_out.set(capslot * (CONV_K - 1) * HEADS * KD + capr * HEADS * KD + capc,
                       kp.get((R - (CONV_K - 1) + capr) * HEADS * KD + capc))
            rv_out.set(capslot * (CONV_K - 1) * HEADS * KD + capr * HEADS * KD + capc,
                       vp.get((R - (CONV_K - 1) + capr) * HEADS * KD + capc))
            capc = capc + 1
        }
        capr = capr + 1
    }
    println(digest("qpre", qp))
    lines = lines + digest("qpre", qp) + "\n"

    # conv+silu over the token axis, then l2-normalise (q also scaled by 1/sqrt(KD))
    # conv1d weights are BF16 (only dt_bias / A_log / hc base+scale are FP32 here)
    var<Int> t2 = 0
    var<Int> d_cq = 0
    var<Int> d_ck = 0
    var<Int> d_cv = 0
    d_cq = deq_bf16(fbf, gx_read(g, 21), HEADS * KD * CONV_K, 0)
    d_ck = deq_bf16(fbf, gx_read(g, 22), HEADS * KD * CONV_K, 0)
    d_cv = deq_bf16(fbf, gx_read(g, 23), HEADS * KD * CONV_K, 0)
    if (d_cq == 0 || d_ck == 0 || d_cv == 0) { return nonev }
    convq<Vec<Float>> = bulk_dtoh(d_cq, HEADS * KD * CONV_K)
    convk<Vec<Float>> = bulk_dtoh(d_ck, HEADS * KD * CONV_K)
    convv<Vec<Float>> = bulk_dtoh(d_cv, HEADS * KD * CONV_K)
    free_dev(d_cq)
    free_dev(d_ck)
    free_dev(d_cv)
    qc<Vec<Float>> = conv_silu(qp, R, HEADS * KD, convq)
    kc<Vec<Float>> = conv_silu(kp, R, HEADS * KD, convk)
    vc<Vec<Float>> = conv_silu(vp, R, HEADS * KD, convv)
    println(digest("qc", qc))
    lines = lines + digest("qc", qc) + "\n"
    println(digest("vc", vc))
    lines = lines + digest("vc", vc) + "\n"
    qn<Vec<Float>> = l2_rows(qc, R * HEADS, KD)
    kn<Vec<Float>> = l2_rows(kc, R * HEADS, KD)
    t2 = 0
    while (t2 < qn.len()) {
        qn.set(t2, qn.get(t2) * (1.0 / vsqrt(KD as Float, 40)))
        t2 = t2 + 1
    }

    println(digest("qn", qn))
    lines = lines + digest("qn", qn) + "\n"
    lines = lines + dumps("qnvals", qn) + "\n"
    println(digest("kn", kn))
    lines = lines + digest("kn", kn) + "\n"
    bet<Vec<Float>> = mm_host(h_a, R, H, d_b, HEADS, fgemm)
    t2 = 0
    while (t2 < bet.len()) {
        bet.set(t2, sigmoid(bet.get(t2)))
        t2 = t2 + 1
    }

    println(digest("beta", bet))
    lines = lines + digest("beta", bet) + "\n"
    fa<Vec<Float>> = mm_host(h_a, R, H, d_fa, 128, fgemm)
    fraw<Vec<Float>> = mm_host(fa, R, 128, d_fb, HEADS * KD, fgemm)
    ga<Vec<Float>> = mm_host(h_a, R, H, d_ga, 128, fgemm)
    zraw<Vec<Float>> = mm_host(ga, R, 128, d_gb, HEADS * KD, fgemm)

    raw_dt = gx_read(g, 10)          # FP32 in the checkpoint
    dt<Vec<Float>> = Vec()
    t2 = 0
    while (t2 < HEADS * KD) {
        dt.push(f32_at(raw_dt, t2))
        t2 = t2 + 1
    }
    raw_alog = gx_read(g, 11)
    alog<Vec<Float>> = Vec()
    t2 = 0
    while (t2 < HEADS) {
        alog.push(f32_at(raw_alog, t2))
        t2 = t2 + 1
    }
    println(digest("fraw", fraw))
    lines = lines + digest("fraw", fraw) + "\n"
    println(digest("zraw", zraw))
    lines = lines + digest("zraw", zraw) + "\n"
    gdec<Vec<Float>> = log_decay(fraw, dt, alog)
    println(digest("gdec", gdec))
    lines = lines + digest("gdec", gdec) + "\n"

    att<Vec<Float>> = delta_rule_cap(qn, kn, vc, gdec, bet, st_out, capslot)
    println(digest("delta", att))
    lines = lines + digest("delta", att) + "\n"

    d_onorm = deq_bf16(fbf, gx_read(g, 9), KD, 0)
    if (d_onorm == 0) { return nonev }
    onorm<Vec<Float>> = bulk_dtoh(d_onorm, KD)
    free_dev(d_onorm)
    gnorm<Vec<Float>> = gated_norm(att, zraw, onorm)
    attn<Vec<Float>> = mm_host(gnorm, R, HEADS * KD, d_o, H, fgemm)
    println(digest("attn", attn))
    lines = lines + digest("attn", attn) + "\n"

    streams1<Vec<Float>> = hc_apply(streams, attn, postA, combA)
    println(digest("streams1", streams1))
    lines = lines + digest("streams1", streams1) + "\n"
    free_dev(d_q)
    free_dev(d_k)
    free_dev(d_v)
    free_dev(d_o)
    free_dev(d_b)
    free_dev(d_fa)
    free_dev(d_fb)
    free_dev(d_ga)
    free_dev(d_gb)
    free_dev(d_fnA)


    return streams1
}

# ffn_dense_site / tail_site: verbatim (no carried state).

share(all)
ffn_dense_site(streams1<Vec<Float>>, dir<String>, total<Int>, lpre<String>, fgemm<Int>, fbf<Int>)<Vec<Float>> -> {
    nonev<Vec<Float>> = Vec()
    lines<String> = ""
    nf<Int> = 0
    idtxt<String> = ""
    cur<String> = ""
    ch<String> = ""
    emb_off<Int> = 0
    emb_path<String> = ""
    raw_emb<String> = ""
    r<Int> = 0
    hh<Int> = 0
    d<Int> = 0
    raw_base<String> = ""
    raw_scale<String> = ""
    d_q<Int> = 0
    d_k<Int> = 0
    d_v<Int> = 0
    d_o<Int> = 0
    d_b<Int> = 0
    d_fa<Int> = 0
    d_fb<Int> = 0
    d_ga<Int> = 0
    d_gb<Int> = 0
    raw_dt<String> = ""
    raw_alog<String> = ""
    d_onorm<Int> = 0
    d_ln2<Int> = 0
    d_gate<Int> = 0
    d_up<Int> = 0
    d_down<Int> = 0
    lines = ""
    nf = 0
    want<Vec<String>> = Vec()
    want.push(lpre + "mlp.gate_proj.weight")
    want.push(lpre + "mlp.up_proj.weight")
    want.push(lpre + "mlp.down_proj.weight")
    want.push(lpre + "post_attention_layernorm.weight")
    want.push(lpre + "hc_ffn_fn")
    want.push(lpre + "hc_ffn_base")
    want.push(lpre + "hc_ffn_scale")

    g<GxLoc> = gx_resolve(dir, total, want)
    i = 0
    while (i < want.len()) {
        if (g.found.get(i) == 1) { nf = nf + 1 }
        i = i + 1
    }
    if (nf != want.len()) { println("L0_FAIL resolve " + nf.to_string()); return nonev }

    if (tensor_init() != 0) { println("L0_FAIL no cuda"); return nonev }
    fgemm = load_fn("native/build/gemm.ptx", "gemm")
    fbf = load_fn("native/build/bf16.ptx", "bf16deq")
    if (fgemm == 0) { println("L0_FAIL gemm.ptx (make gemm)"); return nonev }
    if (fbf == 0) { println("L0_FAIL bf16.ptx (make bf16)"); return nonev }

    d_fnF<Int> = deq_bf16(fbf, gx_read(g, 4), 24 * HC * H, HC * H)
    if (d_fnF == 0) { return nonev }
    baseF<Vec<Float>> = Vec()
    raw_baseF = gx_read(g, 5)
    j = 0
    while (j < 24) {
        baseF.push(f32_at(raw_baseF, j))
        j = j + 1
    }
    scaleF<Vec<Float>> = Vec()
    raw_scaleF = gx_read(g, 6)
    j = 0
    while (j < 3) {
        scaleF.push(f32_at(raw_scaleF, j))
        j = j + 1
    }

    # =============================================================== ffn site + MLP
    d_ln2 = deq_bf16(fbf, gx_read(g, 3), H, 0)
    if (d_ln2 == 0) { return nonev }
    post_ln<Vec<Float>> = bulk_dtoh(d_ln2, H)
    free_dev(d_ln2)

    var<Int> d_flat2 = 0
    var<Int> d_mv2 = 0
    var<Int> d_scr2 = 0
    reflat<Vec<Float>> = Vec()
    t2 = 0
    while (t2 < streams1.len()) {
        reflat.push(streams1.get(t2))
        t2 = t2 + 1
    }
    reflat = rms_rows(reflat, R, HC * H, Vec())
    d_flat2 = alloc_dev(R * HC * H * 8)
    d_mv2 = alloc_dev(R * 24 * 8)
    d_scr2 = alloc_dev(64)
    if (d_flat2 == 0 || d_mv2 == 0 || d_scr2 == 0) { return nonev }
    bulk_htod(d_flat2, view(reflat))
    if (gemm(fgemm, d_scr2, d_flat2, d_fnF, d_mv2, R, 24, HC * H, 1.0, 0.0) != 0) { return nonev }
    sync()
    mv2<Vec<Float>> = bulk_dtoh(d_mv2, R * 24)
    free_dev(d_flat2)
    free_dev(d_mv2)
    free_dev(d_scr2)
    free_dev(d_fnF)

    res2<Vec<Float>> = hc_glue(mv2, baseF, scaleF, streams1)
    collapsed2<Vec<Float>> = Vec()
    t2 = 0
    while (t2 < R * H) {
        collapsed2.push(res2.get(t2))
        t2 = t2 + 1
    }
    postF<Vec<Float>> = Vec()
    t2 = 0
    while (t2 < R * HC) {
        postF.push(res2.get(R * H + t2))
        t2 = t2 + 1
    }
    combF<Vec<Float>> = Vec()
    t2 = 0
    while (t2 < R * HC * HC) {
        combF.push(res2.get(R * H + R * HC + t2))
        t2 = t2 + 1
    }
    h2<Vec<Float>> = rms_rows(collapsed2, R, H, post_ln)
    println(digest("h2", h2))
    lines = lines + digest("h2", h2) + "\n"

    d_gate = deq_bf16(fbf, gx_read(g, 0), H * INTER, H)
    d_up = deq_bf16(fbf, gx_read(g, 1), H * INTER, H)
    d_down = deq_bf16(fbf, gx_read(g, 2), INTER * H, INTER)
    if (d_gate == 0 || d_up == 0 || d_down == 0) { return nonev }
    mg<Vec<Float>> = mm_host(h2, R, H, d_gate, INTER, fgemm)
    mu<Vec<Float>> = mm_host(h2, R, H, d_up, INTER, fgemm)
    act<Vec<Float>> = Vec()
    t2 = 0
    while (t2 < mg.len()) {
        act.push(silu(mg.get(t2)) * mu.get(t2))
        t2 = t2 + 1
    }
    mlp<Vec<Float>> = mm_host(act, R, INTER, d_down, H, fgemm)
    println(digest("mlp", mlp))
    lines = lines + digest("mlp", mlp) + "\n"
    free_dev(d_gate)
    free_dev(d_up)
    free_dev(d_down)

    streams2<Vec<Float>> = hc_apply(streams1, mlp, postF, combF)
    println(digest("streams2", streams2))
    lines = lines + digest("streams2", streams2) + "\n"

    return streams2
    return streams2
}

share(all)
tail_site(streams1<Vec<Float>>, lpre<String>, fgemm<Int>, fbf<Int>, fdeq<Int>, fhgen<Int>, fhad1<Int>, fhad2<Int>, mapbody<String>)<Vec<Float>> -> {
    nonev<Vec<Float>> = Vec()
    best<Int> = 0
    bestv<Float> = 0.0
    cv<Float> = 0.0
    d2<Int> = 0
    d_flat2<Int> = 0
    d_ln2<Int> = 0
    d_mv2<Int> = 0
    d_scr2<Int> = 0
    dir<String> = ""
    dup<Int> = 0
    e<Int> = 0
    epre<String> = ""
    g1<Float> = 0.0
    i<Int> = 0
    j<Int> = 0
    k<Int> = 0
    lane<Int> = 0
    lines<String> = ""
    nex<Int> = 0
    nfound<Int> = 0
    nt<Int> = 0
    out<String> = ""
    r<Int> = 0
    raw_bias<String> = ""
    sm<Float> = 0.0
    spath<String> = ""
    tix<Int> = 0
    tk<Int> = 0
    total<Int> = 0
    u1<Float> = 0.0
    wt<Float> = 0.0
    i = 0
    j = 0
    k = 0
    r = 0
    lane = 0
    d2 = 0
    e = 0
    nex = 0
    nt = 0
    g1 = 0.0
    u1 = 0.0
    bestv = 0.0
    cv = 0.0
    sm = 0.0
    best = 0
    total = 0
    nfound = 0
    tix = 0
    tk = 0
    wt = 0.0
    d_flat2 = 0
    d_mv2 = 0
    d_scr2 = 0
    d_fnF<Int> = 0
    d_ln2 = 0
    dup = 0
    ee<Int> = 0
    i0<Int> = 0
    acc_res<Int> = 0
    acc_deq<Int> = 0
    acc_mm<Int> = 0
    acc_host<Int> = 0
    tA<Int> = 0
    tB<Int> = 0
    allw<Vec<String>> = Vec()
    galle<GxLoc> = GxLoc { found = Vec(), shard = Vec(), tix = Vec(), off = Vec(), nbytes = Vec(),
                           dts = Vec(), paths = Vec() }
    dir = env_get("VYBFORGE_GX_DIR") else "/mnt/apex/rick/vybforge/glm53-checkpoint"
    out = env_get("VYBFORGE_L3TAIL_OUT") else "native/out/l3tail_vyb.txt"
    spath = env_get("VYBFORGE_L3_STREAMS1") else "native/out/gold_l3_streams1.txt"
    total = 83

    if (tensor_init() != 0) { println("TAIL_FAIL no cuda"); return nonev }
    if (fgemm == 0 || fdeq == 0 || fhgen == 0 || fhad1 == 0 || fhad2 == 0 || fbf == 0) {
        println("TAIL_FAIL kernels")
        return nonev
    }
    mapd = ""
    match (open_read("native/exl3/map.bin")) {
        f -> { match (read_all(f)) { s -> { mapd = s } ? -> { return nonev } } close(f) }
        ? -> { println("TAIL_FAIL no map.bin"); return nonev }
    }
    body = mapd.substring(16, mapd.len())

    lines = ""
    w<Vec<String>> = Vec()
    w.push(lpre + "hc_ffn_fn")
    w.push(lpre + "hc_ffn_base")
    w.push(lpre + "hc_ffn_scale")
    w.push(lpre + "post_attention_layernorm.weight")
    gt<GxLoc> = gx_resolve(dir, total, w)
    nfound = 0
    j = 0
    while (j < w.len()) {
        if (gt.found.get(j) == 1) { nfound = nfound + 1 }
        j = j + 1
    }
    if (nfound != w.len()) { println("TAIL_FAIL resolve " + nfound.to_string()); return nonev }

    d_fnF = deq_bf16(fbf, gx_read(gt, 0), 24 * HC * H, HC * H)
    if (d_fnF == 0) { return nonev }
    baseF<Vec<Float>> = Vec()
    raw_baseF = gx_read(gt, 1)
    j = 0
    while (j < 24) {
        baseF.push(f32_at(raw_baseF, j))
        j = j + 1
    }
    scaleF<Vec<Float>> = Vec()
    raw_scaleF = gx_read(gt, 2)
    j = 0
    while (j < 3) {
        scaleF.push(f32_at(raw_scaleF, j))
        j = j + 1
    }
    d_ln2 = deq_bf16(fbf, gx_read(gt, 3), H, 0)
    post_ln<Vec<Float>> = bulk_dtoh(d_ln2, H)

    flat<Vec<Float>> = rms_rows(streams1, R, HC * H, Vec())
    d_flat2 = alloc_dev(R * HC * H * 8)
    d_mv2 = alloc_dev(R * 24 * 8)
    d_scr2 = alloc_dev(64)
    if (d_flat2 == 0 || d_mv2 == 0 || d_scr2 == 0) { return nonev }
    bulk_htod(d_flat2, view(flat))
    if (gemm(fgemm, d_scr2, d_flat2, d_fnF, d_mv2, R, 24, HC * H, 1.0, 0.0) != 0) { return nonev }
    sync()
    mv2<Vec<Float>> = bulk_dtoh(d_mv2, R * 24)
    free_dev(d_flat2)
    free_dev(d_mv2)
    free_dev(d_scr2)
    free_dev(d_fnF)

    res2<Vec<Float>> = hc_glue(mv2, baseF, scaleF, streams1)
    collapsed2<Vec<Float>> = Vec()
    i = 0
    while (i < R * H) {
        collapsed2.push(res2.get(i))
        i = i + 1
    }
    post2<Vec<Float>> = Vec()
    i = 0
    while (i < R * HC) {
        post2.push(res2.get(R * H + i))
        i = i + 1
    }
    comb2<Vec<Float>> = Vec()
    i = 0
    while (i < R * HC * HC) {
        comb2.push(res2.get(R * H + R * HC + i))
        i = i + 1
    }
    h2<Vec<Float>> = rms_rows(collapsed2, R, H, post_ln)
    println(digest("h2", h2))
    lines = digest("h2", h2) + "\n"

    # ---- router (same code path as L3_MOE_ROUTE_VYB) ----
    want<Vec<String>> = Vec()
    want.push(lpre + "mlp.gate.weight")
    want.push(lpre + "mlp.gate.e_score_correction_bias")
    g<GxLoc> = gx_resolve(dir, total, want)
    d_gw = deq_bf16(fbf, gx_read(g, 0), NE * H, H)
    if (d_gw == 0) { return nonev }
    logits<Vec<Float>> = mm_host(h2, R, H, d_gw, NE, fgemm)
    freedom {
        cuMemFree_v2(d_gw)
    }
    raw_bias = gx_read(g, 1)
    bias<Vec<Float>> = Vec()
    i = 0
    while (i < NE) {
        bias.push(f32_at(raw_bias, i))
        i = i + 1
    }
    scores<Vec<Float>> = Vec()
    i = 0
    while (i < logits.len()) {
        scores.push(sigmoid(logits.get(i)))
        i = i + 1
    }

    # top-8 per token + renormed weights
    rsel<Vec<Int>> = Vec()        # [R, 8]
    rwt<Vec<Float>> = Vec()       # [R, 8]
    i = 0
    while (i < R * ROUTE_TOPK) {
        rsel.push(-1)
        rwt.push(0.0)
        i = i + 1
    }
    r = 0
    while (r < R) {
        lane = 0
        while (lane < ROUTE_TOPK) {
            best = -1
            bestv = 0.0 - 1e30
            j = 0
            while (j < NE) {
                dup = 0
                k = 0
                while (k < lane) {
                    if (rsel.get(r * ROUTE_TOPK + k) == j) { dup = 1 }
                    k = k + 1
                }
                if (dup == 0) {
                    cv = scores.get(r * NE + j) + bias.get(j)
                    if (cv > bestv) {
                        bestv = cv
                        best = j
                    }
                }
                j = j + 1
            }
            rsel.set(r * ROUTE_TOPK + lane, best)
            lane = lane + 1
        }
        sm = 0.0
        lane = 0
        while (lane < ROUTE_TOPK) {
            sm = sm + scores.get(r * NE + rsel.get(r * ROUTE_TOPK + lane))
            lane = lane + 1
        }
        lane = 0
        while (lane < ROUTE_TOPK) {
            rwt.set(r * ROUTE_TOPK + lane,
                    scores.get(r * NE + rsel.get(r * ROUTE_TOPK + lane)) / (sm + 1e-20) * ROUTED_SCALE)
            lane = lane + 1
        }
        r = r + 1
    }

    # ---- routed experts: one dequant per (expert, projection), FFN on that expert's tokens
    accr<Vec<Float>> = Vec()
    i = 0
    while (i < R * H) {
        accr.push(0.0)
        i = i + 1
    }
    # per expert: which (token, lane) pairs chose it
    done<Vec<Int>> = Vec()
    i = 0
    while (i < NE) {
        done.push(0)
        i = i + 1
    }
    nex = 0
    # NOTE: resolving all 288 experts' 9 tensors in ONE gx_resolve is ~40% cheaper at a single
    # layer (1.4 s vs 2.4 s), but measured in the 12-layer prefill it grows ~1 s per layer
    # (1.7 -> 9.5 s) from the String churn, so at 45 layers it loses badly. Keep per-expert
    # resolution here; the win came from caching the shard header inside gx_resolve and from
    # reading the 15.5 MB index ONCE per layer instead of once per expert.
    idxtext<String> = gx_read_index(dir)
    e = 0
    while (e < NE) {
        # collect this expert's (token, lane) pairs
        toks<Vec<Int>> = Vec()
        lanes<Vec<Int>> = Vec()
        r = 0
        while (r < R) {
            lane = 0
            while (lane < ROUTE_TOPK) {
                if (rsel.get(r * ROUTE_TOPK + lane) == e) {
                    toks.push(r)
                    lanes.push(lane)
                }
                lane = lane + 1
            }
            r = r + 1
        }
        nt = toks.len()
        if (nt > 0) {
            nex = nex + 1
            tA = time_mono_millis()
            epre = lpre + "mlp.experts." + e.to_string() + "."
            w2<Vec<String>> = Vec()
            w2.push(epre + "gate_proj.trellis")
            w2.push(epre + "gate_proj.suh")
            w2.push(epre + "gate_proj.svh")
            w2.push(epre + "up_proj.trellis")
            w2.push(epre + "up_proj.suh")
            w2.push(epre + "up_proj.svh")
            w2.push(epre + "down_proj.trellis")
            w2.push(epre + "down_proj.suh")
            w2.push(epre + "down_proj.svh")
            ge<GxLoc> = gx_resolve_idx(idxtext, dir, total, w2)
            acc_res = acc_res + (time_mono_millis() - tA)
            nfound = 0
            j = 0
            while (j < w2.len()) {
                if (ge.found.get(j) == 1) { nfound = nfound + 1 }
                j = j + 1
            }
            if (nfound != w2.len()) { println("ALL_FAIL resolve expert " + e.to_string()); return nonev }

            tA = time_mono_millis()
            dWg<Int> = exl3_deq(fdeq, fhgen, fhad1, fhad2, gx_read(ge, 0), gx_read(ge, 1),
                                gx_read(ge, 2), body, EINTER, 32768)
            dWu<Int> = exl3_deq(fdeq, fhgen, fhad1, fhad2, gx_read(ge, 3), gx_read(ge, 4),
                                gx_read(ge, 5), body, EINTER, 32768)
            dWd<Int> = exl3_deq(fdeq, fhgen, fhad1, fhad2, gx_read(ge, 6), gx_read(ge, 7),
                                gx_read(ge, 8), body, H, 32768)
            acc_deq = acc_deq + (time_mono_millis() - tA)
            if (dWg == 0 || dWu == 0 || dWd == 0) {
                println("ALL_FAIL deq expert " + e.to_string())
                return nonev
            }

            # gather this expert's token rows
            sub<Vec<Float>> = Vec()
            j = 0
            while (j < nt) {
                tix = toks.get(j) * H
                d2 = 0
                while (d2 < H) {
                    sub.push(h2.get(tix + d2))
                    d2 = d2 + 1
                }
                j = j + 1
            }
            tA = time_mono_millis()
            gv<Vec<Float>> = mm_host(sub, nt, H, dWg, EINTER, fgemm)
            uv<Vec<Float>> = mm_host(sub, nt, H, dWu, EINTER, fgemm)
            act<Vec<Float>> = Vec()
            j = 0
            while (j < gv.len()) {
                g1 = gv.get(j)
                if (g1 > SWIGLU_LIMIT) { g1 = SWIGLU_LIMIT }
                u1 = uv.get(j)
                if (u1 > SWIGLU_LIMIT) { u1 = SWIGLU_LIMIT }
                if (u1 < 0.0 - SWIGLU_LIMIT) { u1 = 0.0 - SWIGLU_LIMIT }
                act.push(silu(g1) * u1)
                j = j + 1
            }
            yv<Vec<Float>> = mm_host(act, nt, EINTER, dWd, H, fgemm)
            acc_mm = acc_mm + (time_mono_millis() - tA)
            # scatter w*y back
            j = 0
            while (j < nt) {
                tk = toks.get(j)
                wt = rwt.get(tk * ROUTE_TOPK + lanes.get(j))
                d2 = 0
                while (d2 < H) {
                    accr.set(tk * H + d2, accr.get(tk * H + d2) + wt * yv.get(j * H + d2))
                    d2 = d2 + 1
                }
                j = j + 1
            }
            freedom {
                cuMemFree_v2(dWg)
                cuMemFree_v2(dWu)
                cuMemFree_v2(dWd)
            }
            if (nex % 10 == 0) {
                println("  experts done " + nex.to_string() + " (last id " + e.to_string() + ")")
            }
        }
        e = e + 1
    }
    println("routed experts used: " + nex.to_string())
    println("T_MOE layer resolve=" + acc_res.to_string() + " deq=" + acc_deq.to_string() + " mm=" + acc_mm.to_string() + " host=" + acc_host.to_string())

    # ---- shared expert ----
    w3<Vec<String>> = Vec()
    w3.push(lpre + "mlp.shared_experts.gate_proj.weight")
    w3.push(lpre + "mlp.shared_experts.up_proj.weight")
    w3.push(lpre + "mlp.shared_experts.down_proj.weight")
    gs<GxLoc> = gx_resolve(dir, total, w3)
    d_sg = deq_bf16(fbf, gx_read(gs, 0), EINTER * H, H)
    d_su = deq_bf16(fbf, gx_read(gs, 1), EINTER * H, H)
    d_sd = deq_bf16(fbf, gx_read(gs, 2), H * EINTER, EINTER)
    if (d_sg == 0 || d_su == 0 || d_sd == 0) { return nonev }
    sgate<Vec<Float>> = mm_host(h2, R, H, d_sg, EINTER, fgemm)
    sup<Vec<Float>> = mm_host(h2, R, H, d_su, EINTER, fgemm)
    sact<Vec<Float>> = Vec()
    i = 0
    while (i < sgate.len()) {
        g1 = sgate.get(i)
        if (g1 > SWIGLU_LIMIT) { g1 = SWIGLU_LIMIT }
        u1 = sup.get(i)
        if (u1 > SWIGLU_LIMIT) { u1 = SWIGLU_LIMIT }
        if (u1 < 0.0 - SWIGLU_LIMIT) { u1 = 0.0 - SWIGLU_LIMIT }
        sact.push(silu(g1) * u1)
        i = i + 1
    }
    shared<Vec<Float>> = mm_host(sact, R, EINTER, d_sd, H, fgemm)
    freedom {
        cuMemFree_v2(d_sg)
        cuMemFree_v2(d_su)
        cuMemFree_v2(d_sd)
    }

    mlp<Vec<Float>> = Vec()
    i = 0
    while (i < R * H) {
        mlp.push(accr.get(i) + shared.get(i))
        i = i + 1
    }


    streams2<Vec<Float>> = hc_apply(streams1, mlp, post2, comb2)
    println(digest("streams2", streams2))
    lines = lines + digest("mlp", mlp) + "\n" + digest("streams2", streams2) + "\n"
    match (open_write("native/out/l3tail_vyb.txt")) {
        f -> { write_str(f, lines); close(f) }
        ? -> { }
    }

    return streams2
}

# ============================================================ phase-2 KDA step math
# Verbatim from glm_decode_step.vyb (DEC_STEP_VYB gated): the one-token causal conv
# step and the recurrence step that takes the carried state in. Both are R-generic;
# phase 2 runs them with the global R = 1.

# ONE token through the causal k=4 depthwise conv + silu.
# x is the current token's PRE-conv vector [C]; ring is [CONV_K-1, C], oldest first.
# weight[c*CONV_K + j], j = CONV_K-1 applies to the current token (pinned by the gold).
# Returns out [C] followed by the new ring [CONV_K-1, C].
conv1_step(x<Vec<Float>>, ring<Vec<Float>>, w<Vec<Float>>)<Vec<Float>> -> {
    res<Vec<Float>> = Vec()
    c<Int> = 0
    j<Int> = 0
    while (c < HEADS * KD) {
        acc<Float> = 0.0
        j = 0
        while (j < CONV_K) {
            src<Int> = j - (CONV_K - 1)
            xv<Float> = x.get(c)
            if (src < 0) { xv = ring.get((src + CONV_K - 1) * (HEADS * KD) + c) }
            acc = acc + xv * w.get(c * CONV_K + j)
            j = j + 1
        }
        res.push(silu(acc))
        c = c + 1
    }
    j = 1
    while (j < CONV_K) {
        c = 0
        while (c < HEADS * KD) {
            xv<Float> = x.get(c)
            if (j < CONV_K - 1) { xv = ring.get(j * (HEADS * KD) + c) }
            res.push(xv)
            c = c + 1
        }
        j = j + 1
    }
    return res
}

# the KDA delta-rule recurrence for ONE token, taking the carried state in and returning it.
# q,k,v,g [R,HEADS,KD] (R=1), beta [R,HEADS]; st0 [HEADS,KD,KD] row-major.
# Returns out [R*HEADS*KD] followed by the updated state [HEADS*KD*KD].
delta_rule_step(q<Vec<Float>>, k<Vec<Float>>, v<Vec<Float>>, g<Vec<Float>>,
                beta<Vec<Float>>, st0<their<Vec<Float> const>>)<Vec<Float>> -> {
    out<Vec<Float>> = Vec()
    st<Vec<Float>> = Vec()
    var<Int> n = 0
    while (n < HEADS * KD * KD) {
        st.push(st0.get(n))
        n = n + 1
    }
    n = 0
    while (n < R * HEADS * KD) {
        out.push(0.0)
        n = n + 1
    }
    r<Int> = 0
    h<Int> = 0
    a<Int> = 0
    b<Int> = 0
    while (r < R) {
        h = 0
        while (h < HEADS) {
            # decay the whole state block by exp(g)
            a = 0
            while (a < KD) {
                ge<Float> = vexp(g.get((r * HEADS + h) * KD + a))
                b = 0
                while (b < KD) {
                    st.set((h * KD + a) * KD + b, st.get((h * KD + a) * KD + b) * ge)
                    b = b + 1
                }
                a = a + 1
            }
            be<Float> = beta.get(r * HEADS + h)
            # one sweep over v-channels: delta, state update, read-out (numpy's order)
            b = 0
            while (b < KD) {
                kvb<Float> = 0.0
                a = 0
                while (a < KD) {
                    kvb = kvb + st.get((h * KD + a) * KD + b) * k.get((r * HEADS + h) * KD + a)
                    a = a + 1
                }
                dl<Float> = (v.get((r * HEADS + h) * KD + b) - kvb) * be
                a = 0
                while (a < KD) {
                    st.set((h * KD + a) * KD + b,
                           st.get((h * KD + a) * KD + b) + k.get((r * HEADS + h) * KD + a) * dl)
                    a = a + 1
                }
                rd<Float> = 0.0
                a = 0
                while (a < KD) {
                    rd = rd + st.get((h * KD + a) * KD + b) * q.get((r * HEADS + h) * KD + a)
                    a = a + 1
                }
                out.set((r * HEADS + h) * KD + b, rd)
                b = b + 1
            }
            h = h + 1
        }
        r = r + 1
    }
    n = 0
    while (n < st.len()) {
        out.push(st.get(n))
        n = n + 1
    }
    return out
}

# ============================================================ phase-2 MoE tail (one token)
# tail_site's body for R = 1, with the map body passed in (no re-read per layer) and
# no file writes. Resolves the hc_ffn triple + post LN from `gt` (the caller's layer
# GxLoc, KDA-MoE want-list order), the router and shared expert by their own small
# resolves, and each USED expert lazily by 9 names (the drift-safe per-expert form).
moe_tail_step(streams1<Vec<Float>>, lpre<String>, dir<String>, total<Int>, idxtext<String>, mapbody<String>,
              gt<GxLoc>, fgemm<Int>, fbf<Int>, fdeq<Int>, fhgen<Int>, fhad1<Int>, fhad2<Int>)<Vec<Float>> -> {
    nonev<Vec<Float>> = Vec()
    best<Int> = 0
    bestv<Float> = 0.0
    cv<Float> = 0.0
    d2<Int> = 0
    d_flat2<Int> = 0
    d_mv2<Int> = 0
    d_scr2<Int> = 0
    dup<Int> = 0
    e<Int> = 0
    epre<String> = ""
    g1<Float> = 0.0
    i<Int> = 0
    j<Int> = 0
    k<Int> = 0
    lane<Int> = 0
    nex<Int> = 0
    nfound<Int> = 0
    nt<Int> = 0
    r<Int> = 0
    raw_bias<String> = ""
    sm<Float> = 0.0
    tix<Int> = 0
    tk<Int> = 0
    u1<Float> = 0.0
    wt<Float> = 0.0
    i0<Int> = 0
    d_fnF<Int> = 0
    d_ln2<Int> = 0
    body<String> = mapbody

    d_fnF = deq_bf16(fbf, gx_read(gt, 17), 24 * HC * H, HC * H)
    if (d_fnF == 0) { return nonev }
    baseF<Vec<Float>> = Vec()
    raw_baseF<String> = gx_read(gt, 18)
    j = 0
    while (j < 24) {
        baseF.push(f32_at(raw_baseF, j))
        j = j + 1
    }
    scaleF<Vec<Float>> = Vec()
    raw_scaleF<String> = gx_read(gt, 19)
    j = 0
    while (j < 3) {
        scaleF.push(f32_at(raw_scaleF, j))
        j = j + 1
    }
    d_ln2 = deq_bf16(fbf, gx_read(gt, 13), H, 0)
    if (d_ln2 == 0) { return nonev }
    post_ln<Vec<Float>> = bulk_dtoh(d_ln2, H)
    free_dev(d_ln2)

    flat<Vec<Float>> = rms_rows(streams1, R, HC * H, Vec())
    d_flat2 = alloc_dev(R * HC * H * 8)
    d_mv2 = alloc_dev(R * 24 * 8)
    d_scr2 = alloc_dev(64)
    if (d_flat2 == 0 || d_mv2 == 0 || d_scr2 == 0) { return nonev }
    bulk_htod(d_flat2, view(flat))
    if (gemm(fgemm, d_scr2, d_flat2, d_fnF, d_mv2, R, 24, HC * H, 1.0, 0.0) != 0) { return nonev }
    sync()
    mv2<Vec<Float>> = bulk_dtoh(d_mv2, R * 24)
    free_dev(d_flat2)
    free_dev(d_mv2)
    free_dev(d_scr2)
    free_dev(d_fnF)

    res2<Vec<Float>> = hc_glue(mv2, baseF, scaleF, streams1)
    collapsed2<Vec<Float>> = Vec()
    i = 0
    while (i < R * H) {
        collapsed2.push(res2.get(i))
        i = i + 1
    }
    post2<Vec<Float>> = Vec()
    i = 0
    while (i < R * HC) {
        post2.push(res2.get(R * H + i))
        i = i + 1
    }
    comb2<Vec<Float>> = Vec()
    i = 0
    while (i < R * HC * HC) {
        comb2.push(res2.get(R * H + R * HC + i))
        i = i + 1
    }
    h2<Vec<Float>> = rms_rows(collapsed2, R, H, post_ln)

    # ---- router (same code path as L3_MOE_ROUTE_VYB) ----
    want<Vec<String>> = Vec()
    want.push(lpre + "mlp.gate.weight")
    want.push(lpre + "mlp.gate.e_score_correction_bias")
    g<GxLoc> = gx_resolve_idx(idxtext, dir, total, want)
    d_gw<Int> = deq_bf16(fbf, gx_read(g, 0), NE * H, H)
    if (d_gw == 0) { return nonev }
    logits<Vec<Float>> = mm_host(h2, R, H, d_gw, NE, fgemm)
    freedom {
        cuMemFree_v2(d_gw)
    }
    raw_bias = gx_read(g, 1)
    bias<Vec<Float>> = Vec()
    i = 0
    while (i < NE) {
        bias.push(f32_at(raw_bias, i))
        i = i + 1
    }
    scores<Vec<Float>> = Vec()
    i = 0
    while (i < logits.len()) {
        scores.push(sigmoid(logits.get(i)))
        i = i + 1
    }

    # top-8 per token + renormed weights
    rsel<Vec<Int>> = Vec()        # [R, 8]
    rwt<Vec<Float>> = Vec()       # [R, 8]
    i = 0
    while (i < R * ROUTE_TOPK) {
        rsel.push(-1)
        rwt.push(0.0)
        i = i + 1
    }
    r = 0
    while (r < R) {
        lane = 0
        while (lane < ROUTE_TOPK) {
            best = -1
            bestv = 0.0 - 1e30
            j = 0
            while (j < NE) {
                dup = 0
                k = 0
                while (k < lane) {
                    if (rsel.get(r * ROUTE_TOPK + k) == j) { dup = 1 }
                    k = k + 1
                }
                if (dup == 0) {
                    cv = scores.get(r * NE + j) + bias.get(j)
                    if (cv > bestv) {
                        bestv = cv
                        best = j
                    }
                }
                j = j + 1
            }
            rsel.set(r * ROUTE_TOPK + lane, best)
            lane = lane + 1
        }
        sm = 0.0
        lane = 0
        while (lane < ROUTE_TOPK) {
            sm = sm + scores.get(r * NE + rsel.get(r * ROUTE_TOPK + lane))
            lane = lane + 1
        }
        lane = 0
        while (lane < ROUTE_TOPK) {
            rwt.set(r * ROUTE_TOPK + lane,
                    scores.get(r * NE + rsel.get(r * ROUTE_TOPK + lane)) / (sm + 1e-20) * ROUTED_SCALE)
            lane = lane + 1
        }
        r = r + 1
    }

    # ---- routed experts: one dequant per (expert, projection), FFN on that expert's tokens
    accr<Vec<Float>> = Vec()
    i = 0
    while (i < R * H) {
        accr.push(0.0)
        i = i + 1
    }
    nex = 0
    e = 0
    while (e < NE) {
        toks<Vec<Int>> = Vec()
        lanes<Vec<Int>> = Vec()
        r = 0
        while (r < R) {
            lane = 0
            while (lane < ROUTE_TOPK) {
                if (rsel.get(r * ROUTE_TOPK + lane) == e) {
                    toks.push(r)
                    lanes.push(lane)
                }
                lane = lane + 1
            }
            r = r + 1
        }
        nt = toks.len()
        if (nt > 0) {
            nex = nex + 1
            epre = lpre + "mlp.experts." + e.to_string() + "."
            w2<Vec<String>> = Vec()
            w2.push(epre + "gate_proj.trellis")
            w2.push(epre + "gate_proj.suh")
            w2.push(epre + "gate_proj.svh")
            w2.push(epre + "up_proj.trellis")
            w2.push(epre + "up_proj.suh")
            w2.push(epre + "up_proj.svh")
            w2.push(epre + "down_proj.trellis")
            w2.push(epre + "down_proj.suh")
            w2.push(epre + "down_proj.svh")
            ge<GxLoc> = gx_resolve_idx(idxtext, dir, total, w2)
            nfound = 0
            j = 0
            while (j < w2.len()) {
                if (ge.found.get(j) == 1) { nfound = nfound + 1 }
                j = j + 1
            }
            if (nfound != w2.len()) { println("CHAIN_FAIL resolve expert " + e.to_string()); return nonev }

            dWg<Int> = exl3_deq(fdeq, fhgen, fhad1, fhad2, gx_read(ge, 0), gx_read(ge, 1),
                                gx_read(ge, 2), body, EINTER, 32768)
            dWu<Int> = exl3_deq(fdeq, fhgen, fhad1, fhad2, gx_read(ge, 3), gx_read(ge, 4),
                                gx_read(ge, 5), body, EINTER, 32768)
            dWd<Int> = exl3_deq(fdeq, fhgen, fhad1, fhad2, gx_read(ge, 6), gx_read(ge, 7),
                                gx_read(ge, 8), body, H, 32768)
            if (dWg == 0 || dWu == 0 || dWd == 0) {
                println("CHAIN_FAIL deq expert " + e.to_string())
                return nonev
            }

            sub<Vec<Float>> = Vec()
            j = 0
            while (j < nt) {
                tix = toks.get(j) * H
                d2 = 0
                while (d2 < H) {
                    sub.push(h2.get(tix + d2))
                    d2 = d2 + 1
                }
                j = j + 1
            }
            gv<Vec<Float>> = mm_host(sub, nt, H, dWg, EINTER, fgemm)
            uv<Vec<Float>> = mm_host(sub, nt, H, dWu, EINTER, fgemm)
            act<Vec<Float>> = Vec()
            j = 0
            while (j < gv.len()) {
                g1 = gv.get(j)
                if (g1 > SWIGLU_LIMIT) { g1 = SWIGLU_LIMIT }
                u1 = uv.get(j)
                if (u1 > SWIGLU_LIMIT) { u1 = SWIGLU_LIMIT }
                if (u1 < 0.0 - SWIGLU_LIMIT) { u1 = 0.0 - SWIGLU_LIMIT }
                act.push(silu(g1) * u1)
                j = j + 1
            }
            yv<Vec<Float>> = mm_host(act, nt, EINTER, dWd, H, fgemm)
            j = 0
            while (j < nt) {
                tk = toks.get(j)
                wt = rwt.get(tk * ROUTE_TOPK + lanes.get(j))
                d2 = 0
                while (d2 < H) {
                    accr.set(tk * H + d2, accr.get(tk * H + d2) + wt * yv.get(j * H + d2))
                    d2 = d2 + 1
                }
                j = j + 1
            }
            freedom {
                cuMemFree_v2(dWg)
                cuMemFree_v2(dWu)
                cuMemFree_v2(dWd)
            }
        }
        e = e + 1
    }
    println("  routed experts used: " + nex.to_string())

    # ---- shared expert ----
    w3<Vec<String>> = Vec()
    w3.push(lpre + "mlp.shared_experts.gate_proj.weight")
    w3.push(lpre + "mlp.shared_experts.up_proj.weight")
    w3.push(lpre + "mlp.shared_experts.down_proj.weight")
    gs<GxLoc> = gx_resolve_idx(idxtext, dir, total, w3)
    d_sg<Int> = deq_bf16(fbf, gx_read(gs, 0), EINTER * H, H)
    d_su<Int> = deq_bf16(fbf, gx_read(gs, 1), EINTER * H, H)
    d_sd<Int> = deq_bf16(fbf, gx_read(gs, 2), H * EINTER, EINTER)
    if (d_sg == 0 || d_su == 0 || d_sd == 0) { return nonev }
    sgate<Vec<Float>> = mm_host(h2, R, H, d_sg, EINTER, fgemm)
    sup<Vec<Float>> = mm_host(h2, R, H, d_su, EINTER, fgemm)
    sact<Vec<Float>> = Vec()
    i = 0
    while (i < sgate.len()) {
        g1 = sgate.get(i)
        if (g1 > SWIGLU_LIMIT) { g1 = SWIGLU_LIMIT }
        u1 = sup.get(i)
        if (u1 > SWIGLU_LIMIT) { u1 = SWIGLU_LIMIT }
        if (u1 < 0.0 - SWIGLU_LIMIT) { u1 = 0.0 - SWIGLU_LIMIT }
        sact.push(silu(g1) * u1)
        i = i + 1
    }
    shared<Vec<Float>> = mm_host(sact, R, EINTER, d_sd, H, fgemm)
    freedom {
        cuMemFree_v2(d_sg)
        cuMemFree_v2(d_su)
        cuMemFree_v2(d_sd)
    }

    mlp<Vec<Float>> = Vec()
    i = 0
    while (i < R * H) {
        mlp.push(accr.get(i) + shared.get(i))
        i = i + 1
    }

    streams2<Vec<Float>> = hc_apply(streams1, mlp, post2, comb2)
    return streams2
}

# ============================================================ main
main()<Int> -> {
    dir<String> = env_get("VYBFORGE_GX_DIR") else "/mnt/apex/rick/vybforge/glm53-checkpoint"
    out<String> = env_get("VYBFORGE_CHAIN_OUT") else "native/out/decchain_vyb.txt"
    total<Int> = 83
    lines<String> = ""
    mapbody<String> = ""
    idxtext<String> = ""
    i<Int> = 0
    j<Int> = 0
    k<Int> = 0
    r<Int> = 0
    hh<Int> = 0
    d2<Int> = 0
    c<Int> = 0
    a<Int> = 0
    p<Int> = 0
    e<Int> = 0
    lane<Int> = 0
    nfound<Int> = 0
    nf<Int> = 0
    mx<Float> = 0.0
    sm<Float> = 0.0
    acc<Float> = 0.0
    pr<Float> = 0.0
    dot<Float> = 0.0
    rl<Float> = 0.0
    sc<Float> = 0.0
    sv<Float> = 0.0
    scale_iq<Float> = 0.0
    sc_scale<Float> = 0.0
    wscale<Float> = 0.0
    best<Int> = 0
    bestv<Float> = 0.0
    bestp<Int> = 0
    last<Int> = 0
    used<Int> = 0
    tstart<Int> = 0
    slot<Int> = 0
    tv<Int> = 0
    g1<Float> = 0.0
    u1<Float> = 0.0
    wt<Float> = 0.0
    cv<Float> = 0.0
    i0<Int> = 0
    nt<Int> = 0
    tk<Int> = 0
    n<Int> = 0
    npools<Int> = 0
    select_k<Int> = 0
    vcount<Int> = 0
    tcount<Int> = 0
    nex<Int> = 0
    t<Int> = 0
    tid<Int> = 0
    nlay<Int> = 45
    is_dsa<Int> = 0
    lpre<String> = ""
    baseF<Vec<Float>> = Vec()
    scaleF<Vec<Float>> = Vec()
    kslot<Int> = 0
    dslot<Int> = 0
    nckv<Int> = 0
    d_q<Int> = 0
    d_k<Int> = 0
    d_v<Int> = 0
    d_o<Int> = 0
    d_b<Int> = 0
    d_fa<Int> = 0
    d_fb<Int> = 0
    d_ga<Int> = 0
    d_gb<Int> = 0
    d_ln<Int> = 0
    d_ln2<Int> = 0
    d_cq<Int> = 0
    d_ck<Int> = 0
    d_cv<Int> = 0
    d_onorm<Int> = 0
    d_fnA<Int> = 0
    d_fnF<Int> = 0
    d_gate<Int> = 0
    d_up<Int> = 0
    d_down<Int> = 0
    d_qa<Int> = 0
    d_qb<Int> = 0
    d_kva<Int> = 0
    d_kvb<Int> = 0
    d_wqb<Int> = 0
    d_wk<Int> = 0
    d_wproj<Int> = 0
    d_gatei<Int> = 0
    d_gw<Int> = 0
    d_sg<Int> = 0
    d_su<Int> = 0
    d_sd<Int> = 0
    d_qaln<Int> = 0
    d_kvaln<Int> = 0
    d_knw<Int> = 0
    d_knb<Int> = 0
    d_ukm<Int> = 0
    d_uvm<Int> = 0
    d_flat<Int> = 0
    d_mv<Int> = 0
    d_scr<Int> = 0
    d_flat2<Int> = 0
    d_mv2<Int> = 0
    d_scr2<Int> = 0
    d_x<Int> = 0
    lg<GxLoc> = GxLoc { found = Vec(), shard = Vec(), tix = Vec(), off = Vec(), nbytes = Vec(),
                        dts = Vec(), paths = Vec() }
    streams1<Vec<Float>> = Vec()
    streams2<Vec<Float>> = Vec()
    attn<Vec<Float>> = Vec()
    mlp<Vec<Float>> = Vec()

    if (tensor_init() != 0) { println("CHAIN_FAIL no cuda"); return 3 }
    fgemm<Int> = load_fn("native/build/gemm.ptx", "gemm")
    fbf<Int> = load_fn("native/build/bf16.ptx", "bf16deq")
    fdeq<Int> = load_fn("native/build/exl3.ptx", "exl3deq")
    fhgen<Int> = load_fn("native/build/exl3.ptx", "exl3hgen")
    fhad1<Int> = load_fn("native/build/exl3.ptx", "exl3had1")
    fhad2<Int> = load_fn("native/build/exl3.ptx", "exl3had2")
    if (fgemm == 0 || fbf == 0 || fdeq == 0 || fhgen == 0 || fhad1 == 0 || fhad2 == 0) {
        println("CHAIN_FAIL kernels")
        return 4
    }
    mapd<String> = ""
    match (open_read("native/exl3/map.bin")) {
        f -> { match (read_all(f)) { s -> { mapd = s } ? -> { return 5 } } close(f) }
        ? -> { println("CHAIN_FAIL no map.bin"); return 5 }
    }
    mapbody = mapd.substring(16, mapd.len())
    idxtext = gx_read_index(dir)

    # ---------------------------------------------------------------- prompt ids
    # the prefill's default id list (22 tokens); phase 1 prefills ids[0..19], the two
    # decode steps re-walk ids[20] and ids[21] teacher-forced.
    ids<Vec<Int>> = Vec()
    idtxt<String> = env_get("VYBFORGE_L0_IDS") else "785,6722,315,9621,374,12089,11,323,279,7772,3283,304,9851,374,19808,11,892,572,17753,369,10788,13"
    cur<String> = ""
    i = 0
    while (i <= idtxt.len()) {
        if (i == idtxt.len()) {
            if (cur.len() > 0) { ids.push(cur.to_int()) }
        } else {
            ch<String> = idtxt.substring(i, i + 1)
            if (ch == ",") {
                if (cur.len() > 0) { ids.push(cur.to_int()) }
                cur = ""
            } else { cur = cur + ch }
        }
        i = i + 1
    }
    if (ids.len() != 22) { println("CHAIN_FAIL ids " + ids.len().to_string()); return 8 }
    nl2<String> = env_get("VYBFORGE_NLAYERS") else ""
    if (nl2.len() > 0) { nlay = nl2.to_int() }
    ns<String> = env_get("VYBFORGE_NSTEPS") else ""
    nsteps<Int> = 2
    if (ns.len() > 0) { nsteps = ns.to_int() }

    # carried state, flat per layer slot:
    #   KDA (34 slots): recurrence [64,128,128] + conv rings [3,8192] per tensor q/k/v
    #   DSA (11 slots): ckv [CAPT,512], indexer k [CAPT,128], gsc [CAPT,128]
    stAll<Vec<Float>> = Vec()
    ringQ<Vec<Float>> = Vec()
    ringK<Vec<Float>> = Vec()
    ringV<Vec<Float>> = Vec()
    ckvAll<Vec<Float>> = Vec()
    ikAll<Vec<Float>> = Vec()
    gscAll<Vec<Float>> = Vec()
    i = 0
    while (i < NSLOT * HEADS * KD * KD) { stAll.push(0.0); i = i + 1 }
    i = 0
    while (i < NSLOT * (CONV_K - 1) * HEADS * KD) { ringQ.push(0.0); ringK.push(0.0); ringV.push(0.0); i = i + 1 }
    i = 0
    while (i < NDSLOT * CAPT * KV_LORA) { ckvAll.push(0.0); i = i + 1 }
    i = 0
    while (i < NDSLOT * CAPT * IDIM) { ikAll.push(0.0); gscAll.push(0.0); i = i + 1 }

    # ================================================================ phase 1: prefill R = 20
    # embeddings for ids[0..19] -> streams (HC copies), verbatim from glm_prefill.vyb
    want0<Vec<String>> = Vec()
    want0.push("model.language_model.embed_tokens.weight")
    ge0<GxLoc> = gx_resolve(dir, total, want0)
    emb_off<Int> = ge0.off.get(0)
    emb_path<String> = ge0.paths.get(0)
    raw_emb1<String> = ""
    r = 0
    while (r < R) {
        match (open_read(emb_path)) {
            f -> {
                match (read_at(f, emb_off + ids.get(r) * H * 2, H * 2)) {
                    s -> { raw_emb1 = raw_emb1 + s }
                    ? -> { return 9 }
                }
                close(f)
            }
            ? -> { return 9 }
        }
        r = r + 1
    }
    d_x = deq_bf16(fbf, raw_emb1, R * H, 0)
    if (d_x == 0) { println("CHAIN_FAIL emb deq"); return 10 }
    x<Vec<Float>> = bulk_dtoh(d_x, R * H)
    free_dev(d_x)
    println(digest("x", x))
    lines = lines + digest("x", x) + "\n"
    streams<Vec<Float>> = Vec()
    r = 0
    while (r < R) {
        hh = 0
        while (hh < HC) {
            d2 = 0
            while (d2 < H) {
                streams.push(x.get(r * H + d2))
                d2 = d2 + 1
            }
            hh = hh + 1
        }
        r = r + 1
    }

    println("CHAIN phase 1: prefill " + R.to_string() + " tokens, 45 layers")
    n = 0
    while (n < nlay) {
        lpre = "model.language_model.layers." + n.to_string() + "."
        is_dsa = 0
        if ((n % 4) == 3) { is_dsa = 1 }
        if (is_dsa == 1) {
            dslot = (n - 3) / 4
            streams1 = dsa_attn_site_c(streams, dir, total, lpre, fgemm, fbf, fdeq, fhgen, fhad1, fhad2, mapbody, borrow(ckvAll), borrow(ikAll), borrow(gscAll), dslot)
        } else {
            kslot = n - ((n + 1) / 4)
            streams1 = kda_attn_site_c(streams, dir, total, lpre, fgemm, fbf, borrow(stAll), kslot, borrow(ringQ), borrow(ringK), borrow(ringV))
        }
        if (streams1.len() != R * HC * H) {
            println("CHAIN_FAIL attention layer " + n.to_string())
            return 30
        }
        if (n < 3) {
            streams2 = ffn_dense_site(streams1, dir, total, lpre, fgemm, fbf)
        } else {
            streams2 = tail_site(streams1, lpre, fgemm, fbf, fdeq, fhgen, fhad1, fhad2, mapbody)
        }
        if (streams2.len() != R * HC * H) {
            println("CHAIN_FAIL ffn layer " + n.to_string())
            return 31
        }
        streams = streams2
        i = trim_heap()
        ckvs<Vec<Float>> = Vec()
        i = 0
        while (i < 512) { ckvs.push(ckvAll.get(i)); i = i + 1 }
        lines = lines + dumps("p1ck" + n.to_string(), ckvs) + "\n"
        println("phase1 layer " + n.to_string() + " done")
        lines = lines + "phase1 layer " + n.to_string() + " " + digest("streams", streams) + "\n"
        n = n + 1
    }
    println("CHAIN phase 1 done: caches built")

    # ================================================================ phase 2: two decode steps
    # cache-sniff dumps: full DSA slot-0 rows as phase 1 left them, and again at the
    # top of each decode step -- brackets any corruption window.
    p1ckv<Vec<Float>> = Vec()
    p1ik<Vec<Float>> = Vec()
    p1gsc<Vec<Float>> = Vec()
    i = 0
    while (i < CAPT * KV_LORA) { p1ckv.push(ckvAll.get(i)); p1ik.push(ikAll.get(i)); p1gsc.push(gscAll.get(i)); i = i + 1 }
    lines = lines + dumps("p1ckvF", p1ckv) + "\n"
    lines = lines + dumps("p1ikF", p1ik) + "\n"
    lines = lines + dumps("p1gscF", p1gsc) + "\n"
    R = 1
    scale_iq = 1.0 / vsqrt(IDIM as Float, 40)
    sc_scale = 1.0 / vsqrt(NOPE as Float, 40)
    wscale = 1.0 / vsqrt(IHEADS as Float, 40)

    t = 0
    while (t < nsteps) {
        # Refresh the long-lived index/map strings. Phase 1's 45 layers of String
        # churn corrupt a buffer held across it (the 12-layer debug run showed every
        # EXL3 dequant in phase 2 reading the same wrong map: mlp max bit-identical
        # across layers). Phase 1 re-reads both per layer and is immune; phase 2
        # re-reads both per step here.
        match (open_read("native/exl3/map.bin")) {
            f -> { match (read_all(f)) { s -> { mapd = s } ? -> { return 5 } } close(f) }
            ? -> { return 5 }
        }
        mapbody = mapd.substring(16, mapd.len())
        idxtext = gx_read_index(dir)
        tid = ids.get(20 + t)
        i = 0
        while (i < CAPT * KV_LORA) { p1ckv.set(i, ckvAll.get(i)); p1ik.set(i, ikAll.get(i)); p1gsc.set(i, gscAll.get(i)); i = i + 1 }
        lines = lines + dumps("p2ckvF" + t.to_string(), p1ckv) + "\n"
        lines = lines + dumps("p2ikF" + t.to_string(), p1ik) + "\n"
        lines = lines + dumps("p2gscF" + t.to_string(), p1gsc) + "\n"
        raw_emb<String> = ""
        match (open_read(emb_path)) {
            f -> {
                match (read_at(f, emb_off + tid * H * 2, H * 2)) {
                    s -> { raw_emb = s }
                    ? -> { return 9 }
                }
                close(f)
            }
            ? -> { return 9 }
        }
        d_x = deq_bf16(fbf, raw_emb, R * H, 0)
        if (d_x == 0) { println("CHAIN_FAIL emb deq step"); return 10 }
        x = bulk_dtoh(d_x, R * H)
        free_dev(d_x)
        streams = vecf()
        hh = 0
        while (hh < HC) {
            d2 = 0
            while (d2 < H) {
                streams.push(x.get(d2))
                d2 = d2 + 1
            }
            hh = hh + 1
        }

        n = 0
        while (n < nlay) {
            lpre = "model.language_model.layers." + n.to_string() + "."
            is_dsa = 0
            if ((n % 4) == 3) { is_dsa = 1 }
            # resolve this layer's main tensors FRESH, used immediately (the stored
            # GxLoc paths did not survive the surrounding String churn)
            wantL<Vec<String>> = Vec()
            if (is_dsa == 1) {
                wantL.push(lpre + "hc_attn_fn")
                wantL.push(lpre + "hc_attn_base")
                wantL.push(lpre + "hc_attn_scale")
                wantL.push(lpre + "input_layernorm.weight")
                wantL.push(lpre + "self_attn.q_a_proj.weight")
                wantL.push(lpre + "self_attn.q_a_layernorm.weight")
                wantL.push(lpre + "self_attn.q_b_proj.weight")
                wantL.push(lpre + "self_attn.kv_a_proj_with_mqa.weight")
                wantL.push(lpre + "self_attn.kv_a_layernorm.weight")
                wantL.push(lpre + "self_attn.kv_b_proj.weight")
                wantL.push(lpre + "self_attn.o_proj.weight")
                wantL.push(lpre + "self_attn.indexer.wq_b.weight")
                wantL.push(lpre + "self_attn.indexer.wk.weight")
                wantL.push(lpre + "self_attn.indexer.k_norm.weight")
                wantL.push(lpre + "self_attn.indexer.k_norm.bias")
                wantL.push(lpre + "self_attn.indexer.weights_proj.weight")
                wantL.push(lpre + "self_attn.indexer.index_kpool_compress_ape")
                wantL.push(lpre + "self_attn.indexer.index_kpool_compress_gate")
                wantL.push(lpre + "hc_ffn_fn")
                wantL.push(lpre + "hc_ffn_base")
                wantL.push(lpre + "hc_ffn_scale")
                wantL.push(lpre + "post_attention_layernorm.weight")
                wantL.push(lpre + "mlp.gate.weight")
                wantL.push(lpre + "mlp.gate.e_score_correction_bias")
                wantL.push(lpre + "mlp.shared_experts.gate_proj.weight")
                wantL.push(lpre + "mlp.shared_experts.up_proj.weight")
                wantL.push(lpre + "mlp.shared_experts.down_proj.weight")
            } else {
                wantL.push(lpre + "self_attn.q_proj.weight")
                wantL.push(lpre + "self_attn.k_proj.weight")
                wantL.push(lpre + "self_attn.v_proj.weight")
                wantL.push(lpre + "self_attn.o_proj.weight")
                wantL.push(lpre + "self_attn.b_proj.weight")
                wantL.push(lpre + "self_attn.f_a_proj.weight")
                wantL.push(lpre + "self_attn.f_b_proj.weight")
                wantL.push(lpre + "self_attn.g_a_proj.weight")
                wantL.push(lpre + "self_attn.g_b_proj.weight")
                wantL.push(lpre + "self_attn.o_norm.weight")
                wantL.push(lpre + "self_attn.dt_bias")
                wantL.push(lpre + "self_attn.A_log")
                if (n < 3) {
                    wantL.push(lpre + "mlp.gate_proj.weight")
                    wantL.push(lpre + "mlp.up_proj.weight")
                    wantL.push(lpre + "mlp.down_proj.weight")
                    wantL.push(lpre + "input_layernorm.weight")
                    wantL.push(lpre + "post_attention_layernorm.weight")
                    wantL.push(lpre + "hc_attn_fn")
                    wantL.push(lpre + "hc_attn_base")
                    wantL.push(lpre + "hc_attn_scale")
                    wantL.push(lpre + "hc_ffn_fn")
                    wantL.push(lpre + "hc_ffn_base")
                    wantL.push(lpre + "hc_ffn_scale")
                    wantL.push("model.language_model.embed_tokens.weight")
                    wantL.push(lpre + "self_attn.q_conv1d.weight")
                    wantL.push(lpre + "self_attn.k_conv1d.weight")
                    wantL.push(lpre + "self_attn.v_conv1d.weight")
                } else {
                    wantL.push(lpre + "input_layernorm.weight")
                    wantL.push(lpre + "post_attention_layernorm.weight")
                    wantL.push(lpre + "hc_attn_fn")
                    wantL.push(lpre + "hc_attn_base")
                    wantL.push(lpre + "hc_attn_scale")
                    wantL.push(lpre + "hc_ffn_fn")
                    wantL.push(lpre + "hc_ffn_base")
                    wantL.push(lpre + "hc_ffn_scale")
                    wantL.push(lpre + "self_attn.q_conv1d.weight")
                    wantL.push(lpre + "self_attn.k_conv1d.weight")
                    wantL.push(lpre + "self_attn.v_conv1d.weight")
                }
            }
            gL2<GxLoc> = gx_resolve(dir, total, wantL)
            nf = 0
            i = 0
            while (i < wantL.len()) {
                if (gL2.found.get(i) == 1) { nf = nf + 1 }
                i = i + 1
            }
            if (nf != wantL.len()) {
                println("CHAIN_FAIL resolve layer " + n.to_string() + " step " + t.to_string() + " (" + nf.to_string() + ")")
                return 12
            }
            lg = gL2

            if (is_dsa == 1) {
                # ------------------------------------------------ DSA layer step
                # (glm_decode_l3.vyb's step body; caches ride in ckvAll/ikAll/gscAll)
                dslot = (n - 3) / 4
                d_fnA = deq_bf16(fbf, gx_read(lg, 0), 24 * HC * H, HC * H)
                if (d_fnA == 0) { return 11 }
                baseA<Vec<Float>> = Vec()
                raw_baseA<String> = gx_read(lg, 1)
                j = 0
                while (j < 24) { baseA.push(f32_at(raw_baseA, j)); j = j + 1 }
                scaleA<Vec<Float>> = Vec()
                raw_scaleA<String> = gx_read(lg, 2)
                j = 0
                while (j < 3) { scaleA.push(f32_at(raw_scaleA, j)); j = j + 1 }
                d_lnA<Int> = deq_bf16(fbf, gx_read(lg, 3), H, 0)
                if (d_lnA == 0) { return 11 }
                in_ln<Vec<Float>> = bulk_dtoh(d_lnA, H)
                free_dev(d_lnA)

                d_qa = deq_bf16(fbf, gx_read(lg, 4), Q_LORA * H, H)
                d_qb = deq_bf16(fbf, gx_read(lg, 6), HEADS * NOPE * Q_LORA, Q_LORA)
                d_kva = deq_bf16(fbf, gx_read(lg, 7), KV_LORA * H, H)
                d_kvb = deq_bf16(fbf, gx_read(lg, 9), HEADS * (NOPE + VDIM) * KV_LORA, 0)
                d_o = deq_bf16(fbf, gx_read(lg, 10), HEADS * VDIM * H, HEADS * VDIM)
                d_wqb = deq_bf16(fbf, gx_read(lg, 11), Q_LORA * IHEADS * IDIM, Q_LORA)
                d_wk = deq_bf16(fbf, gx_read(lg, 12), H * IDIM, H)
                d_wproj = deq_bf16(fbf, gx_read(lg, 15), H * IHEADS, H)
                d_gatei = deq_bf16(fbf, gx_read(lg, 17), H * IDIM, H)
                d_gw = deq_bf16(fbf, gx_read(lg, 22), NE * H, H)
                if (d_qa == 0 || d_qb == 0 || d_kva == 0 || d_kvb == 0 || d_o == 0 ||
                    d_wqb == 0 || d_wk == 0 || d_wproj == 0 || d_gatei == 0 || d_gw == 0) {
                    println("CHAIN_FAIL weight deq dsa " + n.to_string())
                    return 13
                }
                d_qaln = deq_bf16(fbf, gx_read(lg, 5), Q_LORA, 0)
                d_kvaln = deq_bf16(fbf, gx_read(lg, 8), KV_LORA, 0)
                d_knw = deq_bf16(fbf, gx_read(lg, 13), IDIM, 0)
                d_knb = deq_bf16(fbf, gx_read(lg, 14), IDIM, 0)
                d_ln2 = deq_bf16(fbf, gx_read(lg, 21), H, 0)
                if (d_qaln == 0 || d_kvaln == 0 || d_knw == 0 || d_knb == 0 || d_ln2 == 0) { return 13 }
                qaln_w<Vec<Float>> = bulk_dtoh(d_qaln, Q_LORA)
                kvaln_w<Vec<Float>> = bulk_dtoh(d_kvaln, KV_LORA)
                knw<Vec<Float>> = bulk_dtoh(d_knw, IDIM)
                knb<Vec<Float>> = bulk_dtoh(d_knb, IDIM)
                post_ln2<Vec<Float>> = bulk_dtoh(d_ln2, H)
                free_dev(d_qaln)
                free_dev(d_kvaln)
                free_dev(d_knw)
                free_dev(d_knb)
                free_dev(d_ln2)

                ape<Vec<Float>> = Vec()
                raw_ape<String> = gx_read(lg, 16)
                i = 0
                while (i < KPOOL * IDIM) { ape.push(f32_at(raw_ape, i)); i = i + 1 }

                baseF = vecf()
                raw_baseF<String> = gx_read(lg, 19)
                j = 0
                while (j < 24) { baseF.push(f32_at(raw_baseF, j)); j = j + 1 }
                scaleF = vecf()
                raw_scaleF<String> = gx_read(lg, 20)
                j = 0
                while (j < 3) { scaleF.push(f32_at(raw_scaleF, j)); j = j + 1 }
                d_fnF = deq_bf16(fbf, gx_read(lg, 18), 24 * HC * H, HC * H)
                if (d_fnF == 0) { return 11 }

                raw_bias<String> = gx_read(lg, 23)
                bias<Vec<Float>> = Vec()
                i = 0
                while (i < NE) { bias.push(f32_at(raw_bias, i)); i = i + 1 }

                # absorbed per-head keys/values from kv_b
                kvb<Vec<Float>> = bulk_dtoh(d_kvb, HEADS * (NOPE + VDIM) * KV_LORA)
                free_dev(d_kvb)
                ukm<Vec<Float>> = Vec()
                uvm<Vec<Float>> = Vec()
                d2 = 0
                while (d2 < KV_LORA * HEADS * NOPE) {
                    ukm.push(0.0)
                    uvm.push(0.0)
                    d2 = d2 + 1
                }
                hh = 0
                while (hh < HEADS) {
                    j = 0
                    while (j < NOPE) {
                        d2 = 0
                        while (d2 < KV_LORA) {
                            ukm.set(d2 * (HEADS * NOPE) + hh * NOPE + j,
                                    kvb.get((hh * (NOPE + VDIM) + j) * KV_LORA + d2))
                            uvm.set(d2 * (HEADS * VDIM) + hh * VDIM + j,
                                    kvb.get((hh * (NOPE + VDIM) + NOPE + j) * KV_LORA + d2))
                            d2 = d2 + 1
                        }
                        j = j + 1
                    }
                    hh = hh + 1
                }
                d_ukm = alloc_dev(KV_LORA * HEADS * NOPE * 8)
                d_uvm = alloc_dev(KV_LORA * HEADS * VDIM * 8)
                if (d_ukm == 0 || d_uvm == 0) { return 13 }
                bulk_htod(d_ukm, view(ukm))
                bulk_htod(d_uvm, view(uvm))

                # ---- hc_attn mix -> input_layernorm -> h_a
                flat<Vec<Float>> = rms_rows(streams, R, HC * H, Vec())
                d_flat = alloc_dev(R * HC * H * 8)
                d_mv = alloc_dev(R * 24 * 8)
                d_scr = alloc_dev(64)
                if (d_flat == 0 || d_mv == 0 || d_scr == 0) { println("CHAIN_FAIL alloc"); return 14 }
                bulk_htod(d_flat, view(flat))
                if (gemm(fgemm, d_scr, d_flat, d_fnA, d_mv, R, 24, HC * H, 1.0, 0.0) != 0) { return 14 }
                sync()
                mv<Vec<Float>> = bulk_dtoh(d_mv, R * 24)
                free_dev(d_flat)
                free_dev(d_mv)
                free_dev(d_scr)
                free_dev(d_fnA)

                res<Vec<Float>> = hc_glue(mv, baseA, scaleA, streams)
                collapsed<Vec<Float>> = Vec()
                i = 0
                while (i < R * H) { collapsed.push(res.get(i)); i = i + 1 }
                postA<Vec<Float>> = Vec()
                i = 0
                while (i < R * HC) { postA.push(res.get(R * H + i)); i = i + 1 }
                combA<Vec<Float>> = Vec()
                i = 0
                while (i < R * HC * HC) { combA.push(res.get(R * H + R * HC + i)); i = i + 1 }
                h_a<Vec<Float>> = rms_rows(collapsed, R, H, in_ln)

                # ---- latent projections; append the new cache rows
                qres<Vec<Float>> = mm_host(h_a, R, H, d_qa, Q_LORA, fgemm)
                qa_ln<Vec<Float>> = rms_rows(qres, R, Q_LORA, qaln_w)
                qfull<Vec<Float>> = mm_host(qa_ln, R, Q_LORA, d_qb, HEADS * NOPE, fgemm)
                ckraw<Vec<Float>> = mm_host(h_a, R, H, d_kva, KV_LORA, fgemm)
                ckv_new<Vec<Float>> = rms_rows(ckraw, R, KV_LORA, kvaln_w)
                nckv = 20 + t                       # rows already in this layer's cache
                i = 0
                while (i < R * KV_LORA) {
                    ckvAll.set(dslot * CAPT * KV_LORA + nckv * KV_LORA + i, ckv_new.get(i))
                    i = i + 1
                }
                qidx<Vec<Float>> = mm_host(qres, R, Q_LORA, d_wqb, IHEADS * IDIM, fgemm)
                kraw<Vec<Float>> = mm_host(h_a, R, H, d_wk, IDIM, fgemm)
                k_new<Vec<Float>> = ln_rows(kraw, R, IDIM, knw, knb)
                i = 0
                while (i < R * IDIM) {
                    ikAll.set(dslot * CAPT * IDIM + nckv * IDIM + i, k_new.get(i))
                    i = i + 1
                }
                gsc_new<Vec<Float>> = mm_host(h_a, R, H, d_gatei, IDIM, fgemm)
                i = 0
                while (i < R * IDIM) {
                    gscAll.set(dslot * CAPT * IDIM + nckv * IDIM + i, gsc_new.get(i))
                    i = i + 1
                }
                wproj<Vec<Float>> = mm_host(h_a, R, H, d_wproj, IHEADS, fgemm)
                i = 0
                while (i < wproj.len()) {
                    wproj.set(i, wproj.get(i) * wscale)
                    i = i + 1
                }

                # ---- indexer: pool + topk over the cache with causal visibility
                nckv = nckv + 1                     # the cache now holds nckv rows
                # copy this slot's cache rows into locals sized [nckv, ...]
                ckv_t<Vec<Float>> = Vec()
                ik_t<Vec<Float>> = Vec()
                gsc_t<Vec<Float>> = Vec()
                i = 0
                while (i < nckv * KV_LORA) {
                    ckv_t.push(ckvAll.get(dslot * CAPT * KV_LORA + i))
                    i = i + 1
                }
                i = 0
                while (i < nckv * IDIM) {
                    ik_t.push(ikAll.get(dslot * CAPT * IDIM + i))
                    gsc_t.push(gscAll.get(dslot * CAPT * IDIM + i))
                    i = i + 1
                }
                lines = lines + dumps("d" + t.to_string() + "l" + n.to_string() + "ckv", ckv_t) + "\n"
                lines = lines + dumps("d" + t.to_string() + "l" + n.to_string() + "ik", ik_t) + "\n"
                lines = lines + dumps("d" + t.to_string() + "l" + n.to_string() + "gsc", gsc_t) + "\n"
                npools = nckv / KPOOL
                poolk<Vec<Float>> = Vec()
                d2 = 0
                while (d2 < npools * IDIM) { poolk.push(0.0); d2 = d2 + 1 }
                p = 0
                while (p < npools) {
                    c = 0
                    while (c < IDIM) {
                        mx = 0.0 - 1e30
                        a = 0
                        while (a < KPOOL) {
                            lgf<Float> = gsc_t.get((p * KPOOL + a) * IDIM + c) + ape.get(a * IDIM + c)
                            if (lgf > mx) { mx = lgf }
                            a = a + 1
                        }
                        sm = 0.0
                        a = 0
                        while (a < KPOOL) {
                            sm = sm + vexp(gsc_t.get((p * KPOOL + a) * IDIM + c) + ape.get(a * IDIM + c) - mx)
                            a = a + 1
                        }
                        acc = 0.0
                        a = 0
                        while (a < KPOOL) {
                            pr = vexp(gsc_t.get((p * KPOOL + a) * IDIM + c) + ape.get(a * IDIM + c) - mx) / sm
                            acc = acc + pr * ik_t.get((p * KPOOL + a) * IDIM + c)
                            a = a + 1
                        }
                        poolk.set(p * IDIM + c, acc)
                        c = c + 1
                    }
                    p = p + 1
                }
                isc<Vec<Float>> = Vec()
                d2 = 0
                while (d2 < npools) { isc.push(0.0); d2 = d2 + 1 }
                p = 0
                while (p < npools) {
                    acc = 0.0
                    hh = 0
                    while (hh < IHEADS) {
                        dot = 0.0
                        c = 0
                        while (c < IDIM) {
                            dot = dot + qidx.get(hh * IDIM + c) * poolk.get(p * IDIM + c)
                            c = c + 1
                        }
                        rl = dot * scale_iq
                        if (rl < 0.0) { rl = 0.0 }
                        acc = acc + wproj.get(hh) * rl
                        hh = hh + 1
                    }
                    isc.set(p, acc)
                    p = p + 1
                }
                sel<Vec<Int>> = Vec()
                d2 = 0
                while (d2 < nckv) { sel.push(-1); d2 = d2 + 1 }
                select_k = TOPK / KPOOL
                if (select_k > npools) { select_k = npools }
                taken<Vec<Int>> = Vec()
                k = 0
                while (k < select_k) {
                    bestp = -1
                    bestv = 0.0 - 1e30
                    p = 0
                    while (p < npools) {
                        last = p * KPOOL + KPOOL - 1
                        used = 0
                        j = 0
                        while (j < taken.len()) {
                            if (taken.get(j) == p) { used = 1 }
                            j = j + 1
                        }
                        if (last <= nckv - 1 && used == 0) {
                            sc = isc.get(p)
                            if (sc > bestv) { bestv = sc; bestp = p }
                        }
                        p = p + 1
                    }
                    if (bestp < 0) { k = select_k } else {
                        taken.push(bestp)
                        a = 0
                        while (a < KPOOL) {
                            sel.set(bestp * KPOOL + a, bestp * KPOOL + a)
                            a = a + 1
                        }
                        k = k + 1
                    }
                }
                vcount = nckv
                tcount = vcount % KPOOL
                tstart = vcount - tcount
                a = 0
                while (a < tcount) {
                    sel.set(tstart + a, tstart + a)
                    a = a + 1
                }

                # ---- masked MLA over the selected cache rows
                Kv<Vec<Float>> = mm_host(ckv_t, nckv, KV_LORA, d_ukm, HEADS * NOPE, fgemm)
                Vm<Vec<Float>> = mm_host(ckv_t, nckv, KV_LORA, d_uvm, HEADS * VDIM, fgemm)
                probs<Vec<Float>> = Vec()
                d2 = 0
                while (d2 < R * HEADS * nckv) { probs.push(0.0); d2 = d2 + 1 }
                hh = 0
                while (hh < HEADS) {
                    mx = 0.0 - 1e30
                    i = 0
                    while (i < nckv) {
                        if (sel.get(i) >= 0) {
                            dot = 0.0
                            c = 0
                            while (c < NOPE) {
                                dot = dot + qfull.get(hh * NOPE + c) * Kv.get((i * HEADS + hh) * NOPE + c)
                                c = c + 1
                            }
                            sv = dot * sc_scale
                            if (sv > mx) { mx = sv }
                        }
                        i = i + 1
                    }
                    sm = 0.0
                    i = 0
                    while (i < nckv) {
                        if (sel.get(i) >= 0) {
                            dot = 0.0
                            c = 0
                            while (c < NOPE) {
                                dot = dot + qfull.get(hh * NOPE + c) * Kv.get((i * HEADS + hh) * NOPE + c)
                                c = c + 1
                            }
                            sm = sm + vexp(dot * sc_scale - mx)
                        }
                        i = i + 1
                    }
                    i = 0
                    while (i < nckv) {
                        if (sel.get(i) >= 0) {
                            dot = 0.0
                            c = 0
                            while (c < NOPE) {
                                dot = dot + qfull.get(hh * NOPE + c) * Kv.get((i * HEADS + hh) * NOPE + c)
                                c = c + 1
                            }
                            probs.set(hh * nckv + i, vexp(dot * sc_scale - mx) / sm)
                        }
                        i = i + 1
                    }
                    hh = hh + 1
                }
                ao<Vec<Float>> = Vec()
                d2 = 0
                while (d2 < R * HEADS * VDIM) { ao.push(0.0); d2 = d2 + 1 }
                hh = 0
                while (hh < HEADS) {
                    c = 0
                    while (c < VDIM) {
                        acc = 0.0
                        i = 0
                        while (i < nckv) {
                            pv<Float> = probs.get(hh * nckv + i)
                            if (pv != 0.0) {
                                acc = acc + pv * Vm.get((i * HEADS + hh) * VDIM + c)
                            }
                            i = i + 1
                        }
                        ao.set(hh * VDIM + c, acc)
                        c = c + 1
                    }
                    hh = hh + 1
                }
                attn = mm_host(ao, R, HEADS * VDIM, d_o, H, fgemm)
                free_dev(d_ukm)
                free_dev(d_uvm)
                free_dev(d_qa)
                free_dev(d_qb)
                free_dev(d_kva)
                free_dev(d_o)
                free_dev(d_wqb)
                free_dev(d_wk)
                free_dev(d_wproj)
                free_dev(d_gatei)

                streams1 = hc_apply(streams, attn, postA, combA)

                # ---- ffn site: hc_ffn mix -> post_attn LN -> router -> experts -> shared
                reflat<Vec<Float>> = rms_rows(streams1, R, HC * H, Vec())
                d_flat2 = alloc_dev(R * HC * H * 8)
                d_mv2 = alloc_dev(R * 24 * 8)
                d_scr2 = alloc_dev(64)
                if (d_flat2 == 0 || d_mv2 == 0 || d_scr2 == 0) { return 21 }
                bulk_htod(d_flat2, view(reflat))
                if (gemm(fgemm, d_scr2, d_flat2, d_fnF, d_mv2, R, 24, HC * H, 1.0, 0.0) != 0) { return 22 }
                sync()
                mv2<Vec<Float>> = bulk_dtoh(d_mv2, R * 24)
                free_dev(d_flat2)
                free_dev(d_mv2)
                free_dev(d_scr2)
                free_dev(d_fnF)

                res2<Vec<Float>> = hc_glue(mv2, baseF, scaleF, streams1)
                collapsed2<Vec<Float>> = Vec()
                i = 0
                while (i < R * H) { collapsed2.push(res2.get(i)); i = i + 1 }
                post2<Vec<Float>> = Vec()
                i = 0
                while (i < R * HC) { post2.push(res2.get(R * H + i)); i = i + 1 }
                comb2<Vec<Float>> = Vec()
                i = 0
                while (i < R * HC * HC) { comb2.push(res2.get(R * H + R * HC + i)); i = i + 1 }
                h2<Vec<Float>> = rms_rows(collapsed2, R, H, post_ln2)

                # router: sigmoid + noaux_tc bias + top-8 + renorm * 2.5
                logits<Vec<Float>> = mm_host(h2, R, H, d_gw, NE, fgemm)
                freedom {
                    cuMemFree_v2(d_gw)
                }
                scores<Vec<Float>> = Vec()
                i = 0
                while (i < logits.len()) {
                    scores.push(sigmoid(logits.get(i)))
                    i = i + 1
                }
                rsel<Vec<Int>> = Vec()
                rwt<Vec<Float>> = Vec()
                i = 0
                while (i < R * ROUTE_TOPK) { rsel.push(-1); rwt.push(0.0); i = i + 1 }
                r = 0
                while (r < R) {
                    lane = 0
                    while (lane < ROUTE_TOPK) {
                        best = -1
                        bestv = 0.0 - 1e30
                        j = 0
                        while (j < NE) {
                            used = 0
                            k = 0
                            while (k < lane) {
                                if (rsel.get(r * ROUTE_TOPK + k) == j) { used = 1 }
                                k = k + 1
                            }
                            if (used == 0) {
                                cv = scores.get(r * NE + j) + bias.get(j)
                                if (cv > bestv) { bestv = cv; best = j }
                            }
                            j = j + 1
                        }
                        rsel.set(r * ROUTE_TOPK + lane, best)
                        lane = lane + 1
                    }
                    sm = 0.0
                    lane = 0
                    while (lane < ROUTE_TOPK) {
                        sm = sm + scores.get(r * NE + rsel.get(r * ROUTE_TOPK + lane))
                        lane = lane + 1
                    }
                    lane = 0
                    while (lane < ROUTE_TOPK) {
                        rwt.set(r * ROUTE_TOPK + lane,
                                scores.get(r * NE + rsel.get(r * ROUTE_TOPK + lane)) / (sm + 1e-20) * ROUTED_SCALE)
                        lane = lane + 1
                    }
                    r = r + 1
                }

                # routed experts: lazy per-expert resolve (9 names), EXL3 deq, then shared
                accr<Vec<Float>> = Vec()
                i = 0
                while (i < R * H) { accr.push(0.0); i = i + 1 }
                nex = 0
                e = 0
                while (e < NE) {
                    toks<Vec<Int>> = Vec()
                    lanes<Vec<Int>> = Vec()
                    r = 0
                    while (r < R) {
                        lane = 0
                        while (lane < ROUTE_TOPK) {
                            if (rsel.get(r * ROUTE_TOPK + lane) == e) {
                                toks.push(r)
                                lanes.push(lane)
                            }
                            lane = lane + 1
                        }
                        r = r + 1
                    }
                    nt = toks.len()
                    if (nt > 0) {
                        nex = nex + 1
                        i0 = e * 9
                        epre<String> = lpre + "mlp.experts." + e.to_string() + "."
                        w2<Vec<String>> = Vec()
                        w2.push(epre + "gate_proj.trellis")
                        w2.push(epre + "gate_proj.suh")
                        w2.push(epre + "gate_proj.svh")
                        w2.push(epre + "up_proj.trellis")
                        w2.push(epre + "up_proj.suh")
                        w2.push(epre + "up_proj.svh")
                        w2.push(epre + "down_proj.trellis")
                        w2.push(epre + "down_proj.suh")
                        w2.push(epre + "down_proj.svh")
                        gexp<GxLoc> = gx_resolve_idx(idxtext, dir, total, w2)
                        nfound = 0
                        j = 0
                        while (j < 9) {
                            if (gexp.found.get(j) == 1) { nfound = nfound + 1 }
                            j = j + 1
                        }
                        if (nfound != 9) {
                            println("CHAIN_FAIL resolve expert " + e.to_string() + " layer " + n.to_string())
                            return 23
                        }
                        dWg<Int> = exl3_deq(fdeq, fhgen, fhad1, fhad2, gx_read(gexp, 0),
                                            gx_read(gexp, 1), gx_read(gexp, 2), mapbody,
                                            EINTER, 32768)
                        dWu<Int> = exl3_deq(fdeq, fhgen, fhad1, fhad2, gx_read(gexp, 3),
                                            gx_read(gexp, 4), gx_read(gexp, 5), mapbody,
                                            EINTER, 32768)
                        dWd<Int> = exl3_deq(fdeq, fhgen, fhad1, fhad2, gx_read(gexp, 6),
                                            gx_read(gexp, 7), gx_read(gexp, 8), mapbody,
                                            H, 32768)
                        if (dWg == 0 || dWu == 0 || dWd == 0) {
                            println("CHAIN_FAIL deq expert " + e.to_string())
                            return 24
                        }
                        sub<Vec<Float>> = Vec()
                        j = 0
                        while (j < nt) {
                            tk = toks.get(j) * H
                            d2 = 0
                            while (d2 < H) {
                                sub.push(h2.get(tk + d2))
                                d2 = d2 + 1
                            }
                            j = j + 1
                        }
                        gv<Vec<Float>> = mm_host(sub, nt, H, dWg, EINTER, fgemm)
                        uv<Vec<Float>> = mm_host(sub, nt, H, dWu, EINTER, fgemm)
                        act<Vec<Float>> = Vec()
                        j = 0
                        while (j < gv.len()) {
                            g1 = gv.get(j)
                            if (g1 > SWIGLU_LIMIT) { g1 = SWIGLU_LIMIT }
                            u1 = uv.get(j)
                            if (u1 > SWIGLU_LIMIT) { u1 = SWIGLU_LIMIT }
                            if (u1 < 0.0 - SWIGLU_LIMIT) { u1 = 0.0 - SWIGLU_LIMIT }
                            act.push(silu(g1) * u1)
                            j = j + 1
                        }
                        yv<Vec<Float>> = mm_host(act, nt, EINTER, dWd, H, fgemm)
                        j = 0
                        while (j < nt) {
                            tk = toks.get(j)
                            wt = rwt.get(tk * ROUTE_TOPK + lanes.get(j))
                            d2 = 0
                            while (d2 < H) {
                                accr.set(tk * H + d2, accr.get(tk * H + d2) + wt * yv.get(j * H + d2))
                                d2 = d2 + 1
                            }
                            j = j + 1
                        }
                        freedom {
                            cuMemFree_v2(dWg)
                            cuMemFree_v2(dWu)
                            cuMemFree_v2(dWd)
                        }
                    }
                    e = e + 1
                }

                d_sg = deq_bf16(fbf, gx_read(lg, 24), EINTER * H, H)
                d_su = deq_bf16(fbf, gx_read(lg, 25), EINTER * H, H)
                d_sd = deq_bf16(fbf, gx_read(lg, 26), H * EINTER, EINTER)
                if (d_sg == 0 || d_su == 0 || d_sd == 0) { return 25 }
                sgate<Vec<Float>> = mm_host(h2, R, H, d_sg, EINTER, fgemm)
                sup<Vec<Float>> = mm_host(h2, R, H, d_su, EINTER, fgemm)
                sact<Vec<Float>> = Vec()
                i = 0
                while (i < sgate.len()) {
                    g1 = sgate.get(i)
                    if (g1 > SWIGLU_LIMIT) { g1 = SWIGLU_LIMIT }
                    u1 = sup.get(i)
                    if (u1 > SWIGLU_LIMIT) { u1 = SWIGLU_LIMIT }
                    if (u1 < 0.0 - SWIGLU_LIMIT) { u1 = 0.0 - SWIGLU_LIMIT }
                    sact.push(silu(g1) * u1)
                    i = i + 1
                }
                shared<Vec<Float>> = mm_host(sact, R, EINTER, d_sd, H, fgemm)
                free_dev(d_sg)
                free_dev(d_su)
                free_dev(d_sd)

                mlp = vecf()
                i = 0
                while (i < R * H) { mlp.push(accr.get(i) + shared.get(i)); i = i + 1 }
                streams2 = hc_apply(streams1, mlp, post2, comb2)
            } else {
                # ------------------------------------------------ KDA layer step
                kslot = n - ((n + 1) / 4)
                if (n < 3) {
                    d_fnA = deq_bf16(fbf, gx_read(lg, 17), 24 * HC * H, HC * H)
                } else {
                    d_fnA = deq_bf16(fbf, gx_read(lg, 14), 24 * HC * H, HC * H)
                }
                if (d_fnA == 0) { return 11 }
                base<Vec<Float>> = Vec()
                raw_base<String> = ""
                if (n < 3) { raw_base = gx_read(lg, 18) } else { raw_base = gx_read(lg, 15) }
                j = 0
                while (j < 24) { base.push(f32_at(raw_base, j)); j = j + 1 }
                scale<Vec<Float>> = Vec()
                raw_scale<String> = ""
                if (n < 3) { raw_scale = gx_read(lg, 19) } else { raw_scale = gx_read(lg, 16) }
                j = 0
                while (j < 3) { scale.push(f32_at(raw_scale, j)); j = j + 1 }

                d_q = deq_bf16(fbf, gx_read(lg, 0), H * HEADS * KD, H)
                d_k = deq_bf16(fbf, gx_read(lg, 1), H * HEADS * KD, H)
                d_v = deq_bf16(fbf, gx_read(lg, 2), H * HEADS * KD, H)
                d_o = deq_bf16(fbf, gx_read(lg, 3), HEADS * KD * H, HEADS * KD)
                d_b = deq_bf16(fbf, gx_read(lg, 4), H * HEADS, H)
                d_fa = deq_bf16(fbf, gx_read(lg, 5), H * 128, H)
                d_fb = deq_bf16(fbf, gx_read(lg, 6), 128 * HEADS * KD, 128)
                d_ga = deq_bf16(fbf, gx_read(lg, 7), H * 128, H)
                d_gb = deq_bf16(fbf, gx_read(lg, 8), 128 * HEADS * KD, 128)
                if (n < 3) {
                    d_ln = deq_bf16(fbf, gx_read(lg, 15), H, 0)
                    d_ln2 = deq_bf16(fbf, gx_read(lg, 16), H, 0)
                    d_cq = deq_bf16(fbf, gx_read(lg, 24), HEADS * KD * CONV_K, 0)
                    d_ck = deq_bf16(fbf, gx_read(lg, 25), HEADS * KD * CONV_K, 0)
                    d_cv = deq_bf16(fbf, gx_read(lg, 26), HEADS * KD * CONV_K, 0)
                } else {
                    d_ln = deq_bf16(fbf, gx_read(lg, 12), H, 0)
                    d_ln2 = deq_bf16(fbf, gx_read(lg, 13), H, 0)
                    d_cq = deq_bf16(fbf, gx_read(lg, 20), HEADS * KD * CONV_K, 0)
                    d_ck = deq_bf16(fbf, gx_read(lg, 21), HEADS * KD * CONV_K, 0)
                    d_cv = deq_bf16(fbf, gx_read(lg, 22), HEADS * KD * CONV_K, 0)
                }
                if (d_q == 0 || d_k == 0 || d_v == 0 || d_o == 0 || d_b == 0 || d_fa == 0 || d_fb == 0 ||
                    d_ga == 0 || d_gb == 0 || d_ln == 0 || d_ln2 == 0 || d_cq == 0 || d_ck == 0 || d_cv == 0) {
                    println("CHAIN_FAIL weight deq kda " + n.to_string())
                    return 15
                }
                in_ln<Vec<Float>> = bulk_dtoh(d_ln, H)
                post_ln3<Vec<Float>> = bulk_dtoh(d_ln2, H)
                convq<Vec<Float>> = bulk_dtoh(d_cq, HEADS * KD * CONV_K)
                convk<Vec<Float>> = bulk_dtoh(d_ck, HEADS * KD * CONV_K)
                convv<Vec<Float>> = bulk_dtoh(d_cv, HEADS * KD * CONV_K)
                free_dev(d_cq)
                free_dev(d_ck)
                free_dev(d_cv)

                d_onorm = deq_bf16(fbf, gx_read(lg, 9), KD, 0)
                if (d_onorm == 0) { return 16 }
                onorm<Vec<Float>> = bulk_dtoh(d_onorm, KD)
                free_dev(d_onorm)

                raw_dt<String> = gx_read(lg, 10)
                dt<Vec<Float>> = Vec()
                i = 0
                while (i < HEADS * KD) { dt.push(f32_at(raw_dt, i)); i = i + 1 }
                raw_alog<String> = gx_read(lg, 11)
                alog<Vec<Float>> = Vec()
                i = 0
                while (i < HEADS) { alog.push(f32_at(raw_alog, i)); i = i + 1 }

                # ---- attn site: hc mix -> input_layernorm -> KDA -> o_proj -> hc apply
                flat<Vec<Float>> = rms_rows(streams, R, HC * H, Vec())
                d_flat = alloc_dev(R * HC * H * 8)
                d_mv = alloc_dev(R * 24 * 8)
                d_scr = alloc_dev(64)
                if (d_flat == 0 || d_mv == 0 || d_scr == 0) { println("CHAIN_FAIL alloc"); return 17 }
                bulk_htod(d_flat, view(flat))
                if (gemm(fgemm, d_scr, d_flat, d_fnA, d_mv, R, 24, HC * H, 1.0, 0.0) != 0) { return 17 }
                sync()
                mv<Vec<Float>> = bulk_dtoh(d_mv, R * 24)
                free_dev(d_flat)
                free_dev(d_mv)
                free_dev(d_scr)
                free_dev(d_fnA)

                res<Vec<Float>> = hc_glue(mv, base, scale, streams)
                collapsed<Vec<Float>> = Vec()
                i = 0
                while (i < R * H) { collapsed.push(res.get(i)); i = i + 1 }
                postA<Vec<Float>> = Vec()
                i = 0
                while (i < R * HC) { postA.push(res.get(R * H + i)); i = i + 1 }
                combA<Vec<Float>> = Vec()
                i = 0
                while (i < R * HC * HC) { combA.push(res.get(R * H + R * HC + i)); i = i + 1 }
                h_a<Vec<Float>> = rms_rows(collapsed, R, H, in_ln)

                qp<Vec<Float>> = mm_host(h_a, R, H, d_q, HEADS * KD, fgemm)
                kp<Vec<Float>> = mm_host(h_a, R, H, d_k, HEADS * KD, fgemm)
                vp<Vec<Float>> = mm_host(h_a, R, H, d_v, HEADS * KD, fgemm)

                # conv step against this layer's carried ring (copy in, rotate, copy out)
                ringq<Vec<Float>> = Vec()
                ringk<Vec<Float>> = Vec()
                ringv<Vec<Float>> = Vec()
                i = 0
                while (i < (CONV_K - 1) * HEADS * KD) {
                    ringq.push(ringQ.get(kslot * (CONV_K - 1) * HEADS * KD + i))
                    ringk.push(ringK.get(kslot * (CONV_K - 1) * HEADS * KD + i))
                    ringv.push(ringV.get(kslot * (CONV_K - 1) * HEADS * KD + i))
                    i = i + 1
                }
                qres2<Vec<Float>> = conv1_step(qp, ringq, convq)
                kres2<Vec<Float>> = conv1_step(kp, ringk, convk)
                vres2<Vec<Float>> = conv1_step(vp, ringv, convv)
                qc<Vec<Float>> = Vec()
                i = 0
                while (i < HEADS * KD) { qc.push(qres2.get(i)); i = i + 1 }
                i = HEADS * KD
                while (i < qres2.len()) { ringq.set(i - HEADS * KD, qres2.get(i)); i = i + 1 }
                kc<Vec<Float>> = Vec()
                i = 0
                while (i < HEADS * KD) { kc.push(kres2.get(i)); i = i + 1 }
                i = HEADS * KD
                while (i < kres2.len()) { ringk.set(i - HEADS * KD, kres2.get(i)); i = i + 1 }
                vc<Vec<Float>> = Vec()
                i = 0
                while (i < HEADS * KD) { vc.push(vres2.get(i)); i = i + 1 }
                i = HEADS * KD
                while (i < vres2.len()) { ringv.set(i - HEADS * KD, vres2.get(i)); i = i + 1 }
                i = 0
                while (i < (CONV_K - 1) * HEADS * KD) {
                    ringQ.set(kslot * (CONV_K - 1) * HEADS * KD + i, ringq.get(i))
                    ringK.set(kslot * (CONV_K - 1) * HEADS * KD + i, ringk.get(i))
                    ringV.set(kslot * (CONV_K - 1) * HEADS * KD + i, ringv.get(i))
                    i = i + 1
                }

                qn<Vec<Float>> = l2_rows(qc, R * HEADS, KD)
                kn2<Vec<Float>> = l2_rows(kc, R * HEADS, KD)
                i = 0
                while (i < qn.len()) {
                    qn.set(i, qn.get(i) * (1.0 / vsqrt(KD as Float, 40)))
                    i = i + 1
                }

                bet<Vec<Float>> = mm_host(h_a, R, H, d_b, HEADS, fgemm)
                i = 0
                while (i < bet.len()) {
                    bet.set(i, sigmoid(bet.get(i)))
                    i = i + 1
                }
                fa<Vec<Float>> = mm_host(h_a, R, H, d_fa, 128, fgemm)
                fraw<Vec<Float>> = mm_host(fa, R, 128, d_fb, HEADS * KD, fgemm)
                ga<Vec<Float>> = mm_host(h_a, R, H, d_ga, 128, fgemm)
                zraw<Vec<Float>> = mm_host(ga, R, 128, d_gb, HEADS * KD, fgemm)

                gdec<Vec<Float>> = log_decay(fraw, dt, alog)

                # recurrence with the carried state (copy slot in, step, copy back)
                st_t<Vec<Float>> = Vec()
                i = 0
                while (i < HEADS * KD * KD) {
                    st_t.push(stAll.get(kslot * HEADS * KD * KD + i))
                    i = i + 1
                }
                dres<Vec<Float>> = delta_rule_step(qn, kn2, vc, gdec, bet, view(st_t))
                att0<Vec<Float>> = Vec()
                i = 0
                while (i < R * HEADS * KD) { att0.push(dres.get(i)); i = i + 1 }
                i = R * HEADS * KD
                while (i < dres.len()) {
                    stAll.set(kslot * HEADS * KD * KD + (i - R * HEADS * KD), dres.get(i))
                    i = i + 1
                }

                gnorm<Vec<Float>> = gated_norm(att0, zraw, onorm)
                attn = mm_host(gnorm, R, HEADS * KD, d_o, H, fgemm)
                free_dev(d_q)
                free_dev(d_k)
                free_dev(d_v)
                free_dev(d_o)
                free_dev(d_b)
                free_dev(d_fa)
                free_dev(d_fb)
                free_dev(d_ga)
                free_dev(d_gb)

                streams1 = hc_apply(streams, attn, postA, combA)

                if (n < 3) {
                    # ---- dense SwiGLU MLP tail (glm_decode_step.vyb's step body)
                    d_fnF = deq_bf16(fbf, gx_read(lg, 20), 24 * HC * H, HC * H)
                    if (d_fnF == 0) { return 18 }
                    baseF = vecf()
                    raw_baseF<String> = gx_read(lg, 21)
                    j = 0
                    while (j < 24) { baseF.push(f32_at(raw_baseF, j)); j = j + 1 }
                    scaleF = vecf()
                    raw_scaleF<String> = gx_read(lg, 22)
                    j = 0
                    while (j < 3) { scaleF.push(f32_at(raw_scaleF, j)); j = j + 1 }
                    d_gate = deq_bf16(fbf, gx_read(lg, 12), H * INTER, H)
                    d_up = deq_bf16(fbf, gx_read(lg, 13), H * INTER, H)
                    d_down = deq_bf16(fbf, gx_read(lg, 14), INTER * H, INTER)
                    if (d_gate == 0 || d_up == 0 || d_down == 0) { return 19 }

                    reflat<Vec<Float>> = rms_rows(streams1, R, HC * H, Vec())
                    d_flat2 = alloc_dev(R * HC * H * 8)
                    d_mv2 = alloc_dev(R * 24 * 8)
                    d_scr2 = alloc_dev(64)
                    if (d_flat2 == 0 || d_mv2 == 0 || d_scr2 == 0) { return 20 }
                    bulk_htod(d_flat2, view(reflat))
                    if (gemm(fgemm, d_scr2, d_flat2, d_fnF, d_mv2, R, 24, HC * H, 1.0, 0.0) != 0) { return 20 }
                    sync()
                    mv2<Vec<Float>> = bulk_dtoh(d_mv2, R * 24)
                    free_dev(d_flat2)
                    free_dev(d_mv2)
                    free_dev(d_scr2)
                    free_dev(d_fnF)

                    res2<Vec<Float>> = hc_glue(mv2, baseF, scaleF, streams1)
                    collapsed2<Vec<Float>> = Vec()
                    i = 0
                    while (i < R * H) { collapsed2.push(res2.get(i)); i = i + 1 }
                    post2<Vec<Float>> = Vec()
                    i = 0
                    while (i < R * HC) { post2.push(res2.get(R * H + i)); i = i + 1 }
                    comb2<Vec<Float>> = Vec()
                    i = 0
                    while (i < R * HC * HC) { comb2.push(res2.get(R * H + R * HC + i)); i = i + 1 }
                    h2<Vec<Float>> = rms_rows(collapsed2, R, H, post_ln3)

                    mg<Vec<Float>> = mm_host(h2, R, H, d_gate, INTER, fgemm)
                    mu<Vec<Float>> = mm_host(h2, R, H, d_up, INTER, fgemm)
                    act<Vec<Float>> = Vec()
                    i = 0
                    while (i < mg.len()) {
                        act.push(silu(mg.get(i)) * mu.get(i))
                        i = i + 1
                    }
                    mlp = mm_host(act, R, INTER, d_down, H, fgemm)
                    free_dev(d_gate)
                    free_dev(d_up)
                    free_dev(d_down)
                    streams2 = hc_apply(streams1, mlp, post2, comb2)
                } else {
                    # ---- MoE tail (tail_site's body, R = 1)
                    streams2 = moe_tail_step(streams1, lpre, dir, total, idxtext, mapbody, lg,
                                             fgemm, fbf, fdeq, fhgen, fhad1, fhad2)
                }
            }

            println("step" + t.to_string() + " layer " + n.to_string() + " done")
            println(digest("l" + n.to_string() + "s" + t.to_string() + " s2", streams2))
            lines = lines + digest("l" + n.to_string() + "s" + t.to_string() + "attn", attn) + "\n"
            lines = lines + digest("l" + n.to_string() + "s" + t.to_string() + "mlp", mlp) + "\n"
            lines = lines + digest("l" + n.to_string() + "s" + t.to_string() + "s2", streams2) + "\n"
            lines = lines + dumps("d" + t.to_string() + "l" + n.to_string() + "s2", streams2) + "\n"
            lines = lines + dumps("d" + t.to_string() + "l" + n.to_string() + "s1", streams1) + "\n"
            lines = lines + dumps("d" + t.to_string() + "l" + n.to_string() + "attn", attn) + "\n"
            lines = lines + dumps("d" + t.to_string() + "l" + n.to_string() + "mlp", mlp) + "\n"
            streams = streams2
            i = trim_heap()
            n = n + 1
        }
        t = t + 1
    }

    match (open_write(out)) {
        f -> { write_str(f, lines); close(f) }
        ? -> { println("CHAIN_FAIL write"); return 26 }
    }
    println("CHAIN_OK 45 layers x 2 teacher-forced decode steps, all caches carried")
    return 0
}

