// p6r10_fused_expert — validate and time the FULL fused expert projection
// (xhat -> fused matvec -> yhat) against the production dequant + gemm path,
// for ONE expert's gate_proj (4096 x 2048).
//
// The deq path materialises W (33.5 MB) and reads it back for the matvec; the
// fused path never builds W at all. This driver answers two questions at once:
//   1. does the fused composition give the SAME answer as deq+gemm?
//   2. how much faster is it per expert, end to end (incl. the two Hadamard
//      vector passes that the deq path gets for free by materialising W)?
// env: P6_DIR, P6_EXP
import io::{open_read, read_all, close}
import env::{env_get}
import time::{time_mono_millis}
import tensor::{tensor_init, dev_alloc, bulk_htod, bulk_dtoh, sync}
import gx::{gx_read}
import cuda_binding::{cuMemcpyHtoD_v2, cuMemAlloc_v2, cuMemFree_v2, cuCtxSynchronize}
import glm_engine::{load_fn, had_hoist32, mapdev_build, exl3_deq32f, gx_resolve_tab, launch_kernel, wr_pdev, mm_host32, free_dev, H}

main()<Int> -> {
    dir<String> = env_get("P6_DIR") else "/srv/models/hf/hub/models--Mia-AiLab--GLM-5.3-Flash-EXL3-4bpw-TensorFold/snapshots/078455ffe6472f9a52fbc1139f58b9db2881b25c"
    expS<String> = env_get("P6_EXP") else "153"
    e<Int> = 0
    i<Int> = 0
    while (i < expS.len()) {
        c<Int> = (expS.char_at(i) as Int) & 255
        if (c >= 48 && c <= 57) { e = e * 10 + (c - 48) }
        i = i + 1
    }
    if (tensor_init() != 0) { println("P6_FAIL cuda"); return 1 }

    fdqs4<Int> = load_fn("native/build/exl3dq.ptx", "exl3dq1s4")
    fhad232<Int> = load_fn("native/build/exl3.ptx", "exl3had232")
    fhgen32<Int> = load_fn("native/build/exl3.ptx", "exl3hgen32")
    finvk<Int> = load_fn("native/build/exl3.ptx", "exl3inv")
    fxhat<Int> = load_fn("native/build/exl3mv.ptx", "exl3xhat")
    fvh<Int> = load_fn("native/build/exl3mv.ptx", "exl3yhat")
    fmv<Int> = load_fn("native/build/exl3mv.ptx", "mvnod4")
    flut<Int> = load_fn("native/build/exl3mv.ptx", "f16lut")
    if (fdqs4 == 0 || fhad232 == 0 || fhgen32 == 0 || finvk == 0) { println("P6_FAIL kernels"); return 2 }
    if (fxhat == 0 || fvh == 0 || fmv == 0 || flut == 0) { println("P6_FAIL fused=" + fxhat.to_string() + "/" + fmv.to_string() + "/" + fvh.to_string() + "/" + flut.to_string()); return 2 }
    hd_pre32<Int> = had_hoist32(fhgen32)
    if (hd_pre32 == 0) { println("P6_FAIL hadhoist"); return 3 }

    mapd<String> = ""
    match (open_read("native/exl3/map.bin")) {
        f -> { match (read_all(f)) { s -> { mapd = s } ? -> { return 4 } } close(f) }
        ? -> { println("P6_FAIL map.bin"); return 4 }
    }
    mapbody<String> = mapd.substring(16, mapd.len())
    mapdev<Int> = mapdev_build(finvk, mapd)
    if (mapdev == 0) { println("P6_FAIL mapdev"); return 5 }
    invbase<Int> = mapdev + 16 + (mapd.len() - 16)

    arA<Int> = dev_alloc(8388608)
    arB<Int> = dev_alloc(65536)
    arC<Int> = dev_alloc(33554432)
    arD<Int> = dev_alloc(33554432)
    arG<Int> = dev_alloc(16384)
    arH<Int> = dev_alloc(16384)
    arI<Int> = dev_alloc(64)
    pb32<Int> = dev_alloc(192)
    pbf<Int> = dev_alloc(192)
    pbv<Int> = dev_alloc(192)
    if (arA == 0 || arB == 0 || arC == 0 || arD == 0 || arG == 0 || arH == 0 || arI == 0) { println("P6_FAIL arena"); return 6 }

    // half->f32 LUT (the decode indexes it instead of calling fp16_to_f64)
    lut<Int> = dev_alloc(262144)
    wr_pdev(pbf, 0, lut)
    launch_kernel(flut, 256, pbf)
    sync()

    // the tab cache, layer 3
    cache_path<String> = env_get("VYBFORGE_TAB_CACHE") else "native/out/gx_tabs.cache"
    cs<String> = ""
    match (open_read(cache_path)) {
        f -> { match (read_all(f)) { s -> { cs = s } ? -> { return 4 } } close(f) }
        ? -> { println("P6_FAIL tabcache"); return 4 }
    }
    nl0<Int> = find_from(cs, "\n", 0)
    pos<Int> = nl0 + 1
    tab3<String> = ""
    ti<Int> = 0
    while (ti < 45) {
        nl<Int> = find_from(cs, "\n", pos)
        if (nl < 0) { println("P6_FAIL tabcache_trunc"); return 5 }
        plen<Int> = cs.substring(pos, nl).to_int()
        if (ti == 3) { tab3 = cs.substring(nl + 1, nl + 1 + plen) }
        pos = nl + 1 + plen
        ti = ti + 1
    }

    # every layer's resolve table, so the cold-cache loop can resolve real tensors
    tabs<Vec<String>> = Vec()
    {
        nl0b<Int> = find_from(cs, "\n", 0)
        posb<Int> = nl0b + 1
        var<Int> tb = 0
        while (tb < 45) {
            nlb<Int> = find_from(cs, "\n", posb)
            if (nlb < 0) { tb = 45 }
            else {
                plenb<Int> = cs.substring(posb, nlb).to_int()
                tabs.push(cs.substring(nlb + 1, nlb + 1 + plenb))
                posb = nlb + 1 + plenb
                tb = tb + 1
            }
        }
    }
    println("P6R10 TABS loaded=" + tabs.len().to_string())
    epre<String> = "model.language_model.layers.3.mlp.experts." + e.to_string() + "."
    w2<Vec<String>> = Vec()
    w2.push(epre + "gate_proj.trellis")
    w2.push(epre + "gate_proj.suh")
    w2.push(epre + "gate_proj.svh")
    ge<GxLoc> = gx_resolve_tab(tab3, dir, 83, w2)
    g0<String> = gx_read(ge, 0)
    g1<String> = gx_read(ge, 1)
    g2<String> = gx_read(ge, 2)
    if (g0.len() == 0 || g1.len() == 0) { println("P6_FAIL resolve"); return 7 }
    cw<Int> = 2048
    nin<Int> = 4096
    println("P6R10 expert=" + e.to_string() + " trellis=" + g0.len().to_string() + " suh=" + g1.len().to_string() + " svh=" + g2.len().to_string())

    cuMemcpyHtoD_v2(arA, g0, g0.len())
    cuMemcpyHtoD_v2(arG, g1, g1.len())
    cuMemcpyHtoD_v2(arH, g2, g2.len())
    sync()

    // ---- input vector: a fixed, non-trivial pattern ----
    xv<Vec<Float>> = Vec()
    i = 0
    while (i < nin) {
        xv.push(((i % 17) as Float) * 0.0625 - 0.5)
        i = i + 1
    }
    dx64<Int> = dev_alloc(nin * 8)
    dx<Int> = dev_alloc(nin * 4)
    bulk_htod(dx64, view(xv))
    fcast32<Int> = load_fn("native/build/layer.ptx", "cast32")
    wr_pdev(pb32, 0, dx64)
    wr_pdev(pb32, 8, dx)
    wr_pdev(pb32, 16, nin)
    launch_kernel(fcast32, 16, pb32)
    sync()

    // ---- REFERENCE: dequant W then gemm ----
    t0<Int> = time_mono_millis()
    dW<Int> = exl3_deq32f(0, 0, fdqs4, 0, fhad232, g0, g1, g2, mapbody, 2048, 32768, hd_pre32,
                          arA, arB, arC, arD, arG, arH, arI, mapdev, invbase)
    if (dW == 0) { println("P6_FAIL deq"); return 8 }
    t1<Int> = time_mono_millis()
    fgp<Int> = load_fn("native/build/layer.ptx", "gemm32_p")
    fgr<Int> = load_fn("native/build/layer.ptx", "gemm32_r")
    refv<Vec<Float>> = mm_host32(xv, 1, nin, dW, cw, fcast32, fgp, fgr, pb32)
    t2<Int> = time_mono_millis()
    println("P6R10 DEQ_PATH deq_ms=" + (t1 - t0).to_string() + " mm_ms=" + (t2 - t1).to_string() + " total_ms=" + (t2 - t0).to_string())
    # warm GEMM: 20 reps so the 1 ms timer stops being the resolution limit
    ga<Int> = time_mono_millis()
    var<Int> gr = 0
    while (gr < 20) { refv = mm_host32(xv, 1, nin, dW, cw, fcast32, fgp, fgr, pb32) ; gr = gr + 1 }
    sync()
    gb<Int> = time_mono_millis()
    gper<Float> = ((gb - ga) as Float) / 20.0
    println("P6R10 GEMM_WARM per_ms=" + gper.to_string_precise() + " (20 reps)")

    // ---- FUSED: xhat -> matvec -> yhat, W never built ----
    xp<Int> = dev_alloc(nin * 4)
    yr<Int> = dev_alloc(cw * 4)
    dy<Int> = dev_alloc(cw * 8)
    var<Int> tf0 = 0
    var<Int> tf1 = 0
    var<Int> tf2 = 0
    var<Int> tf3 = 0
    var<Int> rep = 0
    while (rep < 20) {
        cuMemcpyHtoD_v2(yr, zero_bytes(cw * 4), cw * 4)
        f0<Int> = time_mono_millis()
        wr_pdev(pbf, 0, dx)
        wr_pdev(pbf, 8, xp)
        wr_pdev(pbf, 16, hd_pre32)
        wr_pdev(pbf, 24, arG)
        wr_pdev(pbf, 32, nin)
        launch_kernel(fxhat, nin / 128, pbf)
        sync()
        f1<Int> = time_mono_millis()
        wr_pdev(pbv, 0, yr)
        wr_pdev(pbv, 8, xp)
        wr_pdev(pbv, 24, cw)
        wr_pdev(pbv, 40, arA)
        wr_pdev(pbv, 48, mapdev)
        wr_pdev(pbv, 56, invbase)
        wr_pdev(pbv, 144, lut)
        # each block (2048 threads) is 8 CTAs of 256, so the grid is 8x the block count
        launch_kernel(fmv, (nin / 64) * (cw / 128) * 8, pbv)
        sync()
        f2<Int> = time_mono_millis()
        wr_pdev(pbf, 0, yr)
        wr_pdev(pbf, 8, dy)
        wr_pdev(pbf, 16, hd_pre32)
        wr_pdev(pbf, 24, cw)
        wr_pdev(pbf, 32, arH)
        launch_kernel(fvh, cw / 128, pbf)
        sync()
        f3<Int> = time_mono_millis()
        tf0 = tf0 + (f1 - f0)
        tf1 = tf1 + (f2 - f1)
        tf2 = tf2 + (f3 - f2)
        tf3 = tf3 + (f3 - f0)
        rep = rep + 1
    }
    # the timings above are per-iteration deltas of the LAST rep (warm); report them as ms
    f0a<Float> = (tf0 as Float) / 20.0
    f1a<Float> = (tf1 as Float) / 20.0
    f2a<Float> = (tf2 as Float) / 20.0
    f3a<Float> = (tf3 as Float) / 20.0
    println("P6R10 FUSED_WARM xhat_ms=" + f0a.to_string_precise() + " mv_ms=" + f1a.to_string_precise() + " yhat_ms=" + f2a.to_string_precise() + " total_ms=" + f3a.to_string_precise() + " (avg of 20)")

    // ---- nt=4 COMPACTED COMPARISON: the production shape ----
    // Production gathers ~nt tokens per expert and calls the matvec with M=nt.
    // Round 71 verified the fused path at nt=1; this checks the same equality
    // with mvnodB + xhatB/yhatB for 4 compacted tokens.
    nt4<Int> = 4
    xs<Vec<Float>> = Vec()
    var<Int> tt = 0
    while (tt < nt4) {
        var<Int> jj = 0
        while (jj < nin) {
            xs.push((((jj + tt * 7) % 17) as Float) * 0.0625 - 0.5)
            jj = jj + 1
        }
        tt = tt + 1
    }
    dx4_64<Int> = dev_alloc(nt4 * nin * 8)
    bulk_htod(dx4_64, view(xs))
    x4f<Int> = dev_alloc(nt4 * nin * 4)
    wr_pdev(pb32, 0, dx4_64)
    wr_pdev(pb32, 8, x4f)
    wr_pdev(pb32, 16, nt4 * nin)
    launch_kernel(fcast32, (nt4 * nin + 255) / 256, pb32)
    sync()

    # reference: the production path (deq + f32 gemm) for the same 4 tokens
    ref4<Vec<Float>> = mm_host32(xs, nt4, nin, dW, cw, fcast32, fgp, fgr, pb32)

    fxb<Int> = load_fn("native/build/exl3mv.ptx", "xhatB")
    fyb<Int> = load_fn("native/build/exl3mv.ptx", "yhatB")
    fmb4<Int> = load_fn("native/build/exl3mv.ptx", "mvnodB")
    if (fxb != 0 && fyb != 0 && fmb4 != 0) {
        xp4<Int> = dev_alloc(nt4 * nin * 4)
        yr4<Int> = dev_alloc(nt4 * cw * 4)
        dy4<Int> = dev_alloc(nt4 * cw * 8)
        # xhatB: +0 x, +8 out, +16 H, +24 su, +32 nin, +40 B
        wr_pdev(pbf, 0, x4f)
        wr_pdev(pbf, 8, xp4)
        wr_pdev(pbf, 16, hd_pre32)
        wr_pdev(pbf, 24, arG)
        wr_pdev(pbf, 32, nin)
        wr_pdev(pbf, 40, nt4)
        launch_kernel(fxb, nt4 * (nin / 128), pbf)
        sync()
        # mvnodB: +0 T, +8 X, +24 cw, +40 q, +48 td, +56 inv, +144 LUT, +168 B, +176 nin
        cuMemcpyHtoD_v2(yr4, zero_bytes(nt4 * cw * 4), nt4 * cw * 4)
        wr_pdev(pbv, 0, yr4)
        wr_pdev(pbv, 8, xp4)
        wr_pdev(pbv, 24, cw)
        wr_pdev(pbv, 40, arA)
        wr_pdev(pbv, 48, mapdev)
        wr_pdev(pbv, 56, invbase)
        wr_pdev(pbv, 144, lut)
        wr_pdev(pbv, 168, nt4)
        wr_pdev(pbv, 176, nin)
        q0<Int> = time_mono_millis()
        launch_kernel(fmb4, (nin / 64) * (cw / 128) * 8, pbv)
        sync()
        q1<Int> = time_mono_millis()
        # yhatB: +0 YR, +8 Y, +16 H, +24 cw, +32 SV, +40 B
        wr_pdev(pbf, 0, yr4)
        wr_pdev(pbf, 8, dy4)
        wr_pdev(pbf, 16, hd_pre32)
        wr_pdev(pbf, 24, cw)
        wr_pdev(pbf, 32, arH)
        wr_pdev(pbf, 40, nt4)
        launch_kernel(fyb, nt4 * (cw / 128), pbf)
        sync()
        FU<Vec<Float>> = bulk_dtoh(dy4, nt4 * cw)
        var<Int> nbad4 = 0
        var<Float> mx4 = 0.0
        var<Float> rmx = 0.0
        var<Int> z4 = 0
        while (z4 < nt4 * cw) {
            gv4<Float> = FU.get(z4)
            rv4<Float> = ref4.get(z4)
            dv4<Float> = gv4 - rv4
            if (dv4 < 0.0) { dv4 = 0.0 - dv4 }
            if (dv4 > 1e-4) { nbad4 = nbad4 + 1 }
            if (dv4 > mx4) { mx4 = dv4 }
            av4<Float> = rv4
            if (av4 < 0.0) { av4 = 0.0 - av4 }
            if (av4 > rmx) { rmx = av4 }
            z4 = z4 + 1
        }
        println("P6R10 NT4 mv_ms=" + (q1 - q0).to_string() + " count_over_1e-4=" + nbad4.to_string() + " max_abs=" + mx4.to_string_precise() + " ref_max=" + rmx.to_string_precise() + " of " + (nt4 * cw).to_string())
        println("P6R10 NT4 fused0=" + FU.get(0).to_string_precise() + " ref0=" + ref4.get(0).to_string_precise())
        if (nbad4 == 0) { println("P6R10 NT4_PASS fused == deq+gemm for 4 compacted tokens") }
        else { println("P6R10 NT4_FAIL fused != deq+gemm") }
    } else {
        println("P6R10 NT4_SKIP handles xhatB=" + fxb.to_string() + " yhatB=" + fyb.to_string() + " mvnodB=" + fmb4.to_string())
    }

    // ---- DETERMINISTIC MATVEC COST: atomic mvnodB vs mvnodB_det + mvnodR (4096 slots) ----
    // Answers one question: does writing 4096 per-split partials and reducing them cost more than the
    // atomic accumulation it replaces? Same params, same B, 20 warm reps each.
    fdet<Int> = load_fn("native/build/exl3mv.ptx", "mvnodB_det")
    fred<Int> = load_fn("native/build/exl3mv.ptx", "mvnodR")
    fzf<Int> = load_fn("native/build/exl3mv.ptx", "zfill")
    fatom<Int> = load_fn("native/build/exl3mv.ptx", "mvnodB")
    println("P6R10 DET handles det=" + fdet.to_string() + " red=" + fred.to_string() + " zf=" + fzf.to_string() + " atom=" + fatom.to_string())
    if (fdet != 0 && fred != 0 && fzf != 0 && fatom != 0) {
        var<Int> Bd = 1
        dTy<Int> = dev_alloc(cw * 4)
        dXy<Int> = dev_alloc(nin * 4)
        # contributions per output = rb64 (nin/64) x cta (8) = 512 for the gate shape, NOT 4096:
        # launch_kernel uses 256-thread blocks, so the 8 CTAs are 8 PHYSICAL blocks and each
        # rb64 group covers 64 rows. Verified against the grid: (nin/64)*(cw/128)*8 physical
        # blocks = (nin/64)*(cw/128) logical 2048-thread units.
        nslot<Int> = (nin / 64) * 8
        dPy<Int> = dev_alloc(nslot * Bd * cw * 4)
        println("P6R10 DET partial buffer MB=" + (nslot * Bd * cw * 4 / 1048576).to_string())
        if (dTy != 0 && dXy != 0 && dPy != 0) {
            # ---- atomic baseline ----
            wr_pdev(pbv, 0, dTy)
            wr_pdev(pbv, 8, dXy)
            wr_pdev(pbv, 24, cw)
            wr_pdev(pbv, 40, arA)
            wr_pdev(pbv, 48, mapdev)
            wr_pdev(pbv, 56, invbase)
            wr_pdev(pbv, 144, lut)
            wr_pdev(pbv, 168, Bd)
            wr_pdev(pbv, 176, nin)
            launch_kernel(fatom, (nin / 64) * (cw / 128) * 8, pbv)
            sync()
            ta0<Int> = time_mono_millis()
            var<Int> ra = 0
            while (ra < 20) { launch_kernel(fatom, (nin / 64) * (cw / 128) * 8, pbv) ; ra = ra + 1 }
            sync()
            ta1<Int> = time_mono_millis()
            atomms<Float> = ((ta1 - ta0) as Float) / 20.0

            # ---- deterministic path: zero + det + reduce ----
            tz0<Int> = time_mono_millis()
            var<Int> rz = 0
            while (rz < 20) {
                wr_pdev(pbv, 0, dPy)
                wr_pdev(pbv, 8, nslot * Bd * cw)
                launch_kernel(fzf, (nslot * Bd * cw + 255) / 256, pbv)
                rz = rz + 1
            }
            sync()
            tz1<Int> = time_mono_millis()
            zfms<Float> = ((tz1 - tz0) as Float) / 20.0

            td0<Int> = time_mono_millis()
            var<Int> rd = 0
            while (rd < 20) {
                wr_pdev(pbv, 0, dTy)
                wr_pdev(pbv, 8, dXy)
                wr_pdev(pbv, 24, cw)
                wr_pdev(pbv, 40, arA)
                wr_pdev(pbv, 48, mapdev)
                wr_pdev(pbv, 56, invbase)
                wr_pdev(pbv, 144, lut)
                wr_pdev(pbv, 168, Bd)
                wr_pdev(pbv, 176, nin)
                wr_pdev(pbv, 184, dPy)
                launch_kernel(fdet, (nin / 64) * (cw / 128) * 8, pbv)
                rd = rd + 1
            }
            sync()
            td1<Int> = time_mono_millis()
            detms<Float> = ((td1 - td0) as Float) / 20.0

            tr0<Int> = time_mono_millis()
            var<Int> rr2 = 0
            while (rr2 < 20) {
                wr_pdev(pbv, 0, dTy)
                wr_pdev(pbv, 8, dPy)
                wr_pdev(pbv, 16, Bd)
                wr_pdev(pbv, 24, cw)
                wr_pdev(pbv, 32, nslot)
                launch_kernel(fred, (Bd * cw + 255) / 256, pbv)
                rr2 = rr2 + 1
            }
            sync()
            tr1<Int> = time_mono_millis()
            redms<Float> = ((tr1 - tr0) as Float) / 20.0

            # ---- COVERAGE TEST: does the det path give the SAME result with and without the zero? ----
            # If the partial buffer is fully overwritten every call, the zero is dead weight (0.20 ms).
            dTz<Int> = dev_alloc(cw * 4)
            dTn<Int> = dev_alloc(cw * 4)
            if (dTz != 0 && dTn != 0) {
                # with zero
                wr_pdev(pbv, 0, dPy)
                wr_pdev(pbv, 8, nslot * Bd * cw)
                launch_kernel(fzf, (nslot * Bd * cw + 255) / 256, pbv)
                sync()
                wr_pdev(pbv, 0, dTz)
                wr_pdev(pbv, 8, dXy)
                wr_pdev(pbv, 24, cw)
                wr_pdev(pbv, 40, arA)
                wr_pdev(pbv, 48, mapdev)
                wr_pdev(pbv, 56, invbase)
                wr_pdev(pbv, 144, lut)
                wr_pdev(pbv, 168, Bd)
                wr_pdev(pbv, 176, nin)
                wr_pdev(pbv, 184, dPy)
                launch_kernel(fdet, (nin / 64) * (cw / 128) * 8, pbv)
                sync()
                wr_pdev(pbv, 0, dTz)
                wr_pdev(pbv, 8, dPy)
                wr_pdev(pbv, 16, Bd)
                wr_pdev(pbv, 24, cw)
                wr_pdev(pbv, 32, nslot)
                launch_kernel(fred, (Bd * cw + 255) / 256, pbv)
                sync()
                # WITHOUT zero -- fill P with garbage first so a missed slot would show up
                var<Int> gg = 0
                while (gg < 20) { wr_pdev(dPy, gg * 8, 0x7FC000007FC00000) ; gg = gg + 1 }
                sync()
                wr_pdev(pbv, 0, dTn)
                wr_pdev(pbv, 8, dXy)
                wr_pdev(pbv, 24, cw)
                wr_pdev(pbv, 40, arA)
                wr_pdev(pbv, 48, mapdev)
                wr_pdev(pbv, 56, invbase)
                wr_pdev(pbv, 144, lut)
                wr_pdev(pbv, 168, Bd)
                wr_pdev(pbv, 176, nin)
                wr_pdev(pbv, 184, dPy)
                launch_kernel(fdet, (nin / 64) * (cw / 128) * 8, pbv)
                sync()
                wr_pdev(pbv, 0, dTn)
                wr_pdev(pbv, 8, dPy)
                wr_pdev(pbv, 16, Bd)
                wr_pdev(pbv, 24, cw)
                wr_pdev(pbv, 32, nslot)
                launch_kernel(fred, (Bd * cw + 255) / 256, pbv)
                sync()
                VZ<Vec<Float>> = bulk_dtoh(dTz, cw)
                VN<Vec<Float>> = bulk_dtoh(dTn, cw)
                var<Int> nbad5 = 0
                var<Float> mx5 = 0.0
                var<Int> q5 = 0
                while (q5 < cw) {
                    d5<Float> = VZ.get(q5) - VN.get(q5)
                    if (d5 < 0.0) { d5 = 0.0 - d5 }
                    if (d5 > 1e-6) { nbad5 = nbad5 + 1 }
                    if (d5 > mx5) { mx5 = d5 }
                    q5 = q5 + 1
                }
                println("P6R10 COVERAGE with_vs_without_zero count_over_1e-6=" + nbad5.to_string() + " max_abs=" + mx5.to_string_precise() + " of " + cw.to_string())
                if (nbad5 == 0) { println("P6R10 COVERAGE_OK -> the zero is dead weight, drop it") }
                else { println("P6R10 COVERAGE_GAP -> some slots are NOT written; the zero is required") }
                free_dev(dTz)
                free_dev(dTn)
            }
            tot<Float> = zfms + detms + redms
            println("P6R10 DETCOST atomic_ms=" + atomms.to_string_precise() + " det_ms=" + detms.to_string_precise() + " zero_ms=" + zfms.to_string_precise() + " reduce_ms=" + redms.to_string_precise() + " total_ms=" + tot.to_string_precise() + " ratio=" + (tot / atomms).to_string_precise())
            free_dev(dPy)
        }
        free_dev(dTy)
        free_dev(dXy)
    }

    // ---- GATHER-COST SPIKE: 20 launches each, divided for sub-ms resolution ----
    fng<Int> = load_fn("native/build/exl3mv.ptx", "mvnod5")
    if (fng != 0) {
        cuMemcpyHtoD_v2(yr, zero_bytes(cw * 4), cw * 4)
        launch_kernel(fmv, (nin / 64) * (cw / 128) * 8, pbv)
        sync()
        cuMemcpyHtoD_v2(yr, zero_bytes(cw * 4), cw * 4)
        launch_kernel(fng, (nin / 64) * (cw / 128) * 8, pbv)
        sync()
        ta<Int> = time_mono_millis()
        rep = 0
        while (rep < 20) {
            launch_kernel(fmv, (nin / 64) * (cw / 128) * 8, pbv)
            rep = rep + 1
        }
        sync()
        tb<Int> = time_mono_millis()
        tc<Int> = time_mono_millis()
        rep = 0
        while (rep < 20) {
            launch_kernel(fng, (nin / 64) * (cw / 128) * 8, pbv)
            rep = rep + 1
        }
        sync()
        td2<Int> = time_mono_millis()
        ra<Float> = ((tb - ta) as Float) / 20.0
        ng<Float> = ((td2 - tc) as Float) / 20.0
        println("P6R10 GATHER_SPIKE real_gather_ms=" + ra.to_string_precise() + " nogather_ms=" + ng.to_string_precise() + " ratio=" + (ra / ng).to_string_precise())
    }
    // ---- BATCH SWEEP: weights decoded once, B tokens amortise them ----
    mvk<String> = env_get("P6_MVK") else "mvnodB"
    println("P6R10 MVKERNEL " + mvk)
    fmb<Int> = load_fn("native/build/exl3mv.ptx", mvk)
    println("P6R10 MVK handle=" + fmb.to_string())
    if (fmb != 0) {
        var<Int> B = 1
        while (B <= 128) {
            dxb<Int> = dev_alloc(nin * 4 * B)
            tyb<Int> = dev_alloc(cw * 4 * B)
            xpb<Int> = dev_alloc(nin * 4 * B)
            if (dxb != 0 && tyb != 0 && xpb != 0) {
                # throughput measurement only: no zeroing (zero_bytes is O(n) string
                # concatenation in Vyb and took minutes at MB sizes)
                wr_pdev(pbf, 0, dx)
                wr_pdev(pbf, 8, xpb)
                wr_pdev(pbf, 16, hd_pre32)
                wr_pdev(pbf, 24, arG)
                wr_pdev(pbf, 32, nin)
                launch_kernel(fxhat, nin / 128, pbf)
                sync()
                # warm
                wr_pdev(pbv, 0, tyb)
                wr_pdev(pbv, 8, xpb)
                wr_pdev(pbv, 24, cw)
                wr_pdev(pbv, 40, arA)
                wr_pdev(pbv, 48, mapdev)
                wr_pdev(pbv, 56, invbase)
                wr_pdev(pbv, 144, lut)
                wr_pdev(pbv, 168, B)
                wr_pdev(pbv, 176, nin)
                launch_kernel(fmb, (nin / 64) * (cw / 128) * 8, pbv)
                sync()
                tb0<Int> = time_mono_millis()
                var<Int> rp = 0
                while (rp < 10) {
                    launch_kernel(fmb, (nin / 64) * (cw / 128) * 8, pbv)
                    rp = rp + 1
                }
                sync()
                tb1<Int> = time_mono_millis()
                per<Float> = ((tb1 - tb0) as Float) / 10.0
                println("P6R10 BATCH B=" + B.to_string() + " mv_ms=" + per.to_string_precise() + " ms_per_token=" + (per / (B as Float)).to_string_precise())
                free_dev(dxb)
                free_dev(tyb)
                free_dev(xpb)
            }
            B = B * 2
        }
    }
    // ---- DECODE STAGE BREAKDOWN: where do the MoE's milliseconds actually go? ----
    if (fmb != 0) {
        fd1<Int> = load_fn("native/build/dparts.ptx", "d_tile")
        fd2<Int> = load_fn("native/build/dparts.ptx", "d_nib")
        fd3<Int> = load_fn("native/build/dparts.ptx", "d_hash")
        fd4<Int> = load_fn("native/build/dparts.ptx", "d_lut")
        println("P6R10 DPART handles " + fd1.to_string() + " " + fd2.to_string() + " " + fd3.to_string() + " " + fd4.to_string())
        sinkd<Int> = dev_alloc(8388608)
        gblocks<Int> = (nin / 64) * (cw / 128) * 8
        println("P6R10 DPART grid=" + gblocks.to_string())
        var<Int> st = 0
        while (st < 4) {
            fcur<Int> = fd1
            if (st == 1) { fcur = fd2 }
            if (st == 2) { fcur = fd3 }
            if (st == 3) { fcur = fd4 }
            wr_pdev(pbv, 0, sinkd)
            wr_pdev(pbv, 24, cw)
            wr_pdev(pbv, 40, arA)
            wr_pdev(pbv, 48, mapdev)
            wr_pdev(pbv, 56, invbase)
            wr_pdev(pbv, 144, lut)
            wr_pdev(pbv, 176, nin)
            # warm
            launch_kernel(fcur, gblocks, pbv)
            sync()
            d0<Int> = time_mono_millis()
            var<Int> rq = 0
            while (rq < 50) { launch_kernel(fcur, gblocks, pbv) ; rq = rq + 1 }
            sync()
            d1<Int> = time_mono_millis()
            pt<Float> = ((d1 - d0) as Float) / 50.0
            nm2<String> = "tile"
            if (st == 1) { nm2 = "nib" }
            if (st == 2) { nm2 = "hash" }
            if (st == 3) { nm2 = "lut" }
            println("P6R10 DPART " + nm2 + " ms=" + pt.to_string_precise())
            st = st + 1
        }
    }
    // ---- per-token Hadamard passes: xhat + yhat for B tokens ----
    if (fmb != 0) {
        var<Int> B2 = 32
        dxp<Int> = dev_alloc(nin * 4 * B2)
        dyp<Int> = dev_alloc(cw * 8 * B2)
        if (dxp != 0 && dyp != 0) {
            cuMemcpyHtoD_v2(dxp, zero_bytes(nin * 4 * B2), nin * 4 * B2)
            cuMemcpyHtoD_v2(dyp, zero_bytes(cw * 8 * B2), cw * 8 * B2)
            # warm
            wr_pdev(pbf, 0, dx)
            wr_pdev(pbf, 8, xp)
            wr_pdev(pbf, 16, hd_pre32)
            wr_pdev(pbf, 24, arG)
            wr_pdev(pbf, 32, nin)
            launch_kernel(fxhat, nin / 128, pbf)
            sync()
            fxb<Int> = load_fn("native/build/exl3mv.ptx", "xhatB")
            fyb<Int> = load_fn("native/build/exl3mv.ptx", "yhatB")
            if (fxb != 0 && fyb != 0) {
                # one launch for all B tokens
                wr_pdev(pbf, 0, dxp)
                wr_pdev(pbf, 8, dxp)
                wr_pdev(pbf, 16, hd_pre32)
                wr_pdev(pbf, 24, arG)
                wr_pdev(pbf, 32, nin)
                wr_pdev(pbf, 40, B2)
                launch_kernel(fxb, B2 * (nin / 128), pbf)
                sync()
                q0<Int> = time_mono_millis()
                var<Int> rq = 0
                while (rq < 10) {
                    launch_kernel(fxb, B2 * (nin / 128), pbf)
                    rq = rq + 1
                }
                sync()
                q1<Int> = time_mono_millis()
                wr_pdev(pbf, 0, dxp)
                wr_pdev(pbf, 8, dyp)
                wr_pdev(pbf, 16, hd_pre32)
                wr_pdev(pbf, 24, cw)
                wr_pdev(pbf, 32, arH)
                wr_pdev(pbf, 40, B2)
                launch_kernel(fyb, B2 * (cw / 128), pbf)
                sync()
                q2<Int> = time_mono_millis()
                rq = 0
                while (rq < 10) {
                    launch_kernel(fyb, B2 * (cw / 128), pbf)
                    rq = rq + 1
                }
                sync()
                q3<Int> = time_mono_millis()
                xhb<Float> = (((q1 - q0) as Float) / 10.0) / (B2 as Float)
                yhb<Float> = (((q3 - q2) as Float) / 10.0) / (B2 as Float)
                println("P6R10 TOKEN_PASSES_BATCHED xhat_ms_per_token=" + xhb.to_string_precise() + " yhat_ms_per_token=" + yhb.to_string_precise())
            }
            p0<Int> = time_mono_millis()
            var<Int> bb = 0
            while (bb < B2) {
                wr_pdev(pbf, 0, dx)
                wr_pdev(pbf, 8, xp)
                wr_pdev(pbf, 16, hd_pre32)
                wr_pdev(pbf, 24, arG)
                wr_pdev(pbf, 32, nin)
                launch_kernel(fxhat, nin / 128, pbf)
                bb = bb + 1
            }
            sync()
            p1<Int> = time_mono_millis()
            p2t<Int> = time_mono_millis()
            bb = 0
            while (bb < B2) {
                wr_pdev(pbf, 0, yr)
                wr_pdev(pbf, 8, dyp)
                wr_pdev(pbf, 16, hd_pre32)
                wr_pdev(pbf, 24, cw)
                wr_pdev(pbf, 32, arH)
                launch_kernel(fvh, cw / 128, pbf)
                bb = bb + 1
            }
            sync()
            p3t<Int> = time_mono_millis()
            xh<Float> = ((p1 - p0) as Float) / (B2 as Float)
            yh<Float> = ((p3t - p2t) as Float) / (B2 as Float)
            println("P6R10 TOKEN_PASSES xhat_ms_per_token=" + xh.to_string_precise() + " yhat_ms_per_token=" + yh.to_string_precise())
        }
    }
    // ---- BATCHED SERVE LOOP, COLD CACHE: rotate through 21 layers' gate_proj ----
    // 21 distinct experts x 4.2 MB = ~88 MB of packed weights, well past any L2,
    // so the matvec pays the real cold read instead of hitting a cached expert.
    if (fmb != 0) {
        qs<Vec<Int>> = Vec()
        sus<Vec<Int>> = Vec()
        svs<Vec<Int>> = Vec()
        var<Int> nset = 0
        var<Int> L2 = 3
        while (L2 <= 23) {
            pfx<String> = "model.language_model.layers." + L2.to_string() + ".mlp.experts." + e.to_string() + ".gate_proj."
            wl<Vec<String>> = Vec()
            wl.push(pfx + "trellis")
            wl.push(pfx + "suh")
            wl.push(pfx + "svh")
            tl<String> = tab3
            # the cache is 0-indexed by layer: layer 3 is tabs[3]
            if (L2 < tabs.len()) { tl = tabs.get(L2) }
            gl<GxLoc> = gx_resolve_tab(tl, dir, 83, wl)
            c0<String> = gx_read(gl, 0)
            c1<String> = gx_read(gl, 1)
            c2<String> = gx_read(gl, 2)
            if (c0.len() > 0 && c1.len() > 0 && c2.len() > 0) {
                dq<Int> = dev_alloc(c0.len())
                du<Int> = dev_alloc(c1.len())
                dv<Int> = dev_alloc(c2.len())
                if (dq != 0 && du != 0 && dv != 0) {
                    cuMemcpyHtoD_v2(dq, c0, c0.len())
                    cuMemcpyHtoD_v2(du, c1, c1.len())
                    cuMemcpyHtoD_v2(dv, c2, c2.len())
                    qs.push(dq)
                    sus.push(du)
                    svs.push(dv)
                    nset = nset + 1
                }
            }
            L2 = L2 + 1
        }
        sync()
        println("P6R10 SERVE_SETS n=" + nset.to_string() + " packed_MB=" + ((nset * 4194304) / 1000000).to_string())
        if (nset > 0) {
            var<Int> BS2 = 128
            xs<Int> = dev_alloc(nin * 4 * BS2)
            ts<Int> = dev_alloc(cw * 4 * BS2)
            if (xs != 0 && ts != 0) {
                # warm every set once
                var<Int> wz = 0
                while (wz < nset) {
                    wr_pdev(pbv, 0, ts)
                    wr_pdev(pbv, 8, xs)
                    wr_pdev(pbv, 24, cw)
                    wr_pdev(pbv, 40, qs.get(wz))
                    wr_pdev(pbv, 48, mapdev)
                    wr_pdev(pbv, 56, invbase)
                    wr_pdev(pbv, 144, lut)
                    wr_pdev(pbv, 168, BS2)
                    wr_pdev(pbv, 176, nin)
                    launch_kernel(fmb, (nin / 64) * (cw / 128) * 8, pbv)
                    wz = wz + 1
                }
                sync()
                s0<Int> = time_mono_millis()
                var<Int> L3 = 0
                var<Int> ci = 0
                while (L3 < 45) {
                    var<Int> ex2 = 0
                    while (ex2 < 9) {
                        var<Int> pj = 0
                        while (pj < 3) {
                            wr_pdev(pbv, 40, qs.get(ci))
                            launch_kernel(fmb, (nin / 64) * (cw / 128) * 8, pbv)
                            ci = ci + 1
                            if (ci >= nset) { ci = 0 }
                            pj = pj + 1
                        }
                        ex2 = ex2 + 1
                    }
                    L3 = L3 + 1
                }
                sync()
                s1<Int> = time_mono_millis()
                step_ms2<Float> = (s1 - s0) as Float
                println("P6R10 SERVE_LOOP_COLD launches=1215 batch=128 sets=" + nset.to_string() + " step_ms=" + step_ms2.to_string_precise() + " tok_per_s=" + ((128.0 * 1000.0) / step_ms2).to_string_precise())
            }
        }
    }
    // ---- ATTENTION PROJECTION at B=128: shape derived from suh/svh lengths ----
    if (fmb != 0) {
        apre<String> = "model.language_model.layers.3.self_attn.q_proj."
        wa<Vec<String>> = Vec()
        wa.push(apre + "trellis")
        wa.push(apre + "suh")
        wa.push(apre + "svh")
        ga<GxLoc> = gx_resolve_tab(tab3, dir, 83, wa)
        a0<String> = gx_read(ga, 0)
        a1<String> = gx_read(ga, 1)
        a2<String> = gx_read(ga, 2)
        if (a1.len() > 0 && a2.len() > 0) {
            ninA<Int> = a1.len() / 2
            cwA<Int> = a2.len() / 2
            println("P6R10 ATTN q_proj nin=" + ninA.to_string() + " cw=" + cwA.to_string() + " trellis=" + a0.len().to_string())
            cuMemcpyHtoD_v2(arA, a0, a0.len())
            cuMemcpyHtoD_v2(arG, a1, a1.len())
            cuMemcpyHtoD_v2(arH, a2, a2.len())
            sync()
            var<Int> BA = 128
            dxa<Int> = dev_alloc(ninA * 4 * BA)
            tya<Int> = dev_alloc(cwA * 4 * BA)
            if (dxa != 0 && tya != 0) {
                wr_pdev(pbv, 0, tya)
                wr_pdev(pbv, 8, dxa)
                wr_pdev(pbv, 24, cwA)
                wr_pdev(pbv, 40, arA)
                wr_pdev(pbv, 48, mapdev)
                wr_pdev(pbv, 56, invbase)
                wr_pdev(pbv, 144, lut)
                wr_pdev(pbv, 168, BA)
                wr_pdev(pbv, 176, ninA)
                launch_kernel(fmb, (ninA / 64) * (cwA / 128) * 8, pbv)
                sync()
                ta0<Int> = time_mono_millis()
                var<Int> ra = 0
                while (ra < 10) {
                    launch_kernel(fmb, (ninA / 64) * (cwA / 128) * 8, pbv)
                    ra = ra + 1
                }
                sync()
                ta1<Int> = time_mono_millis()
                pa<Float> = ((ta1 - ta0) as Float) / 10.0
                bya<Float> = 2.0 * (a0.len() as Float)
                println("P6R10 ATTN_MV B=128 mv_ms=" + pa.to_string_precise() + " ms_per_token=" + (pa / 128.0).to_string_precise() + " GBps=" + (bya / (pa * 1000000.0)).to_string_precise())
            }
        } else { println("P6R10 ATTN resolve failed a1=" + a1.len().to_string()) }
    }
    // ---- compare ----
    fv<Vec<Float>> = bulk_dtoh(dy, cw)
    var<Int> nbad = 0
    var<Float> mx = 0.0
    var<Float> rel = 0.0
    var<Int> fb = -1
    i = 0
    while (i < cw) {
        dv<Float> = fv.get(i) - refv.get(i)
        adv<Float> = dv
        if (adv < 0.0) { adv = 0.0 - adv }
        if (adv > mx) { mx = adv }
        rv<Float> = refv.get(i)
        if (rv < 0.0) { rv = 0.0 - rv }
        if (rv > rel) { rel = rv }
        if (adv > 1e-4) { if (fb < 0) { fb = i } ; nbad = nbad + 1 }
        i = i + 1
    }
    println("P6R10 GATE count_over_1e-4=" + nbad.to_string() + " max_abs=" + mx.to_string_precise() + " ref_max=" + rel.to_string_precise() + " first_bad=" + fb.to_string())
    println("P6R10 y0 fused=" + fv.get(0).to_string_precise() + " ref=" + refv.get(0).to_string_precise())
    println("P6R10_DONE")
    return 0
}

zero_bytes(n<Int>)<String> -> {
    s<String> = ""
    k<Int> = 0
    while (k < n) { s = s + " " ; k = k + 1 }
    return s
}

find_from(s<String>, needle<String>, start<Int>)<Int> -> {
    n<Int> = s.len()
    m<Int> = needle.len()
    i<Int> = start
    while (i <= n - m) {
        ok<Int> = 1
        j<Int> = 0
        while (j < m) {
            if (s.char_at(i + j) != needle.char_at(j)) { ok = 0 ; j = m }
            j = j + 1
        }
        if (ok == 1) { return i }
        i = i + 1
    }
    return 0 - 1
}
