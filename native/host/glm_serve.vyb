# glm_serve.vyb — the GLM-5.3 serving engine + OpenAI-compatible endpoint.
#
# ARCHITECTURE (doc/SERVING-ENDPOINT-SCOPING.md):
#   - The ENGINE (this file's deterministic core): the packed weights, the
#     on-demand deq, the hybrid caches (34 KDA fixed states + 11+1 DSA token
#     caches), the prefill + the decode step loop. NO request I/O here.
#   - The SERVER (serve_main, bottom): the stdlib http listener, the request
#     parse, the slot allocation, the SSE streaming of the generated tokens.
#   - CORRECTNESS: this program reuses the SAME verified module functions the
#     gated glm_decode_chain.vyb uses (kda_attn_site / dsa_attn_site_c /
#     moe_tail_step / exl3_deq32 / the had_hoist prebuilt buffers). The chain
#     gate (DECODE_CHAIN_MATCH: OK) stays the regression oracle: any change to
#     the shared functions re-runs it. This file's own outputs are verified the
#     same way (its streams vs the prefill reference through
#     verify_decode_chain.py's per-layer metric).
#
# STATUS: scaffold — the architecture and the I/O shape are fixed; the weights
# load, the phase-1 prefill body, and the decode step body port from
# glm_decode_chain.vyb's proven sections in the next pass (mechanical, the
# sections are marked PORT: below).

import http::{http_listen, http_accept, http_read_head, http_request_path, http_send_all, http_close, http_response}
import io::{open_read, read_all, read_at, close}
import env::{env_get}
import tensor::{tensor_init, module_load_path, module_func, dev_alloc, bulk_htod, bulk_dtoh, sync, gemm}
import deq_cache::{cache_save, cache_load, deq_cache_dir}
import glm_engine::{engine_run}

# ---- the config constants come from the glm_engine module exports ----

# ---- the engine state (module-scope; the caches + the weights live here) ----
# PORT: the packed-weight handles, the KDA state/ring buffers, the DSA caches,
# the hoisted Hadamard buffers (had_hoist/had_hoist32 + mapdev/invbase), and
# the deq arena move here from the chain's setup section — the definitions are
# copied verbatim, the module scope replaces main's locals.
stAll<Vec<Float>> = Vec()
ringQ<Vec<Float>> = Vec()
ringK<Vec<Float>> = Vec()
ringV<Vec<Float>> = Vec()
ckvAll<Vec<Float>> = Vec()
ikAll<Vec<Float>> = Vec()
gscAll<Vec<Float>> = Vec()

# ---- the engine API ----

# engine_init(): load the packed weights, build the hoists, allocate the
# caches for MAXCTX tokens. Returns 0 on success. PORT: the chain's setup
# section (the gx index load, the d_* device weights, the hoists, the deq
# arena) moves here verbatim.
engine_init()<Int> -> {
    if (tensor_init() != 0) { println("SERVE_FAIL no cuda"); return 1 }
    return 0
}

# engine_prefill(tokens<Vec<Int>>): run the prompt through all 45 layers,
# building the KDA states and appending the DSA rows. PORT: the chain's
# phase-1 section (the R=nt batched prefill, the sites verbatim).
engine_prefill(tokens<Vec<Int>>)<Int> -> {
    return 0
}

# engine_step(): one decode step from the current cache state; returns the
# argmax token. PORT: the chain's phase-2 per-step body (the 45-layer walk,
# the MTP head, the final lm_head argmax).
engine_step()<Int> -> {
    return 0
}

# ---- the server ----

# POST /v1/generate  {"prompt_ids": [785, ...], "nsteps": 2}
#   -> {"draft_token": 10788}
# The ids-based v1 API: the GLM BPE tokenizer port is its own phase (the
# tokenizer is a big deterministic program in its own right); until then the
# clients send the token ids (the gold ids round-trip is the smoke test).
handle_generate(query<String>)<String> -> {
    tok<String> = env_get("VYBFORGE_SERVE_TOKEN") else ""
    # extract prompt_ids (the comma list inside the JSON) without a full JSON
    # dependency: find the "prompt_ids" key, then the [ ... ] span.
    k<Int> = query.index_of("ids=")
    if (k < 0) { return http_response(400, "{\"error\": \"ids missing\"}") }
    amp<Int> = query.substring(k, query.len()).index_of("&")
    endq<Int> = query.len()
    if (amp > 0) { endq = k + amp }
    csv<String> = query.substring(k + 4, endq)
    # strip the spaces
    clean<String> = ""
    i<Int> = 0
    while (i < csv.len()) {
        ch<String> = csv.substring(i, i + 1)
        if (ch != " " && ch != "\n" && ch != "\r" && ch != "\t") { clean = clean + ch }
        i = i + 1
    }
    ns<Int> = 2
    nk<Int> = query.index_of("nsteps=")
    if (nk >= 0) {
        d<String> = ""
        j<Int> = nk + 7
        while (j < query.len()) {
            ch<String> = query.substring(j, j + 1)
            if (ch >= "0" && ch <= "9") { d = d + ch }
            else { if (d.len() > 0) { j = query.len() } }
            j = j + 1
        }
        if (d.len() > 0) { ns = d.to_int() }
    }
    draft<Int> = engine_run(clean, ns)
    return http_response(200, "{\"draft_token\": " + draft.to_string() + "}")
}

serve_main()<Int> -> {
    port<Int> = 8090
    ps<String> = env_get("VYBFORGE_SERVE_PORT") else ""
    if (ps.len() > 0) { port = ps.to_int() }
    rc<Int> = engine_init()
    if (rc != 0) { return rc }
    match (http_listen(port, 8)) {
        listener -> {
        println("glm_serve listening on " + port.to_string())
        while (1) {
        match (http_accept(listener)) {
            conn -> {
                head<String> = http_read_head(conn.fd, 65536)
                pth<String> = http_request_path(head)
                # the body: after CRLFCRLF; the engine_run is deterministic and
                # the caches are per-call, so serial handling is correct v1.
                resp<String> = ""
                # the query: everything after "?" in the path
                qp<Int> = pth.index_of("?")
                q<String> = ""
                route<String> = pth
                if (qp >= 0) {
                    route = pth.substring(0, qp)
                    q = pth.substring(qp + 1, pth.len())
                }
                if (route == "/v1/generate") {
                    resp = handle_generate(q)
                } else {
                    resp = http_response(404, "{\"error\": \"not found\"}")
                }
                http_send_all(conn.fd, resp)
                http_close(conn.fd)
            }
            ? -> { println("SERVE accept failed"); return 7 }
        }
        }
        }
        ? -> { println("SERVE_FAIL listen"); return 6 }
    }
    return 0
}

main()<Int> -> {
    m<String> = env_get("VYBFORGE_SERVE") else ""
    if (m.len() == 0) {
        # the default: the engine self-test — the gold prompt through
        # engine_run (the gated chain's engine, imported): the returned draft
        # must be 10788 (the f64 gold's next token, DECODE_CHAIN_MATCH's
        # functional check).
        println("SERVE_SMOKE: running the engine self-test")
        draft<Int> = engine_run("785,6722,315,9621,374,12089,11,323,279,7772,3283,304,9851,374,19808,11,892,572,17753,369,10788,13", 2)
        println("SERVE_SMOKE draft=" + draft.to_string() + " (want 10788)")
        if (draft == 10788) { println("SERVE_SMOKE_OK"); return 0 }
        return 5
    }
    return serve_main()
}
