# glm_serve.vyb — the GLM-5.3 serving engine + OpenAI-compatible endpoint.
#
# ARCHITECTURE (doc/SERVING-ENDPOINT-SCOPING.md):
#   - The ENGINE (this file's deterministic core): the packed weights, the
#     on-demand deq, the hybrid caches (34 KDA fixed states + 11+1 DSA token
#     caches), the prefill + the decode step loop. NO request I/O here.
#   - The SERVER (serve_main, bottom): the stdlib http listener, the request
#     parse, the slot allocation, the SSE streaming of the generated tokens.
#   - CORRECTNESS: this program reuses the SAME verified module functions the
#     gated glm_decode_chain.vyb uses (kda_attn_site / dsa_attn_site_c /
#     moe_tail_step / exl3_deq32 / the had_hoist prebuilt buffers). The chain
#     gate (DECODE_CHAIN_MATCH: OK) stays the regression oracle: any change to
#     the shared functions re-runs it. This file's own outputs are verified the
#     same way (its streams vs the prefill reference through
#     verify_decode_chain.py's per-layer metric).
#
# STATUS: scaffold — the architecture and the I/O shape are fixed; the weights
# load, the phase-1 prefill body, and the decode step body port from
# glm_decode_chain.vyb's proven sections in the next pass (mechanical, the
# sections are marked PORT: below).

import http::{http_listen, http_accept, http_read_head, http_request_path, http_send_all, http_close, http_response}
import io::{open_read, read_all, read_at, open_write, open_append, write_str, close}
import env::{env_get}
import safetensors
import gx
import collections::{HashMap}
import tensor::{tensor_init, module_load_path, module_func, dev_alloc, bulk_htod, bulk_dtoh, sync, gemm}
import vmath::{vexp, vsqrt}
import time::{time_mono_millis}
import json_parse
import deq_cache::{cache_save, cache_load, deq_cache_dir}
import glm_engine
import cuda_binding::{cuMemFree_v2, cuMemAlloc_v2, cuMemcpyHtoD_v2, cuMemcpyDtoH_v2, cuCtxSynchronize, cuModuleLoadData, cuModuleGetFunction}


# ---- the config constants come from the glm_engine module exports ----

# ---- the engine state (module-scope; the caches + the weights live here) ----
# PORT: the packed-weight handles, the KDA state/ring buffers, the DSA caches,
# the hoisted Hadamard buffers (had_hoist/had_hoist32 + mapdev/invbase), and
# the deq arena move here from the chain's setup section — the definitions are
# copied verbatim, the module scope replaces main's locals.
# ---- the engine API ----

# ---- the server ----

# POST /v1/generate  {"prompt_ids": [785, ...], "nsteps": 2}
#   -> {"draft_token": 10788}
# The ids-based v1 API: the GLM BPE tokenizer port is its own phase (the
# tokenizer is a big deterministic program in its own right); until then the
# clients send the token ids (the gold ids round-trip is the smoke test).


sv_H<Int> = 4096
sv_HEADS<Int> = 64
sv_NOPE<Int> = 256
sv_VDIM<Int> = 256
sv_KV_LORA<Int> = 512
sv_Q_LORA<Int> = 1536
sv_IHEADS<Int> = 32
sv_KD<Int> = 128
sv_EINTER<Int> = 2048
sv_NE<Int> = 288
sv_ROUTE_TOPK<Int> = 8
sv_INTER<Int> = 12288
sv_NSLOT<Int> = 34
sv_NDSLOT<Int> = 11
sv_NLAY<Int> = 45
sv_CONV_K<Int> = 4
sv_CAPT<Int> = 22
sv_MAXCTX<Int> = 32768
sv_IDIM<Int> = 128
sv_R<Int> = 20
sv_HC<Int> = 4
sv_KPOOL<Int> = 4
sv_SWIGLU_LIMIT<Float> = 10.0
sv_ROUTED_SCALE<Float> = 2.5
sv_TOPK<Int> = 2048

# find the first occurrence of needle at/after start, or -1 (the two-arg
# index_of does not exist; this is the cache loader's scanner).
find_from(s<String>, needle<String>, start<Int>)<Int> -> {
    n<Int> = s.len()
    m<Int> = needle.len()
    i<Int> = start
    while (i <= n - m) {
        ok<Bool> = true
        j<Int> = 0
        while (ok && j < m) {
            if (s.char_at(i + j) != needle.char_at(j)) { ok = false }
            j = j + 1
        }
        if (ok) { return i }
        i = i + 1
    }
    return -1
}

main()<Int> -> {
    setupT<Int> = 0
    secP<Int> = 0
    # the per-layer d-dumps are offline-verification artifacts; in serve mode
    # they cost ~12s/step-layer (the format+concat churn on real data) with no
    # product value — VYBFORGE_SERVE_DUMP=0 skips them (the gate keeps its
    # dumps: the flag defaults to on).
    dump_on<Int> = 1
    dsFlag = env_get("VYBFORGE_SERVE_DUMP") else ""
    srv = env_get("VYBFORGE_SERVE") else ""
    if (srv == "1" && dsFlag != "1") { dump_on = 0 }
    secT<Int> = 0
    # the engine state lives as MAIN-LOCAL Vecs: module-scope Vec member
    # calls hit the codegen gap (probe10a: .push silently no-ops) — the
    # state-in-main architecture, all caches on main's own storage.
    stAll<Vec<Float>> = Vec()
    ringQ<Vec<Float>> = Vec()
    ringK<Vec<Float>> = Vec()
    ringV<Vec<Float>> = Vec()
    ckvAll<Vec<Float>> = Vec()
    ikAll<Vec<Float>> = Vec()
    gscAll<Vec<Float>> = Vec()

    # the local shadows for the engine's module-global Vec state: the module
    # Vec globals hit the codegen type gap (the member calls on them cannot be
    # typed) — the locals shadow them and the whole body runs on main's own
    # storage.
    # the local shim: the engine's constants/externs are not visible inside
    # main's nested scopes (the imported-symbol visibility gap) — the values
    # duplicated from glm_engine.vyb until the compiler fix lands.
    port<Int> = 8091
    ps<String> = env_get("VYBFORGE_SERVE_PORT") else ""
    if (ps.len() > 0) { port = ps.to_int() }
    dir = env_get("VYBFORGE_GX_DIR") else "/mnt/apex/rick/vybforge/glm53-checkpoint"
    out = env_get("VYBFORGE_CHAIN_OUT") else "native/out/decchain_vyb.txt"
    total = 83
    println("SETUP S0walk " + (now_ms() - setupT).to_string())
    setupT = now_ms()
    # ---- one-time shard walk: bucket every tensor record by layer (the tab) ----
    # record = name SP shard SP data_offset SP nbytes SP dtype NEWLINE; runtime never parses JSON.
    # The walk costs ~83 s (83 x st_open); cache the buckets to a file and reload
    # (the stamp embeds the checkpoint dir; delete the cache or point
    # VYBFORGE_TAB_CACHE elsewhere to force a re-walk).
    tabs<Vec<String>> = Vec()
    tnb<String> = ""
    tnb2<String> = ""
    tln<Int> = 0
    tln2<Int> = 0
    while (tln < 45) { tabs.push(""); tln = tln + 1 }
    cache_path<String> = env_get("VYBFORGE_TAB_CACHE") else "native/out/gx_tabs.cache"
    cache_sig<String> = "GXTAB1 " + dir
    loaded<Int> = 0
    match (open_read(cache_path)) {
        f -> {
            match (read_all(f)) { cs -> {
                if (find_from(cs, cache_sig, 0) == 0) {
                    nl0<Int> = find_from(cs, "\n", 0)
                    if (nl0 > 0) {
                        # parse into a temp list: the failed load must not pollute
                        # the real tabs (the walk would append onto stale payloads)
                        ttmp<Vec<String>> = Vec()
                        ti<Int> = 0
                        while (ti < 45) { ttmp.push(""); ti = ti + 1 }
                        pos<Int> = nl0 + 1
                        ti = 0
                        ok<Int> = 1
                        while (ti < 45 && ok == 1) {
                            nl<Int> = find_from(cs, "\n", pos)
                            if (nl < 0) { ok = 0 }
                            if (ok == 1) {
                                plen<Int> = cs.substring(pos, nl).to_int()
                                if (plen <= 0 || nl + 1 + plen > cs.len()) { ok = 0 }
                                if (ok == 1) {
                                    ttmp.set(ti, cs.substring(nl + 1, nl + 1 + plen))
                                    pos = nl + 1 + plen
                                }
                            }
                            ti = ti + 1
                        }
                        if (ok == 1 && pos == cs.len()) {
                            ti = 0
                            while (ti < 45) { tabs.set(ti, ttmp.get(ti)); ti = ti + 1 }
                            loaded = 1
                            println("SETUP S0cache hit")
                        }
                    }
                }
            } ? -> { } }
            close(f)
        }
        ? -> { }
    }
    tsh<Int> = 1
    while (loaded == 0 && tsh < 84) {
        tkix<StIndex> = st_open(gx_shard_path(dir, tsh, 83))
        if (tkix.n > 0) {
            tk<Int> = 0
            while (tk < tkix.n) {
                tnm<String> = tkix.names.get(tk)
                tlnum<Int> = 0
                tlp<Int> = tnm.index_of("layers.")
                if (tlp >= 0) {
                    td0<Int> = tlp + 7
                    while (td0 < tnm.len()) {
                        tcnum<Int> = (tnm.char_at(td0) as Int) & 255
                        if (tcnum < 48 || tcnum > 57) { break }
                        tlnum = tlnum * 10 + (tcnum - 48)
                        td0 = td0 + 1
                    }
                }
                if (tlnum > 44) { tlnum = 44 }
                trec<String> = tnm + " " + tsh.to_string() + " " +
                        (tkix.data_base + tkix.doff.get(tk)).to_string() + " " +
                        tkix.dlen.get(tk).to_string() + " " + tkix.dtypes.get(tk) + "\n"
                if (tlp >= 0) {
                    tnb = tabs.get(tlnum) + trec
                    tabs.set(tlnum, tnb)
                } else {
                    tln2 = 0
                    while (tln2 < 45) {
                        tnb2 = tabs.get(tln2) + trec
                        tabs.set(tln2, tnb2)
                        tln2 = tln2 + 1
                    }
                }
                tk = tk + 1
            }
        }
        tsh = tsh + 1
    }
    if (loaded == 0) {
        # per-tab writes: a single 13 MB write_str drops a byte at the chunk
        # boundary (the cache came back shifted); 45 small writes are exact.
        match (open_write(cache_path)) {
            f -> {
                write_str(f, cache_sig + "\n")
                ti<Int> = 0
                while (ti < 45) {
                    tp<String> = tabs.get(ti)
                    write_str(f, tp.len().to_string() + "\n")
                    write_str(f, tp)
                    ti = ti + 1
                }
                close(f)
            }
            ? -> { }
        }
        println("SETUP S0cache saved")
    }
    lines = ""
    mapbody = ""
    idxtext = ""
    i = 0
    j = 0
    k = 0
    r = 0
    hh = 0
    d2 = 0
    c = 0
    a = 0
    p = 0
    e = 0
    lane = 0
    nfound = 0
    nf = 0
    mx = 0.0
    sm = 0.0
    acc = 0.0
    pr = 0.0
    dot = 0.0
    rl = 0.0
    sc = 0.0
    sv = 0.0
    scale_iq = 0.0
    sc_scale = 0.0
    wscale = 0.0
    best = 0
    bestv = 0.0
    bestp = 0
    last = 0
    used = 0
    tstart = 0
    slot = 0
    tv<Int> = 0
    g1 = 0.0
    u1 = 0.0
    wt = 0.0
    cv = 0.0
    i0 = 0
    nt = 0
    tk<Int> = 0
    n = 0
    npools = 0
    select_k = 0
    vcount = 0
    tcount = 0
    nex = 0
    t = 0
    tid = 0
    nlay = 45
    is_dsa = 0
    println("SETUP S1tab " + (now_ms() - setupT).to_string())
    setupT = now_ms()
    lpre = ""
    tab = ""
    g_g_0<String> = ""
    g_ge_0<String> = ""
    g_ge_1<String> = ""
    g_ge_2<String> = ""
    g_ge_3<String> = ""
    g_ge_4<String> = ""
    g_ge_5<String> = ""
    g_ge_6<String> = ""
    g_ge_7<String> = ""
    g_ge_8<String> = ""
    g_gexp_0 = ""
    g_gexp_1 = ""
    g_gexp_2 = ""
    g_gexp_3 = ""
    g_gexp_4 = ""
    g_gexp_5 = ""
    g_gexp_6 = ""
    g_gexp_7 = ""
    g_gexp_8 = ""
    g_gm_0<String> = ""
    g_gm_1<String> = ""
    g_gm_2<String> = ""
    g_gm_3<String> = ""
    g_gs_0<String> = ""
    g_gs_1<String> = ""
    g_gs_2<String> = ""
    g_gt_13<String> = ""
    g_gt_17<String> = ""
    g_gt_18<String> = ""
    g_gt_19<String> = ""
    g_lg_0 = ""
    g_lg_1 = ""
    g_lg_10 = ""
    g_lg_11 = ""
    g_lg_12 = ""
    g_lg_13 = ""
    g_lg_14 = ""
    g_lg_15 = ""
    g_lg_16 = ""
    g_lg_17 = ""
    g_lg_18 = ""
    g_lg_19 = ""
    g_lg_2 = ""
    g_lg_20 = ""
    g_lg_21 = ""
    g_lg_22 = ""
    g_lg_23 = ""
    g_lg_24 = ""
    g_lg_25 = ""
    g_lg_26 = ""
    g_lg_3 = ""
    g_lg_4 = ""
    g_lg_5 = ""
    g_lg_6 = ""
    g_lg_7 = ""
    g_lg_8 = ""
    g_lg_9 = ""
    g_lmg_0 = ""
    lpre45 = "model.language_model.layers.45."
    mdw<Vec<Int>> = Vec()
    tab = tabs.get(44)
    tvec<Vec<Float>> = Vec()
    hin<Vec<Float>> = Vec()
    x2<Vec<Float>> = Vec()
    raw_e = ""
    mrow = 0
    mckv<Vec<Float>> = Vec()
    mik<Vec<Float>> = Vec()
    migsc<Vec<Float>> = Vec()
    logv<Vec<Float>> = Vec()
    sv_shn_w<Vec<Float>> = Vec()
    sv_baseF<Vec<Float>> = Vec()
    sv_scaleF<Vec<Float>> = Vec()
    finv<Vec<Float>> = Vec()
    chunk<Vec<Float>> = Vec()
    lmraw = ""
    lmpath = ""
    lmoff = 0
    crows = 8192
    cbase = 0
    cn = 0
    cbestv = 0.0
    cbesti = 0
    lmg = GxLoc { found = Vec(), shard = Vec(), tix = Vec(), off = Vec(), nbytes = Vec(),
                        dts = Vec(), paths = Vec() }
    kslot = 0
    dslot = 0
    nckv = 0
    d_q = 0
    d_k = 0
    d_v = 0
    d_o = 0
    d_b = 0
    d_fa = 0
    d_fb = 0
    d_ga = 0
    d_gb = 0
    d_ln = 0
    d_ln2 = 0
    d_cq = 0
    d_ck = 0
    d_cv = 0
    d_onorm = 0
    d_fnA = 0
    d_fnF = 0
    d_gate = 0
    d_up = 0
    d_down = 0
    d_qa = 0
    d_qb = 0
    d_kva = 0
    d_kvb = 0
    d_wqb = 0
    d_wk = 0
    d_wproj = 0
    d_gatei = 0
    d_gw = 0
    d_sg = 0
    d_su = 0
    d_sd = 0
    d_qaln = 0
    d_kvaln = 0
    d_knw = 0
    d_knb = 0
    d_ukm = 0
    d_uvm = 0
    d_flat = 0
    d_mv = 0
    d_scr = 0
    d_flat2 = 0
    d_mv2 = 0
    d_scr2 = 0
    d_x = 0
    lg = GxLoc { found = Vec(), shard = Vec(), tix = Vec(), off = Vec(), nbytes = Vec(),
                        dts = Vec(), paths = Vec() }
    streams1<Vec<Float>> = Vec()
    streams2<Vec<Float>> = Vec()
    attn<Vec<Float>> = Vec()
    mlp<Vec<Float>> = Vec()

    if (tensor_init() != 0) { println("CHAIN_FAIL no cuda"); return 3 }
    fgemm = load_fn("native/build/gemm.ptx", "gemm")
    fbf = load_fn("native/build/bf16.ptx", "bf16deq")
    fdeq = load_fn("native/build/exl3.ptx", "exl3deq")
    fhgen = load_fn("native/build/exl3.ptx", "exl3hgen")
    fhad1 = load_fn("native/build/exl3.ptx", "exl3had1")
    fhad2 = load_fn("native/build/exl3.ptx", "exl3had2")
    fdeq32 = load_fn("native/build/exl3.ptx", "exl3deq32")
    fhgen32<Int> = load_fn("native/build/exl3.ptx", "exl3hgen32")
    fhad132 = load_fn("native/build/exl3.ptx", "exl3had132")
    fhad232 = load_fn("native/build/exl3.ptx", "exl3had232")
    fcvt32 = load_fn("native/build/exl3.ptx", "exl3cvt32")
    fdqs = load_fn("native/build/exl3dq.ptx", "exl3dq1s")
    finvk<Int> = load_fn("native/build/exl3.ptx", "exl3inv")
    if (fdqs == 0 || finvk == 0 || fdeq32 == 0 || fhgen32 == 0 || fhad132 == 0 || fhad232 == 0 || fcvt32 == 0) {
        println("CHAIN_FAIL kernels32")
        return 4
    }
    if (fgemm == 0 || fbf == 0 || fdeq == 0 || fhgen == 0 || fhad1 == 0 || fhad2 == 0) {
        println("CHAIN_FAIL kernels")
        return 4
    }
    mdw = mtp_stage_deqs(lpre45, tab, dir, total, fbf)
    if (mdw.len() != 19) { println("CHAIN_FAIL mtp stage"); return 39 }
    println("SETUP S3stage " + mdw.len().to_string())
    mapd = ""
    match (open_read("native/exl3/map.bin")) {
        f -> { match (read_all(f)) { s -> { mapd = s } ? -> { return 5 } } close(f) }
        ? -> { println("CHAIN_FAIL no map.bin"); return 5 }
    }
    mapbody = mapd.substring(16, mapd.len())
    println("SETUP S2arena " + (now_ms() - setupT).to_string())
    setupT = now_ms()
    # ---- f32 deq setup: constant-sv_H hoists, persistent map+inv, the deq arena ----
    hdg = had_hoist(fhgen)
    if (hdg == 0) { println("CHAIN_FAIL had_hoist"); return 6 }
    hdg32 = had_hoist32(fhgen32)
    if (hdg32 == 0) { println("CHAIN_FAIL had_hoist32"); return 6 }
    mapdev = 0
    freedom {
        mrc0<Int> = cuMemAlloc_v2(loc(mapdev), 8192) as Int
        if (mrc0 != 0) { println("CHAIN_FAIL mapdev"); }
    }
    arA = 0
    arB = 0
    arC = 0
    arD = 0
    arE<Int> = 0
    arF<Int> = 0
    arG = 0
    arH = 0
    arI = 0
    freedom {
        b1<Int> = cuMemAlloc_v2(loc(arA), 8388608) as Int
        b2<Int> = cuMemAlloc_v2(loc(arB), 65536) as Int
        b3<Int> = cuMemAlloc_v2(loc(arC), 33554432) as Int
        b4<Int> = cuMemAlloc_v2(loc(arD), 33554432) as Int
        b5<Int> = cuMemAlloc_v2(loc(arG), 16384) as Int
        b6<Int> = cuMemAlloc_v2(loc(arH), 16384) as Int
        b7<Int> = cuMemAlloc_v2(loc(arI), 64) as Int
        if (b1 + b2 + b3 + b4 + b5 + b6 + b7 != 0) { println("CHAIN_FAIL arena") }
    }
    nbmap<Int> = mapd.len() - 16
    hp<Int> = 0
    freedom {
        cuMemcpyHtoD_v2(mapdev, mapd, mapd.len())
        hrc3<Int> = cuMemAlloc_v2(loc(hp), 64) as Int
        if (hrc3 == 0) {
            cuMemcpyHtoD_v2(hp + 0, loc(mapdev), 8)
            cuMemcpyHtoD_v2(hp + 8, loc(nbmap), 8)
            lrcI<Int> = cuda_launch4i(from<loc<CVoid>>(finvk), 1, 1, 1, 256, 1, 1, hp, 0, 0, 0) as Int
            srI<Int> = cuCtxSynchronize() as Int
            if (lrcI != 0 || srI != 0) { println("CHAIN_FAIL invbuild") }
            cuMemFree_v2(hp)
        }
    }
    println("SETUP S3listen " + (now_ms() - setupT).to_string())
    setupT = now_ms()
    invbase = mapdev + 16 + nbmap
    idxtext = gx_read_index(dir)

    # ---- the http endpoint: the setup is done; serve the decode requests ----
    println("SETUP S3listen " + (now_ms() - setupT).to_string())
    setupT = now_ms()
    match (http_listen(port, 8)) {
        listener -> {
        println("glm_serve listening on " + port.to_string())
        while (1) {
            match (http_accept(listener)) {
                conn -> {
                head<String> = http_read_head(conn.fd, 65536)
                pth<String> = http_request_path(head)
                qp<Int> = pth.index_of("?")
                q<String> = ""
                route<String> = pth
                if (qp >= 0) {
                    route = pth.substring(0, qp)
                    q = pth.substring(qp + 1, pth.len())
                }
                resp<String> = ""
                if (route == "/v1/generate") {
                    # ---------------------------------------------------------------- prompt ids
                    # the prefill's default id list (22 tokens); phase 1 prefills ids[0..19], the two
                    # decode steps re-walk ids[20] and ids[21] teacher-forced.
                    ids<Vec<Int>> = Vec()
                    k<Int> = q.index_of("ids=")
    q_ids<String> = ""
    if (k >= 0) {
        amp<Int> = q.substring(k, q.len()).index_of("&")
        endq<Int> = q.len()
        if (amp > 0) { endq = k + amp }
        q_ids = q.substring(k + 4, endq)
    }
    ns<Int> = 2
    nk<Int> = q.index_of("nsteps=")
    if (nk >= 0) {
        d<String> = ""
        j<Int> = nk + 7
        while (j < q.len()) {
            ch<String> = q.substring(j, j + 1)
            if (ch >= "0" && ch <= "9") { d = d + ch }
            else { if (d.len() > 0) { j = q.len() } }
            j = j + 1
        }
        if (d.len() > 0) { ns = d.to_int() }
    }
    idtxt<String> = q_ids
                    cur<String> = ""
                    i = 0
                    while (i <= idtxt.len()) {
                        if (i == idtxt.len()) {
                            if (cur.len() > 0) { ids.push(cur.to_int()) }
                        } else {
                            ch<String> = idtxt.substring(i, i + 1)
                            if (ch == ",") {
                                if (cur.len() > 0) { ids.push(cur.to_int()) }
                                cur = ""
                            } else { cur = cur + ch }
                        }
                        i = i + 1
                    }
                    if (ids.len() < 4) { println("CHAIN_FAIL ids " + ids.len().to_string()); return 8 }
                    nl2<String> = env_get("VYBFORGE_NLAYERS") else ""
                    if (nl2.len() > 0) { nlay = nl2.to_int() }
                    nsteps<Int> = ns
                    if (nsteps <= 0) {
                        ns<String> = env_get("VYBFORGE_NSTEPS") else ""
                        nsteps = 2
                        if (ns.len() > 0) { nsteps = ns.to_int() }
                    }

                    # carried state, flat per layer slot:
                    #   KDA (34 slots): recurrence [64,128,128] + conv rings [3,8192] per tensor q/k/v
                    #   DSA (11 slots): ckv [sv_CAPT,512], indexer k [sv_CAPT,128], gsc [sv_CAPT,128]
                    stAll<Vec<Float>> = Vec()
                    ringQ<Vec<Float>> = Vec()
                    ringK<Vec<Float>> = Vec()
                    ringV<Vec<Float>> = Vec()
                    ckvAll<Vec<Float>> = Vec()
                    ikAll<Vec<Float>> = Vec()
                    gscAll<Vec<Float>> = Vec()
                    i = 0
                    while (i < sv_NSLOT * sv_HEADS * sv_KD * sv_KD) { stAll.push(0.0); i = i + 1 }
                    i = 0
                    while (i < sv_NSLOT * (sv_CONV_K - 1) * sv_HEADS * sv_KD) { ringQ.push(0.0); ringK.push(0.0); ringV.push(0.0); i = i + 1 }
                    i = 0
                    while (i < sv_NDSLOT * sv_CAPT * sv_KV_LORA) { ckvAll.push(0.0); i = i + 1 }
                    i = 0
                    while (i < sv_NDSLOT * sv_CAPT * sv_IDIM) { ikAll.push(0.0); gscAll.push(0.0); i = i + 1 }
                    # MTP head (layer 45) own DSA cache: rows for the 20 prefill tokens + 2 decode steps
                    i = 0
                    while (i < sv_CAPT * sv_KV_LORA) { mckv.push(0.0); i = i + 1 }
                    i = 0
                    while (i < sv_CAPT * sv_IDIM) { mik.push(0.0); migsc.push(0.0); i = i + 1 }

                    # ================================================================ phase 1: prefill sv_R = 20
                    # embeddings for ids[0..19] -> streams (sv_HC copies), verbatim from glm_prefill.vyb
                    want0<Vec<String>> = Vec()
                    want0.push("model.language_model.embed_tokens.weight")
                    tab = tabs.get(0)
                    ge0<GxLoc> = gx_resolve_tab(tab, dir, total, want0)
                    emb_off<Int> = ge0.off.get(0)
                    emb_path<String> = ge0.paths.get(0)
                    raw_emb1<String> = ""
                    r = 0
                    while (r < sv_R) {
                        match (open_read(emb_path)) {
                            f -> {
                                match (read_at(f, emb_off + ids.get(r) * sv_H * 2, sv_H * 2)) {
                                    s -> { raw_emb1 = raw_emb1 + s }
                                    ? -> { return 9 }
                                }
                                close(f)
                            }
                            ? -> { return 9 }
                        }
                        r = r + 1
                    }
                    d_x = deq_bf16(fbf, raw_emb1, sv_R * sv_H, 0)
                    if (d_x == 0) { println("CHAIN_FAIL emb deq"); return 10 }
                    x<Vec<Float>> = bulk_dtoh(d_x, sv_R * sv_H)
                    free_dev(d_x)
                    println(digest("x", x))
                    lines = lines + digest("x", x) + "\n"
                    streams<Vec<Float>> = Vec()
                    r = 0
                    while (r < sv_R) {
                        hh = 0
                        while (hh < sv_HC) {
                            d2 = 0
                            while (d2 < sv_H) {
                                streams.push(x.get(r * sv_H + d2))
                                d2 = d2 + 1
                            }
                            hh = hh + 1
                        }
                        r = r + 1
                    }

                    println("CHAIN phase 1: prefill " + sv_R.to_string() + " tokens, 45 layers")
                    n = 0
                    while (n < nlay) {
                        lpre = "model.language_model.layers." + n.to_string() + "."
                    tab = tabs.get(n)
                        is_dsa = 0
                        if ((n % 4) == 3) { is_dsa = 1 }
                        secP = now_ms()
                        if (is_dsa == 1) {
                            dslot = (n - 3) / 4
                            streams1 = dsa_attn_site_c(streams, tab, dir, total, lpre, fgemm, fbf, fdeq, fhgen, fhad1, fhad2, mapbody, borrow(ckvAll), borrow(ikAll), borrow(gscAll), dslot)
                        } else {
                            kslot = n - ((n + 1) / 4)
                            streams1 = kda_attn_site_c(borrow(streams), tab, dir, total, lpre, fgemm, fbf, borrow(stAll), kslot, borrow(ringQ), borrow(ringK), borrow(ringV))
                        }
                        if (streams1.len() != sv_R * sv_HC * sv_H) {
                            println("CHAIN_FAIL attention layer " + n.to_string())
                            return 30
                        }
                        println("SEC P1attn " + (now_ms() - secP).to_string())
                        secP = now_ms()
                        if (n < 3) {
                            streams2 = ffn_dense_site(streams1, tab, dir, total, lpre, fgemm, fbf)
                        } else {
                            streams2 = tail_site(streams1, tab, lpre, fgemm, fbf, fdeq, fhgen, fhad1, fhad2, mapbody, hdg, fdeq32, fdqs, fhad132, fhad232, fcvt32, hdg32, arA, arB, arC, arD, arG, arH, arI, mapdev, invbase)
                        }
                        if (streams2.len() != sv_R * sv_HC * sv_H) {
                            println("CHAIN_FAIL ffn layer " + n.to_string())
                            return 31
                        }
                        println("SEC P1ffn " + (now_ms() - secP).to_string())
                        secP = now_ms()
                        streams = streams2
                        i = trim_heap()
                        ckvs<Vec<Float>> = Vec()
                        i = 0
                        while (i < 512) { ckvs.push(ckvAll.get(i)); i = i + 1 }
                        lines = lines + dumps("p1ck" + n.to_string(), ckvs) + "\n"
                        println("phase1 layer " + n.to_string() + " done")
                        println("SEC P1tail " + (now_ms() - secP).to_string())
                        println("RSS n=" + n.to_string() + " " + rss_mb().to_string() + "MB")
                        lines = lines + "phase1 layer " + n.to_string() + " " + digest("streams", streams) + "\n"
                        n = n + 1
                    }

                    # ================================================================ phase 1b: MTP head
                    # prime layer 45's own cache over the prompt: for each prefill token, the trunk
                    # state is the mean over its 4 layer-44 streams -> trunk final norm -> hnorm, and
                    # e = enorm(embed(token)); the per-row MTP input + post-layer hidden are dumped
                    # full precision for the gold oracle (gate A / gate B inputs).
                    if (nlay == 45) {
                    secT = now_ms()
                        println("CHAIN phase 1b: MTP head over " + sv_R.to_string() + " prompt tokens")
                        # fresh index/map strings: phase 1's 45 layers of String churn corrupt a buffer
                        # held across it (the phase-2 refresh below brackets the same window)
                        match (open_read("native/exl3/map.bin")) {
                            f -> { match (read_all(f)) { s -> { mapd = s } ? -> { return 5 } } close(f) }
                            ? -> { return 5 }
                        }
                        mapbody = mapd.substring(16, mapd.len())
                        idxtext = gx_read_index(dir)
                        r = 0
                        while (r < sv_R) {
                            tvec = vecf()
                            d2 = 0
                            while (d2 < sv_H) {
                                acc = 0.0
                                hh = 0
                                while (hh < sv_HC) {
                                    acc = acc + streams.get(r * sv_HC * sv_H + hh * sv_H + d2)
                                    hh = hh + 1
                                }
                                tvec.push(acc / 4.0)
                                d2 = d2 + 1
                            }
                            lines = lines + dumps("mtptrunk" + r.to_string(), tvec) + "\n"
                            raw_e = ""
                            match (open_read(emb_path)) {
                                f -> {
                                    match (read_at(f, emb_off + ids.get(r) * sv_H * 2, sv_H * 2)) {
                                        s -> { raw_e = s }
                                        ? -> { return 9 }
                                    }
                                    close(f)
                                }
                                ? -> { return 9 }
                            }
                            secT = now_ms()
                            hin = mtp_build_row(tvec, raw_e, tab, dir, total, fgemm, fbf)
                            if (hin.len() != sv_H) { println("CHAIN_FAIL mtp build row " + r.to_string()); return 40 }
                            lines = lines + dumps("mtphin" + r.to_string(), hin) + "\n"
                            println("SEC P1bbuild " + (now_ms() - secT).to_string())
                            secT = now_ms()
                            x2 = mtp_layer_step(hin, r, lpre45, tab, dir, total, mapbody, borrow(mckv), borrow(mik), borrow(migsc), mdw, fgemm, fbf, fdeq, fhgen, fhad1, fhad2, hdg)
                            if (x2.len() != sv_H) { println("CHAIN_FAIL mtp layer row " + r.to_string()); return 41 }
                            # the per-token sync: the token kernels and the next token's
                            # deqs overlap without it (the intermittent sticky
                            # CUDA_ERROR_ILLEGAL_ADDRESS rc=700 at the expert deqs).
                            nsy<Int> = sync() as Int
                            if (nsy != 0) { println("CHAIN_FAIL phase1b sync rc=" + nsy.to_string()); return 42 }
                        # the per-token sync: the staged handles persist across the
                        # tokens and the async kernels overlap without it (the
                        # sticky CUDA_ERROR_ILLEGAL_ADDRESS rc=700 race)
                        rsync<Int> = sync() as Int
                        if (rsync != 0) { println("CHAIN_FAIL phase1b sync " + rsync.to_string()); return 42 }
                            println("SEC P1bstep " + (now_ms() - secT).to_string())
                            lines = lines + dumps("mtpx" + r.to_string(), x2) + "\n"
                            println("mtp row " + r.to_string() + " done")
                            i = trim_heap()
                            r = r + 1
                        }
                    }
                    println("CHAIN phase 1 done: caches built")

                    # ================================================================ phase 2: two decode steps
                    # cache-sniff dumps: full DSA slot-0 rows as phase 1 left them, and again at the
                    # top of each decode step -- brackets any corruption window.
                    p1ckv<Vec<Float>> = Vec()
                    p1ik<Vec<Float>> = Vec()
                    p1gsc<Vec<Float>> = Vec()
                    i = 0
                    while (i < sv_CAPT * sv_KV_LORA) { p1ckv.push(ckvAll.get(i)); p1ik.push(ikAll.get(i)); p1gsc.push(gscAll.get(i)); i = i + 1 }
                    lines = lines + dumps("p1ckvF", p1ckv) + "\n"
                    lines = lines + dumps("p1ikF", p1ik) + "\n"
                    lines = lines + dumps("p1gscF", p1gsc) + "\n"
                    sv_R = 1
                    # the ENGINE's module-global R must follow: the engine's site
                    # fns (hc_apply/moe_tail_step/attn_site_c) read their OWN
                    # module R — leaving it at 20 made every decode-step fn call
                    # index R=20 loops over the R=1 serve intermediates (the
                    # out-of-bounds slow path: zeros + the 20x slowdown).
                    set_engine_R(1)
                    scale_iq = 1.0 / vsqrt(sv_IDIM as Float, 40)
                    sc_scale = 1.0 / vsqrt(sv_NOPE as Float, 40)
                    wscale = 1.0 / vsqrt(sv_IHEADS as Float, 40)

                    t = 0
                    while (t < nsteps) {
                        # Refresh the long-lived index/map strings. Phase 1's 45 layers of String
                        # churn corrupt a buffer held across it (the 12-layer debug run showed every
                        # EXL3 dequant in phase 2 reading the same wrong map: mlp max bit-identical
                        # across layers). Phase 1 re-reads both per layer and is immune; phase 2
                        # re-reads both per step here.
                        match (open_read("native/exl3/map.bin")) {
                            f -> { match (read_all(f)) { s -> { mapd = s } ? -> { return 5 } } close(f) }
                            ? -> { return 5 }
                        }
                        mapbody = mapd.substring(16, mapd.len())
                        idxtext = gx_read_index(dir)
                        tid = ids.get(20 + t)
                        i = 0
                        while (i < sv_CAPT * sv_KV_LORA) { p1ckv.set(i, ckvAll.get(i)); p1ik.set(i, ikAll.get(i)); p1gsc.set(i, gscAll.get(i)); i = i + 1 }
                        lines = lines + dumps("p2ckvF" + t.to_string(), p1ckv) + "\n"
                        lines = lines + dumps("p2ikF" + t.to_string(), p1ik) + "\n"
                        lines = lines + dumps("p2gscF" + t.to_string(), p1gsc) + "\n"
                        raw_emb<String> = ""
                        match (open_read(emb_path)) {
                            f -> {
                                match (read_at(f, emb_off + tid * sv_H * 2, sv_H * 2)) {
                                    s -> { raw_emb = s }
                                    ? -> { return 9 }
                                }
                                close(f)
                            }
                            ? -> { return 9 }
                        }
                        d_x = deq_bf16(fbf, raw_emb, sv_R * sv_H, 0)
                        if (d_x == 0) { println("CHAIN_FAIL emb deq step"); return 10 }
                        x = bulk_dtoh(d_x, sv_R * sv_H)
                        free_dev(d_x)
                        streams = vecf()
                        hh = 0
                        while (hh < sv_HC) {
                            d2 = 0
                            while (d2 < sv_H) {
                                streams.push(x.get(d2))
                                d2 = d2 + 1
                            }
                            hh = hh + 1
                        }

                        n = 0
                        println("SEC P1b " + (now_ms() - secT).to_string())
                        secT = now_ms()
                        while (n < nlay) {
                            secT = now_ms()
                            lpre = "model.language_model.layers." + n.to_string() + "."
                    tab = tabs.get(n)
                            is_dsa = 0
                            if ((n % 4) == 3) { is_dsa = 1 }
                            # resolve this layer's main tensors FRESH, used immediately (the stored
                            # GxLoc paths did not survive the surrounding String churn)
                            wantL<Vec<String>> = Vec()
                            streams1<Vec<Float>> = Vec()
                            # NOTE: streams2 is intentionally NOT re-declared here. Declaring
                            # it shadows the main-level variable, so the layer assignments
                            # below would write the shadow while the MTP block (a sibling
                            # scope) reads the stale main-level phase-1 value — the root
                            # cause of the DECODE_MTP red (the steps built their rows from
                            # the phase-1 trunk state instead of their own layer-44 output).
                            attn<Vec<Float>> = Vec()
                            mlp<Vec<Float>> = Vec()
                            if (is_dsa == 1) {
                                wantL.push(lpre + "hc_attn_fn")
                                wantL.push(lpre + "hc_attn_base")
                                wantL.push(lpre + "hc_attn_scale")
                                wantL.push(lpre + "input_layernorm.weight")
                                wantL.push(lpre + "self_attn.q_a_proj.weight")
                                wantL.push(lpre + "self_attn.q_a_layernorm.weight")
                                wantL.push(lpre + "self_attn.q_b_proj.weight")
                                wantL.push(lpre + "self_attn.kv_a_proj_with_mqa.weight")
                                wantL.push(lpre + "self_attn.kv_a_layernorm.weight")
                                wantL.push(lpre + "self_attn.kv_b_proj.weight")
                                wantL.push(lpre + "self_attn.o_proj.weight")
                                wantL.push(lpre + "self_attn.indexer.wq_b.weight")
                                wantL.push(lpre + "self_attn.indexer.wk.weight")
                                wantL.push(lpre + "self_attn.indexer.k_norm.weight")
                                wantL.push(lpre + "self_attn.indexer.k_norm.bias")
                                wantL.push(lpre + "self_attn.indexer.weights_proj.weight")
                                wantL.push(lpre + "self_attn.indexer.index_kpool_compress_ape")
                                wantL.push(lpre + "self_attn.indexer.index_kpool_compress_gate")
                                wantL.push(lpre + "hc_ffn_fn")
                                wantL.push(lpre + "hc_ffn_base")
                                wantL.push(lpre + "hc_ffn_scale")
                                wantL.push(lpre + "post_attention_layernorm.weight")
                                wantL.push(lpre + "mlp.gate.weight")
                                wantL.push(lpre + "mlp.gate.e_score_correction_bias")
                                wantL.push(lpre + "mlp.shared_experts.gate_proj.weight")
                                wantL.push(lpre + "mlp.shared_experts.up_proj.weight")
                                wantL.push(lpre + "mlp.shared_experts.down_proj.weight")
                            } else {
                                wantL.push(lpre + "self_attn.q_proj.weight")
                                wantL.push(lpre + "self_attn.k_proj.weight")
                                wantL.push(lpre + "self_attn.v_proj.weight")
                                wantL.push(lpre + "self_attn.o_proj.weight")
                                wantL.push(lpre + "self_attn.b_proj.weight")
                                wantL.push(lpre + "self_attn.f_a_proj.weight")
                                wantL.push(lpre + "self_attn.f_b_proj.weight")
                                wantL.push(lpre + "self_attn.g_a_proj.weight")
                                wantL.push(lpre + "self_attn.g_b_proj.weight")
                                wantL.push(lpre + "self_attn.o_norm.weight")
                                wantL.push(lpre + "self_attn.dt_bias")
                                wantL.push(lpre + "self_attn.A_log")
                                if (n < 3) {
                                    wantL.push(lpre + "mlp.gate_proj.weight")
                                    wantL.push(lpre + "mlp.up_proj.weight")
                                    wantL.push(lpre + "mlp.down_proj.weight")
                                    wantL.push(lpre + "input_layernorm.weight")
                                    wantL.push(lpre + "post_attention_layernorm.weight")
                                    wantL.push(lpre + "hc_attn_fn")
                                    wantL.push(lpre + "hc_attn_base")
                                    wantL.push(lpre + "hc_attn_scale")
                                    wantL.push(lpre + "hc_ffn_fn")
                                    wantL.push(lpre + "hc_ffn_base")
                                    wantL.push(lpre + "hc_ffn_scale")
                                    wantL.push("model.language_model.embed_tokens.weight")
                                    wantL.push(lpre + "self_attn.q_conv1d.weight")
                                    wantL.push(lpre + "self_attn.k_conv1d.weight")
                                    wantL.push(lpre + "self_attn.v_conv1d.weight")
                                } else {
                                    wantL.push(lpre + "input_layernorm.weight")
                                    wantL.push(lpre + "post_attention_layernorm.weight")
                                    wantL.push(lpre + "hc_attn_fn")
                                    wantL.push(lpre + "hc_attn_base")
                                    wantL.push(lpre + "hc_attn_scale")
                                    wantL.push(lpre + "hc_ffn_fn")
                                    wantL.push(lpre + "hc_ffn_base")
                                    wantL.push(lpre + "hc_ffn_scale")
                                    wantL.push(lpre + "self_attn.q_conv1d.weight")
                                    wantL.push(lpre + "self_attn.k_conv1d.weight")
                                    wantL.push(lpre + "self_attn.v_conv1d.weight")
                                }
                            }
                            gL2<GxLoc> = gx_resolve_tab(tab, dir, total, wantL)
                            nf = 0
                            i = 0
                            while (i < wantL.len()) {
                                if (gL2.found.get(i) == 1) { nf = nf + 1 }
                                i = i + 1
                            }
                            if (nf != wantL.len()) {
                                println("CHAIN_FAIL resolve layer " + n.to_string() + " step " + t.to_string() + " (" + nf.to_string() + ")")
                                return 12
                            }
                            lg = gL2

                            if (is_dsa == 1) {
                                # ------------------------------------------------ DSA layer step
                                # (glm_decode_l3.vyb's step body; caches ride in ckvAll/ikAll/gscAll)
                                dslot = (n - 3) / 4
                                g_lg_0 = gx_read(lg, 0)
                                d_fnA = deq_bf16(fbf, g_lg_0, 24 * sv_HC * sv_H, sv_HC * sv_H)
                                if (d_fnA == 0) { return 11 }
                                baseA<Vec<Float>> = Vec()
                                g_lg_1 = gx_read(lg, 1)
                                raw_baseA<String> = g_lg_1
                                j = 0
                                while (j < 24) { baseA.push(f32_at(raw_baseA, j)); j = j + 1 }
                                scaleA<Vec<Float>> = Vec()
                                g_lg_2 = gx_read(lg, 2)
                                raw_scaleA<String> = g_lg_2
                                j = 0
                                while (j < 3) { scaleA.push(f32_at(raw_scaleA, j)); j = j + 1 }
                                g_lg_3 = gx_read(lg, 3)
                                d_lnA<Int> = deq_bf16(fbf, g_lg_3, sv_H, 0)
                                if (d_lnA == 0) { return 11 }
                                in_ln<Vec<Float>> = bulk_dtoh(d_lnA, sv_H)
                                free_dev(d_lnA)

                                g_lg_4 = gx_read(lg, 4)
                                d_qa = deq_bf16(fbf, g_lg_4, sv_Q_LORA * sv_H, sv_H)
                                g_lg_6 = gx_read(lg, 6)
                                d_qb = deq_bf16(fbf, g_lg_6, sv_HEADS * sv_NOPE * sv_Q_LORA, sv_Q_LORA)
                                g_lg_7 = gx_read(lg, 7)
                                d_kva = deq_bf16(fbf, g_lg_7, sv_KV_LORA * sv_H, sv_H)
                                g_lg_9 = gx_read(lg, 9)
                                d_kvb = deq_bf16(fbf, g_lg_9, sv_HEADS * (sv_NOPE + sv_VDIM) * sv_KV_LORA, 0)
                                g_lg_10 = gx_read(lg, 10)
                                d_o = deq_bf16(fbf, g_lg_10, sv_HEADS * sv_VDIM * sv_H, sv_HEADS * sv_VDIM)
                                g_lg_11 = gx_read(lg, 11)
                                d_wqb = deq_bf16(fbf, g_lg_11, sv_Q_LORA * sv_IHEADS * sv_IDIM, sv_Q_LORA)
                                g_lg_12 = gx_read(lg, 12)
                                d_wk = deq_bf16(fbf, g_lg_12, sv_H * sv_IDIM, sv_H)
                                g_lg_15 = gx_read(lg, 15)
                                d_wproj = deq_bf16(fbf, g_lg_15, sv_H * sv_IHEADS, sv_H)
                                g_lg_17 = gx_read(lg, 17)
                                d_gatei = deq_bf16(fbf, g_lg_17, sv_H * sv_IDIM, sv_H)
                                g_lg_22 = gx_read(lg, 22)
                                d_gw = deq_bf16(fbf, g_lg_22, sv_NE * sv_H, sv_H)
                                if (d_qa == 0 || d_qb == 0 || d_kva == 0 || d_kvb == 0 || d_o == 0 ||
                                    d_wqb == 0 || d_wk == 0 || d_wproj == 0 || d_gatei == 0 || d_gw == 0) {
                                    println("CHAIN_FAIL weight deq dsa " + n.to_string())
                                    return 13
                                }
                                g_lg_5 = gx_read(lg, 5)
                                d_qaln = deq_bf16(fbf, g_lg_5, sv_Q_LORA, 0)
                                g_lg_8 = gx_read(lg, 8)
                                d_kvaln = deq_bf16(fbf, g_lg_8, sv_KV_LORA, 0)
                                g_lg_13 = gx_read(lg, 13)
                                d_knw = deq_bf16(fbf, g_lg_13, sv_IDIM, 0)
                                g_lg_14 = gx_read(lg, 14)
                                d_knb = deq_bf16(fbf, g_lg_14, sv_IDIM, 0)
                                g_lg_21 = gx_read(lg, 21)
                                d_ln2 = deq_bf16(fbf, g_lg_21, sv_H, 0)
                                if (d_qaln == 0 || d_kvaln == 0 || d_knw == 0 || d_knb == 0 || d_ln2 == 0) { return 13 }
                                qaln_w<Vec<Float>> = bulk_dtoh(d_qaln, sv_Q_LORA)
                                kvaln_w<Vec<Float>> = bulk_dtoh(d_kvaln, sv_KV_LORA)
                                knw<Vec<Float>> = bulk_dtoh(d_knw, sv_IDIM)
                                knb<Vec<Float>> = bulk_dtoh(d_knb, sv_IDIM)
                                post_ln2<Vec<Float>> = bulk_dtoh(d_ln2, sv_H)
                                free_dev(d_qaln)
                                free_dev(d_kvaln)
                                free_dev(d_knw)
                                free_dev(d_knb)
                                free_dev(d_ln2)

                                ape<Vec<Float>> = Vec()
                                g_lg_16 = gx_read(lg, 16)
                                raw_ape<String> = g_lg_16
                                i = 0
                                while (i < sv_KPOOL * sv_IDIM) { ape.push(f32_at(raw_ape, i)); i = i + 1 }

                                sv_baseF = vecf()
                                g_lg_19 = gx_read(lg, 19)
                                raw_baseF<String> = g_lg_19
                                j = 0
                                while (j < 24) { sv_baseF.push(f32_at(raw_baseF, j)); j = j + 1 }
                                sv_scaleF = vecf()
                                g_lg_20 = gx_read(lg, 20)
                                raw_scaleF<String> = g_lg_20
                                j = 0
                                while (j < 3) { sv_scaleF.push(f32_at(raw_scaleF, j)); j = j + 1 }
                                g_lg_18 = gx_read(lg, 18)
                                d_fnF = deq_bf16(fbf, g_lg_18, 24 * sv_HC * sv_H, sv_HC * sv_H)
                                if (d_fnF == 0) { return 11 }

                                g_lg_23 = gx_read(lg, 23)
                                raw_bias<String> = g_lg_23
                                bias<Vec<Float>> = Vec()
                                i = 0
                                while (i < sv_NE) { bias.push(f32_at(raw_bias, i)); i = i + 1 }

                                # absorbed per-head keys/values from kv_b
                                kvb<Vec<Float>> = bulk_dtoh(d_kvb, sv_HEADS * (sv_NOPE + sv_VDIM) * sv_KV_LORA)
                                free_dev(d_kvb)
                                ukm<Vec<Float>> = Vec()
                                uvm<Vec<Float>> = Vec()
                                d2 = 0
                                while (d2 < sv_KV_LORA * sv_HEADS * sv_NOPE) {
                                    ukm.push(0.0)
                                    uvm.push(0.0)
                                    d2 = d2 + 1
                                }
                                hh = 0
                                while (hh < sv_HEADS) {
                                    j = 0
                                    while (j < sv_NOPE) {
                                        d2 = 0
                                        while (d2 < sv_KV_LORA) {
                                            ukm.set(d2 * (sv_HEADS * sv_NOPE) + hh * sv_NOPE + j,
                                                    kvb.get((hh * (sv_NOPE + sv_VDIM) + j) * sv_KV_LORA + d2))
                                            uvm.set(d2 * (sv_HEADS * sv_VDIM) + hh * sv_VDIM + j,
                                                    kvb.get((hh * (sv_NOPE + sv_VDIM) + sv_NOPE + j) * sv_KV_LORA + d2))
                                            d2 = d2 + 1
                                        }
                                        j = j + 1
                                    }
                                    hh = hh + 1
                                }
                                d_ukm = alloc_dev(sv_KV_LORA * sv_HEADS * sv_NOPE * 8)
                                d_uvm = alloc_dev(sv_KV_LORA * sv_HEADS * sv_VDIM * 8)
                                if (d_ukm == 0 || d_uvm == 0) { return 13 }
                                bulk_htod(d_ukm, view(ukm))
                                bulk_htod(d_uvm, view(uvm))

                                # ---- hc_attn mix -> input_layernorm -> h_a
                                flat<Vec<Float>> = rms_rows(borrow(streams), sv_R, sv_HC * sv_H, Vec())
                                d_flat = alloc_dev(sv_R * sv_HC * sv_H * 8)
                                d_mv = alloc_dev(sv_R * 24 * 8)
                                d_scr = alloc_dev(64)
                                if (d_flat == 0 || d_mv == 0 || d_scr == 0) { println("CHAIN_FAIL alloc"); return 14 }
                                bulk_htod(d_flat, view(flat))
                                if (gemm(fgemm, d_scr, d_flat, d_fnA, d_mv, sv_R, 24, sv_HC * sv_H, 1.0, 0.0) != 0) { return 14 }
                                sync()
                                mv<Vec<Float>> = bulk_dtoh(d_mv, sv_R * 24)
                                free_dev(d_flat)
                                free_dev(d_mv)
                                free_dev(d_scr)
                                free_dev(d_fnA)

                                res<Vec<Float>> = hc_glue(mv, baseA, scaleA, streams)
                                collapsed<Vec<Float>> = Vec()
                                i = 0
                                while (i < sv_R * sv_H) { collapsed.push(res.get(i)); i = i + 1 }
                                postA<Vec<Float>> = Vec()
                                i = 0
                                while (i < sv_R * sv_HC) { postA.push(res.get(sv_R * sv_H + i)); i = i + 1 }
                                combA<Vec<Float>> = Vec()
                                i = 0
                                while (i < sv_R * sv_HC * sv_HC) { combA.push(res.get(sv_R * sv_H + sv_R * sv_HC + i)); i = i + 1 }
                                h_a<Vec<Float>> = rms_rows(borrow(collapsed), sv_R, sv_H, in_ln)

                                # ---- latent projections; append the new cache rows
                                qres<Vec<Float>> = mm_host(h_a, sv_R, sv_H, d_qa, sv_Q_LORA, fgemm)
                                qa_ln<Vec<Float>> = rms_rows(borrow(qres), sv_R, sv_Q_LORA, qaln_w)
                                qfull<Vec<Float>> = mm_host(qa_ln, sv_R, sv_Q_LORA, d_qb, sv_HEADS * sv_NOPE, fgemm)
                                ckraw<Vec<Float>> = mm_host(h_a, sv_R, sv_H, d_kva, sv_KV_LORA, fgemm)
                                ckv_new<Vec<Float>> = rms_rows(borrow(ckraw), sv_R, sv_KV_LORA, kvaln_w)
                                nckv = 20 + t                       # rows already in this layer's cache
                                i = 0
                                while (i < sv_R * sv_KV_LORA) {
                                    ckvAll.set(dslot * sv_CAPT * sv_KV_LORA + nckv * sv_KV_LORA + i, ckv_new.get(i))
                                    i = i + 1
                                }
                                qidx<Vec<Float>> = mm_host(qres, sv_R, sv_Q_LORA, d_wqb, sv_IHEADS * sv_IDIM, fgemm)
                                kraw<Vec<Float>> = mm_host(h_a, sv_R, sv_H, d_wk, sv_IDIM, fgemm)
                                k_new<Vec<Float>> = ln_rows(borrow(kraw), sv_R, sv_IDIM, knw, knb)
                                i = 0
                                while (i < sv_R * sv_IDIM) {
                                    ikAll.set(dslot * sv_CAPT * sv_IDIM + nckv * sv_IDIM + i, k_new.get(i))
                                    i = i + 1
                                }
                                gsc_new<Vec<Float>> = mm_host(h_a, sv_R, sv_H, d_gatei, sv_IDIM, fgemm)
                                i = 0
                                while (i < sv_R * sv_IDIM) {
                                    gscAll.set(dslot * sv_CAPT * sv_IDIM + nckv * sv_IDIM + i, gsc_new.get(i))
                                    i = i + 1
                                }
                                wproj<Vec<Float>> = mm_host(h_a, sv_R, sv_H, d_wproj, sv_IHEADS, fgemm)
                                i = 0
                                while (i < wproj.len()) {
                                    wproj.set(i, wproj.get(i) * wscale)
                                    i = i + 1
                                }

                                # ---- indexer: pool + topk over the cache with causal visibility
                                nckv = nckv + 1                     # the cache now holds nckv rows
                                # copy this slot's cache rows into locals sized [nckv, ...]
                                ckv_t<Vec<Float>> = Vec()
                                ik_t<Vec<Float>> = Vec()
                                gsc_t<Vec<Float>> = Vec()
                                i = 0
                                while (i < nckv * sv_KV_LORA) {
                                    ckv_t.push(ckvAll.get(dslot * sv_CAPT * sv_KV_LORA + i))
                                    i = i + 1
                                }
                                i = 0
                                while (i < nckv * sv_IDIM) {
                                    ik_t.push(ikAll.get(dslot * sv_CAPT * sv_IDIM + i))
                                    gsc_t.push(gscAll.get(dslot * sv_CAPT * sv_IDIM + i))
                                    i = i + 1
                                }
                                lines = lines + dumps("d" + t.to_string() + "l" + n.to_string() + "ckv", ckv_t) + "\n"
                                lines = lines + dumps("d" + t.to_string() + "l" + n.to_string() + "ik", ik_t) + "\n"
                                lines = lines + dumps("d" + t.to_string() + "l" + n.to_string() + "gsc", gsc_t) + "\n"
                                npools = nckv / sv_KPOOL
                                poolk<Vec<Float>> = Vec()
                                d2 = 0
                                while (d2 < npools * sv_IDIM) { poolk.push(0.0); d2 = d2 + 1 }
                                p = 0
                                while (p < npools) {
                                    c = 0
                                    while (c < sv_IDIM) {
                                        mx = 0.0 - 1e30
                                        a = 0
                                        while (a < sv_KPOOL) {
                                            lgf<Float> = gsc_t.get((p * sv_KPOOL + a) * sv_IDIM + c) + ape.get(a * sv_IDIM + c)
                                            if (lgf > mx) { mx = lgf }
                                            a = a + 1
                                        }
                                        sm = 0.0
                                        a = 0
                                        while (a < sv_KPOOL) {
                                            sm = sm + vexp(gsc_t.get((p * sv_KPOOL + a) * sv_IDIM + c) + ape.get(a * sv_IDIM + c) - mx)
                                            a = a + 1
                                        }
                                        acc = 0.0
                                        a = 0
                                        while (a < sv_KPOOL) {
                                            pr = vexp(gsc_t.get((p * sv_KPOOL + a) * sv_IDIM + c) + ape.get(a * sv_IDIM + c) - mx) / sm
                                            acc = acc + pr * ik_t.get((p * sv_KPOOL + a) * sv_IDIM + c)
                                            a = a + 1
                                        }
                                        poolk.set(p * sv_IDIM + c, acc)
                                        c = c + 1
                                    }
                                    p = p + 1
                                }
                                isc<Vec<Float>> = Vec()
                                d2 = 0
                                while (d2 < npools) { isc.push(0.0); d2 = d2 + 1 }
                                p = 0
                                while (p < npools) {
                                    acc = 0.0
                                    hh = 0
                                    while (hh < sv_IHEADS) {
                                        dot = 0.0
                                        c = 0
                                        while (c < sv_IDIM) {
                                            dot = dot + qidx.get(hh * sv_IDIM + c) * poolk.get(p * sv_IDIM + c)
                                            c = c + 1
                                        }
                                        rl = dot * scale_iq
                                        if (rl < 0.0) { rl = 0.0 }
                                        acc = acc + wproj.get(hh) * rl
                                        hh = hh + 1
                                    }
                                    isc.set(p, acc)
                                    p = p + 1
                                }
                                sel<Vec<Int>> = Vec()
                                d2 = 0
                                while (d2 < nckv) { sel.push(-1); d2 = d2 + 1 }
                                select_k = sv_TOPK / sv_KPOOL
                                if (select_k > npools) { select_k = npools }
                                taken<Vec<Int>> = Vec()
                                k = 0
                                while (k < select_k) {
                                    bestp = -1
                                    bestv = 0.0 - 1e30
                                    p = 0
                                    while (p < npools) {
                                        last = p * sv_KPOOL + sv_KPOOL - 1
                                        used = 0
                                        j = 0
                                        while (j < taken.len()) {
                                            if (taken.get(j) == p) { used = 1 }
                                            j = j + 1
                                        }
                                        if (last <= nckv - 1 && used == 0) {
                                            sc = isc.get(p)
                                            if (sc > bestv) { bestv = sc; bestp = p }
                                        }
                                        p = p + 1
                                    }
                                    if (bestp < 0) { k = select_k } else {
                                        taken.push(bestp)
                                        a = 0
                                        while (a < sv_KPOOL) {
                                            sel.set(bestp * sv_KPOOL + a, bestp * sv_KPOOL + a)
                                            a = a + 1
                                        }
                                        k = k + 1
                                    }
                                }
                                vcount = nckv
                                tcount = vcount % sv_KPOOL
                                tstart = vcount - tcount
                                a = 0
                                while (a < tcount) {
                                    sel.set(tstart + a, tstart + a)
                                    a = a + 1
                                }

                                # ---- masked MLA over the selected cache rows
                                Kv<Vec<Float>> = mm_host(ckv_t, nckv, sv_KV_LORA, d_ukm, sv_HEADS * sv_NOPE, fgemm)
                                Vm<Vec<Float>> = mm_host(ckv_t, nckv, sv_KV_LORA, d_uvm, sv_HEADS * sv_VDIM, fgemm)
                                probs<Vec<Float>> = Vec()
                                d2 = 0
                                while (d2 < sv_R * sv_HEADS * nckv) { probs.push(0.0); d2 = d2 + 1 }
                                hh = 0
                                while (hh < sv_HEADS) {
                                    mx = 0.0 - 1e30
                                    i = 0
                                    while (i < nckv) {
                                        if (sel.get(i) >= 0) {
                                            dot = 0.0
                                            c = 0
                                            while (c < sv_NOPE) {
                                                dot = dot + qfull.get(hh * sv_NOPE + c) * Kv.get((i * sv_HEADS + hh) * sv_NOPE + c)
                                                c = c + 1
                                            }
                                            sv = dot * sc_scale
                                            if (sv > mx) { mx = sv }
                                        }
                                        i = i + 1
                                    }
                                    sm = 0.0
                                    i = 0
                                    while (i < nckv) {
                                        if (sel.get(i) >= 0) {
                                            dot = 0.0
                                            c = 0
                                            while (c < sv_NOPE) {
                                                dot = dot + qfull.get(hh * sv_NOPE + c) * Kv.get((i * sv_HEADS + hh) * sv_NOPE + c)
                                                c = c + 1
                                            }
                                            sm = sm + vexp(dot * sc_scale - mx)
                                        }
                                        i = i + 1
                                    }
                                    i = 0
                                    while (i < nckv) {
                                        if (sel.get(i) >= 0) {
                                            dot = 0.0
                                            c = 0
                                            while (c < sv_NOPE) {
                                                dot = dot + qfull.get(hh * sv_NOPE + c) * Kv.get((i * sv_HEADS + hh) * sv_NOPE + c)
                                                c = c + 1
                                            }
                                            probs.set(hh * nckv + i, vexp(dot * sc_scale - mx) / sm)
                                        }
                                        i = i + 1
                                    }
                                    hh = hh + 1
                                }
                                ao<Vec<Float>> = Vec()
                                d2 = 0
                                while (d2 < sv_R * sv_HEADS * sv_VDIM) { ao.push(0.0); d2 = d2 + 1 }
                                hh = 0
                                while (hh < sv_HEADS) {
                                    c = 0
                                    while (c < sv_VDIM) {
                                        acc = 0.0
                                        i = 0
                                        while (i < nckv) {
                                            pv<Float> = probs.get(hh * nckv + i)
                                            if (pv != 0.0) {
                                                acc = acc + pv * Vm.get((i * sv_HEADS + hh) * sv_VDIM + c)
                                            }
                                            i = i + 1
                                        }
                                        ao.set(hh * sv_VDIM + c, acc)
                                        c = c + 1
                                    }
                                    hh = hh + 1
                                }
                                attn = mm_host(ao, sv_R, sv_HEADS * sv_VDIM, d_o, sv_H, fgemm)
                                free_dev(d_ukm)
                                free_dev(d_uvm)
                                free_dev(d_qa)
                                free_dev(d_qb)
                                free_dev(d_kva)
                                free_dev(d_o)
                                free_dev(d_wqb)
                                free_dev(d_wk)
                                free_dev(d_wproj)
                                free_dev(d_gatei)

                                streams1 = hc_apply(streams, attn, postA, combA)

                                # ---- ffn site: hc_ffn mix -> post_attn LN -> router -> experts -> shared
                                reflat<Vec<Float>> = rms_rows(borrow(streams1), sv_R, sv_HC * sv_H, Vec())
                                d_flat2 = alloc_dev(sv_R * sv_HC * sv_H * 8)
                                d_mv2 = alloc_dev(sv_R * 24 * 8)
                                d_scr2 = alloc_dev(64)
                                if (d_flat2 == 0 || d_mv2 == 0 || d_scr2 == 0) { return 21 }
                                bulk_htod(d_flat2, view(reflat))
                                if (gemm(fgemm, d_scr2, d_flat2, d_fnF, d_mv2, sv_R, 24, sv_HC * sv_H, 1.0, 0.0) != 0) { return 22 }
                                sync()
                                mv2<Vec<Float>> = bulk_dtoh(d_mv2, sv_R * 24)
                                free_dev(d_flat2)
                                free_dev(d_mv2)
                                free_dev(d_scr2)
                                free_dev(d_fnF)

                                res2<Vec<Float>> = hc_glue(mv2, sv_baseF, sv_scaleF, streams1)
                                collapsed2<Vec<Float>> = Vec()
                                i = 0
                                while (i < sv_R * sv_H) { collapsed2.push(res2.get(i)); i = i + 1 }
                                post2<Vec<Float>> = Vec()
                                i = 0
                                while (i < sv_R * sv_HC) { post2.push(res2.get(sv_R * sv_H + i)); i = i + 1 }
                                comb2<Vec<Float>> = Vec()
                                i = 0
                                while (i < sv_R * sv_HC * sv_HC) { comb2.push(res2.get(sv_R * sv_H + sv_R * sv_HC + i)); i = i + 1 }
                                h2<Vec<Float>> = rms_rows(borrow(collapsed2), sv_R, sv_H, post_ln2)

                                # router: sigmoid + noaux_tc bias + top-8 + renorm * 2.5
                                logits<Vec<Float>> = mm_host(h2, sv_R, sv_H, d_gw, sv_NE, fgemm)
                                freedom {
                                    cuMemFree_v2(d_gw)
                                }
                                scores<Vec<Float>> = Vec()
                                i = 0
                                while (i < logits.len()) {
                                    scores.push(sigmoid(logits.get(i)))
                                    i = i + 1
                                }
                                rsel<Vec<Int>> = Vec()
                                rwt<Vec<Float>> = Vec()
                                i = 0
                                while (i < sv_R * sv_ROUTE_TOPK) { rsel.push(-1); rwt.push(0.0); i = i + 1 }
                                r = 0
                                while (r < sv_R) {
                                    lane = 0
                                    while (lane < sv_ROUTE_TOPK) {
                                        best = -1
                                        bestv = 0.0 - 1e30
                                        j = 0
                                        while (j < sv_NE) {
                                            used = 0
                                            k = 0
                                            while (k < lane) {
                                                if (rsel.get(r * sv_ROUTE_TOPK + k) == j) { used = 1 }
                                                k = k + 1
                                            }
                                            if (used == 0) {
                                                cv = scores.get(r * sv_NE + j) + bias.get(j)
                                                if (cv > bestv) { bestv = cv; best = j }
                                            }
                                            j = j + 1
                                        }
                                        rsel.set(r * sv_ROUTE_TOPK + lane, best)
                                        lane = lane + 1
                                    }
                                    sm = 0.0
                                    lane = 0
                                    while (lane < sv_ROUTE_TOPK) {
                                        sm = sm + scores.get(r * sv_NE + rsel.get(r * sv_ROUTE_TOPK + lane))
                                        lane = lane + 1
                                    }
                                    lane = 0
                                    while (lane < sv_ROUTE_TOPK) {
                                        rwt.set(r * sv_ROUTE_TOPK + lane,
                                                scores.get(r * sv_NE + rsel.get(r * sv_ROUTE_TOPK + lane)) / (sm + 1e-20) * sv_ROUTED_SCALE)
                                        lane = lane + 1
                                    }
                                    r = r + 1
                                }

                                # routed experts: lazy per-expert resolve (9 names), EXL3 deq, then shared
                                accr<Vec<Float>> = Vec()
                                i = 0
                                while (i < sv_R * sv_H) { accr.push(0.0); i = i + 1 }
                                nex = 0
                                e = 0
                                while (e < sv_NE) {
                                    toks<Vec<Int>> = Vec()
                                    lanes<Vec<Int>> = Vec()
                                    r = 0
                                    while (r < sv_R) {
                                        lane = 0
                                        while (lane < sv_ROUTE_TOPK) {
                                            if (rsel.get(r * sv_ROUTE_TOPK + lane) == e) {
                                                toks.push(r)
                                                lanes.push(lane)
                                            }
                                            lane = lane + 1
                                        }
                                        r = r + 1
                                    }
                                    nt = toks.len()
                                    if (nt > 0) {
                                        nex = nex + 1
                                        i0 = e * 9
                                        epre<String> = lpre + "mlp.experts." + e.to_string() + "."
                                        w2<Vec<String>> = Vec()
                                        w2.push(epre + "gate_proj.trellis")
                                        w2.push(epre + "gate_proj.suh")
                                        w2.push(epre + "gate_proj.svh")
                                        w2.push(epre + "up_proj.trellis")
                                        w2.push(epre + "up_proj.suh")
                                        w2.push(epre + "up_proj.svh")
                                        w2.push(epre + "down_proj.trellis")
                                        w2.push(epre + "down_proj.suh")
                                        w2.push(epre + "down_proj.svh")
                                        gexp<GxLoc> = gx_resolve_tab(tab, dir, total, w2)
                                        nfound = 0
                                        j = 0
                                        while (j < 9) {
                                            if (gexp.found.get(j) == 1) { nfound = nfound + 1 }
                                            j = j + 1
                                        }
                                        if (nfound != 9) {
                                            println("CHAIN_FAIL resolve expert " + e.to_string() + " layer " + n.to_string())
                                            return 23
                                        }
                                        g_gexp_2 = gx_read(gexp, 2)
                                        g_gexp_1 = gx_read(gexp, 1)
                                        g_gexp_0 = gx_read(gexp, 0)
                                        dWg<Int> = exl3_deq(fdeq, fhgen, fhad1, fhad2, g_gexp_0, g_gexp_1, g_gexp_2, mapbody, sv_EINTER, 32768, hdg)
                                        g_gexp_5 = gx_read(gexp, 5)
                                        g_gexp_4 = gx_read(gexp, 4)
                                        g_gexp_3 = gx_read(gexp, 3)
                                        dWu<Int> = exl3_deq(fdeq, fhgen, fhad1, fhad2, g_gexp_3, g_gexp_4, g_gexp_5, mapbody, sv_EINTER, 32768, hdg)
                                        g_gexp_8 = gx_read(gexp, 8)
                                        g_gexp_7 = gx_read(gexp, 7)
                                        g_gexp_6 = gx_read(gexp, 6)
                                        dWd<Int> = exl3_deq(fdeq, fhgen, fhad1, fhad2, g_gexp_6, g_gexp_7, g_gexp_8, mapbody, sv_H, 32768, hdg)
                                        if (dWg == 0 || dWu == 0 || dWd == 0) {
                                            println("CHAIN_FAIL deq expert " + e.to_string())
                                            return 24
                                        }
                                        sub<Vec<Float>> = Vec()
                                        j = 0
                                        while (j < nt) {
                                            tk = toks.get(j) * sv_H
                                            d2 = 0
                                            while (d2 < sv_H) {
                                                sub.push(h2.get(tk + d2))
                                                d2 = d2 + 1
                                            }
                                            j = j + 1
                                        }
                                        gv<Vec<Float>> = mm_host(sub, nt, sv_H, dWg, sv_EINTER, fgemm)
                                        uv<Vec<Float>> = mm_host(sub, nt, sv_H, dWu, sv_EINTER, fgemm)
                                        act<Vec<Float>> = Vec()
                                        j = 0
                                        while (j < gv.len()) {
                                            g1 = gv.get(j)
                                            if (g1 > sv_SWIGLU_LIMIT) { g1 = sv_SWIGLU_LIMIT }
                                            u1 = uv.get(j)
                                            if (u1 > sv_SWIGLU_LIMIT) { u1 = sv_SWIGLU_LIMIT }
                                            if (u1 < 0.0 - sv_SWIGLU_LIMIT) { u1 = 0.0 - sv_SWIGLU_LIMIT }
                                            act.push(silu(g1) * u1)
                                            j = j + 1
                                        }
                                        yv<Vec<Float>> = mm_host(act, nt, sv_EINTER, dWd, sv_H, fgemm)
                                        j = 0
                                        while (j < nt) {
                                            tk = toks.get(j)
                                            wt = rwt.get(tk * sv_ROUTE_TOPK + lanes.get(j))
                                            d2 = 0
                                            while (d2 < sv_H) {
                                                accr.set(tk * sv_H + d2, accr.get(tk * sv_H + d2) + wt * yv.get(j * sv_H + d2))
                                                d2 = d2 + 1
                                            }
                                            j = j + 1
                                        }
                                        freedom {
                                            cuMemFree_v2(dWg)
                                            cuMemFree_v2(dWu)
                                            cuMemFree_v2(dWd)
                                        }
                                    }
                                    e = e + 1
                                }

                                g_lg_24 = gx_read(lg, 24)
                                d_sg = deq_bf16(fbf, g_lg_24, sv_EINTER * sv_H, sv_H)
                                g_lg_25 = gx_read(lg, 25)
                                d_su = deq_bf16(fbf, g_lg_25, sv_EINTER * sv_H, sv_H)
                                g_lg_26 = gx_read(lg, 26)
                                d_sd = deq_bf16(fbf, g_lg_26, sv_H * sv_EINTER, sv_EINTER)
                                if (d_sg == 0 || d_su == 0 || d_sd == 0) { return 25 }
                                sgate<Vec<Float>> = mm_host(h2, sv_R, sv_H, d_sg, sv_EINTER, fgemm)
                                sup<Vec<Float>> = mm_host(h2, sv_R, sv_H, d_su, sv_EINTER, fgemm)
                                sact<Vec<Float>> = Vec()
                                i = 0
                                while (i < sgate.len()) {
                                    g1 = sgate.get(i)
                                    if (g1 > sv_SWIGLU_LIMIT) { g1 = sv_SWIGLU_LIMIT }
                                    u1 = sup.get(i)
                                    if (u1 > sv_SWIGLU_LIMIT) { u1 = sv_SWIGLU_LIMIT }
                                    if (u1 < 0.0 - sv_SWIGLU_LIMIT) { u1 = 0.0 - sv_SWIGLU_LIMIT }
                                    sact.push(silu(g1) * u1)
                                    i = i + 1
                                }
                                shared<Vec<Float>> = mm_host(sact, sv_R, sv_EINTER, d_sd, sv_H, fgemm)
                                free_dev(d_sg)
                                free_dev(d_su)
                                free_dev(d_sd)

                                mlp = vecf()
                                i = 0
                                while (i < sv_R * sv_H) { mlp.push(accr.get(i) + shared.get(i)); i = i + 1 }
                                streams2 = hc_apply(streams1, mlp, post2, comb2)
                            } else {
                                # ------------------------------------------------ KDA layer step
                                kslot = n - ((n + 1) / 4)
                                if (n < 3) {
                                    g_lg_17 = gx_read(lg, 17)
                                    d_fnA = deq_bf16(fbf, g_lg_17, 24 * sv_HC * sv_H, sv_HC * sv_H)
                                } else {
                                    g_lg_14 = gx_read(lg, 14)
                                    d_fnA = deq_bf16(fbf, g_lg_14, 24 * sv_HC * sv_H, sv_HC * sv_H)
                                }
                                if (d_fnA == 0) { return 11 }
                                base<Vec<Float>> = Vec()
                                raw_base<String> = ""
                                g_lg_15 = gx_read(lg, 15)
                                g_lg_18 = gx_read(lg, 18)
                                if (n < 3) { raw_base = g_lg_18 } else { raw_base = g_lg_15 }
                                j = 0
                                while (j < 24) { base.push(f32_at(raw_base, j)); j = j + 1 }
                                scale<Vec<Float>> = Vec()
                                raw_scale<String> = ""
                                g_lg_16 = gx_read(lg, 16)
                                g_lg_19 = gx_read(lg, 19)
                                if (n < 3) { raw_scale = g_lg_19 } else { raw_scale = g_lg_16 }
                                j = 0
                                while (j < 3) { scale.push(f32_at(raw_scale, j)); j = j + 1 }

                                println("SEC preS " + (now_ms() - secT).to_string())
                                secT = now_ms()
                                g_lg_0 = gx_read(lg, 0)
                                d_q = deq_bf16(fbf, g_lg_0, sv_H * sv_HEADS * sv_KD, sv_H)
                                g_lg_1 = gx_read(lg, 1)
                                d_k = deq_bf16(fbf, g_lg_1, sv_H * sv_HEADS * sv_KD, sv_H)
                                g_lg_2 = gx_read(lg, 2)
                                d_v = deq_bf16(fbf, g_lg_2, sv_H * sv_HEADS * sv_KD, sv_H)
                                g_lg_3 = gx_read(lg, 3)
                                d_o = deq_bf16(fbf, g_lg_3, sv_HEADS * sv_KD * sv_H, sv_HEADS * sv_KD)
                                g_lg_4 = gx_read(lg, 4)
                                d_b = deq_bf16(fbf, g_lg_4, sv_H * sv_HEADS, sv_H)
                                g_lg_5 = gx_read(lg, 5)
                                d_fa = deq_bf16(fbf, g_lg_5, sv_H * 128, sv_H)
                                g_lg_6 = gx_read(lg, 6)
                                d_fb = deq_bf16(fbf, g_lg_6, 128 * sv_HEADS * sv_KD, 128)
                                g_lg_7 = gx_read(lg, 7)
                                d_ga = deq_bf16(fbf, g_lg_7, sv_H * 128, sv_H)
                                g_lg_8 = gx_read(lg, 8)
                                d_gb = deq_bf16(fbf, g_lg_8, 128 * sv_HEADS * sv_KD, 128)
                                if (n < 3) {
                                    g_lg_15 = gx_read(lg, 15)
                                    d_ln = deq_bf16(fbf, g_lg_15, sv_H, 0)
                                    g_lg_16 = gx_read(lg, 16)
                                    d_ln2 = deq_bf16(fbf, g_lg_16, sv_H, 0)
                                    g_lg_24 = gx_read(lg, 24)
                                    d_cq = deq_bf16(fbf, g_lg_24, sv_HEADS * sv_KD * sv_CONV_K, 0)
                                    g_lg_25 = gx_read(lg, 25)
                                    d_ck = deq_bf16(fbf, g_lg_25, sv_HEADS * sv_KD * sv_CONV_K, 0)
                                    g_lg_26 = gx_read(lg, 26)
                                    d_cv = deq_bf16(fbf, g_lg_26, sv_HEADS * sv_KD * sv_CONV_K, 0)
                                } else {
                                    g_lg_12 = gx_read(lg, 12)
                                    d_ln = deq_bf16(fbf, g_lg_12, sv_H, 0)
                                    g_lg_13 = gx_read(lg, 13)
                                    d_ln2 = deq_bf16(fbf, g_lg_13, sv_H, 0)
                                    g_lg_20 = gx_read(lg, 20)
                                    d_cq = deq_bf16(fbf, g_lg_20, sv_HEADS * sv_KD * sv_CONV_K, 0)
                                    g_lg_21 = gx_read(lg, 21)
                                    d_ck = deq_bf16(fbf, g_lg_21, sv_HEADS * sv_KD * sv_CONV_K, 0)
                                    g_lg_22 = gx_read(lg, 22)
                                    d_cv = deq_bf16(fbf, g_lg_22, sv_HEADS * sv_KD * sv_CONV_K, 0)
                                }
                                if (d_q == 0 || d_k == 0 || d_v == 0 || d_o == 0 || d_b == 0 || d_fa == 0 || d_fb == 0 ||
                                    d_ga == 0 || d_gb == 0 || d_ln == 0 || d_ln2 == 0 || d_cq == 0 || d_ck == 0 || d_cv == 0) {
                                    println("CHAIN_FAIL weight deq kda " + n.to_string())
                                    return 15
                                }
                                in_ln<Vec<Float>> = bulk_dtoh(d_ln, sv_H)
                                post_ln3<Vec<Float>> = bulk_dtoh(d_ln2, sv_H)
                                convq<Vec<Float>> = bulk_dtoh(d_cq, sv_HEADS * sv_KD * sv_CONV_K)
                                convk<Vec<Float>> = bulk_dtoh(d_ck, sv_HEADS * sv_KD * sv_CONV_K)
                                convv<Vec<Float>> = bulk_dtoh(d_cv, sv_HEADS * sv_KD * sv_CONV_K)
                                free_dev(d_cq)
                                free_dev(d_ck)
                                free_dev(d_cv)

                                g_lg_9 = gx_read(lg, 9)
                                d_onorm = deq_bf16(fbf, g_lg_9, sv_KD, 0)
                                if (d_onorm == 0) { return 16 }
                                onorm<Vec<Float>> = bulk_dtoh(d_onorm, sv_KD)
                                free_dev(d_onorm)

                                g_lg_10 = gx_read(lg, 10)
                                println("SEC stageS " + (now_ms() - secT).to_string())
                                secT = now_ms()
                                raw_dt<String> = g_lg_10
                                dt<Vec<Float>> = Vec()
                                i = 0
                                while (i < sv_HEADS * sv_KD) { dt.push(f32_at(raw_dt, i)); i = i + 1 }
                                g_lg_11 = gx_read(lg, 11)
                                raw_alog<String> = g_lg_11
                                alog<Vec<Float>> = Vec()
                                i = 0
                                while (i < sv_HEADS) { alog.push(f32_at(raw_alog, i)); i = i + 1 }

                                # ---- attn site: hc mix -> input_layernorm -> KDA -> o_proj -> hc apply
                                flat<Vec<Float>> = rms_rows(borrow(streams), sv_R, sv_HC * sv_H, Vec())
                                d_flat = alloc_dev(sv_R * sv_HC * sv_H * 8)
                                d_mv = alloc_dev(sv_R * 24 * 8)
                                d_scr = alloc_dev(64)
                                if (d_flat == 0 || d_mv == 0 || d_scr == 0) { println("CHAIN_FAIL alloc"); return 17 }
                                bulk_htod(d_flat, view(flat))
                                if (gemm(fgemm, d_scr, d_flat, d_fnA, d_mv, sv_R, 24, sv_HC * sv_H, 1.0, 0.0) != 0) { return 17 }
                                sync()
                                mv<Vec<Float>> = bulk_dtoh(d_mv, sv_R * 24)
                                free_dev(d_flat)
                                free_dev(d_mv)
                                free_dev(d_scr)
                                free_dev(d_fnA)

                                res<Vec<Float>> = hc_glue(mv, base, scale, streams)
                                collapsed<Vec<Float>> = Vec()
                                i = 0
                                while (i < sv_R * sv_H) { collapsed.push(res.get(i)); i = i + 1 }
                                postA<Vec<Float>> = Vec()
                                i = 0
                                while (i < sv_R * sv_HC) { postA.push(res.get(sv_R * sv_H + i)); i = i + 1 }
                                combA<Vec<Float>> = Vec()
                                i = 0
                                while (i < sv_R * sv_HC * sv_HC) { combA.push(res.get(sv_R * sv_H + sv_R * sv_HC + i)); i = i + 1 }
                                h_a<Vec<Float>> = rms_rows(borrow(collapsed), sv_R, sv_H, in_ln)

                                println("SEC parseA " + (now_ms() - secT).to_string())
                                secT = now_ms()
                                qp<Vec<Float>> = mm_host(h_a, sv_R, sv_H, d_q, sv_HEADS * sv_KD, fgemm)
                                kp<Vec<Float>> = mm_host(h_a, sv_R, sv_H, d_k, sv_HEADS * sv_KD, fgemm)
                                vp<Vec<Float>> = mm_host(h_a, sv_R, sv_H, d_v, sv_HEADS * sv_KD, fgemm)

                                # conv step against this layer's carried ring (copy in, rotate, copy out)
                                ringq<Vec<Float>> = Vec()
                                ringk<Vec<Float>> = Vec()
                                ringv<Vec<Float>> = Vec()
                                i = 0
                                while (i < (sv_CONV_K - 1) * sv_HEADS * sv_KD) {
                                    ringq.push(ringQ.get(kslot * (sv_CONV_K - 1) * sv_HEADS * sv_KD + i))
                                    ringk.push(ringK.get(kslot * (sv_CONV_K - 1) * sv_HEADS * sv_KD + i))
                                    ringv.push(ringV.get(kslot * (sv_CONV_K - 1) * sv_HEADS * sv_KD + i))
                                    i = i + 1
                                }
                                qres2<Vec<Float>> = conv1_step(qp, ringq, convq)
                                kres2<Vec<Float>> = conv1_step(kp, ringk, convk)
                                vres2<Vec<Float>> = conv1_step(vp, ringv, convv)
                                qc<Vec<Float>> = Vec()
                                i = 0
                                while (i < sv_HEADS * sv_KD) { qc.push(qres2.get(i)); i = i + 1 }
                                i = sv_HEADS * sv_KD
                                while (i < qres2.len()) { ringq.set(i - sv_HEADS * sv_KD, qres2.get(i)); i = i + 1 }
                                kc<Vec<Float>> = Vec()
                                i = 0
                                while (i < sv_HEADS * sv_KD) { kc.push(kres2.get(i)); i = i + 1 }
                                i = sv_HEADS * sv_KD
                                while (i < kres2.len()) { ringk.set(i - sv_HEADS * sv_KD, kres2.get(i)); i = i + 1 }
                                vc<Vec<Float>> = Vec()
                                i = 0
                                while (i < sv_HEADS * sv_KD) { vc.push(vres2.get(i)); i = i + 1 }
                                i = sv_HEADS * sv_KD
                                while (i < vres2.len()) { ringv.set(i - sv_HEADS * sv_KD, vres2.get(i)); i = i + 1 }
                                i = 0
                                while (i < (sv_CONV_K - 1) * sv_HEADS * sv_KD) {
                                    ringQ.set(kslot * (sv_CONV_K - 1) * sv_HEADS * sv_KD + i, ringq.get(i))
                                    ringK.set(kslot * (sv_CONV_K - 1) * sv_HEADS * sv_KD + i, ringk.get(i))
                                    ringV.set(kslot * (sv_CONV_K - 1) * sv_HEADS * sv_KD + i, ringv.get(i))
                                    i = i + 1
                                }

                                qn<Vec<Float>> = l2_rows(qc, sv_R * sv_HEADS, sv_KD)
                                kn2<Vec<Float>> = l2_rows(kc, sv_R * sv_HEADS, sv_KD)
                                i = 0
                                while (i < qn.len()) {
                                    qn.set(i, qn.get(i) * (1.0 / vsqrt(sv_KD as Float, 40)))
                                    i = i + 1
                                }

                                bet<Vec<Float>> = mm_host(h_a, sv_R, sv_H, d_b, sv_HEADS, fgemm)
                                i = 0
                                while (i < bet.len()) {
                                    bet.set(i, sigmoid(bet.get(i)))
                                    i = i + 1
                                }
                                fa<Vec<Float>> = mm_host(h_a, sv_R, sv_H, d_fa, 128, fgemm)
                                fraw<Vec<Float>> = mm_host(fa, sv_R, 128, d_fb, sv_HEADS * sv_KD, fgemm)
                                ga<Vec<Float>> = mm_host(h_a, sv_R, sv_H, d_ga, 128, fgemm)
                                zraw<Vec<Float>> = mm_host(ga, sv_R, 128, d_gb, sv_HEADS * sv_KD, fgemm)

                                gdec<Vec<Float>> = log_decay(borrow(fraw), dt, alog)

                                # recurrence with the carried state (copy slot in, step, copy back)
                                st_t<Vec<Float>> = Vec()
                                i = 0
                                while (i < sv_HEADS * sv_KD * sv_KD) {
                                    st_t.push(stAll.get(kslot * sv_HEADS * sv_KD * sv_KD + i))
                                    i = i + 1
                                }
                                dres<Vec<Float>> = delta_rule_step(borrow(qn), kn2, vc, gdec, bet, view(st_t))
                                att0<Vec<Float>> = Vec()
                                i = 0
                                while (i < sv_R * sv_HEADS * sv_KD) { att0.push(dres.get(i)); i = i + 1 }
                                i = sv_R * sv_HEADS * sv_KD
                                while (i < dres.len()) {
                                    stAll.set(kslot * sv_HEADS * sv_KD * sv_KD + (i - sv_R * sv_HEADS * sv_KD), dres.get(i))
                                    i = i + 1
                                }

                                gnorm<Vec<Float>> = gated_norm(att0, zraw, onorm)
                                println("SEC qkvB " + (now_ms() - secT).to_string())
                                secT = now_ms()
                                attn = mm_host(gnorm, sv_R, sv_HEADS * sv_KD, d_o, sv_H, fgemm)
                                free_dev(d_q)
                                free_dev(d_k)
                                free_dev(d_v)
                                free_dev(d_o)
                                free_dev(d_b)
                                free_dev(d_fa)
                                free_dev(d_fb)
                                free_dev(d_ga)
                                free_dev(d_gb)

                                streams1 = hc_apply(streams, attn, postA, combA)

                                println("SEC attnC " + (now_ms() - secT).to_string())
                                secT = now_ms()
                                if (n < 3) {
                                    # ---- dense SwiGLU MLP tail (glm_decode_step.vyb's step body)
                                    g_lg_20 = gx_read(lg, 20)
                                    d_fnF = deq_bf16(fbf, g_lg_20, 24 * sv_HC * sv_H, sv_HC * sv_H)
                                    if (d_fnF == 0) { return 18 }
                                    sv_baseF = vecf()
                                    g_lg_21 = gx_read(lg, 21)
                                    raw_baseF<String> = g_lg_21
                                    j = 0
                                    while (j < 24) { sv_baseF.push(f32_at(raw_baseF, j)); j = j + 1 }
                                    sv_scaleF = vecf()
                                    g_lg_22 = gx_read(lg, 22)
                                    raw_scaleF<String> = g_lg_22
                                    j = 0
                                    while (j < 3) { sv_scaleF.push(f32_at(raw_scaleF, j)); j = j + 1 }
                                    g_lg_12 = gx_read(lg, 12)
                                    d_gate = deq_bf16(fbf, g_lg_12, sv_H * sv_INTER, sv_H)
                                    g_lg_13 = gx_read(lg, 13)
                                    d_up = deq_bf16(fbf, g_lg_13, sv_H * sv_INTER, sv_H)
                                    g_lg_14 = gx_read(lg, 14)
                                    d_down = deq_bf16(fbf, g_lg_14, sv_INTER * sv_H, sv_INTER)
                                    if (d_gate == 0 || d_up == 0 || d_down == 0) { return 19 }

                                    reflat<Vec<Float>> = rms_rows(borrow(streams1), sv_R, sv_HC * sv_H, Vec())
                                    d_flat2 = alloc_dev(sv_R * sv_HC * sv_H * 8)
                                    d_mv2 = alloc_dev(sv_R * 24 * 8)
                                    d_scr2 = alloc_dev(64)
                                    if (d_flat2 == 0 || d_mv2 == 0 || d_scr2 == 0) { return 20 }
                                    bulk_htod(d_flat2, view(reflat))
                                    if (gemm(fgemm, d_scr2, d_flat2, d_fnF, d_mv2, sv_R, 24, sv_HC * sv_H, 1.0, 0.0) != 0) { return 20 }
                                    sync()
                                    mv2<Vec<Float>> = bulk_dtoh(d_mv2, sv_R * 24)
                                    free_dev(d_flat2)
                                    free_dev(d_mv2)
                                    free_dev(d_scr2)
                                    free_dev(d_fnF)

                                    res2<Vec<Float>> = hc_glue(mv2, sv_baseF, sv_scaleF, streams1)
                                    collapsed2<Vec<Float>> = Vec()
                                    i = 0
                                    while (i < sv_R * sv_H) { collapsed2.push(res2.get(i)); i = i + 1 }
                                    post2<Vec<Float>> = Vec()
                                    i = 0
                                    while (i < sv_R * sv_HC) { post2.push(res2.get(sv_R * sv_H + i)); i = i + 1 }
                                    comb2<Vec<Float>> = Vec()
                                    i = 0
                                    while (i < sv_R * sv_HC * sv_HC) { comb2.push(res2.get(sv_R * sv_H + sv_R * sv_HC + i)); i = i + 1 }
                                    h2<Vec<Float>> = rms_rows(borrow(collapsed2), sv_R, sv_H, post_ln3)

                                    mg<Vec<Float>> = mm_host(h2, sv_R, sv_H, d_gate, sv_INTER, fgemm)
                                    mu<Vec<Float>> = mm_host(h2, sv_R, sv_H, d_up, sv_INTER, fgemm)
                                    act<Vec<Float>> = Vec()
                                    i = 0
                                    while (i < mg.len()) {
                                        act.push(silu(mg.get(i)) * mu.get(i))
                                        i = i + 1
                                    }
                                    mlp = mm_host(act, sv_R, sv_INTER, d_down, sv_H, fgemm)
                                    free_dev(d_gate)
                                    free_dev(d_up)
                                    free_dev(d_down)
                                    streams2 = hc_apply(streams1, mlp, post2, comb2)
                                } else {
                                    # ---- MoE tail (tail_site's body, sv_R = 1)
                                    streams2 = moe_tail_step(streams1, lpre, tab, dir, total, mapbody, lg,
                                                             fgemm, fbf, fdeq, fhgen, fhad1, fhad2, hdg)
                                }
                            }

                            println("step" + t.to_string() + " layer " + n.to_string() + " done")
                            println("SEC mlpmoe " + (now_ms() - secT).to_string())
                            secT = now_ms()
                            dg2 = digest("l" + n.to_string() + "s" + t.to_string() + " s2", streams2)
                            println(dg2)
                            lines = lines + dg2 + "\n"
                            lines = lines + digest("l" + n.to_string() + "s" + t.to_string() + "attn", attn) + "\n"
                            lines = lines + digest("l" + n.to_string() + "s" + t.to_string() + "mlp", mlp) + "\n"
                            println("SEC ioF1 " + (now_ms() - secT).to_string())
                            secT = now_ms()
                            gs<Float> = slowget(borrow(streams2), 16384)
                            println("SLOWGET streams2 " + (now_ms() - secT).to_string())
                            secT = now_ms()
                            if (dump_on == 1) {
                                dd<Int> = dump_to("d" + t.to_string() + "l" + n.to_string() + "s2", streams2)
                            dd = dump_to("d" + t.to_string() + "l" + n.to_string() + "s1", streams1)
                            dd = dump_to("d" + t.to_string() + "l" + n.to_string() + "attn", attn)
                            dd = dump_to("d" + t.to_string() + "l" + n.to_string() + "mlp", mlp)                            }

                            streams = streams2
                            println("SEC ioF2 " + (now_ms() - secT).to_string())
                            secT = now_ms()
                            i = trim_heap()
                            println("SEC ioF3 " + (now_ms() - secT).to_string())
                            println("RSS step" + t.to_string() + " n=" + n.to_string() + " " + rss_mb().to_string() + "MB")
                            n = n + 1
                        }

                        # ============================================================ MTP head (layer 45)
                        if (nlay == 45) {
                            # refresh the index/map strings: the 45-layer walk churned Strings (the
                            # same corruption window the per-step refresh above brackets)
                            match (open_read("native/exl3/map.bin")) {
                                f -> { match (read_all(f)) { s -> { mapd = s } ? -> { return 5 } } close(f) }
                                ? -> { return 5 }
                            }
                            mapbody = mapd.substring(16, mapd.len())
                            idxtext = gx_read_index(dir)
                            tvec = vecf()
                            d2 = 0
                            while (d2 < sv_H) {
                                acc = 0.0
                                hh = 0
                                while (hh < sv_HC) {
                                    acc = acc + streams2.get(hh * sv_H + d2)
                                    hh = hh + 1
                                }
                                tvec.push(acc / 4.0)
                                d2 = d2 + 1
                            }
                            mrow = 20 + t
                            lines = lines + dumps("mtptrunk" + mrow.to_string(), tvec) + "\n"
                            raw_e = ""
                            match (open_read(emb_path)) {
                                f -> {
                                    match (read_at(f, emb_off + tid * sv_H * 2, sv_H * 2)) {
                                        s -> { raw_e = s }
                                        ? -> { return 9 }
                                    }
                                    close(f)
                                }
                                ? -> { return 9 }
                            }
                            hin = mtp_build_row(tvec, raw_e, tab, dir, total, fgemm, fbf)
                            if (hin.len() != sv_H) { println("CHAIN_FAIL mtp build step " + t.to_string()); return 42 }
                            lines = lines + dumps("mtphin" + mrow.to_string(), hin) + "\n"
                            x2 = mtp_layer_step(hin, mrow, lpre45, tab, dir, total, mapbody, borrow(mckv), borrow(mik), borrow(migsc), mdw, fgemm, fbf, fdeq, fhgen, fhad1, fhad2, hdg)
                            if (x2.len() != sv_H) { println("CHAIN_FAIL mtp layer step " + t.to_string()); return 43 }
                            lines = lines + dumps("mtpx" + mrow.to_string(), x2) + "\n"
                            println("mtp step" + t.to_string() + " done")
                            if (t == nsteps - 1) {
                                # ---- final head: shared_head.norm -> lm_head (chunked, untied) -> argmax
                                wantH<Vec<String>> = Vec()
                                wantH.push(lpre45 + "shared_head.norm.weight")
                                wantH.push("lm_head.weight")
                                lmg = gx_resolve_tab(tab, dir, total, wantH)
                                nf = 0
                                i = 0
                                while (i < 2) {
                                    if (lmg.found.get(i) == 1) { nf = nf + 1 }
                                    i = i + 1
                                }
                                if (nf != 2) { println("CHAIN_FAIL mtp head resolve"); return 44 }
                                g_lmg_0 = gx_read(lmg, 0)
                                d_shn<Int> = deq_bf16(fbf, g_lmg_0, sv_H, 0)
                                if (d_shn == 0) { return 44 }
                                sv_shn_w = bulk_dtoh(d_shn, sv_H)
                                free_dev(d_shn)
                                finv = rms_rows(borrow(x2), 1, sv_H, sv_shn_w)
                                lmpath = lmg.paths.get(1)
                                lmoff = lmg.off.get(1)
                                logv = vecf()
                                cbesti = 0
                                cbestv = 0.0 - 1e308
                                cbase = 0
                                while (cbase < 154880) {
                                    cn = 154880 - cbase
                                    if (cn > crows) { cn = crows }
                                    lmraw = ""
                                    match (open_read(lmpath)) {
                                        f -> {
                                            match (read_at(f, lmoff + cbase * sv_H * 2, cn * sv_H * 2)) {
                                                s -> { lmraw = s }
                                                ? -> { return 9 }
                                            }
                                            close(f)
                                        }
                                        ? -> { return 9 }
                                    }
                                    d_lmw<Int> = deq_bf16(fbf, lmraw, cn * sv_H, sv_H)
                                    if (d_lmw == 0) { println("CHAIN_FAIL mtp lmhead deq"); return 45 }
                                    chunk = mm_host(finv, 1, sv_H, d_lmw, cn, fgemm)
                                    free_dev(d_lmw)
                                    i = 0
                                    while (i < cn) {
                                        logv.push(chunk.get(i))
                                        if (chunk.get(i) > cbestv) {
                                            cbestv = chunk.get(i)
                                            cbesti = cbase + i
                                        }
                                        i = i + 1
                                    }
                                    cbase = cbase + cn
                                }
                                lines = lines + dumps("mtplogits" + t.to_string(), logv) + "\n"
                                println("MTP draft token: " + cbesti.to_string() + " (logit " + cbestv.to_string() + ")")
                            }
                        }
                        t = t + 1
                    }

                    # open_append: the per-layer d-lines were streamed to the same file during
                    # the run — an open_write here truncates them away (the decchain14 run's
                    # file was cut to the summaries + 66 stragglers).
                    match (open_append(out)) {
                        f -> { write_str(f, lines); close(f) }
                        ? -> { println("CHAIN_FAIL write"); return 26 }
                    }
                    println("CHAIN_OK 45 layers x 2 teacher-forced decode steps, all caches carried")
                                resp = http_response(200, "{\"draft_token\": " + cbesti.to_string() + "}")
                                http_send_all(conn.fd, resp)
                                http_close(conn.fd)
                                # the graceful close lets the client read the body; a
                                # return here would hard-exit main mid-connection (the
                                # kernel sends RST and curl discards the response).
                                break
                } else {
                    resp = http_response(404, "{\"error\": \"not found\"}")
                }
                if (resp.len() > 0) {
                    http_send_all(conn.fd, resp)
                    http_close(conn.fd)
                }
                }
                ? -> { println("SERVE accept failed") }
            }
        }
        }
        ? -> { println("SERVE_FAIL listen"); return 6 }
    }
    return 0
}
















