// Full-36-layer Qwen3-4B prefill on the GPU, Vyb-native (tied lm_head).
// Streams each layer's 11 real weights from the live GGUF via io::read_at,
// tensor index read from native/out/qwen3_4b_tensors.tsv (no hardcoded offsets),
// bulk-dequants Q4_K/Q6_K/F32->f64 per layer (packed stays canonical), then loops
// blk.0..35 forward (layer.vyb gemm/rmsnorm/attn/silu/resid + qwen3.vyb rope/
// f32expand) with ping-pong activations. Ends with output_norm -> tied lm_head
// (token_embd chunked-dequant -> trans_emb -> gemm -> argmax). Writes:
//   prefill_hidden_vyb.txt  -- final 36-layer hidden [S,D]
//   prefill_top1_vyb.txt    -- per-token argmax logit id (tied lm_head)
import io::{open_read, read_at, read_all, open_write, write_str, close}
import llm::{llm_load, llm_decode, llm_encode}
import vllm::{Model}
import env::{env_get}
// S0.2: dimensions come from the model's own config, and buffer sizes from the tensor core.
// Both are PURE (no CUDA, no allocation) — a module that pulls in cuda_binding cannot be
// imported by a file declaring its own extern "C" (Vyb#442).
import model_config::{mc_load, mc_nq, mc_nkv, mc_is_ok, ModelConfig}
// unit 9c: the per-layer DISPATCH. The loop asks this rule which branch a block takes instead of
// inferring it from the architecture name or a layer-index list (P4.4, model_caps::mc_layer_kind).
import model_caps::{mc_layer_kind}
import tshape::{tt_nbytes}
import dtype::{dt_f64, dt_bytes_for}

extern "C" {
    cuInit(flags<CUInt>)<CInt>
    cuDeviceGetCount(count<loc<CInt>>)<CInt>
    cuDeviceGet(device<loc<CInt>>, ordinal<CInt>)<CInt>
    cuCtxCreate_v2(pctx<loc<loc<CVoid>>>, flags<CUInt>, dev<CInt>)<CInt>
    cuModuleLoadData(hmod<loc<loc<CVoid>>>, image<CString>)<CInt>
    cuModuleGetFunction(hfunc<loc<loc<CVoid>>>, hmod<loc<CVoid>>, name<CString>)<CInt>
    cuMemAlloc_v2(dptr<loc<Int>>, bytesize<Int>)<CInt>
    cuMemcpyHtoD_v2(dstDevice<Int>, srcHost<loc<CVoid>>, ByteCount<Int>)<CInt>
    cuMemcpyHtoDAsync_v2(dstDevice<Int>, srcHost<CString>, ByteCount<Int>, hStream<Int>)<CInt>
    cuMemcpyDtoH_v2(dstHost<loc<CVoid>>, srcDevice<Int>, ByteCount<Int>)<CInt>
    cuMemFree_v2(dptr<Int>)<CInt>
    cuMemsetD8_v2(dstDevice<Int>, uc<CUInt>, N<Int>)<CInt>
    cuCtxSynchronize()<CInt>
    cuda_launch4i(f<loc<CVoid>>, gridX<CUInt>, gridY<CUInt>, gridZ<CUInt>,
                  blockX<CUInt>, blockY<CUInt>, blockZ<CUInt>,
                  a0<Int>, a1<Int>, a2<Int>, a3<Int>)<CInt>
    # Generic launcher (Vyb#476): no arity cap and no per-argument register class — the caller
    # packs an array of argument-cell addresses and cuLaunchKernel takes the single pointer. Only
    # the grid-table dequant kernels (IQ2_S/IQ3_S) need it, because their codebook is an ordinary
    # FIFTH argument and `cuda_launch4i` has exactly four slots. Vyb#476 made this stdlib call
    # available; the standalone load drivers (native/host/iq2_s_load_driver.vyb) use the same form.
    cuda_launch_n(f<loc<CVoid>>, gridX<CUInt>, gridY<CUInt>, gridZ<CUInt>,
                  blockX<CUInt>, blockY<CUInt>, blockZ<CUInt>,
                  kernelParams<Int>, nargs<Int>)<CInt>
}

u8(s<String>, o<Int>)<Int> -> { return (s.char_at(o) as Int) & 255 }
strchr(s<String>, nd<Int>, st<Int>)<Int> -> {
    i<Int> = st
    for (i in st..s.len() - 1) {
        if ((s.char_at(i) as Int) == nd) { return i }
    }
    return -1
}
parse_u(s<String>, frm<Int>, endp<Int>)<Int> -> {
    a<Int> = 0
    i<Int> = frm
    for (i in frm..endp - 1) {
        c<Int> = (s.char_at(i) as Int)
        if (c >= 48) {
            if (c <= 57) { a = a * 10 + (c - 48) }
        }
    }
    return a
}
# A whitespace-separated id list -> a Vec, for VYB_PROMPT_IDS: the caller then supplies the EXACT
# tokens to embed, with no tokenizer in the path. A gate uses it to run a captured fixture's own id
# PREFIX, which is what makes causal-path coverage sound for any prompt — guessing a text prefix
# ("The cap") can tokenize to a different id sequence while keeping the same token count.
parse_ids(s<String>)<Vec<Int>> -> {
    v<Vec<Int>> = Vec()
    n<Int> = s.len()
    cur<Int> = -1
    i<Int> = 0
    for (i in 0..n - 1) {
        c<Int> = (s.char_at(i) as Int)
        if (c >= 48) {
            if (c <= 57) {
                if (cur < 0) { cur = 0 }
                cur = cur * 10 + (c - 48)
            }
        } else {
            if (cur >= 0) { v.push(cur) ; cur = -1 }
        }
    }
    if (cur >= 0) { v.push(cur) }
    return v
}
parse_numel(s<String>, frm<Int>, endp<Int>)<Int> -> {
    n<Int> = 1
    seg<Int> = frm
    i<Int> = frm
    for (i in frm..endp - 1) {
        if ((s.char_at(i) as Int) == 120) {
            n = n * parse_u(s, seg, i)
            seg = i + 1
        }
    }
    n = n * parse_u(s, seg, endp)
    return n
}
packed_bytes(numel<Int>, ty<Int>)<Int> -> {
    if (ty == 12) { return numel * 144 / 256 }
    if (ty == 13) { return numel * 176 / 256 }
    if (ty == 14) { return numel * 210 / 256 }
    # W1: Ridge's FFN types. IQ2_S is 82 bytes per 256 values (160 tensors, 4.25 GiB — the mid-stack
    # FFN), IQ3_S 110 (32 tensors, 1.14 GiB — the edge layers' FFN). These are NOT optional: without
    # them the loader falls through to the 4-bytes-per-element F32 rule below and stages garbage,
    # because a packed tensor is shorter than numel*4 and the fall-through reads whatever follows it
    # — a wrong block that still has plausible magnitudes, which is why the probe gate compares the
    # STAGED OPERAND and not only the stages computed from it.
    if (ty == 22) { return numel * 82 / 256 }     # IQ2_S  (native/kernels/iq2s.vyb)
    if (ty == 21) { return numel * 110 / 256 }    # IQ3_S  (native/kernels/iq3s.vyb)
    return numel * 4
}
find_nm(nmv<Vec<String>>, nm<String>)<Int> -> {
    i<Int> = 0
    for (i in 0..nmv.len() - 1) {
        if (nmv.get(i) == nm) { return i }
    }
    return -1
}

download(data<String>, dst<Int>, nbytes<Int>)<Int> -> {
    freedom {
        # Bulk HtoD from the String's raw {ptr,len} (srcHost declared CString); the
        # per-8-byte loop was the DMA hotspot. Non-pinned Vyb buffer + null-stream
        # async needs cuCtxSynchronize() to order DMA reads before `data` is reused
        # (one driver call per tensor).
        if (cuMemcpyHtoDAsync_v2(dst, data, nbytes, 0) != 0) { return 15 }
        cuCtxSynchronize()
        return 0
    }
    return 0
}

read_model(path<String>, off<Int>, nbytes<Int>)<String> -> {
    r<String> = ""
    match (open_read(path)) {
        f -> {
            match (read_at(f, off, nbytes)) { s -> { r = s } ? -> { r = "" } }
            close(f)
        }
        ? -> { r = "" }
    }
    return r
}
read_bin(path<String>)<String> -> {
    r<String> = ""
    match (open_read(path)) {
        f -> {
            match (read_all(f)) { s -> { r = s } ? -> { r = "" } }
            close(f)
        }
        ? -> { r = "" }
    }
    return r
}

// in-dim (the kernel's `z` arg): >0 transposes the whole-matrix write. GGUF stores 2D weights
// out-major, so every real weight matrix needs its own in-dim here (Wq/Wk/Wv→D, Wo→NQ,
// Wg/Wu→D, Wd→FF); 1D norms take the load_norm path and need nothing.
load_quant(path<String>, dpack<Int>, dout<Int>, off<Int>, nb<Int>, numel<Int>, hq<loc<CVoid>>, inz<Int>)<Int> -> {
    data<String> = read_model(path, off, nb)
    if (data.len() < nb) { return 32 }
    freedom {
        e<Int> = download(data, dpack, nb)
        if (e != 0) { return e }
        rc<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(hq)), (numel + 255) / 256, 1, 1, 256, 1, 1, dpack, dout, numel, inz)
        if (rc != 0) { return 33 }
        return 0
    }
    return 0
}
load_norm(path<String>, pf<Int>, dpack<Int>, dout<Int>, off<Int>, numel<Int>, he<loc<CVoid>>)<Int> -> {
    data<String> = read_model(path, off, numel * 4)
    if (data.len() < numel * 4) { return 32 }
    freedom {
        e<Int> = download(data, dpack, numel * 4)
        if (e != 0) { return e }
        cuMemcpyHtoD_v2(pf + 0, loc(dpack), 8)
        cuMemcpyHtoD_v2(pf + 8, loc(dout), 8)
        cuMemcpyHtoD_v2(pf + 16, loc(numel), 8)
        rc<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(he)), (numel + 255) / 256, 1, 1, 256, 1, 1, pf, 0, 0, 0)
        if (rc != 0) { return 33 }
        return 0
    }
    return 0
}

// ───────── W2: the untied head, and the embed that cannot share its table ─────────
// One embedding ROW, straight out of the model's own table: just that row's packed blocks
// (D/256 of them), dequantised into `dst` as D f64 values, row-major. NO transpose — this is a
// gather, not a weight, so the kernel's z stays 0.
//
// It exists because an untied model's token table cannot be materialised whole: Ridge's is
// 248320 x 5120 Q6_K, i.e. 10.2 GB as f64, and an untied model needs a SECOND table of that size for
// the head — neither fits the 3090 beside the weights. The dense path's `emb_dequant` (whole table
// into DE, then a gather kernel) is kept unchanged for a tied model, so `make prefill` is byte-for-byte
// unaffected. Q6_K only, asserted: that is what Qwen ships for both the token table and the head.
emb_row(path<String>, off<Int>, tid<Int>, D<Int>, ty<Int>, dpk<Int>, q6fn<loc<CVoid>>, dst<Int>)<Int> -> {
    if (ty != 14) { return 62 }
    if (D % 256 != 0) { return 62 }
    nblk<Int> = D / 256
    data<String> = read_model(path, off + tid * nblk * 210, nblk * 210)
    if (data.len() < nblk * 210) { return 32 }
    freedom {
        e<Int> = download(data, dpk, nblk * 210)
        if (e != 0) { return e }
        rc<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(q6fn)), (D + 255) / 256, 1, 1, 256, 1, 1, dpk, dst, D, 0)
        if (rc != 0) { return 33 }
        return 0
    }
    return 0
}

// ───────── W1: the GRID-TABLE dequant path (IQ2_S / IQ3_S) ─────────
// These two codecs carry their codebook as an ordinary FIFTH kernel argument (8192 B for IQ2_S's
// 1024-entry grid, 2048 B for IQ3_S's 512-entry one), so they cannot be launched with the 4-slot
// `cuda_launch4i`: they need `cuda_launch_n` (Vyb#476), which takes a caller-built array of
// argument-cell addresses. `fh` is the kernel's function handle and `gridDev` its uploaded table;
// the table is the SAME for every tensor of that type, so it is uploaded once, not per weight.
// Everything else — read the raw bytes out of the GGUF, stage them, the transposing write — is the
// same as `load_quant`; `inz` is the tensor's IN dim exactly as there (gate/up: D, down: FF).
load_quant_grid(path<String>, dpk<Int>, dout<Int>, off<Int>, nb<Int>, numel<Int>, fh<Int>, gridDev<Int>, inz<Int>)<Int> -> {
    data<String> = read_model(path, off, nb)
    if (data.len() < nb) { return 32 }
    freedom {
        e<Int> = download(data, dpk, nb)
        if (e != 0) { return e }
        # The kernel's five arguments live in these cells and `params` holds their ADDRESSES; the
        # values are read at launch, so the cells are declared here and never moved. Same shape as
        # native/host/iq2_s_load_driver.vyb (which is why that driver exists: it pinned the pattern).
        gv<Int> = gridDev; qv<Int> = dpk; ov<Int> = dout; nv<Int> = numel; zv<Int> = inz
        params<[Int; 5]> = [0, 0, 0, 0, 0]
        params[0] = addr(gv)
        params[1] = addr(qv)
        params[2] = addr(ov)
        params[3] = addr(nv)
        params[4] = addr(zv)
        fnv<loc<CVoid>> = from<loc<CVoid>>(fh)
        rc<CInt> = cuda_launch_n(from<loc<CVoid>>(addr(fnv)), (numel + 255) / 256, 1, 1, 256, 1, 1, addr(params), 5)
        if (rc != 0) { return 33 }
        return 0
    }
    return 0
}

// The two grid kernels and their uploaded tables, bundled so `stage_one` can route a tensor to the
// right one without taking a fifth positional function pointer: its call sites already carry
// q4fn/q5fn/q6fn/efn, and adding two more handles plus two tables positionally is where that
// signature stops being readable. `f*` are function handles (Int, converted at launch), `g*` the
// device tables.
struct GridK { f2<Int>, g2<Int>, f3<Int>, g3<Int> }

// ───────── unit 9c: the recurrent block, on the engine's own weight path ─────────
// put_*/dump_* are the small device-side helpers the Gated DeltaNet branch needs. `dump_section`
// and `dump_slot` print machine-readable evidence for native/tools/gdn_engine_verify.py; the
// engine's normal path writes files instead, which is not what a stage comparison wants.
put_i(PD<Int>, off<Int>, v<Int>) -> {
    freedom { cuMemcpyHtoD_v2(PD + off, loc(v), 8) }
}
put_f(PD<Int>, off<Int>, v<Float>) -> {
    freedom { cuMemcpyHtoD_v2(PD + off, loc(v), 8) }
}
dump_section(base<Int>, count<Int>, pfx<String>, nm<String>) -> {
    println("DUMP " + pfx + nm + " " + count.to_string())
    acc<String> = ""
    i<Int> = 0
    for (i in 0..count - 1) {
        iv<Int> = 0
        freedom { cuMemcpyDtoH_v2(loc(iv), base + i * 8, 8) }
        acc = acc + iv.to_string() + " "
        if (i % 64 == 63) { println(acc); acc = "" }
    }
    if (count % 64 != 0) { println(acc) }
}
dump_slot(base<Int>, idx<Int>, tag<String>) -> {
    iv<Int> = 0
    freedom { cuMemcpyDtoH_v2(loc(iv), base + idx * 8, 8) }
    println("PROBE " + tag + " " + idx.to_string() + " " + iv.to_string())
}

stage_one(path<String>, nmv<Vec<String>>, ofv<Vec<Int>>, nlv<Vec<Int>>, tyv<Vec<Int>>,
          nm<String>, dpk<Int>, pf<Int>, dout<Int>,
          q4fn<loc<CVoid>>, q5fn<loc<CVoid>>, q6fn<loc<CVoid>>, efn<loc<CVoid>>, inz<Int>,
          gk<GridK>)<Int> -> {
    idx<Int> = find_nm(nmv, nm)
    if (idx < 0) { return 60 }
    off<Int> = ofv.get(idx); numel<Int> = nlv.get(idx); ty<Int> = tyv.get(idx)
    if (ty == 12) { return load_quant(path, dpk, dout, off, packed_bytes(numel, ty), numel, q4fn, inz) }
    # Q5_K (13): Ridge's attention q/k/v. Its own dequant kernel, gated bit-exact in native/legit/run_q5k_gate.sh.
    if (ty == 13) { return load_quant(path, dpk, dout, off, packed_bytes(numel, ty), numel, q5fn, inz) }
    if (ty == 14) { return load_quant(path, dpk, dout, off, packed_bytes(numel, ty), numel, q6fn, inz) }
    # W1: the grid-table types go through cuda_launch_n, not cuda_launch4i — see load_quant_grid.
    if (ty == 22) { return load_quant_grid(path, dpk, dout, off, packed_bytes(numel, ty), numel, gk.f2, gk.g2, inz) }
    if (ty == 21) { return load_quant_grid(path, dpk, dout, off, packed_bytes(numel, ty), numel, gk.f3, gk.g3, inz) }
    return load_norm(path, pf, dpk, dout, off, numel, efn)
}

emb_dequant(path<String>, off<Int>, total<Int>, dpk<Int>, q6fn<loc<CVoid>>, de<Int>)<Int> -> {
    CH<Int> = 65536
    chunks<Int> = total / CH
    c<Int> = 0
    estr<Int> = 0
    for (c in 0..chunks - 1) {
        e_start<Int> = c * CH
        byte_off<Int> = e_start / 256 * 210
        nbytes<Int> = CH / 256 * 210
        data<String> = read_model(path, off + byte_off, nbytes)
        if (data.len() < nbytes) { return 61 }
        estr = 0
        freedom {
            e<Int> = download(data, dpk, nbytes)
            if (e != 0) { estr = e }
            else {
                rc<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(q6fn)), CH / 256, 1, 1, 256, 1, 1, dpk, de + e_start * 8, CH, 0)
                if (rc != 0) { estr = 33 }
            }
        }
        if (estr != 0) { return estr }
    }
    return 0
}

// One attention half of a transformer block, on XI -> X1: attn_norm, the q/k/v projections with
// their per-head norms, rope, attention, the output projection and the residual. The FFN that
// follows it in every block is `run_ffn` — split out so a RECURRENT block (whose mixer writes the
// same X1) can use it too. The remaining parameters are the FFN's, kept for call-site compatibility.
run_layer_attn(S<Int>, D<Int>, H<Int>, KVH<Int>, HD<Int>, NROT<Int>, FF<Int>, NQ<Int>, NKV<Int>,
          EPS<Float>, XI<Int>, XO<Int>,
          gfn<loc<CVoid>>, rfn<loc<CVoid>>, rpfn<loc<CVoid>>, afn<loc<CVoid>>, sfn<loc<CVoid>>, refn<loc<CVoid>>,
          GM<Int>, RN<Int>, ATT<Int>, ROP<Int>,
          N1<Int>, DWq<Int>, DWk<Int>, DWv<Int>, Nq<Int>, Nk<Int>, DF<Int>, DWo<Int>, N2<Int>,
          DWg<Int>, DWu<Int>, DWd<Int>,
          XN<Int>, DQ<Int>, DK<Int>, DV<Int>, DQN<Int>, DKN<Int>, DQr<Int>, DKr<Int>,
          DCtx<Int>, DO<Int>, X1<Int>, X1N<Int>, Gr<Int>, Up<Int>, Hu<Int>, M<Int>)<Int> -> {
    freedom {
        AF<Float> = 1.0; BF<Float> = 0.0
        zro<Int> = 0
        rA<Int> = XI; rB<Int> = N1; rC<Int> = XN
        cuMemcpyHtoD_v2(RN + 0, loc(rA), 8); cuMemcpyHtoD_v2(RN + 8, loc(rB), 8); cuMemcpyHtoD_v2(RN + 16, loc(rC), 8)
        cuMemcpyHtoD_v2(RN + 24, loc(S), 8); cuMemcpyHtoD_v2(RN + 32, loc(D), 8); cuMemcpyHtoD_v2(RN + 40, loc(EPS), 8)
        cuda_launch4i(from<loc<CVoid>>(addr(rfn)), (S * D + 255) / 256, 1, 1, 256, 1, 1, RN, 0, 0, 0)

        gA<Int> = XN; gB<Int> = DWq; gC<Int> = DQ; gM<Int> = S; gN<Int> = NQ; gK<Int> = D
        cuMemcpyHtoD_v2(GM + 0, loc(gA), 8); cuMemcpyHtoD_v2(GM + 8, loc(gB), 8); cuMemcpyHtoD_v2(GM + 16, loc(gC), 8)
        cuMemcpyHtoD_v2(GM + 24, loc(gM), 8); cuMemcpyHtoD_v2(GM + 32, loc(gN), 8); cuMemcpyHtoD_v2(GM + 40, loc(gK), 8)
        cuMemcpyHtoD_v2(GM + 48, loc(AF), 8); cuMemcpyHtoD_v2(GM + 56, loc(BF), 8)
        cuda_launch4i(from<loc<CVoid>>(addr(gfn)), (gM * gN + 255) / 256, 1, 1, 256, 1, 1, GM, 0, 0, 0)
        gA = XN; gB = DWk; gC = DK; gM = S; gN = NKV; gK = D
        cuMemcpyHtoD_v2(GM + 0, loc(gA), 8); cuMemcpyHtoD_v2(GM + 8, loc(gB), 8); cuMemcpyHtoD_v2(GM + 16, loc(gC), 8)
        cuMemcpyHtoD_v2(GM + 24, loc(gM), 8); cuMemcpyHtoD_v2(GM + 32, loc(gN), 8); cuMemcpyHtoD_v2(GM + 40, loc(gK), 8)
        cuMemcpyHtoD_v2(GM + 48, loc(AF), 8); cuMemcpyHtoD_v2(GM + 56, loc(BF), 8)
        cuda_launch4i(from<loc<CVoid>>(addr(gfn)), (gM * gN + 255) / 256, 1, 1, 256, 1, 1, GM, 0, 0, 0)
        gA = XN; gB = DWv; gC = DV; gM = S; gN = NKV; gK = D
        cuMemcpyHtoD_v2(GM + 0, loc(gA), 8); cuMemcpyHtoD_v2(GM + 8, loc(gB), 8); cuMemcpyHtoD_v2(GM + 16, loc(gC), 8)
        cuMemcpyHtoD_v2(GM + 24, loc(gM), 8); cuMemcpyHtoD_v2(GM + 32, loc(gN), 8); cuMemcpyHtoD_v2(GM + 40, loc(gK), 8)
        cuMemcpyHtoD_v2(GM + 48, loc(AF), 8); cuMemcpyHtoD_v2(GM + 56, loc(BF), 8)
        cuda_launch4i(from<loc<CVoid>>(addr(gfn)), (gM * gN + 255) / 256, 1, 1, 256, 1, 1, GM, 0, 0, 0)

        rA = DQ; rB = Nq; rC = DQN; gM = S * H; gN = HD
        cuMemcpyHtoD_v2(RN + 0, loc(rA), 8); cuMemcpyHtoD_v2(RN + 8, loc(rB), 8); cuMemcpyHtoD_v2(RN + 16, loc(rC), 8)
        cuMemcpyHtoD_v2(RN + 24, loc(gM), 8); cuMemcpyHtoD_v2(RN + 32, loc(gN), 8); cuMemcpyHtoD_v2(RN + 40, loc(EPS), 8)
        cuda_launch4i(from<loc<CVoid>>(addr(rfn)), (S * H * HD + 255) / 256, 1, 1, 256, 1, 1, RN, 0, 0, 0)
        rA = DK; rB = Nk; rC = DKN; gM = S * KVH; gN = HD
        cuMemcpyHtoD_v2(RN + 0, loc(rA), 8); cuMemcpyHtoD_v2(RN + 8, loc(rB), 8); cuMemcpyHtoD_v2(RN + 16, loc(rC), 8)
        cuMemcpyHtoD_v2(RN + 24, loc(gM), 8); cuMemcpyHtoD_v2(RN + 32, loc(gN), 8); cuMemcpyHtoD_v2(RN + 40, loc(EPS), 8)
        cuda_launch4i(from<loc<CVoid>>(addr(rfn)), (S * KVH * HD + 255) / 256, 1, 1, 256, 1, 1, RN, 0, 0, 0)

        # rope_nrot's layout (native/kernels/rope.vyb): +0 Q, +8 K, +16 Qd, +24 Kd, +32 FR, +40 S,
        # +48 HD, +56 H, +64 KVH, +72 POS, +80 NROT. ROP is 232 B and nothing else reads its low
        # half, so the variant reuses the block.
        cuMemcpyHtoD_v2(ROP + 0, loc(DQN), 8); cuMemcpyHtoD_v2(ROP + 8, loc(DKN), 8)
        cuMemcpyHtoD_v2(ROP + 16, loc(DQr), 8); cuMemcpyHtoD_v2(ROP + 24, loc(DKr), 8)
        cuMemcpyHtoD_v2(ROP + 32, loc(DF), 8); cuMemcpyHtoD_v2(ROP + 40, loc(S), 8)
        cuMemcpyHtoD_v2(ROP + 48, loc(HD), 8); cuMemcpyHtoD_v2(ROP + 56, loc(H), 8); cuMemcpyHtoD_v2(ROP + 64, loc(KVH), 8)
        cuMemcpyHtoD_v2(ROP + 72, loc(zro), 8)      # POS base = 0
        cuMemcpyHtoD_v2(ROP + 80, loc(NROT), 8)     # how many of each head's dims rotate
        rope_total<Int> = S * H * HD + S * KVH * HD
        cuda_launch4i(from<loc<CVoid>>(addr(rpfn)), (rope_total + 255) / 256, 1, 1, 256, 1, 1, ROP, 0, 0, 0)

        cuMemcpyHtoD_v2(ATT + 80, loc(DQr), 8); cuMemcpyHtoD_v2(ATT + 88, loc(DKr), 8)
        cuMemcpyHtoD_v2(ATT + 96, loc(DV), 8); cuMemcpyHtoD_v2(ATT + 104, loc(DCtx), 8)
        cuMemcpyHtoD_v2(ATT + 184, loc(S), 8); cuMemcpyHtoD_v2(ATT + 200, loc(HD), 8)
        cuMemcpyHtoD_v2(ATT + 208, loc(H), 8); cuMemcpyHtoD_v2(ATT + 216, loc(KVH), 8)
        cuda_launch4i(from<loc<CVoid>>(addr(afn)), (S * H + 255) / 256, 1, 1, 256, 1, 1, ATT, 0, 0, 0)

        gA = DCtx; gB = DWo; gC = DO; gM = S; gN = D; gK = NQ
        cuMemcpyHtoD_v2(GM + 0, loc(gA), 8); cuMemcpyHtoD_v2(GM + 8, loc(gB), 8); cuMemcpyHtoD_v2(GM + 16, loc(gC), 8)
        cuMemcpyHtoD_v2(GM + 24, loc(gM), 8); cuMemcpyHtoD_v2(GM + 32, loc(gN), 8); cuMemcpyHtoD_v2(GM + 40, loc(gK), 8)
        cuMemcpyHtoD_v2(GM + 48, loc(AF), 8); cuMemcpyHtoD_v2(GM + 56, loc(BF), 8)
        cuda_launch4i(from<loc<CVoid>>(addr(gfn)), (gM * gN + 255) / 256, 1, 1, 256, 1, 1, GM, 0, 0, 0)
        cuda_launch4i(from<loc<CVoid>>(addr(refn)), (S * D + 255) / 256, 1, 1, 256, 1, 1, XI, DO, X1, S * D)
        return 0
    }
    return 0
}

// The FFN half of a block, split out of run_layer_attn so a RECURRENT layer can feed it too: a
// Gated DeltaNet block is mixer-then-FFN, and its mixer writes the same X1 (the residual output) the
// attention branch writes, so both branches share this one implementation.
run_ffn(S<Int>, D<Int>, FF<Int>, gfn<loc<CVoid>>, rfn<loc<CVoid>>, sfn<loc<CVoid>>, refn<loc<CVoid>>,
        GM<Int>, RN<Int>, EPS<Float>, X1<Int>, N2<Int>, DWg<Int>, DWu<Int>, DWd<Int>,
        X1N<Int>, Gr<Int>, Up<Int>, Hu<Int>, M<Int>, XO<Int>)<Int> -> {
    freedom {
        AF<Float> = 1.0; BF<Float> = 0.0
        gA<Int> = 0; gB<Int> = 0; gC<Int> = 0; gM<Int> = 0; gN<Int> = 0; gK<Int> = 0
        rA<Int> = X1; rB<Int> = N2; rC<Int> = X1N
        cuMemcpyHtoD_v2(RN + 0, loc(rA), 8); cuMemcpyHtoD_v2(RN + 8, loc(rB), 8); cuMemcpyHtoD_v2(RN + 16, loc(rC), 8)
        cuMemcpyHtoD_v2(RN + 24, loc(S), 8); cuMemcpyHtoD_v2(RN + 32, loc(D), 8); cuMemcpyHtoD_v2(RN + 40, loc(EPS), 8)
        cuda_launch4i(from<loc<CVoid>>(addr(rfn)), (S * D + 255) / 256, 1, 1, 256, 1, 1, RN, 0, 0, 0)

        gA = X1N; gB = DWg; gC = Gr; gM = S; gN = FF; gK = D
        cuMemcpyHtoD_v2(GM + 0, loc(gA), 8); cuMemcpyHtoD_v2(GM + 8, loc(gB), 8); cuMemcpyHtoD_v2(GM + 16, loc(gC), 8)
        cuMemcpyHtoD_v2(GM + 24, loc(gM), 8); cuMemcpyHtoD_v2(GM + 32, loc(gN), 8); cuMemcpyHtoD_v2(GM + 40, loc(gK), 8)
        cuMemcpyHtoD_v2(GM + 48, loc(AF), 8); cuMemcpyHtoD_v2(GM + 56, loc(BF), 8)
        cuda_launch4i(from<loc<CVoid>>(addr(gfn)), (gM * gN + 255) / 256, 1, 1, 256, 1, 1, GM, 0, 0, 0)
        gA = X1N; gB = DWu; gC = Up; gM = S; gN = FF; gK = D
        cuMemcpyHtoD_v2(GM + 0, loc(gA), 8); cuMemcpyHtoD_v2(GM + 8, loc(gB), 8); cuMemcpyHtoD_v2(GM + 16, loc(gC), 8)
        cuMemcpyHtoD_v2(GM + 24, loc(gM), 8); cuMemcpyHtoD_v2(GM + 32, loc(gN), 8); cuMemcpyHtoD_v2(GM + 40, loc(gK), 8)
        cuMemcpyHtoD_v2(GM + 48, loc(AF), 8); cuMemcpyHtoD_v2(GM + 56, loc(BF), 8)
        cuda_launch4i(from<loc<CVoid>>(addr(gfn)), (gM * gN + 255) / 256, 1, 1, 256, 1, 1, GM, 0, 0, 0)
        cuda_launch4i(from<loc<CVoid>>(addr(sfn)), (S * FF + 255) / 256, 1, 1, 256, 1, 1, Gr, Up, Hu, S * FF)

        gA = Hu; gB = DWd; gC = M; gM = S; gN = D; gK = FF
        cuMemcpyHtoD_v2(GM + 0, loc(gA), 8); cuMemcpyHtoD_v2(GM + 8, loc(gB), 8); cuMemcpyHtoD_v2(GM + 16, loc(gC), 8)
        cuMemcpyHtoD_v2(GM + 24, loc(gM), 8); cuMemcpyHtoD_v2(GM + 32, loc(gN), 8); cuMemcpyHtoD_v2(GM + 40, loc(gK), 8)
        cuMemcpyHtoD_v2(GM + 48, loc(AF), 8); cuMemcpyHtoD_v2(GM + 56, loc(BF), 8)
        cuda_launch4i(from<loc<CVoid>>(addr(gfn)), (gM * gN + 255) / 256, 1, 1, 256, 1, 1, GM, 0, 0, 0)
        cuda_launch4i(from<loc<CVoid>>(addr(refn)), (S * D + 255) / 256, 1, 1, 256, 1, 1, X1, M, XO, S * D)
        return 0
    }
    return 0
}

main()<Int> -> {
    # ---- prompt source --------------------------------------------------------
    # VYB_PROMPT_RAW=1  -> the synthetic 2-token prefix [0,1]. No tokenizer, no chat
    #   template, no text. This is what the NUMERIC gate uses (`make prefill`),
    #   because its numpy reference (prefill_ref.py) is built for exactly that
    #   prefix. Its decoded "response" is meaningless BY CONSTRUCTION: the input is
    #   the two characters  !"  so the model is guessing with no context at all and
    #   no language is being asked of it -- the argmax there is the top of a nearly
    #   flat distribution (p ~= 0.015), so it can be a Chinese fragment or an
    #   English word interchangeably. Read the hidden comparison, not the text.
    # VYB_PROMPT=<text> -> a real prompt, ids from the model's own tokenizer.
    # default           -> DEFAULT_PROMPT, a real English sentence, so a bare run
    #                      and the chat gates read as an actual conversation.
    prids<Vec<Int>> = Vec()
    praw<String> = env_get("VYB_PROMPT_RAW") else ""
    pstr<String> = env_get("VYB_PROMPT") else "The capital of France is"
    if (praw.len() > 0) {
        prids.push(0); prids.push(1)
        println("PROMPT_MODE=synthetic PROMPT_N=2 PROMPT_NOTE=input is the characters !\" -- no tokenizer, no chat template; the decoded response is gibberish by construction, compare the hidden output instead")
    } else {
        pids<String> = env_get("VYB_PROMPT_IDS") else ""
        if (pids.len() > 0) {
            # An explicit id sequence. No tokenizer, and nothing left to interpret: the ids printed
            # below ARE the run's input, which is what a prefix-coverage gate needs.
            prids = parse_ids(pids)
            println("PROMPT_MODE=ids PROMPT_N=" + prids.len().to_string())
        } else {
        m0<Model> = llm_load("qwen3", env_get("VYB_LLM_DIR") else "artifacts/vybos-configurator-lora")
        prids = llm_encode(m0, pstr)
        println("PROMPT_MODE=text PROMPT_SRC=<" + pstr + "> PROMPT_N=" + prids.len().to_string())
        }
    }
    # ---- W4: the MTP draft head (VYB_MTP=1) ----
    # The draft head consumes the NORMALISED hidden at position t plus the embedding of token t+1 and
    # predicts t+2 (llama.cpp's MTP hook batch carries both the next-token id and the `h_nextn` row),
    # so there is one step per position 0..S-2 and the rest of the driver sees that STEP COUNT as S.
    # The block itself is the ordinary attention block of the last file block (blk.NTL) — it runs on
    # the loop's own dispatch and staging, so nothing inside the block changes; only its input does.
    mtps<String> = env_get("VYB_MTP") else ""
    MTPM<Int> = 0
    if (mtps.len() > 0) { MTPM = 1 }
    if (MTPM == 1) {
        if (prids.len() < 3) { println("MTP_ERR the draft head needs at least 3 prompt tokens"); return 2 }
        mtr<Vec<Int>> = Vec()
        mti<Int> = 0
        for (mti in 0..prids.len() - 2) { mtr.push(prids.get(mti + 1)) }
        prids = mtr
    }
    S<Int> = prids.len()
    # Print the ACTUAL ids, not just the count: the oracle fixtures are keyed by token ids, so a
    # verifier can prove the run it is reading embedded the fixture's own id sequence (or a PREFIX of
    # it, when a gate deliberately runs a shorter prompt). Without this a log is only self-described —
    # and a prompt whose text was edited would still report the right token COUNT.
    ids_str<String> = ""
    iid<Int> = 0
    for (iid in 0..S - 1) {
        ids_str = ids_str + prids.get(iid).to_string()
        if (iid < S - 1) { ids_str = ids_str + " " }
    }
    println("PROMPT_IDS=" + ids_str)
    hm<String> = env_get("HOME") else "."
    # VYB_MODEL / VYB_TSV override the model and its tensor index (the unit 9c probe points them at
    # the Ridge GGUF and its generated index); VYBFORGE_QWEN3_GGUF stays the default so the existing
    # make targets are unaffected.
    MODEL<String> = env_get("VYB_MODEL") else (env_get("VYBFORGE_QWEN3_GGUF") else hm + "/Models/qwen3/Qwen3-4B-Q4_K_M.gguf")
    # ---- S0.2: every dimension is read from the model's OWN config, not spelled here ----
    cfg<ModelConfig> = mc_load(MODEL)
    if (!mc_is_ok(cfg)) {
        println("CFG_FAIL=" + cfg.arch + " check=" + cfg.notes)
        return 2
    }
    println("CFG_SRC=" + cfg.source + " arch=" + cfg.arch + " kind=" + cfg.kind)
    println("CFG_DERIVED=<" + cfg.derived + "> CFG_DEFAULTED=<" + cfg.defaulted + ">")
    if (cfg.notes.len() > 0) { println("CFG_NOTES=<" + cfg.notes + ">") }
    D<Int> = cfg.hidden; H<Int> = cfg.heads; KVH<Int> = cfg.kv_heads; HD<Int> = cfg.head_dim
    FF<Int> = cfg.ffn; NQ<Int> = mc_nq(cfg); NKV<Int> = mc_nkv(cfg); VOCAB<Int> = cfg.vocab
    MAXL<Int> = cfg.n_layers; DOLM<Int> = 1     # full depth + tied lm_head
    EPS<Float> = cfg.rms_eps
    println("DIMS S=" + S.to_string() + " D=" + D.to_string() + " H=" + H.to_string()
            + " KVH=" + KVH.to_string() + " HD=" + HD.to_string() + " FF=" + FF.to_string()
            + " NQ=" + NQ.to_string() + " NKV=" + NKV.to_string() + " VOCAB=" + VOCAB.to_string()
            + " MAXL=" + MAXL.to_string() + " EPS=" + EPS.to_string())
    # ---- unit 10 step 5: the ATTENTION-block probe selector (VYB_ATTN_PROBE=<layer index>) ----
    # Empty (the normal case) runs the model. A layer index runs ONLY that attention block, with the
    # block's input taken from a fixture instead of the embedding, and dumps the ten stages the
    # authority (native/tools/attn_authority.c) produces — the same shape as the recurrent probe
    # below. S comes from the FIXTURE's own length (S = len / (D*8)), so one file sets the token
    # count; the fixture is the block INPUT (attn_norm runs inside the driver, as it does in the
    # loop), and its bits are compared as f64, like every other dump here.
    aps<String> = env_get("VYB_ATTN_PROBE") else ""
    APR<Int> = -1
    if (aps.len() > 0) { APR = parse_u(aps, 0, aps.len()) }
    afx<String> = ""
    if (APR >= 0) {
        afx = read_bin(env_get("VYB_ATTN_X") else "native/build/attn_engine_x.bin")
        if (afx.len() < D * 8) { println("ATTN_ERR no fixture to probe the attention block with"); return 2 }
        S = afx.len() / (D * 8)
        println("ATTN_PROBE_INPUT fixture_tokens=" + S.to_string())
    }
    # ---- W1: the FFN-block probe selector (VYB_FFN_PROBE=<layer index>) ----
    # Empty (the normal case) runs the model. A layer index runs ONLY that block's FFN half — the
    # shared code path a whole-model run uses (native/host/model_driver.vyb's run_ffn, called at the
    # bottom of both the recurrent and the attention branch) — with the block's residual-stream input
    # taken from a fixture instead of from the mixer. It exists because every Ridge block's FFN is
    # IQ2_S or IQ3_S, which no engine path could stage before W1; the probe is the acceptance check
    # for the staging path, not a side harness (the loop calls this same code once per token).
    ffs<String> = env_get("VYB_FFN_PROBE") else ""
    FR<Int> = -1
    if (ffs.len() > 0) { FR = parse_u(ffs, 0, ffs.len()) }
    ffx<String> = ""
    if (FR >= 0) {
        ffx = read_bin(env_get("VYB_FFN_X") else "native/build/ffn_engine_x.bin")
        if (ffx.len() < D * 8) { println("FFN_ERR no fixture to probe the FFN block with"); return 2 }
        S = ffx.len() / (D * 8)
        println("FFN_PROBE_INPUT fixture_tokens=" + S.to_string())
    }
    # Shapes (in elements) as the tensor core wants them; every buffer below is one call.
    SD<Vec<Int>> = Vec(); SD.push(S); SD.push(D)
    SQ<Vec<Int>> = Vec(); SQ.push(S); SQ.push(NQ)
    SQ2<Vec<Int>> = Vec(); SQ2.push(S); SQ2.push(2 * NQ)
    SK<Vec<Int>> = Vec(); SK.push(S); SK.push(NKV)
    SF<Vec<Int>> = Vec(); SF.push(S); SF.push(FF)
    SV<Vec<Int>> = Vec(); SV.push(S); SV.push(VOCAB)
    D1<Vec<Int>> = Vec(); D1.push(D)
    S1<Vec<Int>> = Vec(); S1.push(S)
    TSV<String> = env_get("VYB_TSV") else "native/out/qwen3_4b_tensors.tsv"
    AF<Float> = 1.0; BF<Float> = 0.0
    rA<Int> = 0; rB<Int> = 0; rC<Int> = 0
    gA<Int> = 0; gB<Int> = 0; gC<Int> = 0; gM<Int> = 0; gN<Int> = 0; gK<Int> = 0

    nmv<Vec<String>> = Vec(); tyv<Vec<Int>> = Vec(); nlv<Vec<Int>> = Vec(); ofv<Vec<Int>> = Vec()
    bff<String> = read_bin(TSV)
    ln<Int> = bff.len(); st<Int> = 0; i<Int> = 0
    for (i in 0..ln - 1) {
        if ((bff.char_at(i) as Int) == 10) {
            t1<Int> = strchr(bff, 9, st)
            if (t1 >= st) {
                t2<Int> = strchr(bff, 9, t1 + 1)
                if (t2 < 0) { t2 = i }
                nm<String> = bff.substring(st, t1)
                keep<Int> = 0
                if (nm.substring(0, 4) == "blk.") { keep = 1 }
                if (nm == "output_norm.weight") { keep = 1 }
                if (nm == "token_embd.weight") { keep = 1 }
                # W2: the UNTIED head's own table. mc_load derives cfg.tied from this tensor's
                # presence, and the chunked head path stages its bytes by offset, so it has to survive
                # the index filter.
                if (nm == "output.weight") { keep = 1 }
                if (keep == 1) {
                    t3<Int> = strchr(bff, 9, t2 + 1)
                    if (t3 < 0) { t3 = i }
                    t4<Int> = strchr(bff, 9, t3 + 1)
                    if (t4 < 0) { t4 = i }
                    nmv.push(nm)
                    tyv.push(parse_u(bff, t2 + 1, t3))
                    nlv.push(parse_numel(bff, t1 + 1, t2))
                    ofv.push(parse_u(bff, t3 + 1, t4))
                }
            }
            st = i + 1
        }
    }
    println("TSV_ALL_TENSORS=" + nmv.len().to_string() + " (expect 398)")
    if (nmv.len() < 396) { println("TSV_PARSE_FAIL"); return 2 }

    # ---- unit 9c: the recurrent-block probe selector (VYB_GDN_PROBE=<layer index>) ----
    # Empty (the normal case) runs the model; a layer index runs only THAT block, with the input
    # taken from a fixture file instead of the embedding — so the probe exercises the loop's own
    # dispatch, staging, state cache and chain, not a copy of them.
    prs<String> = env_get("VYB_GDN_PROBE") else ""
    PR<Int> = -1
    if (prs.len() > 0) { PR = parse_u(prs, 0, prs.len()) }

    # ---- optional per-block TRACE (VYB_RIDGE_TRACE=1) ----
    # Writes the FIRST THREE components of every token's hidden AFTER each block to
    # native/out/ridge_trace_L<L>.txt. Three because that is exactly what llama.cpp's own
    # `llama-eval-callback` example prints per tensor dimension (common_debug_print_tensor(..., 3, ...)),
    # so the two traces compare directly and the FIRST block that diverges is visible in one run —
    # a whole-model cosine says the forward is wrong, it cannot say WHERE. Default off: no gate sees it.
    trs<String> = env_get("VYB_RIDGE_TRACE") else ""
    LTR<Int> = 0
    if (trs.len() > 0) { LTR = 1 }

    # ---- unit 9c: the recurrent geometry, and whether this model has recurrent blocks at all ----
    # Decided from the TENSOR TABLE (the same rule the loop dispatches on), never from the model
    # name; a dense model leaves GRL at -1 and the recurrent path is never entered or allocated.
    GRL<Int> = -1
    GL<Int> = 0
    for (GL in 0..MAXL - 1) {
        if (GRL < 0) {
            # mc_layer_kind classifies a NAME — "what kind is this tensor" — it does NOT answer "does
            # this tensor exist", and every constructed name ends with the marker, so a bare kind test
            # calls a DENSE model recurrent. Measured: it did, and the dense regression failed with
            # GDN_CFG_FAIL. Presence comes from the tensor table; the kind says what a present tensor
            # means. Always pair the two.
            if (find_nm(nmv, "blk." + GL.to_string() + ".ssm_alpha.weight") >= 0) {
                if (mc_layer_kind("blk." + GL.to_string() + ".ssm_alpha.weight") == 2) { GRL = GL }
            }
        }
    }
    GNE<Int> = 0; GSS<Int> = 0; GHK<Int> = 0; GHV<Int> = 0
    GDC<Int> = 0; GQKV<Int> = 0; GVALUE<Int> = 0; GKEY<Int> = 0
    GRQKV<Int> = 0
    if (GRL >= 0) {
        gp<String> = "blk." + GRL.to_string() + "."
        gi_an<Int> = find_nm(nmv, gp + "attn_norm.weight")
        gi_qk<Int> = find_nm(nmv, gp + "attn_qkv.weight")
        gi_ga<Int> = find_nm(nmv, gp + "attn_gate.weight")
        gi_al<Int> = find_nm(nmv, gp + "ssm_alpha.weight")
        gi_ou<Int> = find_nm(nmv, gp + "ssm_out.weight")
        gi_cw<Int> = find_nm(nmv, gp + "ssm_conv1d.weight")
        gi_sn<Int> = find_nm(nmv, gp + "ssm_norm.weight")
        gi_aa<Int> = find_nm(nmv, gp + "ssm_a")
        if (gi_an < 0 || gi_qk < 0 || gi_ga < 0 || gi_al < 0 || gi_ou < 0
            || gi_cw < 0 || gi_sn < 0 || gi_aa < 0) {
            println("GDN_CFG_FAIL the first recurrent block " + gp + " is missing a tensor")
            return 2
        }
        GNE = nlv.get(gi_an)
        GHV = nlv.get(gi_aa)
        GVALUE = nlv.get(gi_ga) / GNE
        GQKV = nlv.get(gi_qk) / GNE
        GDC = nlv.get(gi_cw) / GQKV
        GSS = nlv.get(gi_sn)
        GHK = (GQKV - GVALUE) / (2 * GSS)
        GKEY = GHK * GSS
        if (GVALUE != GHV * GSS || GQKV != 2 * GKEY + GVALUE || nlv.get(gi_ou) != GNE * GVALUE
            || nlv.get(gi_cw) != GQKV * GDC || nlv.get(gi_al) != GNE * GHV) {
            println("GDN_CFG_FAIL " + gp + " tensor shapes are not a consistent recurrent block")
            return 2
        }
        println("GDN_CFG first_recurrent=" + GRL.to_string() + " NE=" + GNE.to_string()
                + " S=" + GSS.to_string() + " Hk=" + GHK.to_string() + " Hv=" + GHV.to_string()
                + " d_conv=" + GDC.to_string() + " qkv=" + GQKV.to_string()
                + " value=" + GVALUE.to_string() + " hidden=" + D.to_string())
        if (GNE != D) {
            println("GDN_CFG_FAIL the recurrent block's width != the model's hidden size")
            return 2
        }
    }

    # ---- unit 10 step 5: does this model's attention carry a FOLDED output gate? ----
    # Decided from the TENSOR TABLE (attn_q's own element count), never from the arch name: a dense
    # model's attn_q is (heads*head_dim, D) = NQ*D elements, while qwen35's carries per head a q
    # block AND a gate block, so it is 2*NQ*D (Ridge: 12288 x 5120). The loop then dispatches on
    # this flag, exactly as it dispatches on the layer KIND for the recurrent blocks.
    JQG<Int> = 0
    fj<Int> = 0
    for (fj in 0..MAXL - 1) {
        if (JQG == 0) {
            if (fj > 0) {
                ji<Int> = find_nm(nmv, "blk." + fj.to_string() + ".attn_q.weight")
                if (ji >= 0) {
                    if (mc_layer_kind("blk." + fj.to_string() + ".attn_q.weight") == 1) {
                        if (nlv.get(ji) == 2 * NQ * D) { JQG = 1 }
                    }
                }
            }
        }
    }
    if (GRL >= 0) { println("ATTN_CFG joint_q_gate=" + JQG.to_string() + " (1 = attn_q carries the output gate, 2*NQ*D elements)") }

    # ---- W3: how many blocks are TEXT layers ----
    # cfg.n_layers is the file's block_count, which for qwen35 INCLUDES the MTP draft head as a
    # block: Ridge has 65 blocks (blk.0..blk.64) and llama.cpp's main pass runs only blk.0..blk.63 —
    # the draft head is applied separately, to (hidden, next token), and is not part of the sequence.
    # Running it as a text layer produced a hidden that agreed with the oracle at only cos 0.55 while
    # EVERY block-level probe stayed green (the probes name a layer explicitly, so none of them ever
    # ran the boundary). The bound therefore comes from the TENSOR TABLE: the first block carrying a
    # `nextn.` tensor is the draft head, and everything before it is text. A model with no such block
    # (the dense Qwen3-4B) keeps NTL == MAXL and the loop is byte-for-byte the same as before.
    NTL<Int> = MAXL
    mj<Int> = 0
    for (mj in 0..MAXL - 1) {
        if (find_nm(nmv, "blk." + mj.to_string() + ".nextn.eh_proj.weight") >= 0) {
            if (mj < NTL) { NTL = mj }
        }
    }
    if (NTL < MAXL) {
        println("TEXT_LAYERS=" + NTL.to_string() + " of " + MAXL.to_string() + " blocks (blk."
                + NTL.to_string() + " carries the nextn tensors = the MTP draft head, which is NOT "
                + "part of the main pass; the loop stops before it)")
    }

    # ---- W2: is the head UNTIED (its own table) — and therefore is the embed table unshareable? ----
    # Decided from the model's OWN config, never from the architecture name: mc_load derives tied from
    # the tensor table (an `output.weight` present means untied; the dense Qwen3-4B has none). For an
    # untied model one f64 table costs vocab*D*8 = 10.2 GB for 248320x5120 and TWO of them do not fit
    # the 3090 beside the weights, so the embed builds only the prompt's own rows and the head runs
    # chunk by chunk. A TIED model keeps the old path exactly (whole table into DE, shared by the
    # gather and the head), so `make prefill` is untouched.
    UT<Int> = 0
    if (cfg.tied == 0) { UT = 1 }
    println("HEAD_CFG tied=" + cfg.tied.to_string() + " untied_path=" + UT.to_string()
            + " (1 = rows-only embed + chunked head, the untied-model path)")

    freedom {
        if (cuInit(0) != 0) { println("SKIP: no CUDA"); return 0 }
        var<CInt> ndev = 0
        if (cuDeviceGetCount(loc(ndev)) != 0 || ndev < 1) { println("SKIP: no CUDA device"); return 0 }
        var<CInt> dev = 0
        if (cuDeviceGet(loc(dev), 0) != 0) { return 14 }
        ctx<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuCtxCreate_v2(loc(ctx), 0, dev) != 0) { return 14 }
    }

    freedom {
        m4<loc<CVoid>> = from<loc<CVoid>>(0)
        m6<loc<CVoid>> = from<loc<CVoid>>(0)
        ml<loc<CVoid>> = from<loc<CVoid>>(0)
        mw<loc<CVoid>> = from<loc<CVoid>>(0)
        rc4<CInt> = -1
        t4<Int> = 0
        for (t4 in 0..5) { if (rc4 != 0) { m4 = from<loc<CVoid>>(0); rc4 = cuModuleLoadData(loc(m4), read_bin("native/build/q4k.ptx")) } }
        if (rc4 != 0) { println("MODLOAD_FAIL q4k"); return 9 }
        rc6<CInt> = -1
        t6<Int> = 0
        for (t6 in 0..5) { if (rc6 != 0) { m6 = from<loc<CVoid>>(0); rc6 = cuModuleLoadData(loc(m6), read_bin("native/build/q6k.ptx")) } }
        if (rc6 != 0) { println("MODLOAD_FAIL q6k"); return 9 }
        rcl<CInt> = -1
        tl<Int> = 0
        for (tl in 0..5) { if (rcl != 0) { ml = from<loc<CVoid>>(0); rcl = cuModuleLoadData(loc(ml), read_bin("native/build/layer.ptx")) } }
        if (rcl != 0) { println("MODLOAD_FAIL layer"); return 9 }
        rcw<CInt> = -1
        tw<Int> = 0
        for (tw in 0..5) { if (rcw != 0) { mw = from<loc<CVoid>>(0); rcw = cuModuleLoadData(loc(mw), read_bin("native/build/qwen3.ptx")) } }
        mrope<loc<CVoid>> = from<loc<CVoid>>(0)
        rcw2<CInt> = -1
        rcw2 = cuModuleLoadData(loc(mrope), read_bin("native/build/rope.ptx"))
        for (tw2 in 0..5) { if (rcw2 != 0) { mrope = from<loc<CVoid>>(0); rcw2 = cuModuleLoadData(loc(mrope), read_bin("native/build/rope.ptx")) } }
        if (rcw2 != 0) { println("MODLOAD_FAIL rope"); return 9 }
        if (rcw != 0) { println("MODLOAD_FAIL qwen3"); return 9 }
        q4fn<loc<CVoid>> = from<loc<CVoid>>(0)
        q6fn<loc<CVoid>> = from<loc<CVoid>>(0)
        q5fn<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(q4fn), m4, "q4kdeq") != 0) { return 10 }
        if (cuModuleGetFunction(loc(q6fn), m6, "q6kdeq") != 0) { return 10 }
        gfn<loc<CVoid>> = from<loc<CVoid>>(0)
        rfn<loc<CVoid>> = from<loc<CVoid>>(0)
        afn<loc<CVoid>> = from<loc<CVoid>>(0)
        sfn<loc<CVoid>> = from<loc<CVoid>>(0)
        refn<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(gfn), ml, "gemm") != 0) { return 10 }
        if (cuModuleGetFunction(loc(rfn), ml, "rmsnorm") != 0) { return 10 }
        if (cuModuleGetFunction(loc(afn), ml, "attn") != 0) { return 10 }
        if (cuModuleGetFunction(loc(sfn), ml, "silu") != 0) { return 10 }
        if (cuModuleGetFunction(loc(refn), ml, "resid") != 0) { return 10 }
        rpfn<loc<CVoid>> = from<loc<CVoid>>(0)
        efn<loc<CVoid>> = from<loc<CVoid>>(0)
        lsfn<loc<CVoid>> = from<loc<CVoid>>(0)
        arfn<loc<CVoid>> = from<loc<CVoid>>(0)
        emfn<loc<CVoid>> = from<loc<CVoid>>(0)
        accfn<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(rpfn), mrope, "rope_nrot") != 0) { return 10 }
        if (cuModuleGetFunction(loc(efn), mw, "f32expand") != 0) { return 10 }
        if (cuModuleGetFunction(loc(lsfn), mw, "logits_slice") != 0) { return 10 }
        if (cuModuleGetFunction(loc(arfn), mw, "argmax_row") != 0) { return 10 }
        if (cuModuleGetFunction(loc(emfn), mw, "embed") != 0) { return 10 }
        # W2: the running argmax the chunked (untied) head folds each vocab chunk into.
        if (cuModuleGetFunction(loc(accfn), mw, "argmax_acc") != 0) { return 10 }

        # ---- unit 9c: the recurrent branch's kernels, plus Q8_0 staging ----
        # gdn.ptx carries the ops the Gated DeltaNet block needs and nothing else does; q8_0.ptx the
        # dequant for its ssm_alpha/ssm_beta. Loaded here so the loop can call the branch directly.
        mq8<loc<CVoid>> = from<loc<CVoid>>(0)
        mgd<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleLoadData(loc(mq8), read_bin("native/build/q8_0.ptx")) != 0) { println("MODLOAD_FAIL q8_0"); return 9 }
        if (cuModuleLoadData(loc(mgd), read_bin("native/build/gdn.ptx")) != 0) { println("MODLOAD_FAIL gdn"); return 9 }
        q8fn<loc<CVoid>> = from<loc<CVoid>>(0)
        hsg<loc<CVoid>> = from<loc<CVoid>>(0)
        hag<loc<CVoid>> = from<loc<CVoid>>(0)
        hsv<loc<CVoid>> = from<loc<CVoid>>(0)
        hcv<loc<CVoid>> = from<loc<CVoid>>(0)
        hil<loc<CVoid>> = from<loc<CVoid>>(0)
        hsh<loc<CVoid>> = from<loc<CVoid>>(0)
        hl2<loc<CVoid>> = from<loc<CVoid>>(0)
        hds<loc<CVoid>> = from<loc<CVoid>>(0)
        hng<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(q8fn), mq8, "q8_0deq") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hsg), mgd, "sigmoid_k") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hag), mgd, "alpha_gate") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hsv), mgd, "silu_k") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hcv), mgd, "conv1d_k") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hil), mgd, "interleave_qkv") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hsh), mgd, "conv_shift") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hl2), mgd, "l2norm") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hds), mgd, "delta_step") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hng), mgd, "norm_gated") != 0) { return 10 }

        # ---- unit 10 step 5: the ATTENTION block's own kernels ----
        # q5k.ptx: the dequant for Ridge's q/k/v (Q5_K) — stage_one's ty==13 branch.
        # attn35.ptx: the joint q+gate SPLIT and the output gate (attn * sigmoid(gate)); nothing else
        # in the engine needs them. Both are loaded unconditionally (like gdn.ptx/q8_0.ptx above) and
        # built by the Makefile's KERNELS list, so a clean build has them.
        mq5<loc<CVoid>> = from<loc<CVoid>>(0)
        ma35<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleLoadData(loc(mq5), read_bin("native/build/q5k.ptx")) != 0) { println("MODLOAD_FAIL q5k"); return 9 }
        if (cuModuleLoadData(loc(ma35), read_bin("native/build/attn35.ptx")) != 0) { println("MODLOAD_FAIL attn35"); return 9 }
        if (cuModuleGetFunction(loc(q5fn), mq5, "q5kdeq") != 0) { return 10 }
        hsplit<loc<CVoid>> = from<loc<CVoid>>(0)
        hgmul<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(hsplit), ma35, "qg_split") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hgmul), ma35, "gate_mul") != 0) { return 10 }

        # ---- W1: the GRID-TABLE dequant kernels (IQ2_S / IQ3_S) ----
        # Ridge's FFN is IQ2_S (160 tensors, the mid-stack) and IQ3_S (32, the edge layers), and both
        # carry their codebook as an ordinary FIFTH kernel argument — so they launch through
        # `cuda_launch_n` (see load_quant_grid) instead of `cuda_launch4i`. Loaded unconditionally,
        # like q5k/attn35 above; both are in the Makefile's KERNELS list so a clean build has them.
        # The tables are 8192 B (IQ2_S: 1024 entries x 8) and 2048 B (IQ3_S: 512 x 4), the SAME for
        # every tensor of their type, so each is uploaded exactly once, here.
        mi2<loc<CVoid>> = from<loc<CVoid>>(0)
        mi3<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleLoadData(loc(mi2), read_bin("native/build/iq2s.ptx")) != 0) { println("MODLOAD_FAIL iq2s"); return 9 }
        if (cuModuleLoadData(loc(mi3), read_bin("native/build/iq3s.ptx")) != 0) { println("MODLOAD_FAIL iq3s"); return 9 }
        f2l<loc<CVoid>> = from<loc<CVoid>>(0)
        f3l<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(f2l), mi2, "iq2sdeq") != 0) { return 10 }
        if (cuModuleGetFunction(loc(f3l), mi3, "iq3sdeq") != 0) { return 10 }
        # Length-checked, never trusted: a short read here is a grid the kernels would index past.
        g2img<String> = read_bin("native/out/iq2s_grid.bin")
        g3img<String> = read_bin("native/out/iq3s_grid.bin")
        if (g2img.len() != 8192) { println("GRID_FAIL the iq2s grid image is " + g2img.len().to_string() + " bytes, want 8192 (run native/tools/iq2_s_ref.py)"); return 36 }
        if (g3img.len() != 2048) { println("GRID_FAIL the iq3s grid image is " + g3img.len().to_string() + " bytes, want 2048 (run native/tools/iq3_s_ref.py)"); return 36 }
        GD2<Int> = 0; GD3<Int> = 0
        if (cuMemAlloc_v2(loc(GD2), 8192) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(GD3), 2048) != 0) { return 11 }
        if (download(g2img, GD2, 8192) != 0) { return 15 }
        if (download(g3img, GD3, 2048) != 0) { return 15 }
        GK<GridK> = GridK { f2 = addr(f2l), g2 = GD2, f3 = addr(f3l), g3 = GD3 }
        println("GRID_TABLES iq2_s=8192B iq3_s=2048B uploaded once each")


        # Buffers are sized from a TEMPLATE layer's tensors, never from blk.0 by assumption: in a
        # hybrid model block 0 is RECURRENT and has no attn_q/k/v at all, so sizing from blk.0 makes
        # every attention buffer the size of a missing tensor and the first allocation fails —
        # measured on the Ridge model, not hypothetical. The template is the first ATTENTION block;
        # each size has a sane default for a tensor this architecture names differently (qwen35 calls
        # the FFN's pre-norm `post_attention_norm`, and folds an output gate into attn_q).
        ATL<Int> = 0
        atl2<Int> = 0
        for (atl2 in 0..MAXL - 1) {
            if (ATL == 0) {
                if (atl2 > 0) {
                    if (find_nm(nmv, "blk." + atl2.to_string() + ".attn_q.weight") >= 0) {
                        if (mc_layer_kind("blk." + atl2.to_string() + ".attn_q.weight") == 1) { ATL = atl2 }
                    }
                }
            }
        }
        ats<String> = "blk." + ATL.to_string() + "."
        wq_nl<Int> = NQ * D; wk_nl<Int> = NKV * D; wv_nl<Int> = NKV * D; wo_nl<Int> = D * NQ
        wg_nl<Int> = FF * D; wu_nl<Int> = FF * D; wd_nl<Int> = D * FF
        n1_nl<Int> = D; nq_nl<Int> = HD; nk_nl<Int> = HD; n2_nl<Int> = D
        i0<Int> = find_nm(nmv, ats + "attn_q.weight"); if (i0 >= 0) { wq_nl = nlv.get(i0) }
        i0 = find_nm(nmv, ats + "attn_k.weight"); if (i0 >= 0) { wk_nl = nlv.get(i0) }
        i0 = find_nm(nmv, ats + "attn_v.weight"); if (i0 >= 0) { wv_nl = nlv.get(i0) }
        i0 = find_nm(nmv, ats + "attn_output.weight"); if (i0 >= 0) { wo_nl = nlv.get(i0) }
        i0 = find_nm(nmv, ats + "ffn_gate.weight"); if (i0 >= 0) { wg_nl = nlv.get(i0) }
        i0 = find_nm(nmv, ats + "ffn_up.weight"); if (i0 >= 0) { wu_nl = nlv.get(i0) }
        i0 = find_nm(nmv, ats + "ffn_down.weight"); if (i0 >= 0) { wd_nl = nlv.get(i0) }
        i0 = find_nm(nmv, ats + "attn_norm.weight"); if (i0 >= 0) { n1_nl = nlv.get(i0) }
        i0 = find_nm(nmv, ats + "attn_q_norm.weight"); if (i0 >= 0) { nq_nl = nlv.get(i0) }
        i0 = find_nm(nmv, ats + "attn_k_norm.weight"); if (i0 >= 0) { nk_nl = nlv.get(i0) }
        i0 = find_nm(nmv, ats + "ffn_norm.weight"); if (i0 >= 0) { n2_nl = nlv.get(i0) }
        i0 = find_nm(nmv, "token_embd.weight"); te_nl<Int> = nlv.get(i0)
        i0 = find_nm(nmv, "token_embd.weight"); te_off<Int> = ofv.get(i0)
        i0 = find_nm(nmv, "token_embd.weight"); te_ty<Int> = tyv.get(i0)
        # W2: the untied head's own table (absent on a tied model, where the head IS token_embd).
        oi<Int> = find_nm(nmv, "output.weight")
        out_nl<Int> = -1; out_off<Int> = 0; out_ty<Int> = -1
        if (oi >= 0) { out_nl = nlv.get(oi); out_off = ofv.get(oi); out_ty = tyv.get(oi) }
        if (UT == 1) {
            if (oi < 0) { println("HEAD_FAIL the config says untied but the index has no output.weight"); return 2 }
            if (out_nl != VOCAB * D || out_ty != 14) {
                println("HEAD_FAIL output.weight is " + out_nl.to_string() + " values of type "
                        + out_ty.to_string() + ", wanted " + (VOCAB * D).to_string() + " of type 14 (Q6_K)")
                return 2
            }
            println("HEAD_TABLE output.weight " + out_nl.to_string() + " values, Q6_K, off=" + out_off.to_string()
                    + "; token_embd off=" + te_off.to_string() + " type=" + te_ty.to_string())
        }

        DWq<Int> = 0; DWk<Int> = 0; DWv<Int> = 0; DWo<Int> = 0; DWg<Int> = 0; DWu<Int> = 0; DWd<Int> = 0
        N1<Int> = 0; Nq<Int> = 0; Nk<Int> = 0; N2<Int> = 0; ON<Int> = 0
        XA<Int> = 0; XB<Int> = 0; XN<Int> = 0; DQ<Int> = 0; DQN<Int> = 0; DQr<Int> = 0
        DK<Int> = 0; DKN<Int> = 0; DKr<Int> = 0; DV<Int> = 0; DCtx<Int> = 0
        DO<Int> = 0; X1<Int> = 0; X1N<Int> = 0; Gr<Int> = 0; Up<Int> = 0; Hu<Int> = 0; M<Int> = 0
        DH<Int> = 0; DE<Int> = 0; DEt<Int> = 0; DL<Int> = 0; AO<Int> = 0
        # W2: the untied head's chunk buffers, and the chunk size (rows of the output table held at
        # once: 16384 x 5120 x 8 = 671 MB, which fits beside the layer weights on a 24 GB card).
        DCH<Int> = 0; DCL<Int> = 0; DBV<Int> = 0; DAO<Int> = 0
        CH<Int> = 16384
        DPK<Int> = 0; GM<Int> = 0; RN<Int> = 0; ATT<Int> = 0; ROP<Int> = 0; PF<Int> = 0; T4<Int> = 0; A4<Int> = 0; IDS<Int> = 0; EP<Int> = 0
        # unit 10 step 5: the Ridge attention branch's buffers (allocated only when JQG == 1)
        DQG<Int> = 0; DGT<Int> = 0; DGD<Int> = 0; AP1<Int> = 0
        if (cuMemAlloc_v2(loc(DWq), dt_bytes_for(wq_nl, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DWk), dt_bytes_for(wk_nl, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DWv), dt_bytes_for(wv_nl, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DWo), dt_bytes_for(wo_nl, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DWg), dt_bytes_for(wg_nl, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DWu), dt_bytes_for(wu_nl, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DWd), dt_bytes_for(wd_nl, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(N1), dt_bytes_for(n1_nl, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(Nq), dt_bytes_for(nq_nl, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(Nk), dt_bytes_for(nk_nl, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(N2), dt_bytes_for(n2_nl, dt_f64())) != 0) { return 11 }
        # Activations: shape x element width, both from the layers above (S0.2b tensor core).
        if (cuMemAlloc_v2(loc(ON), tt_nbytes(D1, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(XA), tt_nbytes(SD, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(XB), tt_nbytes(SD, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(XN), tt_nbytes(SD, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DQ), tt_nbytes(SQ, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DQN), tt_nbytes(SQ, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DQr), tt_nbytes(SQ, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DK), tt_nbytes(SK, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DKN), tt_nbytes(SK, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DKr), tt_nbytes(SK, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DV), tt_nbytes(SK, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DCtx), tt_nbytes(SQ, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DO), tt_nbytes(SD, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(X1), tt_nbytes(SD, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(X1N), tt_nbytes(SD, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(Gr), tt_nbytes(SF, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(Up), tt_nbytes(SF, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(Hu), tt_nbytes(SF, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(M), tt_nbytes(SD, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DH), tt_nbytes(SD, dt_f64())) != 0) { return 11 }
        # W2: the untied path's buffers. The head cannot hold its table whole (10.2 GB as f64), so it
        # keeps a reusable [D, CH] chunk of it, that chunk's logits for every position, and a running
        # (best value, best index) per position. A tied model allocates none of these and keeps the
        # whole-table DE path it has always used.
        if (UT == 0) {
            if (cuMemAlloc_v2(loc(DE), dt_bytes_for(te_nl, dt_f64())) != 0) { return 11 }
        } else {
            if (cuMemAlloc_v2(loc(DCH), dt_bytes_for(D * CH, dt_f64())) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(DCL), dt_bytes_for(S * CH, dt_f64())) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(DBV), tt_nbytes(S1, dt_f64())) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(DAO), tt_nbytes(S1, dt_f64())) != 0) { return 11 }
            println("HEAD_ALLOC chunk=" + CH.to_string() + " rows, [D,CH] f64 = "
                    + (D * CH * 8 / 1048576).to_string() + " MB (the whole table would have been "
                    + (te_nl * 8 / 1048576).to_string() + " MB, and an untied model needs a second one)")
        }
        if (cuMemAlloc_v2(loc(DL), tt_nbytes(SV, dt_f64())) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(AO), tt_nbytes(S1, dt_f64())) != 0) { return 11 }
        # DPK is the staging buffer for every tensor the loop stages WHOLE, so it must cover the
        # LARGEST one — and that is not the template layer's ffn_down. Sizing it from blk.0's
        # ffn_down was safe only while `packed_bytes` had no IQ2_S/IQ3_S case: the FFN fall-through
        # (4 bytes per element) made that number larger than every packed form in the file. Landing
        # the FFN types (W1) removed that accident, and Ridge's attn_q (12288x5120 Q5_K, 43.3 MB)
        # then overran a 38 MB DPK — the stage fails at attn_q with a CUDA error that reads like a
        # kernel bug. So the size is COMPUTED from the model's own tensor table (measured, not
        # assumed), and token_embd is excluded because emb_dequant stages it in 65536-ELEMENT chunks
        # (53,760 B for Q6_K), far below every whole-tensor candidate.
        pk_max<Int> = 0
        pj<Int> = 0
        for (pj in 0..nmv.len() - 1) {
            if (nmv.get(pj) != "token_embd.weight") {
                pjpb<Int> = packed_bytes(nlv.get(pj), tyv.get(pj))
                if (pjpb > pk_max) { pk_max = pjpb }
            }
        }
        if (pk_max <= 0) { println("PK_FAIL no tensor to size the staging buffer from"); return 11 }
        println("PK_STAGE bytes=" + pk_max.to_string() + " (the largest tensor staged whole)")
        if (cuMemAlloc_v2(loc(DPK), pk_max) != 0) { return 11 }

        # ---- unit 10 step 5: the Ridge attention branch's own buffers ----
        # DQG holds the JOINT q+gate projection (S x 2*NQ), which nothing else allocates; DGT the
        # gate half after the split, DGD the gated context, AP1 the split/gate kernels' param block.
        # Only allocated when the model's attn_q actually carries the gate (JQG), so a dense model's
        # memory footprint is unchanged.
        if (JQG == 1) {
            if (cuMemAlloc_v2(loc(DQG), tt_nbytes(SQ2, dt_f64())) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(DGT), tt_nbytes(SQ, dt_f64())) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(DGD), tt_nbytes(SQ, dt_f64())) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(AP1), 64) != 0) { return 11 }
        }

        # ---- unit 9c: the recurrent branch's buffers ----
        # ONE set of weight and activation buffers, staged per recurrent block as the loop reaches
        # it (several hundred MB each; per-layer sets would be 48x that), plus the PER-LAYER STATE
        # CACHE — the conv window and the delta-net state a sequence carries across tokens. Both
        # are sized from the model's own geometry (GDN_CFG above) and are never touched for a model
        # with no recurrent block.
        GWAN<Int> = 0; GWQ<Int> = 0; GWG<Int> = 0; GWB<Int> = 0; GWA<Int> = 0
        GWO<Int> = 0; GWCW<Int> = 0; GWSN<Int> = 0; GWDT<Int> = 0; GWSAA<Int> = 0
        GXN<Int> = 0; GQKVX<Int> = 0; GZ<Int> = 0; GBRAW<Int> = 0; GBETA<Int> = 0; GARAW<Int> = 0
        GGATE<Int> = 0; GCONV<Int> = 0; GCONVS<Int> = 0; GCRAW<Int> = 0; GQN<Int> = 0; GKN<Int> = 0
        GOUT<Int> = 0; GEL<Int> = 0; GEPI<Int> = 0; GY<Int> = 0; GLOD<Int> = 0
        DSTS<Int> = 0; GDPK<Int> = 0
        # W4's draft-head buffers: declared HERE, not inside the `if (MTPM == 1)` branch that fills
        # them — a variable declared inside a branch is scoped to it, and MSN is read much later (the
        # head's normalisation), which fails as "Undefined identifier: MSN".
        MEH<Int> = 0; MEN<Int> = 0; MHN<Int> = 0; MSN<Int> = 0; MC2<Int> = 0; MTMP<Int> = 0; MHID<Int> = 0
        MPOS<Int> = 0
        GP1<Int> = 0; GP2<Int> = 0; GP3<Int> = 0; GP4<Int> = 0
        if (GRL >= 0) {
            if (cuMemAlloc_v2(loc(GWAN), GNE * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GWQ), GQKV * GNE * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GWG), GVALUE * GNE * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GWB), GHV * GNE * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GWA), GHV * GNE * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GWO), GNE * GVALUE * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GWCW), GQKV * GDC * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GWSN), GSS * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GWDT), GHV * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GWSAA), GHV * 8) != 0) { return 11 }
            println("GDN_ALLOC_WEIGHTS_OK")
            if (cuMemAlloc_v2(loc(GXN), GNE * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GQKVX), GQKV * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GZ), GVALUE * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GBRAW), GHV * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GBETA), GHV * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GARAW), GHV * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GGATE), GHV * 8) != 0) { return 11 }
            # The conv WINDOW is per-layer sequence state and the loop indexes it that way
            # (`gconv = GCONV + L * GDC*GQKV*8`), so it needs a slot per layer the index can reach —
            # exactly what the delta-net cache below does. Sizing it for ONE window is an
            # out-of-bounds write from L = 1 onward, and it is SILENT for as long as the write lands
            # in device memory that nothing reads: measured, the S=5 whole-model forward matched the
            # oracle at cos 0.9996 while an S=2 run died at block 16 with `GDN_ERR conv` (the OOB
            # damage only reaches a fault when the neighbouring allocations are small). Zeroed
            # explicitly below, like every other cache: a stale window is not guaranteed zero, and
            # token 0 reads it directly.
            if (cuMemAlloc_v2(loc(GCONV), MAXL * GDC * GQKV * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GCONVS), GQKV * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GCRAW), GQKV * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GQN), GKEY * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GKN), GKEY * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GOUT), GSS * GHV * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GEL), GSS * GHV * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GEPI), GSS * GHV * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GY), GNE * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GLOD), GNE * 8) != 0) { return 11 }
            println("GDN_ALLOC_ACTS_OK")
            # the delta-net state cache is allocated for every TEXT block, so the loop never has to
            # decide whether layer L owns a slot: recurrent blocks use theirs, the rest stay zeroed.
            # (The conv windows live in GCONV, allocated above with the same per-layer sizing.)
            # TWO delta-net slots per layer, not one: the loop ping-pongs a layer's state between
            # `L*2 + gst%2` and `L*2 + 1 - gst%2`, so the cache must hold 2*MAXL of them. Allocating
            # MAXL (one per layer, which is what the name suggests) is out of bounds from L = MAXL/2
            # — measured on Ridge: layers 0..31 run and the FIRST recurrent block past the halfway
            # point faults, poisoning the context so the failure surfaces at the next checked launch
            # (`GDN_ERR norm_gated` at blk.32) rather than at the delta_step that wrote past the end.
            # The hidden state of a whole-model run had never reached layer 32 before this, which is
            # why a probe at blk.0/blk.19 never saw it.
            if (cuMemAlloc_v2(loc(DSTS), MAXL * 2 * GSS * GSS * GHV * 8) != 0) { return 11 }
            println("GDN_ALLOC_CACHE_OK")
            # the mixer weights' packed staging buffer. Sized at 4 bytes per element, which is the
            # widest any ggml type this loader accepts occupies, so no tensor can overrun it.
            if (cuMemAlloc_v2(loc(GDPK), GQKV * GNE * 4) != 0) { return 11 }
            println("GDN_ALLOC_PK_OK")
            if (cuMemAlloc_v2(loc(GP1), 128) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GP2), 128) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GP3), 128) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(GP4), 128) != 0) { return 11 }
            println("GDN_ALLOC_PARAMS_OK")
            # A fresh sequence starts with a zero conv window and a zero delta-net state, and device
            # memory is NOT pre-zeroed, so both caches must be cleared here. The host-side
            # `download` helper moves 8 bytes per device call — for 410 MB that is 51 M calls and
            # minutes of wall clock; cuMemsetD8_v2 clears each cache in one call.
            if (cuMemsetD8_v2(DSTS, 0, MAXL * 2 * GSS * GSS * GHV * 8) != 0) {
                println("GDN_CFG_FAIL could not zero the state cache")
                return 11
            }
            if (cuMemsetD8_v2(GCONV, 0, MAXL * GDC * GQKV * 8) != 0) {
                println("GDN_CFG_FAIL could not zero the conv windows")
                return 11
            }
            println("GDN_CACHE layers=" + MAXL.to_string() + " delta-net=" + (MAXL * 2 * GSS * GSS * GHV).to_string()
                    + " values (2 slots/layer, the ping-pong the loop indexes with L*2+slot)"
                    + " conv=" + (MAXL * GDC * GQKV).to_string() + " values in " + MAXL.to_string() + " per-layer windows, zeroed")
        }
        if (cuMemAlloc_v2(loc(GM), 64) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(RN), 48) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(ATT), 224) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(ROP), 232) != 0) { return 11 }   # +224 POS base for qwen3rope
        if (cuMemAlloc_v2(loc(PF), 24) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(T4), 32) != 0) { return 11 }
        # 64 B, not 32: argmax_acc takes six params (+0 C +8 BV +16 Out +24 S +32 CH +40 base) and
        # shares this block with argmax_row (which uses the first four).
        if (cuMemAlloc_v2(loc(A4), 64) != 0) { return 11 }
        DF<Int> = 0
        if (cuMemAlloc_v2(loc(DF), 64 * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(IDS), S * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(EP), 40) != 0) { return 11 }

        # ---- unit 9c probe: the block's input comes from the fixture, not the embedding ----
        # Everything else in this section (the token_embd gather table, the prompt gather) belongs to
        # a whole-model run; the probe reads its two tokens straight into the activation buffer.
        if (PR >= 0) {
            xf<String> = read_bin(env_get("VYB_GDN_X") else "native/build/gdn_engine_x.bin")
            if (xf.len() < 2 * D * 8) { println("GDN_ERR no step input"); return 2 }
            if (download(xf, XA, 2 * D * 8) != 0) { return 15 }
            println("GDN_PROBE_INPUT fixture_tokens=2")
        } else {
        if (APR >= 0) {
            # unit 10 step 5: the attention probe's input is the BLOCK INPUT (pre-attn_norm), S tokens
            # of D, read from the fixture whose LENGTH set S above.
            if (download(afx, XA, S * D * 8) != 0) { return 15 }
            println("ATTN_PROBE_X_READY tokens=" + S.to_string() + " D=" + D.to_string())
        } else {
        if (FR >= 0) {
            # ---- W1: the FFN probe's input is the block's RESIDUAL-STREAM input, S tokens of D:
            # the value the mixer (attention or recurrent) leaves for the FFN. Read straight into
            # X1, which is what run_ffn takes as its residual operand.
            if (download(ffx, X1, S * D * 8) != 0) { return 15 }
            println("FFN_PROBE_X_READY tokens=" + S.to_string() + " D=" + D.to_string())
        } else {

        if (UT == 1) {
            # ---- the untied path: build ONLY the prompt's own rows, straight from the table.
            # One row is D/256 packed blocks (4200 B for Ridge), so the prompt embed costs kilobytes
            # per token instead of a 10.2 GB table — which is the whole reason this path exists.
            ir<Int> = 0
            for (ir in 0..S - 1) {
                dr<Int> = prids.get(ir)
                e = emb_row(MODEL, te_off, dr, D, te_ty, DPK, q6fn, XA + ir * D * 8)
                if (e != 0) { println("EMBED_ERR row " + ir.to_string() + " token " + dr.to_string() + " e=" + e.to_string()); return 91 }
            }
            println("EMBED_ROWS tokens=" + S.to_string() + " (the prompt's rows only; no table materialised)")
            if (LTR == 1) {
                # The untied embed is NEW code (W2) and nothing else checks it: dump the first three
                # components of each prompt row so a python Q6_K dequant of the same table rows can
                # be compared directly, and a wrong row offset or a missing transpose shows up as a
                # number rather than as a whole-model cosine.
                cuCtxSynchronize()
                match (open_write("native/out/ridge_embed_rows.txt")) {
                    ew -> {
                        etj<Int> = 0
                        for (etj in 0..S * 3 - 1) {
                            etv<Float> = 0.0
                            if (cuMemcpyDtoH_v2(loc(etv), XA + (etj / 3) * D * 8 + (etj % 3) * 8, 8) != 0) { return 16 }
                            match (write_str(ew, etv.to_string() + "\n")) { q -> { } ? -> { return 17 } }
                        }
                        close(ew)
                    }
                    ? -> { return 17 }
                }
            }
        } else {

        # ---- token_embd -> DE (f64 gather table), loaded up front so BOTH the
        # prompt embed (this block) and the tied lm_head reuse it. ----
        if (emb_dequant(MODEL, te_off, te_nl, DPK, q6fn, DE) != 0) { return 91 }

        # ---- embed prompt: XA[s*D+d] = DE[prids[s]*D+d] (GPU gather). ----
        dvar<Int> = 0
        ikt<Int> = 0
        for (ikt in 0..S - 1) {
            dvar = prids.get(ikt)
            if (cuMemcpyHtoD_v2(IDS + ikt * 8, loc(dvar), 8) != 0) { return 15 }
        }
        cuMemcpyHtoD_v2(EP + 0, loc(DE), 8); cuMemcpyHtoD_v2(EP + 8, loc(IDS), 8); cuMemcpyHtoD_v2(EP + 16, loc(XA), 8)
        cuMemcpyHtoD_v2(EP + 24, loc(S), 8); cuMemcpyHtoD_v2(EP + 32, loc(D), 8)
        rc_em<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(emfn)), (S * D + 255) / 256, 1, 1, 256, 1, 1, EP, 0, 0, 0)
        if (rc_em != 0) { println("EMBED_LAUNCH_FAIL rc=" + (rc_em as Int).to_string()); return 93 }
        # Step-1 probe: dump the embedded XA so verify_chat_real.py can assert it
        # equals layer0_input.bin (the committed gold for ids [0,1]).
        cuCtxSynchronize()
        match (open_write("native/out/prefill_embedded_vyb.txt")) {
            w -> {
                rve<Float> = 0.0
                ie2<Int> = 0
                for (ie2 in 0..S * D - 1) {
                    rve = 0.0
                    if (cuMemcpyDtoH_v2(loc(rve), XA + ie2 * 8, 8) != 0) { return 16 }
                    match (write_str(w, rve.to_string() + "\n")) { q -> { } ? -> { return 17 } }
                }
                close(w)
            }
            ? -> { return 17 }
        }
        println("EMBED_PROBE_DONE")
        }
        }
        }
        }

        # WHICH model's rope table: measured per model from its own GGUF (rope.freq_base and
        # rope.dimension_count), and named by env so the same driver path can serve either. Ridge's is
        # 1e7 over 64 dims (32 pairs); Qwen3-4B's is 5e6 over 128 (64 pairs) — see native/tools/gen_invfreq.py.
        fip<String> = env_get("VYB_INVFREQ") else "native/out/layer0_invfreq.bin"
        fb<String> = read_bin(fip)
        if (fb.len() < 8) { println("INVFREQ_MISSING"); return 35 }
        # the table holds one inverse frequency per PAIR, so n_dims = 2 * entries: 64 entries is
        # Qwen3-4B's whole 128-dim head (rotate everything, as qwen3rope did), 32 is Ridge's
        # 64-of-256. Reading it here rather than hardcoding it is what lets one kernel serve both.
        NROTP<Int> = fb.len() / 8
        if (NROTP > 64) { NROTP = 64 }        # DF is 64 entries
        download(fb, DF, NROTP * 8)
        NROT<Int> = NROTP * 2

        XI<Int> = XA; XO<Int> = XB
        e<Int> = 0
        L<Int> = 0
        # ---- W4: the MTP draft head's input sequence and staging ----
        # `cur_i = eh_proj @ [ rms(e(token_{i+1}), enorm) ; rms(h_i, hnorm) ]`, one row per step, built
        # into XA — the loop's own input buffer — so the block below consumes it exactly as a normal
        # layer consumes the embed. The four nextn tensors are not per-layer, so they are staged once.
        if (MTPM == 1) {
            mtop<Int> = find_nm(nmv, "blk." + NTL.to_string() + ".nextn.eh_proj.weight")
            mon<Int> = find_nm(nmv, "blk." + NTL.to_string() + ".nextn.enorm.weight")
            mhn<Int> = find_nm(nmv, "blk." + NTL.to_string() + ".nextn.hnorm.weight")
            msn<Int> = find_nm(nmv, "blk." + NTL.to_string() + ".nextn.shared_head_norm.weight")
            if (mtop < 0 || mon < 0 || mhn < 0 || msn < 0) {
                println("MTP_ERR blk." + NTL.to_string() + " is missing a nextn tensor"); return 2
            }
            if (cuMemAlloc_v2(loc(MEH), 2 * D * D * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(MEN), D * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(MHN), D * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(MSN), D * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(MC2), 2 * D * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(MTMP), D * 8) != 0) { return 11 }
            if (cuMemAlloc_v2(loc(MHID), S * D * 8) != 0) { return 11 }
            e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + NTL.to_string() + ".nextn.eh_proj.weight", DPK, PF, MEH, q4fn, q5fn, q6fn, efn, 2 * D, GK)
            if (e != 0) { println("MTP_ERR stage eh_proj"); return 74 }
            e = load_norm(MODEL, PF, DPK, MEN, ofv.get(mon), nlv.get(mon), efn)
            if (e != 0) { println("MTP_ERR stage enorm"); return 80 }
            e = load_norm(MODEL, PF, DPK, MHN, ofv.get(mhn), nlv.get(mhn), efn)
            if (e != 0) { println("MTP_ERR stage hnorm"); return 80 }
            e = load_norm(MODEL, PF, DPK, MSN, ofv.get(msn), nlv.get(msn), efn)
            if (e != 0) { println("MTP_ERR stage shared_head_norm"); return 80 }
            # The hidden rows come from the ORACLE's own capture (VYB_MTP_HIDDEN = a fixture's
            # `.hidden.f64`), which isolates this new block from the main pass: with the oracle's
            # hidden as input, any disagreement is this block's, not accumulation through 64 layers.
            mhp<String> = env_get("VYB_MTP_HIDDEN") else ""
            mhs<String> = read_bin(mhp)
            if (mhs.len() < S * D * 8) {
                println("MTP_ERR hidden file " + mhp + " has " + mhs.len().to_string() + " B, wanted "
                        + (S * D * 8).to_string()); return 2
            }
            if (download(mhs, MHID, S * D * 8) != 0) { return 15 }
            msi<Int> = 0
            for (msi in 0..S - 1) {
                dms<Int> = prids.get(msi)
                e = emb_row(MODEL, te_off, dms, D, te_ty, DPK, q6fn, MTMP)
                if (e != 0) { println("MTP_ERR embed row " + msi.to_string()); return 91 }
                # embedding FIRST, then the hidden (ggml_concat(e_norm, h_norm)): into MC2's halves
                put_i(GP1, 0, MTMP) ; put_i(GP1, 8, MEN) ; put_i(GP1, 16, MC2)
                put_i(GP1, 24, 1) ; put_i(GP1, 32, D) ; put_f(GP1, 40, EPS)
                grcc = cuda_launch4i(from<loc<CVoid>>(addr(rfn)), (D + 255) / 256, 1, 1, 256, 1, 1, GP1, 0, 0, 0)
                if (grcc != 0) { println("MTP_ERR enorm rms"); return 12 }
                put_i(GP1, 0, MHID + msi * D * 8) ; put_i(GP1, 8, MHN) ; put_i(GP1, 16, MC2 + D * 8)
                put_i(GP1, 24, 1) ; put_i(GP1, 32, D) ; put_f(GP1, 40, EPS)
                grcc = cuda_launch4i(from<loc<CVoid>>(addr(rfn)), (D + 255) / 256, 1, 1, 256, 1, 1, GP1, 0, 0, 0)
                if (grcc != 0) { println("MTP_ERR hnorm rms"); return 12 }
                put_f(GP2, 48, 1.0) ; put_f(GP2, 56, 0.0)
                put_i(GP2, 0, MC2) ; put_i(GP2, 8, MEH) ; put_i(GP2, 16, XA + msi * D * 8)
                put_i(GP2, 24, 1) ; put_i(GP2, 32, D) ; put_i(GP2, 40, 2 * D)
                grcc = cuda_launch4i(from<loc<CVoid>>(addr(gfn)), (D + 255) / 256, 1, 1, 256, 1, 1, GP2, 0, 0, 0)
                if (grcc != 0) { println("MTP_ERR eh_proj gemm"); return 12 }
            }
            # The draft step's rope position is the CALLER's choice in llama.cpp (inp_pos), so it is a
            # knob here: measured, not assumed. 1 = the next token's own position.
            mpv<String> = env_get("VYB_MTP_POS") else "1"
            MPOS<Int> = parse_u(mpv, 0, mpv.len())
            cuMemcpyHtoD_v2(ROP + 72, loc(MPOS), 8)
            println("MTP_MODE steps=" + S.to_string() + " block=blk." + NTL.to_string()
                    + " rope_pos_base=" + MPOS.to_string() + " hidden=" + mhp)
        }

        LST<Int> = 0 ; LEP<Int> = NTL
        if (MTPM == 1) { LST = NTL ; LEP = NTL + 1 }
        for (L in LST..LEP - 1) {
            # ---- the per-layer DISPATCH (unit 9c) ----
            # Presence comes from the tensor table; the KIND comes from the shared classifier. This
            # pairing is not optional: mc_layer_kind classifies a name, so asking it alone about a
            # constructed name makes every layer look recurrent (measured — a dense model reported
            # "the first recurrent block blk.0. is missing a tensor").
            lkc<Int> = 0
            if (find_nm(nmv, "blk." + L.to_string() + ".ssm_alpha.weight") >= 0) {
                lkc = mc_layer_kind("blk." + L.to_string() + ".ssm_alpha.weight")
            }
            if (lkc == 0) {
                if (find_nm(nmv, "blk." + L.to_string() + ".attn_q.weight") >= 0) {
                    lkc = mc_layer_kind("blk." + L.to_string() + ".attn_q.weight")
                }
            }
            if (lkc == 0) {
                println("DISPATCH_FAIL blk." + L.to_string() + " carries neither a recurrent nor an attention marker")
                return 7
            }
            if ((PR < 0 && APR < 0 && FR < 0) || L == PR || L == APR || L == FR) {
            if (FR >= 0) {
                # ---- W1: the FFN half of a Ridge block, on the engine's own weight path ----
                # The SAME code the whole-model loop runs (run_ffn, called at the bottom of both the
                # recurrent and the attention branch), with the residual-stream input from the
                # fixture. This is the acceptance check for the IQ2_S/IQ3_S staging path: before W1
                # stage_one had no case for types 21/22 and fell through to the F32 loader.
                l_fn<Int> = find_nm(nmv, "blk." + L.to_string() + ".post_attention_norm.weight")
                if (l_fn < 0) { l_fn = find_nm(nmv, "blk." + L.to_string() + ".ffn_norm.weight") }
                if (l_fn < 0) { println("FFN_ERR blk." + L.to_string() + " has no FFN pre-norm tensor"); return 7 }
                e = load_norm(MODEL, PF, DPK, N2, ofv.get(l_fn), nlv.get(l_fn), efn)
                if (e != 0) { println("FFN_ERR stage post_attention_norm"); return 80 }
                e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".ffn_gate.weight", DPK, PF, DWg, q4fn, q5fn, q6fn, efn, D, GK); if (e != 0) { println("FFN_ERR stage ffn_gate"); return 74 }
                e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".ffn_up.weight", DPK, PF, DWu, q4fn, q5fn, q6fn, efn, D, GK); if (e != 0) { println("FFN_ERR stage ffn_up"); return 75 }
                e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".ffn_down.weight", DPK, PF, DWd, q4fn, q5fn, q6fn, efn, FF, GK); if (e != 0) { println("FFN_ERR stage ffn_down"); return 76 }
                println("FFN_GEOM blk." + L.to_string() + " D=" + D.to_string() + " FF=" + FF.to_string() + " S=" + S.to_string())
                println("FFN_STAGED blk." + L.to_string() + " ffn_gate/ffn_up/ffn_down by their own type (21=IQ3_S, 22=IQ2_S), post_attention_norm F32")
                # The staged operands at the addresses gemm reads: the dequant's transposing write
                # gives ffn_gate/up B[k*FF + n] (k over D, n over FF) and ffn_down B[k*D + n] (k over
                # FF). A good block fed a wrong operand is invisible to a stage-by-stage comparison,
                # so the verifier checks these against the model's own dequantised tensor.
                dump_slot(DWg, 0 * FF + 0, "fg")
                dump_slot(DWg, (D - 1) * FF + 0, "fg")
                dump_slot(DWg, 100 * FF + (FF - 9), "fg")
                dump_slot(DWu, 3000 * FF + 12345, "fu")
                dump_slot(DWd, 0 * D + 0, "fd")
                dump_slot(DWd, (FF - 8) * D + (D - 1), "fd")
                e = run_ffn(S, D, FF, gfn, rfn, sfn, refn, GM, RN, EPS,
                            X1, N2, DWg, DWu, DWd, X1N, Gr, Up, Hu, M, XO)
                if (e != 0) { println("FFN_ERR run_ffn"); return 82 }
                cuCtxSynchronize()
                dump_section(N2, D, "f1_", "norm")
                dump_section(X1N, S * D, "f1_", "ffn_xn")
                dump_section(Gr, S * FF, "f1_", "ffn_gate")
                dump_section(Up, S * FF, "f1_", "ffn_up")
                dump_section(Hu, S * FF, "f1_", "ffn_silu")
                dump_section(M, S * D, "f1_", "ffn_down")
                dump_section(XO, S * D, "f1_", "block_out")
                println("FFN_PROBE_DONE blk." + L.to_string() + " tokens=" + S.to_string())
                return 0
            }
            if (lkc == 2) {
                # ---- the recurrent block: mixer (per token, state carried) then the shared FFN ----
                l_an<Int> = find_nm(nmv, "blk." + L.to_string() + ".attn_norm.weight")
                l_qk<Int> = find_nm(nmv, "blk." + L.to_string() + ".attn_qkv.weight")
                l_ga<Int> = find_nm(nmv, "blk." + L.to_string() + ".attn_gate.weight")
                l_be<Int> = find_nm(nmv, "blk." + L.to_string() + ".ssm_beta.weight")
                l_al<Int> = find_nm(nmv, "blk." + L.to_string() + ".ssm_alpha.weight")
                l_ou<Int> = find_nm(nmv, "blk." + L.to_string() + ".ssm_out.weight")
                l_cw<Int> = find_nm(nmv, "blk." + L.to_string() + ".ssm_conv1d.weight")
                l_sn<Int> = find_nm(nmv, "blk." + L.to_string() + ".ssm_norm.weight")
                l_dt<Int> = find_nm(nmv, "blk." + L.to_string() + ".ssm_dt.bias")
                l_aa<Int> = find_nm(nmv, "blk." + L.to_string() + ".ssm_a")
                if (l_an < 0 || l_qk < 0 || l_ga < 0 || l_be < 0 || l_al < 0 || l_ou < 0
                    || l_cw < 0 || l_sn < 0 || l_dt < 0 || l_aa < 0) {
                    println("GDN_ERR blk." + L.to_string() + " is missing a recurrent tensor")
                    return 7
                }
                # the ten mixer weights, staged from the GGUF by the engine's own path
                e = load_norm(MODEL, GP1, GDPK, GWAN, ofv.get(l_an), GNE, efn)
                if (e != 0) { println("GDN_ERR stage attn_norm"); return 40 }
                e = load_quant(MODEL, GDPK, GWQ, ofv.get(l_qk), packed_bytes(nlv.get(l_qk), tyv.get(l_qk)), nlv.get(l_qk), q4fn, GNE)
                if (e != 0) { println("GDN_ERR stage attn_qkv"); return 41 }
                e = load_quant(MODEL, GDPK, GWG, ofv.get(l_ga), packed_bytes(nlv.get(l_ga), tyv.get(l_ga)), nlv.get(l_ga), q4fn, GNE)
                if (e != 0) { println("GDN_ERR stage attn_gate"); return 42 }
                e = load_quant(MODEL, GDPK, GWB, ofv.get(l_be), packed_bytes(nlv.get(l_be), tyv.get(l_be)), nlv.get(l_be), q8fn, GNE)
                if (e != 0) { println("GDN_ERR stage ssm_beta"); return 43 }
                e = load_quant(MODEL, GDPK, GWA, ofv.get(l_al), packed_bytes(nlv.get(l_al), tyv.get(l_al)), nlv.get(l_al), q8fn, GNE)
                if (e != 0) { println("GDN_ERR stage ssm_alpha"); return 44 }
                e = load_quant(MODEL, GDPK, GWO, ofv.get(l_ou), packed_bytes(nlv.get(l_ou), tyv.get(l_ou)), nlv.get(l_ou), q4fn, GVALUE)
                if (e != 0) { println("GDN_ERR stage ssm_out"); return 45 }
                e = load_norm(MODEL, GP1, GDPK, GWCW, ofv.get(l_cw), GQKV * GDC, efn)
                if (e != 0) { println("GDN_ERR stage ssm_conv1d"); return 46 }
                e = load_norm(MODEL, GP1, GDPK, GWSN, ofv.get(l_sn), GSS, efn)
                if (e != 0) { println("GDN_ERR stage ssm_norm"); return 47 }
                e = load_norm(MODEL, GP1, GDPK, GWDT, ofv.get(l_dt), GHV, efn)
                if (e != 0) { println("GDN_ERR stage ssm_dt"); return 48 }
                e = load_norm(MODEL, GP1, GDPK, GWSAA, ofv.get(l_aa), GHV, efn)
                if (e != 0) { println("GDN_ERR stage ssm_a"); return 49 }
                # and the FFN of the same block, through the shared FFN buffers
                # the FFN's pre-norm is named differently across these architectures (qwen3
                # `ffn_norm`, qwen35 `post_attention_norm`), so resolve it by trying both and stage
                # it by INDEX — stage_one takes a name and would fail on the one that is absent.
                l_fn<Int> = find_nm(nmv, "blk." + L.to_string() + ".ffn_norm.weight")
                if (l_fn < 0) { l_fn = find_nm(nmv, "blk." + L.to_string() + ".post_attention_norm.weight") }
                if (l_fn < 0) { println("GDN_ERR blk." + L.to_string() + " has no FFN pre-norm tensor"); return 7 }
                e = load_norm(MODEL, PF, DPK, N2, ofv.get(l_fn), nlv.get(l_fn), efn)
                if (e != 0) { println("GDN_ERR stage ffn pre-norm"); return 80 }
                e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".ffn_gate.weight", DPK, PF, DWg, q4fn, q5fn, q6fn, efn, D, GK); if (e != 0) { return 74 }
                e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".ffn_up.weight", DPK, PF, DWu, q4fn, q5fn, q6fn, efn, D, GK); if (e != 0) { return 75 }
                e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".ffn_down.weight", DPK, PF, DWd, q4fn, q5fn, q6fn, efn, FF, GK); if (e != 0) { return 76 }
                if (PR >= 0) {
                    println("GDN_GEOM blk." + L.to_string() + ".NE=" + GNE.to_string() + " S=" + GSS.to_string()
                            + " Hk=" + GHK.to_string() + " Hv=" + GHV.to_string() + " d_conv=" + GDC.to_string()
                            + " qkv=" + GQKV.to_string() + " value=" + GVALUE.to_string())
                    println("GDN_STAGED blk." + L.to_string() + ".attn_norm F32, attn_qkv Q4_K, attn_gate Q4_K, ssm_beta Q8_0, ssm_alpha Q8_0, ssm_out Q4_K, ssm_conv1d F32, ssm_norm F32, ssm_dt F32, ssm_a F32")
                    # the staged operand at the addresses gemm reads (B[k*N+n]) — the engine's
                    # staging really produced the model's own weights, not just a plausible block
                    dump_slot(GWO, 0 * GNE + 0, "so")
                    dump_slot(GWO, 0 * GNE + 3994, "so")
                    dump_slot(GWO, 1 * GNE + 3994, "so")
                    dump_slot(GWO, 2 * GNE + 3994, "so")
                    dump_slot(GWO, 3994 * GNE + 3994, "so")
                    dump_slot(GWO, 6143 * GNE + 3994, "so")
                    dump_slot(GWO, 5000 * GNE + 3994, "so")
                    dump_slot(GWO, 0 * GNE + 100, "so")
                }
                # one token at a time, carrying this block's conv window and delta-net state: the
                # sequential rule, which is what a decode step is. Two state slots per block, used
                # alternately, so the pair swaps without moving memory; the conv window shifts in
                # place (conv_shift), exactly as llama.cpp's decode does.
                gst<Int> = 0
                for (gst in 0..S - 1) {
                    gxp<Int> = XI + gst * D * 8
                    gx1<Int> = X1 + gst * D * 8
                    gconv<Int> = GCONV + L * GDC * GQKV * 8
                    sin<Int> = DSTS + (L * 2 + (gst % 2)) * GSS * GSS * GHV * 8
                    sout<Int> = DSTS + (L * 2 + 1 - (gst % 2)) * GSS * GSS * GHV * 8
                    grcc<CInt> = 0
                    if (gst > 0) {
                        put_i(GP4, 0, gconv) ; put_i(GP4, 8, GQKV) ; put_i(GP4, 16, GDC) ; put_i(GP4, 24, 0)
                        grcc = cuda_launch4i(from<loc<CVoid>>(addr(hsh)), (GQKV + 255) / 256, 1, 1, 256, 1, 1, GP4, 0, 0, 0)
                        if (grcc != 0) { println("GDN_ERR conv_shift") ; return 12 }
                    }
                    # 1. attn_norm — the engine's own rmsnorm kernel
                    put_i(GP1, 0, gxp) ; put_i(GP1, 8, GWAN) ; put_i(GP1, 16, GXN)
                    put_i(GP1, 24, 1) ; put_i(GP1, 32, GNE) ; put_f(GP1, 40, EPS)
                    grcc = cuda_launch4i(from<loc<CVoid>>(addr(rfn)), (GNE + 255) / 256, 1, 1, 256, 1, 1, GP1, 0, 0, 0)
                    if (grcc != 0) { println("GDN_ERR rmsnorm") ; return 12 }
                    # 2. the projections through the engine's gemm (B is [in,out] from the dequant)
                    put_f(GP2, 48, 1.0) ; put_f(GP2, 56, 0.0)
                    put_i(GP2, 0, GXN) ; put_i(GP2, 8, GWQ) ; put_i(GP2, 16, GQKVX)
                    put_i(GP2, 24, 1) ; put_i(GP2, 32, GQKV) ; put_i(GP2, 40, GNE)
                    grcc = cuda_launch4i(from<loc<CVoid>>(addr(gfn)), (GQKV + 255) / 256, 1, 1, 256, 1, 1, GP2, 0, 0, 0)
                    if (grcc != 0) { println("GDN_ERR gemm qkv") ; return 12 }
                    put_i(GP2, 8, GWG) ; put_i(GP2, 16, GZ) ; put_i(GP2, 32, GVALUE)
                    grcc = cuda_launch4i(from<loc<CVoid>>(addr(gfn)), (GVALUE + 255) / 256, 1, 1, 256, 1, 1, GP2, 0, 0, 0)
                    if (grcc != 0) { println("GDN_ERR gemm gate") ; return 12 }
                    put_i(GP2, 8, GWB) ; put_i(GP2, 16, GBRAW) ; put_i(GP2, 32, GHV)
                    grcc = cuda_launch4i(from<loc<CVoid>>(addr(gfn)), (GHV + 255) / 256, 1, 1, 256, 1, 1, GP2, 0, 0, 0)
                    if (grcc != 0) { println("GDN_ERR gemm beta") ; return 12 }
                    put_i(GP2, 8, GWA) ; put_i(GP2, 16, GARAW) ; put_i(GP2, 32, GHV)
                    grcc = cuda_launch4i(from<loc<CVoid>>(addr(gfn)), (GHV + 255) / 256, 1, 1, 256, 1, 1, GP2, 0, 0, 0)
                    if (grcc != 0) { println("GDN_ERR gemm alpha") ; return 12 }
                    # 3. the two gates
                    put_i(GP3, 0, GBRAW) ; put_i(GP3, 8, GBETA) ; put_i(GP3, 16, GHV)
                    grcc = cuda_launch4i(from<loc<CVoid>>(addr(hsg)), 1, 1, 1, 64, 1, 1, GP3, 0, 0, 0)
                    if (grcc != 0) { println("GDN_ERR sigmoid") ; return 12 }
                    put_i(GP3, 0, GARAW) ; put_i(GP3, 8, GWDT) ; put_i(GP3, 16, GWSAA) ; put_i(GP3, 24, GGATE) ; put_i(GP3, 32, GHV)
                    grcc = cuda_launch4i(from<loc<CVoid>>(addr(hag)), 1, 1, 1, 64, 1, 1, GP3, 0, 0, 0)
                    if (grcc != 0) { println("GDN_ERR alpha_gate") ; return 12 }
                    # 4. the conv input's token frame, the causal short conv, then SiLU
                    put_i(GP4, 0, GQKVX) ; put_i(GP4, 8, gconv) ; put_i(GP4, 16, GQKV) ; put_i(GP4, 24, GDC) ; put_i(GP4, 32, 1)
                    grcc = cuda_launch4i(from<loc<CVoid>>(addr(hil)), (GQKV + 255) / 256, 1, 1, 256, 1, 1, GP4, 0, 0, 0)
                    if (grcc != 0) { println("GDN_ERR interleave") ; return 12 }
                    put_i(GP3, 0, gconv) ; put_i(GP3, 8, GWCW) ; put_i(GP3, 16, GCRAW)
                    put_i(GP3, 24, GQKV) ; put_i(GP3, 32, GDC) ; put_i(GP3, 40, 1)
                    grcc = cuda_launch4i(from<loc<CVoid>>(addr(hcv)), (GQKV + 255) / 256, 1, 1, 256, 1, 1, GP3, 0, 0, 0)
                    if (grcc != 0) { println("GDN_ERR conv") ; return 12 }
                    put_i(GP3, 0, GCRAW) ; put_i(GP3, 8, GCONVS) ; put_i(GP3, 16, GQKV)
                    grcc = cuda_launch4i(from<loc<CVoid>>(addr(hsv)), (GQKV + 255) / 256, 1, 1, 256, 1, 1, GP3, 0, 0, 0)
                    if (grcc != 0) { println("GDN_ERR silu") ; return 12 }
                    # 5. l2 norm on q and k (the split is a channel offset)
                    put_i(GP1, 0, GCONVS) ; put_i(GP1, 8, GQN) ; put_i(GP1, 16, GHK) ; put_i(GP1, 24, GSS) ; put_f(GP1, 32, EPS)
                    grcc = cuda_launch4i(from<loc<CVoid>>(addr(hl2)), (GKEY + 255) / 256, 1, 1, 256, 1, 1, GP1, 0, 0, 0)
                    if (grcc != 0) { println("GDN_ERR l2 q") ; return 12 }
                    put_i(GP1, 0, GCONVS + GKEY * 8) ; put_i(GP1, 8, GKN)
                    grcc = cuda_launch4i(from<loc<CVoid>>(addr(hl2)), (GKEY + 255) / 256, 1, 1, 256, 1, 1, GP1, 0, 0, 0)
                    if (grcc != 0) { println("GDN_ERR l2 k") ; return 12 }
                    # 6. the recurrence
                    put_i(GP2, 0, GQN) ; put_i(GP2, 8, GKN) ; put_i(GP2, 16, GCONVS + 2 * GKEY * 8)
                    put_i(GP2, 24, GGATE) ; put_i(GP2, 32, GBETA) ; put_i(GP2, 40, sin)
                    put_i(GP2, 48, sout) ; put_i(GP2, 56, GOUT) ; put_i(GP2, 64, GEL)
                    put_i(GP2, 72, GSS) ; put_i(GP2, 80, GHK) ; put_i(GP2, 88, GHV)
                    put_f(GP2, 96, 1.0 / sqrt(GSS as Float))
                    grcc = cuda_launch4i(from<loc<CVoid>>(addr(hds)), 1, 1, 1, GHV, 1, 1, GP2, 0, 0, 0)
                    if (grcc != 0) { println("GDN_ERR delta_step") ; return 12 }
                    # 7. the gated RMS epilogue, ssm_out, the residual — the residual lands in X1,
                    # the FFN input, which is what the attention branch also produces
                    put_i(GP3, 0, GOUT) ; put_i(GP3, 8, GZ) ; put_i(GP3, 16, GWSN) ; put_i(GP3, 24, GEPI)
                    put_i(GP3, 32, GHV) ; put_i(GP3, 40, GSS) ; put_f(GP3, 48, EPS)
                    grcc = cuda_launch4i(from<loc<CVoid>>(addr(hng)), (GHV * GSS + 255) / 256, 1, 1, 256, 1, 1, GP3, 0, 0, 0)
                    if (grcc != 0) { println("GDN_ERR norm_gated") ; return 12 }
                    put_i(GP2, 0, GEPI) ; put_i(GP2, 8, GWO) ; put_i(GP2, 16, GY)
                    put_i(GP2, 24, 1) ; put_i(GP2, 32, GNE) ; put_i(GP2, 40, GVALUE)
                    # GP2 is SHARED with delta_step, which wrote pointers into +48/+56 (the state
                    # buffers) — exactly where gemm reads alpha/beta. Re-state them, or this
                    # projection runs with alpha = a pointer's bits as f64 and yields denormals.
                    put_f(GP2, 48, 1.0) ; put_f(GP2, 56, 0.0)
                    grcc = cuda_launch4i(from<loc<CVoid>>(addr(gfn)), (GNE + 255) / 256, 1, 1, 256, 1, 1, GP2, 0, 0, 0)
                    if (grcc != 0) { println("GDN_ERR gemm ssm_out") ; return 12 }
                    grcc = cuda_launch4i(from<loc<CVoid>>(addr(refn)), (GNE + 255) / 256, 1, 1, 256, 1, 1, GY, gxp, gx1, GNE)
                    if (grcc != 0) { println("GDN_ERR residual") ; return 12 }
                    cuCtxSynchronize()
                    if (PR >= 0) {
                        gpf<String> = "s" + (gst + 1).to_string() + "_"
                        dump_section(GXN, GNE, gpf, "xn")
                        dump_section(GQKVX, GQKV, gpf, "qkv")
                        dump_section(GZ, GVALUE, gpf, "z")
                        dump_section(GBETA, GHV, gpf, "beta")
                        dump_section(GGATE, GHV, gpf, "gate")
                        dump_section(GCONVS, GQKV, gpf, "conv_silu")
                        dump_section(GQN, GKEY, gpf, "q_norm")
                        dump_section(GKN, GKEY, gpf, "k_norm")
                        dump_section(GOUT, GSS * GHV, gpf, "gdn_out")
                        dump_section(GEPI, GSS * GHV, gpf, "epi")
                        dump_section(GY, GNE, gpf, "y")
                        dump_section(gx1, GNE, gpf, "layer_out")
                        dump_section(sout, GSS * GSS * GHV, gpf, "state_out")
                    }
                }
            } else {
            if (JQG == 1) {
                # ---- Ridge's ATTENTION block, on the engine's own weight path (unit 10 step 5) ----
                # `attn_q` is a JOINT q+gate projection, so the block is: attn_norm -> qg -> SPLIT
                # (qg_split) -> the two per-head RMS norms -> rope_nrot over the first NROT dims ->
                # causal attention (the engine's `attn` kernel already groups kv heads h/(H/KVH),
                # which is the same function the authority expresses by replicating K/V) -> the
                # output gate (gate_mul) -> wo -> residual. Every operand is re-stated immediately
                # before the launch that reads it: a param block is not an argument list.
                e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".attn_q.weight", DPK, PF, DWq, q4fn, q5fn, q6fn, efn, D, GK); if (e != 0) { println("ATTN_ERR stage attn_q"); return 70 }
                e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".attn_k.weight", DPK, PF, DWk, q4fn, q5fn, q6fn, efn, D, GK); if (e != 0) { println("ATTN_ERR stage attn_k"); return 71 }
                e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".attn_v.weight", DPK, PF, DWv, q4fn, q5fn, q6fn, efn, D, GK); if (e != 0) { println("ATTN_ERR stage attn_v"); return 72 }
                e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".attn_output.weight", DPK, PF, DWo, q4fn, q5fn, q6fn, efn, NQ, GK); if (e != 0) { println("ATTN_ERR stage attn_output"); return 73 }
                e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".attn_norm.weight", DPK, PF, N1, q4fn, q5fn, q6fn, efn, 0, GK); if (e != 0) { println("ATTN_ERR stage attn_norm"); return 77 }
                e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".attn_q_norm.weight", DPK, PF, Nq, q4fn, q5fn, q6fn, efn, 0, GK); if (e != 0) { println("ATTN_ERR stage attn_q_norm"); return 78 }
                e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".attn_k_norm.weight", DPK, PF, Nk, q4fn, q5fn, q6fn, efn, 0, GK); if (e != 0) { println("ATTN_ERR stage attn_k_norm"); return 79 }
                # ---- the FFN's own pre-norm, which NOTHING else stages for this branch ----
                # Ridge names it `post_attention_norm` (qwen3 calls it `ffn_norm`); the fall-through
                # `run_ffn` below takes it from N2, so without this the FFN of every attention layer
                # ran with whatever N2 still held — the PREVIOUS block's weight. That is a silent,
                # layer-dependent error: measured, it left the whole-model hidden at cos 0.54 against
                # the oracle while every block probe stayed green, because the attention probe stops
                # at `out` (the attention authority's last stage) and never reaches run_ffn. P4.12 is
                # the gate that catches this class; the block probes cannot, by construction.
                l_fn2<Int> = find_nm(nmv, "blk." + L.to_string() + ".ffn_norm.weight")
                if (l_fn2 < 0) { l_fn2 = find_nm(nmv, "blk." + L.to_string() + ".post_attention_norm.weight") }
                if (l_fn2 < 0) { println("ATTN_ERR blk." + L.to_string() + " has no FFN pre-norm tensor"); return 7 }
                e = load_norm(MODEL, PF, DPK, N2, ofv.get(l_fn2), nlv.get(l_fn2), efn)
                if (e != 0) { println("ATTN_ERR stage post_attention_norm"); return 80 }
                # ...and the FFN's WEIGHTS, for the same reason and with the same failure mode: the
                # shared `run_ffn` at the bottom of the loop reads DWg/DWu/DWd, which the RECURRENT
                # branch stages per block and this branch never did — so every attention block ran its
                # FFN with the previous recurrent block's gate/up/down. That is the dominant error of
                # the two: 16 of 64 blocks computed a whole FFN from the wrong weights (Ridge's
                # attention blocks have their own ffn_* tensors, at the same shapes as the recurrent
                # ones, so nothing about the staging failed loudly). Stage them by their own type
                # through the same GridK dispatcher the recurrent branch uses.
                e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".ffn_gate.weight", DPK, PF, DWg, q4fn, q5fn, q6fn, efn, D, GK); if (e != 0) { println("ATTN_ERR stage ffn_gate"); return 74 }
                e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".ffn_up.weight", DPK, PF, DWu, q4fn, q5fn, q6fn, efn, D, GK); if (e != 0) { println("ATTN_ERR stage ffn_up"); return 75 }
                e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".ffn_down.weight", DPK, PF, DWd, q4fn, q5fn, q6fn, efn, FF, GK); if (e != 0) { println("ATTN_ERR stage ffn_down"); return 76 }
                if (APR >= 0) {
                    println("ATTN_GEOM blk." + L.to_string() + " D=" + D.to_string() + " H=" + H.to_string()
                            + " KVH=" + KVH.to_string() + " HD=" + HD.to_string() + " NQ=" + NQ.to_string()
                            + " NKV=" + NKV.to_string() + " NROT=" + NROT.to_string() + " S=" + S.to_string())
                    println("ATTN_STAGED blk." + L.to_string() + " attn_q/attn_k/attn_v/attn_output by their own type, attn_norm/attn_q_norm/attn_k_norm F32")
                    # the staged operands at the addresses gemm reads (B[k*N+n]) — a good block fed a
                    # wrong operand is invisible to a stage-by-stage comparison, so check the operand
                    # itself against the model's own dequantised tensor (as the GDN gate does).
                    dump_slot(DWq, 0 * 2 * NQ + 0, "aq")
                    dump_slot(DWq, 5119 * 2 * NQ + 0, "aq")
                    dump_slot(DWq, 100 * 2 * NQ + 7, "aq")
                    dump_slot(DWq, 3000 * 2 * NQ + 9000, "aq")
                    dump_slot(DWo, 0 * D + 0, "ao")
                    dump_slot(DWo, 6143 * D + 5119, "ao")
                    dump_slot(DWo, 5000 * D + 3000, "ao")
                }
                ac1<Float> = 1.0; bc1<Float> = 0.0; zro2<Int> = 0
                # 1. attn_norm (the engine's own rmsnorm kernel) -> XN
                rA = XI; rB = N1; rC = XN
                cuMemcpyHtoD_v2(RN + 0, loc(rA), 8); cuMemcpyHtoD_v2(RN + 8, loc(rB), 8); cuMemcpyHtoD_v2(RN + 16, loc(rC), 8)
                cuMemcpyHtoD_v2(RN + 24, loc(S), 8); cuMemcpyHtoD_v2(RN + 32, loc(D), 8); cuMemcpyHtoD_v2(RN + 40, loc(EPS), 8)
                cuda_launch4i(from<loc<CVoid>>(addr(rfn)), (S * D + 255) / 256, 1, 1, 256, 1, 1, RN, 0, 0, 0)
                # 2. the three projections through the engine's gemm (B is [in,out] from the dequant)
                gA = XN; gB = DWq; gC = DQG; gM = S; gN = 2 * NQ; gK = D
                cuMemcpyHtoD_v2(GM + 0, loc(gA), 8); cuMemcpyHtoD_v2(GM + 8, loc(gB), 8); cuMemcpyHtoD_v2(GM + 16, loc(gC), 8)
                cuMemcpyHtoD_v2(GM + 24, loc(gM), 8); cuMemcpyHtoD_v2(GM + 32, loc(gN), 8); cuMemcpyHtoD_v2(GM + 40, loc(gK), 8)
                cuMemcpyHtoD_v2(GM + 48, loc(ac1), 8); cuMemcpyHtoD_v2(GM + 56, loc(bc1), 8)
                cuda_launch4i(from<loc<CVoid>>(addr(gfn)), (gM * gN + 255) / 256, 1, 1, 256, 1, 1, GM, 0, 0, 0)
                gB = DWk; gC = DK; gN = NKV
                cuMemcpyHtoD_v2(GM + 8, loc(gB), 8); cuMemcpyHtoD_v2(GM + 16, loc(gC), 8); cuMemcpyHtoD_v2(GM + 32, loc(gN), 8)
                cuda_launch4i(from<loc<CVoid>>(addr(gfn)), (gM * gN + 255) / 256, 1, 1, 256, 1, 1, GM, 0, 0, 0)
                gB = DWv; gC = DV
                cuMemcpyHtoD_v2(GM + 8, loc(gB), 8); cuMemcpyHtoD_v2(GM + 16, loc(gC), 8)
                cuda_launch4i(from<loc<CVoid>>(addr(gfn)), (gM * gN + 255) / 256, 1, 1, 256, 1, 1, GM, 0, 0, 0)
                # 3. the joint q+gate SPLIT: per head the projection carries q then gate
                put_i(AP1, 0, DQG) ; put_i(AP1, 8, DQ) ; put_i(AP1, 16, DGT)
                put_i(AP1, 24, S) ; put_i(AP1, 32, H) ; put_i(AP1, 40, HD)
                cuda_launch4i(from<loc<CVoid>>(addr(hsplit)), (S * NQ + 255) / 256, 1, 1, 256, 1, 1, AP1, 0, 0, 0)
                # 4. the two per-head RMS norms (rows of HD), as llama.cpp's attention does
                rA = DQ; rB = Nq; rC = DQN; gM = S * H; gN = HD
                cuMemcpyHtoD_v2(RN + 0, loc(rA), 8); cuMemcpyHtoD_v2(RN + 8, loc(rB), 8); cuMemcpyHtoD_v2(RN + 16, loc(rC), 8)
                cuMemcpyHtoD_v2(RN + 24, loc(gM), 8); cuMemcpyHtoD_v2(RN + 32, loc(gN), 8); cuMemcpyHtoD_v2(RN + 40, loc(EPS), 8)
                cuda_launch4i(from<loc<CVoid>>(addr(rfn)), (S * H * HD + 255) / 256, 1, 1, 256, 1, 1, RN, 0, 0, 0)
                rA = DK; rB = Nk; rC = DKN; gM = S * KVH; gN = HD
                cuMemcpyHtoD_v2(RN + 0, loc(rA), 8); cuMemcpyHtoD_v2(RN + 8, loc(rB), 8); cuMemcpyHtoD_v2(RN + 16, loc(rC), 8)
                cuMemcpyHtoD_v2(RN + 24, loc(gM), 8); cuMemcpyHtoD_v2(RN + 32, loc(gN), 8); cuMemcpyHtoD_v2(RN + 40, loc(EPS), 8)
                cuda_launch4i(from<loc<CVoid>>(addr(rfn)), (S * KVH * HD + 255) / 256, 1, 1, 256, 1, 1, RN, 0, 0, 0)
                # 5. rope over the first NROT dims of each head (rope_nrot's own layout)
                cuMemcpyHtoD_v2(ROP + 0, loc(DQN), 8); cuMemcpyHtoD_v2(ROP + 8, loc(DKN), 8)
                cuMemcpyHtoD_v2(ROP + 16, loc(DQr), 8); cuMemcpyHtoD_v2(ROP + 24, loc(DKr), 8)
                cuMemcpyHtoD_v2(ROP + 32, loc(DF), 8); cuMemcpyHtoD_v2(ROP + 40, loc(S), 8)
                cuMemcpyHtoD_v2(ROP + 48, loc(HD), 8); cuMemcpyHtoD_v2(ROP + 56, loc(H), 8); cuMemcpyHtoD_v2(ROP + 64, loc(KVH), 8)
                # The rope position base the MAIN pass wants is 0. The MTP draft head's is a caller
                # choice, so when MTPM is set this is where it takes effect — setting it BEFORE the
                # loop does not work, because this line overwrites it on every layer (measured: the
                # knob was inert, POS 0/1/2 giving byte-identical results, which is how this was
                # found; the earlier "rope base 1, settled by measurement" claim was therefore wrong).
                if (MTPM == 1) { cuMemcpyHtoD_v2(ROP + 72, loc(MPOS), 8) } else { cuMemcpyHtoD_v2(ROP + 72, loc(zro2), 8) }
                cuMemcpyHtoD_v2(ROP + 80, loc(NROT), 8)
                rt2<Int> = S * H * HD + S * KVH * HD
                cuda_launch4i(from<loc<CVoid>>(addr(rpfn)), (rt2 + 255) / 256, 1, 1, 256, 1, 1, ROP, 0, 0, 0)
                # 6. causal attention; the kv head for query head h is h/(H/KVH)
                cuMemcpyHtoD_v2(ATT + 80, loc(DQr), 8); cuMemcpyHtoD_v2(ATT + 88, loc(DKr), 8)
                cuMemcpyHtoD_v2(ATT + 96, loc(DV), 8); cuMemcpyHtoD_v2(ATT + 104, loc(DCtx), 8)
                cuMemcpyHtoD_v2(ATT + 184, loc(S), 8); cuMemcpyHtoD_v2(ATT + 200, loc(HD), 8)
                cuMemcpyHtoD_v2(ATT + 208, loc(H), 8); cuMemcpyHtoD_v2(ATT + 216, loc(KVH), 8)
                cuda_launch4i(from<loc<CVoid>>(addr(afn)), (S * H + 255) / 256, 1, 1, 256, 1, 1, ATT, 0, 0, 0)
                # 7. the OUTPUT GATE: gated = attn * sigmoid(gate)
                put_i(AP1, 0, DCtx) ; put_i(AP1, 8, DGT) ; put_i(AP1, 16, DGD) ; put_i(AP1, 24, S * NQ)
                cuda_launch4i(from<loc<CVoid>>(addr(hgmul)), (S * NQ + 255) / 256, 1, 1, 256, 1, 1, AP1, 0, 0, 0)
                # 8. wo and the residual into X1 (what the shared FFN consumes)
                gA = DGD; gB = DWo; gC = DO; gM = S; gN = D; gK = NQ
                cuMemcpyHtoD_v2(GM + 0, loc(gA), 8); cuMemcpyHtoD_v2(GM + 8, loc(gB), 8); cuMemcpyHtoD_v2(GM + 16, loc(gC), 8)
                cuMemcpyHtoD_v2(GM + 24, loc(gM), 8); cuMemcpyHtoD_v2(GM + 32, loc(gN), 8); cuMemcpyHtoD_v2(GM + 40, loc(gK), 8)
                cuMemcpyHtoD_v2(GM + 48, loc(ac1), 8); cuMemcpyHtoD_v2(GM + 56, loc(bc1), 8)
                cuda_launch4i(from<loc<CVoid>>(addr(gfn)), (gM * gN + 255) / 256, 1, 1, 256, 1, 1, GM, 0, 0, 0)
                cuda_launch4i(from<loc<CVoid>>(addr(refn)), (S * D + 255) / 256, 1, 1, 256, 1, 1, XI, DO, X1, S * D)
                cuCtxSynchronize()
                if (APR >= 0) {
                    dump_section(DQG, S * 2 * NQ, "a1_", "qg")
                    dump_section(DQ, S * NQ, "a1_", "q_pre")
                    dump_section(DGT, S * NQ, "a1_", "gate_pre")
                    dump_section(DQN, S * NQ, "a1_", "q_norm")
                    dump_section(DQr, S * NQ, "a1_", "q_rope")
                    dump_section(DKN, S * NKV, "a1_", "k_norm")
                    dump_section(DKr, S * NKV, "a1_", "k_rope")
                    dump_section(DCtx, S * NQ, "a1_", "attn")
                    dump_section(DGD, S * NQ, "a1_", "gated")
                    dump_section(DO, S * D, "a1_", "out")
                    println("ATTN_PROBE_DONE blk." + L.to_string() + " tokens=" + S.to_string()
                            + " H=" + H.to_string() + " KVH=" + KVH.to_string() + " HD=" + HD.to_string())
                    # The FFN half of the block is not run HERE on purpose: this check is about the
                    # attention authority, whose last stage is `out` (the wo output, pre-residual).
                    # Ridge's FFN (IQ2_S/IQ3_S) is covered by its own probe — VYB_FFN_PROBE, P4.10 —
                    # and the whole-model loop falls through to the same run_ffn at the tail of this
                    # block, so an attention LAYER is covered end to end by P4.9 + P4.10 together.
                    return 0
                }
            } else {
            e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".attn_q.weight", DPK, PF, DWq, q4fn, q5fn, q6fn, efn, D, GK); if (e != 0) { return 70 }
            e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".attn_k.weight", DPK, PF, DWk, q4fn, q5fn, q6fn, efn, D, GK); if (e != 0) { return 71 }
            e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".attn_v.weight", DPK, PF, DWv, q4fn, q5fn, q6fn, efn, D, GK); if (e != 0) { return 72 }
            e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".attn_output.weight", DPK, PF, DWo, q4fn, q5fn, q6fn, efn, NQ, GK); if (e != 0) { return 73 }
            e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".ffn_gate.weight", DPK, PF, DWg, q4fn, q5fn, q6fn, efn, D, GK); if (e != 0) { return 74 }
            e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".ffn_up.weight", DPK, PF, DWu, q4fn, q5fn, q6fn, efn, D, GK); if (e != 0) { return 75 }
            e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".ffn_down.weight", DPK, PF, DWd, q4fn, q5fn, q6fn, efn, FF, GK); if (e != 0) { return 76 }
            e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".attn_norm.weight", DPK, PF, N1, q4fn, q5fn, q6fn, efn, 0, GK); if (e != 0) { return 77 }
            e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".attn_q_norm.weight", DPK, PF, Nq, q4fn, q5fn, q6fn, efn, 0, GK); if (e != 0) { return 78 }
            e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".attn_k_norm.weight", DPK, PF, Nk, q4fn, q5fn, q6fn, efn, 0, GK); if (e != 0) { return 79 }
            e = stage_one(MODEL, nmv, ofv, nlv, tyv, "blk." + L.to_string() + ".ffn_norm.weight", DPK, PF, N2, q4fn, q5fn, q6fn, efn, 0, GK); if (e != 0) { return 80 }

            e = run_layer_attn(S, D, H, KVH, HD, NROT, FF, NQ, NKV, EPS, XI, XO,
                          gfn, rfn, rpfn, afn, sfn, refn, GM, RN, ATT, ROP,
                          N1, DWq, DWk, DWv, Nq, Nk, DF, DWo, N2, DWg, DWu, DWd,
                          XN, DQ, DK, DV, DQN, DKN, DQr, DKr, DCtx, DO, X1, X1N, Gr, Up, Hu, M)
            if (e != 0) { return 81 }
            }
            }
            e = run_ffn(S, D, FF, gfn, rfn, sfn, refn, GM, RN, EPS,
                        X1, N2, DWg, DWu, DWd, X1N, Gr, Up, Hu, M, XO)
            if (e != 0) { return 82 }
            if (LTR == 1) {
                match (open_write("native/out/ridge_trace_L" + L.to_string() + ".txt")) {
                    tw -> {
                        tj2<Int> = 0
                        for (tj2 in 0..S * 3 - 1) {
                            tv<Float> = 0.0
                            if (cuMemcpyDtoH_v2(loc(tv), XI + (tj2 / 3) * D * 8 + (tj2 % 3) * 8, 8) != 0) { return 16 }
                            match (write_str(tw, tv.to_string() + "\n")) { q -> { } ? -> { return 17 } }
                        }
                        close(tw)
                    }
                    ? -> { return 17 }
                }
            }
            tl2<Int> = XI; XI = XO; XO = tl2
            }
            # Progress heartbeat. This 36-layer staging loop runs for minutes and was silent
            # between EMBED_PROBE_DONE and PREFILL_HIDDEN_DONE, so a slow-but-working run was
            # indistinguishable from a hang (it has been mistaken for one, and killed).
            if (L % 4 == 3) { pnl<Int> = L + 1; println("PREFILL_LAYER " + pnl.to_string() + "/" + NTL.to_string()) }
        }

        # ---- probe mode ends here: one block ran through the loop's own dispatch, staging and
        # chain, and the stages are already dumped. The rest of this file (lm_head, the written
        # outputs, the chat loop) belongs to a whole-model run.
        if (PR >= 0) {
            println("GDN_PROBE_DONE blk." + PR.to_string() + " tokens=" + S.to_string()
                    + " NE=" + GNE.to_string() + " S=" + GSS.to_string() + " Hk=" + GHK.to_string()
                    + " Hv=" + GHV.to_string() + " d_conv=" + GDC.to_string())
            return 0
        }

        # ---- write final 36-layer hidden (now in XI) ----
        cuCtxSynchronize()
        match (open_write("native/out/prefill_hidden_vyb.txt")) {
            w -> {
                rv<Float> = 0.0
                i = 0
                for (i in 0..S * D - 1) {
                    rv = 0.0
                    if (cuMemcpyDtoH_v2(loc(rv), XI + i * 8, 8) != 0) { return 16 }
                    match (write_str(w, rv.to_string() + "\n")) { q -> { } ? -> { return 17 } }
                }
                close(w)
            }
            ? -> { return 17 }
        }
        println("PREFILL_HIDDEN_DONE (layers=" + MAXL.to_string() + ")")

        if (DOLM == 1) {
            i0 = find_nm(nmv, "output_norm.weight")
            on_off<Int> = ofv.get(i0); on_nl<Int> = nlv.get(i0)
            e = load_norm(MODEL, PF, DPK, ON, on_off, on_nl, efn); if (e != 0) { return 90 }
            rA = XI; rB = ON; rC = DH
            # W4: the draft head normalises with its OWN `nextn.shared_head_norm` (llama.cpp falls
            # back to output_norm only when the tensor is absent), so the shared head sees the same
            # kind of input either way but from a different weight.
            if (MTPM == 1) { rB = MSN }
            cuMemcpyHtoD_v2(RN + 0, loc(rA), 8); cuMemcpyHtoD_v2(RN + 8, loc(rB), 8); cuMemcpyHtoD_v2(RN + 16, loc(rC), 8)
            cuMemcpyHtoD_v2(RN + 24, loc(S), 8); cuMemcpyHtoD_v2(RN + 32, loc(D), 8); cuMemcpyHtoD_v2(RN + 40, loc(EPS), 8)
            cuda_launch4i(from<loc<CVoid>>(addr(rfn)), (S * D + 255) / 256, 1, 1, 256, 1, 1, RN, 0, 0, 0)

            # DE (token_embd gather table) is already populated by the up-front embed.

            if (UT == 1) {
                # ---- the UNTIED head, chunk by chunk. The table is output.weight (Q6_K,
                # VOCAB x D = 248320 x 5120): 10.2 GB as f64, so it is never held whole. Each chunk is
                # CH vocab rows, dequantised into DCH as [D, CH] by the same kernel the tied path uses
                # for a whole table; that chunk's logits for every position come from logits_slice
                # pointed AT THE CHUNK (its V = the chunk's row count, so the output is one chunk-local
                # row), and argmax_acc folds them into the running (best value, best index) per
                # position with the chunk's global base. A tie keeps the earlier index, which is
                # argmax_row's own rule, so this and a whole-table head agree on ties.
                vs0<Int> = 0
                rows<Int> = 0
                zz0<Int> = 0
                nblk2<Int> = D / 256
                seedv<Float> = -1.0e308
                seedi<Int> = 0
                iq2<Int> = 0
                for (iq2 in 0..S - 1) {
                    put_f(DBV, iq2 * 8, seedv)
                    put_i(DAO, iq2 * 8, seedi)
                }
                while (vs0 < VOCAB) {
                    rows = CH
                    if (vs0 + CH > VOCAB) { rows = VOCAB - vs0 }
                    # ONE ROW IS (D/256) PACKED BLOCKS = 4200 B for Ridge (Q6_K, 210 B per 256
                    # values), so the byte offset of vocab row vs0 is vs0 * nblk2 * 210 and the
                    # chunk's length is rows * nblk2 * 210. The missing nblk2 factor was the whole
                    # bug: with (vs0/256)*210 the chunk read ~5120x too few bytes from ~5120x too
                    # early, the dequant then expanded the whole chunk out of a 13 KB window, and
                    # every logit came from garbage — while the HIDDEN was already correct at
                    # cos 0.9996, so the top1 was wrong for a reason no hidden check could see.
                    nb2<Int> = rows * nblk2 * 210
                    pkd<String> = read_model(MODEL, out_off + vs0 * nblk2 * 210, nb2)
                    if (pkd.len() < nb2) { println("LMHEAD_ERR short read at " + vs0.to_string()); return 92 }
                    if (download(pkd, DPK, nb2) != 0) { return 15 }
                    # NATURAL (non-transposed) dequant, inz=0: `logits_slice` reads its table as
                    # Emb[vs*D + d], i.e. ROW-MAJOR [rows, D] — exactly the order the packed chunk
                    # already has ([vocab, D] out-major in the file) — and exactly what the TIED
                    # path's whole-table dequant (emb_dequant, also inz=0) produces. Asking for the
                    # transposed write (inz=D) here put the chunk in [D, rows] and every dot product
                    # then multiplied the wrong pairs: the argmax came out of an unscrambled table.
                    rcq<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(q6fn)), (D * rows + 255) / 256, 1, 1, 256, 1, 1, DPK, DCH, D * rows, 0)
                    if (rcq != 0) { println("LMHEAD_ERR dequant rc=" + (rcq as Int).to_string()); return 92 }
                    s7 = 0
                    for (s7 in 0..S - 1) {
                        cuMemcpyHtoD_v2(GM + 0, loc(DH), 8); cuMemcpyHtoD_v2(GM + 8, loc(DCH), 8); cuMemcpyHtoD_v2(GM + 16, loc(DCL), 8)
                        cuMemcpyHtoD_v2(GM + 24, loc(s7), 8); cuMemcpyHtoD_v2(GM + 32, loc(D), 8)
                        cuMemcpyHtoD_v2(GM + 40, loc(zz0), 8); cuMemcpyHtoD_v2(GM + 48, loc(rows), 8); cuMemcpyHtoD_v2(GM + 56, loc(rows), 8)
                        rc_sl = cuda_launch4i(from<loc<CVoid>>(addr(lsfn)), (rows + 255) / 256, 1, 1, 256, 1, 1, GM, 0, 0, 0)
                        if (rc_sl != 0) { println("LMHEAD_ERR logits rc=" + (rc_sl as Int).to_string()); return 92 }
                    }
                    cuMemcpyHtoD_v2(A4 + 0, loc(DCL), 8); cuMemcpyHtoD_v2(A4 + 8, loc(DBV), 8); cuMemcpyHtoD_v2(A4 + 16, loc(DAO), 8)
                    cuMemcpyHtoD_v2(A4 + 24, loc(S), 8); cuMemcpyHtoD_v2(A4 + 32, loc(rows), 8); cuMemcpyHtoD_v2(A4 + 40, loc(vs0), 8)
                    rc_aa<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(accfn)), (S + 255) / 256, 1, 1, 256, 1, 1, A4, 0, 0, 0)
                    if (rc_aa != 0) { println("LMHEAD_ERR argmax_acc rc=" + (rc_aa as Int).to_string()); return 92 }
                    vs0 = vs0 + rows
                }
                cuCtxSynchronize()
                # hand the S winners to AO — the buffer the shared tail below (the written top1 file
                # and the chat decode) already reads — so nothing after this needs a branch.
                iv3<Int> = 0
                iu3<Int> = 0
                for (iu3 in 0..S - 1) {
                    iv3 = 0
                    if (cuMemcpyDtoH_v2(loc(iv3), DAO + iu3 * 8, 8) != 0) { return 16 }
                    if (cuMemcpyHtoD_v2(AO + iu3 * 8, loc(iv3), 8) != 0) { return 15 }
                }
                println("LMHEAD_MODE=untied-chunked chunk_rows=" + CH.to_string() + " chunks=" + ((VOCAB + CH - 1) / CH).to_string())
                match (open_write("native/out/prefill_top1_vyb.txt")) {
                    w -> {
                        iv<Int> = 0
                        i = 0
                        for (i in 0..S - 1) {
                            iv = 0
                            if (cuMemcpyDtoH_v2(loc(iv), AO + i * 8, 8) != 0) { return 16 }
                            match (write_str(w, iv.to_string() + "\n")) { q -> { } ? -> { return 17 } }
                        }
                        close(w)
                    }
                    ? -> { return 17 }
                }
                println("LMHEAD_TOP1_DONE")
            } else {
            # logits via logits_slice (chunked vocab slices; large-grid kernels truncate)
            LCH<Int> = 16384
            s7<Int> = 0
            vs2<Int> = 0
            ve2<Int> = 0
            rc_sl<CInt> = 0
            for (s7 in 0..S - 1) {
                vs2 = 0
                while (vs2 < VOCAB) {
                    ve2 = vs2 + LCH
                    if (ve2 > VOCAB) { ve2 = VOCAB }
                    cuMemcpyHtoD_v2(GM + 0, loc(DH), 8); cuMemcpyHtoD_v2(GM + 8, loc(DE), 8); cuMemcpyHtoD_v2(GM + 16, loc(DL), 8)
                    cuMemcpyHtoD_v2(GM + 24, loc(s7), 8); cuMemcpyHtoD_v2(GM + 32, loc(D), 8)
                    cuMemcpyHtoD_v2(GM + 40, loc(vs2), 8); cuMemcpyHtoD_v2(GM + 48, loc(ve2), 8); cuMemcpyHtoD_v2(GM + 56, loc(VOCAB), 8)
                    rc_sl = cuda_launch4i(from<loc<CVoid>>(addr(lsfn)), (ve2 - vs2 + 255) / 256, 1, 1, 256, 1, 1, GM, 0, 0, 0)
                    if (rc_sl != 0) { println("LMDBG logits_slice rc=" + (rc_sl as Int).to_string()); return 92 }
                    vs2 = ve2
                }
            }

            cuMemcpyHtoD_v2(A4 + 0, loc(DL), 8); cuMemcpyHtoD_v2(A4 + 8, loc(AO), 8)
            cuMemcpyHtoD_v2(A4 + 16, loc(S), 8); cuMemcpyHtoD_v2(A4 + 24, loc(VOCAB), 8)
            rc_ar<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(arfn)), (S + 255) / 256, 1, 1, 256, 1, 1, A4, 0, 0, 0)
            println("LMDBG argmax rc=" + (rc_ar as Int).to_string())
            cuCtxSynchronize()

            match (open_write("native/out/prefill_top1_vyb.txt")) {
                w -> {
                    iv<Int> = 0
                    i = 0
                    for (i in 0..S - 1) {
                        iv = 0
                        if (cuMemcpyDtoH_v2(loc(iv), AO + i * 8, 8) != 0) { return 16 }
                        match (write_str(w, iv.to_string() + "\n")) { q -> { } ? -> { return 17 } }
                    }
                    close(w)
                }
                ? -> { return 17 }
            }
            println("LMHEAD_TOP1_DONE")
            }

            # ---- llm.chat: decode the real-model argmax continuation to text
            # via the stdlib/vllm CPU head (llm:: facade). Closes the
            # CPU(stdlib/vllm) <-> GPU(36-layer forward) loop on the REAL model.
            dir<String> = env_get("VYB_LLM_DIR") else "artifacts/vybos-configurator-lora"
            m<Model> = llm_load("qwen3", dir)
            ids<Vec<Int>> = Vec()
            ict<Int> = 0
            ivd<Int> = 0
            for (ict in 0..S - 1) {
                ivd = 0
                if (cuMemcpyDtoH_v2(loc(ivd), AO + ict * 8, 8) != 0) { return 16 }
                ids.push(ivd)
            }
            resp<String> = llm_decode(m, ids)
            println("LLM_CHAT_TOP1_IDS=" + ids.get(0).to_string() + "," + ids.get(S - 1).to_string())
            println("LLM_CHAT_RESPONSE=<" + resp + ">")
        }

        println("MODEL_PREFILL_DONE")
        return 0
    }

    return 0
}
