// p6r13_step0 — STEP 0 of the batched attention build: prove ONE known BF16 word
// round-trips from the checkpoint to the host through the upload path.
//
// The on-disk first word of layers.3.self_attn.kv_a_proj_with_mqa.weight is
// 0xBC30 little-endian, which as BF16 is exactly -0.0107422. If the device
// reports that value, the upload and the conversion are both sound and the
// attention projections can be built on top. If not, nothing else is worth doing.
// env: P6_DIR
import io::{open_read, read_all, close}
import env::{env_get}
import tensor::{tensor_init, dev_alloc, bulk_dtoh, sync}
import gx::{gx_read}
import cuda_binding::{cuMemcpyHtoD_v2, cuMemAlloc_v2, cuMemFree_v2, cuCtxSynchronize}
import glm_engine::{load_fn, gx_resolve_tab, launch_kernel, wr_pdev, deq_bf16}

# Declaring the extern in THIS module is what enables the String -> loc<CVoid>
# conversion. Importing it is not enough: the binding's comment says an importer
# does not inherit the pointer intrinsics, so the String arg arrives as its
# STRUCT (a host pointer) -- which is exactly the 2.22e31 pointer-bit garbage.
extern "C" {
    cuMemcpyHtoD_v2(dstDevice<Int>, srcHost<loc<CVoid>>, ByteCount<Int>)<CInt>
}

main()<Int> -> {
    dir<String> = env_get("P6_DIR") else "/srv/models/hf/hub/models--Mia-AiLab--GLM-5.3-Flash-EXL3-4bpw-TensorFold/snapshots/078455ffe6472f9a52fbc1139f58b9db2881b25c"
    if (tensor_init() != 0) { println("S0_FAIL cuda"); return 1 }
    f<Int> = load_fn("native/build/tobg.ptx", "tobg")
    if (f == 0) { println("S0_FAIL fn"); return 2 }

    cs<String> = ""
    match (open_read("native/out/gx_tabs.cache")) {
        fr -> { match (read_all(fr)) { s -> { cs = s } ? -> { return 3 } } close(fr) }
        ? -> { println("S0_FAIL tabcache"); return 3 }
    }
    nl0<Int> = find_from(cs, "\n", 0)
    pos<Int> = nl0 + 1
    tab3<String> = ""
    var<Int> ti = 0
    while (ti < 45) {
        nl<Int> = find_from(cs, "\n", pos)
        if (nl < 0) { println("S0_FAIL trunc"); return 3 }
        plen<Int> = cs.substring(pos, nl).to_int()
        if (ti == 3) { tab3 = cs.substring(nl + 1, nl + 1 + plen) }
        pos = nl + 1 + plen
        ti = ti + 1
    }

    K<Int> = 4096
    nm<String> = "model.language_model.layers.3.self_attn.kv_a_proj_with_mqa.weight"
    w1<Vec<String>> = Vec()
    w1.push(nm)
    ge<GxLoc> = gx_resolve_tab(tab3, dir, 83, w1)
    fnd<Int> = ge.found.get(0)
    # ONE read per GxLoc
    g0<String> = gx_read(ge, 0)
    println("S0 found=" + fnd.to_string() + " bytes=" + g0.len().to_string())
    println("S0 host bytes: " + (g0.char_at(0) as Int).to_string() + "," + (g0.char_at(1) as Int).to_string() + "," + (g0.char_at(2) as Int).to_string() + "," + (g0.char_at(3) as Int).to_string())

    # first 8 elements only: 16 bytes
    dS<Int> = dev_alloc(64)
    dD<Int> = dev_alloc(64)
    pb<Int> = dev_alloc(32)
    if (dS == 0 || dD == 0 || pb == 0) { println("S0_FAIL alloc"); return 4 }
    # upload straight from the String gx_read returned (the way the working
    # trellis path does); a substring() copy was the source of corrupted bytes
    # CAPTURE the return code: silent failures here are exactly what a
    # never-written destination looks like
    # the dedicated raw-bytes helper: it takes the String's DATA pointer and
    # copies inside a freedom block (this is what the trellis path uses)
    # INSIDE a freedom block the String->loc<CVoid> conversion is in scope, which
    # is exactly what cuda_memcpy_h2d does internally. At top level the String is
    # passed as its STRUCT (a pointer), which is why the device held junk.
    # call the binding's own helper: the String->pointer conversion only works
    # inside the module that declares the FFI pointer functions
    # (the hand-rolled copy is gone: deq_bf16 below does the upload itself,
    #  the way glm_engine:299 does -- String passed straight to cuMemcpyHtoD_v2)
    # ---- THE REAL TEST: the engine's own decoder with z = row width.
    # bf16.vyb stores f64 when z > 0 and f32 when z == 0; bulk_dtoh reads f64.
    # z = K (row width) is how glm_engine calls it, and it is the f64 branch.
    fbf<Int> = load_fn("native/build/bf16.ptx", "bf16deq")   # f64 twin, linear when z=0
    dF3<Int> = deq_bf16(fbf, g0, 512 * K, 0)
    sync()
    if (dF3 == 0) { println("S0_FAIL deq_bf16 returned 0"); return 5 }
    W3<Vec<Float>> = bulk_dtoh(dF3, 8)
    println("S0 DECODED first=" + W3.get(0).to_string_precise() + " second=" + W3.get(1).to_string_precise() + "  (expect -0.010742188 0.013793945)")
    d0<Float> = W3.get(0) + 0.0107421875
    if (d0 < 0.0) { d0 = 0.0 - d0 }
    if (d0 < 1e-9) { println("S0_PASS bf16 round-trip verified: 0xBC30 -> -0.0107421875") }
    else { println("S0_FAIL expected -0.0107421875 got " + W3.get(0).to_string_precise()) }
    println("S0_DONE")
    return 0
}

find_from(s<String>, needle<String>, start<Int>)<Int> -> {
    n<Int> = s.len()
    m<Int> = needle.len()
    i<Int> = start
    while (i <= n - m) {
        ok<Int> = 1
        j<Int> = 0
        while (j < m) {
            if (s.char_at(i + j) != needle.char_at(j)) { ok = 0 ; j = m }
            j = j + 1
        }
        if (ok == 1) { return i }
        i = i + 1
    }
    return 0 - 1
}
