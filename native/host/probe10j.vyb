# probe10j: is a cross-module-returned Vec slow to .get()?
import probe10emod::{maken}
import io::{open_append, write_str, close}

SCALE40<Float> = 1099511627776.0

di(v<Float>)<Int> -> {
    return (v * SCALE40) as Int
}

dumpit(v<Vec<Float>>)<Int> -> {
    match (open_append("/tmp/probe10j.txt")) {
        f -> {
            i<Int> = 0
            chunk<String> = ""
            while (i < v.len()) {
                chunk = chunk + " " + di(v.get(i)).to_string()
                if (chunk.len() > 2048) { write_str(f, chunk); chunk = "" }
                i = i + 1
            }
            write_str(f, chunk)
            close(f)
            return 0
        }
        ? -> { return 1 }
    }
}

main()<Int> -> {
    n<Int> = 327680
    # case A: built locally in main (the gate's shape)
    v3<Vec<Float>> = Vec()
    i<Int> = 0
    while (i < n) { v3.push(0.5); i = i + 1 }
    println("A local-built")
    t1<Int> = dumpit(v3)
    println("A done")
    # case B: returned from a cross-module call (the serve's shape)
    v2<Vec<Float>> = maken(n)
    println("B module-returned")
    t1 = dumpit(v2)
    println("B done")
    return 0
}
