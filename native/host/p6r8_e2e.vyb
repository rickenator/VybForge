// p6r8_e2e — the MINIMAL end-to-end check of the fused matvec, no modes, no
// old paths: x = e_0  ->  xp = su.(H x)  ->  yraw = T xp  ->  y = sv.(H yraw)
// compared against the ONE-HOT ROW of the verified deq buffer (y[n] = B[0][n]).
// Everything else in the fused debugging lives in p6r5; this file exists so the
// question has exactly one answer.
// env: P6_DIR, P6_EXP
import io::{open_read, read_all, close}
import env::{env_get}
import time::{time_mono_millis}
import tensor::{tensor_init, dev_alloc, bulk_htod, bulk_dtoh}
import gx::{gx_read}
import glm_engine::{load_fn, had_hoist32, mapdev_build, exl3_deq32f_into, gx_resolve_tab, launch_kernel, wr_pdev, alloc_dev, free_dev, H}

main()<Int> -> {
    dir<String> = env_get("P6_DIR") else "/srv/models/hf/hub/models--Mia-AiLab--GLM-5.3-Flash-EXL3-4bpw-TensorFold/snapshots/078455ffe6472f9a52fbc1139f58b9db2881b25c"
    expS<String> = env_get("P6_EXP") else "153"
    e<Int> = 0
    i<Int> = 0
    while (i < expS.len()) {
        c<Int> = (expS.char_at(i) as Int) & 255
        if (c >= 48 && c <= 57) { e = e * 10 + (c - 48) }
        i = i + 1
    }
    if (tensor_init() != 0) { println("E2E_FAIL cuda"); return 1 }
    fdqs4<Int> = load_fn("native/build/exl3dq.ptx", "exl3dq1s4")
    fhad232<Int> = load_fn("native/build/exl3.ptx", "exl3had232")
    fhgen32<Int> = load_fn("native/build/exl3.ptx", "exl3hgen32")
    finvk<Int> = load_fn("native/build/exl3.ptx", "exl3inv")
    fcast32<Int> = load_fn("native/build/layer.ptx", "cast32")
    fxh<Int> = load_fn("native/build/exl3mv.ptx", "exl3xhat")
    fmv<Int> = load_fn("native/build/exl3mv.ptx", "exl3mv1s4")
    fyh<Int> = load_fn("native/build/exl3mv.ptx", "exl3yhat")
    fcv<Int> = load_fn("native/build/dbg_sh.ptx", "f32t64")
    if (fdqs4 == 0 || fhad232 == 0 || fhgen32 == 0 || finvk == 0 || fcast32 == 0) { println("E2E_FAIL kernels"); return 2 }
    if (fxh == 0 || fmv == 0 || fyh == 0 || fcv == 0) { println("E2E_FAIL mvkernels"); return 2 }
    hd_pre32<Int> = had_hoist32(fhgen32)
    if (hd_pre32 == 0) { println("E2E_FAIL hadhoist"); return 3 }
    mapd<String> = ""
    match (open_read("native/exl3/map.bin")) {
        f -> { match (read_all(f)) { s -> { mapd = s } ? -> { return 4 } } close(f) }
        ? -> { println("E2E_FAIL map.bin"); return 4 }
    }
    mapbody<String> = mapd.substring(16, mapd.len())
    nbmap<Int> = mapd.len() - 16
    mapdev<Int> = mapdev_build(finvk, mapd)
    if (mapdev == 0) { println("E2E_FAIL mapdev"); return 5 }
    invbase<Int> = mapdev + 16 + nbmap
    arA<Int> = dev_alloc(8388608)     // trellis
    arB<Int> = dev_alloc(65536)
    arC<Int> = dev_alloc(33554432)    // deq output W
    arD<Int> = dev_alloc(33554432)
    arG<Int> = dev_alloc(16384)       // su
    arH<Int> = dev_alloc(16384)       // sv
    arI<Int> = dev_alloc(64)
    pb32<Int> = dev_alloc(192)
    pbx<Int> = dev_alloc(64)
    pbm<Int> = dev_alloc(160)
    pby<Int> = dev_alloc(48)
    bx<Int> = dev_alloc(16384)
    bxp<Int> = dev_alloc(16384)
    byr<Int> = dev_alloc(8192)
    by<Int> = dev_alloc(16384)
    dscr<Int> = dev_alloc(33554432)   // the mv dump target (never read)
    if (arA == 0 || arC == 0 || arG == 0 || arH == 0 || pb32 == 0 || bx == 0 || bxp == 0 || byr == 0 || by == 0 || dscr == 0) {
        println("E2E_FAIL arena")
        return 6
    }
    // Zero every work buffer up front: initcheck flagged uninitialised GLOBAL
    // reads inside exl3xhat, i.e. some buffer it consumes is not fully written
    // before the read. Zeroing makes the offender visible (it will still report
    // on whatever remains never-written) and rules out stale-memory noise.
    cuMemcpyHtoD_v2(bx, zero_bytes(16384), 16384)
    cuMemcpyHtoD_v2(bxp, zero_bytes(16384), 16384)
    cuMemcpyHtoD_v2(byr, zero_bytes(8192), 8192)
    cuMemcpyHtoD_v2(by, zero_bytes(16384), 16384)
    cuMemcpyHtoD_v2(arG, zero_bytes(16384), 16384)
    cuMemcpyHtoD_v2(arH, zero_bytes(16384), 16384)
    println("E2E zeroed work buffers")
    println("E2E ptrs bx=0x" + hexv(bx) + " bxp=0x" + hexv(bxp) + " H=0x" + hexv(hd_pre32) + " arG=0x" + hexv(arG) + " byr=0x" + hexv(byr))
    // tab (layer 3)
    cache_path<String> = env_get("VYBFORGE_TAB_CACHE") else "native/out/gx_tabs.cache"
    cs<String> = ""
    match (open_read(cache_path)) {
        f -> { match (read_all(f)) { s -> { cs = s } ? -> { return 4 } } close(f) }
        ? -> { println("E2E_FAIL tabcache"); return 4 }
    }
    nl0<Int> = find_from(cs, "\n", 0)
    pos<Int> = nl0 + 1
    tab3<String> = ""
    ti<Int> = 0
    while (ti < 45) {
        nl<Int> = find_from(cs, "\n", pos)
        if (nl < 0) { println("E2E_FAIL tab_trunc"); return 5 }
        plen<Int> = cs.substring(pos, nl).to_int()
        if (ti == 3) { tab3 = cs.substring(nl + 1, nl + 1 + plen) }
        pos = nl + 1 + plen
        ti = ti + 1
    }
    epre<String> = "model.language_model.layers.3.mlp.experts." + e.to_string() + ".gate_proj."
    w2<Vec<String>> = Vec()
    w2.push(epre + "trellis")
    w2.push(epre + "suh")
    w2.push(epre + "svh")
    ge<GxLoc> = gx_resolve_tab(tab3, dir, 83, w2)
    g0<String> = gx_read(ge, 0)
    g1<String> = gx_read(ge, 1)
    g2<String> = gx_read(ge, 2)
    println("E2E tensors trellis=" + g0.len().to_string() + " suh=" + g1.len().to_string() + " svh=" + g2.len().to_string())
    cuMemcpyHtoD_v2(arA, g0, g0.len())
    cuMemcpyHtoD_v2(arG, g1, g1.len())
    cuMemcpyHtoD_v2(arH, g2, g2.len())
    // x = e_0 -> f32 device
    onesm<Bool> = (env_get("P6_ONES") else "0") == "1"
    x<Vec<Float>> = Vec()
    i = 0
    while (i < 4096) {
        if (onesm) { x.push(1.0) } else { if (i == 0) { x.push(1.0) } else { x.push(0.0) } }
        i = i + 1
    }
    d64<Int> = alloc_dev(32768)
    bulk_htod(d64, view(x))
    wr_pdev(pb32, 0, d64)
    wr_pdev(pb32, 8, bx)
    wr_pdev(pb32, 16, 4096)
    launch_kernel(fcast32, 16, pb32)
    cuCtxSynchronize()
    free_dev(d64)
    // ---- SINGLE-CTA ISOLATION (P6_C1=1) ----
    // One CTA (blk 0) covers input rows 0..7 and output columns 0..127. With
    // xp = ones its yraw[n] must equal sum_{k<8} T[k][n] — computable on the host
    // from the PROVEN T. No atomics contention, no cross-CTA confusion.
    if ((env_get("P6_C1") else "0") == "1") {
        fo3<Int> = load_fn("native/build/exl3dqdbg.ptx", "exl3dqdbg1s4")
        if (fo3 == 0) { println("E2E_FAIL oracle"); return 2 }
        bT<Int> = dev_alloc(33554432)
        pbo3<Int> = dev_alloc(64)
        wr_pdev(pbo3, 0, arA)
        wr_pdev(pbo3, 8, mapdev)
        wr_pdev(pbo3, 16, 0)
        wr_pdev(pbo3, 24, bT)
        wr_pdev(pbo3, 32, 2048)
        wr_pdev(pbo3, 40, invbase)
        launch_kernel(fo3, 8192, pbo3)
        cuCtxSynchronize()
        // xp = ones
        ones2<Vec<Float>> = Vec()
        i = 0
        while (i < 4096) { ones2.push(1.0) ; i = i + 1 }
        d64b<Int> = alloc_dev(32768)
        bulk_htod(d64b, view(ones2))
        wr_pdev(pb32, 0, d64b)
        wr_pdev(pb32, 8, bxp)
        wr_pdev(pb32, 16, 4096)
        launch_kernel(fcast32, 16, pb32)
        cuCtxSynchronize()
        free_dev(d64b)
        // ONE CTA (the mv params are set here: this mode runs before the fused path)
        wr_pdev(pbm, 0, byr)
        wr_pdev(pbm, 8, bxp)
        wr_pdev(pbm, 16, arH)
        wr_pdev(pbm, 24, 2048)
        wr_pdev(pbm, 32, 0)
        wr_pdev(pbm, 40, arA)
        wr_pdev(pbm, 48, mapdev)
        wr_pdev(pbm, 56, invbase)
        wr_pdev(pbm, 64, dscr)
        wr_pdev(pbm, 72, 0)
        cuMemcpyHtoD_v2(byr, zero_bytes(8192), 8192)
        r1c<Int> = launch_kernel(fmv, 1, pbm)
        cuCtxSynchronize()
        yr3<Int> = dev_alloc(16384)
        wr_pdev(pb32, 0, byr)
        wr_pdev(pb32, 8, yr3)
        wr_pdev(pb32, 16, 128)
        launch_kernel(fcv, 1, pb32)
        cuCtxSynchronize()
        YR3<Vec<Float>> = bulk_dtoh(yr3, 128)
        // T -> host
        t64c<Int> = dev_alloc(67108864)
        wr_pdev(pb32, 0, bT)
        wr_pdev(pb32, 8, t64c)
        wr_pdev(pb32, 16, 8388608)
        launch_kernel(fcv, 32768, pb32)
        cuCtxSynchronize()
        T3<Vec<Float>> = bulk_dtoh(t64c, 8388608)
        var<Int> ndc = 0
        var<Float> suma = 0.0
        n5<Int> = 0
        while (n5 < 128) {
            ap<Float> = 0.0
            k5<Int> = 0
            while (k5 < 8) {
                ap = ap + T3.get(k5 * 2048 + n5)
                k5 = k5 + 1
            }
            dd5<Float> = ap - YR3.get(n5)
            ad5<Float> = dd5
            if (ad5 < 0.0) { ad5 = 0.0 - ad5 }
            if (ad5 > 1e-4) { ndc = ndc + 1 }
            suma = suma + ad5
            n5 = n5 + 1
        }
        println("E2E ONE_CTA rc=" + r1c.to_string() + " colsum_partial0=" + YR3.get(0).to_string_precise() + " colsum_partial1=" + YR3.get(1).to_string_precise())
        println("E2E ONE_CTA_GATE count_over_1e-4=" + ndc.to_string() + " sum_absdiff=" + suma.to_string_precise())
        // CORRECTED grid walk. The deq tiling maps block -> (rb64 = block/16,
        // nb128 = block%16); one block = 8 CTAs covering rows rb64*64 .. +63 of
        // column block nb128. So with G CTAs (G/8 blocks, rb64 = 0 only for
        // G <= 128) EVERY output column gets a partial over rows 0..63.
        // G=128 is therefore the first VALID multi-block test:
        //   yraw[n] must equal sum_{k<64} T[k][n]   for all n.
        g2<Int> = 128
        cuMemcpyHtoD_v2(byr, zero_bytes(8192), 8192)
        launch_kernel(fmv, g2, pbm)
        cuCtxSynchronize()
        wr_pdev(pb32, 0, byr)
        wr_pdev(pb32, 8, yr3)
        wr_pdev(pb32, 16, 128)
        launch_kernel(fcv, 1, pb32)
        cuCtxSynchronize()
        YG2<Vec<Float>> = bulk_dtoh(yr3, 128)
        var<Int> ndh2 = 0
        n7<Int> = 0
        while (n7 < 128) {
            ap3<Float> = 0.0
            k7<Int> = 0
            while (k7 < 64) {
                ap3 = ap3 + T3.get(k7 * 2048 + n7)
                k7 = k7 + 1
            }
            dg3<Float> = ap3 - YG2.get(n7)
            ad7<Float> = dg3
            if (ad7 < 0.0) { ad7 = 0.0 - ad7 }
            if (ad7 > 1e-3) { ndh2 = ndh2 + 1 }
            n7 = n7 + 1
        }
        println("E2E GRID128 count_over_1e-3=" + ndh2.to_string() + " v0=" + YG2.get(0).to_string_precise())
        // and the FULL grid against the full column sum (the real case)
        cuMemcpyHtoD_v2(byr, zero_bytes(8192), 8192)
        launch_kernel(fmv, 8192, pbm)
        cuCtxSynchronize()
        wr_pdev(pb32, 0, byr)
        wr_pdev(pb32, 8, yr3)
        wr_pdev(pb32, 16, 128)
        launch_kernel(fcv, 1, pb32)
        cuCtxSynchronize()
        YGF<Vec<Float>> = bulk_dtoh(yr3, 128)
        var<Int> ndf = 0
        n8<Int> = 0
        while (n8 < 128) {
            ap4<Float> = 0.0
            k8<Int> = 0
            while (k8 < 4096) {
                ap4 = ap4 + T3.get(k8 * 2048 + n8)
                k8 = k8 + 1
            }
            dg4<Float> = ap4 - YGF.get(n8)
            ad8<Float> = dg4
            if (ad8 < 0.0) { ad8 = 0.0 - ad8 }
            if (ad8 > 1e-3) { ndf = ndf + 1 }
            n8 = n8 + 1
        }
        println("E2E GRIDFULL count_over_1e-3=" + ndf.to_string() + " v0=" + YGF.get(0).to_string_precise())
        return 0
    }
    // ---- XP CHECK (P6_XP=1): xp for x = ones against the host formula ----
    // xp[b] = sum_{j<128} H[(b%128)*128 + j] * su[block(b)+j]   (x == 1)
    if ((env_get("P6_XP") else "0") == "1") {
        ones3<Vec<Float>> = Vec()
        i = 0
        while (i < 4096) { ones3.push(1.0) ; i = i + 1 }
        d64c<Int> = alloc_dev(32768)
        bulk_htod(d64c, view(ones3))
        wr_pdev(pb32, 0, d64c)
        wr_pdev(pb32, 8, bx)
        wr_pdev(pb32, 16, 4096)
        launch_kernel(fcast32, 16, pb32)
        cuCtxSynchronize()
        free_dev(d64c)
        wr_pdev(pbx, 0, bx)
        wr_pdev(pbx, 8, bxp)
        wr_pdev(pbx, 16, hd_pre32)
        wr_pdev(pbx, 24, arG)
        wr_pdev(pbx, 32, 4096)
        launch_kernel(fxh, 32, pbx)
        cuCtxSynchronize()
        // xp -> host
        xp64<Int> = dev_alloc(32768)
        wr_pdev(pb32, 0, bxp)
        wr_pdev(pb32, 8, xp64)
        wr_pdev(pb32, 16, 4096)
        launch_kernel(fcv, 16, pb32)
        cuCtxSynchronize()
        XP<Vec<Float>> = bulk_dtoh(xp64, 4096)
        // H -> host
        h64<Int> = dev_alloc(131072)
        wr_pdev(pb32, 0, hd_pre32)
        wr_pdev(pb32, 8, h64)
        wr_pdev(pb32, 16, 16384)
        launch_kernel(fcv, 64, pb32)
        cuCtxSynchronize()
        HX<Vec<Float>> = bulk_dtoh(h64, 16384)
        var<Int> ndx = 0
        var<Float> mxx = 0.0
        b9<Int> = 0
        while (b9 < 4096) {
            d9<Int> = b9 % 128
            base9<Int> = b9 - d9
            acc9<Float> = 0.0
            j9<Int> = 0
            while (j9 < 128) {
                acc9 = acc9 + HX.get(d9 * 128 + j9) * f16_host(g1, base9 + j9)
                j9 = j9 + 1
            }
            dd9<Float> = acc9 - XP.get(b9)
            ad9<Float> = dd9
            if (ad9 < 0.0) { ad9 = 0.0 - ad9 }
            if (ad9 > mxx) { mxx = ad9 }
            if (ad9 > 1e-6) { ndx = ndx + 1 }
            b9 = b9 + 1
        }
        println("E2E XP_GATE count_over_1e-6=" + ndx.to_string() + " max_abs=" + mxx.to_string_precise())
        println("E2E XP xp0=" + XP.get(0).to_string_precise() + " xp129=" + XP.get(129).to_string_precise())
        // ---- y check: mv (full grid, proven) -> u, then yhat -> y, vs host ----
        wr_pdev(pbm, 0, byr)
        wr_pdev(pbm, 8, bxp)
        wr_pdev(pbm, 16, arH)
        wr_pdev(pbm, 24, 2048)
        wr_pdev(pbm, 32, 0)
        wr_pdev(pbm, 40, arA)
        wr_pdev(pbm, 48, mapdev)
        wr_pdev(pbm, 56, invbase)
        wr_pdev(pbm, 64, dscr)
        wr_pdev(pbm, 72, 0)
        wr_pdev(pbm, 88, -1)
        atgt<Int> = dev_alloc(8192)
        cuMemcpyHtoD_v2(atgt, zero_bytes(8192), 8192)
        wr_pdev(pbm, 112, atgt)
        stb<Int> = dev_alloc(8192)
        cuMemcpyHtoD_v2(stb, zero_bytes(8192), 8192)
        wr_pdev(pbm, 104, stb)
        dbgb<Int> = dev_alloc(64)
        cuMemcpyHtoD_v2(dbgb, zero_bytes(64), 64)
        wr_pdev(pbm, 96, dbgb)
        cnt2b<Int> = dev_alloc(8192)
        cuMemcpyHtoD_v2(cnt2b, zero_bytes(8192), 8192)
        wr_pdev(pbm, 80, cnt2b)
        cuMemcpyHtoD_v2(byr, zero_bytes(8192), 8192)
        launch_kernel(fmv, 8192, pbm)
        cuCtxSynchronize()
        cnt2f<Int> = dev_alloc(16384)
        wr_pdev(pb32, 0, cnt2b)
        wr_pdev(pb32, 8, cnt2f)
        wr_pdev(pb32, 16, 2048)
        launch_kernel(fcv, 8, pb32)
        cuCtxSynchronize()
        C2<Vec<Float>> = bulk_dtoh(cnt2f, 2048)
        var<Int> zeros2 = 0
        n12<Int> = 0
        while (n12 < 2048) {
            if ((C2.get(n12) as Int) == 0) { zeros2 = zeros2 + 1 }
            n12 = n12 + 1
        }
        println("E2E PEROUT zero_outputs=" + zeros2.to_string() + " c0=" + (C2.get(0) as Int).to_string() + " c255=" + (C2.get(255) as Int).to_string() + " c256=" + (C2.get(256) as Int).to_string() + " c2047=" + (C2.get(2047) as Int).to_string())
        u64<Int> = dev_alloc(16384)
        wr_pdev(pb32, 0, byr)
        wr_pdev(pb32, 8, u64)
        wr_pdev(pb32, 16, 2048)
        launch_kernel(fcv, 1, pb32)
        cuCtxSynchronize()
        UY<Vec<Float>> = bulk_dtoh(u64, 2048)
        // ---- full-u check: u[n] = sum_k T[k][n] . xp[k] for ALL 2048 outputs ----
        fo4<Int> = load_fn("native/build/exl3dqdbg.ptx", "exl3dqdbg1s4")
        if (fo4 != 0) {
            bT2<Int> = dev_alloc(33554432)
            pbo4<Int> = dev_alloc(64)
            wr_pdev(pbo4, 0, arA)
            wr_pdev(pbo4, 8, mapdev)
            wr_pdev(pbo4, 16, 0)
            wr_pdev(pbo4, 24, bT2)
            wr_pdev(pbo4, 32, 2048)
            wr_pdev(pbo4, 40, invbase)
            launch_kernel(fo4, 8192, pbo4)
            cuCtxSynchronize()
            t64d<Int> = dev_alloc(67108864)
            wr_pdev(pb32, 0, bT2)
            wr_pdev(pb32, 8, t64d)
            wr_pdev(pb32, 16, 8388608)
            launch_kernel(fcv, 32768, pb32)
            cuCtxSynchronize()
            T4<Vec<Float>> = bulk_dtoh(t64d, 8388608)
            var<Int> ndu = 0
            var<Float> mxu = 0.0
            var<Int> firstbad_u = -1
            n11<Int> = 0
            while (n11 < 2048) {
                au<Float> = 0.0
                k11<Int> = 0
                while (k11 < 4096) {
                    au = au + T4.get(k11 * 2048 + n11) * XP.get(k11)
                    k11 = k11 + 1
                }
                du<Float> = au - UY.get(n11)
                adu<Float> = du
                if (adu < 0.0) { adu = 0.0 - adu }
                if (adu > mxu) { mxu = adu }
                if (adu > 1e-4) { ndu = ndu + 1 ; if (firstbad_u < 0) { firstbad_u = n11 } }
                n11 = n11 + 1
            }
            println("E2E U_FULL count_over_1e-4=" + ndu.to_string() + " max_abs=" + mxu.to_string_precise() + " first_bad=" + firstbad_u.to_string())
            // ---- ONLY block 2: does that block's own contribution sum correctly? ----
            wr_pdev(pbm, 88, 2)
            cuMemcpyHtoD_v2(byr, zero_bytes(8192), 8192)
            launch_kernel(fmv, 8192, pbm)
            cuCtxSynchronize()
            wr_pdev(pb32, 0, byr)
            wr_pdev(pb32, 8, u64)
            wr_pdev(pb32, 16, 2048)
            launch_kernel(fcv, 1, pb32)
            cuCtxSynchronize()
            UO<Vec<Float>> = bulk_dtoh(u64, 2048)
        dbgf<Int> = dev_alloc(64)
        wr_pdev(pb32, 0, dbgb)
        wr_pdev(pb32, 8, dbgf)
        wr_pdev(pb32, 16, 4)
        launch_kernel(fcv, 1, pb32)
        cuCtxSynchronize()
        DBGV<Vec<Float>> = bulk_dtoh(dbgf, 4)
        println("E2E DBG only_seen=" + DBGV.get(0).to_string_precise() + " nb128_seen=" + DBGV.get(1).to_string_precise() + " nb128_eq2_count=" + DBGV.get(2).to_string_precise() + " only_eq2_count=" + DBGV.get(3).to_string_precise())
            var<Int> ndo2 = 0
            var<Float> mxo2 = 0.0
            var<Int> fbo = -1
            n13<Int> = 256
            while (n13 < 384) {
                ao<Float> = 0.0
                k13<Int> = 0
                while (k13 < 4096) {
                    ao = ao + T4.get(k13 * 2048 + n13) * XP.get(k13)
                    k13 = k13 + 1
                }
                do3<Float> = ao - UO.get(n13)
                ado<Float> = do3
                if (ado < 0.0) { ado = 0.0 - ado }
                if (ado > mxo2) { mxo2 = ado }
                if (ado > 1e-4) { ndo2 = ndo2 + 1 ; if (fbo < 0) { fbo = n13 } }
                n13 = n13 + 1
            }
            // plain-store readback for outputs 256..383
        stf<Int> = dev_alloc(16384)
        wr_pdev(pb32, 0, stb)
        wr_pdev(pb32, 8, stf)
        wr_pdev(pb32, 16, 2048)
        launch_kernel(fcv, 8, pb32)
        cuCtxSynchronize()
        STV<Vec<Float>> = bulk_dtoh(stf, 2048)
        var<Int> nz = 0
        var<Float> mxs = 0.0
        n14<Int> = 256
        while (n14 < 384) {
            av<Float> = STV.get(n14)
            if (av < 0.0) { av = 0.0 - av }
            if (av > 0.0) { nz = nz + 1 }
            if (av > mxs) { mxs = av }
            n14 = n14 + 1
        }
        println("E2E STORE_ACC nonzero_256_383=" + nz.to_string() + " max_abs=" + mxs.to_string_precise() + " v256=" + STV.get(256).to_string_precise())
        atf<Int> = dev_alloc(16384)
        wr_pdev(pb32, 0, atgt)
        wr_pdev(pb32, 8, atf)
        wr_pdev(pb32, 16, 2048)
        launch_kernel(fcv, 8, pb32)
        cuCtxSynchronize()
        ATV<Vec<Float>> = bulk_dtoh(atf, 2048)
        println("E2E ATGT v256=" + ATV.get(256).to_string_precise() + " v257=" + ATV.get(257).to_string_precise() + " v128=" + ATV.get(128).to_string_precise())
        println("E2E ONLY2 count_over_1e-4=" + ndo2.to_string() + " max_abs=" + mxo2.to_string_precise() + " first_bad=" + fbo.to_string() + " u256=" + UO.get(256).to_string_precise())

        }
        wr_pdev(pbm, 88, -1)
        wr_pdev(pby, 0, byr)
        wr_pdev(pby, 8, by)
        wr_pdev(pby, 16, hd_pre32)
        wr_pdev(pby, 24, 2048)
        wr_pdev(pby, 32, arH)
        launch_kernel(fyh, 16, pby)
        cuCtxSynchronize()
        y64b<Int> = dev_alloc(16384)
        wr_pdev(pb32, 0, by)
        wr_pdev(pb32, 8, y64b)
        wr_pdev(pb32, 16, 2048)
        launch_kernel(fcv, 1, pb32)
        cuCtxSynchronize()
        YY<Vec<Float>> = bulk_dtoh(y64b, 2048)
        var<Int> ndy2 = 0
        var<Float> mxy = 0.0
        n10<Int> = 0
        while (n10 < 2048) {
            a10<Int> = n10 % 128
            bs10<Int> = n10 - a10
            acc10<Float> = 0.0
            m10<Int> = 0
            while (m10 < 128) {
                acc10 = acc10 + HX.get(a10 * 128 + m10) * UY.get(bs10 + m10)
                m10 = m10 + 1
            }
            yref10<Float> = acc10 * f16_host(g2, n10)
            dy10<Float> = yref10 - YY.get(n10)
            ady10<Float> = dy10
            if (ady10 < 0.0) { ady10 = 0.0 - ady10 }
            if (ady10 > mxy) { mxy = ady10 }
            if (ady10 > 1e-6) { ndy2 = ndy2 + 1 }
            n10 = n10 + 1
        }
        println("E2E YH_GATE count_over_1e-6=" + ndy2.to_string() + " max_abs=" + mxy.to_string_precise())
        return 0
    }
    // ---- fused path ----
    t0<Int> = time_mono_millis()
    wr_pdev(pbx, 0, bx)
    wr_pdev(pbx, 8, bxp)
    wr_pdev(pbx, 16, hd_pre32)
    wr_pdev(pbx, 24, arG)
    wr_pdev(pbx, 32, 4096)
    r1<Int> = launch_kernel(fxh, 32, pbx)
    cuCtxSynchronize()
    t1<Int> = time_mono_millis()
    cuMemcpyHtoD_v2(byr, zero_bytes(8192), 8192)
    wr_pdev(pbm, 0, byr)
    wr_pdev(pbm, 8, bxp)
    wr_pdev(pbm, 16, arH)
    wr_pdev(pbm, 24, 2048)
    wr_pdev(pbm, 32, 0)
    wr_pdev(pbm, 40, arA)
    wr_pdev(pbm, 48, mapdev)
    wr_pdev(pbm, 56, invbase)
    wr_pdev(pbm, 64, dscr)
    cntb<Int> = dev_alloc(64)
    cuMemcpyHtoD_v2(cntb, zero_bytes(64), 64)
    wr_pdev(pbm, 72, cntb)
    r2<Int> = launch_kernel(fmv, 8192, pbm)
    cuCtxSynchronize()
    t2<Int> = time_mono_millis()
    wr_pdev(pby, 0, byr)
    wr_pdev(pby, 8, by)
    wr_pdev(pby, 16, hd_pre32)
    wr_pdev(pby, 24, 2048)
    wr_pdev(pby, 32, arH)
    r3<Int> = launch_kernel(fyh, 16, pby)
    cuCtxSynchronize()
    t3<Int> = time_mono_millis()
    // contributions per column block (expect 512 each: 64 rb64 x 8 cta)
    fcv2<Int> = load_fn("native/build/dbg_sh.ptx", "f32t64")
    cnt64<Int> = dev_alloc(128)
    pbcnt<Int> = dev_alloc(24)
    wr_pdev(pbcnt, 0, cntb)
    wr_pdev(pbcnt, 8, cnt64)
    wr_pdev(pbcnt, 16, 16)
    launch_kernel(fcv2, 1, pbcnt)
    cuCtxSynchronize()
    cntv<Vec<Float>> = bulk_dtoh(cnt64, 16)
    line2<String> = "E2E cnt:"
    i = 0
    while (i < 16) { line2 = line2 + " " + (cntv.get(i) as Int).to_string() ; i = i + 1 }
    println(line2)
    ynew<Vec<Float>> = bulk_dtoh(by, 2048)
    println("E2E fused rc=" + r1.to_string() + "/" + r2.to_string() + "/" + r3.to_string() + " xhat=" + (t1 - t0).to_string() + "mv=" + (t2 - t1).to_string() + "yhat=" + (t3 - t2).to_string() + "ms")
    // ---- reference: the one-hot row of the verified deq buffer ----
    dW<Int> = exl3_deq32f_into(0, 0, fdqs4, 0, fhad232, g0, g1, g2, mapbody, 2048, 32768, hd_pre32,
                               arA, arB, arC, arD, arG, arH, arI, mapdev, invbase, arD)
    if (dW == 0) { println("E2E_FAIL deq"); return 7 }
    w64<Int> = dev_alloc(16384)
    wr_pdev(pb32, 0, dW)
    wr_pdev(pb32, 8, w64)
    wr_pdev(pb32, 16, 2048)
    launch_kernel(fcv, 8, pb32)
    cuCtxSynchronize()
    bref<Vec<Float>> = bulk_dtoh(w64, 2048)
    if (onesm) {
        // x = ones: y[n] must equal sum_k B[k][n] — the full column sums of the
        // verified deq buffer. This tests the whole chain with no one-hot luck.
        tall<Int> = dev_alloc(67108864)
        pbc3<Int> = dev_alloc(24)
        wr_pdev(pbc3, 0, dW)
        wr_pdev(pbc3, 8, tall)
        wr_pdev(pbc3, 16, 8388608)
        launch_kernel(fcv, 32768, pbc3)
        cuCtxSynchronize()
        B64<Vec<Float>> = bulk_dtoh(tall, 8388608)
        var<Int> ndo = 0
        var<Float> mxo = 0.0
        n9<Int> = 0
        while (n9 < 2048) {
            cs2<Float> = 0.0
            k9<Int> = 0
            while (k9 < 4096) {
                cs2 = cs2 + B64.get(k9 * 2048 + n9)
                k9 = k9 + 1
            }
            do2<Float> = cs2 - ynew.get(n9)
            ao2<Float> = do2
            if (ao2 < 0.0) { ao2 = 0.0 - ao2 }
            if (ao2 > mxo) { mxo = ao2 }
            if (ao2 > 1e-3) { ndo = ndo + 1 }
            n9 = n9 + 1
        }
        println("E2E ONES_GATE count_over_1e-3=" + ndo.to_string() + " max_abs=" + mxo.to_string_precise())
        println("E2E ONES fused y0=" + ynew.get(0).to_string_precise() + " colsum0=" + colsum_b(B64, 0).to_string_precise())
        return 0
    }
    println("E2E onehot fused y0=" + ynew.get(0).to_string_precise() + " y1=" + ynew.get(1).to_string_precise())
    println("E2E onehot B[0]  y0=" + bref.get(0).to_string_precise() + " y1=" + bref.get(1).to_string_precise())
    nd<Int> = 0
    mx<Float> = 0.0
    i = 0
    while (i < 2048) {
        d<Float> = ynew.get(i) - bref.get(i)
        ad<Float> = d
        if (ad < 0.0) { ad = 0.0 - ad }
        if (ad > mx) { mx = ad }
        if (ad > 1e-4) { nd = nd + 1 }
        i = i + 1
    }
    println("E2E_GATE count_over_1e-4=" + nd.to_string() + " max_abs=" + mx.to_string_precise())
    // where does it start to diverge?
    var<Int> firstbad = -1
    i = 0
    while (i < 2048) {
        d2<Float> = ynew.get(i) - bref.get(i)
        ad2<Float> = d2
        if (ad2 < 0.0) { ad2 = 0.0 - ad2 }
        if (ad2 > 1e-4 && firstbad < 0) { firstbad = i }
        i = i + 1
    }
    println("E2E first_mismatch_index=" + firstbad.to_string())
    // Is block 3+ shifted onto another input row? Compare y[384] with B[k][384].
    k2<Int> = 0
    while (k2 < 4) {
        w64b<Int> = dev_alloc(8192)
        pbc2<Int> = dev_alloc(24)
        wr_pdev(pbc2, 0, dW + (k2 * 2048 + 384) * 4)
        wr_pdev(pbc2, 8, w64b)
        wr_pdev(pbc2, 16, 4)
        launch_kernel(fcv, 1, pbc2)
        cuCtxSynchronize()
        bv2<Vec<Float>> = bulk_dtoh(w64b, 4)
        println("E2E row" + k2.to_string() + "[384..387]=" + bv2.get(0).to_string_precise() + " " + bv2.get(1).to_string_precise() + " " + bv2.get(2).to_string_precise())
        free_dev(w64b)
        k2 = k2 + 1
    }
    println("E2E fused[384..387]=" + ynew.get(384).to_string_precise() + " " + ynew.get(385).to_string_precise() + " " + ynew.get(386).to_string_precise())
    // per-128-block error counts: structural pattern or scattered?
    var<Int> blk = 0
    line<String> = "E2E blocks:"
    while (blk < 16) {
        cnt<Int> = 0
        i = blk * 128
        while (i < blk * 128 + 128) {
            d3<Float> = ynew.get(i) - bref.get(i)
            ad3<Float> = d3
            if (ad3 < 0.0) { ad3 = 0.0 - ad3 }
            if (ad3 > 1e-4) { cnt = cnt + 1 }
            i = i + 1
        }
        line = line + " " + cnt.to_string()
        blk = blk + 1
    }
    println(line)
    if (nd == 0) { println("E2E_DONE FUSED_OK") } else { println("E2E_DONE FUSED_FAIL") }
    return 0
}

hexv(v<Int>)<String> -> {
    digs<Vec<String>> = Vec()
    digs.push("0") ; digs.push("1") ; digs.push("2") ; digs.push("3")
    digs.push("4") ; digs.push("5") ; digs.push("6") ; digs.push("7")
    digs.push("8") ; digs.push("9") ; digs.push("a") ; digs.push("b")
    digs.push("c") ; digs.push("d") ; digs.push("e") ; digs.push("f")
    s<String> = ""
    k<Int> = 0
    while (k < 12) {
        n<Int> = (v >> (k * 4)) & 15
        s = digs.get(n) + s
        k = k + 1
    }
    return s
}

f16_host(s<String>, i<Int>)<Float> -> {
    b0<Int> = (s.char_at(i * 2) as Int) & 255
    b1<Int> = (s.char_at(i * 2 + 1) as Int) & 255
    u<Int> = b0 + b1 * 256
    sgn<Int> = (u >> 15) & 1
    e<Int> = (u >> 10) & 31
    m<Int> = u & 1023
    v<Float> = 0.0
    if (e == 0) {
        v = (m as Float) * 5.960464477539063e-08
    } else {
        v = 1.0 + (m as Float) / 1024.0
        k<Int> = 0
        while (k < e - 15) { v = v * 2.0 ; k = k + 1 }
        while (k < 15 - e) { v = v * 0.5 ; k = k + 1 }
    }
    if (sgn == 1) { return 0.0 - v }
    return v
}

colsum_b(B<Vec<Float>>, n<Int>)<Float> -> {
    s<Float> = 0.0
    k<Int> = 0
    while (k < 4096) {
        s = s + B.get(k * 2048 + n)
        k = k + 1
    }
    return s
}

zero_bytes(n<Int>)<String> -> {
    s<String> = ""
    k<Int> = 0
    while (k < n) { s = s + " " ; k = k + 1 }
    return s
}

find_from(s<String>, needle<String>, start<Int>)<Int> -> {
    n<Int> = s.len()
    m<Int> = needle.len()
    i<Int> = start
    while (i <= n - m) {
        ok<Bool> = true
        j<Int> = 0
        while (ok && j < m) {
            if (s.char_at(i + j) != needle.char_at(j)) { ok = false }
            j = j + 1
        }
        if (ok) { return i }
        i = i + 1
    }
    return -1
}
