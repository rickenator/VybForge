# probe10e module: a share'd fn with a hot loop using a module constant
EMOD_K<Int> = 7

share(all)
hotloop(n<Int>)<Int> -> {
    acc<Int> = 0
    i<Int> = 0
    while (i < n) { acc = acc + i * EMOD_K - acc / 3; i = i + 1 }
    return acc
}

share(all)
veclen_borrow(v<their<Vec<Float> const>>)<Int> -> {
    s<Int> = 0
    i<Int> = 0
    while (i < 10) { s = s + 1; i = i + 1 }
    return s + v.len()
}

share(all)
maken(n<Int>)<Vec<Float>> -> {
    v<Vec<Float>> = Vec()
    i<Int> = 0
    while (i < n) { v.push(0.5); i = i + 1 }
    return v
}
