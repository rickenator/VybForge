// glm_chat_server.vyb — GLM-5.3-Flash chat endpoint on localhost:8090 (P12).
//
// Pure-Vyb HTTP server on the chat_server.vyb pattern. Per request it:
//   1. extracts the prompt (GET /chat?q=... or POST prompt=...),
//   2. encodes it with the Vyb-native GLM byte-level BPE tokenizer
//      (native/tokenizer/tokenizer.vyb pointed at artifacts/glm53-tokenizer),
//   3. exec's the gated 45-layer decode chain driver (glm_decode_chain.vyb) with
//      the prompt ids + VYBFORGE_GEN as env — the driver prefills the prompt,
//      walks the last two prompt tokens teacher-forced (the gated chain path),
//      then greedy-decodes via the trunk argmax with the MTP draft logged
//      alongside (greedy-via-target; no speculative acceptance),
//   4. decodes the generated ids back to text and replies.
//
// The model never lives in this process: the chain driver streams the 164 GB
// checkpoint from /mnt/apex per request. Honest cost: each request re-runs the
// full 45-layer prefill + decode at fp64 EXL3 dequant speed — MINUTES per
// request (~15 min prefill + ~2-3 min per generated token on the 3090).
// Single-client, correctness-first; a resident model + KV reuse is the later
// slice, exactly as chat_server.vyb did.
//
// Run (repo root):
//   VYB_STDLIB=$HOME/Projects/Vyb/stdlib VYBFORGE_GLMGEN=8 \
//     build/vyb native/host/glm_chat_server.vyb \
//     --module-path native/json --module-path native/torchload \
//     --module-path native/glm53 --module-path native/kernels \
//     --module-path native/tensor --module-path native/tokenizer \
//     --module-path $HOME/Projects/Vyb/bindings/cuda \
//     --module-path $HOME/Projects/Vyb/stdlib/collections
//   curl 'http://localhost:8090/chat?q=The%20capital%20of%20France%20is'
//   curl -d 'prompt=hello' http://localhost:8090/chat
//
// Env: VYBFORGE_GLMGEN (tokens to generate, default 8), VYBFORGE_GX_DIR
// (checkpoint dir), VYBFORGE_TOKDIR/VYBFORGE_DIGMAX/VYBFORGE_TOKIGNORE are
// passed through to the tokenizer (GLM: artifacts/glm53-tokenizer, 3, 1).
// Localhost-only per the standing rule.

import http::{http_listen, http_local_port, http_accept, http_read_head,
              http_request_path, http_send_all, http_close, http_response,
              http_read_rest}
import network::{TcpListener, TcpStream, TcpListenerOps, TcpStreamOps}
import io::{open_read, read_all, open_write, write_str, close}
import process::{exec_run}
import env::{env_get}
import tokenizer::{encode, decode}

PORT<Int> = 8091     # 8090 is taken on this host (verified with ss -ltn)
PROMPT_IDS<String> = "native/out/glm_prompt_ids.txt"
GEN_OUT<String> = "native/out/glm_chat_gen_ids.txt"
CHAIN_OUT<String> = "native/out/glm_chat_chain.txt"
CHAIN_DRV<String> = "native/host/glm_decode_chain.vyb"

hexch(c<Int>)<Int> -> {
    if (c >= 48 && c <= 57) { return c - 48 }
    if (c >= 97 && c <= 102) { return c - 97 + 10 }
    if (c >= 65 && c <= 70) { return c - 65 + 10 }
    return 0
}

urldecode(s<String>)<String> -> {
    out<String> = ""
    i<Int> = 0
    n<Int> = s.len()
    while (i < n) {
        c<Int> = s.char_at(i)
        if (c == 43) { out = out + " " }
        else if (c == 37 && i + 2 < n) {
            h1<Int> = hexch(s.char_at(i + 1)); h2<Int> = hexch(s.char_at(i + 2))
            out = out + String::from_byte(h1 * 16 + h2)
            i = i + 2
        } else { out = out + String::from_byte(c) }
        i = i + 1
    }
    return out
}

extract_prompt(s<String>)<String> -> {
    qa<Int> = s.index_of("q=")
    pa<Int> = s.index_of("prompt=")
    estart<Int> = qa
    if (pa >= 0 && (qa < 0 || pa < estart)) { estart = pa }
    if (estart < 0) { return "" }
    v<String> = ""
    if (estart == qa) { v = s.substring(qa + 2) }
    else { v = s.substring(pa + 7) }
    sp2<Int> = v.index_of(" ")
    am2<Int> = v.index_of("&")
    cut<Int> = sp2
    if (am2 >= 0 && (cut < 0 || am2 < cut)) { cut = am2 }
    if (cut >= 0) { v = v.substring(0, cut) }
    return urldecode(v.trim())
}

read_file(path<String>)<String> -> {
    match (open_read(path)) {
        f -> {
            match (read_all(f)) { s -> { close(f); return s } ? -> { close(f); return "" } }
        }
        ? -> { return "" }
    }
    return ""
}

write_file(path<String>, body<String>)<Int> -> {
    match (open_write(path)) {
        w -> { match (write_str(w, body)) { q -> { } ? -> { } } close(w); return 0 }
        ? -> { return -1 }
    }
    return 0
}

// "PROMPT 1,2,3" / "GEN 4,5,6" lines -> the GEN csv parsed into ids.
read_gen_ids(body<String>)<Vec<Int>> -> {
    v<Vec<Int>> = Vec()
    gidx<Int> = body.index_of("GEN ")
    if (gidx < 0) { return v }
    rest<String> = body.substring(gidx + 4)
    nl<Int> = rest.index_of("\n")
    if (nl >= 0) { rest = rest.substring(0, nl) }
    cur<String> = ""
    i<Int> = 0
    while (i <= rest.len()) {
        if (i == rest.len()) {
            if (cur.len() > 0) { v.push(cur.to_int()) }
        } else {
            ch<String> = rest.substring(i, i + 1)
            if (ch == ",") {
                if (cur.len() > 0) { v.push(cur.to_int()) }
                cur = ""
            } else { cur = cur + ch }
        }
        i = i + 1
    }
    return v
}

free_exec(cmd<String>)<Int> -> {
    freedom { return exec_run(cmd) else -1 }
    return -1
}

// Encode -> exec the chain driver -> parse generated ids -> decode to text.
glm_response(prompt<String>)<String> -> {
    ids<Vec<Int>> = encode(prompt)
    if (ids.len() == 0) { return "ERR: prompt encoded to 0 tokens" }
    idtxt<String> = ""
    i<Int> = 0
    for (i in 0..ids.len() - 1) {
        if (i > 0) { idtxt = idtxt + "," }
        idtxt = idtxt + ids.get(i).to_string()
    }
    if (write_file(PROMPT_IDS, idtxt) != 0) { return "ERR: write prompt ids" }
    vhome<String> = env_get("VYBHOME") else ""
    vyb<String> = env_get("VYB_BIN") else ""
    vstd<String> = env_get("VYB_STDLIB") else ""
    if (vhome.len() == 0 && (vyb.len() == 0 || vstd.len() == 0)) {
        return "ERR: set VYBHOME to the Vyb checkout"
    }
    if (vyb.len() == 0) { vyb = vhome + "/build/vyb" }
    if (vstd.len() == 0) { vstd = vhome + "/stdlib" }
    genn<Int> = 8
    gs<String> = env_get("VYBFORGE_GLMGEN") else ""
    if (gs.len() > 0) { genn = gs.to_int() }
    tokdir<String> = env_get("VYBFORGE_TOKDIR") else "artifacts/glm53-tokenizer"
    cmd<String> = "VYB_STDLIB=" + vstd +
                  " VYBFORGE_L0_IDS=" + idtxt +
                  " VYBFORGE_GEN=" + genn.to_string() +
                  " VYBFORGE_CHAIN_OUT=" + CHAIN_OUT +
                  " VYBFORGE_GEN_OUT=" + GEN_OUT +
                  " VYBFORGE_TOKDIR=" + tokdir +
                  " VYBFORGE_DIGMAX=3 VYBFORGE_TOKIGNORE=1" +
                  " " + vyb + " " + CHAIN_DRV +
                  " --module-path native/json --module-path native/torchload" +
                  " --module-path native/glm53 --module-path native/kernels" +
                  " --module-path native/tensor --module-path native/tokenizer" +
                  " --module-path " + vhome + "/bindings/cuda" +
                  " --module-path " + vstd + "/collections" +
                  " >" + GEN_OUT + ".log 2>&1"
    rc<Int> = free_exec(cmd)
    if (rc != 0) { return "ERR: chain driver exit " + rc.to_string() }
    genbody<String> = read_file(GEN_OUT)
    gen<Vec<Int>> = read_gen_ids(genbody)
    if (gen.len() == 0) { return "ERR: no generated ids" }
    return decode(gen)
}

serve_chat(fd<Int>)<Int> -> {
    head<String> = http_read_head(fd, 65536)
    path<String> = http_request_path(head)
    prompt<String> = extract_prompt(path)
    # Only read a body if the request advertises one (POST / Content-Length),
    # otherwise http_read_rest on a keep-alive GET would block forever.
    if (prompt.len() == 0 && (head.starts_with("POST") || head.index_of("Content-Length:") >= 0)) {
        body<String> = http_read_rest(fd, 65536)
        prompt = extract_prompt(body)
    }
    status<Int> = 200
    body_out<String> = ""
    if (prompt.len() == 0) {
        status = 400
        body_out = "usage: GET /chat?q=<prompt> or POST 'prompt=<prompt>'\n"
    } else {
        ntok<Int> = 0
        ids0<Vec<Int>> = encode(prompt)
        ntok = ids0.len()
        println("GLM_CHAT request: " + prompt)
        resp<String> = glm_response(prompt)
        body_out = "prompt=[" + prompt + "]\ntokens=" + ntok.to_string() + "\n" + resp + "\n"
        println("GLM_CHAT reply: " + resp)
    }
    pk<String> = http_response(status, body_out)
    http_send_all(fd, pk)
    http_close(fd)
    return 0
}

main()<Int> -> {
    match (http_listen(PORT, 4)) {
        srv -> {
            port<Int> = srv.local_port()
            println("GLM_CHAT_SERVER up on localhost:" + port.to_string() +
                    " (single-client; minutes per request, see header)")
            while (true) {
                match (http_accept(srv)) {
                    conn -> {
                        # single-client, correctness-first: handle sequentially
                        serve_chat(conn.fd)
                    }
                    ? -> { return 0 }
                }
            }
            return 0
        }
        ? -> { println("GLM_CHAT_SERVER listen failed on " + PORT.to_string()); return 1 }
    }
    return 0
}
