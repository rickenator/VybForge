// p6r14_tiny — the hand-checkable bfgemm_p test. No real weights, no model.
//
//   A = [1,2,3,4,5,6,7,8]            (f32 activations, cast from f64)
//   B = [N][K] = 2 rows: row0 = 1.0 everywhere, row1 = 2.0 everywhere (bf16)
//   M=1, N=2, K=8, KSP=1, TRANSP=1
//
//   expected: o[0] = 1+2+...+8 = 36.0
//             o[1] = 2*(1+2+...+8) = 72.0
//
// If this is not exactly 36 and 72 there is no point running the real tensor:
// the arithmetic is small enough to do by hand, so any deviation is a bug with
// nowhere to hide.
import io::{open_read, read_all, close}
import tensor::{tensor_init, dev_alloc, bulk_htod, bulk_dtoh, sync}
import glm_engine::{load_fn, launch_kernel, wr_pdev}

main()<Int> -> {
    if (tensor_init() != 0) { println("T_FAIL cuda"); return 1 }
    fp<Int> = load_fn("native/build/bfgemm.ptx", "bfgemm_1s")
    fw<Int> = load_fn("native/build/bfgemm.ptx", "widen32")
    fc<Int> = load_fn("native/build/layer.ptx", "cast32")
    println("T handles: gemm=" + fp.to_string() + " widen=" + fw.to_string() + " cast=" + fc.to_string())
    if (fp == 0 || fw == 0 || fc == 0) { println("T_FAIL handle"); return 2 }

    var<Int> M = 1
    var<Int> N = 2
    var<Int> K = 8

    # A: f64 1..8 on the host, cast to f32 on device
    xv<Vec<Float>> = Vec()
    var<Int> i = 0
    while (i < K) { xv.push(((i + 1) as Float)) ; i = i + 1 }
    dA64<Int> = dev_alloc(K * 8)
    bulk_htod(dA64, view(xv))
    dA<Int> = dev_alloc(K * 4)
    pbc<Int> = dev_alloc(32)
    wr_pdev(pbc, 0, dA64)
    wr_pdev(pbc, 8, dA)
    wr_pdev(pbc, 16, K)
    launch_kernel(fc, 1, pbc)
    sync()

    # B: 16 bf16 words. 1.0 = 0x3F80, 2.0 = 0x4000. Four u16 per 8-byte Int.
    dB<Int> = dev_alloc(32)
    w_one<Int> = 0
    w_two<Int> = 0
    # build the packed Ints by shifting: 0x3F80 repeated four times
    # four bf16 words packed per 8-byte Int, low word first
    w_one = 0x3F803F803F803F80
    w_two = 0x4000400040004000
    wr_pdev(dB, 0, w_one)
    wr_pdev(dB, 8, w_one)
    wr_pdev(dB, 16, w_two)
    wr_pdev(dB, 24, w_two)
    sync()

    # ---- VERIFY THE INPUTS LANDED, before blaming the GEMM ----
    fb2<Int> = load_fn("native/build/bfgemm.ptx", "b2d")
    dAc<Int> = dev_alloc(K * 8)
    wr_pdev(pbc, 0, dA)
    wr_pdev(pbc, 8, dAc)
    wr_pdev(pbc, 16, K)
    launch_kernel(fw, 1, pbc)
    sync()
    AC<Vec<Float>> = bulk_dtoh(dAc, K)
    println("T A on device: " + AC.get(0).to_string_precise() + " " + AC.get(1).to_string_precise() + " " + AC.get(2).to_string_precise() + " ... " + AC.get(7).to_string_precise())
    dBc<Int> = dev_alloc(16 * 8)
    wr_pdev(pbc, 0, dB)
    wr_pdev(pbc, 8, dBc)
    wr_pdev(pbc, 16, 16)
    launch_kernel(fb2, 1, pbc)
    sync()
    BC<Vec<Float>> = bulk_dtoh(dBc, 16)
    println("T B on device: " + BC.get(0).to_string_precise() + " " + BC.get(7).to_string_precise() + " | " + BC.get(8).to_string_precise() + " " + BC.get(15).to_string_precise() + "   (expect 1 1 | 2 2)")

    # run the GEMM
    # 8 slots, explicitly zeroed, so the printout shows exactly which slots the
    # kernel touches (and which it leaves alone)
    dS<Int> = dev_alloc(64)
    wr_pdev(dS, 0, 0)
    wr_pdev(dS, 8, 0)
    wr_pdev(dS, 16, 0)
    wr_pdev(dS, 24, 0)
    wr_pdev(dS, 32, 0)
    wr_pdev(dS, 40, 0)
    wr_pdev(dS, 48, 0)
    wr_pdev(dS, 56, 0)
    pbg<Int> = dev_alloc(96)
    wr_pdev(pbg, 0, dA)
    wr_pdev(pbg, 8, dB)
    wr_pdev(pbg, 16, dS)
    wr_pdev(pbg, 24, M)
    wr_pdev(pbg, 32, N)
    wr_pdev(pbg, 40, K)
    wr_pdev(pbg, 56, 1)
    wr_pdev(pbg, 64, 1)
    nblk<Int> = (((M + 3) / 4) * N + 255) / 256
    rcg<Int> = launch_kernel(fp, nblk, pbg) as Int
    sync()
    println("T gemm grid=" + nblk.to_string() + " rc=" + rcg.to_string())

    # widen f32 -> f64 and read back
    dS64<Int> = dev_alloc(64)
    wr_pdev(pbc, 0, dS)
    wr_pdev(pbc, 8, dS64)
    wr_pdev(pbc, 16, 8)
    launch_kernel(fw, 1, pbc)
    sync()
    O<Vec<Float>> = bulk_dtoh(dS64, 8)
    println("T all8: " + O.get(0).to_string_precise() + " " + O.get(1).to_string_precise() + " " + O.get(2).to_string_precise() + " " + O.get(3).to_string_precise() + " " + O.get(4).to_string_precise() + " " + O.get(5).to_string_precise())
    println("T o[0]=" + O.get(0).to_string_precise() + " o[1]=" + O.get(1).to_string_precise() + "   (expect 36 and 72)")
    d0<Float> = O.get(0) - 36.0
    d1<Float> = O.get(1) - 72.0
    if (d0 < 0.0) { d0 = 0.0 - d0 }
    if (d1 < 0.0) { d1 = 0.0 - d1 }
    if (d0 < 1e-5 && d1 < 1e-5) { println("T_PASS bfgemm_p is correct on the hand-checkable case") }
    else { println("T_FAIL bfgemm_p wrong: d0=" + d0.to_string_precise() + " d1=" + d1.to_string_precise()) }
    println("T_DONE")
    return 0
}
