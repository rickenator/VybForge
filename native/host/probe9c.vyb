# probe9c: the importer at the serve's exact nesting depth.
import probe9cmod

main()<Int> -> {
    total<Int> = 0
    i<Int> = 0
    while (i < 2) {
        match (i) {
            n -> {
                j<Int> = 0
                while (j < 2) {
                    match (j) {
                        m -> {
                            # the innermost: the serve's per-request body depth
                            a<Int> = f1()
                            b<Int> = f2(c1)
                            c<Int> = f3(c2, n)
                            total = total + a + b + c
                            println("inner a=" + a.to_string() + " b=" + b.to_string() + " c=" + c.to_string())
                        }
                    }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    println("total=" + total.to_string() + " (want 4*(42+222+223))")
    if (total == 1956) { println("PROBE9C_OK"); return 0 }
    return 1
}
