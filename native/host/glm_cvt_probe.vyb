# glm_exl3_check.vyb — the reusable EXL3 dequant (native/glm53/exl3_load.vyb) against the
# P1 oracle on a REAL expert tensor: layer 3, expert 0, gate_proj [4096, 2048] at 4 bpw.
#
# This is the piece the MoE needs for its 109 routed experts; once it matches the oracle
# here it can be called per (expert, projection) inside the ffn site.
#
# Gold: native/glm53/gold_exl3_deq.py (loader.dequant_exl3_fast, P1-gated)
# Gate: EXL3_LOAD_VYB (digest compare, tolerance from the P1 gate: max abs 3e-3)
#
# Run: make -f native/Makefile glm3x
import io::{open_read, read_at, read_all, open_write, write_str, close}
import time::{time_mono_millis}
import env::{env_get}
import safetensors
import gx
import tensor::{tensor_init, dtoh_vec, dtoh, sync}

struct CvtBox {
    p<Int>
}

extern "C" {
    cuMemFree_v2(dptr<Int>)<CInt>
    cuMemAlloc_v2(dptr<loc<Int>>, bytesize<Int>)<CInt>
    cuMemcpyHtoD_v2(dstDevice<Int>, srcHost<loc<CVoid>>, ByteCount<Int>)<CInt>
    cuMemcpyDtoH_v2(dstHost<loc<CVoid>>, srcDevice<Int>, ByteCount<Int>)<CInt>
    cuCtxSynchronize()<CInt>
    cuModuleLoadData(hmod<loc<loc<CVoid>>>, image<CString>)<CInt>
    cuModuleGetFunction(hfunc<loc<loc<CVoid>>>, hmod<loc<CVoid>>, name<CString>)<CInt>
    cuda_launch4i(f<loc<CVoid>>, gridX<CUInt>, gridY<CUInt>, gridZ<CUInt>,
                  blockX<CUInt>, blockY<CUInt>, blockZ<CUInt>,
                  a0<Int>, a1<Int>, a2<Int>, a3<Int>)<CInt>
}

SCALE40<Float> = 1099511627776.0

di(v<Float>)<Int> -> {
    return (v * SCALE40) as Int
}

digest(name<String>, v<Vec<Float>>)<String> -> {
    s<Float> = 0.0
    a<Float> = 0.0
    q<Float> = 0.0
    m<Float> = 0.0
    i<Int> = 0
    while (i < v.len()) {
        x<Float> = v.get(i)
        s = s + x
        if (x < 0.0) { a = a - x } else { a = a + x }
        q = q + x * x
        t<Float> = x
        if (t < 0.0) { t = 0.0 - t }
        if (t > m) { m = t }
        i = i + 1
    }
    out<String> = name + " n=" + v.len().to_string() + " sum=" + di(s).to_string() +
                  " abs=" + di(a).to_string() + " sq=" + di(q).to_string() +
                  " max=" + di(m).to_string()
    i = 0
    while (i < 8) {
        hv<Float> = 0.0
        if (i < v.len()) { hv = v.get(i) }
        out = out + " v" + i.to_string() + "=" + di(hv).to_string()
        i = i + 1
    }
    return out
}

load_fn(ptx_path<String>, fn_name<String>)<Int> -> {
    ptx<String> = ""
    match (open_read(ptx_path)) {
        f -> { match (read_all(f)) { s -> { ptx = s } ? -> { return 0 } } close(f) }
        ? -> { return 0 }
    }
    var<Int> addr_out = 0
    freedom {
        var<loc<loc<CVoid>>> m = from<loc<loc<CVoid>>>(0)
        if (cuModuleLoadData(loc(m), ptx) != 0) { return 0 }
        var<loc<CVoid>> f = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(f), m, fn_name) != 0) { return 0 }
        addr_out = addr(f)
    }
    return addr_out
}

# Dequantize one EXL3-packed expert tensor to f64 [in, out] on the device.
#   body: the 256x16 tile-map body (map.bin minus its 16-byte header)
share(all)
exl3_deq(fdeq<Int>, fhgen<Int>, fhad1<Int>, fhad2<Int>, fcvt32<Int>,
         trellis<String>, suh<String>, svh<String>, body<String>,
         cw<Int>, ntiles<Int>, hd_pre<Int>,
         qda<Int>, tda<Int>, oda<Int>, td2a<Int>, f32a<Int>, fdca<Int>,
         suda<Int>, svda<Int>, pda<Int>)<Int> -> {
    tb<Int> = 0
    kn<Int> = 0
    krows<Int> = 0
    nbc<Int> = 0
    nblocks<Int> = 0
    mb<Int> = 0
    hwide<Int> = 0
    bq<Int> = 0
    u<Int> = 0
    ch<Int> = 0
    b<Int> = 0
    pq<Int> = 0
    chq<Int> = 0
    var<Int> out = 0
    tb = trellis.len()
    if (tb < ntiles * 128) { return 0 }
    kn = (ntiles / (cw / 16)) * 16 * cw
    krows = kn / cw
    if ((suh.len() % 8) != 0 || (svh.len() % 8) != 0) { return 0 }
    if (suh.len() != krows * 2 || svh.len() != cw * 2) { return 0 }
    nbc = cw / 128
    nblocks = (kn / cw / 128) * nbc
    mb = 16 + body.len()
    freedom {
        var<Int> qd = 0
        var<Int> td = 0
        var<Int> od = 0
        var<Int> hd = 0
        var<Int> td2 = 0
        var<Int> fd = 0
        var<Int> fdc = 0
        var<Int> pd = 0
        var<Int> sud = 0
        var<Int> svd = 0
        qd = qda
        td = tda
        od = oda
        hd = hd_pre
        td2 = td2a
        fd = f32a
        fdc = fdca
        pd = pda
        sud = suda
        svd = svda

        # trellis: bulk copy straight from the String
        if (cuMemcpyHtoD_v2(qd, trellis, tb) != 0) { return 0 }
        # map: 16-byte header + the 256-slot body
        var<CInt> rc = 0
        hwide = 0
        bq = 0
        while (bq < 8) {
            hwide = hwide | (((cw >> (bq * 8)) & 255) << (bq * 8))
            bq = bq + 1
        }
        if (cuMemcpyHtoD_v2(td, loc(hwide), 8) != 0) { return 0 }
        hwide = 0
        bq = 0
        while (bq < 8) {
            hwide = hwide | (((ntiles >> (bq * 8)) & 255) << (bq * 8))
            bq = bq + 1
        }
        if (cuMemcpyHtoD_v2(td + 8, loc(hwide), 8) != 0) { return 0 }
        u = 0
        while (u < body.len()) {
            ch = 0
            b = 0
            while (b < 8) {
                ch = ch | ((((body.char_at(u + b) as Int) & 255)) << (b * 8))
                b = b + 1
            }
            if (cuMemcpyHtoD_v2(td + 16 + u, loc(ch), 8) != 0) { return 0 }
            u = u + 8
        }
        # dequant
        if (cuda_launch4i(from<loc<CVoid>>(fdeq), ntiles, 1, 1, 256, 1, 1, qd, td, od, 0) != 0) {
            return 0
        }
        cuCtxSynchronize()
        # scales (fp16) to the device
        u = 0
        while (u < suh.len()) {
            ch = 0
            b = 0
            while (b < 8) {
                ch = ch | ((((suh.char_at(u + b) as Int) & 255)) << (b * 8))
                b = b + 1
            }
            if (cuMemcpyHtoD_v2(sud + u, loc(ch), 8) != 0) { return 0 }
            u = u + 8
        }
        u = 0
        while (u < svh.len()) {
            ch = 0
            b = 0
            while (b < 8) {
                ch = ch | ((((svh.char_at(u + b) as Int) & 255)) << (b * 8))
                b = b + 1
            }
            if (cuMemcpyHtoD_v2(svd + u, loc(ch), 8) != 0) { return 0 }
            u = u + 8
        }
        # hgen: H at pd+0 (skipped when H was prebuilt by had_hoist)
        if (hd_pre == 0) {
            if (cuMemcpyHtoD_v2(pd + 0, loc(hd), 8) != 0) { return 0 }
            if (cuda_launch4i(from<loc<CVoid>>(fhgen), 64, 1, 1, 256, 1, 1, pd, 0, 0, 0) != 0) {
                return 0
            }
            cuCtxSynchronize()
        }
        # had1: what=od, tmp=td2, H=hd, cw, nbc, nblocks
        pq = 0
        while (pq < 6) {
            chq = 0
            if (pq == 0) { chq = od }
            if (pq == 1) { chq = td2 }
            if (pq == 2) { chq = hd }
            if (pq == 3) { chq = cw }
            if (pq == 4) { chq = nbc }
            if (pq == 5) { chq = nblocks }
            if (cuMemcpyHtoD_v2(pd + pq * 8, loc(chq), 8) != 0) { return 0 }
            pq = pq + 1
        }
        if (cuda_launch4i(from<loc<CVoid>>(fhad1), nblocks * 64, 1, 1, 256, 1, 1, pd, 0, 0, 0) != 0) {
            return 0
        }
        cuCtxSynchronize()
        # had2: tmp=td2, out=fd, H=hd, suh, svh, cw, nbc, nblocks
        pq = 0
        while (pq < 8) {
            chq = 0
            if (pq == 0) { chq = td2 }
            if (pq == 1) { chq = fd }
            if (pq == 2) { chq = hd }
            if (pq == 3) { chq = sud }
            if (pq == 4) { chq = svd }
            if (pq == 5) { chq = cw }
            if (pq == 6) { chq = nbc }
            if (pq == 7) { chq = nblocks }
            if (cuMemcpyHtoD_v2(pd + pq * 8, loc(chq), 8) != 0) { return 0 }
            pq = pq + 1
        }
        if (cuda_launch4i(from<loc<CVoid>>(fhad2), nblocks * 64, 1, 1, 256, 1, 1, pd, 0, 0, 0) != 0) {
            return 0
        }
        cuCtxSynchronize()
        pq = 0
        while (pq < 3) {
            chq = 0
            if (pq == 0) { chq = fd }
            if (pq == 1) { chq = fdc }
            if (pq == 2) { chq = kn }
            if (cuMemcpyHtoD_v2(pd + pq * 8, loc(chq), 8) != 0) { println("CVTPROBE param"); return 0 }
            pq = pq + 1
        }
        lrcCvt<Int> = cuda_launch4i(from<loc<CVoid>>(fcvt32), (kn + 255) / 256, 1, 1, 256, 1, 1, pd, 0, 0, 0) as Int
        srCvt<Int> = cuCtxSynchronize() as Int
        if (lrcCvt != 0 || srCvt != 0) { println("CVTPROBE launch lrc=" + lrcCvt.to_string() + " sync=" + srCvt.to_string()); return 0 }
        out = fdc
    }
    return out
}

# Build the run-constant 128x128 Sylvester Hadamard/8 matrix ONCE (f64, 128*128*8 bytes).
# Returns the device pointer, 0 on failure. Keep alive for the whole run — never free it.
had_hoist(fhgen<Int>)<Int> -> {
    var<Int> out = 0
    freedom {
        var<Int> hd = 0
        var<Int> pd = 0
        hrc1<Int> = cuMemAlloc_v2(loc(hd), 16384 * 4) as Int
        if (hrc1 == 0) {
            hrc2<Int> = cuMemAlloc_v2(loc(pd), 64) as Int
            if (hrc2 == 0) {
                if (cuMemcpyHtoD_v2(pd + 0, loc(hd), 8) == 0) {
                    hlrc<Int> = cuda_launch4i(from<loc<CVoid>>(fhgen), 64, 1, 1, 256, 1, 1, pd, 0, 0, 0) as Int
                    hsync<Int> = cuCtxSynchronize() as Int
                    if (hlrc == 0 && hsync == 0) { out = hd }
                }
                cuMemFree_v2(pd)
            }
            if (out == 0) { cuMemFree_v2(hd) }
        }
    }
    return out
}


# program-level struct holder for the cvt output pointer (struct globals work at
# program level; bare Int globals do not)
cvtbox<CvtBox> = CvtBox()

# native-width f32 device read (4 bytes); f32 path readback
dtoh32(p<Int>)<Float> -> {
    var<Float> out = 0.0
    freedom {
        var<Float32> v = 0.0
        if (cuMemcpyDtoH_v2(loc(v), p, 4) == 0) { out = v as Float }
    }
    return out
}

# f32 variant: build the constant Hadamard/8 as f32 once (16384*4 bytes). Never freed.
had_hoist32(fhgen32<Int>)<Int> -> {
    var<Int> out = 0
    freedom {
        var<Int> hd = 0
        var<Int> pd = 0
        hrc1<Int> = cuMemAlloc_v2(loc(hd), 16384 * 4) as Int
        if (hrc1 == 0) {
            hrc2<Int> = cuMemAlloc_v2(loc(pd), 64) as Int
            if (hrc2 == 0) {
                if (cuMemcpyHtoD_v2(pd + 0, loc(hd), 8) == 0) {
                    hlrc<Int> = cuda_launch4i(from<loc<CVoid>>(fhgen32), 64, 1, 1, 256, 1, 1, pd, 0, 0, 0) as Int
                    hsync<Int> = cuCtxSynchronize() as Int
                    if (hlrc == 0 && hsync == 0) { out = hd }
                }
                cuMemFree_v2(pd)
            }
            if (out == 0) { cuMemFree_v2(hd) }
        }
    }
    return out
}

main()<Int> -> {
    dir<String> = env_get("VYBFORGE_GX_DIR") else "/mnt/apex/rick/vybforge/glm53-checkpoint"
    out<String> = env_get("VYBFORGE_EXL3_OUT") else "native/out/exl3_load_vyb32.txt"
    total<Int> = 83
    expert<String> = env_get("VYBFORGE_EXPERT") else "0"
    pre<String> = "model.language_model.layers.3.mlp.experts." + expert + ".gate_proj."

    want<Vec<String>> = Vec()
    want.push(pre + "trellis")
    want.push(pre + "suh")
    want.push(pre + "svh")

    g<GxLoc> = gx_resolve(dir, total, want)
    nf<Int> = 0
    i<Int> = 0
    while (i < want.len()) {
        if (g.found.get(i) == 1) { nf = nf + 1 }
        i = i + 1
    }
    if (nf != want.len()) { println("EXL3_FAIL resolve " + nf.to_string()); return 3 }

    if (tensor_init() != 0) { println("EXL3_FAIL no cuda"); return 4 }
    fdeq<Int> = load_fn("native/build/exl3.ptx", "exl3deq32")
    fhgen<Int> = load_fn("native/build/exl3.ptx", "exl3hgen32")
    fhad1<Int> = load_fn("native/build/exl3.ptx", "exl3had132")
    fhad2<Int> = load_fn("native/build/exl3.ptx", "exl3had232")
    fcvt32<Int> = load_fn("native/build/exl3.ptx", "exl3cvt32")
    if (fdeq == 0 || fhgen == 0 || fhad1 == 0 || fhad2 == 0) {
        println("EXL3_FAIL kernels (make exl3)")
        return 5
    }
    fgemm2<Int> = load_fn("native/build/gemm.ptx", "gemm")
    fbf2<Int> = load_fn("native/build/bf16.ptx", "bf16deq")
    println("MODULES gemm=" + fgemm2.to_string() + " bf16=" + fbf2.to_string())
    hdg<Int> = had_hoist(fhgen)
    if (hdg == 0) { println("EXL3_FAIL had_hoist"); return 5 }
    # arena, same sizes as the glm_prefill integration attempt
    arA<Int> = 0
    arB<Int> = 0
    arC<Int> = 0
    arD<Int> = 0
    arE<Int> = 0
    arF<Int> = 0
    arG<Int> = 0
    arH<Int> = 0
    arI<Int> = 0
    freedom {
        b1<Int> = cuMemAlloc_v2(loc(arA), 8388608) as Int
        b2<Int> = cuMemAlloc_v2(loc(arB), 65536) as Int
        b3<Int> = cuMemAlloc_v2(loc(arC), 33554432) as Int
        b4<Int> = cuMemAlloc_v2(loc(arD), 33554432) as Int
        b5<Int> = cuMemAlloc_v2(loc(arE), 33554432) as Int
        b6<Int> = cuMemAlloc_v2(loc(arF), 67108864) as Int
        b7<Int> = cuMemAlloc_v2(loc(arG), 16384) as Int
        b8<Int> = cuMemAlloc_v2(loc(arH), 16384) as Int
        b9<Int> = cuMemAlloc_v2(loc(arI), 64) as Int
        if (b1 + b2 + b3 + b4 + b5 + b6 + b7 + b8 + b9 != 0) { println("CVTPROBE arena fail") }
    }
        freedom {
            t<String> = "OK!"
            hA<Int> = cuMemcpyHtoD_v2(arA, t, 3) as Int
            hB<Int> = cuMemcpyHtoD_v2(arB, t, 3) as Int
            hC<Int> = cuMemcpyHtoD_v2(arC, t, 3) as Int
            hD<Int> = cuMemcpyHtoD_v2(arD, t, 3) as Int
            hE<Int> = cuMemcpyHtoD_v2(arE, t, 3) as Int
            hF<Int> = cuMemcpyHtoD_v2(arF, t, 3) as Int
            println("ALLOC-TIME htoD A=" + hA.to_string() + " B=" + hB.to_string() + " C=" + hC.to_string() + " D=" + hD.to_string() + " E=" + hE.to_string() + " F=" + hF.to_string())
        }

    # map.bin: 16-byte header + 256*16 body; the body is shape-independent
    mapd<String> = ""
    match (open_read("native/exl3/map.bin")) {
        f -> { match (read_all(f)) { s -> { mapd = s } ? -> { return 6 } } close(f) }
        ? -> { println("EXL3_FAIL no map.bin (make exl3)"); return 6 }
    }
    body<String> = mapd.substring(16, mapd.len())

    trellis<String> = gx_read(g, 0)
    suh<String> = gx_read(g, 1)
    svh<String> = gx_read(g, 2)
    # gate_proj: [in=4096, out=2048] -> cw (out) 2048, ntiles = (4096/16)*(2048/16)
    # context stress: mimic the driver's alloc/free churn before the first f32 deq
    st<Int> = 0
    freedom {
        var<Int> tmp = 0
        si<Int> = 0
        while (si < 200) {
            src<Int> = cuMemAlloc_v2(loc(tmp), 67108864) as Int
            if (src == 0) { cuMemFree_v2(tmp) }
            si = si + 1
        }
        st = tmp
    }
    # hold ~4 GB live (mimic the driver's heap at first f32 deq)
    freedom {
        hi<Int> = 0
        while (hi < 60) {
            hp<Int> = 0
            hrc<Int> = cuMemAlloc_v2(loc(hp), 67108864) as Int
            hi = hi + 1
        }
    }
    println("HOLD done")
    println("STRESS done st=" + st.to_string())
    dW<Int> = exl3_deq(fdeq, fhgen, fhad1, fhad2, fcvt32, trellis, suh, svh, body, 2048, 32768, hdg, arA, arB, arC, arD, arE, arF, arG, arH, arI)
    if (dW == 0) { println("EXL3_FAIL deq"); return 7 }
    sync()
    W<Vec<Float>> = Vec()
    wi<Int> = 0
    while (wi < 8) {
        W.push(dtoh(dW + wi * 8))
        wi = wi + 1
    }
# arena-backed result: NOT freed (owned by the arena)

    line<String> = digest("gp0", W)
    println(line)
    match (open_write(out)) {
        f -> { write_str(f, line + "\n"); close(f) }
        ? -> { println("EXL3_FAIL write"); return 8 }
    }
    Wf<Vec<Float>> = Vec()
    wj<Int> = 0
    while (wj < 8) {
        Wf.push(dtoh32(cvtbox.p + wj * 4))
        wj = wj + 1
    }
    println(digest("fd32", Wf))

    println("PTRCHECK dW=" + dW.to_string() + " arF=" + arF.to_string() + " arE=" + arE.to_string() + " arC=" + arC.to_string())
    freedom {
        pre<String> = "PREOK!"
        hpre<Int> = cuMemcpyHtoD_v2(arF, pre, 6) as Int
        println("PRE-HTODF rc=" + hpre.to_string())
        hpre2<Int> = cuMemcpyHtoD_v2(arE, pre, 6) as Int
        println("PRE-HTOD-E rc=" + hpre2.to_string())
        hpre3<Int> = cuMemcpyHtoD_v2(dW, pre, 6) as Int
        println("PRE-HTOD-dW rc=" + hpre3.to_string())
    }    println("EXL3_LOAD32_OK expert=" + expert + " elements=" + W.len().to_string())

    t2out<Int> = 0
    # ---- fused dq1 gate: td2 must be bit-identical to the separate deq32+had132 ----
    fdq1<Int> = load_fn("native/build/exl3.ptx", "exl3dq1")
    hdg32<Int> = had_hoist32(fhgen)
    finv<Int> = load_fn("native/build/exl3.ptx", "exl3inv")
    freedom {
        md<Int> = 0
        t2<Int> = 0
        pp<Int> = 0
        mrc<Int> = cuMemAlloc_v2(loc(md), 8192) as Int
        trc<Int> = cuMemAlloc_v2(loc(t2), 33554432) as Int
        prc<Int> = cuMemAlloc_v2(loc(pp), 64) as Int
        if (mrc == 0 && trc == 0 && prc == 0) {
            cuMemcpyHtoD_v2(md, mapd, mapd.len())
            nb<Int> = mapd.len() - 16
            cuMemcpyHtoD_v2(pp + 0, loc(md), 8)
            cuMemcpyHtoD_v2(pp + 8, loc(nb), 8)
            lrcI<Int> = cuda_launch4i(from<loc<CVoid>>(finv), 1, 1, 1, 256, 1, 1, pp, 0, 0, 0) as Int
            srI<Int> = cuCtxSynchronize() as Int
            tq<Int> = 0
            tqrc<Int> = cuMemAlloc_v2(loc(tq), trellis.len()) as Int
            cuMemcpyHtoD_v2(tq, trellis, trellis.len())
            cuMemcpyHtoD_v2(pp + 0, loc(tq), 8)
            cuMemcpyHtoD_v2(pp + 8, loc(md), 8)
            cuMemcpyHtoD_v2(pp + 16, loc(hdg32), 8)
            cuMemcpyHtoD_v2(pp + 24, loc(t2), 8)
            cwv<Int> = 2048
            cuMemcpyHtoD_v2(pp + 32, loc(cwv), 8)
            invb<Int> = md + 16 + nb
            cuMemcpyHtoD_v2(pp + 40, loc(invb), 8)
            g0<Int> = time_mono_millis()
            lrcD<Int> = cuda_launch4i(from<loc<CVoid>>(fdq1), 65536, 1, 1, 128, 1, 1, pp, 0, 0, 0) as Int
            srD<Int> = cuCtxSynchronize() as Int
            g1<Int> = time_mono_millis()
            println("FUSED_DQ1 lrc=" + lrcD.to_string() + " sync=" + srD.to_string() + " ms=" + (g1 - g0).to_string())
            t2out = t2
            cuMemFree_v2(tq)
        }
        cuMemFree_v2(md)
        cuMemFree_v2(pp)
    }
    mm<Int> = 0
    first1<Int> = 0
    first2<Int> = 0
    chk<Int> = 0
    while (chk < 4194304) {
        a1<Float> = dtoh(t2out + chk * 8)
        a2<Float> = dtoh(arD + chk * 8)
        if (a1 != a2) {
            mm = mm + 1
            if (mm == 1) { first1 = chk * 8; first2 = chk * 8 + 4 }
        }
        chk = chk + 1
    }
    println("MISMATCH f32-pairs=" + mm.to_string() + " of 4194304; first pair idx bytes " + first1.to_string() + "/" + first2.to_string())
    # ---- shared-memory fused kernel gate: T3 vs arD, timed ----
    fdqs<Int> = load_fn("native/build/exl3dq.ptx", "exl3dq1s")
    freedom {
        md2<Int> = 0
        t3<Int> = 0
        pp2<Int> = 0
        tq2<Int> = 0
        m2<Int> = cuMemAlloc_v2(loc(md2), 8192) as Int
        t3c<Int> = cuMemAlloc_v2(loc(t3), 33554432) as Int
        p2c<Int> = cuMemAlloc_v2(loc(pp2), 64) as Int
        q2c<Int> = cuMemAlloc_v2(loc(tq2), trellis.len()) as Int
        if (m2 == 0 && t3c == 0 && p2c == 0 && q2c == 0) {
            cuMemcpyHtoD_v2(md2, mapd, mapd.len())
            nb2<Int> = mapd.len() - 16
            cuMemcpyHtoD_v2(tq2, trellis, trellis.len())
            # inv build staging: p+0 = td(map), p+8 = nbody
            cuMemcpyHtoD_v2(pp2 + 0, loc(md2), 8)
            cuMemcpyHtoD_v2(pp2 + 8, loc(nb2), 8)
            li<Int> = cuda_launch4i(from<loc<CVoid>>(finv), 1, 1, 1, 256, 1, 1, pp2, 0, 0, 0) as Int
            si<Int> = cuCtxSynchronize() as Int
            # dqs staging: p+0 q, +8 td, +16 H, +24 T, +32 cw, +40 invbase
            cuMemcpyHtoD_v2(pp2 + 0, loc(tq2), 8)
            cuMemcpyHtoD_v2(pp2 + 8, loc(md2), 8)
            cuMemcpyHtoD_v2(pp2 + 16, loc(hdg32), 8)
            cuMemcpyHtoD_v2(pp2 + 24, loc(t3), 8)
            cw3<Int> = 2048
            cuMemcpyHtoD_v2(pp2 + 32, loc(cw3), 8)
            invb2<Int> = md2 + 16 + nb2
            cuMemcpyHtoD_v2(pp2 + 40, loc(invb2), 8)
            g0s<Int> = time_mono_millis()
            lrcS<Int> = cuda_launch4i(from<loc<CVoid>>(fdqs), 1024, 1, 1, 256, 1, 1, pp2, 0, 0, 0) as Int
            srS<Int> = cuCtxSynchronize() as Int
            g1s<Int> = time_mono_millis()
            println("INVBUILD sync=" + si.to_string())
            println("FUSED_SHARED lrc=" + lrcS.to_string() + " sync=" + srS.to_string() + " ms=" + (g1s - g0s).to_string())
            SHV<Vec<Float>> = Vec()
            sj<Int> = 0
            while (sj < 6) {
                SHV.push(dtoh(t3 + sj * 8))
                sj = sj + 1
            }
            k3<Int> = 0
            while (k3 < 6) {
                println("SHARED dq1s[" + k3.to_string() + "]=" + SHV.get(k3).to_string() + " sep[" + k3.to_string() + "]=" + dtoh(arD + k3 * 8).to_string())
                k3 = k3 + 1
            }
        }
        cuMemFree_v2(md2)
        cuMemFree_v2(t3)
        cuMemFree_v2(pp2)
        cuMemFree_v2(tq2)
    }
    println("TWO-WRITE repro section removed (SEGV-prone; see handoff)")
    return 0
}
