// P2 gate driver: run the MoE block kernels (native/kernels/moe.vyb) on the
// prepared fixture and dump routing + output for verify_moe_vyb.py.
// Files come from native/glm53/prep/ (prepare_moe_fixture.py); uploads are one
// bulk copy per buffer from the String (same conversion cuModuleLoadData uses).
import io::{open_read, read_at, read_all, open_write, write_str, close}
import env::{env_get}

extern "C" {
    cuInit(flags<CUInt>)<CInt>
    cuDeviceGetCount(count<loc<CInt>>)<CInt>
    cuDeviceGet(device<loc<CInt>>, ordinal<CInt>)<CInt>
    cuCtxCreate_v2(pctx<loc<loc<CVoid>>>, flags<CUInt>, dev<CInt>)<CInt>
    cuModuleLoadData(hmod<loc<loc<CVoid>>>, image<CString>)<CInt>
    cuModuleGetFunction(hfunc<loc<loc<CVoid>>>, hmod<loc<CVoid>>, name<CString>)<CInt>
    cuMemAlloc_v2(dptr<loc<Int>>, bytesize<Int>)<CInt>
    cuMemcpyHtoD_v2(dstDevice<Int>, srcHost<loc<CVoid>>, ByteCount<Int>)<CInt>
    cuMemcpyDtoH_v2(dstHost<loc<CVoid>>, srcDevice<Int>, ByteCount<Int>)<CInt>
    cuMemFree_v2(dptr<Int>)<CInt>
    cuCtxSynchronize()<CInt>
    cuda_launch4i(f<loc<CVoid>>, gridX<CUInt>, gridY<CUInt>, gridZ<CUInt>,
                  blockX<CUInt>, blockY<CUInt>, blockZ<CUInt>,
                  a0<Int>, a1<Int>, a2<Int>, a3<Int>)<CInt>
}

readf(path<String>)<String> -> {
    d<String> = ""
    match (open_read(path)) {
        f -> {
            match (read_all(f)) {
                g -> { d = g }
                ? -> { d = "" }
            }
            close(f)
        }
        ? -> { d = "" }
    }
    return d
}

main()<Int> -> {
    hm<String> = env_get("HOME") else "."
    P<String> = "native/glm53/prep"
    yd<String> = readf(P + "/y.f32")
    gd<String> = readf(P + "/gate.f32")
    bd<String> = readf(P + "/bias.f32")
    wged<String> = readf(P + "/wg_e.f32")
    wued<String> = readf(P + "/wu_e.f32")
    wded<String> = readf(P + "/wd_e.f32")
    wgsd<String> = readf(P + "/wg_s.f32")
    wusd<String> = readf(P + "/wu_s.f32")
    wdsd<String> = readf(P + "/wd_s.f32")
    if (yd.len() < 4096 * 4) { println("MISSING_FIXTURE (run prepare_moe_fixture.py)"); return 22 }
    if (gd.len() < 288 * 4096 * 4) { println("SHORT_GATE"); return 22 }
    S<Int> = yd.len() / (4096 * 4)
    println("MOE_DRIVER S=" + S.to_string())

    ptx<String> = readf("native/build/moe.ptx")
    if (ptx.len() == 0) { println("NO_PTX native/build/moe.ptx"); return 13 }

    freedom {
        if (cuInit(0) != 0) { println("SKIP: no CUDA"); return 0 }
        var<CInt> ndev = 0
        if (cuDeviceGetCount(loc(ndev)) != 0 || ndev < 1) { println("SKIP: no device"); return 0 }
        var<CInt> dev = 0
        if (cuDeviceGet(loc(dev), 0) != 0) { return 14 }
        ctx<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuCtxCreate_v2(loc(ctx), 0, dev) != 0) { return 14 }
    }

    freedom {
        hmod<loc<CVoid>> = from<loc<CVoid>>(0)
        lrc<CInt> = cuModuleLoadData(loc(hmod), ptx)
        if (lrc != 0) {
            ptx2<String> = readf("native/build/moe.ptx")
            hmod = from<loc<CVoid>>(0)
            lrc = cuModuleLoadData(loc(hmod), ptx2)
        }
        if (lrc != 0) { return 9 }
        hr<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(hr), hmod, "moe_route") != 0) { return 10 }
        ha<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(ha), hmod, "moe_act") != 0) { return 10 }
        hd<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(hd), hmod, "moe_down") != 0) { return 10 }

        ydv<Int> = 0
        gwv<Int> = 0
        biv<Int> = 0
        lgv<Int> = 0
        ixv<Int> = 0
        wtv<Int> = 0
        acv<Int> = 0
        wgev<Int> = 0
        wuev<Int> = 0
        wdev<Int> = 0
        wgsv<Int> = 0
        wusv<Int> = 0
        wdsv<Int> = 0
        ov<Int> = 0
        pdb<Int> = 0
        if (cuMemAlloc_v2(loc(ydv), yd.len()) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(gwv), gd.len()) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(biv), 288 * 4) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(lgv), S * 288 * 4) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(ixv), S * 8 * 4) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(wtv), S * 8 * 4) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(acv), S * 9 * 2048 * 4) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(wgev), wged.len()) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(wuev), wued.len()) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(wdev), wded.len()) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(wgsv), wgsd.len()) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(wusv), wusd.len()) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(wdsv), wdsd.len()) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(ov), S * 4096 * 4) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(pdb), 128) != 0) { return 11 }

        if (cuMemcpyHtoD_v2(ydv, yd, yd.len()) != 0) { return 15 }
        if (cuMemcpyHtoD_v2(gwv, gd, gd.len()) != 0) { return 15 }
        if (cuMemcpyHtoD_v2(biv, bd, 288 * 4) != 0) { return 15 }
        if (cuMemcpyHtoD_v2(wgev, wged, wged.len()) != 0) { return 15 }
        if (cuMemcpyHtoD_v2(wuev, wued, wued.len()) != 0) { return 15 }
        if (cuMemcpyHtoD_v2(wdev, wded, wded.len()) != 0) { return 15 }
        if (cuMemcpyHtoD_v2(wgsv, wgsd, wgsd.len()) != 0) { return 15 }
        if (cuMemcpyHtoD_v2(wusv, wusd, wusd.len()) != 0) { return 15 }
        if (cuMemcpyHtoD_v2(wdsv, wdsd, wdsd.len()) != 0) { return 15 }

        # params: 14 pointers + S
        pv<Int> = 0
        while (pv < 15) {
            ch<Int> = 0
            if (pv == 0) { ch = ydv }
            if (pv == 1) { ch = gwv }
            if (pv == 2) { ch = biv }
            if (pv == 3) { ch = lgv }
            if (pv == 4) { ch = ixv }
            if (pv == 5) { ch = wtv }
            if (pv == 6) { ch = acv }
            if (pv == 7) { ch = wgev }
            if (pv == 8) { ch = wuev }
            if (pv == 9) { ch = wdev }
            if (pv == 10) { ch = wgsv }
            if (pv == 11) { ch = wusv }
            if (pv == 12) { ch = wdsv }
            if (pv == 13) { ch = ov }
            if (pv == 14) { ch = S }
            if (cuMemcpyHtoD_v2(pdb + pv * 8, loc(ch), 8) != 0) { return 15 }
            pv = pv + 1
        }

        r1<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(hr)), 1, 1, 1, 256, 1, 1, pdb, 0, 0, 0)
        if (r1 != 0) { println("launch route rc"); println_int(r1); return 12 }
        cuCtxSynchronize()
        nact<Int> = S * 9 * 2048
        r2<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(ha)), (nact + 255) / 256, 1, 1, 256, 1, 1, pdb, 0, 0, 0)
        if (r2 != 0) { println("launch act rc"); println_int(r2); return 12 }
        cuCtxSynchronize()
        ndn<Int> = S * 4096
        r3<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(hd)), (ndn + 255) / 256, 1, 1, 256, 1, 1, pdb, 0, 0, 0)
        if (r3 != 0) { println("launch down rc"); println_int(r3); return 12 }
        cuCtxSynchronize()

        match (open_write("native/out/moe_out.txt")) {
            w -> {
                i<Int> = 0
                while (i < ndn) {
                    # f32 store: read the 4-byte word into an Int, decode in python
                    wv<Int> = 0
                    if (cuMemcpyDtoH_v2(loc(wv), ov + i * 4, 4) != 0) { return 16 }
                    match (write_str(w, wv.to_string() + "\n")) { q -> { } ? -> { return 17 } }
                    i = i + 1
                }
                close(w)
            }
            ? -> { return 17 }
        }
        match (open_write("native/out/moe_route.txt")) {
            w -> {
                i<Int> = 0
                while (i < S * 8) {
                    wi<Int> = 0
                    if (cuMemcpyDtoH_v2(loc(wi), ixv + i * 4, 4) != 0) { return 16 }
                    match (write_str(w, wi.to_string() + "\n")) { q -> { } ? -> { return 17 } }
                    i = i + 1
                }
                i = 0
                while (i < S * 8) {
                    ww<Int> = 0
                    if (cuMemcpyDtoH_v2(loc(ww), wtv + i * 4, 4) != 0) { return 16 }
                    match (write_str(w, ww.to_string() + "\n")) { q -> { } ? -> { return 17 } }
                    i = i + 1
                }
                close(w)
            }
            ? -> { return 17 }
        }

        cuMemFree_v2(ydv)
        cuMemFree_v2(gwv)
        cuMemFree_v2(biv)
        cuMemFree_v2(lgv)
        cuMemFree_v2(ixv)
        cuMemFree_v2(wtv)
        cuMemFree_v2(acv)
        cuMemFree_v2(wgev)
        cuMemFree_v2(wuev)
        cuMemFree_v2(wdev)
        cuMemFree_v2(wgsv)
        cuMemFree_v2(wusv)
        cuMemFree_v2(wdsv)
        cuMemFree_v2(ov)
        cuMemFree_v2(pdb)

        println("MOE_DRIVER_DONE elements=" + ndn.to_string())
        return 0
    }
}
