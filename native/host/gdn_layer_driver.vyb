// GDN recurrent-LAYER wiring driver (phase 4 item 1, unit 7).
//
// Assembles one qwen35 linear-attention block out of GPU kernels, in the order
// src/models/qwen35.cpp builds it — attn_norm (the existing rmsnorm kernel, from a second module) →
// wqkv / wqkv_gate (mm_nt) → beta (mm_nt + sigmoid) → alpha gate (mm_nt + softplus*ssm_a) → the
// causal short conv (conv1d_k + silu_k) → the q|k|v split as channel offsets → l2norm on q and k →
// delta_step → the gated RMS epilogue (norm_gated) → ssm_out (mm_nt) → the attn residual (add_k) —
// and dumps every stage so the result can be compared per stage against unit 5's authority, which
// builds the same block out of ggml's own ops.
//
// Geometry is a fixture (small enough to be quick, and NOT degenerate: S=32, H_k=4, H_v=8, d_conv=4
// all have strides > 1, which is where the axis traps live). One token, one sequence.
//
// Input native/build/gdn_layer_in.bin, fp64, ALL ggml order (ne0 fastest), in this order:
//   x 2*NE (two tokens) | attn_norm NE | wqkv QKV*NE | wqkv_gate VALUE*NE | ssm_beta HV*NE | ssm_alpha HV*NE |
//   ssm_dt HV | ssm_a HV | ssm_conv1d QKV*DC | ssm_norm S | ssm_out NE*VALUE | conv_zero (DC-1+1)*QKV |
//   state S*S*HV
// Prints SKIP and returns 0 without CUDA.
import io::{open_read, read_at, close}

extern "C" {
    cuInit(flags<CUInt>)<CInt>
    cuDeviceGetCount(count<loc<CInt>>)<CInt>
    cuDeviceGet(device<loc<CInt>>, ordinal<CInt>)<CInt>
    cuCtxCreate_v2(pctx<loc<loc<CVoid>>>, flags<CUInt>, dev<CInt>)<CInt>
    cuModuleLoadData(hmod<loc<loc<CVoid>>>, image<CString>)<CInt>
    cuModuleGetFunction(hfunc<loc<loc<CVoid>>>, hmod<loc<CVoid>>, name<CString>)<CInt>
    cuMemAlloc_v2(dptr<loc<Int>>, bytesize<Int>)<CInt>
    cuMemcpyHtoD_v2(dstDevice<Int>, srcHost<loc<CVoid>>, ByteCount<Int>)<CInt>
    cuMemcpyDtoH_v2(dstHost<loc<CVoid>>, srcDevice<Int>, ByteCount<Int>)<CInt>
    cuMemFree_v2(dptr<Int>)<CInt>
    cuCtxSynchronize()<CInt>
    cuda_launch4i(f<loc<CVoid>>, gridX<CUInt>, gridY<CUInt>, gridZ<CUInt>,
                  blockX<CUInt>, blockY<CUInt>, blockZ<CUInt>,
                  a0<Int>, a1<Int>, a2<Int>, a3<Int>)<CInt>
}

upload(data<String>, dst<Int>, nbytes<Int>)<Int> -> {
    freedom {
        if (cuMemcpyHtoD_v2(dst, from<loc<CVoid>>(addr(data)), nbytes) != 0) { return 15 }
        return 0
    }
    return 0
}

read_slice(f<File>, off<Int>, nbytes<Int>)<String> -> {
    r<String> = ""
    match (read_at(f, off, nbytes)) { s -> { r = s } ? -> { r = "" } }
    return r
}

dump_section(base<Int>, count<Int>, pfx<String>, nm<String>) -> {
    println("DUMP " + pfx + nm + " " + count.to_string())
    acc<String> = ""
    i<Int> = 0
    for (i in 0..count - 1) {
        iv<Int> = 0
        freedom {
            cuMemcpyDtoH_v2(loc(iv), base + i * 8, 8)
        }
        acc = acc + iv.to_string() + " "
        if (i % 64 == 63) { println(acc); acc = "" }
    }
    if (count % 64 != 0) { println(acc) }
}

put_i(PD<Int>, off<Int>, v<Int>) -> {
    freedom {
        cuMemcpyHtoD_v2(PD + off, loc(v), 8)
    }
}
put_f(PD<Int>, off<Int>, v<Float>) -> {
    freedom {
        cuMemcpyHtoD_v2(PD + off, loc(v), 8)
    }
}

main()<Int> -> {
    NE<Int> = 5120
    S<Int> = 128
    HK<Int> = 16
    HV<Int> = 48
    DC<Int> = 4
    KEY<Int> = HK * S
    VALUE<Int> = HV * S
    QKV<Int> = 2 * KEY + VALUE
    eps<Float> = 0.000001
    sc<Float> = 0.08838834764831845        # 1/sqrt(128)
    blkNN<Int> = 256
    gRms<Int> = (NE + 255) / 256
    gQkv<Int> = (QKV + 255) / 256
    gVal<Int> = (VALUE + 255) / 256
    gKey<Int> = (HK * S + 255) / 256
    gHead<Int> = (HV * S + 255) / 256
    gOut<Int> = (NE + 255) / 256

    xs<String> = "" ; ans<String> = "" ; wqs<String> = "" ; wgs<String> = ""
    wbs<String> = "" ; was<String> = "" ; dts<String> = "" ; asa<String> = ""
    cws<String> = "" ; sns<String> = "" ; sos<String> = "" ; zws<String> = "" ; sts<String> = ""
    aqs<String> = "" ; bqs<String> = ""
    qkvq<String> = "" ; gatq<String> = "" ; outq<String> = ""
    match (open_read("native/build/gdn_layer_in.bin")) {
        fh -> {
            o<Int> = 0
            xs = read_slice(fh, o, 2 * NE * 8)          ; o = o + 2 * NE * 8
            ans = read_slice(fh, o, NE * 8)            ; o = o + NE * 8
            wqs = read_slice(fh, o, QKV * NE * 8)      ; o = o + QKV * NE * 8
            wgs = read_slice(fh, o, VALUE * NE * 8)    ; o = o + VALUE * NE * 8
            wbs = read_slice(fh, o, HV * NE * 8)       ; o = o + HV * NE * 8
            was = read_slice(fh, o, HV * NE * 8)       ; o = o + HV * NE * 8
            dts = read_slice(fh, o, HV * 8)            ; o = o + HV * 8
            asa = read_slice(fh, o, HV * 8)            ; o = o + HV * 8
            cws = read_slice(fh, o, QKV * DC * 8)      ; o = o + QKV * DC * 8
            sns = read_slice(fh, o, S * 8)             ; o = o + S * 8
            sos = read_slice(fh, o, NE * VALUE * 8)    ; o = o + NE * VALUE * 8
            zws = read_slice(fh, o, DC * QKV * 8)          ; o = o + DC * QKV * 8
            sts = read_slice(fh, o, S * S * HV * 8)    ; o = o + S * S * HV * 8
            aqs = read_slice(fh, o, HV * NE * 34 / 32) ; o = o + HV * NE * 34 / 32   # Q8_0: 34 B / 32 values
            bqs = read_slice(fh, o, HV * NE * 34 / 32) ; o = o + HV * NE * 34 / 32
            qkvq = read_slice(fh, o, QKV * NE * 144 / 256) ; o = o + QKV * NE * 144 / 256   # Q4_K: 144 B / 256 values
            gatq = read_slice(fh, o, VALUE * NE * 144 / 256) ; o = o + VALUE * NE * 144 / 256
            outq = read_slice(fh, o, NE * VALUE * 144 / 256)
            close(fh)
        }
        ? -> { println("GDNL_ERR no input file") ; return 13 }
    }

    freedom {
        if (cuInit(0) != 0) { println("SKIP: no CUDA"); return 0 }
        var<CInt> ndev = 0
        if (cuDeviceGetCount(loc(ndev)) != 0 || ndev < 1) { println("SKIP: no CUDA device"); return 0 }
        var<CInt> dev = 0
        if (cuDeviceGet(loc(dev), 0) != 0) { return 14 }
        ctx<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuCtxCreate_v2(loc(ctx), 0, dev) != 0) { return 14 }
    }

    ptxG<String> = ""
    match (open_read("native/build/gdn.ptx")) {
        g -> { ptxG = read_slice(g, 0, 262144) ; close(g) }
        ? -> { return 13 }
    }
    ptxR<String> = ""
    match (open_read("native/build/rmsnorm.ptx")) {
        g -> { ptxR = read_slice(g, 0, 65536) ; close(g) }
        ? -> { return 13 }
    }
    ptxQ<String> = ""
    match (open_read("native/build/q8_0.ptx")) {
        g -> { ptxQ = read_slice(g, 0, 65536) ; close(g) }
        ? -> { return 13 }
    }
    ptxK<String> = ""
    match (open_read("native/build/q4k.ptx")) {
        g -> { ptxK = read_slice(g, 0, 65536) ; close(g) }
        ? -> { return 13 }
    }

    freedom {
        hmodG<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleLoadData(loc(hmodG), ptxG) != 0) { return 9 }
        hmodR<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleLoadData(loc(hmodR), ptxR) != 0) { return 9 }
        hmodQ<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleLoadData(loc(hmodQ), ptxQ) != 0) { return 9 }
        hmodK<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleLoadData(loc(hmodK), ptxK) != 0) { return 9 }

        hRN<loc<CVoid>> = from<loc<CVoid>>(0)
        hMM<loc<CVoid>> = from<loc<CVoid>>(0)
        hSG<loc<CVoid>> = from<loc<CVoid>>(0)
        hAG<loc<CVoid>> = from<loc<CVoid>>(0)
        hSV<loc<CVoid>> = from<loc<CVoid>>(0)
        hCV<loc<CVoid>> = from<loc<CVoid>>(0)
        hIL<loc<CVoid>> = from<loc<CVoid>>(0)
        hSH<loc<CVoid>> = from<loc<CVoid>>(0)
        hL2<loc<CVoid>> = from<loc<CVoid>>(0)
        hDS<loc<CVoid>> = from<loc<CVoid>>(0)
        hNG<loc<CVoid>> = from<loc<CVoid>>(0)
        hAD<loc<CVoid>> = from<loc<CVoid>>(0)
        hQ8<loc<CVoid>> = from<loc<CVoid>>(0)
        hQ4<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(hRN), hmodR, "rmsnorm") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hMM), hmodG, "mm_nt") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hSG), hmodG, "sigmoid_k") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hAG), hmodG, "alpha_gate") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hSV), hmodG, "silu_k") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hCV), hmodG, "conv1d_k") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hIL), hmodG, "interleave_qkv") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hSH), hmodG, "conv_shift") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hL2), hmodG, "l2norm") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hDS), hmodG, "delta_step") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hNG), hmodG, "norm_gated") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hAD), hmodG, "add_k") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hQ8), hmodQ, "q8_0deq") != 0) { return 10 }
        if (cuModuleGetFunction(loc(hQ4), hmodK, "q4kdeq") != 0) { return 10 }

        DQ8A<Int> = 0 ; DQ8B<Int> = 0 ; DQ4A<Int> = 0 ; DQ4B<Int> = 0 ; DQ4C<Int> = 0
        DX<Int> = 0 ; DAN<Int> = 0 ; DWQKV<Int> = 0 ; DWG<Int> = 0 ; DWB<Int> = 0 ; DWA<Int> = 0
        DDT<Int> = 0 ; DA<Int> = 0 ; DCW<Int> = 0 ; DSN<Int> = 0 ; DSO<Int> = 0
        DXN<Int> = 0 ; DQKV<Int> = 0 ; DCONV<Int> = 0 ; DCONVS<Int> = 0 ; DZ<Int> = 0 ; DBRAW<Int> = 0 ; DBETA<Int> = 0
        DARAW<Int> = 0 ; DGATE<Int> = 0 ; DCRAW<Int> = 0 ; DQN<Int> = 0 ; DKN<Int> = 0
        DSTATE<Int> = 0 ; DSTOUT<Int> = 0 ; DEL<Int> = 0 ; DOUT<Int> = 0 ; DEPI<Int> = 0
        DY<Int> = 0 ; DLO<Int> = 0
        P1<Int> = 0 ; P2<Int> = 0 ; P3<Int> = 0 ; P4<Int> = 0
        cuMemAlloc_v2(loc(DQ8A), HV * NE * 34 / 32)
        cuMemAlloc_v2(loc(DQ4A), QKV * NE * 144 / 256)
        cuMemAlloc_v2(loc(DQ4B), VALUE * NE * 144 / 256)
        cuMemAlloc_v2(loc(DQ4C), NE * VALUE * 144 / 256)
        cuMemAlloc_v2(loc(DQ8B), HV * NE * 34 / 32)
        cuMemAlloc_v2(loc(DX), 2 * NE * 8)          # both tokens of this fixture
        cuMemAlloc_v2(loc(DAN), NE * 8)
        cuMemAlloc_v2(loc(DWQKV), QKV * NE * 8)
        cuMemAlloc_v2(loc(DWG), VALUE * NE * 8)
        cuMemAlloc_v2(loc(DWB), HV * NE * 8)
        cuMemAlloc_v2(loc(DWA), HV * NE * 8)
        cuMemAlloc_v2(loc(DDT), HV * 8)
        cuMemAlloc_v2(loc(DA), HV * 8)
        cuMemAlloc_v2(loc(DCW), QKV * DC * 8)
        cuMemAlloc_v2(loc(DSN), S * 8)
        cuMemAlloc_v2(loc(DSO), NE * VALUE * 8)
        cuMemAlloc_v2(loc(DXN), NE * 8)
        cuMemAlloc_v2(loc(DQKV), QKV * 8)
        cuMemAlloc_v2(loc(DCONV), DC * QKV * 8)          # window + token, ssm_conv's input
        cuMemAlloc_v2(loc(DCONVS), QKV * 8)
        cuMemAlloc_v2(loc(DZ), VALUE * 8)
        cuMemAlloc_v2(loc(DBRAW), HV * 8)
        cuMemAlloc_v2(loc(DBETA), HV * 8)
        cuMemAlloc_v2(loc(DARAW), HV * 8)
        cuMemAlloc_v2(loc(DGATE), HV * 8)
        cuMemAlloc_v2(loc(DCRAW), QKV * 8)
        cuMemAlloc_v2(loc(DQN), KEY * 8)
        cuMemAlloc_v2(loc(DKN), KEY * 8)
        cuMemAlloc_v2(loc(DSTATE), S * S * HV * 8)
        cuMemAlloc_v2(loc(DSTOUT), S * S * HV * 8)
        cuMemAlloc_v2(loc(DEL), S * HV * 8)
        cuMemAlloc_v2(loc(DOUT), S * HV * 8)
        cuMemAlloc_v2(loc(DEPI), S * HV * 8)
        cuMemAlloc_v2(loc(DY), NE * 8)
        cuMemAlloc_v2(loc(DLO), NE * 8)
        cuMemAlloc_v2(loc(P1), 128) ; cuMemAlloc_v2(loc(P2), 128)
        cuMemAlloc_v2(loc(P3), 128) ; cuMemAlloc_v2(loc(P4), 128)

        upload(xs, DX, 2 * NE * 8) ; upload(ans, DAN, NE * 8)
        upload(wqs, DWQKV, QKV * NE * 8) ; upload(wgs, DWG, VALUE * NE * 8)
        upload(wbs, DWB, HV * NE * 8) ; upload(was, DWA, HV * NE * 8)
        # ssm_alpha / ssm_beta: when the fixture carries the model's own Q8_0 tensors, dequantise them
        # on the GPU with the existing q8_0deq kernel instead of using the f64 upload above.
        rcq<CInt> = 0
        if (qkvq.len() > 0) {
            upload(qkvq, DQ4A, QKV * NE * 144 / 256)
            rcq = cuda_launch4i(from<loc<CVoid>>(addr(hQ4)), (QKV * NE) / 256, 1, 1, 256, 1, 1, DQ4A, DWQKV, QKV * NE, 0)
            if (rcq != 0) { println("GDNL_ERR q4 qkv") ; return 12 }
        }
        if (gatq.len() > 0) {
            upload(gatq, DQ4B, VALUE * NE * 144 / 256)
            rcq = cuda_launch4i(from<loc<CVoid>>(addr(hQ4)), (VALUE * NE) / 256, 1, 1, 256, 1, 1, DQ4B, DWG, VALUE * NE, 0)
            if (rcq != 0) { println("GDNL_ERR q4 gate") ; return 12 }
        }
        if (outq.len() > 0) {
            upload(outq, DQ4C, NE * VALUE * 144 / 256)
            rcq = cuda_launch4i(from<loc<CVoid>>(addr(hQ4)), (NE * VALUE) / 256, 1, 1, 256, 1, 1, DQ4C, DSO, NE * VALUE, 0)
            if (rcq != 0) { println("GDNL_ERR q4 ssm_out") ; return 12 }
        }
        if (aqs.len() > 0) {
            upload(aqs, DQ8A, HV * NE * 34 / 32)
            rcq = cuda_launch4i(from<loc<CVoid>>(addr(hQ8)), 960, 1, 1, 256, 1, 1, DQ8A, DWA, HV * NE, 0)
            if (rcq != 0) { println("GDNL_ERR q8 alpha") ; return 12 }
        }
        if (bqs.len() > 0) {
            upload(bqs, DQ8B, HV * NE * 34 / 32)
            rcq = cuda_launch4i(from<loc<CVoid>>(addr(hQ8)), 960, 1, 1, 256, 1, 1, DQ8B, DWB, HV * NE, 0)
            if (rcq != 0) { println("GDNL_ERR q8 beta") ; return 12 }
        }
        upload(dts, DDT, HV * 8) ; upload(asa, DA, HV * 8)
        upload(cws, DCW, QKV * DC * 8) ; upload(sns, DSN, S * 8)
        upload(sos, DSO, NE * VALUE * 8) ; upload(zws, DCONV, DC * QKV * 8)
        upload(sts, DSTATE, S * S * HV * 8)

        # ---- the decode steps: two tokens, carrying the conv window and the delta-net state ----
        stin<Int> = DSTATE
        stout<Int> = DSTOUT
        st<Int> = 0
        for (st in 0..1) {
        xp<Int> = DX + st * NE * 8
        pf<String> = "s1_"
        if (st == 1) { pf = "s2_" }
        if (st > 0) {
            put_i(P4, 0, DCONV) ; put_i(P4, 8, QKV) ; put_i(P4, 16, DC) ; put_i(P4, 24, 0)
            rc = cuda_launch4i(from<loc<CVoid>>(addr(hSH)), gQkv, 1, 1, 256, 1, 1, P4, 0, 0, 0)
            if (rc != 0) { println("GDNL_ERR conv_shift") ; return 12 }
        }

        # ---- 1. attn_norm: the existing rmsnorm kernel, params (X, W, Y, rows, D, eps) ----
        put_i(P1, 0, xp) ; put_i(P1, 8, DAN) ; put_i(P1, 16, DXN)
        put_i(P1, 24, 1) ; put_i(P1, 32, NE) ; put_f(P1, 40, eps)
        rc<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(hRN)), gRms, 1, 1, 256, 1, 1, P1, 0, 0, 0)
        if (rc != 0) { println("GDNL_ERR rmsnorm") ; println_int(rc) ; return 12 }

        # ---- 2. projections ----
        put_i(P2, 0, DXN) ; put_i(P2, 8, DWQKV) ; put_i(P2, 16, DQKV)
        put_i(P2, 24, 1) ; put_i(P2, 32, QKV) ; put_i(P2, 40, NE)
        rc = cuda_launch4i(from<loc<CVoid>>(addr(hMM)), gQkv, 1, 1, 256, 1, 1, P2, 0, 0, 0)
        if (rc != 0) { println("GDNL_ERR mm wqkv") ; return 12 }
        put_i(P2, 8, DWG) ; put_i(P2, 16, DZ) ; put_i(P2, 32, VALUE)
        rc = cuda_launch4i(from<loc<CVoid>>(addr(hMM)), gVal, 1, 1, 256, 1, 1, P2, 0, 0, 0)
        if (rc != 0) { println("GDNL_ERR mm wgate") ; return 12 }
        put_i(P2, 8, DWB) ; put_i(P2, 16, DBRAW) ; put_i(P2, 32, HV)
        rc = cuda_launch4i(from<loc<CVoid>>(addr(hMM)), 1, 1, 1, 256, 1, 1, P2, 0, 0, 0)
        if (rc != 0) { println("GDNL_ERR mm wbeta") ; return 12 }
        put_i(P2, 8, DWA) ; put_i(P2, 16, DARAW) ; put_i(P2, 32, HV)
        rc = cuda_launch4i(from<loc<CVoid>>(addr(hMM)), 1, 1, 1, 256, 1, 1, P2, 0, 0, 0)
        if (rc != 0) { println("GDNL_ERR mm walpha") ; return 12 }

        # ---- 3. the two gates ----
        put_i(P3, 0, DBRAW) ; put_i(P3, 8, DBETA) ; put_i(P3, 16, HV)
        rc = cuda_launch4i(from<loc<CVoid>>(addr(hSG)), 1, 1, 1, 64, 1, 1, P3, 0, 0, 0)
        if (rc != 0) { println("GDNL_ERR sigmoid") ; return 12 }
        put_i(P3, 0, DARAW) ; put_i(P3, 8, DDT) ; put_i(P3, 16, DA) ; put_i(P3, 24, DGATE) ; put_i(P3, 32, HV)
        rc = cuda_launch4i(from<loc<CVoid>>(addr(hAG)), 1, 1, 1, 64, 1, 1, P3, 0, 0, 0)
        if (rc != 0) { println("GDNL_ERR alpha_gate") ; return 12 }

        # ---- 4. the conv input's token frames, the causal short conv, then SiLU ----
        put_i(P4, 0, DQKV) ; put_i(P4, 8, DCONV) ; put_i(P4, 16, QKV) ; put_i(P4, 24, DC) ; put_i(P4, 32, 1)
        rc = cuda_launch4i(from<loc<CVoid>>(addr(hIL)), gQkv, 1, 1, 256, 1, 1, P4, 0, 0, 0)
        if (rc != 0) { println("GDNL_ERR interleave") ; return 12 }
        put_i(P3, 0, DCONV) ; put_i(P3, 8, DCW) ; put_i(P3, 16, DCRAW)
        put_i(P3, 24, QKV) ; put_i(P3, 32, DC) ; put_i(P3, 40, 1)
        rc = cuda_launch4i(from<loc<CVoid>>(addr(hCV)), gQkv, 1, 1, 256, 1, 1, P3, 0, 0, 0)
        if (rc != 0) { println("GDNL_ERR conv") ; return 12 }
        put_i(P3, 0, DCRAW) ; put_i(P3, 8, DCONVS) ; put_i(P3, 16, QKV)
        rc = cuda_launch4i(from<loc<CVoid>>(addr(hSV)), gQkv, 1, 1, 256, 1, 1, P3, 0, 0, 0)
        if (rc != 0) { println("GDNL_ERR silu") ; return 12 }

        # ---- 5. l2 norm on q and k (the q|k|v split is just channel offsets) ----
        put_i(P1, 0, DCONVS) ; put_i(P1, 8, DQN) ; put_i(P1, 16, HK) ; put_i(P1, 24, S) ; put_f(P1, 32, eps)
        rc = cuda_launch4i(from<loc<CVoid>>(addr(hL2)), gKey, 1, 1, 256, 1, 1, P1, 0, 0, 0)
        if (rc != 0) { println("GDNL_ERR l2 q") ; return 12 }
        put_i(P1, 0, DCONVS + KEY * 8) ; put_i(P1, 8, DKN)
        rc = cuda_launch4i(from<loc<CVoid>>(addr(hL2)), gKey, 1, 1, 256, 1, 1, P1, 0, 0, 0)
        if (rc != 0) { println("GDNL_ERR l2 k") ; return 12 }

        # ---- 6. the recurrence ----
        put_i(P2, 0, DQN) ; put_i(P2, 8, DKN) ; put_i(P2, 16, DCONVS + 2 * KEY * 8)
        put_i(P2, 24, DGATE) ; put_i(P2, 32, DBETA) ; put_i(P2, 40, stin)
        put_i(P2, 48, stout) ; put_i(P2, 56, DOUT) ; put_i(P2, 64, DEL)
        put_i(P2, 72, S) ; put_i(P2, 80, HK) ; put_i(P2, 88, HV) ; put_f(P2, 96, sc)
        rc = cuda_launch4i(from<loc<CVoid>>(addr(hDS)), 1, 1, 1, HV, 1, 1, P2, 0, 0, 0)
        if (rc != 0) { println("GDNL_ERR delta_step") ; return 12 }

        # ---- 7. the gated RMS epilogue, then ssm_out and the residual ----
        put_i(P3, 0, DOUT) ; put_i(P3, 8, DZ) ; put_i(P3, 16, DSN) ; put_i(P3, 24, DEPI)
        put_i(P3, 32, HV) ; put_i(P3, 40, S) ; put_f(P3, 48, eps)
        rc = cuda_launch4i(from<loc<CVoid>>(addr(hNG)), gHead, 1, 1, 256, 1, 1, P3, 0, 0, 0)
        if (rc != 0) { println("GDNL_ERR norm_gated") ; return 12 }
        put_i(P2, 0, DEPI) ; put_i(P2, 8, DSO) ; put_i(P2, 16, DY)
        put_i(P2, 24, 1) ; put_i(P2, 32, NE) ; put_i(P2, 40, VALUE)
        rc = cuda_launch4i(from<loc<CVoid>>(addr(hMM)), gOut, 1, 1, 256, 1, 1, P2, 0, 0, 0)
        if (rc != 0) { println("GDNL_ERR mm ssm_out") ; return 12 }
        put_i(P3, 0, DY) ; put_i(P3, 8, xp) ; put_i(P3, 16, DLO) ; put_i(P3, 24, NE)
        rc = cuda_launch4i(from<loc<CVoid>>(addr(hAD)), gOut, 1, 1, 256, 1, 1, P3, 0, 0, 0)
        if (rc != 0) { println("GDNL_ERR residual") ; return 12 }
        cuCtxSynchronize()

        sw<Int> = stin ; stin = stout ; stout = sw      # the new state is the next step's input
        dump_section(DXN, NE, pf, "xn")
        dump_section(DQKV, QKV, pf, "qkv")
        dump_section(DZ, VALUE, pf, "z")
        dump_section(DBETA, HV, pf, "beta")
        dump_section(DGATE, HV, pf, "gate")
        dump_section(DCONVS, QKV, pf, "conv_silu")
        dump_section(DQN, KEY, pf, "q_norm")
        dump_section(DKN, KEY, pf, "k_norm")
        dump_section(DOUT, S * HV, pf, "gdn_out")
        dump_section(DEPI, S * HV, pf, "epi")
        dump_section(DY, NE, pf, "y")
        dump_section(DLO, NE, pf, "layer_out")
        dump_section(stin, S * S * HV, pf, "state_out")
        }

        cuMemFree_v2(DX) ; cuMemFree_v2(DAN) ; cuMemFree_v2(DQ8A) ; cuMemFree_v2(DQ8B)
        cuMemFree_v2(DQ4A) ; cuMemFree_v2(DQ4B) ; cuMemFree_v2(DQ4C) ; cuMemFree_v2(DWQKV) ; cuMemFree_v2(DWG)
        cuMemFree_v2(DWB) ; cuMemFree_v2(DWA) ; cuMemFree_v2(DDT) ; cuMemFree_v2(DA)
        cuMemFree_v2(DCW) ; cuMemFree_v2(DSN) ; cuMemFree_v2(DSO)
        cuMemFree_v2(DXN) ; cuMemFree_v2(DQKV) ; cuMemFree_v2(DCONV) ; cuMemFree_v2(DCONVS) ; cuMemFree_v2(DZ)
        cuMemFree_v2(DBRAW) ; cuMemFree_v2(DBETA) ; cuMemFree_v2(DARAW) ; cuMemFree_v2(DGATE)
        cuMemFree_v2(DCRAW) ; cuMemFree_v2(DQN) ; cuMemFree_v2(DKN) ; cuMemFree_v2(DSTATE)
        cuMemFree_v2(DSTOUT) ; cuMemFree_v2(DEL) ; cuMemFree_v2(DOUT) ; cuMemFree_v2(DEPI)
        cuMemFree_v2(DY) ; cuMemFree_v2(DLO)
        cuMemFree_v2(P1) ; cuMemFree_v2(P2) ; cuMemFree_v2(P3) ; cuMemFree_v2(P4)
    }
    println("GDNL_DONE steps=2 NE=5120 S=128 Hk=16 Hv=48 d_conv=4")
    return 0
}
