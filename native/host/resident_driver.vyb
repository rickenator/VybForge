// Real Qwen3-4B autoregressive greedy decode on the GPU, exclusively Vyb.
// Keeps all 36 layers' PACKED weights resident on-GPU (one ~2.3GB upload; packed
// stays canonical per issue #5), dequants to f64 per layer inside each step (fast
// kernels, no H2D in the loop), runs the shared layer.vyb forward, then the tied
// lm_head argmax -> next token id. Writes native/out/decode_ids_vyb.txt; the numpy
// reference (native/gguf/decode_ref.py) must match it token-for-token.
import io::{open_read, read_at, read_all, open_write, write_str, close}
import llm::{llm_load, llm_decode}
import vllm::{Model}
import env::{env_get}
import time::{time_mono_millis}

extern "C" {
    cuInit(flags<CUInt>)<CInt>
    cuDeviceGetCount(count<loc<CInt>>)<CInt>
    cuDeviceGet(device<loc<CInt>>, ordinal<CInt>)<CInt>
    cuCtxCreate_v2(pctx<loc<loc<CVoid>>>, flags<CUInt>, dev<CInt>)<CInt>
    cuModuleLoadData(hmod<loc<loc<CVoid>>>, image<CString>)<CInt>
    cuModuleGetFunction(hfunc<loc<loc<CVoid>>>, hmod<loc<CVoid>>, name<CString>)<CInt>
    cuMemAlloc_v2(dptr<loc<Int>>, bytesize<Int>)<CInt>
    cuMemcpyHtoD_v2(dstDevice<Int>, srcHost<loc<CVoid>>, ByteCount<Int>)<CInt>
    cuMemcpyHtoDAsync_v2(dstDevice<Int>, srcHost<CString>, ByteCount<Int>, hStream<Int>)<CInt>
    cuMemcpyDtoH_v2(dstHost<loc<CVoid>>, srcDevice<Int>, ByteCount<Int>)<CInt>
    cuMemcpyDtoD_v2(dstDevice<Int>, srcDevice<Int>, ByteCount<Int>)<CInt>
    cuMemFree_v2(dptr<Int>)<CInt>
    cuCtxSynchronize()<CInt>
    cuda_launch4i(f<loc<CVoid>>, gridX<CUInt>, gridY<CUInt>, gridZ<CUInt>,
                  blockX<CUInt>, blockY<CUInt>, blockZ<CUInt>,
                  a0<Int>, a1<Int>, a2<Int>, a3<Int>)<CInt>
}

u8(s<String>, o<Int>)<Int> -> { return (s.char_at(o) as Int) & 255 }
strchr(s<String>, nd<Int>, st<Int>)<Int> -> {
    i<Int> = st
    for (i in st..s.len() - 1) { if ((s.char_at(i) as Int) == nd) { return i } }
    return -1
}
parse_u(s<String>, frm<Int>, endp<Int>)<Int> -> {
    a<Int> = 0
    i<Int> = frm
    for (i in frm..endp - 1) {
        c<Int> = (s.char_at(i) as Int)
        if (c >= 48) { if (c <= 57) { a = a * 10 + (c - 48) } }
    }
    return a
}
parse_numel(s<String>, frm<Int>, endp<Int>)<Int> -> {
    n<Int> = 1
    seg<Int> = frm
    i<Int> = frm
    for (i in frm..endp - 1) {
        if ((s.char_at(i) as Int) == 120) { n = n * parse_u(s, seg, i); seg = i + 1 }
    }
    n = n * parse_u(s, seg, endp)
    return n
}
packed_bytes(numel<Int>, ty<Int>)<Int> -> {
    if (ty == 12) { return numel * 144 / 256 }
    if (ty == 14) { return numel * 210 / 256 }
    return numel * 4
}
find_nm(nmv<Vec<String>>, nm<String>)<Int> -> {
    i<Int> = 0
    for (i in 0..nmv.len() - 1) { if (nmv.get(i) == nm) { return i } }
    return -1
}

download(data<String>, dst<Int>, nbytes<Int>)<Int> -> {
    freedom {
        # Bulk HtoD (srcHost declared CString = String's raw {ptr,len}). MUST be
        # synchronous-in-effect: the caller reuses/frees the `pd` String right
        # after download() returns, and cuMemcpyHtoDAsync_v2 on the null stream
        # with a NON-PINNED (pageable) Vyb buffer does not guarantee the DMA read
        # has finished before pd is reused -> async copies could step on each
        # other / read freed memory and corrupt weights. cuCtxSynchronize() here
        # makes the bulk copy ordered with the next tensor while keeping ONE
        # driver call per tensor (the 13min->seconds win is call count, not async).
        if (cuMemcpyHtoDAsync_v2(dst, data, nbytes, 0) != 0) { return 15 }
        cuCtxSynchronize()
        return 0
    }
    return 0
}
read_model(path<String>, off<Int>, nbytes<Int>)<String> -> {
    r<String> = ""
    match (open_read(path)) { f -> { match (read_at(f, off, nbytes)) { s -> { r = s } ? -> { r = "" } } close(f) } ? -> { r = "" } }
    return r
}
read_bin(path<String>)<String> -> {
    r<String> = ""
    match (open_read(path)) { f -> { match (read_all(f)) { s -> { r = s } ? -> { r = "" } } close(f) } ? -> { r = "" } }
    return r
}

dequant_gpu(pkb<Int>, off<Int>, dout<Int>, numel<Int>, hq<loc<CVoid>>, inz<Int>)<Int> -> {
    freedom {
        rc<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(hq)), (numel + 255) / 256, 1, 1, 256, 1, 1, pkb + off, dout, numel, inz)
        if (rc != 0) { return 33 }
        return 0
    }
    return 0
}
load_norm(path<String>, pf<Int>, dpack<Int>, dout<Int>, off<Int>, numel<Int>, he<loc<CVoid>>)<Int> -> {
    data<String> = read_model(path, off, numel * 4)
    if (data.len() < numel * 4) { return 32 }
    freedom {
        e<Int> = download(data, dpack, numel * 4)
        if (e != 0) { return e }
        cuMemcpyHtoD_v2(pf + 0, loc(dpack), 8)
        cuMemcpyHtoD_v2(pf + 8, loc(dout), 8)
        cuMemcpyHtoD_v2(pf + 16, loc(numel), 8)
        rc<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(he)), (numel + 255) / 256, 1, 1, 256, 1, 1, pf, 0, 0, 0)
        if (rc != 0) { return 33 }
        return 0
    }
    return 0
}
emb_dequant(path<String>, off<Int>, total<Int>, dpk<Int>, q6fn<loc<CVoid>>, de<Int>)<Int> -> {
    CH<Int> = 65536
    chunks<Int> = total / CH
    c<Int> = 0
    estr<Int> = 0
    for (c in 0..chunks - 1) {
        e_start<Int> = c * CH
        byte_off<Int> = e_start / 256 * 210
        nbytes<Int> = CH / 256 * 210
        data<String> = read_model(path, off + byte_off, nbytes)
        if (data.len() < nbytes) { return 61 }
        estr = 0
        freedom {
            e<Int> = download(data, dpk, nbytes)
            if (e != 0) { estr = e }
            else {
                rc<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(q6fn)), CH / 256, 1, 1, 256, 1, 1, dpk, de + e_start * 8, CH, 0)
                if (rc != 0) { estr = 33 }
            }
        }
        if (estr != 0) { return estr }
    }
    return 0
}
copy_row(de<Int>, tokenId<Int>, D<Int>, dst<Int>)<Int> -> {
    freedom {
        if (cuMemcpyDtoD_v2(dst, de + tokenId * D * 8, D * 8) != 0) { return 15 }
        return 0
    }
    return 0
}

// Parse a comma/newline-separated list of token ids (as written by
// prompt_ids.txt / llm_encode_probe) into a Vec<Int>.
parse_pids(s<String>)<Vec<Int>> -> {
    r<Vec<Int>> = Vec()
    n<Int> = s.len(); i<Int> = 0
    cur<Int> = 0; inum<Int> = 0
    for (i in 0..n - 1) {
        c<Int> = (s.char_at(i) as Int)
        if (c >= 48) {
            if (c <= 57) { cur = cur * 10 + (c - 48); inum = 1 }
        } else {
            if (inum == 1) { r.push(cur); cur = 0; inum = 0 }
        }
    }
    if (inum == 1) { r.push(cur) }
    return r
}

// The split-K gemm pair as one call (VybForge#23): pass 1 writes KSP partial slices, pass 2 reduces
// them and applies alpha/beta — i.e. exactly `C = alpha A@B + beta C`, with the K reduction done
// across slices so the grid carries KSP times as many blocks. Params buffer: pass 1 at +0..+56,
// pass 2 at +64..+112 (SK, C, M, N, alpha, beta, KSP).
// ---- launch-parameter blocks, one transfer each (VybForge#23) ----
// Every launch was preceded by 3-8 separate 8-byte cuMemcpyHtoD calls -- ~4,500 per token, the gemm
// path alone ~126 per layer -- and the host side is ~30 ms of a 98 ms token. A Vyb struct lays its
// fields out in DECLARATION order, so a struct of Int fields IS the parameter block the kernel reads:
// fill the fields (stack work, ~free) and copy the block once. Order must match the kernel offsets:
//   pass 1 (gemm32_p): A, B, SK, M, N, K, NBLK, KSP       +0..+56
//   pass 2 (gemm32_r): SK, SCR, M, N, alpha, beta, KSP    +0..+48 (alpha/beta are not read)
//   cast32 / widen32:  src, dst, n                        +0..+16
struct GP1 { a<Int>, b<Int>, sk<Int>, m<Int>, n<Int>, k<Int>, nblk<Int>, ksp<Int> }
struct GP2 { sk<Int>, scr<Int>, m<Int>, n<Int>, pad1<Int>, pad2<Int>, ksp<Int> }
struct GP3 { src<Int>, dst<Int>, n<Int> }

gemm2(gpn<loc<CVoid>>, grn<loc<CVoid>>, GPB<Int>, SKB<Int>, KSP<Int>,
      A<Int>, B<Int>, C<Int>, M<Int>, N<Int>, K<Int>, al<Float>, be<Float>)<Int> -> {
    freedom {
        NBLK<Int> = (M * N + 255) / 256
        b1<GP1> = GP1 { a = A, b = B, sk = SKB, m = M, n = N, k = K, nblk = NBLK, ksp = KSP }
        if (cuMemcpyHtoD_v2(GPB, loc(b1), 64) != 0) { return 1 }
        rc1<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(gpn)), NBLK * KSP, 1, 1, 256, 1, 1, GPB, 0, 0, 0)
        if (rc1 != 0) { println("GEMM2_P_ERR rc=" + rc1.to_string() + " grid=" + (NBLK * KSP).to_string() + " M=" + M.to_string() + " N=" + N.to_string() + " K=" + K.to_string()); return 73 }
        b2<GP2> = GP2 { sk = SKB, scr = C, m = M, n = N, pad1 = 0, pad2 = 0, ksp = KSP }
        if (cuMemcpyHtoD_v2(GPB + 64, loc(b2), 56) != 0) { return 1 }
        # pass 2 reads its params from GPB + 64, NOT from GPB: launching it with the base pointer fed it
        # pointer values as M/N and made it write through the weights buffer (illegal address 700).
        rc2<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(grn)), (M * N + 255) / 256, 1, 1, 256, 1, 1, GPB + 64, 0, 0, 0)
        if (rc2 != 0) { return 74 }
        return 0
    }
    return 0
}

// Two-pass RMSNorm as one call (VybForge#23): pass 1 writes the per-chunk sums of squares, pass 2
// sums those (NCH ~10, not D ~2560) and normalizes. Params buffers: RSPB for pass 1, RSB for pass 2.
norm2(rsnp<loc<CVoid>>, ranp<loc<CVoid>>, RSPB<Int>, RSB<Int>, SNB<Int>,
      X<Int>, W<Int>, Y<Int>, S<Int>, D<Int>, ep<Float>, CH<Int>)<Int> -> {
    freedom {
        NCH<Int> = (D + CH - 1) / CH
        cuMemcpyHtoD_v2(RSPB + 0, loc(X), 8)
        cuMemcpyHtoD_v2(RSPB + 8, loc(SNB), 8)
        cuMemcpyHtoD_v2(RSPB + 16, loc(S), 8)
        cuMemcpyHtoD_v2(RSPB + 24, loc(D), 8)
        cuMemcpyHtoD_v2(RSPB + 32, loc(CH), 8)
        rc1<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(rsnp)), (S * NCH + 255) / 256, 1, 1, 256, 1, 1, RSPB, 0, 0, 0)
        if (rc1 != 0) { println("NORM2_SS_ERR rc=" + rc1.to_string()); return 75 }
        cuMemcpyHtoD_v2(RSB + 0, loc(X), 8)
        cuMemcpyHtoD_v2(RSB + 8, loc(W), 8)
        cuMemcpyHtoD_v2(RSB + 16, loc(Y), 8)
        cuMemcpyHtoD_v2(RSB + 24, loc(SNB), 8)
        cuMemcpyHtoD_v2(RSB + 32, loc(S), 8)
        cuMemcpyHtoD_v2(RSB + 40, loc(D), 8)
        cuMemcpyHtoD_v2(RSB + 48, loc(ep), 8)
        cuMemcpyHtoD_v2(RSB + 56, loc(NCH), 8)
        rc2<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(ranp)), (S * D + 255) / 256, 1, 1, 256, 1, 1, RSB, 0, 0, 0)
        if (rc2 != 0) { println("NORM2_AP_ERR rc=" + rc2.to_string()); return 76 }
        return 0
    }
    return 0
}

// f32-path helpers (VybForge#23). cast1 writes a 24-byte param block (src, dst, n) and launches the
// elementwise cast; widen32 uses the same layout into its own block (they never overlap).
cast1(cfn<loc<CVoid>>, PB<Int>, src<Int>, dst<Int>, n<Int>)<Int> -> {
    b3<GP3> = GP3 { src = src, dst = dst, n = n }
    freedom {
        if (cuMemcpyHtoD_v2(PB, loc(b3), 24) != 0) { return 1 }
        rc<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(cfn)), (n + 255) / 256, 1, 1, 256, 1, 1, PB, 0, 0, 0)
        if (rc != 0) { println("CAST32_ERR rc=" + rc.to_string()); return 77 }
        return 0
    }
    return 0
}

// The widen as its own single launch (same shape as cast1, which is proven). The multi-launch
// gemm32run helper was REMOVED: every launch it made faulted with CUDA 700 in this driver while the
// identical launch through gemm2 ran clean, so rather than fight it the f32 path is assembled from
// the proven pieces -- gemm2 for passes 1+2, this for pass 3.
widen1(cfn<loc<CVoid>>, PB<Int>, src<Int>, dst<Int>, n<Int>)<Int> -> {
    b3<GP3> = GP3 { src = src, dst = dst, n = n }
    freedom {
        if (cuMemcpyHtoD_v2(PB, loc(b3), 24) != 0) { return 1 }
        rc<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(cfn)), (n + 255) / 256, 1, 1, 256, 1, 1, PB, 0, 0, 0)
        if (rc != 0) { println("WIDEN1_ERR rc=" + rc.to_string()); return 80 }
        return 0
    }
    return 0
}

run_layer(S<Int>, D<Int>, H<Int>, KVH<Int>, HD<Int>, FF<Int>, NQ<Int>, NKV<Int>,
          EPS<Float>, XI<Int>, XO<Int>,
          gfn<loc<CVoid>>, rfn<loc<CVoid>>, rpfn<loc<CVoid>>, afn<loc<CVoid>>, sfn<loc<CVoid>>, refn<loc<CVoid>>,
          GM<Int>, RN<Int>, ATT<Int>, ROP<Int>,
          N1<Int>, DWq32<Int>, DWk32<Int>, DWv32<Int>, Nq<Int>, Nk<Int>, DF<Int>, DWo32<Int>, N2<Int>,
          DWg32<Int>, DWu32<Int>, DWd32<Int>,
          XN32<Int>, DC32<Int>, X132<Int>, HU32<Int>, SK32<Int>, SCR32<Int>, CPB<Int>, WPB<Int>, RDB<Int>,
          c32n<loc<CVoid>>, g3p<loc<CVoid>>, g3r<loc<CVoid>>, w3n<loc<CVoid>>,
          XN<Int>, DQ<Int>, DK<Int>, DV<Int>, DQN<Int>, DKN<Int>, DQr<Int>, DKr<Int>,
          DCtx<Int>, DO<Int>, X1<Int>, X1N<Int>, Gr<Int>, Up<Int>, Hu<Int>, M<Int>,
          gpn<loc<CVoid>>, grn<loc<CVoid>>, GPB<Int>, SKB<Int>, KSP<Int>,
          rsn<loc<CVoid>>, ran<loc<CVoid>>, RSPB<Int>, RSB<Int>, SNB<Int>, CHN<Int>)<Int> -> {
    freedom {
        AF<Float> = 1.0; BF<Float> = 0.0
        zro<Int> = 0
        rA<Int> = XI; rB<Int> = N1; rC<Int> = XN
        if (norm2(rsn, ran, RSPB, RSB, SNB, XI, N1, XN, S, D, EPS, CHN) != 0) { return 75 }

        if (cast1(c32n, CPB, XN, XN32, S * D) != 0) { return 77 }
        gA<Int> = XN; gB<Int> = DWq32; gC<Int> = DQ; gM<Int> = S; gN<Int> = NQ; gK<Int> = D
        if (gemm2(g3p, g3r, GPB, SKB, KSP, XN32, DWq32, DQ, S, NQ, D, AF, BF) != 0) { return 73 }
        gA = XN; gB = DWk32; gC = DK; gM = S; gN = NKV; gK = D
        if (gemm2(g3p, g3r, GPB, SKB, KSP, XN32, DWk32, DK, S, NKV, D, AF, BF) != 0) { return 73 }
        gA = XN; gB = DWv32; gC = DV; gM = S; gN = NKV; gK = D
        if (gemm2(g3p, g3r, GPB, SKB, KSP, XN32, DWv32, DV, S, NKV, D, AF, BF) != 0) { return 73 }

        rA = DQ; rB = Nq; rC = DQN; gM = S * H; gN = HD
        cuMemcpyHtoD_v2(RN + 0, loc(rA), 8); cuMemcpyHtoD_v2(RN + 8, loc(rB), 8); cuMemcpyHtoD_v2(RN + 16, loc(rC), 8)
        println("RLR qkvok")
        cuMemcpyHtoD_v2(RN + 24, loc(gM), 8); cuMemcpyHtoD_v2(RN + 32, loc(gN), 8); cuMemcpyHtoD_v2(RN + 40, loc(EPS), 8)
        cuda_launch4i(from<loc<CVoid>>(addr(rfn)), (S * H * HD + 255) / 256, 1, 1, 256, 1, 1, RN, 0, 0, 0)
        rA = DK; rB = Nk; rC = DKN; gM = S * KVH; gN = HD
        cuMemcpyHtoD_v2(RN + 0, loc(rA), 8); cuMemcpyHtoD_v2(RN + 8, loc(rB), 8); cuMemcpyHtoD_v2(RN + 16, loc(rC), 8)
        cuMemcpyHtoD_v2(RN + 24, loc(gM), 8); cuMemcpyHtoD_v2(RN + 32, loc(gN), 8); cuMemcpyHtoD_v2(RN + 40, loc(EPS), 8)
        cuda_launch4i(from<loc<CVoid>>(addr(rfn)), (S * KVH * HD + 255) / 256, 1, 1, 256, 1, 1, RN, 0, 0, 0)

        cuMemcpyHtoD_v2(ROP + 80, loc(DQN), 8); cuMemcpyHtoD_v2(ROP + 88, loc(DKN), 8)
        cuMemcpyHtoD_v2(ROP + 96, loc(DQr), 8); cuMemcpyHtoD_v2(ROP + 104, loc(DKr), 8)
        cuMemcpyHtoD_v2(ROP + 176, loc(DF), 8); cuMemcpyHtoD_v2(ROP + 184, loc(S), 8)
        cuMemcpyHtoD_v2(ROP + 200, loc(HD), 8); cuMemcpyHtoD_v2(ROP + 208, loc(H), 8); cuMemcpyHtoD_v2(ROP + 216, loc(KVH), 8)
        cuMemcpyHtoD_v2(ROP + 224, loc(zro), 8)   # POS offset = 0 (full-sequence rope; qwen3rope +224)
        rope_total<Int> = S * H * HD + S * KVH * HD
        cuda_launch4i(from<loc<CVoid>>(addr(rpfn)), (rope_total + 255) / 256, 1, 1, 256, 1, 1, ROP, 0, 0, 0)
        println("RLR ropeok")

        cuMemcpyHtoD_v2(ATT + 80, loc(DQr), 8); cuMemcpyHtoD_v2(ATT + 88, loc(DKr), 8)
        cuMemcpyHtoD_v2(ATT + 96, loc(DV), 8); cuMemcpyHtoD_v2(ATT + 104, loc(DCtx), 8)
        cuMemcpyHtoD_v2(ATT + 184, loc(S), 8); cuMemcpyHtoD_v2(ATT + 200, loc(HD), 8)
        cuMemcpyHtoD_v2(ATT + 208, loc(H), 8); cuMemcpyHtoD_v2(ATT + 216, loc(KVH), 8)
        cuda_launch4i(from<loc<CVoid>>(addr(afn)), (S * H * HD + 255) / 256, 1, 1, 256, 1, 1, ATT, 0, 0, 0)
        println("RLR attnok")

        if (cast1(c32n, CPB, DCtx, DC32, S * NQ) != 0) { return 77 }
        gA = DCtx; gB = DWo32; gC = DO; gM = S; gN = D; gK = NQ
        if (gemm2(g3p, g3r, GPB, SKB, KSP, DC32, DWo32, DO, S, D, NQ, AF, BF) != 0) { return 73 }
        cuda_launch4i(from<loc<CVoid>>(addr(refn)), (S * D + 255) / 256, 1, 1, 256, 1, 1, XI, DO, X1, S * D)

        rA = X1; rB = N2; rC = X1N
        if (norm2(rsn, ran, RSPB, RSB, SNB, X1, N2, X1N, S, D, EPS, CHN) != 0) { return 75 }

        if (cast1(c32n, CPB, X1N, X132, S * D) != 0) { return 77 }
        gA = X1N; gB = DWg32; gC = Gr; gM = S; gN = FF; gK = D
        if (gemm2(g3p, g3r, GPB, SKB, KSP, X132, DWg32, Gr, S, FF, D, AF, BF) != 0) { return 73 }
        gA = X1N; gB = DWu32; gC = Up; gM = S; gN = FF; gK = D
        if (gemm2(g3p, g3r, GPB, SKB, KSP, X132, DWu32, Up, S, FF, D, AF, BF) != 0) { return 73 }
        cuda_launch4i(from<loc<CVoid>>(addr(sfn)), (S * FF + 255) / 256, 1, 1, 256, 1, 1, Gr, Up, Hu, S * FF)

        if (cast1(c32n, CPB, Hu, HU32, S * FF) != 0) { return 77 }
        gA = Hu; gB = DWd32; gC = M; gM = S; gN = D; gK = FF
        if (gemm2(g3p, g3r, GPB, SKB, KSP, HU32, DWd32, M, S, D, FF, AF, BF) != 0) { return 73 }
        cuda_launch4i(from<loc<CVoid>>(addr(refn)), (S * D + 255) / 256, 1, 1, 256, 1, 1, X1, M, XO, S * D)
        println("RLR endok")
        return 0
    }
    return 0
}

main()<Int> -> {
    D<Int> = 2560; H<Int> = 32; KVH<Int> = 8; HD<Int> = 128; FF<Int> = 9728
    NQ<Int> = H * HD; NKV<Int> = KVH * HD; VOCAB<Int> = 151936
    NLAYER<Int> = 36
    # ---- optional arbitrary-prompt seed (Checkpoint C): VYB_PROMPT_IDS points at
    # a comma/newline-separated ids file (prompt_ids.txt) -> SEEDLEN = that count.
    # Default (no env) preserves the [0,1] seed so decode-real stays unchanged.
    pids<Vec<Int>> = Vec()
    pf<String> = env_get("VYB_PROMPT_IDS") else ""
    if (pf.len() > 0) {
        pids = parse_pids(read_bin(pf))
        println("PROMPT_SEED_N=" + pids.len().to_string())
    } else {
        pids.push(0); pids.push(1)
    }
    SEEDLEN<Int> = pids.len()
    GEN<Int> = 6
    gn<String> = env_get("VYB_GEN") else ""
    if (gn.len() > 0) { GEN = parse_u(gn, 0, gn.len()) }
    NRUNS<Int> = 1
    rn<String> = env_get("VYB_RUNS") else ""
    if (rn.len() > 0) { NRUNS = parse_u(rn, 0, rn.len()) }
    # VYB_QUIET=1 suppresses the per-layer/per-step DECG trace. Those prints are ~150 lines per
    # token and cost real wall-clock; the machine-readable lines (RESIDENT_RUN=,
    # RESIDENT_BREAKDOWN=, RESIDENT_AVG_TOKENS_PER_SEC=) and the token-id files are untouched, so
    # verify_resident_bench.py reads the same keys either way. Default 0 = trace on, as before.
    QV<Int> = 0
    qs<String> = env_get("VYB_QUIET") else ""
    if (qs.len() > 0) { QV = 1 }
    MAXS<Int> = SEEDLEN + GEN
    EPS<Float> = 0.000001
    hm<String> = env_get("HOME") else "."
    MODEL<String> = env_get("VYBFORGE_QWEN3_GGUF") else hm + "/Models/qwen3/Qwen3-4B-Q4_K_M.gguf"
    TSV<String> = "native/out/qwen3_4b_tensors.tsv"

    nmv<Vec<String>> = Vec(); tyv<Vec<Int>> = Vec(); nlv<Vec<Int>> = Vec(); ofv<Vec<Int>> = Vec()
    bff<String> = read_bin(TSV)
    ln<Int> = bff.len(); st<Int> = 0; i<Int> = 0
    for (i in 0..ln - 1) {
        if ((bff.char_at(i) as Int) == 10) {
            t1<Int> = strchr(bff, 9, st)
            if (t1 >= st) {
                t2<Int> = strchr(bff, 9, t1 + 1)
                if (t2 < 0) { t2 = i }
                nm<String> = bff.substring(st, t1)
                keep<Int> = 0
                if (nm.substring(0, 4) == "blk.") { keep = 1 }
                if (nm == "output_norm.weight") { keep = 1 }
                if (nm == "token_embd.weight") { keep = 1 }
                if (keep == 1) {
                    t3<Int> = strchr(bff, 9, t2 + 1)
                    if (t3 < 0) { t3 = i }
                    t4<Int> = strchr(bff, 9, t3 + 1)
                    if (t4 < 0) { t4 = i }
                    nmv.push(nm); tyv.push(parse_u(bff, t2 + 1, t3)); nlv.push(parse_numel(bff, t1 + 1, t2)); ofv.push(parse_u(bff, t3 + 1, t4))
                }
            }
            st = i + 1
        }
    }
    println("TSV_ALL_TENSORS=" + nmv.len().to_string())
    if (nmv.len() < 396) { println("TSV_PARSE_FAIL"); return 2 }

    # per-kind packed bytes per layer (blk.0 shapes == all layers) + types
    K0<Int> = packed_bytes(nlv.get(find_nm(nmv, "blk.0.attn_q.weight")), tyv.get(find_nm(nmv, "blk.0.attn_q.weight")))
    K1<Int> = packed_bytes(nlv.get(find_nm(nmv, "blk.0.attn_k.weight")), tyv.get(find_nm(nmv, "blk.0.attn_k.weight")))
    K2<Int> = packed_bytes(nlv.get(find_nm(nmv, "blk.0.attn_v.weight")), tyv.get(find_nm(nmv, "blk.0.attn_v.weight")))
    K3<Int> = packed_bytes(nlv.get(find_nm(nmv, "blk.0.attn_output.weight")), tyv.get(find_nm(nmv, "blk.0.attn_output.weight")))
    K4<Int> = packed_bytes(nlv.get(find_nm(nmv, "blk.0.ffn_gate.weight")), tyv.get(find_nm(nmv, "blk.0.ffn_gate.weight")))
    K5<Int> = packed_bytes(nlv.get(find_nm(nmv, "blk.0.ffn_up.weight")), tyv.get(find_nm(nmv, "blk.0.ffn_up.weight")))
    K6<Int> = packed_bytes(nlv.get(find_nm(nmv, "blk.0.ffn_down.weight")), tyv.get(find_nm(nmv, "blk.0.ffn_down.weight")))

    freedom {
        if (cuInit(0) != 0) { println("SKIP: no CUDA"); return 0 }
        var<CInt> ndev = 0
        if (cuDeviceGetCount(loc(ndev)) != 0 || ndev < 1) { println("SKIP"); return 0 }
        var<CInt> dev = 0
        if (cuDeviceGet(loc(dev), 0) != 0) { return 14 }
        ctx<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuCtxCreate_v2(loc(ctx), 0, dev) != 0) { return 14 }
    }

    freedom {
        m4<loc<CVoid>> = from<loc<CVoid>>(0); m6<loc<CVoid>> = from<loc<CVoid>>(0); ml<loc<CVoid>> = from<loc<CVoid>>(0); mw<loc<CVoid>> = from<loc<CVoid>>(0)
        rc4<CInt> = -1; t4<Int> = 0
        for (t4 in 0..5) { if (rc4 != 0) { m4 = from<loc<CVoid>>(0); rc4 = cuModuleLoadData(loc(m4), read_bin("native/build/q4k.ptx")) } }
        if (rc4 != 0) { println("MODLOAD_FAIL q4k"); return 9 }
        rc6<CInt> = -1; t6<Int> = 0
        for (t6 in 0..5) { if (rc6 != 0) { m6 = from<loc<CVoid>>(0); rc6 = cuModuleLoadData(loc(m6), read_bin("native/build/q6k.ptx")) } }
        if (rc6 != 0) { println("MODLOAD_FAIL q6k"); return 9 }
        rcl<CInt> = -1; tl<Int> = 0
        for (tl in 0..5) { if (rcl != 0) { ml = from<loc<CVoid>>(0); rcl = cuModuleLoadData(loc(ml), read_bin("native/build/layer.ptx")) } }
        if (rcl != 0) { println("MODLOAD_FAIL layer"); return 9 }
        rcw<CInt> = -1; tw<Int> = 0
        for (tw in 0..5) { if (rcw != 0) { mw = from<loc<CVoid>>(0); rcw = cuModuleLoadData(loc(mw), read_bin("native/build/qwen3.ptx")) } }
        if (rcw != 0) { println("MODLOAD_FAIL qwen3"); return 9 }
        q4fn<loc<CVoid>> = from<loc<CVoid>>(0); q6fn<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(q4fn), m4, "q4kdeq") != 0) { return 10 }
        if (cuModuleGetFunction(loc(q6fn), m6, "q6kdeq") != 0) { return 10 }
        gfn<loc<CVoid>> = from<loc<CVoid>>(0); rfn<loc<CVoid>> = from<loc<CVoid>>(0); afn<loc<CVoid>> = from<loc<CVoid>>(0); sfn<loc<CVoid>> = from<loc<CVoid>>(0); refn<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(gfn), ml, "gemm") != 0) { return 10 }
        if (cuModuleGetFunction(loc(rfn), ml, "rmsnorm") != 0) { return 10 }
        if (cuModuleGetFunction(loc(afn), ml, "attn") != 0) { return 10 }
        if (cuModuleGetFunction(loc(sfn), ml, "silu") != 0) { return 10 }
        if (cuModuleGetFunction(loc(refn), ml, "resid") != 0) { return 10 }
        gpn<loc<CVoid>> = from<loc<CVoid>>(0); grn<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(gpn), ml, "gemm_p") != 0) { return 10 }
        if (cuModuleGetFunction(loc(grn), ml, "gemm_r") != 0) { return 10 }
        # f32 path (VybForge#23, needs Vyb#488): f32 dequant twins, one cast, and the f32
        # split-K triple -- pass 1 (f32 MACs), pass 2 (f32 reduce), pass 3 (widen to the f64 C).
        q432<loc<CVoid>> = from<loc<CVoid>>(0); q632<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(q432), m4, "q4kdeq32") != 0) { return 10 }
        if (cuModuleGetFunction(loc(q632), m6, "q6kdeq32") != 0) { return 10 }
        c32n<loc<CVoid>> = from<loc<CVoid>>(0); g3p<loc<CVoid>> = from<loc<CVoid>>(0)
        g3r<loc<CVoid>> = from<loc<CVoid>>(0); w3n<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(c32n), ml, "cast32") != 0) { return 10 }
        if (cuModuleGetFunction(loc(g3p), ml, "gemm32_p") != 0) { return 10 }
        if (cuModuleGetFunction(loc(g3r), ml, "gemm32_r") != 0) { return 10 }
        if (cuModuleGetFunction(loc(w3n), ml, "widen32") != 0) { return 10 }
        rsn<loc<CVoid>> = from<loc<CVoid>>(0); ran<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(rsn), ml, "rms_ss") != 0) { return 10 }
        if (cuModuleGetFunction(loc(ran), ml, "rms_apply") != 0) { return 10 }
        rpfn<loc<CVoid>> = from<loc<CVoid>>(0); efn<loc<CVoid>> = from<loc<CVoid>>(0); lsfn<loc<CVoid>> = from<loc<CVoid>>(0); arfn<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(rpfn), mw, "qwen3rope") != 0) { return 10 }
        if (cuModuleGetFunction(loc(efn), mw, "f32expand") != 0) { return 10 }
        if (cuModuleGetFunction(loc(lsfn), mw, "logits_slice") != 0) { return 10 }
        if (cuModuleGetFunction(loc(arfn), mw, "argmax_row") != 0) { return 10 }
        a1p<loc<CVoid>> = from<loc<CVoid>>(0); a1r<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(a1p), mw, "argmax1_p") != 0) { return 10 }
        if (cuModuleGetFunction(loc(a1r), mw, "argmax1_r") != 0) { return 10 }

        ii0<Int> = find_nm(nmv, "blk.0.attn_q.weight"); wq_nl<Int> = nlv.get(ii0)
        ii0 = find_nm(nmv, "blk.0.attn_k.weight"); wk_nl<Int> = nlv.get(ii0)
        ii0 = find_nm(nmv, "blk.0.attn_v.weight"); wv_nl<Int> = nlv.get(ii0)
        ii0 = find_nm(nmv, "blk.0.attn_output.weight"); wo_nl<Int> = nlv.get(ii0)
        ii0 = find_nm(nmv, "blk.0.ffn_gate.weight"); wg_nl<Int> = nlv.get(ii0)
        ii0 = find_nm(nmv, "blk.0.ffn_up.weight"); wu_nl<Int> = nlv.get(ii0)
        ii0 = find_nm(nmv, "blk.0.ffn_down.weight"); wd_nl<Int> = nlv.get(ii0)
        ii0 = find_nm(nmv, "token_embd.weight"); te_nl<Int> = nlv.get(ii0); te_off0<Int> = ofv.get(ii0)
        ii0 = find_nm(nmv, "output_norm.weight"); on_off<Int> = ofv.get(ii0); on_nl<Int> = nlv.get(ii0)

        # ---- the four per-layer norm kinds (VybForge#23) ----
        # Static, per-layer, and (until now) re-read from the GGUF and re-uploaded for every layer of
        # every token. Their sizes come from the file, not from hardcoded shapes, so a different model
        # cannot silently index the resident block wrong.
        ii0 = find_nm(nmv, "blk.0.attn_norm.weight"); n1n<Int> = nlv.get(ii0)
        ii0 = find_nm(nmv, "blk.0.attn_q_norm.weight"); nqn<Int> = nlv.get(ii0)
        ii0 = find_nm(nmv, "blk.0.attn_k_norm.weight"); nkn<Int> = nlv.get(ii0)
        ii0 = find_nm(nmv, "blk.0.ffn_norm.weight"); n2n<Int> = nlv.get(ii0)
        nstride<Int> = n1n + nqn + nkn + n2n

        # Qwen3-4B-Q4_K_M MIXES quantization per layer: attn_v and ffn_down are
        # Q6_K (ty 14, numel*210/256) on some layers, Q4_K (ty 12, numel*144/256)
        # on others (verified in the TSV), so their PACKED SIZE varies per layer.
        # The other 5 tensor kinds are uniformly Q4_K. Build per-layer cumulative
        # packed byte offsets + sizes for the two variable kinds.
        ov2<Vec<Int>> = Vec(); os2<Vec<Int>> = Vec()
        ov6<Vec<Int>> = Vec(); os6<Vec<Int>> = Vec()
        run2<Int> = 0; run6<Int> = 0
        Lx<Int> = 0
        for (Lx in 0..NLAYER - 1) {
            t2<Int> = tyv.get(find_nm(nmv, "blk." + Lx.to_string() + ".attn_v.weight"))
            sz2<Int> = 0
            if (t2 == 12) { sz2 = wv_nl * 144 / 256 } else { sz2 = wv_nl * 210 / 256 }
            ov2.push(run2); os2.push(sz2); run2 = run2 + sz2
            t6<Int> = tyv.get(find_nm(nmv, "blk." + Lx.to_string() + ".ffn_down.weight"))
            sz6<Int> = 0
            if (t6 == 12) { sz6 = wd_nl * 144 / 256 } else { sz6 = wd_nl * 210 / 256 }
            ov6.push(run6); os6.push(sz6); run6 = run6 + sz6
        }

        PK0<Int> = 0; PK1<Int> = 0; PK2<Int> = 0; PK3<Int> = 0; PK4<Int> = 0; PK5<Int> = 0; PK6<Int> = 0
        if (cuMemAlloc_v2(loc(PK0), K0 * NLAYER) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(PK1), K1 * NLAYER) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(PK2), run2) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(PK3), K3 * NLAYER) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(PK4), K4 * NLAYER) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(PK5), K5 * NLAYER) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(PK6), run6) != 0) { return 11 }
        Wq<Int> = 0; Wk<Int> = 0; Wv<Int> = 0; Wo<Int> = 0; Wg<Int> = 0; Wu<Int> = 0; Wd<Int> = 0
        N1<Int> = 0; Nq<Int> = 0; Nk<Int> = 0; N2<Int> = 0; ON<Int> = 0
        DE<Int> = 0; EMB<Int> = 0; HA<Int> = 0; HB<Int> = 0; DH<Int> = 0
        XN<Int> = 0; DQ<Int> = 0; DQN<Int> = 0; DQr<Int> = 0; DK<Int> = 0; DKN<Int> = 0; DKr<Int> = 0; DV<Int> = 0
        DCtx<Int> = 0; DO<Int> = 0; X1<Int> = 0; X1N<Int> = 0; Gr<Int> = 0; Up<Int> = 0; Hu<Int> = 0; M<Int> = 0
        DL<Int> = 0; AO<Int> = 0; DF<Int> = 0
        DPK<Int> = 0; GM<Int> = 0; RN<Int> = 0; ATT<Int> = 0; ROP<Int> = 0; PF<Int> = 0; LSP<Int> = 0; A4<Int> = 0
        A5<Int> = 0; A6<Int> = 0; PVA<Int> = 0; PIA<Int> = 0; CHA<Int> = 256
        NB<Int> = 0; GPB<Int> = 0; SKB<Int> = 0; KSP<Int> = 8
        RSPB<Int> = 0; RSB<Int> = 0; SNB<Int> = 0; CHN<Int> = 256
        Wq32<Int> = 0; Wk32<Int> = 0; Wv32<Int> = 0; Wo32<Int> = 0; Wg32<Int> = 0; Wu32<Int> = 0; Wd32<Int> = 0
        WqA<Int> = 0; WkA<Int> = 0; WvA<Int> = 0; WoA<Int> = 0; WgA<Int> = 0; WuA<Int> = 0; WdA<Int> = 0
        XN32<Int> = 0; DC32<Int> = 0; X132<Int> = 0; HU32<Int> = 0; SK32<Int> = 0; SCR32<Int> = 0
        CPB<Int> = 0; WPB<Int> = 0; RDB<Int> = 0
        if (cuMemAlloc_v2(loc(Wq), wq_nl * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(Wk), wk_nl * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(Wv), wv_nl * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(Wo), wo_nl * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(Wg), wg_nl * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(Wu), wu_nl * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(Wd), wd_nl * 8) != 0) { return 11 }
        # f32 path (VybForge#23): weights as f32, the four gemm A-operands as f32 copies, the f32
        # partial scratch and reduce output, and two 24-byte param blocks + a 64-byte readback block.
        if (cuMemAlloc_v2(loc(Wq32), wq_nl * 4) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(Wk32), wk_nl * 4) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(Wv32), wv_nl * 4) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(Wo32), wo_nl * 4) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(Wg32), wg_nl * 4) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(Wu32), wu_nl * 4) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(Wd32), wd_nl * 4) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(XN32), MAXS * D * 4) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DC32), MAXS * NQ * 4) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(X132), MAXS * D * 4) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(HU32), MAXS * FF * 4) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(SK32), KSP * MAXS * FF * 4) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(SCR32), MAXS * FF * 4) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(CPB), 24) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(WPB), 24) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(RDB), 64) != 0) { return 11 }
        # ALL 36 LAYERS' f32 WEIGHTS (VybForge#23): the per-token dequant was 112 ms of a 219 ms
        # token (51%) recomputing weights that never change between tokens -- it was per-token only
        # for capacity. The f64 expansion needs ~29 GB and does not fit; the f32 one is ~14.5 GB and
        # does. This deletes the per-token dequant entirely. The per-layer SHAPES are uniform, so
        # each tensor is one base pointer plus L * (numel * 4): the per-layer quant-type variation
        # (attn_v, ffn_down) changes the packed size, never the element count.
        if (cuMemAlloc_v2(loc(WqA), wq_nl * 4 * NLAYER) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(WkA), wk_nl * 4 * NLAYER) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(WvA), wv_nl * 4 * NLAYER) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(WoA), wo_nl * 4 * NLAYER) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(WgA), wg_nl * 4 * NLAYER) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(WuA), wu_nl * 4 * NLAYER) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(WdA), wd_nl * 4 * NLAYER) != 0) { return 11 }
        println("ALL_WEIGHT_BUFFERS alloc'ed: total " + ((wq_nl + wk_nl + wv_nl + wo_nl + wg_nl + wu_nl + wd_nl) * 4 * NLAYER).to_string() + " bytes")
        # The per-layer norms all live in ONE resident block (one slot per layer, four kinds each);
        # the gen loop indexes into it instead of re-loading the four tensors per layer per token.
        if (cuMemAlloc_v2(loc(NB), NLAYER * nstride * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(ON), 2560 * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DE), te_nl * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(EMB), MAXS * D * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(HA), MAXS * D * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(HB), MAXS * D * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DH), MAXS * D * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(XN), MAXS * D * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DQ), MAXS * NQ * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DQN), MAXS * NQ * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DQr), MAXS * NQ * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DK), MAXS * NKV * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DKN), MAXS * NKV * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DKr), MAXS * NKV * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DV), MAXS * NKV * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DCtx), MAXS * NQ * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DO), MAXS * D * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(X1), MAXS * D * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(X1N), MAXS * D * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(Gr), MAXS * FF * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(Up), MAXS * FF * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(Hu), MAXS * FF * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(M), MAXS * D * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DL), MAXS * VOCAB * 8) != 0) { return 11 }   # [MAXS, V] rows for per-step logits
        if (cuMemAlloc_v2(loc(AO), 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DF), 64 * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(DPK), 60000) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(GM), 64) != 0) { return 11 }
        # Split-K gemm scratch (VybForge#23): KSP slices of the largest gemm (M <= MAXS, N <= FF).
        if (cuMemAlloc_v2(loc(GPB), 128) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(SKB), KSP * MAXS * FF * 8) != 0) { return 11 }
        # Two-pass norm: params buffers + the per-chunk sum-of-squares scratch (NCH <= 64 covers D=2560).
        if (cuMemAlloc_v2(loc(RSPB), 64) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(RSB), 64) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(SNB), MAXS * 64 * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(RN), 48) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(ATT), 224) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(ROP), 232) != 0) { return 11 }   # +224 POS base for qwen3rope
        if (cuMemAlloc_v2(loc(PF), 24) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(LSP), 64) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(A4), 32) != 0) { return 11 }
        # Two-pass head argmax (VybForge#23): per-chunk partials, then a one-thread reduce.
        # NCH = ceil(VOCAB/CHA) = 594 for VOCAB 151936; 1024 slots leave headroom.
        if (cuMemAlloc_v2(loc(A5), 40) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(A6), 32) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(PVA), 1024 * 8) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(PIA), 1024 * 8) != 0) { return 11 }
        fb<String> = read_bin("native/out/layer0_invfreq.bin")
        if (fb.len() < 64 * 8) { println("INVFREQ_MISSING"); return 35 }
        download(fb, DF, 64 * 8)

        # ---- upload all 36 layers' packed weights (one-time) ----
        L<Int> = 0
        e<Int> = 0
        for (L in 0..NLAYER - 1) {
            # attn_q (uniform Q4_K)
            pd<String> = read_model(MODEL, ofv.get(find_nm(nmv, "blk." + L.to_string() + ".attn_q.weight")), K0)
            if (pd.len() < K0) { println("SHORTED pk attn_q L=" + L.to_string()); return 66 }
            freedom { e = download(pd, PK0 + K0 * L, K0) }
            if (e != 0) { return 66 }
            # attn_k (uniform Q4_K)
            pd = read_model(MODEL, ofv.get(find_nm(nmv, "blk." + L.to_string() + ".attn_k.weight")), K1)
            if (pd.len() < K1) { println("SHORTED pk attn_k L=" + L.to_string()); return 66 }
            freedom { e = download(pd, PK1 + K1 * L, K1) }
            if (e != 0) { return 66 }
            # attn_v (MIXED Q6_K/Q4_K per layer -> per-layer offset os2/ov2)
            pd = read_model(MODEL, ofv.get(find_nm(nmv, "blk." + L.to_string() + ".attn_v.weight")), os2.get(L))
            if (pd.len() < os2.get(L)) { println("SHORTED pk attn_v L=" + L.to_string()); return 66 }
            freedom { e = download(pd, PK2 + ov2.get(L), os2.get(L)) }
            if (e != 0) { return 66 }
            # attn_output (uniform Q4_K)
            pd = read_model(MODEL, ofv.get(find_nm(nmv, "blk." + L.to_string() + ".attn_output.weight")), K3)
            if (pd.len() < K3) { println("SHORTED pk attn_output L=" + L.to_string()); return 66 }
            freedom { e = download(pd, PK3 + K3 * L, K3) }
            if (e != 0) { return 66 }
            # ffn_gate (uniform Q4_K)
            pd = read_model(MODEL, ofv.get(find_nm(nmv, "blk." + L.to_string() + ".ffn_gate.weight")), K4)
            if (pd.len() < K4) { println("SHORTED pk ffn_gate L=" + L.to_string()); return 66 }
            freedom { e = download(pd, PK4 + K4 * L, K4) }
            if (e != 0) { return 66 }
            # ffn_up (uniform Q4_K)
            pd = read_model(MODEL, ofv.get(find_nm(nmv, "blk." + L.to_string() + ".ffn_up.weight")), K5)
            if (pd.len() < K5) { println("SHORTED pk ffn_up L=" + L.to_string()); return 66 }
            freedom { e = download(pd, PK5 + K5 * L, K5) }
            if (e != 0) { return 66 }
            # ffn_down (MIXED Q6_K/Q4_K per layer -> per-layer offset os6/ov6)
            pd = read_model(MODEL, ofv.get(find_nm(nmv, "blk." + L.to_string() + ".ffn_down.weight")), os6.get(L))
            if (pd.len() < os6.get(L)) { println("SHORTED pk ffn_down L=" + L.to_string()); return 66 }
            freedom { e = download(pd, PK6 + ov6.get(L), os6.get(L)) }
            if (e != 0) { return 66 }
            if (L % 6 == 0) { println("PACKED_UPLOADED layer " + L.to_string() + "/36") }
        }
        println("ALL_PACKED_RESIDENT")

        # ---- expand ALL 36 layers to f32 ONCE (VybForge#23) ----
        # The per-token dequant recomputed weights that never change between tokens. With f32 (half
        # the f64 footprint) the whole expansion fits in the card, so it happens once here and the
        # token loop does no dequantizing at all.
        for (L in 0..NLAYER - 1) {
            avtA<Int> = tyv.get(find_nm(nmv, "blk." + L.to_string() + ".attn_v.weight"))
            avqA<loc<CVoid>> = q432
            if (avtA == 14) { avqA = q632 }
            fdtA<Int> = tyv.get(find_nm(nmv, "blk." + L.to_string() + ".ffn_down.weight"))
            fdqA<loc<CVoid>> = q432
            if (fdtA == 14) { fdqA = q632 }
            e = dequant_gpu(PK0, K0 * L, WqA + L * wq_nl * 4, wq_nl, q432, D); if (e != 0) { return 70 }
            e = dequant_gpu(PK1, K1 * L, WkA + L * wk_nl * 4, wk_nl, q432, D); if (e != 0) { return 70 }
            e = dequant_gpu(PK2, ov2.get(L), WvA + L * wv_nl * 4, wv_nl, avqA, D); if (e != 0) { return 70 }
            e = dequant_gpu(PK3, K3 * L, WoA + L * wo_nl * 4, wo_nl, q432, NQ); if (e != 0) { return 70 }
            e = dequant_gpu(PK4, K4 * L, WgA + L * wg_nl * 4, wg_nl, q432, D); if (e != 0) { return 70 }
            e = dequant_gpu(PK5, K5 * L, WuA + L * wu_nl * 4, wu_nl, q432, D); if (e != 0) { return 70 }
            e = dequant_gpu(PK6, ov6.get(L), WdA + L * wd_nl * 4, wd_nl, fdqA, FF); if (e != 0) { return 70 }
            if (L % 6 == 0) { println("WEIGHTS_EXPANDED layer " + L.to_string() + "/36") }
        }
        println("ALL_WEIGHTS_EXPANDED")

        # ---- all 36 layers' norms: expand ONCE, resident (VybForge#23) ----
        # Measured before this change: the four load_norm calls in the gen loop cost 7.5% of a token
        # (norm_ms in RESIDENT_BREAKDOWN) — 144 file reads + H2D uploads + launches per token, on
        # static data. They are now done once here (1.6 MB total) and indexed by layer in the loop.
        for (L in 0..NLAYER - 1) {
            LN<Int> = NB + L * nstride * 8
            ii0 = find_nm(nmv, "blk." + L.to_string() + ".attn_norm.weight"); e = load_norm(MODEL, PF, DPK, LN, ofv.get(ii0), nlv.get(ii0), efn); if (e != 0) { return 85 }
            ii0 = find_nm(nmv, "blk." + L.to_string() + ".attn_q_norm.weight"); e = load_norm(MODEL, PF, DPK, LN + n1n * 8, ofv.get(ii0), nlv.get(ii0), efn); if (e != 0) { return 86 }
            ii0 = find_nm(nmv, "blk." + L.to_string() + ".attn_k_norm.weight"); e = load_norm(MODEL, PF, DPK, LN + (n1n + nqn) * 8, ofv.get(ii0), nlv.get(ii0), efn); if (e != 0) { return 87 }
            ii0 = find_nm(nmv, "blk." + L.to_string() + ".ffn_norm.weight"); e = load_norm(MODEL, PF, DPK, LN + (n1n + nqn + nkn) * 8, ofv.get(ii0), nlv.get(ii0), efn); if (e != 0) { return 88 }
            if (L % 6 == 0) { println("NORMS_RESIDENT layer " + L.to_string() + "/36") }
        }
        println("ALL_NORMS_RESIDENT")

        e = emb_dequant(MODEL, te_off0, te_nl, DPK, q6fn, DE); if (e != 0) { return 91 }
        println("EMB_DEQUANT_DONE")

        # NOTE: the 4 per-layer RMSNorm weights (attn_norm/attn_q_norm/attn_k_norm/
        # ffn_norm) DIFFER per layer and are loaded per-layer inside the gen loop
        # (mirroring stage_one). output_norm is the single final norm — load once.
        e = load_norm(MODEL, PF, DPK, ON, on_off, on_nl, efn); if (e != 0) { return 84 }
        println("NORMS_LOADED")

        # ---- resident interaction loop: seed + gen, repeated NRUNS times ----
        # Each run re-seeds EMB from the prompt ids and runs the same proven
        # recompute-full-prefix greedy gen loop (GEN tokens). The model weights,
        # embedding and norms stay RESIDENT on-GPU from the load above, so this
        # measures steady-state generation, not re-loading.
        # ---- per-phase wall-clock accounting (VybForge#23) ----
        # Where a token's milliseconds actually go, summed over the run: the per-layer norm loads
        # (4 file reads + H2D per layer per token), the per-layer f64 dequant, the layer forward
        # (the f64 untiled gemm), and the head (final norm + logits slices + argmax). These are
        # wall-clock deltas on the host, so they include launch and sync cost, which is the point:
        # they say how much of the 850 ms/token is GPU arithmetic and how much is the driver loop.
        nmT<Int> = 0; dqT<Int> = 0; lyT<Int> = 0; hdT<Int> = 0
        tot_ms<Int> = 0
        tot_tok<Int> = 0
        rn<Int> = 0
        for (rn in 0..NRUNS - 1) {
            t0<Int> = time_mono_millis()
            nmT = 0; dqT = 0; lyT = 0; hdT = 0

            # seed EMB with the prompt rows (or [0,1])
            si<Int> = 0
            for (si in 0..SEEDLEN - 1) {
                if (copy_row(DE, pids.get(si), D, EMB + si * D * 8) != 0) { return 15 }
            }

            # Prompt mode writes the FULL sequence (prompt ids + generated) to
            # chatgen_ids_vyb.txt (the chat-gen verifier reads it); default mode
            # keeps decode_ids_vyb.txt = [0,1,...] for the decode-real gate.
            outnm<String> = "native/out/decode_ids_vyb.txt"
            if (pf.len() > 0) { outnm = "native/out/chatgen_ids_vyb.txt" }

            match (open_write(outnm)) {
                w -> {
                    sj<Int> = 0
                    for (sj in 0..SEEDLEN - 1) {
                        match (write_str(w, pids.get(sj).to_string() + "\n")) { q -> { } ? -> { return 17 } }
                    }
                    g<Int> = 0
                    Scur<Int> = 0
                    nxt<Int> = 0
                    rA<Int> = 0; rB<Int> = 0; rC<Int> = 0
                    for (g in 0..GEN - 1) {
                        Scur = SEEDLEN + g
                        cur<Int> = EMB
                        if (QV == 0) { println("DECG step " + g.to_string() + " Scur=" + Scur.to_string()) }
                        L<Int> = 0
                        for (L in 0..NLAYER - 1) {
                            if (QV == 0) { println("DECG L" + L.to_string() + " deqstart") }
                            phA<Int> = time_mono_millis()
                            # per-layer norms are RESIDENT (expanded once at load) — index them here.
                            # No file read, no H2D, no launch: this was 7.5% of a token (norm_ms).
                            N1 = NB + L * nstride * 8
                            Nq = N1 + n1n * 8
                            Nk = Nq + nqn * 8
                            N2 = Nk + nkn * 8
                            e<Int> = 0
                            nmT = nmT + (time_mono_millis() - phA)
                            phB<Int> = time_mono_millis()
                            # No per-token dequant: every layer was expanded to f32 once at load
                            # (ALL_WEIGHTS_EXPANDED). dqT is kept so the breakdown stays comparable and
                            # now measures the residual.
                            dqT = dqT + (time_mono_millis() - phB)
                            if (QV == 0) { println("DECG deqdone L" + L.to_string()) }
                            phC<Int> = time_mono_millis()
                            tgt<Int> = HA
                            if ((L % 2) == 1) { tgt = HB }
                            e = run_layer(Scur, D, H, KVH, HD, FF, NQ, NKV, EPS, cur, tgt,
                                          gfn, rfn, rpfn, afn, sfn, refn, GM, RN, ATT, ROP,
                                          N1, WqA + L * wq_nl * 4, WkA + L * wk_nl * 4, WvA + L * wv_nl * 4,
                                          Nq, Nk, DF, WoA + L * wo_nl * 4, N2,
                                          WgA + L * wg_nl * 4, WuA + L * wu_nl * 4, WdA + L * wd_nl * 4,
                                          XN32, DC32, X132, HU32, SK32, SCR32, CPB, WPB, RDB, c32n, g3p, g3r, w3n,
                                          XN, DQ, DK, DV, DQN, DKN, DQr, DKr, DCtx, DO, X1, X1N, Gr, Up, Hu, M,
                                          gpn, grn, GPB, SKB, KSP, rsn, ran, RSPB, RSB, SNB, CHN)
                            if (e != 0) { println("RUN_LAYER_ERR L=" + L.to_string() + " code=" + e.to_string()); return 71 }
                            lyT = lyT + (time_mono_millis() - phC)
                            cur = tgt
                            if (QV == 0) { println("DECG layer " + L.to_string() + " done") }
                        }
                        if (QV == 0) { println("DECG forward done") }
                        phD<Int> = time_mono_millis()
                        rA = cur; rB = ON; rC = DH
                        cuMemcpyHtoD_v2(RN + 0, loc(rA), 8); cuMemcpyHtoD_v2(RN + 8, loc(rB), 8); cuMemcpyHtoD_v2(RN + 16, loc(rC), 8)
                        cuMemcpyHtoD_v2(RN + 24, loc(Scur), 8); cuMemcpyHtoD_v2(RN + 32, loc(D), 8); cuMemcpyHtoD_v2(RN + 40, loc(EPS), 8)
                        cuda_launch4i(from<loc<CVoid>>(addr(rfn)), (Scur * D + 255) / 256, 1, 1, 256, 1, 1, RN, 0, 0, 0)
                        LCH<Int> = 16384
                        s7<Int> = Scur - 1
                        vs2<Int> = 0
                        ve2<Int> = 0
                        rc_sl<CInt> = 0
                        while (vs2 < VOCAB) {
                            ve2 = vs2 + LCH
                            if (ve2 > VOCAB) { ve2 = VOCAB }
                            cuMemcpyHtoD_v2(LSP + 0, loc(DH), 8); cuMemcpyHtoD_v2(LSP + 8, loc(DE), 8); cuMemcpyHtoD_v2(LSP + 16, loc(DL), 8)
                            cuMemcpyHtoD_v2(LSP + 24, loc(s7), 8); cuMemcpyHtoD_v2(LSP + 32, loc(D), 8)
                            cuMemcpyHtoD_v2(LSP + 40, loc(vs2), 8); cuMemcpyHtoD_v2(LSP + 48, loc(ve2), 8); cuMemcpyHtoD_v2(LSP + 56, loc(VOCAB), 8)
                            rc_sl = cuda_launch4i(from<loc<CVoid>>(addr(lsfn)), (ve2 - vs2 + 255) / 256, 1, 1, 256, 1, 1, LSP, 0, 0, 0)
                            if (rc_sl != 0) { return 92 }
                            vs2 = ve2
                        }
                        # Two-pass argmax (VybForge#23): `argmax_row` scans VOCAB with ONE thread
                        # (14.4 ms per launch, measured); this splits the row into VOCAB/CHA chunks,
                        # one thread each, then reduces ~594 partials in a single thread.
                        nchA<Int> = (VOCAB + CHA - 1) / CHA
                        cuMemcpyHtoD_v2(A5 + 0, loc(DL + s7 * VOCAB * 8), 8); cuMemcpyHtoD_v2(A5 + 8, loc(PVA), 8)
                        cuMemcpyHtoD_v2(A5 + 16, loc(PIA), 8); cuMemcpyHtoD_v2(A5 + 24, loc(VOCAB), 8)
                        cuMemcpyHtoD_v2(A5 + 32, loc(CHA), 8)
                        rc_am<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(a1p)), (nchA + 255) / 256, 1, 1, 256, 1, 1, A5, 0, 0, 0)
                        if (rc_am != 0) { println("ARGMAX1_P_ERR rc=" + rc_am.to_string()); return 93 }
                        cuMemcpyHtoD_v2(A6 + 0, loc(PVA), 8); cuMemcpyHtoD_v2(A6 + 8, loc(PIA), 8)
                        cuMemcpyHtoD_v2(A6 + 16, loc(AO), 8); cuMemcpyHtoD_v2(A6 + 24, loc(nchA), 8)
                        rc_am = cuda_launch4i(from<loc<CVoid>>(addr(a1r)), 1, 1, 1, 256, 1, 1, A6, 0, 0, 0)
                        if (rc_am != 0) { println("ARGMAX1_R_ERR rc=" + rc_am.to_string()); return 94 }
                        cuCtxSynchronize()
                        nxt = 0
                        cuMemcpyDtoH_v2(loc(nxt), AO, 8)
                        match (write_str(w, nxt.to_string() + "\n")) { q -> { } ? -> { return 17 } }
                        copy_row(DE, nxt, D, EMB + Scur * D * 8)
                        hdT = hdT + (time_mono_millis() - phD)
                        if (QV == 0) { println("GEN step " + g.to_string() + " token=" + nxt.to_string()) }
                    }
                    close(w)
                }
                ? -> { return 17 }
            }

            t1<Int> = time_mono_millis()
            drun<Int> = t1 - t0
            tot_ms = tot_ms + drun
            tot_tok = tot_tok + GEN
            println("RESIDENT_RUN=" + rn.to_string() + " ms=" + drun.to_string() + " tokens=" + GEN.to_string())
            # The measured split (VybForge#23): sums over this run's tokens of the per-layer norm
            # loads, the per-layer f64 dequant, the layer forward and the head. Together with drun
            # they say what is left over (parse/lookup/print overhead), so a fix can be aimed.
            println("RESIDENT_BREAKDOWN norm_ms=" + nmT.to_string() + " dequant_ms=" + dqT.to_string()
                    + " layer_ms=" + lyT.to_string() + " head_ms=" + hdT.to_string()
                    + " total_ms=" + drun.to_string() + " tokens=" + GEN.to_string())
        }
        tps<Float> = (tot_tok as Float) / ((tot_ms as Float) / 1000.0)
        println("RESIDENT_RUNS=" + NRUNS.to_string() + " total_ms=" + tot_ms.to_string() + " total_tokens=" + tot_tok.to_string())
        println("RESIDENT_AVG_TOKENS_PER_SEC=" + tps.to_string())

        # ---- prompt mode: decode the generated continuation (last GEN ids) ----
        # to a fluent String via the stdlib/vllm CPU head.
        if (pf.len() > 0) {
            src<String> = read_bin("native/out/chatgen_ids_vyb.txt")
            all<Vec<Int>> = parse_pids(src)
            gids<Vec<Int>> = Vec()
            gi<Int> = SEEDLEN
            for (gi in SEEDLEN..all.len() - 1) { gids.push(all.get(gi)) }
            dir<String> = env_get("VYB_LLM_DIR") else "artifacts/vybos-configurator-lora"
            m<Model> = llm_load("qwen3", dir)
            resp<String> = llm_decode(m, gids)
            println("LLM_CHAT_GENERATED_IDS=" + gids.get(0).to_string() + "," + gids.get(gids.len() - 1).to_string())
            println("LLM_CHAT_RESPONSE=<" + resp + ">")
        }
        println("DECODE_DONE")
        return 0
    }
    return 0
}
