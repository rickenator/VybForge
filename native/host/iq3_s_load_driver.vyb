// IQ3_S dequant on REAL Qwen3.8-27B Ridge tensors (VybForge#10 phase 3).
//
// Reads the tensors named in native/out/iq3_s_ref.txt (written by native/tools/iq3_s_ref.py)
// so this driver and the reference cannot drift onto different tensors, loads the first
// SLICE_BLOCKS blocks of each straight from the GGUF, prepends the 2048-byte grid image the
// kernel expects, runs iq3sdeq on the GPU and dumps every value of the slice for the gate.
//
// SKIPs (exit 0, printing SKIP) when CUDA or the model is absent.
import env::{env_get}
import io::{open_read, read_at, read_all, close}

extern "C" {
    cuInit(flags<CUInt>)<CInt>
    cuDeviceGetCount(count<loc<CInt>>)<CInt>
    cuDeviceGet(device<loc<CInt>>, ordinal<CInt>)<CInt>
    cuCtxCreate_v2(pctx<loc<loc<CVoid>>>, flags<CUInt>, dev<CInt>)<CInt>
    cuModuleLoadData(hmod<loc<loc<CVoid>>>, image<CString>)<CInt>
    cuModuleGetFunction(hfunc<loc<loc<CVoid>>>, hmod<loc<CVoid>>, name<CString>)<CInt>
    cuMemAlloc_v2(dptr<loc<Int>>, bytesize<Int>)<CInt>
    cuMemcpyHtoD_v2(dstDevice<Int>, srcHost<loc<CVoid>>, ByteCount<Int>)<CInt>
    cuMemcpyDtoH_v2(dstHost<loc<CVoid>>, srcDevice<Int>, ByteCount<Int>)<CInt>
    cuMemFree_v2(dptr<Int>)<CInt>
    cuCtxSynchronize()<CInt>
    cuda_launch4i(f<loc<CVoid>>, gridX<CUInt>, gridY<CUInt>, gridZ<CUInt>,
                  blockX<CUInt>, blockY<CUInt>, blockZ<CUInt>,
                  a0<Int>, a1<Int>, a2<Int>, a3<Int>)<CInt>
    # Generic launcher (Vyb#476): no arity cap, no per-argument register class — the caller packs
    # an array of argument-cell addresses and cuLaunchKernel takes the one pointer.
    cuda_launch_n(f<loc<CVoid>>, gridX<CUInt>, gridY<CUInt>, gridZ<CUInt>,
                  blockX<CUInt>, blockY<CUInt>, blockZ<CUInt>,
                  kernelParams<Int>, nargs<Int>)<CInt>
}

u8(s<String>, o<Int>)<Int> -> { return (s.char_at(o) as Int) & 255 }
strchr(s<String>, nd<Int>, st<Int>)<Int> -> {
    i<Int> = st
    for (i in st..s.len() - 1) { if ((s.char_at(i) as Int) == nd) { return i } }
    return -1
}
read_bin(path<String>)<String> -> {
    r<String> = ""
    match (open_read(path)) { f -> { match (read_all(f)) { s -> { r = s } ? -> { r = "" } } close(f) } ? -> { r = "" } }
    return r
}
read_model(path<String>, off<Int>, nbytes<Int>)<String> -> {
    r<String> = ""
    match (open_read(path)) { f -> { match (read_at(f, off, nbytes)) { s -> { r = s } ? -> { r = "" } } close(f) } ? -> { r = "" } }
    return r
}
// One call per buffer: `addr(String)` is the byte buffer itself (Vyb#476), so a whole tensor or
// grid image goes up in a single cuMemcpyHtoD. This used to loop one 8-byte copy per element —
// ~3.5M calls for a full FFN tensor — which was a property of this driver's own declaration, not
// of the runtime: passing `from<loc<CVoid>>(addr(data))` is enough.
upload(data<String>, dst<Int>, nbytes<Int>)<Int> -> {
    freedom {
        if (cuMemcpyHtoD_v2(dst, from<loc<CVoid>>(addr(data)), nbytes) != 0) { return 15 }
        return 0
    }
    return 0
}
// "Q8_0 <name>@<off> -> ..." style line -> the tensor name and its absolute file offset.
struct RefLine { nm<String>, off<Int> }
parse_ref(rows<String>)<Vec<RefLine>> -> {
    out<Vec<RefLine>> = Vec()
    ln<Int> = rows.len(); st<Int> = 0; i<Int> = 0
    for (i in 0..ln - 1) {
        if ((rows.char_at(i) as Int) == 10) {
            line<String> = rows.substring(st, i)
            if (line.substring(0, 5) == "IQ3_S") {
                atp<Int> = strchr(line, 64, 0)         # '@'
                arrow<Int> = strchr(line, 45, 0)       # '-'
                if (atp > 0) {
                    if (arrow > atp) {
                        nm<String> = line.substring(6, atp)
                        os<Int> = 0
                        dg<Int> = atp + 1
                        while (dg < arrow) {
                            c<Int> = line.char_at(dg) as Int
                            if (c >= 48) { if (c <= 57) { os = os * 10 + (c - 48) } }
                            dg = dg + 1
                        }
                        out.push(RefLine { nm = nm, off = os })
                    }
                }
            }
            st = i + 1
        }
    }
    return out
}
// Every value of the slice, not a sample: with one-call uploads (Vyb#476) the whole slice is
// cheap to read back, and a mistake in any sub-group would otherwise hide behind six good
// numbers. The reference writes the same full list, so the gate compares all 4096 elements.
dump_all(base<Int>, tag<String>, count<Int>)<Int> -> {
    freedom {
        iv<Int> = 0; acc<String> = ""; rj<Int> = 0
        for (rj in 0..count - 1) {
            iv = 0
            cuMemcpyDtoH_v2(loc(iv), base + rj * 8, 8)
            acc = acc + iv.to_string() + " "
        }
        println("IQ3_S " + tag + " -> " + acc)
    }
    return 0
}

main()<Int> -> {
    SLICE<Int> = 16                 # must match SLICE_BLOCKS in native/tools/iq3_s_ref.py
    BB<Int> = 110
    hm<String> = env_get("HOME") else "."
    MODEL<String> = env_get("VYBFORGE_RIDGE_GGUF") else hm + "/Models/qwen38-27b-ridge/Qwen3.8-27B-Ridge-3.7bpw.gguf"
    refs<Vec<RefLine>> = parse_ref(read_bin("native/out/iq3_s_ref.txt"))
    if (refs.len() == 0) { println("IQ3_S_FAIL no reference lines (run native/tools/iq3_s_ref.py)"); return 4 }
    grid<String> = read_bin("native/out/iq3s_grid.bin")
    if (grid.len() != 2048) { println("IQ3_S_FAIL grid image is " + grid.len().to_string() + " bytes, want 2048"); return 5 }
    println("IQ3_S_REFS=" + refs.len().to_string())

    freedom {
        if (cuInit(0) != 0) { println("SKIP"); return 0 }
        var<CInt> ndev = 0
        if (cuDeviceGetCount(loc(ndev)) != 0 || ndev < 1) { println("SKIP"); return 0 }
        var<CInt> dev = 0; if (cuDeviceGet(loc(dev), 0) != 0) { return 14 }
        ctx<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuCtxCreate_v2(loc(ctx), 0, dev) != 0) { return 14 }
    }
    freedom {
        m8<loc<CVoid>> = from<loc<CVoid>>(0)
        rc8<CInt> = -1; t8<Int> = 0
        for (t8 in 0..5) { if (rc8 != 0) { m8 = from<loc<CVoid>>(0); rc8 = cuModuleLoadData(loc(m8), read_bin("native/build/iq3s.ptx")) } }
        if (rc8 != 0) { println("MODLOAD_FAIL iq3s"); return 9 }
        fn8<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(fn8), m8, "iq3sdeq") != 0) { return 10 }

        # Device buffers: the grid once, the weight bytes per tensor. With addr(String) these go
        # up in ONE call each (Vyb#476) — no per-element loop.
        GD<Int> = 0; PK<Int> = 0; WA<Int> = 0
        if (cuMemAlloc_v2(loc(GD), 2048) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(PK), SLICE * BB) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(WA), SLICE * 256 * 8) != 0) { return 11 }
        e0<Int> = upload(grid, GD, 2048)
        if (e0 != 0) { return 66 }
        # The kernel's five arguments live in these cells and params[] holds their addresses; the
        # values are read at launch, so the cells are assigned as work proceeds and params is
        # built once, before the loop.
        nl<Int> = SLICE * 256
        zz<Int> = 0
        params<[Int; 5]> = [0, 0, 0, 0, 0]
        params[0] = addr(GD)
        params[1] = addr(PK)
        params[2] = addr(WA)
        params[3] = addr(nl)
        params[4] = addr(zz)

        ri<Int> = 0
        for (ri in 0..refs.len() - 1) {
            nm<String> = refs.get(ri).nm
            pd<String> = read_model(MODEL, refs.get(ri).off, SLICE * BB)
            if (pd.len() < SLICE * BB) { println("IQ3_S_SKIP_MODEL short read " + nm); return 0 }
            ee<Int> = upload(pd, PK, SLICE * BB)
            if (ee != 0) { return 66 }
            rc<CInt> = cuda_launch_n(from<loc<CVoid>>(addr(fn8)), (nl + 255) / 256, 1, 1, 256, 1, 1, addr(params), 5)
            if (rc != 0) { println("LAUNCH_FAIL"); return 33 }
            cuCtxSynchronize()
            dump_all(WA, nm, nl)
        }
        cuMemFree_v2(GD); cuMemFree_v2(PK); cuMemFree_v2(WA)
        println("IQ3_S_DRIVER_DONE")
        return 0
    }
    return 0
}
