// chat_server.vyb — Vyb-native chat endpoint on localhost:8888 (untuned slice).
//
// Pure-Vyb HTTP server. Per request it:
//   1. extracts the prompt (GET /chat?q=... or POST prompt=...),
//   2. CPU-encodes it via the stdlib/vllm Model facade,
//   3. exec's the pristine decode_driver (recompute-full-prefix greedy gen) with
//      the ids + gen count as env, then
//   4. decodes the generated continuation to text and replies.
//
// The GPU decode stays a separate process (it loads the 2.5GB GGUF + streams
// weights) — this server just orchestrates it, so NO verified decode code is
// refactored. Tuned (LoRA) wiring deferred (next slice).
//
// Honest cost: each request fully re-runs decode (model load + gen) ~minutes,
// single-client, GPU-bound. Correctness proof first; tuning + a resident model
// + KV-cache reuse come after.
//
// Run:
//   VYB_STDLIB=$VYB_STDLIB build/vyb native/host/chat_server.vyb --module-path native/llm
//   curl 'http://localhost:8888/chat?q=The%20capital%20of%20France%20is'
//   curl -d 'prompt=hello' http://localhost:8888/chat

import http::{http_listen, http_local_port, http_accept, http_read_head,
              http_request_path, http_send_all, http_close, http_response,
              http_read_rest}
import network::{TcpListener, TcpStream, TcpListenerOps, TcpStreamOps}
import io::{open_read, read_all, open_write, write_str, close}
import process::{exec_run}
import llm::{llm_load, llm_encode, llm_decode}
import vllm::{Model}
import env::{env_get}
import threads::{thread_spawn, thread_detach}

PORT<Int> = 8888
GEN<Int> = 3
MODELDRV<String> = "native/host/decode_driver.vyb"
LLMDIR<String> = "native/llm"
PROMPT_IDS<String> = "native/out/prompt_ids.txt"
CHATGEN_OUT<String> = "native/out/chatgen_ids_vyb.txt"
VYB_BIN<String> = "/home/rick/Projects/Vyb/build/vyb"
VYB_STDLIB<String> = "/home/rick/Projects/Vyb/stdlib"

hexch(c<Int>)<Int> -> {
    if (c >= 48 && c <= 57) { return c - 48 }
    if (c >= 97 && c <= 102) { return c - 97 + 10 }
    if (c >= 65 && c <= 70) { return c - 65 + 10 }
    return 0
}

urldecode(s<String>)<String> -> {
    out<String> = ""
    i<Int> = 0
    n<Int> = s.len()
    while (i < n) {
        c<Int> = s.char_at(i)
        if (c == 43) { out = out + " " }
        else if (c == 37 && i + 2 < n) {
            h1<Int> = hexch(s.char_at(i + 1)); h2<Int> = hexch(s.char_at(i + 2))
            out = out + String::from_byte(h1 * 16 + h2)
            i = i + 2
        } else { out = out + String::from_byte(c) }
        i = i + 1
    }
    return out
}

extract_prompt(s<String>)<String> -> {
    qa<Int> = s.index_of("q=")
    pa<Int> = s.index_of("prompt=")
    estart<Int> = qa
    if (pa >= 0 && (qa < 0 || pa < estart)) { estart = pa }
    if (estart < 0) { return "" }
    v<String> = ""
    if (estart == qa) { v = s.substring(qa + 2) }
    else { v = s.substring(pa + 7) }
    sp2<Int> = v.index_of(" ")
    am2<Int> = v.index_of("&")
    cut<Int> = sp2
    if (am2 >= 0 && (cut < 0 || am2 < cut)) { cut = am2 }
    if (cut >= 0) { v = v.substring(0, cut) }
    return urldecode(v.trim())
}

read_file(path<String>)<String> -> {
    match (open_read(path)) {
        f -> {
            match (read_all(f)) { s -> { close(f); return s } ? -> { close(f); return "" } }
        }
        ? -> { return "" }
    }
    return ""
}

write_prompt_ids(m<Model>, prompt<String>)<Int> -> {
    ids<Vec<Int>> = llm_encode(m, prompt)
    match (open_write(PROMPT_IDS)) {
        w -> {
            i<Int> = 0
            for (i in 0..ids.len() - 1) {
                if (i > 0) { match (write_str(w, ",")) { q -> { } ? -> { } } }
                match (write_str(w, ids.get(i).to_string())) { q -> { } ? -> { } }
            }
            close(w)
        }
        ? -> { }
    }
    return ids.len()
}

read_ids()<Vec<Int>> -> {
    v<Vec<Int>> = Vec()
    body<String> = read_file(CHATGEN_OUT)
    if (body.len() == 0) { return v }
    cur<Int> = 0; inum<Int> = 0
    n<Int> = body.len(); i<Int> = 0
    for (i in 0..n - 1) {
        c<Int> = (body.char_at(i) as Int)
        if (c >= 48 && c <= 57) { cur = cur * 10 + (c - 48); inum = 1 }
        else if (inum == 1) { v.push(cur); cur = 0; inum = 0 }
    }
    if (inum == 1) { v.push(cur) }
    return v
}

// run the untuned decode driver; returns its exit status (-1 on launch fail).
free_exec(cmd<String>)<Int> -> {
    freedom { return exec_run(cmd) else -1 }
    return -1
}

untuned_response(prompt<String>)<String> -> {
    tdir<String> = env_get("VYB_LLM_DIR") else "artifacts/vybos-configurator-lora"
    m<Model> = llm_load("qwen3", tdir)
    nids<Int> = write_prompt_ids(m, prompt)
    if (nids == 0) { return "ERR: prompt encoded to 0 tokens" }
    cmd<String> = "VYB_STDLIB=" + VYB_STDLIB + " VYB_PROMPT_IDS=" + PROMPT_IDS +
                  " VYB_GEN=" + GEN.to_string() + " " + VYB_BIN + " " + MODELDRV +
                  " --module-path " + LLMDIR + " >/dev/null 2>&1"
    rc<Int> = free_exec(cmd)
    if (rc != 0) { return "ERR: decode_driver exit " + rc.to_string() }
    all<Vec<Int>> = read_ids()
    if (all.len() <= nids) { return "ERR: no continuation (got " + all.len().to_string() + " ids, prompt " + nids.to_string() + ")" }
    resp<Vec<Int>> = Vec()
    j<Int> = nids
    for (j in nids..all.len() - 1) { resp.push(all.get(j)) }
    return llm_decode(m, resp)
}

serve_chat(fd<Int>)<Int> -> {
    head<String> = http_read_head(fd, 65536)
    path<String> = http_request_path(head)
    prompt<String> = extract_prompt(path)
    # Only read a body if the request advertises one (POST / Content-Length),
    # otherwise http_read_rest on a keep-alive GET would block forever.
    if (prompt.len() == 0 && (head.starts_with("POST") || head.index_of("Content-Length:") >= 0)) {
        body<String> = http_read_rest(fd, 65536)
        prompt = extract_prompt(body)
    }
    status<Int> = 200
    body_out<String> = ""
    if (prompt.len() == 0) {
        status = 400
        body_out = "usage: GET /chat?q=<prompt> or POST 'prompt=<prompt>'\n"
    } else {
        body_out = "prompt=[" + prompt + "]\ntokens=" + (llm_encode(llm_load("qwen3", env_get("VYB_LLM_DIR") else "artifacts/vybos-configurator-lora"), prompt).len()).to_string() + "\n" + untuned_response(prompt) + "\n"
    }
    pk<String> = http_response(status, body_out)
    http_send_all(fd, pk)
    http_close(fd)
    return 0
}

main()<Int> -> {
    match (http_listen(PORT, 4)) {
        srv -> {
            port<Int> = srv.local_port()
            println("VYB_CHAT up on localhost:" + port.to_string() + " (untuned; tuned deferred)")
            while (true) {
                match (http_accept(srv)) {
                    conn -> {
                        h<Int?> = thread_spawn(|| -> { serve_chat(conn.fd) })
                        match (h) { t -> { thread_detach(t) } ? -> { } }
                    }
                    ? -> { return 0 }
                }
            }
            return 0
        }
        ? -> { println("VYB_CHAT listen failed on " + PORT.to_string()); return 1 }
    }
    return 0
}
