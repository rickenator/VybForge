// p6_rank_probe — P6 increment 1: expert-partition across two nodes.
// Each rank gx_resolves + deqs ITS expert's 9 tensors at layer 3 (EXL3 chain,
// f32 path), computes that expert's FFN output for a deterministic x, then the
// exchange: rank 1 sends its H-vector (32 KB) to rank 0; rank 0 recomputes the
// peer expert LOCALLY and compares bit-wise (the gate), and prints the routed
// partial sum. Single-rank mode (P6_RANK unset or "solo") skips the exchange
// and just prints the y digest.
// env: P6_RANK=0|1|solo  P6_PEER=<rank1's ip>  P6_DIR=<checkpoint snapshots dir>
//      P6_EXP=<my expert>  P6_PEEREXP=<peer expert>  P6_PORT=9150
import io::{open_read, read_all, close}
import env::{env_get}
import time::{time_mono_millis}
import network::{socket_open, socket_close, socket_bind, socket_listen, socket_accept, socket_connect, socket_send_bytes, socket_recv_bytes, socket_set_timeout}
import tensor::{tensor_init, dev_alloc, bulk_dtoh, sync}
import gx::{gx_resolve, gx_read}
import glm_engine::{load_fn, had_hoist32, mapdev_build, exl3_deq32f, mm_host32, silu}


main()<Int> -> {
    rank<String> = env_get("P6_RANK") else "solo"
    peer<String> = env_get("P6_PEER") else "192.168.192.2"
    dir<String> = env_get("P6_DIR") else "/srv/models/hf/hub/models--Mia-AiLab--GLM-5.3-Flash-EXL3-4bpw-TensorFold/snapshots/078455ffe6472f9a52fbc1139f58b9db2881b25c"
    expS<String> = env_get("P6_EXP") else "0"
    pexS<String> = env_get("P6_PEEREXP") else "1"
    exp<Int> = 0
    pex<Int> = 0
    i<Int> = 0
    while (i < expS.len()) {
        c<Int> = (expS.char_at(i) as Int) & 255
        if (c >= 48 && c <= 57) { exp = exp * 10 + (c - 48) }
        i = i + 1
    }
    i = 0
    while (i < pexS.len()) {
        c<Int> = (pexS.char_at(i) as Int) & 255
        if (c >= 48 && c <= 57) { pex = pex * 10 + (c - 48) }
        i = i + 1
    }
    port<Int> = 9150
    println("P6 mode=" + rank + " exp=" + exp.to_string() + " peerexp=" + pex.to_string())
    if (tensor_init() != 0) { println("P6_FAIL cuda"); return 1 }
    // kernels
    fdqs4 = load_fn("native/build/exl3dq.ptx", "exl3dq1s4")
    fhad232 = load_fn("native/build/exl3.ptx", "exl3had232")
    fhgen32 = load_fn("native/build/exl3.ptx", "exl3hgen32")
    finvk = load_fn("native/build/exl3.ptx", "exl3inv")
    fcast32 = load_fn("native/build/layer.ptx", "cast32")
    fgp = load_fn("native/build/layer.ptx", "gemm32_p")
    fgr = load_fn("native/build/layer.ptx", "gemm32_r")
    if (fdqs4 == 0 || fhad232 == 0 || fhgen32 == 0 || finvk == 0 || fcast32 == 0 || fgp == 0 || fgr == 0) {
        println("P6_FAIL kernels")
        return 2
    }
    hd_pre32<Int> = had_hoist32(fhgen32)
    if (hd_pre32 == 0) { println("P6_FAIL hadhoist"); return 3 }
    // the exl3 map: mapd from disk, mapdev + inverse built in the engine
    mapd<String> = ""
    match (open_read("native/exl3/map.bin")) {
        f -> { match (read_all(f)) { s -> { mapd = s } ? -> { return 4 } } close(f) }
        ? -> { println("P6_FAIL map.bin"); return 4 }
    }
    mapbody<String> = mapd.substring(16, mapd.len())
    nbmap<Int> = mapd.len() - 16
    mapdev<Int> = mapdev_build(finvk, mapd)
    if (mapdev == 0) { println("P6_FAIL mapdev"); return 5 }
    invbase<Int> = mapdev + 16 + nbmap
    // arenas exactly as the serve
    arA<Int> = dev_alloc(8388608)
    arB<Int> = dev_alloc(65536)
    arC<Int> = dev_alloc(33554432)
    arD<Int> = dev_alloc(33554432)
    arG<Int> = dev_alloc(16384)
    arH<Int> = dev_alloc(16384)
    arI<Int> = dev_alloc(64)
    pb32<Int> = dev_alloc(192)
    if (arA == 0 || arB == 0 || arC == 0 || arD == 0 || arG == 0 || arH == 0 || arI == 0 || pb32 == 0) {
        println("P6_FAIL arena")
        return 6
    }
    // resolve MY expert's 9 tensors at layer 3
    w2<Vec<String>> = Vec()
    epre<String> = "model.language_model.layers.3.mlp.experts." + exp.to_string() + "."
    w2.push(epre + "gate_proj.trellis")
    w2.push(epre + "gate_proj.suh")
    w2.push(epre + "gate_proj.svh")
    w2.push(epre + "up_proj.trellis")
    w2.push(epre + "up_proj.suh")
    w2.push(epre + "up_proj.svh")
    w2.push(epre + "down_proj.trellis")
    w2.push(epre + "down_proj.suh")
    w2.push(epre + "down_proj.svh")
    t0<Int> = time_mono_millis()
    ge<GxLoc> = gx_resolve(dir, 83, w2)
    nf<Int> = 0
    j<Int> = 0
    while (j < ge.found.len()) {
        if (ge.found.get(j) == 1) { nf = nf + 1 }
        j = j + 1
    }
    println("P6 resolved=" + nf.to_string() + " of 9 in " + (time_mono_millis() - t0).to_string() + "ms")
    if (nf != 9) { println("P6_FAIL resolve"); return 7 }
    g0<String> = gx_read(ge, 0)
    g1<String> = gx_read(ge, 1)
    g2<String> = gx_read(ge, 2)
    g3<String> = gx_read(ge, 3)
    g4<String> = gx_read(ge, 4)
    g5<String> = gx_read(ge, 5)
    g6<String> = gx_read(ge, 6)
    g7<String> = gx_read(ge, 7)
    g8<String> = gx_read(ge, 8)
    println("P6 read bytes: " + g0.len().to_string() + " " + g1.len().to_string() + " " + g6.len().to_string())
    dWg<Int> = exl3_deq32f(0, 0, fdqs4, 0, fhad232, g0, g1, g2, mapbody, 2048, 32768, hd_pre32,
                           arA, arB, arC, arD, arG, arH, arI, mapdev, invbase)
    dWu<Int> = exl3_deq32f(0, 0, fdqs4, 0, fhad232, g3, g4, g5, mapbody, 2048, 32768, hd_pre32,
                           arA, arB, arC, arD, arG, arH, arI, mapdev, invbase)
    dWd<Int> = exl3_deq32f(0, 0, fdqs4, 0, fhad232, g6, g7, g8, mapbody, 4096, 32768, hd_pre32,
                           arA, arB, arC, arD, arG, arH, arI, mapdev, invbase)
    if (dWg == 0 || dWu == 0 || dWd == 0) { println("P6_FAIL deq"); return 8 }
    println("P6 deq ok")
    // deterministic x: 4096 f64 values in [-0.5, 0.5)
    x<Vec<Float>> = Vec()
    i = 0
    while (i < 4096) {
        x.push((((i * 37) % 251) as Float - 125.0) / 250.0)
        i = i + 1
    }
    t0 = time_mono_millis()
    gv<Vec<Float>> = mm_host32(x, 1, 4096, dWg, 2048, fcast32, fgp, fgr, pb32)
    uv<Vec<Float>> = mm_host32(x, 1, 4096, dWu, 2048, fcast32, fgp, fgr, pb32)
    act<Vec<Float>> = Vec()
    i = 0
    while (i < gv.len()) {
        act.push(silu(gv.get(i)) * uv.get(i))
        i = i + 1
    }
    y<Vec<Float>> = mm_host32(act, 1, 2048, dWd, 4096, fcast32, fgp, fgr, pb32)
    println("P6 ffn ms=" + (time_mono_millis() - t0).to_string() + " ylen=" + y.len().to_string())
    if (y.len() != 4096) { println("P6_FAIL ylen"); return 9 }
    // my digest
    dg<Float> = 0.0
    i = 0
    while (i < y.len()) {
        dg = dg + y.get(i) * ((i % 7) as Float + 1.0)
        i = i + 1
    }
    println("P6_Y_DIGEST exp=" + exp.to_string() + " " + dg.to_string())
    if (rank == "solo") {
        println("P6_SOLO_OK")
        return 0
    }
    // ---- exchange (increment 1: full-precision digest compare) ----
    // rank 1 sends its y digest as text; rank 0 recomputes the peer expert
    // locally, compares digests (rel <= 1e-12) and prints the routed partial sum.
    if (rank == "0") {
        fd<Int> = socket_open(2, 1, 0) else 0
        if (fd == 0) { println("P6_FAIL open"); return 10 }
        bnd<Bool> = socket_bind(fd, "0.0.0.0", port) else false
        if (!bnd) { println("P6_FAIL bind"); return 11 }
        ls<Bool> = socket_listen(fd, 1) else false
        if (!ls) { return 12 }
        println("P6_LISTENING")
        cf<Int> = socket_accept(fd) else 0
        if (cf == 0) { println("P6_FAIL accept"); return 13 }
        socket_set_timeout(cf, 120000)
        rxs<Vec<UInt8>> = socket_recv_bytes(cf, 256) else Vec<UInt8>()
        ptxt<String> = ""
        i = 0
        while (i < rxs.len()) { ptxt = ptxt + String_char(rxs.get(i) as Int) ; i = i + 1 }
        println("P6 peer says: " + ptxt)
        pdig<Float> = ptxt.to_float()
        println("P6 peer digest parsed=" + pdig.to_string())
        // recompute the PEER expert locally
        epre2<String> = "model.language_model.layers.3.mlp.experts." + pex.to_string() + "."
        w3<Vec<String>> = Vec()
        w3.push(epre2 + "gate_proj.trellis")
        w3.push(epre2 + "gate_proj.suh")
        w3.push(epre2 + "gate_proj.svh")
        w3.push(epre2 + "up_proj.trellis")
        w3.push(epre2 + "up_proj.suh")
        w3.push(epre2 + "up_proj.svh")
        w3.push(epre2 + "down_proj.trellis")
        w3.push(epre2 + "down_proj.suh")
        w3.push(epre2 + "down_proj.svh")
        ge2<GxLoc> = gx_resolve(dir, 83, w3)
        h0<String> = gx_read(ge2, 0)
        h1<String> = gx_read(ge2, 1)
        h2<String> = gx_read(ge2, 2)
        h3<String> = gx_read(ge2, 3)
        h4<String> = gx_read(ge2, 4)
        h5<String> = gx_read(ge2, 5)
        h6<String> = gx_read(ge2, 6)
        h7<String> = gx_read(ge2, 7)
        h8<String> = gx_read(ge2, 8)
        eWg<Int> = exl3_deq32f(0, 0, fdqs4, 0, fhad232, h0, h1, h2, mapbody, 2048, 32768, hd_pre32,
                               arA, arB, arC, arD, arG, arH, arI, mapdev, invbase)
        eWu<Int> = exl3_deq32f(0, 0, fdqs4, 0, fhad232, h3, h4, h5, mapbody, 2048, 32768, hd_pre32,
                               arA, arB, arC, arD, arG, arH, arI, mapdev, invbase)
        eWd<Int> = exl3_deq32f(0, 0, fdqs4, 0, fhad232, h6, h7, h8, mapbody, 4096, 32768, hd_pre32,
                               arA, arB, arC, arD, arG, arH, arI, mapdev, invbase)
        if (eWg == 0 || eWu == 0 || eWd == 0) { println("P6_FAIL peerdeq"); return 15 }
        egv<Vec<Float>> = mm_host32(x, 1, 4096, eWg, 2048, fcast32, fgp, fgr, pb32)
        euv<Vec<Float>> = mm_host32(x, 1, 4096, eWu, 2048, fcast32, fgp, fgr, pb32)
        eact<Vec<Float>> = Vec()
        i = 0
        while (i < egv.len()) {
            eact.push(silu(egv.get(i)) * euv.get(i))
            i = i + 1
        }
        ey<Vec<Float>> = mm_host32(eact, 1, 2048, eWd, 4096, fcast32, fgp, fgr, pb32)
        edg<Float> = 0.0
        i = 0
        while (i < ey.len()) {
            edg = edg + ey.get(i) * ((i % 7) as Float + 1.0)
            i = i + 1
        }
        println("P6 local peer digest=" + edg.to_string())
        df<Float> = pdig - edg
        if (df < 0.0) { df = 0.0 - df }
        den<Float> = edg
        if (den < 0.0) { den = 0.0 - den }
        if (den < 1e-30) { den = 1.0 }
        rel<Float> = df / den
        println("P6_GATE rel=" + rel.to_string() + " (tol 1e-6; the digest crosses as TEXT ~7 sig figs — a byte-exact vector exchange is increment 2)")
        s<Float> = 0.0
        i = 0
        while (i < 4096) {
            s = s + (y.get(i) + ey.get(i)) * ((i % 7) as Float + 1.0)
            i = i + 1
        }
        println("P6_SUM_DIGEST=" + s.to_string())
        okv<Vec<UInt8>> = okbytes()
        socket_send_bytes(cf, borrow(okv)) else 0
        socket_close(cf)
        socket_close(fd)
        if (rel <= 1e-6) { println("P6_RANK0_DONE GATE_OK") } else { println("P6_RANK0_DONE GATE_FAIL") }
        return 0
    }
    // rank 1: connect, send the digest text
    fd<Int> = socket_open(2, 1, 0) else 0
    if (fd == 0) { return 16 }
    cn<Bool> = socket_connect(fd, peer, port) else false
    if (!cn) { println("P6_FAIL connect"); return 17 }
    socket_set_timeout(fd, 120000)
    msg<String> = dg.to_string()
    mb<Vec<UInt8>> = Vec()
    i = 0
    while (i < msg.len()) {
        mb.push((msg.char_at(i) as Int) as UInt8)
        i = i + 1
    }
    sent<Int> = socket_send_bytes(fd, borrow(mb)) else 0
    println("P6 sent digest bytes=" + sent.to_string())
    ack<Vec<UInt8>> = socket_recv_bytes(fd, 2) else Vec<UInt8>()
    println("P6 ack=" + ack.len().to_string())
    socket_close(fd)
    println("P6_RANK1_DONE")
    return 0
}

okbytes()<Vec<UInt8>> -> {
    v<Vec<UInt8>> = Vec()
    v.push(79)
    v.push(75)
    return v
}

String_char(c<Int>)<String> -> {
    // one-byte string from a byte value
    s<String> = ""
    if (c == 45) { return "-" }
    if (c == 46) { return "." }
    if (c == 101) { return "e" }
    if (c == 43) { return "+" }
    if (c >= 48 && c <= 57) {
        d<Int> = c - 48
        s = "0123456789".substring(d, d + 1)
    }
    return s
}
