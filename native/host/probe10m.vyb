# probe10m: does the phase-1-like allocation churn make the dump loop slow?
import io::{open_append, write_str, close}

SCALE40<Float> = 1099511627776.0

di(v<Float>)<Int> -> {
    return (v * SCALE40) as Int
}

main()<Int> -> {
    v<Vec<Float>> = Vec()
    i<Int> = 0
    while (i < 327680) { v.push((i % 97) * 0.13 - 6.0); i = i + 1 }
    println("built")
    # churn: 45 rounds of 12 transient 12MB strings + a growing accumulator
    acc<String> = ""
    r<Int> = 0
    while (r < 45) {
        j<Int> = 0
        while (j < 10) {
            big<String> = ""
            k<Int> = 0
            while (k < 1500000) { big = big + "x"; k = k + 1 }
            j = j + 1
        }
        acc = acc + "padding-padding-padding-padding-padding-padding-padding-padding"
        r = r + 1
    }
    println("churned; acc=" + acc.len().to_string())
    match (open_append("/tmp/probe10m.txt")) {
        f -> {
            i = 0
            chunk<String> = ""
            while (i < v.len()) {
                chunk = chunk + " " + di(v.get(i)).to_string()
                if (chunk.len() > 2048) { write_str(f, chunk); chunk = "" }
                i = i + 1
            }
            write_str(f, chunk)
            close(f)
        }
        ? -> { println("fail") }
    }
    println("dumped")
    return 0
}
