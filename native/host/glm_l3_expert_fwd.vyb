# glm_l3_expert_fwd.vyb — one token's routed-expert contribution, in Vyb.
#
# The last piece of layer 3's ffn site: for a token, take its top-8 experts (already gated
# by L3_MOE_ROUTE_VYB), dequantize each expert's gate/up/down from EXL3 on the device,
# run the clamped SwiGLU expert FFN, and accumulate weight * output. Compared against the
# gold's routed-only sum for that token.
#
# Expert ids and their renormed weights come in as env strings (from gold_l3_moe.json) so
# this gate measures the expert path itself; routing is gated separately.
#
#   VYBFORGE_EXPERT_IDS="202,149,10,205,285,20,97,252"
#   VYBFORGE_EXPERT_W="+925305+858024..."  (scaled integers, /2^40)
#
# Run: make -f native/Makefile glm3exp
import io::{open_read, read_at, read_all, open_write, write_str, close}
import env::{env_get}
import safetensors
import gx
import tensor::{tensor_init, dev_alloc, htod_vec, dtoh_vec, sync, gemm}
import vmath::{vexp, vsqrt}

extern "C" {
    cuMemFree_v2(dptr<Int>)<CInt>
    cuMemAlloc_v2(dptr<loc<Int>>, bytesize<Int>)<CInt>
    cuMemcpyHtoD_v2(dstDevice<Int>, srcHost<loc<CVoid>>, ByteCount<Int>)<CInt>
    cuCtxSynchronize()<CInt>
    cuModuleLoadData(hmod<loc<loc<CVoid>>>, image<CString>)<CInt>
    cuModuleGetFunction(hfunc<loc<loc<CVoid>>>, hmod<loc<CVoid>>, name<CString>)<CInt>
    cuda_launch4i(f<loc<CVoid>>, gridX<CUInt>, gridY<CUInt>, gridZ<CUInt>,
                  blockX<CUInt>, blockY<CUInt>, blockZ<CUInt>,
                  a0<Int>, a1<Int>, a2<Int>, a3<Int>)<CInt>
}

H<Int> = 4096
EINTER<Int> = 2048
LIM<Float> = 10.0
SCALE40<Float> = 1099511627776.0

di(v<Float>)<Int> -> {
    return (v * SCALE40) as Int
}

silu(x<Float>)<Float> -> {
    return x * (1.0 / (1.0 + vexp(0.0 - x)))
}

digest(name<String>, v<Vec<Float>>)<String> -> {
    s<Float> = 0.0
    a<Float> = 0.0
    q<Float> = 0.0
    m<Float> = 0.0
    i<Int> = 0
    while (i < v.len()) {
        x<Float> = v.get(i)
        s = s + x
        if (x < 0.0) { a = a - x } else { a = a + x }
        q = q + x * x
        t<Float> = x
        if (t < 0.0) { t = 0.0 - t }
        if (t > m) { m = t }
        i = i + 1
    }
    out<String> = name + " n=" + v.len().to_string() + " sum=" + di(s).to_string() +
                  " abs=" + di(a).to_string() + " sq=" + di(q).to_string() +
                  " max=" + di(m).to_string()
    i = 0
    while (i < 8) {
        hv<Float> = 0.0
        if (i < v.len()) { hv = v.get(i) }
        out = out + " v" + i.to_string() + "=" + di(hv).to_string()
        i = i + 1
    }
    return out
}

load_fn(ptx_path<String>, fn_name<String>)<Int> -> {
    ptx<String> = ""
    match (open_read(ptx_path)) {
        f -> { match (read_all(f)) { s -> { ptx = s } ? -> { return 0 } } close(f) }
        ? -> { return 0 }
    }
    var<Int> addr_out = 0
    freedom {
        var<loc<loc<CVoid>>> m = from<loc<loc<CVoid>>>(0)
        if (cuModuleLoadData(loc(m), ptx) != 0) { return 0 }
        var<loc<CVoid>> f = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(f), m, fn_name) != 0) { return 0 }
        addr_out = addr(f)
    }
    return addr_out
}

# host [rows,K] @ device W[K,N] -> host [rows,N]
mm_host(x<Vec<Float>>, rows<Int>, K<Int>, B<Int>, N<Int>, fgemm<Int>)<Vec<Float>> -> {
    out<Vec<Float>> = Vec()
    var<Int> dA = 0
    var<Int> scr = 0
    var<Int> dC = 0
    dA = dev_alloc(rows * K * 8)
    scr = dev_alloc(64)
    dC = dev_alloc(rows * N * 8)
    if (dA == 0 || scr == 0 || dC == 0) { return out }
    htod_vec(dA, x)
    if (gemm(fgemm, scr, dA, B, dC, rows, N, K, 1.0, 0.0) != 0) { return out }
    sync()
    out = dtoh_vec(dC, rows * N)
    return out
}

exl3_deq(fdeq<Int>, fhgen<Int>, fhad1<Int>, fhad2<Int>,
         trellis<String>, suh<String>, svh<String>, body<String>,
         cw<Int>, ntiles<Int>)<Int> -> {
    tb<Int> = 0
    kn<Int> = 0
    krows<Int> = 0
    nbc<Int> = 0
    nblocks<Int> = 0
    mb<Int> = 0
    hwide<Int> = 0
    bq<Int> = 0
    u<Int> = 0
    ch<Int> = 0
    b<Int> = 0
    pq<Int> = 0
    chq<Int> = 0
    var<Int> out = 0
    tb = trellis.len()
    if (tb < ntiles * 128) { return 0 }
    kn = (ntiles / (cw / 16)) * 16 * cw
    krows = kn / cw
    if ((suh.len() % 8) != 0 || (svh.len() % 8) != 0) { return 0 }
    if (suh.len() != krows * 2 || svh.len() != cw * 2) { return 0 }
    nbc = cw / 128
    nblocks = (kn / cw / 128) * nbc
    mb = 16 + body.len()
    freedom {
        var<Int> qd = 0
        var<Int> td = 0
        var<Int> od = 0
        var<Int> hd = 0
        var<Int> td2 = 0
        var<Int> fd = 0
        var<Int> pd = 0
        var<Int> sud = 0
        var<Int> svd = 0
        if (cuMemAlloc_v2(loc(qd), tb) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(td), mb) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(od), kn * 8) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(hd), 128 * 128 * 8) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(td2), kn * 8) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(fd), kn * 8) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(pd), 64) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(sud), krows * 2) != 0) { return 0 }
        if (cuMemAlloc_v2(loc(svd), cw * 2) != 0) { return 0 }

        # trellis: bulk copy straight from the String
        if (cuMemcpyHtoD_v2(qd, trellis, tb) != 0) { return 0 }
        # map: 16-byte header + the 256-slot body
        var<CInt> rc = 0
        hwide = 0
        bq = 0
        while (bq < 8) {
            hwide = hwide | (((cw >> (bq * 8)) & 255) << (bq * 8))
            bq = bq + 1
        }
        if (cuMemcpyHtoD_v2(td, loc(hwide), 8) != 0) { return 0 }
        hwide = 0
        bq = 0
        while (bq < 8) {
            hwide = hwide | (((ntiles >> (bq * 8)) & 255) << (bq * 8))
            bq = bq + 1
        }
        if (cuMemcpyHtoD_v2(td + 8, loc(hwide), 8) != 0) { return 0 }
        u = 0
        while (u < body.len()) {
            ch = 0
            b = 0
            while (b < 8) {
                ch = ch | ((((body.char_at(u + b) as Int) & 255)) << (b * 8))
                b = b + 1
            }
            if (cuMemcpyHtoD_v2(td + 16 + u, loc(ch), 8) != 0) { return 0 }
            u = u + 8
        }
        # dequant
        if (cuda_launch4i(from<loc<CVoid>>(fdeq), ntiles, 1, 1, 256, 1, 1, qd, td, od, 0) != 0) {
            return 0
        }
        cuCtxSynchronize()
        cuMemFree_v2(qd)
        cuMemFree_v2(td)
        # scales (fp16) to the device
        u = 0
        while (u < suh.len()) {
            ch = 0
            b = 0
            while (b < 8) {
                ch = ch | ((((suh.char_at(u + b) as Int) & 255)) << (b * 8))
                b = b + 1
            }
            if (cuMemcpyHtoD_v2(sud + u, loc(ch), 8) != 0) { return 0 }
            u = u + 8
        }
        u = 0
        while (u < svh.len()) {
            ch = 0
            b = 0
            while (b < 8) {
                ch = ch | ((((svh.char_at(u + b) as Int) & 255)) << (b * 8))
                b = b + 1
            }
            if (cuMemcpyHtoD_v2(svd + u, loc(ch), 8) != 0) { return 0 }
            u = u + 8
        }
        # hgen: H at pd+0
        if (cuMemcpyHtoD_v2(pd + 0, loc(hd), 8) != 0) { return 0 }
        if (cuda_launch4i(from<loc<CVoid>>(fhgen), 64, 1, 1, 256, 1, 1, pd, 0, 0, 0) != 0) {
            return 0
        }
        cuCtxSynchronize()
        # had1: what=od, tmp=td2, H=hd, cw, nbc, nblocks
        pq = 0
        while (pq < 6) {
            chq = 0
            if (pq == 0) { chq = od }
            if (pq == 1) { chq = td2 }
            if (pq == 2) { chq = hd }
            if (pq == 3) { chq = cw }
            if (pq == 4) { chq = nbc }
            if (pq == 5) { chq = nblocks }
            if (cuMemcpyHtoD_v2(pd + pq * 8, loc(chq), 8) != 0) { return 0 }
            pq = pq + 1
        }
        if (cuda_launch4i(from<loc<CVoid>>(fhad1), nblocks * 64, 1, 1, 256, 1, 1, pd, 0, 0, 0) != 0) {
            return 0
        }
        cuCtxSynchronize()
        # had2: tmp=td2, out=fd, H=hd, suh, svh, cw, nbc, nblocks
        pq = 0
        while (pq < 8) {
            chq = 0
            if (pq == 0) { chq = td2 }
            if (pq == 1) { chq = fd }
            if (pq == 2) { chq = hd }
            if (pq == 3) { chq = sud }
            if (pq == 4) { chq = svd }
            if (pq == 5) { chq = cw }
            if (pq == 6) { chq = nbc }
            if (pq == 7) { chq = nblocks }
            if (cuMemcpyHtoD_v2(pd + pq * 8, loc(chq), 8) != 0) { return 0 }
            pq = pq + 1
        }
        if (cuda_launch4i(from<loc<CVoid>>(fhad2), nblocks * 64, 1, 1, 256, 1, 1, pd, 0, 0, 0) != 0) {
            return 0
        }
        cuCtxSynchronize()
        cuMemFree_v2(od)
        cuMemFree_v2(hd)
        cuMemFree_v2(td2)
        cuMemFree_v2(pd)
        cuMemFree_v2(sud)
        cuMemFree_v2(svd)
        out = fd
    }
    return out
}
main()<Int> -> {
    dir<String> = env_get("VYBFORGE_GX_DIR") else "/mnt/apex/rick/vybforge/glm53-checkpoint"
    out<String> = env_get("VYBFORGE_EXP_OUT") else "native/out/l3exp_vyb.txt"
    h2path<String> = env_get("VYBFORGE_L3MOE_H2") else "native/out/gold_l3_moe_h2.txt"
    idtxt<String> = env_get("VYBFORGE_EXPERT_IDS") else "202,149,10,205,285,20,97,252"
    wtxt<String> = env_get("VYBFORGE_EXPERT_W") else ""
    total<Int> = 83

    if (tensor_init() != 0) { println("EXP_FAIL no cuda"); return 3 }
    fgemm<Int> = load_fn("native/build/gemm.ptx", "gemm")
    fdeq<Int> = load_fn("native/build/exl3.ptx", "exl3deq")
    fhgen<Int> = load_fn("native/build/exl3.ptx", "exl3hgen")
    fhad1<Int> = load_fn("native/build/exl3.ptx", "exl3had1")
    fhad2<Int> = load_fn("native/build/exl3.ptx", "exl3had2")
    if (fgemm == 0 || fdeq == 0 || fhgen == 0 || fhad1 == 0 || fhad2 == 0) {
        println("EXP_FAIL kernels")
        return 4
    }

    mapd<String> = ""
    match (open_read("native/exl3/map.bin")) {
        f -> { match (read_all(f)) { s -> { mapd = s } ? -> { return 5 } } close(f) }
        ? -> { println("EXP_FAIL no map.bin (make exl3)"); return 5 }
    }
    body<String> = mapd.substring(16, mapd.len())

    # token 0's h2 row (the first 4096 integers of the dumped matrix)
    t<String> = ""
    match (open_read(h2path)) {
        f -> { match (read_all(f)) { s -> { t = s } ? -> { return 6 } } close(f) }
        ? -> { println("EXP_FAIL no h2"); return 6 }
    }
    h2row<Vec<Float>> = Vec()
    cur<String> = ""
    i<Int> = 0
    while (i < t.len() && h2row.len() < H) {
        ch<String> = t.substring(i, i + 1)
        if (ch == " " || ch == "\n") {
            if (cur.len() > 0) {
                h2row.push((cur.to_int() as Float) / SCALE40)
                cur = ""
            }
        } else { cur = cur + ch }
        i = i + 1
    }
    if (h2row.len() != H) { println("EXP_FAIL h2 row " + h2row.len().to_string()); return 7 }

    # expert ids
    ids<Vec<Int>> = Vec()
    cur = ""
    i = 0
    while (i <= idtxt.len()) {
        ch2<String> = ""
        if (i < idtxt.len()) { ch2 = idtxt.substring(i, i + 1) }
        if (i == idtxt.len() || ch2 == ",") {
            if (cur.len() > 0) {
                ids.push(cur.to_int())
                cur = ""
            }
        } else { cur = cur + ch2 }
        i = i + 1
    }
    if (ids.len() != 8) { println("EXP_FAIL ids " + ids.len().to_string()); return 8 }

    # lane weights (scaled integers, /2^40) — from the gold's renormed router output
    wts<Vec<Float>> = Vec()
    cur = ""
    i = 0
    while (i <= wtxt.len()) {
        chw<String> = ""
        if (i < wtxt.len()) { chw = wtxt.substring(i, i + 1) }
        if (i == wtxt.len() || chw == ",") {
            if (cur.len() > 0) {
                wts.push((cur.to_int() as Float) / SCALE40)
                cur = ""
            }
        } else { cur = cur + chw }
        i = i + 1
    }
    if (wts.len() != ids.len()) { println("EXP_FAIL weights " + wts.len().to_string()); return 12 }

    acc<Vec<Float>> = Vec()
    i = 0
    while (i < H) {
        acc.push(0.0)
        i = i + 1
    }

    lane<Int> = 0
    while (lane < ids.len()) {
        e<Int> = ids.get(lane)
        epre<String> = "model.language_model.layers.3.mlp.experts." + e.to_string() + "."
        want<Vec<String>> = Vec()
        want.push(epre + "gate_proj.trellis")
        want.push(epre + "gate_proj.suh")
        want.push(epre + "gate_proj.svh")
        want.push(epre + "up_proj.trellis")
        want.push(epre + "up_proj.suh")
        want.push(epre + "up_proj.svh")
        want.push(epre + "down_proj.trellis")
        want.push(epre + "down_proj.suh")
        want.push(epre + "down_proj.svh")
        g<GxLoc> = gx_resolve(dir, total, want)
        nf<Int> = 0
        j<Int> = 0
        while (j < want.len()) {
            if (g.found.get(j) == 1) { nf = nf + 1 }
            j = j + 1
        }
        if (nf != want.len()) { println("EXP_FAIL resolve expert " + e.to_string()); return 9 }

        # gate_proj / up_proj: [in=4096, out=2048] -> cw 2048, ntiles (4096/16)*(2048/16)
        dWg<Int> = exl3_deq(fdeq, fhgen, fhad1, fhad2, gx_read(g, 0), gx_read(g, 1),
                            gx_read(g, 2), body, EINTER, 32768)
        dWu<Int> = exl3_deq(fdeq, fhgen, fhad1, fhad2, gx_read(g, 3), gx_read(g, 4),
                            gx_read(g, 5), body, EINTER, 32768)
        # down_proj: [in=2048, out=4096] -> cw 4096, ntiles (2048/16)*(4096/16)
        dWd<Int> = exl3_deq(fdeq, fhgen, fhad1, fhad2, gx_read(g, 6), gx_read(g, 7),
                            gx_read(g, 8), body, H, 32768)
        if (dWg == 0 || dWu == 0 || dWd == 0) { println("EXP_FAIL deq expert " + e.to_string()); return 10 }

        gv<Vec<Float>> = mm_host(h2row, 1, H, dWg, EINTER, fgemm)
        uv<Vec<Float>> = mm_host(h2row, 1, H, dWu, EINTER, fgemm)
        act<Vec<Float>> = Vec()
        j = 0
        while (j < EINTER) {
            g1<Float> = gv.get(j)
            if (g1 > LIM) { g1 = LIM }
            u1<Float> = uv.get(j)
            if (u1 > LIM) { u1 = LIM }
            if (u1 < 0.0 - LIM) { u1 = 0.0 - LIM }
            act.push(silu(g1) * u1)
            j = j + 1
        }
        yv<Vec<Float>> = mm_host(act, 1, EINTER, dWd, H, fgemm)
        j = 0
        while (j < H) {
            acc.set(j, acc.get(j) + wts.get(lane) * yv.get(j))
            j = j + 1
        }
        println("  lane " + lane.to_string() + " expert " + e.to_string() +
                " |y|=" + di(yv.get(0)).to_string())
        freedom {
            cuMemFree_v2(dWg)
            cuMemFree_v2(dWu)
            cuMemFree_v2(dWd)
        }
        lane = lane + 1
    }

    line<String> = digest("routed", acc)
    println(line)
    match (open_write(out)) {
        f -> { write_str(f, line + "\n"); close(f) }
        ? -> { return 11 }
    }
    println("EXPERT_OK lanes=" + ids.len().to_string())
    return 0
}
