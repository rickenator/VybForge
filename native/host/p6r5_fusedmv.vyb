// p6r5_fusedmv — the fused decode+matvec prototype, gated against the current
// materialise-W path on ONE expert's gate_proj (2048x4096).
//   old:  deq W (33.5 MB to HBM)  ->  mm_host32(x, W)
//   new:  xp = sv . (H x)  ->  yraw = T xp (W never stored)  ->  y = H yraw
// Gate: rel error <= 1e-5 vs the old path (re-associated f32 sums, not bit-exact).
// env: P6_DIR, P6_EXP
import io::{open_read, read_all, close}
import env::{env_get}
import time::{time_mono_millis}
import tensor::{tensor_init, dev_alloc, bulk_htod, bulk_dtoh, sync}
import gx::{gx_read}
import glm_engine::{load_fn, had_hoist32, mapdev_build, exl3_deq32f_into, exl3_deq32f, mm_host32, gx_resolve_tab, launch_kernel, wr_pdev, alloc_dev, H}

main()<Int> -> {
    dir<String> = env_get("P6_DIR") else "/srv/models/hf/hub/models--Mia-AiLab--GLM-5.3-Flash-EXL3-4bpw-TensorFold/snapshots/078455ffe6472f9a52fbc1139f58b9db2881b25c"
    expS<String> = env_get("P6_EXP") else "153"
    e<Int> = 0
    i<Int> = 0
    while (i < expS.len()) {
        c<Int> = (expS.char_at(i) as Int) & 255
        if (c >= 48 && c <= 57) { e = e * 10 + (c - 48) }
        i = i + 1
    }
    if (tensor_init() != 0) { println("P6_FAIL cuda"); return 1 }
    fdqs4<Int> = load_fn("native/build/exl3dq.ptx", "exl3dq1s4")
    fhad232<Int> = load_fn("native/build/exl3.ptx", "exl3had232")
    fhgen32<Int> = load_fn("native/build/exl3.ptx", "exl3hgen32")
    finvk<Int> = load_fn("native/build/exl3.ptx", "exl3inv")
    fcast32<Int> = load_fn("native/build/layer.ptx", "cast32")
    fgp<Int> = load_fn("native/build/layer.ptx", "gemm32_p")
    fgr<Int> = load_fn("native/build/layer.ptx", "gemm32_r")
    fxh<Int> = load_fn("native/build/exl3mv.ptx", "exl3xhat")
    fmv<Int> = load_fn("native/build/exl3mv.ptx", "exl3mv1s4")
    fyh<Int> = load_fn("native/build/exl3mv.ptx", "exl3yhat")
    if (fdqs4 == 0 || fhad232 == 0 || fhgen32 == 0 || finvk == 0 || fcast32 == 0 || fgp == 0 || fgr == 0) { println("P6_FAIL kernels"); return 2 }
    if (fxh == 0 || fmv == 0 || fyh == 0) { println("P6_FAIL mvkernels"); return 2 }
    hd_pre32<Int> = had_hoist32(fhgen32)
    if (hd_pre32 == 0) { println("P6_FAIL hadhoist"); return 3 }
    mapd<String> = ""
    match (open_read("native/exl3/map.bin")) {
        f -> { match (read_all(f)) { s -> { mapd = s } ? -> { return 4 } } close(f) }
        ? -> { println("P6_FAIL map.bin"); return 4 }
    }
    mapbody<String> = mapd.substring(16, mapd.len())
    nbmap<Int> = mapd.len() - 16
    mapdev<Int> = mapdev_build(finvk, mapd)
    if (mapdev == 0) { println("P6_FAIL mapdev"); return 5 }
    invbase<Int> = mapdev + 16 + nbmap
    arA<Int> = dev_alloc(8388608)
    arB<Int> = dev_alloc(65536)
    arC<Int> = dev_alloc(33554432)
    arD<Int> = dev_alloc(33554432)
    arG<Int> = dev_alloc(16384)
    arH<Int> = dev_alloc(16384)
    arI<Int> = dev_alloc(64)
    pb32<Int> = dev_alloc(192)
    pbx<Int> = dev_alloc(64)
    pbm<Int> = dev_alloc(96)
    pby<Int> = dev_alloc(48)
    if (arA == 0 || arB == 0 || arC == 0 || arD == 0 || arG == 0 || arH == 0 || arI == 0 || pb32 == 0) { println("P6_FAIL arena"); return 6 }
    // fusion work buffers: xp (4096 f32), yraw (2048 f32), y (2048 f32)
    bxp<Int> = dev_alloc(16384)
    byr<Int> = dev_alloc(8192)
    by<Int> = dev_alloc(16384)
    bx<Int> = dev_alloc(16384)
    if (bxp == 0 || byr == 0 || by == 0 || bx == 0) { println("P6_FAIL fbufs"); return 6 }
    // tab
    cache_path<String> = env_get("VYBFORGE_TAB_CACHE") else "native/out/gx_tabs.cache"
    cs<String> = ""
    match (open_read(cache_path)) {
        f -> { match (read_all(f)) { s -> { cs = s } ? -> { return 4 } } close(f) }
        ? -> { println("P6_FAIL tabcache"); return 4 }
    }
    nl0<Int> = find_from(cs, "\n", 0)
    pos<Int> = nl0 + 1
    tab3<String> = ""
    ti<Int> = 0
    while (ti < 45) {
        nl<Int> = find_from(cs, "\n", pos)
        if (nl < 0) { println("P6_FAIL tabcache_trunc"); return 5 }
        plen<Int> = cs.substring(pos, nl).to_int()
        if (ti == 3) { tab3 = cs.substring(nl + 1, nl + 1 + plen) }
        pos = nl + 1 + plen
        ti = ti + 1
    }
    epre<String> = "model.language_model.layers.3.mlp.experts." + e.to_string() + ".gate_proj."
    w2<Vec<String>> = Vec()
    w2.push(epre + "trellis")
    w2.push(epre + "suh")
    w2.push(epre + "svh")
    ge<GxLoc> = gx_resolve_tab(tab3, dir, 83, w2)
    g0<String> = gx_read(ge, 0)
    g1<String> = gx_read(ge, 1)
    g2<String> = gx_read(ge, 2)
    println("P6R5 trellis=" + g0.len().to_string() + " suh=" + g1.len().to_string() + " svh=" + g2.len().to_string())
    // x
    oneshot<Bool> = (env_get("P6_ONESHOT") else "0") == "1"
    x<Vec<Float>> = Vec()
    i = 0
    while (i < 4096) {
        if (oneshot) {
            if (i == 0) { x.push(1.0) } else { x.push(0.0) }
        } else {
            x.push((((i * 37) % 251) as Float - 125.0) / 250.0)
        }
        i = i + 1
    }
    xb<Vec<UInt8>> = Vec()
    // ---- OLD path: materialise W then matvec ----
    ta<Int> = time_mono_millis()
    dW<Int> = exl3_deq32f_into(0, 0, fdqs4, 0, fhad232, g0, g1, g2, mapbody, 2048, 32768, hd_pre32,
                               arA, arB, arC, arD, arG, arH, arI, mapdev, invbase, arC)
    if (dW == 0) { println("P6_FAIL deq"); return 7 }
    tdeq<Int> = time_mono_millis()
    yold<Vec<Float>> = mm_host32(x, 1, 4096, dW, 2048, fcast32, fgp, fgr, pb32)
    told<Int> = time_mono_millis()
    println("P6R5 OLD deq_ms=" + (tdeq - ta).to_string() + " mm_ms=" + (told - tdeq).to_string() + " total=" + (told - ta).to_string() + " ylen=" + yold.len().to_string())
    // W^T row 0 = column 0 of W = exactly what a one-hot x must produce
    fcast64<Int> = load_fn("native/build/dbg_sh.ptx", "f32t64")
    wrow<Int> = dev_alloc(16384)
    pbc<Int> = dev_alloc(24)
    wr_pdev(pbc, 0, dW)
    wr_pdev(pbc, 8, wrow)
    wr_pdev(pbc, 16, 2048)
    launch_kernel(fcast64, 8, pbc)
    cuCtxSynchronize()
    wcol<Vec<Float>> = bulk_dtoh(wrow, 2048)
    // ---- INDEX-IDENTITY PROBE: which buffer element is y0 for x = e_0? ----
    if ((env_get("P6_IDX") else "0") == "1") {
        fcast64b<Int> = load_fn("native/build/dbg_sh.ptx", "f32t64")
        bd<Int> = dev_alloc(128)
        pbd2<Int> = dev_alloc(24)
        idxs<Vec<Int>> = Vec()
        idxs.push(0) ; idxs.push(1) ; idxs.push(2) ; idxs.push(7)
        idxs.push(2048) ; idxs.push(4096) ; idxs.push(4097) ; idxs.push(2047)
        k2<Int> = 0
        while (k2 < idxs.len()) {
            wr_pdev(pbd2, 0, dW + idxs.get(k2) * 4)
            wr_pdev(pbd2, 8, bd + k2 * 8)
            wr_pdev(pbd2, 16, 1)
            launch_kernel(fcast64b, 1, pbd2)
            k2 = k2 + 1
        }
        cuCtxSynchronize()
        bv<Vec<Float>> = bulk_dtoh(bd, 8)
        println("P6IDX B[0]=" + bv.get(0).to_string_precise() + " B[1]=" + bv.get(1).to_string_precise() + " B[2]=" + bv.get(2).to_string_precise() + " B[7]=" + bv.get(3).to_string_precise())
        println("P6IDX B[2048]=" + bv.get(4).to_string_precise() + " B[4096]=" + bv.get(5).to_string_precise() + " B[4097]=" + bv.get(6).to_string_precise() + " B[2047]=" + bv.get(7).to_string_precise())
        // y for x = e_0 and x = e_1 (old path; mm is cheap)
        e0<Vec<Float>> = Vec()
        e1<Vec<Float>> = Vec()
        i = 0
        while (i < 4096) {
            if (i == 0) { e0.push(1.0) } else { e0.push(0.0) }
            if (i == 1) { e1.push(1.0) } else { e1.push(0.0) }
            i = i + 1
        }
        ye0<Vec<Float>> = mm_host32(e0, 1, 4096, dW, 2048, fcast32, fgp, fgr, pb32)
        ye1<Vec<Float>> = mm_host32(e1, 1, 4096, dW, 2048, fcast32, fgp, fgr, pb32)
        println("P6IDX y(e0)_0=" + ye0.get(0).to_string_precise() + " y(e0)_1=" + ye0.get(1).to_string_precise() + " y(e1)_0=" + ye1.get(0).to_string_precise() + " y(e1)_1=" + ye1.get(1).to_string_precise())
        return 0
    }
    // ---- VECTOR-PASS ISOLATION (P6_VEC=1): x = e_0, dump H/su/xp ----
    if ((env_get("P6_VEC") else "0") == "1") {
        e0v<Vec<Float>> = Vec()
        i = 0
        while (i < 4096) {
            if (i == 0) { e0v.push(1.0) } else { e0v.push(0.0) }
            i = i + 1
        }
        d64<Int> = alloc_dev(32768)
        bulk_htod(d64, view(e0v))
        wr_pdev(pb32, 0, d64)
        wr_pdev(pb32, 8, bx)
        wr_pdev(pb32, 16, 4096)
        launch_kernel(fcast32, 16, pb32)
        cuCtxSynchronize()
        free_dev(d64)
        wr_pdev(pbx, 0, bx)
        wr_pdev(pbx, 8, bxp)
        wr_pdev(pbx, 16, hd_pre32)
        wr_pdev(pbx, 24, arG)
        wr_pdev(pbx, 32, 4096)
        launch_kernel(fxh, 32, pbx)
        cuCtxSynchronize()
        fd2<Int> = load_fn("native/build/dbg2.ptx", "dbg2")
        o2<Int> = dev_alloc(48)
        o2c<Int> = dev_alloc(96)
        pd2<Int> = dev_alloc(32)
        wr_pdev(pd2, 0, o2)
        wr_pdev(pd2, 8, hd_pre32)
        wr_pdev(pd2, 16, arG)
        wr_pdev(pd2, 24, bxp)
        launch_kernel(fd2, 1, pd2)
        cuCtxSynchronize()
        // cast the 12 f32s to f64 for honest reading
        pcc<Int> = dev_alloc(24)
        wr_pdev(pcc, 0, o2)
        wr_pdev(pcc, 8, o2c)
        wr_pdev(pcc, 16, 12)
        launch_kernel(fcast64, 1, pcc)
        cuCtxSynchronize()
        vv<Vec<Float>> = bulk_dtoh(o2c, 12)
        i = 0
        while (i < 4) {
            hval<Float> = vv.get(i)
            suv<Float> = vv.get(4 + i)
            xpv<Float> = vv.get(8 + i)
            expv<Float> = suv * hval
            println("P6VEC i=" + i.to_string() + " H=" + hval.to_string_precise() + " su=" + suv.to_string_precise() + " xp=" + xpv.to_string_precise() + " expected_xp=" + expv.to_string_precise())
            i = i + 1
        }
        return 0
    }
    // ---- NEW path: xp -> yraw -> y ----
    tb<Int> = time_mono_millis()
    // stage x (bulk_htod f64 -> cast32 f32), the trellis, su/sv, and zero yraw
    dA64x<Int> = alloc_dev(32768)
    bulk_htod(dA64x, view(x))
    wr_pdev(pb32, 0, dA64x)
    wr_pdev(pb32, 8, bx)
    wr_pdev(pb32, 16, 4096)
    launch_kernel(fcast32, 16, pb32)
    cuCtxSynchronize()
    free_dev(dA64x)
    cuMemcpyHtoD_v2(arA, g0, g0.len())
    cuMemcpyHtoD_v2(arG, g1, g1.len())
    cuMemcpyHtoD_v2(arH, g2, g2.len())
    cuMemcpyHtoD_v2(byr, zero_bytes(8192), 8192)
    tup<Int> = time_mono_millis()
    // p: +0 x, +8 out(xp), +16 H, +24 sv, +32 cw
    var<Int> v1 = bx
    var<Int> v2 = bxp
    var<Int> v3 = hd_pre32
    var<Int> v4 = arG
    var<Int> v5 = 4096
    wr_pdev(pbx, 0, v1)
    wr_pdev(pbx, 8, v2)
    wr_pdev(pbx, 16, v3)
    wr_pdev(pbx, 24, v4)
    wr_pdev(pbx, 32, v5)
    fdbg<Int> = load_fn("native/build/dbg_sh.ptx", "dbg_sh")
    if (fdbg != 0) {
        pbd<Int> = dev_alloc(48)
        bdb<Int> = dev_alloc(48)
        wr_pdev(pbd, 0, bdb)
        wr_pdev(pbd, 8, hd_pre32)
        wr_pdev(pbd, 16, arG)
        wr_pdev(pbd, 24, bx)
        launch_kernel(fdbg, 1, pbd)
        cuCtxSynchronize()
        dbg<Vec<Float>> = bulk_dtoh(bdb, 12)
        println("P6R5 DBG H0=" + dbg.get(0).to_string_precise() + " H1=" + dbg.get(1).to_string_precise() + " H2=" + dbg.get(2).to_string_precise())
        println("P6R5 DBG su0=" + dbg.get(4).to_string_precise() + " su1=" + dbg.get(5).to_string_precise() + " su2=" + dbg.get(6).to_string_precise())
        println("P6R5 DBG x0=" + dbg.get(8).to_string_precise() + " x1=" + dbg.get(9).to_string_precise() + " x2=" + dbg.get(10).to_string_precise())
    }
    // ---- DECODE ORACLE (P6_T=1): fused slab vs the verified kernel's own decode ----
    if ((env_get("P6_T") else "0") == "1") {
        # xp must exist before the fused mv runs (it feeds the dots)
        launch_kernel(fxh, 32, pbx)
        cuCtxSynchronize()
        fo<Int> = load_fn("native/build/exl3dqdbg.ptx", "exl3dqdbg1s4")
        fcm<Int> = load_fn("native/build/dbg_sh.ptx", "cmp32")
        if (fo == 0 || fcm == 0) { println("P6_FAIL oracle_kernel"); return 2 }
        bTe<Int> = dev_alloc(33554432)
        bTf<Int> = dev_alloc(33554432)
        pbo<Int> = dev_alloc(64)
        wr_pdev(pbo, 0, arA)
        wr_pdev(pbo, 8, mapdev)
        wr_pdev(pbo, 16, 0)
        wr_pdev(pbo, 24, bTe)
        wr_pdev(pbo, 32, 2048)
        wr_pdev(pbo, 40, invbase)
        rco<Int> = launch_kernel(fo, 8192, pbo)
        cuCtxSynchronize()
        println("P6T oracle_launch_rc=" + rco.to_string())
        // the fused kernel with its dump enabled (same grid, same cw)
        wr_pdev(pbm, 64, bTf)
        rcm2<Int> = launch_kernel(fmv, 8192, pbm)
        cuCtxSynchronize()
        println("P6T fused_launch_rc=" + rcm2.to_string())
        cnt<Int> = dev_alloc(8)
        sm<Int> = dev_alloc(8)
        wr_pdev(cnt, 0, 0)
        wr_pdev(sm, 0, 0)
        pbcmp<Int> = dev_alloc(40)
        wr_pdev(pbcmp, 0, bTe)
        wr_pdev(pbcmp, 8, bTf)
        wr_pdev(pbcmp, 16, 8388608)
        wr_pdev(pbcmp, 24, cnt)
        wr_pdev(pbcmp, 32, sm)
        launch_kernel(fcm, 32768, pbcmp)
        cuCtxSynchronize()
        cv2<Vec<Float>> = bulk_dtoh(cnt, 1)
        sv2<Vec<Float>> = bulk_dtoh(sm, 1)
        println("P6T DECODE_DIFF count_over_1e-4=" + (cv2.get(0) as Int).to_string() + " sum_absdiff=" + sv2.get(0).to_string_precise())
        // ---- HOST-SIDE reference (no kernel loads at all) ----
        if ((env_get("P6_HC") else "0") == "1") {
            fcv<Int> = load_fn("native/build/dbg_sh.ptx", "f32t64")
            th<Int> = time_mono_millis()
            t64<Int> = dev_alloc(67108864)
            pbcv<Int> = dev_alloc(24)
            wr_pdev(pbcv, 0, bTe)
            wr_pdev(pbcv, 8, t64)
            wr_pdev(pbcv, 16, 8388608)
            launch_kernel(fcv, 32768, pbcv)
            cuCtxSynchronize()
            T64<Vec<Float>> = bulk_dtoh(t64, 8388608)
            println("P6HC T cast+copy ms=" + (time_mono_millis() - th).to_string() + " n=" + T64.len().to_string())
            // xp (4096 f32 -> f64)
            xp64<Int> = dev_alloc(32768)
            wr_pdev(pbcv, 0, bxp)
            wr_pdev(pbcv, 8, xp64)
            wr_pdev(pbcv, 16, 4096)
            launch_kernel(fcv, 16, pbcv)
            cuCtxSynchronize()
            XP64<Vec<Float>> = bulk_dtoh(xp64, 4096)
            // sv from the host string g2 (f16, one per output column)
            // the fused yraw (2048 f32)
            yr64<Int> = dev_alloc(16384)
            wr_pdev(pbcv, 0, byr)
            wr_pdev(pbcv, 8, yr64)
            wr_pdev(pbcv, 16, 2048)
            launch_kernel(fcv, 1, pbcv)
            cuCtxSynchronize()
            YR64<Vec<Float>> = bulk_dtoh(yr64, 2048)
            // H to the host as f64 (16384 values)
            h64<Int> = dev_alloc(131072)
            wr_pdev(pbcv, 0, hd_pre32)
            wr_pdev(pbcv, 8, h64)
            wr_pdev(pbcv, 16, 16384)
            launch_kernel(fcv, 64, pbcv)
            cuCtxSynchronize()
            H64<Vec<Float>> = bulk_dtoh(h64, 16384)
            U<Vec<Float>> = Vec()
            // reference u
            th = time_mono_millis()
            ndh<Int> = 0
            nsum<Float> = 0.0
            n2<Int> = 0
            while (n2 < 2048) {
                acc<Float> = 0.0
                k2<Int> = 0
                while (k2 < 4096) {
                    acc = acc + T64.get(k2 * 2048 + n2) * XP64.get(k2)
                    k2 = k2 + 1
                }
                svv<Float> = f16_host(g2, n2)
                u<Float> = acc * svv
                U.push(u)
                dd<Float> = u - YR64.get(n2)
                ad<Float> = dd
                if (ad < 0.0) { ad = 0.0 - ad }
                if (ad > 1e-4) { ndh = ndh + 1 }
                nsum = nsum + ad
                n2 = n2 + 1
            }
            println("P6HC U_DIFF count_over_1e-4=" + ndh.to_string() + " sum_absdiff=" + nsum.to_string_precise() + " ms=" + (time_mono_millis() - th).to_string())
            // the fused y (by) for the same input
            y64<Int> = dev_alloc(16384)
            wr_pdev(pbcv, 0, by)
            wr_pdev(pbcv, 8, y64)
            wr_pdev(pbcv, 16, 2048)
            launch_kernel(fcv, 1, pbcv)
            cuCtxSynchronize()
            Y64<Vec<Float>> = bulk_dtoh(y64, 2048)
            ndy<Int> = 0
            nsy<Float> = 0.0
            n3<Int> = 0
            while (n3 < 2048) {
                a3<Int> = n3 % 128
                b3<Int> = n3 - a3
                acc3<Float> = 0.0
                m3<Int> = 0
                while (m3 < 128) {
                    acc3 = acc3 + H64.get(a3 * 128 + m3) * U.get(b3 + m3)
                    m3 = m3 + 1
                }
                dd3<Float> = acc3 - Y64.get(n3)
                ad3<Float> = dd3
                if (ad3 < 0.0) { ad3 = 0.0 - ad3 }
                if (ad3 > 1e-4) { ndy = ndy + 1 }
                nsy = nsy + ad3
                n3 = n3 + 1
            }
            println("P6HC Y_DIFF count_over_1e-4=" + ndy.to_string() + " sum_absdiff=" + nsy.to_string_precise())
            return 0
        }
        // ---- the dot: reference yraw from the PROVEN T, vs the fused yraw ----
        fru<Int> = load_fn("native/build/exl3mv.ptx", "exl3refu")
        fry<Int> = load_fn("native/build/exl3mv.ptx", "exl3refy")
        println("P6T loads refu=" + fru.to_string() + " refy=" + fry.to_string())
        if (fru == 0) { println("P6_FAIL refu"); return 2 }
        bUref<Int> = dev_alloc(8192)
        pbr<Int> = dev_alloc(48)
        wr_pdev(pbr, 0, bTe)
        wr_pdev(pbr, 8, bxp)
        wr_pdev(pbr, 16, 2048)
        wr_pdev(pbr, 24, 4096)
        wr_pdev(pbr, 32, bUref)
        wr_pdev(pbr, 40, arH)
        launch_kernel(fru, 8, pbr)
        cuCtxSynchronize()
        wr_pdev(pbcmp, 0, bUref)
        wr_pdev(pbcmp, 8, byr)
        wr_pdev(pbcmp, 16, 2048)
        wr_pdev(cnt, 0, 0)
        wr_pdev(sm, 0, 0)
        launch_kernel(fcm, 1, pbcmp)
        cuCtxSynchronize()
        cv3<Vec<Float>> = bulk_dtoh(cnt, 1)
        sv3<Vec<Float>> = bulk_dtoh(sm, 1)
        println("P6T DOT_DIFF count_over_1e-4=" + (cv3.get(0) as Int).to_string() + " sum_absdiff=" + sv3.get(0).to_string_precise())
        // ---- yhat vs the plain reference output transform (on the reference u) ----
        bYref<Int> = dev_alloc(8192)
        pbyr<Int> = dev_alloc(32)
        wr_pdev(pbyr, 0, hd_pre32)
        wr_pdev(pbyr, 8, bUref)
        wr_pdev(pbyr, 16, bYref)
        wr_pdev(pbyr, 24, 2048)
        launch_kernel(fry, 8, pbyr)
        cuCtxSynchronize()
        wr_pdev(pbcmp, 0, bYref)
        wr_pdev(pbcmp, 8, by)
        wr_pdev(pbcmp, 16, 2048)
        wr_pdev(cnt, 0, 0)
        wr_pdev(sm, 0, 0)
        launch_kernel(fcm, 1, pbcmp)
        cuCtxSynchronize()
        cv4<Vec<Float>> = bulk_dtoh(cnt, 1)
        sv4<Vec<Float>> = bulk_dtoh(sm, 1)
        println("P6T YHAT_DIFF count_over_1e-4=" + (cv4.get(0) as Int).to_string() + " sum_absdiff=" + sv4.get(0).to_string_precise())
        // and the reference y against the verified B row (x-dependent)
        return 0
    }
    rcx<Int> = launch_kernel(fxh, 32, pbx)
    println("P6R5 DBG xh_launch_rc=" + rcx.to_string())
    cuCtxSynchronize()
    txh<Int> = time_mono_millis()
    // p: +0 yraw, +8 xp, +16 su, +24 cw, +40 q(trellis), +48 td(mapdev), +56 inv
    var<Int> m1 = byr
    var<Int> m2 = bxp
    var<Int> m3 = arH
    var<Int> m4 = 2048
    var<Int> m5 = 0
    var<Int> m6 = arA
    var<Int> m7 = mapdev
    var<Int> m8 = invbase
    wr_pdev(pbm, 0, m1)
    wr_pdev(pbm, 8, m2)
    wr_pdev(pbm, 16, m3)
    wr_pdev(pbm, 24, m4)
    wr_pdev(pbm, 32, m5)
    wr_pdev(pbm, 40, m6)
    wr_pdev(pbm, 48, m7)
    wr_pdev(pbm, 56, m8)
    wr_pdev(pbm, 64, 0)
    rcm<Int> = launch_kernel(fmv, 8192, pbm)
    println("P6R5 DBG mv_launch_rc=" + rcm.to_string())
    cuCtxSynchronize()
    tmv<Int> = time_mono_millis()
    // p: +0 yraw, +8 y, +16 H, +24 cw
    var<Int> h1 = byr
    var<Int> h2 = by
    var<Int> h3 = hd_pre32
    var<Int> h4 = 2048
    wr_pdev(pby, 0, h1)
    wr_pdev(pby, 8, h2)
    wr_pdev(pby, 16, h3)
    wr_pdev(pby, 24, h4)
    rcy<Int> = launch_kernel(fyh, 16, pby)
    println("P6R5 DBG yh_launch_rc=" + rcy.to_string())
    cuCtxSynchronize()
    tyh<Int> = time_mono_millis()
    ynew<Vec<Float>> = bulk_dtoh(by, 2048)
    println("P6R5 NEW stage_ms=" + (tup - tb).to_string() + " xhat_ms=" + (txh - tup).to_string() + " mv_ms=" + (tmv - txh).to_string() + " yhat_ms=" + (tyh - tmv).to_string() + " total=" + (tyh - tb).to_string() + " ylen=" + ynew.len().to_string())
    // dump the first few values of each stage
    yrd<Vec<Float>> = bulk_dtoh(by, 8)
    xpd<Vec<Float>> = bulk_dtoh(bxp, 4)
    println("P6R5 DBG yraw0=" + yrd.get(0).to_string_precise() + " yraw1=" + yrd.get(1).to_string_precise())
    println("P6R5 DBG xp0=" + xpd.get(0).to_string_precise() + " xp1=" + xpd.get(1).to_string_precise())
    println("P6R5 DBG ynew0=" + ynew.get(0).to_string_precise() + " yold0=" + yold.get(0).to_string_precise())
    // ---- the gate ----
    nd<Int> = 0
    mx<Float> = 0.0
    i = 0
    while (i < 2048) {
        d<Float> = ynew.get(i) - yold.get(i)
        ad<Float> = d
        if (ad < 0.0) { ad = 0.0 - ad }
        if (ad > mx) { mx = ad }
        if (ad > 1e-3) { nd = nd + 1 }
        i = i + 1
    }
    // relative scale of the old output
    nn<Float> = 0.0
    i = 0
    while (i < 2048) {
        av<Float> = yold.get(i)
        if (av < 0.0) { av = 0.0 - av }
        if (av > nn) { nn = av }
        i = i + 1
    }
    rel<Float> = mx / (nn + 1e-30)
    println("P6R5_GATE max_abs=" + mx.to_string_precise() + " over_max=" + nn.to_string_precise() + " rel=" + rel.to_string_precise() + " over1e-3=" + nd.to_string())
    // what is zero: yraw or sv?
    fcv2<Int> = load_fn("native/build/dbg_sh.ptx", "f32t64")
    yrd2<Int> = dev_alloc(64)
    pbcv2<Int> = dev_alloc(24)
    wr_pdev(pbcv2, 0, byr)
    wr_pdev(pbcv2, 8, yrd2)
    wr_pdev(pbcv2, 16, 4)
    launch_kernel(fcv2, 1, pbcv2)
    cuCtxSynchronize()
    yrv<Vec<Float>> = bulk_dtoh(yrd2, 4)
    println("P6R5 DBG yraw0=" + yrv.get(0).to_string_precise() + " yraw1=" + yrv.get(1).to_string_precise() + " sv0=" + f16_host(g2, 0).to_string_precise() + " sv1=" + f16_host(g2, 1).to_string_precise())
    println("P6R5 DBG new_y0=" + ynew.get(0).to_string_precise() + " new_y1=" + ynew.get(1).to_string_precise() + " new_y2=" + ynew.get(2).to_string_precise())
    println("P6R5 DBG B0_0=" + wcol.get(0).to_string_precise() + " B0_1=" + wcol.get(1).to_string_precise() + " B0_2=" + wcol.get(2).to_string_precise())
    if (oneshot) {
        // x = e_0: y[n] must equal B[0][n] exactly (one term survives)
        nd2<Int> = 0
        mx2<Float> = 0.0
        i = 0
        while (i < 2048) {
            dd<Float> = ynew.get(i) - wcol.get(i)
            ad2<Float> = dd
            if (ad2 < 0.0) { ad2 = 0.0 - ad2 }
            if (ad2 > mx2) { mx2 = ad2 }
            if (ad2 > 1e-4) { nd2 = nd2 + 1 }
            i = i + 1
        }
        println("P6R5 ONESHOT_GATE max_abs=" + mx2.to_string_precise() + " over1e-4=" + nd2.to_string())
    }
    if (rel <= 1e-5) { println("P6R5_DONE FUSED_OK") } else { println("P6R5_DONE FUSED_FAIL") }
    return 0
}

f16_host(s<String>, i<Int>)<Float> -> {
    // f16 at byte offset i*2, little-endian, normal values only (scales)
    b0<Int> = (s.char_at(i * 2) as Int) & 255
    b1<Int> = (s.char_at(i * 2 + 1) as Int) & 255
    u<Int> = b0 + b1 * 256
    sgn<Int> = (u >> 15) & 1
    e<Int> = (u >> 10) & 31
    m<Int> = u & 1023
    v<Float> = 0.0
    if (e == 0) {
        v = (m as Float) * 5.960464477539063e-08
    } else {
        v = 1.0 + (m as Float) / 1024.0
        k<Int> = 0
        while (k < e - 15) { v = v * 2.0 ; k = k + 1 }
        while (k < 15 - e) { v = v * 0.5 ; k = k + 1 }
    }
    if (sgn == 1) { return 0.0 - v }
    return v
}

zero_bytes(n<Int>)<String> -> {
    s<String> = ""
    k<Int> = 0
    while (k < n) { s = s + " " ; k = k + 1 }
    return s
}

find_from(s<String>, needle<String>, start<Int>)<Int> -> {
    n<Int> = s.len()
    m<Int> = needle.len()
    i<Int> = start
    while (i <= n - m) {
        ok<Bool> = true
        j<Int> = 0
        while (ok && j < m) {
            if (s.char_at(i + j) != needle.char_at(j)) { ok = false }
            j = j + 1
        }
        if (ok) { return i }
        i = i + 1
    }
    return -1
}
