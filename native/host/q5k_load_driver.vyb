// Q5_K dequant on REAL Qwen3.8-27B Ridge tensors (VybForge#10 phase 3).
//
// Reads the tensors named in native/out/q5k_ref.txt (written by native/tools/q5k_ref.py) so this
// driver and the reference cannot drift onto different tensors, loads the first SLICE_BLOCKS
// blocks of each straight from the GGUF, runs q5kdeq on the GPU and dumps the first 6 values.
//
// Unlike iq2sdeq this kernel needs no codebook, so the buffer is just the blocks — the four
// launcher arguments are enough (contrast the grid-prefix convention in native/kernels/iq2s.vyb,
// which exists because of Vyb#476).
// SKIPs (exit 0, printing SKIP) when CUDA or the model is absent.
import env::{env_get}
import io::{open_read, read_at, read_all, close}

extern "C" {
    cuInit(flags<CUInt>)<CInt>
    cuDeviceGetCount(count<loc<CInt>>)<CInt>
    cuDeviceGet(device<loc<CInt>>, ordinal<CInt>)<CInt>
    cuCtxCreate_v2(pctx<loc<loc<CVoid>>>, flags<CUInt>, dev<CInt>)<CInt>
    cuModuleLoadData(hmod<loc<loc<CVoid>>>, image<CString>)<CInt>
    cuModuleGetFunction(hfunc<loc<loc<CVoid>>>, hmod<loc<CVoid>>, name<CString>)<CInt>
    cuMemAlloc_v2(dptr<loc<Int>>, bytesize<Int>)<CInt>
    cuMemcpyHtoD_v2(dstDevice<Int>, srcHost<loc<CVoid>>, ByteCount<Int>)<CInt>
    cuMemcpyDtoH_v2(dstHost<loc<CVoid>>, srcDevice<Int>, ByteCount<Int>)<CInt>
    cuMemFree_v2(dptr<Int>)<CInt>
    cuCtxSynchronize()<CInt>
    cuda_launch4i(f<loc<CVoid>>, gridX<CUInt>, gridY<CUInt>, gridZ<CUInt>,
                  blockX<CUInt>, blockY<CUInt>, blockZ<CUInt>,
                  a0<Int>, a1<Int>, a2<Int>, a3<Int>)<CInt>
}

u8(s<String>, o<Int>)<Int> -> { return (s.char_at(o) as Int) & 255 }
strchr(s<String>, nd<Int>, st<Int>)<Int> -> {
    i<Int> = st
    for (i in st..s.len() - 1) { if ((s.char_at(i) as Int) == nd) { return i } }
    return -1
}
read_bin(path<String>)<String> -> {
    r<String> = ""
    match (open_read(path)) { f -> { match (read_all(f)) { s -> { r = s } ? -> { r = "" } } close(f) } ? -> { r = "" } }
    return r
}
read_model(path<String>, off<Int>, nbytes<Int>)<String> -> {
    r<String> = ""
    match (open_read(path)) { f -> { match (read_at(f, off, nbytes)) { s -> { r = s } ? -> { r = "" } } close(f) } ? -> { r = "" } }
    return r
}
// One call per buffer: `addr(String)` is the byte buffer itself (Vyb#476), so a whole tensor goes
// up in a single cuMemcpyHtoD instead of one 8-byte copy per element.
upload(data<String>, dst<Int>, nbytes<Int>)<Int> -> {
    freedom {
        if (cuMemcpyHtoD_v2(dst, from<loc<CVoid>>(addr(data)), nbytes) != 0) { return 15 }
        return 0
    }
    return 0
}
struct RefLine { nm<String>, off<Int> }
// "Q5_K <name>@<off> -> ..." -> the tensor name and its absolute file offset.
parse_ref(rows<String>)<Vec<RefLine>> -> {
    out<Vec<RefLine>> = Vec()
    ln<Int> = rows.len(); st<Int> = 0; i<Int> = 0
    for (i in 0..ln - 1) {
        if ((rows.char_at(i) as Int) == 10) {
            line<String> = rows.substring(st, i)
            if (line.len() > 5) {
                if (line.substring(0, 4) == "Q5_K") {
                    atp<Int> = strchr(line, 64, 0)        # '@'
                    arrow<Int> = strchr(line, 45, 0)      # '-'
                    if (atp > 0) {
                        if (arrow > atp) {
                            nm<String> = line.substring(5, atp)
                            os<Int> = 0
                            dg<Int> = atp + 1
                            while (dg < arrow) {
                                c<Int> = line.char_at(dg) as Int
                                if (c >= 48) { if (c <= 57) { os = os * 10 + (c - 48) } }
                                dg = dg + 1
                            }
                            out.push(RefLine { nm = nm, off = os })
                        }
                    }
                }
            }
            st = i + 1
        }
    }
    return out
}
dump_all(base<Int>, tag<String>, count<Int>)<Int> -> {
    freedom {
        iv<Int> = 0; acc<String> = ""; rj<Int> = 0
        for (rj in 0..count - 1) { iv = 0; cuMemcpyDtoH_v2(loc(iv), base + rj * 8, 8); acc = acc + iv.to_string() + " " }
        println("Q5_K " + tag + " -> " + acc)
    }
    return 0
}

main()<Int> -> {
    SLICE<Int> = 16                 # must match SLICE_BLOCKS in native/tools/q5k_ref.py
    BB<Int> = 176
    hm<String> = env_get("HOME") else "."
    MODEL<String> = env_get("VYBFORGE_RIDGE_GGUF") else hm + "/Models/qwen38-27b-ridge/Qwen3.8-27B-Ridge-3.7bpw.gguf"
    refs<Vec<RefLine>> = parse_ref(read_bin("native/out/q5k_ref.txt"))
    if (refs.len() == 0) { println("Q5_K_FAIL no reference lines (run native/tools/q5k_ref.py)"); return 4 }
    println("Q5_K_REFS=" + refs.len().to_string())

    freedom {
        if (cuInit(0) != 0) { println("SKIP"); return 0 }
        var<CInt> ndev = 0
        if (cuDeviceGetCount(loc(ndev)) != 0 || ndev < 1) { println("SKIP"); return 0 }
        var<CInt> dev = 0; if (cuDeviceGet(loc(dev), 0) != 0) { return 14 }
        ctx<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuCtxCreate_v2(loc(ctx), 0, dev) != 0) { return 14 }
    }
    freedom {
        m5<loc<CVoid>> = from<loc<CVoid>>(0)
        rc5<CInt> = -1; t5<Int> = 0
        for (t5 in 0..5) { if (rc5 != 0) { m5 = from<loc<CVoid>>(0); rc5 = cuModuleLoadData(loc(m5), read_bin("native/build/q5k.ptx")) } }
        if (rc5 != 0) { println("MODLOAD_FAIL q5k"); return 9 }
        fn5<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(fn5), m5, "q5kdeq") != 0) { return 10 }

        PK<Int> = 0; WA<Int> = 0
        if (cuMemAlloc_v2(loc(PK), SLICE * BB) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(WA), SLICE * 256 * 8) != 0) { return 11 }

        ri<Int> = 0
        for (ri in 0..refs.len() - 1) {
            nm<String> = refs.get(ri).nm
            pd<String> = read_model(MODEL, refs.get(ri).off, SLICE * BB)
            if (pd.len() < SLICE * BB) { println("Q5_K_SKIP_MODEL short read " + nm); return 0 }
            ee<Int> = upload(pd, PK, SLICE * BB)
            if (ee != 0) { return 66 }
            nl<Int> = SLICE * 256
            rc<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(fn5)), (nl + 255) / 256, 1, 1, 256, 1, 1, PK, WA, nl, 0)
            if (rc != 0) { println("LAUNCH_FAIL"); return 33 }
            cuCtxSynchronize()
            ct<Int> = 4096
            if (nl < ct) { ct = nl }
            dump_all(WA, nm, ct)
        }
        cuMemFree_v2(PK); cuMemFree_v2(WA)
        println("Q5_K_DRIVER_DONE")
        return 0
    }
    return 0
}
