// exl3mv — the FUSED decode+matvec (prototype) as its own module.
//
// The current path materialises W (2048x4096 f32 = 33.5 MB per projection) and
// then reads it back for the matvec: ~100 MB of traffic per expert for nothing.
// For decode (M=1) W is never reusable, so W should never exist. The EXL3
// composition is blockwise  W = H_left @ T @ H_right  (T = the raw decoded
// tile, H = the 128x128 Hadamard, with su per row and sv per column), hence
//     y = W x = H_left @ (T @ (H_right @ x)).
// So:  xp = sv . (H_right x)           one tiny pass over x       (exl3xhat)
//      yraw = T xp                    decode + dot, W never stored (exl3mv1s4)
//      y = H_left yraw                one tiny pass over y        (exl3yhat)
// Per projection that is the 4.2 MB packed read + tiny vector passes.
//
// Compile: --kernel-shared 40960 (32 KB tile slab + 4 KB reduction).

share(all) fp16_to_f64(b<Int>)<Float> -> {
    sb<Int> = (b >> 15) & 1
    eb<Int> = (b >> 10) & 31
    mb<Int> = b & 1023
    v<Float> = 0.0
    if (eb == 0) {
        # subnormal: mb * 2^-24 in ONE multiply (was a 24-step halving loop);
        # the product is exact, so the value is bit-identical
        v = (mb as Float) * 0.000000059604644775390625
    } else {
        if (eb == 31) {
            v = 65504.0
        } else {
            v = (1024 + mb) as Float
            e<Int> = eb - 25
            # 2^e exactly via binary exponentiation (<=5 squarings): every
            # intermediate is a power of two, so the result is bit-identical
            # to the old stepwise doubling/halving loops (<=24 iterations)
            k<Int> = e
            if (k < 0) { k = 0 - k }
            r<Float> = 1.0
            b2<Float> = 2.0
            while (k > 0) {
                if ((k - ((k >> 1) * 2)) == 1) { r = r * b2 }
                b2 = b2 * b2
                k = k >> 1
            }
            if (e < 0) {
                v = v / r
            } else {
                v = v * r
            }
        }
    }
    if (sb == 1) {
        v = 0.0 - v
    }
    return v
}

// p: +0 x(f32), +8 out(f32), +16 H(f32 128x128), +24 sv(f16), +32 cw
exl3xhat(p<Int>) -> {
    x<Int> = ld_i64(p + 0)
    o<Int> = ld_i64(p + 8)
    H<Int> = ld_i64(p + 16)
    SV<Int> = ld_i64(p + 24)
    cw<Int> = ld_i64(p + 32)
    nb<Int> = blk_x()
    d<Int> = tid_x()
    base<Int> = nb * 128
    # launch_kernel always runs 256 threads but H has only 128 rows: threads with
    # d >= 128 would index H[d*128+j] past the 64 KB Hadamard (and write past the
    # output). This was the bug initcheck found — out-of-bounds global reads.
    if (base < cw && d < 128) {
        # xp[i] = sum_k H[i][k] * (su[k] * x[k]): su is a DIAGONAL on the input
        # axis and does NOT commute with H, so it must scale x BEFORE the
        # transform (the same mistake as sv, which belongs AFTER exl3yhat).
        acc<Float32> = 0.0
        j<Int> = 0
        while (j < 128) {
            suj<Float32> = ld_f16(SV + (base + j) * 2) as Float32
            acc = acc + ld_f32n(H + (d * 128 + j) * 4) * ld_f32n(x + (base + j) * 4) * suj
            j = j + 1
        }
        st_f32(o + (base + d) * 4, acc)
    }
}

// p: +0 out(f32 yraw, cw rows), +8 xp(f32, cw cols), +16 su(f16 per row)
//    +24 cw, +32 yrow-base is implicit through blk
// The decode is exl3dq1s4's phase 1 verbatim (the oracle-verified nibble/slot
// walk into the shared slab); phase 2 replaces "apply H and store W" with
// "dot the row against xp" -> one f32 per row, accumulated with atomics.
exl3mv1s4(p<Int>) -> {
    # PRODUCTION fused decode matvec (promoted from mvnod4, round 58).
    # CAREFUL: this entry previously carried nine inert diagnostic branches
    # (DBG/SBD/CNT/CNT2/STB/ATGT/XD/ONLY/CONST) plus ten extra param slots, and
    # their presence corrupted the accumulation (0/2048 correct with them, 0
    # errors without). Do not add diagnostic branches to this entry — put
    # experiments in a SEPARATE fn and call it from a separate driver.
    tid<Int> = blk_x() * dim_x() + tid_x()
    cw<Int> = ld_i64(p + 24)
    nbc128<Int> = cw / 128
    nbc16<Int> = cw / 16
    block<Int> = tid / 2048
    rem<Int> = tid - block * 2048
    rb64<Int> = block / nbc128
    nb128<Int> = block - rb64 * nbc128
    q<Int> = ld_i64(p + 40)
    td<Int> = ld_i64(p + 48)
    T<Int> = ld_i64(p + 0)
    X<Int> = ld_i64(p + 8)
    inv<Int> = ld_i64(p + 56)
    LUT<Int> = ld_i64(p + 144)
    cta<Int> = rem / 256
    within<Int> = rem - cta * 256

    k<Int> = 0
    while (k < 4) {
        eK<Int> = within + k * 256
        bK<Int> = eK / 128
        cK<Int> = eK - bK * 128
        rowK<Int> = rb64 * 64 + cta * 8 + bK
        colK<Int> = nb128 * 128 + cK
        kb16K<Int> = rowK / 16
        r16K<Int> = rowK - kb16K * 16
        nb16K<Int> = colK / 16
        c16K<Int> = colK - nb16K * 16
        tile16K<Int> = kb16K * nbc16 + nb16K
        slotK<UInt32> = ld_u32(inv + (r16K * 16 + c16K) * 4)
        baseK<Int> = td + 16 + (slotK as Int) * 16
        w16K<Int> = 0
        iK<Int> = 0
        while (iK < 4) {
            nidxK<Int> = ld_u16(baseK + iK * 2) as Int
            ppK<Int> = (ld_i8(baseK + 8 + iK) as Int) & 255
            wbK<Int> = q + tile16K * 128 + (nidxK / 4) * 2 + (nidxK % 4) / 2
            byK<Int> = (ld_i8(wbK) as Int) & 255
            shK<Int> = ((nidxK % 4) % 2) * 4
            nibK<Int> = (byK >> shK) & 15
            w16K = w16K | (nibK << (ppK * 4))
            iK = iK + 1
        }
        prodK<Int> = (w16K * 3417055213) & 4294967295
        yK<Int> = (prodK & 2415890431) ^ 996162400
        loK<Float> = ld_f32n(LUT + (yK & 65535) * 4) as Float
        hiK<Float> = ld_f32n(LUT + ((yK >> 16) & 65535) * 4) as Float
        st_shared_f32(bK * 512 + cK * 4, (loK + hiK) as Float32)
        k = k + 1
    }

    inbase<Int> = rb64 * 64 + cta * 8
    kernel_barrier()

    if (within < 128) {
        d<Int> = within
        acc<Float32> = 0.0
        j<Int> = 0
        while (j < 8) {
            acc = acc + ld_shared_f32(j * 512 + d * 4) * ld_f32n(X + (inbase + j) * 4)
            j = j + 1
        }
        cb<Int> = nb128 * 128 + d
        if (cb < cw) { atomic_add_f32(T + cb * 4, acc) }
    }
}

// p: +0 yraw(f32, cw), +8 y(f32), +16 H(f32 128x128), +24 cw, +32 sv(f16, cw)
exl3yhat(p<Int>) -> {
    YR<Int> = ld_i64(p + 0)
    Y<Int> = ld_i64(p + 8)
    H<Int> = ld_i64(p + 16)
    cw<Int> = ld_i64(p + 24)
    SV<Int> = ld_i64(p + 32)
    nb<Int> = blk_x()
    a<Int> = tid_x()
    base<Int> = nb * 128
    if (base < cw && a < 128) {
        acc<Float32> = 0.0
        b<Int> = 0
        while (b < 128) {
            acc = acc + ld_f32n(H + (a * 128 + b) * 4) * ld_f32n(YR + (base + b) * 4)
            b = b + 1
        }
        svy<Float32> = ld_f16(SV + (base + a) * 2) as Float32
        st_f64(Y + (base + a) * 8, acc * svy)
    }
}

// exl3refu — the plainest reference matvec over the raw decode T:
//   u[n] = sv[n] * sum_{k < nin} T[k][n] * xp[k]
// Lives in THIS module deliberately: dbg_sh.ptx validated a kernel with the same
// body but cuModuleGetFunction refused it while siblings resolved, and every
// diagnostic depends on the load path. One thread per output, no tiling.
// p: +0 T(f32 [nin][cw]), +8 xp(f32 nin), +16 cw, +24 nin, +32 out(f32), +40 sv(f16)
exl3refu(p<Int>) -> {
    T<Int> = ld_i64(p + 0)
    X<Int> = ld_i64(p + 8)
    cw<Int> = ld_i64(p + 16)
    nin<Int> = ld_i64(p + 24)
    O<Int> = ld_i64(p + 32)
    SV<Int> = ld_i64(p + 40)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < cw) {
        acc<Float32> = 0.0
        k<Int> = 0
        while (k < nin) {
            acc = acc + ld_f32n(T + (k * cw + gid) * 4) * ld_f32n(X + k * 4)
            k = k + 1
        }
        svv<Float32> = ld_f16(SV + gid * 2) as Float32
        st_f32(O + gid * 4, acc * svv)
    }
}

// exl3refy — the plainest reference output transform:
//   y[n] = sum_{m in the 128-block of n} H[n%128][m%128] * u[m]
// p: +0 H(f32 128x128), +8 u(f32), +16 y(f32), +24 cw
exl3refy(p<Int>) -> {
    H<Int> = ld_i64(p + 0)
    U<Int> = ld_i64(p + 8)
    Y<Int> = ld_i64(p + 16)
    cw<Int> = ld_i64(p + 24)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < cw) {
        a<Int> = gid % 128
        base<Int> = gid - a
        acc<Float32> = 0.0
        m<Int> = 0
        while (m < 128) {
            acc = acc + ld_f32n(H + (m * 128 + a) * 4) * ld_f32n(U + (base + m) * 4)
            m = m + 1
        }
        st_f32(Y + gid * 4, acc)
    }
}

// ============================================================================
// BISECT ENTRY: mvnod — exl3mv1s4 with the DECODE CODE REMOVED ENTIRELY.
// Same geometry, same phase-2 dot, same atomic, but phase 1 is a bare constant
// store (no inv map, no shift/xor, no fp16_to_f64, no if/else).
// If this returns 0.5*sum(xp) per output, the defect lives in the decode body.
// p: identical layout to exl3mv1s4 (+0 T, +8 X, +24 cw).
// ============================================================================
mvnod(p<Int>) -> {
    tid<Int> = blk_x() * dim_x() + tid_x()
    cw<Int> = ld_i64(p + 24)
    nbc128<Int> = cw / 128
    block<Int> = tid / 2048
    rem<Int> = tid - block * 2048
    rb64<Int> = block / nbc128
    nb128<Int> = block - rb64 * nbc128
    T<Int> = ld_i64(p + 0)
    X<Int> = ld_i64(p + 8)
    cta<Int> = rem / 256
    within<Int> = rem - cta * 256

    k<Int> = 0
    while (k < 4) {
        eK<Int> = within + k * 256
        bK<Int> = eK / 128
        cK<Int> = eK - bK * 128
        st_shared_f32(bK * 512 + cK * 4, 0.5)
        k = k + 1
    }

    inbase<Int> = rb64 * 64 + cta * 8
    kernel_barrier()

    if (within < 128) {
        d<Int> = within
        acc<Float32> = 0.0
        j<Int> = 0
        while (j < 8) {
            acc = acc + ld_shared_f32(j * 512 + d * 4) * ld_f32n(X + (inbase + j) * 4)
            j = j + 1
        }
        cb<Int> = nb128 * 128 + d
        if (cb < cw) { atomic_add_f32(T + cb * 4, acc) }
    }
}

// ============================================================================
// BISECT STEP 2: mvnod2 — the FULL decode body (inv map, nibble walk, shift/xor)
// but WITHOUT the fp16_to_f64 device calls: the slab value is a constant.
// If this is correct, the fp16_to_f64 CALL is what corrupts the kernel.
// ============================================================================
mvnod2(p<Int>) -> {
    tid<Int> = blk_x() * dim_x() + tid_x()
    cw<Int> = ld_i64(p + 24)
    nbc128<Int> = cw / 128
    nbc16<Int> = cw / 16
    block<Int> = tid / 2048
    rem<Int> = tid - block * 2048
    rb64<Int> = block / nbc128
    nb128<Int> = block - rb64 * nbc128
    q<Int> = ld_i64(p + 40)
    td<Int> = ld_i64(p + 48)
    T<Int> = ld_i64(p + 0)
    X<Int> = ld_i64(p + 8)
    inv<Int> = ld_i64(p + 56)
    cta<Int> = rem / 256
    within<Int> = rem - cta * 256

    k<Int> = 0
    while (k < 4) {
        eK<Int> = within + k * 256
        bK<Int> = eK / 128
        cK<Int> = eK - bK * 128
        rowK<Int> = rb64 * 64 + cta * 8 + bK
        colK<Int> = nb128 * 128 + cK
        kb16K<Int> = rowK / 16
        r16K<Int> = rowK - kb16K * 16
        nb16K<Int> = colK / 16
        c16K<Int> = colK - nb16K * 16
        tile16K<Int> = kb16K * nbc16 + nb16K
        slotK<UInt32> = ld_u32(inv + (r16K * 16 + c16K) * 4)
        baseK<Int> = td + 16 + (slotK as Int) * 16
        w16K<Int> = 0
        iK<Int> = 0
        while (iK < 4) {
            nidxK<Int> = ld_u16(baseK + iK * 2) as Int
            ppK<Int> = (ld_i8(baseK + 8 + iK) as Int) & 255
            wbK<Int> = q + tile16K * 128 + (nidxK / 4) * 2 + (nidxK % 4) / 2
            byK<Int> = (ld_i8(wbK) as Int) & 255
            shK<Int> = ((nidxK % 4) % 2) * 4
            nibK<Int> = (byK >> shK) & 15
            w16K = w16K | (nibK << (ppK * 4))
            iK = iK + 1
        }
        prodK<Int> = (w16K * 3417055213) & 4294967295
        yK<Int> = (prodK & 2415890431) ^ 996162400
        ysum<Int> = (yK & 65535) + ((yK >> 16) & 65535)
        st_shared_f32(bK * 512 + cK * 4, 0.5)
        k = k + 1
    }

    inbase<Int> = rb64 * 64 + cta * 8
    kernel_barrier()

    if (within < 128) {
        d<Int> = within
        acc<Float32> = 0.0
        j<Int> = 0
        while (j < 8) {
            acc = acc + ld_shared_f32(j * 512 + d * 4) * ld_f32n(X + (inbase + j) * 4)
            j = j + 1
        }
        cb<Int> = nb128 * 128 + d
        if (cb < cw) { atomic_add_f32(T + cb * 4, acc) }
    }
}

// ============================================================================
// f16lut — fill a 65536-entry f32 table with the half->float conversion.
// This REPLACES the fp16_to_f64 device calls in the decode loop: calling that
// function twice per element inside the big kernel corrupts state (bisected in
// rounds 55-57), while a standalone kernel that calls it is bit-exact (that is
// exactly what exl3dq1s4 does). Built once per process, then indexed.
// p: +0 lut(f32, 65536)
// ============================================================================
f16lut(p<Int>) -> {
    LUT<Int> = ld_i64(p + 0)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < 65536) {
        st_f32(LUT + gid * 4, fp16_to_f64(gid) as Float32)
    }
}

// ============================================================================
// BISECT STEP 3: mvnod3 — the FULL decode chain, kept LIVE by writing yK to a
// scratch buffer, while the SLAB still receives a constant 0.5.
//   - sum == 0.5*sum(xp)  => the chain is harmless; the bug is in the VALUE
//                            that reaches the slab (LUT / lo+hi path)
//   - sum != 0.5*sum(xp)  => the chain's PRESENCE alone breaks the accumulation
// p: identical to exl3mv1s4, +152 scratch(f32)
// ============================================================================
mvnod3(p<Int>) -> {
    tid<Int> = blk_x() * dim_x() + tid_x()
    cw<Int> = ld_i64(p + 24)
    nbc128<Int> = cw / 128
    nbc16<Int> = cw / 16
    block<Int> = tid / 2048
    rem<Int> = tid - block * 2048
    rb64<Int> = block / nbc128
    nb128<Int> = block - rb64 * nbc128
    q<Int> = ld_i64(p + 40)
    td<Int> = ld_i64(p + 48)
    T<Int> = ld_i64(p + 0)
    X<Int> = ld_i64(p + 8)
    inv<Int> = ld_i64(p + 56)
    SCR<Int> = ld_i64(p + 152)
    cta<Int> = rem / 256
    within<Int> = rem - cta * 256

    k<Int> = 0
    while (k < 4) {
        eK<Int> = within + k * 256
        bK<Int> = eK / 128
        cK<Int> = eK - bK * 128
        rowK<Int> = rb64 * 64 + cta * 8 + bK
        colK<Int> = nb128 * 128 + cK
        kb16K<Int> = rowK / 16
        r16K<Int> = rowK - kb16K * 16
        nb16K<Int> = colK / 16
        c16K<Int> = colK - nb16K * 16
        tile16K<Int> = kb16K * nbc16 + nb16K
        slotK<UInt32> = ld_u32(inv + (r16K * 16 + c16K) * 4)
        baseK<Int> = td + 16 + (slotK as Int) * 16
        w16K<Int> = 0
        iK<Int> = 0
        while (iK < 4) {
            nidxK<Int> = ld_u16(baseK + iK * 2) as Int
            ppK<Int> = (ld_i8(baseK + 8 + iK) as Int) & 255
            wbK<Int> = q + tile16K * 128 + (nidxK / 4) * 2 + (nidxK % 4) / 2
            byK<Int> = (ld_i8(wbK) as Int) & 255
            shK<Int> = ((nidxK % 4) % 2) * 4
            nibK<Int> = (byK >> shK) & 15
            w16K = w16K | (nibK << (ppK * 4))
            iK = iK + 1
        }
        prodK<Int> = (w16K * 3417055213) & 4294967295
        yK<Int> = (prodK & 2415890431) ^ 996162400
        # keep the chain LIVE: the value must be observable or the compiler drops it
        if (SCR != 0) { st_f32(SCR + (block - (block / 64) * 64) * 4, yK as Float32) }
        st_shared_f32(bK * 512 + cK * 4, 0.5)
        k = k + 1
    }

    inbase<Int> = rb64 * 64 + cta * 8
    kernel_barrier()

    if (within < 128) {
        d<Int> = within
        acc<Float32> = 0.0
        j<Int> = 0
        while (j < 8) {
            acc = acc + ld_shared_f32(j * 512 + d * 4) * ld_f32n(X + (inbase + j) * 4)
            j = j + 1
        }
        cb<Int> = nb128 * 128 + d
        if (cb < cw) { atomic_add_f32(T + cb * 4, acc) }
    }
}

// ============================================================================
// BISECT STEP 4: mvnod4 — mvnod3 + the REAL slab value (LUT). If this fails,
// the defect is localised to ~10 lines: the store of a value loaded from the
// LUT, in an otherwise-proven-minimal kernel.
// p: identical to mvnod3, +144 lut(f32 65536)
// ============================================================================
mvnod4(p<Int>) -> {
    tid<Int> = blk_x() * dim_x() + tid_x()
    cw<Int> = ld_i64(p + 24)
    nbc128<Int> = cw / 128
    nbc16<Int> = cw / 16
    block<Int> = tid / 2048
    rem<Int> = tid - block * 2048
    rb64<Int> = block / nbc128
    nb128<Int> = block - rb64 * nbc128
    q<Int> = ld_i64(p + 40)
    td<Int> = ld_i64(p + 48)
    T<Int> = ld_i64(p + 0)
    X<Int> = ld_i64(p + 8)
    inv<Int> = ld_i64(p + 56)
    LUT<Int> = ld_i64(p + 144)
    cta<Int> = rem / 256
    within<Int> = rem - cta * 256

    k<Int> = 0
    while (k < 4) {
        eK<Int> = within + k * 256
        bK<Int> = eK / 128
        cK<Int> = eK - bK * 128
        rowK<Int> = rb64 * 64 + cta * 8 + bK
        colK<Int> = nb128 * 128 + cK
        kb16K<Int> = rowK / 16
        r16K<Int> = rowK - kb16K * 16
        nb16K<Int> = colK / 16
        c16K<Int> = colK - nb16K * 16
        tile16K<Int> = kb16K * nbc16 + nb16K
        slotK<UInt32> = ld_u32(inv + (r16K * 16 + c16K) * 4)
        baseK<Int> = td + 16 + (slotK as Int) * 16
        w16K<Int> = 0
        iK<Int> = 0
        while (iK < 4) {
            nidxK<Int> = ld_u16(baseK + iK * 2) as Int
            ppK<Int> = (ld_i8(baseK + 8 + iK) as Int) & 255
            wbK<Int> = q + tile16K * 128 + (nidxK / 4) * 2 + (nidxK % 4) / 2
            byK<Int> = (ld_i8(wbK) as Int) & 255
            shK<Int> = ((nidxK % 4) % 2) * 4
            nibK<Int> = (byK >> shK) & 15
            w16K = w16K | (nibK << (ppK * 4))
            iK = iK + 1
        }
        prodK<Int> = (w16K * 3417055213) & 4294967295
        yK<Int> = (prodK & 2415890431) ^ 996162400
        loK<Float> = ld_f32n(LUT + (yK & 65535) * 4) as Float
        hiK<Float> = ld_f32n(LUT + ((yK >> 16) & 65535) * 4) as Float
        st_shared_f32(bK * 512 + cK * 4, (loK + hiK) as Float32)
        k = k + 1
    }

    inbase<Int> = rb64 * 64 + cta * 8
    kernel_barrier()

    if (within < 128) {
        d<Int> = within
        acc<Float32> = 0.0
        j<Int> = 0
        while (j < 8) {
            acc = acc + ld_shared_f32(j * 512 + d * 4) * ld_f32n(X + (inbase + j) * 4)
            j = j + 1
        }
        cb<Int> = nb128 * 128 + d
        if (cb < cw) { atomic_add_f32(T + cb * 4, acc) }
    }
}

// ============================================================================
// mvnod5 — GATHER-COST SPIKE. Identical to mvnod4 except the four nibble
// gathers use a CONSTANT index (nidx := 0, pp := iK) instead of the per-element
// slot header. Everything else (LUT, mixing, slab, dot, atomics) is identical,
// so the timing difference between mvnod4 and mvnod5 is EXACTLY the cost of the
// gather addressing — which is what an offline re-pack would have to buy back.
// p: identical to mvnod4 (+0 T, +8 X, +24 cw, +40 q, +48 td, +56 inv, +144 LUT)
// ============================================================================
mvnod5(p<Int>) -> {
    tid<Int> = blk_x() * dim_x() + tid_x()
    cw<Int> = ld_i64(p + 24)
    nbc128<Int> = cw / 128
    nbc16<Int> = cw / 16
    block<Int> = tid / 2048
    rem<Int> = tid - block * 2048
    rb64<Int> = block / nbc128
    nb128<Int> = block - rb64 * nbc128
    q<Int> = ld_i64(p + 40)
    td<Int> = ld_i64(p + 48)
    T<Int> = ld_i64(p + 0)
    X<Int> = ld_i64(p + 8)
    inv<Int> = ld_i64(p + 56)
    LUT<Int> = ld_i64(p + 144)
    cta<Int> = rem / 256
    within<Int> = rem - cta * 256

    k<Int> = 0
    while (k < 4) {
        eK<Int> = within + k * 256
        bK<Int> = eK / 128
        cK<Int> = eK - bK * 128
        rowK<Int> = rb64 * 64 + cta * 8 + bK
        colK<Int> = nb128 * 128 + cK
        kb16K<Int> = rowK / 16
        r16K<Int> = rowK - kb16K * 16
        nb16K<Int> = colK / 16
        c16K<Int> = colK - nb16K * 16
        tile16K<Int> = kb16K * nbc16 + nb16K
        slotK<UInt32> = ld_u32(inv + (r16K * 16 + c16K) * 4)
        baseK<Int> = td + 16 + (slotK as Int) * 16
        w16K<Int> = 0
        iK<Int> = 0
        while (iK < 4) {
            # the gather is replaced by a fixed pattern: same volume of loads,
            # same LUT and mixing work, NO per-element address computation
            wbK<Int> = q + tile16K * 128 + iK
            byK<Int> = (ld_i8(wbK) as Int) & 255
            shK<Int> = (iK % 2) * 4
            nibK<Int> = (byK >> shK) & 15
            w16K = w16K | (nibK << ((iK + 1) * 4))
            iK = iK + 1
        }
        prodK<Int> = (w16K * 3417055213) & 4294967295
        yK<Int> = (prodK & 2415890431) ^ 996162400
        loK<Float> = ld_f32n(LUT + (yK & 65535) * 4) as Float
        hiK<Float> = ld_f32n(LUT + ((yK >> 16) & 65535) * 4) as Float
        st_shared_f32(bK * 512 + cK * 4, (loK + hiK) as Float32)
        k = k + 1
    }

    inbase<Int> = rb64 * 64 + cta * 8
    kernel_barrier()

    if (within < 128) {
        d<Int> = within
        acc<Float32> = 0.0
        j<Int> = 0
        while (j < 8) {
            acc = acc + ld_shared_f32(j * 512 + d * 4) * ld_f32n(X + (inbase + j) * 4)
            j = j + 1
        }
        cb<Int> = nb128 * 128 + d
        if (cb < cw) { atomic_add_f32(T + cb * 4, acc) }
    }
}

// ============================================================================
// mvnodB — BATCHED fused decode matvec. Identical decode to mvnod4 (the slab is
// built ONCE from the packed weights), then B dots reuse that slab. This is the
// weight amortisation that makes the throughput number comparable to a batched
// server: the 4.2 MB of packed weights is read once per B tokens, not per token.
// p: +0 T  (f32 [B][cw] output), +8 X (f32 [B][nin] input),
//    +24 cw, +40 q, +48 td, +56 inv, +144 LUT, +168 B
// ============================================================================
mvnodB(p<Int>) -> {
    tid<Int> = blk_x() * dim_x() + tid_x()
    cw<Int> = ld_i64(p + 24)
    nbc128<Int> = cw / 128
    nbc16<Int> = cw / 16
    block<Int> = tid / 2048
    rem<Int> = tid - block * 2048
    rb64<Int> = block / nbc128
    nb128<Int> = block - rb64 * nbc128
    q<Int> = ld_i64(p + 40)
    td<Int> = ld_i64(p + 48)
    T<Int> = ld_i64(p + 0)
    X<Int> = ld_i64(p + 8)
    inv<Int> = ld_i64(p + 56)
    LUT<Int> = ld_i64(p + 144)
    B<Int> = ld_i64(p + 168)
    nin<Int> = ld_i64(p + 176)
    cta<Int> = rem / 256
    within<Int> = rem - cta * 256

    # ---- decode the packed weights ONCE ----
    k<Int> = 0
    while (k < 4) {
        eK<Int> = within + k * 256
        bK<Int> = eK / 128
        cK<Int> = eK - bK * 128
        rowK<Int> = rb64 * 64 + cta * 8 + bK
        colK<Int> = nb128 * 128 + cK
        kb16K<Int> = rowK / 16
        r16K<Int> = rowK - kb16K * 16
        nb16K<Int> = colK / 16
        c16K<Int> = colK - nb16K * 16
        tile16K<Int> = kb16K * nbc16 + nb16K
        slotK<UInt32> = ld_u32(inv + (r16K * 16 + c16K) * 4)
        baseK<Int> = td + 16 + (slotK as Int) * 16
        w16K<Int> = 0
        iK<Int> = 0
        while (iK < 4) {
            nidxK<Int> = ld_u16(baseK + iK * 2) as Int
            ppK<Int> = (ld_i8(baseK + 8 + iK) as Int) & 255
            wbK<Int> = q + tile16K * 128 + (nidxK / 4) * 2 + (nidxK % 4) / 2
            byK<Int> = (ld_i8(wbK) as Int) & 255
            shK<Int> = ((nidxK % 4) % 2) * 4
            nibK<Int> = (byK >> shK) & 15
            w16K = w16K | (nibK << (ppK * 4))
            iK = iK + 1
        }
        prodK<Int> = (w16K * 3417055213) & 4294967295
        yK<Int> = (prodK & 2415890431) ^ 996162400
        loK<Float> = ld_f32n(LUT + (yK & 65535) * 4) as Float
        hiK<Float> = ld_f32n(LUT + ((yK >> 16) & 65535) * 4) as Float
        st_shared_f32(bK * 512 + cK * 4, (loK + hiK) as Float32)
        k = k + 1
    }

    inbase<Int> = rb64 * 64 + cta * 8
    kernel_barrier()

    # ---- B dots over the SAME slab: the weights are not re-read ----
    if (within < 128) {
        d<Int> = within
        cb<Int> = nb128 * 128 + d
        b2<Int> = 0
        while (b2 < B) {
            xb<Int> = X + b2 * nin * 4
            acc<Float32> = 0.0
            j<Int> = 0
            while (j < 8) {
                acc = acc + ld_shared_f32(j * 512 + d * 4) * ld_f32n(xb + (inbase + j) * 4)
                j = j + 1
            }
            if (cb < cw) { atomic_add_f32(T + (b2 * cw + cb) * 4, acc) }
            b2 = b2 + 1
        }
    }
}

mvnodB4(p<Int>) -> {
    tid<Int> = blk_x() * dim_x() + tid_x()
    cw<Int> = ld_i64(p + 24)
    nbc128<Int> = cw / 128
    nbc16<Int> = cw / 16
    block<Int> = tid / 2048
    rem<Int> = tid - block * 2048
    rb64<Int> = block / nbc128
    nb128<Int> = block - rb64 * nbc128
    q<Int> = ld_i64(p + 40)
    td<Int> = ld_i64(p + 48)
    T<Int> = ld_i64(p + 0)
    X<Int> = ld_i64(p + 8)
    inv<Int> = ld_i64(p + 56)
    LUT<Int> = ld_i64(p + 144)
    B<Int> = ld_i64(p + 168)
    nin<Int> = ld_i64(p + 176)
    cta<Int> = rem / 256
    within<Int> = rem - cta * 256

    # ---- decode the packed weights ONCE ----
    k<Int> = 0
    while (k < 4) {
        eK<Int> = within + k * 256
        bK<Int> = eK / 128
        cK<Int> = eK - bK * 128
        rowK<Int> = rb64 * 64 + cta * 8 + bK
        colK<Int> = nb128 * 128 + cK
        kb16K<Int> = rowK / 16
        r16K<Int> = rowK - kb16K * 16
        nb16K<Int> = colK / 16
        c16K<Int> = colK - nb16K * 16
        tile16K<Int> = kb16K * nbc16 + nb16K
        slotK<UInt32> = ld_u32(inv + (r16K * 16 + c16K) * 4)
        baseK<Int> = td + 16 + (slotK as Int) * 16
        w16K<Int> = 0
        iK<Int> = 0
        while (iK < 4) {
            nidxK<Int> = ld_u16(baseK + iK * 2) as Int
            ppK<Int> = (ld_i8(baseK + 8 + iK) as Int) & 255
            wbK<Int> = q + tile16K * 128 + (nidxK / 4) * 2 + (nidxK % 4) / 2
            byK<Int> = (ld_i8(wbK) as Int) & 255
            shK<Int> = ((nidxK % 4) % 2) * 4
            nibK<Int> = (byK >> shK) & 15
            w16K = w16K | (nibK << (ppK * 4))
            iK = iK + 1
        }
        prodK<Int> = (w16K * 3417055213) & 4294967295
        yK<Int> = (prodK & 2415890431) ^ 996162400
        loK<Float> = ld_f32n(LUT + (yK & 65535) * 4) as Float
        hiK<Float> = ld_f32n(LUT + ((yK >> 16) & 65535) * 4) as Float
        st_shared_f32(bK * 512 + cK * 4, (loK + hiK) as Float32)
        k = k + 1
    }

    inbase<Int> = rb64 * 64 + cta * 8
    kernel_barrier()

    # ---- B dots over the SAME slab: the weights are not re-read ----
    # ILP: 4 output columns per thread. The four accumulators are independent, and
    # the X element for a given j is loaded ONCE and reused by all four (mvnodB
    # reloads it for every column).
    if (within < 32) {
        d0<Int> = within * 4
        cb0<Int> = nb128 * 128 + d0
        b2<Int> = 0
        while (b2 < B) {
            xb<Int> = X + b2 * nin * 4
            acc0<Float32> = 0.0
            acc1<Float32> = 0.0
            acc2<Float32> = 0.0
            acc3<Float32> = 0.0
            j<Int> = 0
            while (j < 8) {
                xv<Float32> = ld_f32n(xb + (inbase + j) * 4)
                base<Int> = j * 512 + d0 * 4
                acc0 = acc0 + ld_shared_f32(base) * xv
                acc1 = acc1 + ld_shared_f32(base + 4) * xv
                acc2 = acc2 + ld_shared_f32(base + 8) * xv
                acc3 = acc3 + ld_shared_f32(base + 12) * xv
                j = j + 1
            }
            if (cb0 < cw) { atomic_add_f32(T + (b2 * cw + cb0) * 4, acc0) }
            if (cb0 + 1 < cw) { atomic_add_f32(T + (b2 * cw + cb0 + 1) * 4, acc1) }
            if (cb0 + 2 < cw) { atomic_add_f32(T + (b2 * cw + cb0 + 2) * 4, acc2) }
            if (cb0 + 3 < cw) { atomic_add_f32(T + (b2 * cw + cb0 + 3) * 4, acc3) }
            b2 = b2 + 1
        }
    }
}

mvnodB_st(p<Int>) -> {  // TIMING ONLY: plain store instead of the atomic (numerically WRONG: k-split races)
    tid<Int> = blk_x() * dim_x() + tid_x()
    cw<Int> = ld_i64(p + 24)
    nbc128<Int> = cw / 128
    nbc16<Int> = cw / 16
    block<Int> = tid / 2048
    rem<Int> = tid - block * 2048
    rb64<Int> = block / nbc128
    nb128<Int> = block - rb64 * nbc128
    q<Int> = ld_i64(p + 40)
    td<Int> = ld_i64(p + 48)
    T<Int> = ld_i64(p + 0)
    X<Int> = ld_i64(p + 8)
    inv<Int> = ld_i64(p + 56)
    LUT<Int> = ld_i64(p + 144)
    B<Int> = ld_i64(p + 168)
    nin<Int> = ld_i64(p + 176)
    cta<Int> = rem / 256
    within<Int> = rem - cta * 256

    # ---- decode the packed weights ONCE ----
    k<Int> = 0
    while (k < 4) {
        eK<Int> = within + k * 256
        bK<Int> = eK / 128
        cK<Int> = eK - bK * 128
        rowK<Int> = rb64 * 64 + cta * 8 + bK
        colK<Int> = nb128 * 128 + cK
        kb16K<Int> = rowK / 16
        r16K<Int> = rowK - kb16K * 16
        nb16K<Int> = colK / 16
        c16K<Int> = colK - nb16K * 16
        tile16K<Int> = kb16K * nbc16 + nb16K
        slotK<UInt32> = ld_u32(inv + (r16K * 16 + c16K) * 4)
        baseK<Int> = td + 16 + (slotK as Int) * 16
        w16K<Int> = 0
        iK<Int> = 0
        while (iK < 4) {
            nidxK<Int> = ld_u16(baseK + iK * 2) as Int
            ppK<Int> = (ld_i8(baseK + 8 + iK) as Int) & 255
            wbK<Int> = q + tile16K * 128 + (nidxK / 4) * 2 + (nidxK % 4) / 2
            byK<Int> = (ld_i8(wbK) as Int) & 255
            shK<Int> = ((nidxK % 4) % 2) * 4
            nibK<Int> = (byK >> shK) & 15
            w16K = w16K | (nibK << (ppK * 4))
            iK = iK + 1
        }
        prodK<Int> = (w16K * 3417055213) & 4294967295
        yK<Int> = (prodK & 2415890431) ^ 996162400
        loK<Float> = ld_f32n(LUT + (yK & 65535) * 4) as Float
        hiK<Float> = ld_f32n(LUT + ((yK >> 16) & 65535) * 4) as Float
        st_shared_f32(bK * 512 + cK * 4, (loK + hiK) as Float32)
        k = k + 1
    }

    inbase<Int> = rb64 * 64 + cta * 8
    kernel_barrier()

    # ---- B dots over the SAME slab: the weights are not re-read ----
    # ILP: 4 output columns per thread. The four accumulators are independent, and
    # the X element for a given j is loaded ONCE and reused by all four (mvnodB
    # reloads it for every column).
    if (within < 32) {
        d0<Int> = within * 4
        cb0<Int> = nb128 * 128 + d0
        b2<Int> = 0
        while (b2 < B) {
            xb<Int> = X + b2 * nin * 4
            acc0<Float32> = 0.0
            acc1<Float32> = 0.0
            acc2<Float32> = 0.0
            acc3<Float32> = 0.0
            j<Int> = 0
            while (j < 8) {
                xv<Float32> = ld_f32n(xb + (inbase + j) * 4)
                base<Int> = j * 512 + d0 * 4
                acc0 = acc0 + ld_shared_f32(base) * xv
                acc1 = acc1 + ld_shared_f32(base + 4) * xv
                acc2 = acc2 + ld_shared_f32(base + 8) * xv
                acc3 = acc3 + ld_shared_f32(base + 12) * xv
                j = j + 1
            }
            if (cb0 < cw) { st_f32(T + (b2 * cw + cb0) * 4, acc0) }
            if (cb0 + 1 < cw) { st_f32(T + (b2 * cw + cb0 + 1) * 4, acc1) }
            if (cb0 + 2 < cw) { st_f32(T + (b2 * cw + cb0 + 2) * 4, acc2) }
            if (cb0 + 3 < cw) { st_f32(T + (b2 * cw + cb0 + 3) * 4, acc3) }
            b2 = b2 + 1
        }
    }
}

// mvnodB — BATCHED fused decode matvec. Identical decode to mvnod4 (the slab is
// built ONCE from the packed weights), then B dots reuse that slab. This is the
// weight amortisation that makes the throughput number comparable to a batched
// server: the 4.2 MB of packed weights is read once per B tokens, not per token.
// p: +0 T  (f32 [B][cw] output), +8 X (f32 [B][nin] input),
//    +24 cw, +40 q, +48 td, +56 inv, +144 LUT, +168 B
// ============================================================================
mvnodB_det(p<Int>) -> {
    tid<Int> = blk_x() * dim_x() + tid_x()
    cw<Int> = ld_i64(p + 24)
    nbc128<Int> = cw / 128
    nbc16<Int> = cw / 16
    block<Int> = tid / 2048
    rem<Int> = tid - block * 2048
    rb64<Int> = block / nbc128
    nb128<Int> = block - rb64 * nbc128
    q<Int> = ld_i64(p + 40)
    td<Int> = ld_i64(p + 48)
    T<Int> = ld_i64(p + 0)
    X<Int> = ld_i64(p + 8)
    inv<Int> = ld_i64(p + 56)
    LUT<Int> = ld_i64(p + 144)
    B<Int> = ld_i64(p + 168)
    nin<Int> = ld_i64(p + 176)
    cta<Int> = rem / 256
    within<Int> = rem - cta * 256

    # ---- decode the packed weights ONCE ----
    k<Int> = 0
    while (k < 4) {
        eK<Int> = within + k * 256
        bK<Int> = eK / 128
        cK<Int> = eK - bK * 128
        rowK<Int> = rb64 * 64 + cta * 8 + bK
        colK<Int> = nb128 * 128 + cK
        kb16K<Int> = rowK / 16
        r16K<Int> = rowK - kb16K * 16
        nb16K<Int> = colK / 16
        c16K<Int> = colK - nb16K * 16
        tile16K<Int> = kb16K * nbc16 + nb16K
        slotK<UInt32> = ld_u32(inv + (r16K * 16 + c16K) * 4)
        baseK<Int> = td + 16 + (slotK as Int) * 16
        w16K<Int> = 0
        iK<Int> = 0
        while (iK < 4) {
            nidxK<Int> = ld_u16(baseK + iK * 2) as Int
            ppK<Int> = (ld_i8(baseK + 8 + iK) as Int) & 255
            wbK<Int> = q + tile16K * 128 + (nidxK / 4) * 2 + (nidxK % 4) / 2
            byK<Int> = (ld_i8(wbK) as Int) & 255
            shK<Int> = ((nidxK % 4) % 2) * 4
            nibK<Int> = (byK >> shK) & 15
            w16K = w16K | (nibK << (ppK * 4))
            iK = iK + 1
        }
        prodK<Int> = (w16K * 3417055213) & 4294967295
        yK<Int> = (prodK & 2415890431) ^ 996162400
        loK<Float> = ld_f32n(LUT + (yK & 65535) * 4) as Float
        hiK<Float> = ld_f32n(LUT + ((yK >> 16) & 65535) * 4) as Float
        st_shared_f32(bK * 512 + cK * 4, (loK + hiK) as Float32)
        k = k + 1
    }

    inbase<Int> = rb64 * 64 + cta * 8
    kernel_barrier()

    # ---- B dots over the SAME slab: the weights are not re-read ----
    if (within < 128) {
        d<Int> = within
        cb<Int> = nb128 * 128 + d
        b2<Int> = 0
        while (b2 < B) {
            xb<Int> = X + b2 * nin * 4
            acc<Float32> = 0.0
            j<Int> = 0
            while (j < 8) {
                acc = acc + ld_shared_f32(j * 512 + d * 4) * ld_f32n(xb + (inbase + j) * 4)
                j = j + 1
            }
            # DETERMINISTIC: write this CTA's partial instead of an atomic add. The 8 k-split
            # CTAs each own one slot, so every value is written exactly once and mvnodR sums
            # them in a fixed order -- bit-identical across runs.
            P<Int> = ld_i64(p + 184)
            if (cb < cw) { st_f32(P + ((cta * B + b2) * cw + cb) * 4, acc) }
            b2 = b2 + 1
        }
    }
}

// zfill — zero n f32 slots (the partial buffer must start at zero: mvnodB_det only writes the
// slots its grid covers, and mvnodR sums all NS of them).
// p: +0 D, +8 n
zfill(p<Int>) -> {
    D<Int> = ld_i64(p + 0)
    N<Int> = ld_i64(p + 8)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < N) { st_f32(D + gid * 4, 0.0) }
}

// mvnodR — reduce the 8 per-CTA partials written by mvnodB_det into T, in FIXED order.
// This is what makes the fused matvec reproducible: float addition is not associative, so the
// atomic-add version depends on thread scheduling; summing 0..7 sequentially does not.
// p: +0 T, +8 P, +16 B, +24 cw, +32 NS (number of splits, 8)
mvnodR(p<Int>) -> {
    T<Int> = ld_i64(p + 0)
    P<Int> = ld_i64(p + 8)
    B<Int> = ld_i64(p + 16)
    cw<Int> = ld_i64(p + 24)
    NS<Int> = ld_i64(p + 32)
    gid<Int> = blk_x() * dim_x() + tid_x()
    total<Int> = B * cw
    if (gid < total) {
        s<Float32> = 0.0
        kk<Int> = 0
        while (kk < NS) {
            s = s + ld_f32(P + (kk * total + gid) * 4)
            kk = kk + 1
        }
        st_f32(T + gid * 4, s)
    }
}
// ============================================================================
// xhatB / yhatB — BATCHED Hadamard passes. The single-token versions are one
// launch PER TOKEN, which measured as pure launch overhead (0.03125 ms each =
// 77% of per-token work at B=32). These cover all B tokens in ONE launch: the
// grid is B * (blocks per token).
// xhatB p: +0 x(f32 [B][nin]), +8 out(f32 [B][nin]), +16 H, +24 su(f16),
//          +32 nin, +40 B
// ============================================================================
xhatB(p<Int>) -> {
    x<Int> = ld_i64(p + 0)
    o<Int> = ld_i64(p + 8)
    H<Int> = ld_i64(p + 16)
    SV<Int> = ld_i64(p + 24)
    nin<Int> = ld_i64(p + 32)
    B<Int> = ld_i64(p + 40)
    nbpt<Int> = nin / 128
    gid<Int> = blk_x()
    tok<Int> = gid / nbpt
    blk<Int> = gid - tok * nbpt
    d<Int> = tid_x()
    base<Int> = blk * 128
    if (tok < B && base < nin && d < 128) {
        xo<Int> = x + tok * nin * 4
        oo<Int> = o + tok * nin * 4
        acc<Float32> = 0.0
        j<Int> = 0
        while (j < 128) {
            suj<Float32> = ld_f16(SV + (base + j) * 2) as Float32
            acc = acc + ld_f32n(H + (d * 128 + j) * 4) * ld_f32n(xo + (base + j) * 4) * suj
            j = j + 1
        }
        st_f32(oo + (base + d) * 4, acc)
    }
}

// yhatB p: +0 yraw(f32 [B][cw]), +8 y(f64 [B][cw]), +16 H, +24 cw,
//          +32 sv(f16), +40 B
yhatB(p<Int>) -> {
    YR<Int> = ld_i64(p + 0)
    Y<Int> = ld_i64(p + 8)
    H<Int> = ld_i64(p + 16)
    cw<Int> = ld_i64(p + 24)
    SV<Int> = ld_i64(p + 32)
    B<Int> = ld_i64(p + 40)
    nbpt<Int> = cw / 128
    gid<Int> = blk_x()
    tok<Int> = gid / nbpt
    blk<Int> = gid - tok * nbpt
    a<Int> = tid_x()
    base<Int> = blk * 128
    if (tok < B && base < cw && a < 128) {
        acc<Float32> = 0.0
        b<Int> = 0
        while (b < 128) {
            acc = acc + ld_f32n(H + (a * 128 + b) * 4) * ld_f32n(YR + tok * cw * 4 + (base + b) * 4)
            b = b + 1
        }
        svy<Float32> = ld_f16(SV + (base + a) * 2) as Float32
        st_f64(Y + (tok * cw + base + a) * 8, acc * svy)
    }
}
