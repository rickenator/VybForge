            b0v3<Float32> = ld_f16(pb + 192)
            b0v4<Float32> = ld_f16(pb + 256)
            b0v5<Float32> = ld_f16(pb + 320)
            b0v6<Float32> = ld_f16(pb + 384)
            b0v7<Float32> = ld_f16(pb + 448)
