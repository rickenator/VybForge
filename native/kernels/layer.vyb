// apack (Ursela): A [M][K] f32 -> [ceil(M/8)][K][8] f32 packets for gemm16_t (rows >= M repeat row M-1).
// Params: +0 src, +8 dst, +16 M, +24 K.
apack(p<Int>) -> {
    SRC<Int> = ld_i64(p + 0)
    DST<Int> = ld_i64(p + 8)
    M<Int> = ld_i64(p + 16)
    K<Int> = ld_i64(p + 24)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < (M + 7) / 8 * K * 8) {
        i<Int> = gid % 8
        kk<Int> = (gid / 8) % K
        mb<Int> = gid / (8 * K)
        row<Int> = mb * 8 + i
        if (row > M - 1) { row = M - 1 }
        v<Float32> = ld_f32(SRC + (row * K + kk) * 4)
        st_f32(DST + gid * 4, v)
    }
}










// Prefill attention (Ursela). attn_sc4 spends a warp, 5 block barriers and a shared f64 tree per score; at
// S=512 that is ~190 ms/forward on GB10. attn_sc5 gives each (row s, kv group g, position t) ONE thread
// that rebuilds attn_sc4's arithmetic exactly: lane partial l = sum over ia = l, l+32, l+64, l+96 (f32,
// same order), then the same f64 pairwise tree (16, 8, 4, 2, 1) -> bit-identical scores. HD == 128 only.
// Grid: S * KVH * ceil(T / 128) blocks of 128 threads (consecutive t -> broadcast Q, coalesced stores).
attn_sc5(p<Int>) -> {
    Q<Int> = ld_i64(p + 80)
    K<Int> = ld_i64(p + 88)
    S<Int> = ld_i64(p + 184)
    H<Int> = ld_i64(p + 208)
    KVH<Int> = ld_i64(p + 216)
    P0<Int> = ld_i64(p + 224)
    SC<Int> = ld_i64(p + 232)
    T<Int> = ld_i64(p + 240)
    PC<Int> = ld_i64(p + 264)
    scale<Float> = 0.08838834764831845
    TB<Int> = (T + 127) / 128
    gk<Int> = blk_x() / TB
    tb<Int> = blk_x() % TB
    s<Int> = gk / KVH
    g<Int> = gk % KVH
    t<Int> = tb * 128 + tid_x()
    if (t < T) { if (t <= P0 + s) {
        # K transposed by attn_kt into the (here unused) chunk-partial buffer PC: [g][ia][T] f32 -> coalesced
        T4<Int> = T * 4
        Q32<Int> = PC + ((T * KVH * 512 + 255) / 256) * 256   # f32 copy of Q written by attn_kt
        hj<Int> = 0
        # all 4 heads of the group in one pass over K (each K element loaded once, not 4 times)
        qb<Int> = Q32 + (s * H * 128 + g * 4 * 128) * 4
        kp<Int> = PC + (g * 128 * T + t) * 4
        p0_0<Float32> = 0.0 as Float32
        p0_1<Float32> = 0.0 as Float32
        p0_2<Float32> = 0.0 as Float32
        p0_3<Float32> = 0.0 as Float32
        p0_4<Float32> = 0.0 as Float32
        p0_5<Float32> = 0.0 as Float32
        p0_6<Float32> = 0.0 as Float32
        p0_7<Float32> = 0.0 as Float32
