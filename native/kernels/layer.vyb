        cg<Int> = w % NG
        mm0<Int> = mb * 8
        c0<Int> = cg * 256 + lane
        kl<Int> = (K + KSP - 1) / KSP
        k0<Int> = ks * kl
        k1<Int> = k0 + kl
        if (k1 > K) { k1 = K }
        a0_0<Float32> = 0.0
        a0_1<Float32> = 0.0
        a0_2<Float32> = 0.0
        a0_3<Float32> = 0.0
        a0_4<Float32> = 0.0
        a0_5<Float32> = 0.0
        a0_6<Float32> = 0.0
        a0_7<Float32> = 0.0
        a1_0<Float32> = 0.0
        a1_1<Float32> = 0.0
        a1_2<Float32> = 0.0
        a1_3<Float32> = 0.0
        a1_4<Float32> = 0.0
        a1_5<Float32> = 0.0
        a1_6<Float32> = 0.0
        a1_7<Float32> = 0.0
        a2_0<Float32> = 0.0
        a2_1<Float32> = 0.0
        a2_2<Float32> = 0.0
        a2_3<Float32> = 0.0
        a2_4<Float32> = 0.0
        a2_5<Float32> = 0.0
        a2_6<Float32> = 0.0
        a2_7<Float32> = 0.0
        a3_0<Float32> = 0.0
        a3_1<Float32> = 0.0
        a3_2<Float32> = 0.0
        a3_3<Float32> = 0.0
        a3_4<Float32> = 0.0
        a3_5<Float32> = 0.0
        a3_6<Float32> = 0.0
        a3_7<Float32> = 0.0
        a4_0<Float32> = 0.0
        a4_1<Float32> = 0.0
        a4_2<Float32> = 0.0
        a4_3<Float32> = 0.0
        a4_4<Float32> = 0.0
        a4_5<Float32> = 0.0
        a4_6<Float32> = 0.0
        a4_7<Float32> = 0.0
        a5_0<Float32> = 0.0
        a5_1<Float32> = 0.0
        a5_2<Float32> = 0.0
        a5_3<Float32> = 0.0
        a5_4<Float32> = 0.0
        a5_5<Float32> = 0.0
        a5_6<Float32> = 0.0
        a5_7<Float32> = 0.0
        a6_0<Float32> = 0.0
        a6_1<Float32> = 0.0
        a6_2<Float32> = 0.0
        a6_3<Float32> = 0.0
        a6_4<Float32> = 0.0
        a6_5<Float32> = 0.0
        a6_6<Float32> = 0.0
        a6_7<Float32> = 0.0
        a7_0<Float32> = 0.0
        a7_1<Float32> = 0.0
        a7_2<Float32> = 0.0
        a7_3<Float32> = 0.0
        a7_4<Float32> = 0.0
        a7_5<Float32> = 0.0
        a7_6<Float32> = 0.0
        a7_7<Float32> = 0.0
        # A arrives packed by apack as [M/8][K][8] f32: the 8 row values of step k are one 32-byte packet
        pa<Int> = A + (mb * K + k0) * 32
        pb<Int> = B + (k0 * N + c0) * 2
        pbx<Int> = N * 2
        np<Int> = (k1 - k0) / 2
