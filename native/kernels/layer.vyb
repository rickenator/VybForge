    NG<Int> = N / 256
    items<Int> = MB8 * NG
    NBLK<Int> = (items + 7) / 8
    bx<Int> = blk_x()
    ks<Int> = bx / NBLK
    nb<Int> = bx % NBLK
    w<Int> = nb * 8 + tid_x() / 32
    lane<Int> = tid_x() % 32
    total<Int> = M * N
    if (w < items) {
