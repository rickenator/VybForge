// One transformer decoder layer forward, as launchable Vyb kernels (sm_86).
// Entry kernels: gemm, rmsnorm, rope, attn, silu, resid.
// NOTE: never write `X * (Y)` — the compiler misparses it as a pointer type
// (`X *` + parenthesized expr -> ptr<X>) and silently nulls the expression
// (garbage/zero). Always expand to a plain multiply chain `X * Y1 * Y2`.
import vmath::{vexp, vsin, vcos, vsqrt}

// Reusable GEMM C=alpha A@B + beta C (f64). Small 56-B params buffer:
//   +0 A, +8 B, +16 C, +24 M, +32 N, +40 K, +48 alpha, +56 beta.
gemm(p<Int>) -> {
    A<Int> = ld_i64(p + 0)
    B<Int> = ld_i64(p + 8)
    C<Int> = ld_i64(p + 16)
    M<Int> = ld_i64(p + 24)
    N<Int> = ld_i64(p + 32)
    K<Int> = ld_i64(p + 40)
    alpha<Float> = ld_f64(p + 48)
    beta<Float> = ld_f64(p + 56)
    total<Int> = M * N
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < total) {
        mm<Int> = gid / N
        nn<Int> = gid % N
        acc<Float> = 0.0
        kk<Int> = 0
        for (kk in 0..K - 1) {
            av<Float> = ld_f64(A + (mm * K + kk) * 8)
            bv<Float> = ld_f64(B + (kk * N + nn) * 8)
            acc = acc + av * bv
        }
        cval<Float> = 0.0
        if (beta != 0.0) { cval = ld_f64(C + (mm * N + nn) * 8) }
        st_f64(C + (mm * N + nn) * 8, alpha * acc + beta * cval)
    }
}

// Split-K GEMM, pass 1 of 2: PARTIAL sums (VybForge#23). Same A/B as `gemm`, but K is cut into KSP
// slices and each BLOCK computes ONE slice for its 256 output elements, writing the raw partial to
// SK[ks][m][n] (no alpha/beta). Grid = NBLK * KSP, NBLK = ceil(M*N/256).
// Why: `gemm` at decode shapes launches 10-38 blocks for an 82-SM card — the same defect nsys showed
// for `attn` (ONE block, 21x slow). Splitting K multiplies the block count by KSP for the price of a
// scratch buffer and one extra launch. (A shared-memory tiled version — `fixtures/kernel/matmul_smem.vyb`
// in the Vyb repo is the template, and Vyb has the intrinsics for it — could reduce inside the block
// instead of through pass 2; this pair is the version that exists today.) The summation ORDER changes (each slice sums its own range, then
// pass 2 adds the slices), so results differ from `gemm` at ~1e-16 relative — f64 rounding.
// Params: +0 A, +8 B, +16 SK, +24 M, +32 N, +40 K, +48 NBLK, +56 KSP.
gemm_p(p<Int>) -> {
    A<Int> = ld_i64(p + 0)
    B<Int> = ld_i64(p + 8)
    SK<Int> = ld_i64(p + 16)
    M<Int> = ld_i64(p + 24)
    N<Int> = ld_i64(p + 32)
    K<Int> = ld_i64(p + 40)
    NBLK<Int> = ld_i64(p + 48)
    KSP<Int> = ld_i64(p + 56)
    bx<Int> = blk_x()
    ks<Int> = bx / NBLK
    nb<Int> = bx % NBLK
    gid<Int> = nb * dim_x() + tid_x()
    total<Int> = M * N
    if (gid < total) {
        mm<Int> = gid / N
        nn<Int> = gid % N
        kl<Int> = (K + KSP - 1) / KSP
        k0<Int> = ks * kl
        k1<Int> = k0 + kl
        if (k1 > K) { k1 = K }
        acc<Float> = 0.0
        pa<Int> = A + (mm * K + k0) * 8
        pb<Int> = B + (k0 * N + nn) * 8
        kk<Int> = k0
        for (kk in k0..k1 - 1) {
            acc = acc + ld_f64(pa) * ld_f64(pb)
            pa = pa + 8
            pb = pb + N * 8
        }
        st_f64(SK + (ks * total + gid) * 8, acc)
    }
}

// Split-K GEMM, pass 2 of 2: sum the KSP partials, then apply alpha/beta and write C — i.e. exactly
// `C = alpha A@B + beta C` with the reduction done across slices instead of inside one thread.
// Params: +0 SK, +8 C, +16 M, +24 N, +32 alpha, +40 beta, +48 KSP. Grid = ceil(M*N/256).
gemm_r(p<Int>) -> {
    SK<Int> = ld_i64(p + 0)
    C<Int> = ld_i64(p + 8)
    M<Int> = ld_i64(p + 16)
    N<Int> = ld_i64(p + 24)
    alpha<Float> = ld_f64(p + 32)
    beta<Float> = ld_f64(p + 40)
    KSP<Int> = ld_i64(p + 48)
    total<Int> = M * N
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < total) {
        s<Float> = 0.0
        ks<Int> = 0
        for (ks in 0..KSP - 1) { s = s + ld_f64(SK + (ks * total + gid) * 8) }
        cval<Float> = 0.0
        if (beta != 0.0) { cval = ld_f64(C + gid * 8) }
        st_f64(C + gid * 8, alpha * s + beta * cval)
    }
}

// Two-pass RMSNorm (VybForge#23). `rmsnorm` gives every one of its S*D threads the WHOLE row sum, so a
// row costs S*D*D loads/ops instead of D — the same redundant-work shape the old `attn` had.
//
// CORRECTION — a claim that stood here was WRONG: "Vyb has no shared memory or barriers". Vyb has both.
// Probed directly rather than inferred: a kernel using `st_shared_f64`/`ld_shared_f64` + `kernel_barrier`
// emits `.shared .align 8 .b8 __vyb_kernel_shared[32768]`, `st.shared.u64`, `ld.shared.f64`, `bar.sync`;
// a kernel doing `a<Float32> * b<Float32> + a<Float32>` on non-constant inputs emits `mul.rn.f32` /
// `add.rn.f32`; and the language reference documents `atomic_add_f64/i32` and grid/lane reads. The
// shipped `fixtures/kernel/matmul_smem.vyb` is a shared-memory TILED matmul with block barriers,
// verified on an RTX 3090. The mistake came from grepping this project's kernels for usage instead of
// reading Vyb's own reference — do not repeat it.
//
// So the two-pass split below is ONE way, not the only way: a shared-memory version can reduce inside a
// block and drop the scratch entirely, and that is the natural next step for this kernel.
//   rms_ss     one thread per (row, chunk of CH) -> SS[s*NCH + ch], the chunk's sum of squares.
//   rms_apply  one thread per element: sums the NCH partials (NCH ~10, not D ~2560), then normalizes.
// Params: rms_ss +0 X, +8 SS, +16 S, +24 D, +32 CH.  rms_apply +0 X, +8 W, +16 Y, +24 SS, +32 S,
// +40 D, +48 eps, +56 NCH.
// The summation order changes (chunk partials), so results differ from `rmsnorm` at ~1e-16 relative.
rms_ss(p<Int>) -> {
    X<Int> = ld_i64(p + 0)
    SS<Int> = ld_i64(p + 8)
    S<Int> = ld_i64(p + 16)
    D<Int> = ld_i64(p + 24)
    CH<Int> = ld_i64(p + 32)
    NCH<Int> = (D + CH - 1) / CH
    total<Int> = S * NCH
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < total) {
        s<Int> = gid / NCH
        ch<Int> = gid % NCH
        i0<Int> = ch * CH
        i1<Int> = i0 + CH
        if (i1 > D) { i1 = D }
        ss<Float> = 0.0
        j<Int> = i0
        for (j in i0..i1 - 1) {
            v<Float> = ld_f64(X + (s * D + j) * 8)
            ss = ss + v * v
        }
        st_f64(SS + gid * 8, ss)
    }
}

rms_apply(p<Int>) -> {
    X<Int> = ld_i64(p + 0)
    W<Int> = ld_i64(p + 8)
    Y<Int> = ld_i64(p + 16)
    SS<Int> = ld_i64(p + 24)
    S<Int> = ld_i64(p + 32)
    D<Int> = ld_i64(p + 40)
    eps<Float> = ld_f64(p + 48)
    NCH<Int> = ld_i64(p + 56)
    total<Int> = S * D
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < total) {
        s<Int> = gid / D
        d<Int> = gid % D
        ss<Float> = 0.0
        k<Int> = 0
        for (k in 0..NCH - 1) { ss = ss + ld_f64(SS + (s * NCH + k) * 8) }
        r<Float> = 1.0 / vsqrt(ss / (D as Float) + eps, 24)
        wv<Float> = ld_f64(W + d * 8)
        xv<Float> = ld_f64(X + (s * D + d) * 8)
        st_f64(Y + (s * D + d) * 8, xv * r * wv)
    }
}
// RMSNorm y[s][d] = x[s][d] * 1/sqrt(mean(rowsq)+eps) * w[d]. Small 48-B params.
rmsnorm(p<Int>) -> {
    X<Int> = ld_i64(p + 0)
    W<Int> = ld_i64(p + 8)
    Y<Int> = ld_i64(p + 16)
    S<Int> = ld_i64(p + 24)
    D<Int> = ld_i64(p + 32)
    eps<Float> = ld_f64(p + 40)
    total<Int> = S * D
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < total) {
        s<Int> = gid / D
        d<Int> = gid % D
        ss<Float> = 0.0
        j<Int> = 0
        for (j in 0..D - 1) {
            v<Float> = ld_f64(X + (s * D + j) * 8)
            ss = ss + v * v
        }
        r<Float> = 1.0 / vsqrt(ss / (D as Float) + eps, 24)
        wv<Float> = ld_f64(W + d * 8)
        xv<Float> = ld_f64(X + (s * D + d) * 8)
        st_f64(Y + (s * D + d) * 8, xv * r * wv)
    }
}

// RoPE in place on Q [S,H*HD] and K [S,KVH*HD].
// Big PD offsets: +80 Q, +88 K, +176 FREQ, +184 S, +200 HD, +208 H, +216 KVH.
rope(p<Int>) -> {
    Q<Int> = ld_i64(p + 80)
    K<Int> = ld_i64(p + 88)
    FR<Int> = ld_i64(p + 176)
    S<Int> = ld_i64(p + 184)
    HD<Int> = ld_i64(p + 200)
    H<Int> = ld_i64(p + 208)
    KVH<Int> = ld_i64(p + 216)
    half<Int> = HD / 2
    shd<Int> = S * H * half
    skd<Int> = S * KVH * half
    total<Int> = shd + skd
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < total) {
        if (gid < shd) {
            s<Int> = gid / (H * half)
            rem<Int> = gid % (H * half)
            hh<Int> = rem / half
            ii<Int> = rem % half
            ang<Float> = (s as Float) * ld_f64(FR + ii * 8)
            c<Float> = vcos(ang)
            sn<Float> = vsin(ang)
            rbase<Int> = Q + (s * H * HD + hh * HD) * 8
            q0<Float> = ld_f64(rbase + ii * 2 * 8)
            q1<Float> = ld_f64(rbase + (ii * 2 + 1) * 8)
            st_f64(rbase + ii * 2 * 8, q0 * c - q1 * sn)
            st_f64(rbase + (ii * 2 + 1) * 8, q0 * sn + q1 * c)
        } else {
            g2<Int> = gid - shd
            s2<Int> = g2 / (KVH * half)
            rem2<Int> = g2 % (KVH * half)
            hh2<Int> = rem2 / half
            ii2<Int> = rem2 % half
            ang2<Float> = (s2 as Float) * ld_f64(FR + ii2 * 8)
            c2<Float> = vcos(ang2)
            sn2<Float> = vsin(ang2)
            rbase2<Int> = K + (s2 * KVH * HD + hh2 * HD) * 8
            k0<Float> = ld_f64(rbase2 + ii2 * 2 * 8)
            k1<Float> = ld_f64(rbase2 + (ii2 * 2 + 1) * 8)
            st_f64(rbase2 + ii2 * 2 * 8, k0 * c2 - k1 * sn2)
            st_f64(rbase2 + (ii2 * 2 + 1) * 8, k0 * sn2 + k1 * c2)
        }
    }
}

// Grouped-query, causal, scaled-softmax attention: Q,K,V -> Ctx [S,H*HD].
// kv head for q head h = h / (H/KVH).
// PD offsets: +80 Q, +88 K, +96 V, +104 Ctx, +184 S, +200 HD, +208 H, +216 KVH.
// Causal multi-head attention. One THREAD per (s, h, ii): each thread owns ONE context dimension and
// walks the causal window, recomputing the score per position (the flash-decode form).
// VybForge#23: the previous mapping was one thread per (s, h) — 64 threads for an 82-SM card — and
// its third pass put the context dimension OUTSIDE the position loop, so the HD-wide score AND its
// vexp were recomputed for every (ii, tc) pair: HD x redundant work, measured by nsys at 8.2 ms per
// layer (295 ms/token; the largest kernel in the profile). The math and the per-element summation
// order are unchanged, so the results are bit-identical.
attn(p<Int>) -> {
    Q<Int> = ld_i64(p + 80)
    K<Int> = ld_i64(p + 88)
    V<Int> = ld_i64(p + 96)
    Ctx<Int> = ld_i64(p + 104)
    S<Int> = ld_i64(p + 184)
    HD<Int> = ld_i64(p + 200)
    H<Int> = ld_i64(p + 208)
    KVH<Int> = ld_i64(p + 216)
    # 1/sqrt(HD): 16 dependent f64 divides PER THREAD before (Ursela). For HD=128 use the value that
    # exact loop produces (0.08838834764831845, computed by the same IEEE ops on the host).
    scale<Float> = 0.08838834764831845
    if (HD != 128) { scale = 1.0 / vsqrt(HD as Float, 16) }
    hkv<Int> = H / KVH
    total<Int> = S * H * HD
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < total) {
        ii<Int> = gid % HD
        gsh<Int> = gid / HD
        h<Int> = gsh % H
        s<Int> = gsh / H
        kvh<Int> = h / hkv
        qb<Int> = Q + (s * H * HD + h * HD) * 8
        kb<Int> = K + kvh * HD * 8
        # ONE flash-style walk (VybForge#23). The kernel used to walk the keys THREE times -- row max,
        # exp sum, then context -- re-loading the q row and every k row each time (2 f64 loads = 16 B
        # per MAC), so its cost was the LOADS, not the arithmetic: making the MACs f32 bought only
        # +3-4%, while deleting a walk bought +7.2%. This merges the context pass in, so each key's
        # score is computed once: the running max is tracked and the output accumulator is RESCALED
        # whenever the max advances, then divided by the running sum at the end.
        mx<Float> = -1000000000000000000000000000000.0
        ssum<Float> = 0.0
        acc<Float> = 0.0
        ta<Int> = 0
        for (ta in 0..s) {
            sc<Float32> = 0.0
            ia<Int> = 0
            for (ia in 0..HD - 1) {
                qv<Float> = ld_f64(qb + ia * 8)
                kv<Float> = ld_f64(kb + (ta * KVH * HD + ia) * 8)
                q32<Float32> = qv
                k32<Float32> = kv
                sc = sc + q32 * k32
            }
            scf<Float> = sc as Float
            scf = scf * scale
            if (scf > mx) {
                rs<Float> = vexp(mx - scf)
                ssum = ssum * rs
                acc = acc * rs
                mx = scf
            }
            p<Float> = vexp(scf - mx)
            ssum = ssum + p
            vv<Float> = ld_f64(V + (ta * KVH * HD + kvh * HD + ii) * 8)
            acc = acc + p * vv
        }
        out<Float> = acc / ssum
        st_f64(Ctx + (s * H * HD + h * HD + ii) * 8, out)
    }
}

// MLP gate: h[gid] = silu(g[gid]) * u[gid], elementwise over n.
silu(g<Int>, u<Int>, h<Int>, n<Int>) -> {
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < n) {
        gv<Float> = ld_f64(g + gid * 8)
        uv<Float> = ld_f64(u + gid * 8)
        sg<Float> = 1.0 / (1.0 + vexp(0.0 - gv))
        st_f64(h + gid * 8, gv * sg * uv)
    }
}

// Residual add: y[gid] = a[gid] + b[gid] over n.
resid(a<Int>, b<Int>, y<Int>, n<Int>) -> {
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < n) {
        av<Float> = ld_f64(a + gid * 8)
        bv<Float> = ld_f64(b + gid * 8)
        st_f64(y + gid * 8, av + bv)
    }
}

// f64 -> f32 cast, elementwise (VybForge#23). Params: +0 src (f64), +8 dst (f32), +16 n.
cast32(p<Int>) -> {
    SRC<Int> = ld_i64(p + 0)
    DST<Int> = ld_i64(p + 8)
    N<Int> = ld_i64(p + 16)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < N) {
        v<Float> = ld_f64(SRC + gid * 8)
        st_f32(DST + gid * 4, v)
    }
}

// Split-K GEMM in f32, pass 1 of 3 (VybForge#23). A, B and the partials are f32 and the MACs are
// native `mul.rn.f32`/`add.rn.f32`. The Float32 LOCALS are load bearing: `ld_f32` has a Float64
// surface type, so `ld_f32(pa) * ld_f32(pb)` would be an f64 multiply of two widened values with 4
// conversions per MAC (f64 is 1/64 rate on sm_86). Binding first makes the MAC native and the
// widen/narrow pair of an exactly-f32 value folds away -- verified in the emitted PTX.
// Params: +0 A, +8 B, +16 SK, +24 M, +32 N, +40 K, +48 NBLK, +56 KSP.
gemm32_p(p<Int>) -> {
    A<Int> = ld_i64(p + 0)
    B<Int> = ld_i64(p + 8)
    SK<Int> = ld_i64(p + 16)
    M<Int> = ld_i64(p + 24)
    N<Int> = ld_i64(p + 32)
    K<Int> = ld_i64(p + 40)
    # M-BLOCKING: 4 rows per thread, one accumulator column. This kernel is L2-BANDWIDTH-bound -- with
    # no reuse across M, every output row re-reads the whole weight matrix through L2 (~2 TB/s on this
    # card), which caps it near 1 TFLOP/s. 4-way unrolling made it SLOWER (99 vs 72 ms in the harness),
    # so ILP is not the answer; reuse is. One B load now feeds 4 MACs.
    # Padded rows (M not a multiple of 4) are READ but never STORED: the A buffers carry 4 rows of
    # slack and an accumulator that is never stored is harmless.
    # NBLK is derived HERE (not read from the block) so it always matches the grid the driver computes.
    MB<Int> = (M + 3) / 4
    NBLK<Int> = (MB * N + 255) / 256
    KSP<Int> = ld_i64(p + 56)
    bx<Int> = blk_x()
    ks<Int> = bx / NBLK
    nb<Int> = bx % NBLK
    gid<Int> = nb * dim_x() + tid_x()
    total<Int> = M * N
    if (gid < MB * N) {
        mb<Int> = gid / N
        nn<Int> = gid % N
        mm0<Int> = mb * 4
        kl<Int> = (K + KSP - 1) / KSP
        k0<Int> = ks * kl
        k1<Int> = k0 + kl
        if (k1 > K) { k1 = K }
        a0<Float32> = 0.0
        a1<Float32> = 0.0
        a2<Float32> = 0.0
        a3<Float32> = 0.0
        pa0<Int> = A + (mm0 * K + k0) * 4
        pa1<Int> = pa0 + K * 4
        pa2<Int> = pa0 + K * 8
        pa3<Int> = pa0 + K * 12
        pb<Int> = B + (k0 * N + nn) * 4
        pbx<Int> = N * 4
        kk<Int> = k0
        for (kk in k0..k1 - 1) {
            # EVERY ld_f32 is BOUND to a <Float32> local before the multiply: `a0 + ld_f32(pa0) * bv`
            # leaves the load's Float64 surface type in play and turns the MAC into f64 (1/64 rate on
            # sm_86) -- exactly what made the first attempt at this M-blocking 8x slower.
            bv<Float32> = ld_f32(pb)
            av0<Float32> = ld_f32(pa0)
            av1<Float32> = ld_f32(pa1)
            av2<Float32> = ld_f32(pa2)
            av3<Float32> = ld_f32(pa3)
            a0 = a0 + av0 * bv
            a1 = a1 + av1 * bv
            a2 = a2 + av2 * bv
            a3 = a3 + av3 * bv
            pa0 = pa0 + 4
            pa1 = pa1 + 4
            pa2 = pa2 + 4
            pa3 = pa3 + 4
            pb = pb + pbx
        }
        st_f32(SK + (ks * total + mm0 * N + nn) * 4, a0)
        if (mm0 + 1 < M) { st_f32(SK + (ks * total + (mm0 + 1) * N + nn) * 4, a1) }
        if (mm0 + 2 < M) { st_f32(SK + (ks * total + (mm0 + 2) * N + nn) * 4, a2) }
        if (mm0 + 3 < M) { st_f32(SK + (ks * total + (mm0 + 3) * N + nn) * 4, a3) }
    }
}

// Split-K GEMM in f32, pass 2 of 3: f32 reduce, f32 store (the f32 store is what keeps the loop).
// PARAM LAYOUT IS gemm_r's, deliberately: SK(+0), SCR(+8), M(+16), N(+24), alpha(+32), beta(+40),
// KSP(+48). That lets the driver's PROVEN gemm2 helper drive this kernel as its pass 2 (it writes
// those slots itself), instead of a hand-rolled multi-launch helper.
gemm32_r(p<Int>) -> {
    SK<Int> = ld_i64(p + 0)
    SCR<Int> = ld_i64(p + 8)
    M<Int> = ld_i64(p + 16)
    N<Int> = ld_i64(p + 24)
    KSP<Int> = ld_i64(p + 48)
    total<Int> = M * N
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < total) {
        s<Float32> = 0.0
        ks<Int> = 0
        for (ks in 0..KSP - 1) { s = s + ld_f32(SK + (ks * total + gid) * 4) }
        # The f64 store folds the widen INTO the reduce (VybForge#23): the widen was a whole extra
        # launch per site (252 per token) plus 4 bytes/element out and 4+8 back through those buffers.
        # Writing f64 here removes the launch and HALVES that traffic (16 -> 8 bytes/element). Same
        # idiom as widen32: a plain f32 value feeding an f64 store.
        st_f64(SCR + gid * 8, s)
    }
}

// Split-K GEMM in f32, pass 3 of 3: widen to the f64 C the layer reads. The one working f32->f64
// idiom is a plain f32 load feeding an f64 store; keep it isolated here. Params: +0 src, +8 dst, +16 n.
widen32(p<Int>) -> {
    SRC<Int> = ld_i64(p + 0)
    DST<Int> = ld_i64(p + 8)
    N<Int> = ld_i64(p + 16)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < N) {
        w<Float32> = ld_f32(SRC + gid * 4)
        st_f64(DST + gid * 8, w)
    }
}

// KV-cached causal attention (Ursela, VybForge#23 follow-up). Same math, loops and per-element summation
// order as `attn`, but the S query rows sit at ABSOLUTE positions P0..P0+S-1 and K/V are the per-layer
// CACHE ([MAXS, KVH*HD], rows 0..P0+S-1 already written). Query row s attends to cache rows 0..P0+s, so
// with P0 = 0 and S = full length this is exactly `attn`; with S = 1 it is the decode step. Bit-identical
// to the uncached path because every product and sum happens in the same order.
// PD offsets: as attn (+80 Q, +88 K, +96 V, +104 Ctx, +184 S, +200 HD, +208 H, +216 KVH) plus +224 P0.
attn_kv(p<Int>) -> {
    Q<Int> = ld_i64(p + 80)
    K<Int> = ld_i64(p + 88)
    V<Int> = ld_i64(p + 96)
    Ctx<Int> = ld_i64(p + 104)
    S<Int> = ld_i64(p + 184)
    HD<Int> = ld_i64(p + 200)
    H<Int> = ld_i64(p + 208)
    KVH<Int> = ld_i64(p + 216)
    P0<Int> = ld_i64(p + 224)
    # 1/sqrt(HD): 16 dependent f64 divides PER THREAD before (Ursela). For HD=128 use the value that
    # exact loop produces (0.08838834764831845, computed by the same IEEE ops on the host).
    scale<Float> = 0.08838834764831845
    if (HD != 128) { scale = 1.0 / vsqrt(HD as Float, 16) }
    hkv<Int> = H / KVH
    total<Int> = S * H * HD
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < total) {
        ii<Int> = gid % HD
        gsh<Int> = gid / HD
        h<Int> = gsh % H
        s<Int> = gsh / H
        sa<Int> = P0 + s
        kvh<Int> = h / hkv
        qb<Int> = Q + (s * H * HD + h * HD) * 8
        kb<Int> = K + kvh * HD * 8
        mx<Float> = -1000000000000000000000000000000.0
        ta<Int> = 0
        for (ta in 0..sa) {
            sc<Float> = 0.0
            ia<Int> = 0
            for (ia in 0..HD - 1) {
                qv<Float> = ld_f64(qb + ia * 8)
                kv<Float> = ld_f64(kb + (ta * KVH * HD + ia) * 8)
                sc = sc + qv * kv
            }
            sc = sc * scale
            if (sc > mx) { mx = sc }
        }
        ssum<Float> = 0.0
        tb<Int> = 0
        for (tb in 0..sa) {
            sc2<Float> = 0.0
            ib<Int> = 0
            for (ib in 0..HD - 1) {
                qv2<Float> = ld_f64(qb + ib * 8)
                kv2<Float> = ld_f64(kb + (tb * KVH * HD + ib) * 8)
                sc2 = sc2 + qv2 * kv2
            }
            sc2 = sc2 * scale
            ssum = ssum + vexp(sc2 - mx)
        }
        acc<Float> = 0.0
        tc<Int> = 0
        for (tc in 0..sa) {
            sc3<Float> = 0.0
            jj<Int> = 0
            for (jj in 0..HD - 1) {
                qv3<Float> = ld_f64(qb + jj * 8)
                kv3<Float> = ld_f64(kb + (tc * KVH * HD + jj) * 8)
                sc3 = sc3 + qv3 * kv3
            }
            sc3 = sc3 * scale
            e<Float> = vexp(sc3 - mx)
            w<Float> = e / ssum
            vv<Float> = ld_f64(V + (tc * KVH * HD + kvh * HD + ii) * 8)
            acc = acc + w * vv
        }
        st_f64(Ctx + (s * H * HD + h * HD + ii) * 8, acc)
    }
}

// Two-kernel KV attention (Ursela, VybForge#23 follow-up). attn/attn_kv give each of the HD threads of a
// (row, head) its OWN copy of every score: 3 passes x (P0+s+1) positions x HD MACs per thread, all f64 --
// HD-fold redundant, and it made a 128-token generation 4x slower per token than a 3-token one. Here the
// score is computed ONCE per (row, head, position) into scratch SC, and the context kernel only reads it.
// Every score is the same sequential HD dot product times scale, and the context thread runs the same
// max / sum-of-exp / weighted-sum loops in the same order over the same values, so the output is
// BIT-IDENTICAL to attn_kv (and attn).
// Params: the ATT block (+80 Q, +88 K cache, +96 V cache, +104 Ctx, +184 S, +200 HD, +208 H, +216 KVH,
// +224 P0) plus +232 SC (scratch, [S, H, T] f64) and +240 T = P0 + S (cache rows valid).
// attn_sc: one thread per (s, h, t), t < T; positions t > P0 + s are causal-masked and never read.
attn_sc(p<Int>) -> {
    Q<Int> = ld_i64(p + 80)
    K<Int> = ld_i64(p + 88)
    S<Int> = ld_i64(p + 184)
    HD<Int> = ld_i64(p + 200)
    H<Int> = ld_i64(p + 208)
    KVH<Int> = ld_i64(p + 216)
    P0<Int> = ld_i64(p + 224)
    SC<Int> = ld_i64(p + 232)
    T<Int> = ld_i64(p + 240)
    # 1/sqrt(HD): 16 dependent f64 divides PER THREAD before (Ursela). For HD=128 use the value that
    # exact loop produces (0.08838834764831845, computed by the same IEEE ops on the host).
    scale<Float> = 0.08838834764831845
    if (HD != 128) { scale = 1.0 / vsqrt(HD as Float, 16) }
    hkv<Int> = H / KVH
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < S * H * T) {
        t<Int> = gid % T
        gsh<Int> = gid / T
        h<Int> = gsh % H
        s<Int> = gsh / H
        if (t <= P0 + s) {
            kvh<Int> = h / hkv
            qb<Int> = Q + (s * H * HD + h * HD) * 8
            kb<Int> = K + (t * KVH * HD + kvh * HD) * 8
            sc<Float> = 0.0
            ia<Int> = 0
            # 8 independent load pairs in flight per trip (2026-10-26): the old one-pair loop paid a full
            # uncoalesced load latency per element (~62 us per launch). Same adds in the same order.
            while (ia + 7 < HD) {
                q0<Float> = ld_f64(qb + ia * 8)
                q1<Float> = ld_f64(qb + ia * 8 + 8)
                q2<Float> = ld_f64(qb + ia * 8 + 16)
                q3<Float> = ld_f64(qb + ia * 8 + 24)
                q4<Float> = ld_f64(qb + ia * 8 + 32)
                q5<Float> = ld_f64(qb + ia * 8 + 40)
                q6<Float> = ld_f64(qb + ia * 8 + 48)
                q7<Float> = ld_f64(qb + ia * 8 + 56)
                k0<Float> = ld_f64(kb + ia * 8)
                k1<Float> = ld_f64(kb + ia * 8 + 8)
                k2<Float> = ld_f64(kb + ia * 8 + 16)
                k3<Float> = ld_f64(kb + ia * 8 + 24)
                k4<Float> = ld_f64(kb + ia * 8 + 32)
                k5<Float> = ld_f64(kb + ia * 8 + 40)
                k6<Float> = ld_f64(kb + ia * 8 + 48)
                k7<Float> = ld_f64(kb + ia * 8 + 56)
                sc = sc + q0 * k0
                sc = sc + q1 * k1
                sc = sc + q2 * k2
                sc = sc + q3 * k3
                sc = sc + q4 * k4
                sc = sc + q5 * k5
                sc = sc + q6 * k6
                sc = sc + q7 * k7
                ia = ia + 8
            }
            while (ia < HD) {
                qv<Float> = ld_f64(qb + ia * 8)
                kv<Float> = ld_f64(kb + ia * 8)
                sc = sc + qv * kv
                ia = ia + 1
            }
            st_f64(SC + gid * 8, sc * scale)
        }
    }
}

// attn_cx: one thread per (s, h, ii) -- the context element -- reading the precomputed scores.
attn_cx(p<Int>) -> {
    V<Int> = ld_i64(p + 96)
    Ctx<Int> = ld_i64(p + 104)
    S<Int> = ld_i64(p + 184)
    HD<Int> = ld_i64(p + 200)
    H<Int> = ld_i64(p + 208)
    KVH<Int> = ld_i64(p + 216)
    P0<Int> = ld_i64(p + 224)
    SC<Int> = ld_i64(p + 232)
    T<Int> = ld_i64(p + 240)
    hkv<Int> = H / KVH
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < S * H * HD) {
        ii<Int> = gid % HD
        gsh<Int> = gid / HD
        h<Int> = gsh % H
        s<Int> = gsh / H
        sa<Int> = P0 + s
        kvh<Int> = h / hkv
        sb<Int> = SC + (s * H + h) * T * 8
        mx<Float> = -1000000000000000000000000000000.0
        ta<Int> = 0
        for (ta in 0..sa) {
            sc<Float> = ld_f64(sb + ta * 8)
            if (sc > mx) { mx = sc }
        }
        ssum<Float> = 0.0
        tb<Int> = 0
        for (tb in 0..sa) {
            sc2<Float> = ld_f64(sb + tb * 8)
            ssum = ssum + vexp(sc2 - mx)
        }
        acc<Float> = 0.0
        tc<Int> = 0
        for (tc in 0..sa) {
            sc3<Float> = ld_f64(sb + tc * 8)
            e<Float> = vexp(sc3 - mx)
            w<Float> = e / ssum
            vv<Float> = ld_f64(V + (tc * KVH * HD + kvh * HD + ii) * 8)
            acc = acc + w * vv
        }
        st_f64(Ctx + (s * H * HD + h * HD + ii) * 8, acc)
    }
}

// f16 weights (Ursela, VybForge#23 follow-up). gemm32_p already streams its f32 weights at ~85% of DRAM
// peak at M=1 (3090 ~800 GB/s, GB10 ~240 GB/s in a standalone harness), so the f32 path is at its floor:
// 14.5 GB read per token. Halving the bytes is the remaining lever short of reading Q4_K directly.
// gemm16_p is gemm32_p with B stored as IEEE half (2 bytes): the half is widened and bound to a <Float32>
// local, so the MACs stay native f32 exactly as in gemm32_p (same params, same split-K, same gemm32_r).
// The half copy rounds each dequantized weight to 11 significant bits; the gold stream is the gate.
// 2 COLUMNS x 4 rows per thread (Ursela): each thread now loads 2 adjacent halves per k step and keeps
// 8 accumulators. Swept in a standalone harness (1/2/4 columns x KSP 8..128) on both GPUs at M=1:
// 2 columns wins on every Qwen3-4B shape, e.g. ffn_down (N=2560, K=9728) GB10 0.286 -> 0.183 ms and
// q (N=4096) 3090 0.047 -> 0.035 ms at KSP=32. N must be even (all Qwen3 shapes are). The driver's
// grid uses NBLK = ceil(MB * N/2 / 256), matching what the kernel derives here.
gemm16_p(p<Int>) -> {
    A<Int> = ld_i64(p + 0)
    B<Int> = ld_i64(p + 8)
    SK<Int> = ld_i64(p + 16)
    M<Int> = ld_i64(p + 24)
    N<Int> = ld_i64(p + 32)
    K<Int> = ld_i64(p + 40)
    MB<Int> = (M + 3) / 4
    NC<Int> = N / 2
    NBLK<Int> = (MB * NC + 255) / 256
    KSP<Int> = ld_i64(p + 56)
    bx<Int> = blk_x()
    ks<Int> = bx / NBLK
    nb<Int> = bx % NBLK
    gid<Int> = nb * dim_x() + tid_x()
    total<Int> = M * N
    if (gid < MB * NC) {
        mb<Int> = gid / NC
        nn<Int> = (gid % NC) * 2
        mm0<Int> = mb * 4
        kl<Int> = (K + KSP - 1) / KSP
        k0<Int> = ks * kl
        k1<Int> = k0 + kl
        if (k1 > K) { k1 = K }
        a0_0<Float32> = 0.0
        a0_1<Float32> = 0.0
        a1_0<Float32> = 0.0
        a1_1<Float32> = 0.0
        a2_0<Float32> = 0.0
        a2_1<Float32> = 0.0
        a3_0<Float32> = 0.0
        a3_1<Float32> = 0.0
        pa0<Int> = A + (mm0 * K + k0) * 4
        pa1<Int> = pa0 + K * 4
        pa2<Int> = pa0 + K * 8
        pa3<Int> = pa0 + K * 12
        pb<Int> = B + (k0 * N + nn) * 2
        pbx<Int> = N * 2
        kk<Int> = k0
        for (kk in k0..k1 - 1) {
            bv0<Float32> = ld_f16(pb + 0)
            bv1<Float32> = ld_f16(pb + 2)
            av0<Float32> = ld_f32(pa0)
            av1<Float32> = ld_f32(pa1)
            av2<Float32> = ld_f32(pa2)
            av3<Float32> = ld_f32(pa3)
            a0_0 = a0_0 + av0 * bv0
            a0_1 = a0_1 + av0 * bv1
            a1_0 = a1_0 + av1 * bv0
            a1_1 = a1_1 + av1 * bv1
            a2_0 = a2_0 + av2 * bv0
            a2_1 = a2_1 + av2 * bv1
            a3_0 = a3_0 + av3 * bv0
            a3_1 = a3_1 + av3 * bv1
            pa0 = pa0 + 4
            pa1 = pa1 + 4
            pa2 = pa2 + 4
            pa3 = pa3 + 4
            pb = pb + pbx
        }
        { st_f32(SK + (ks * total + (mm0 + 0) * N + nn + 0) * 4, a0_0) }
        { st_f32(SK + (ks * total + (mm0 + 0) * N + nn + 1) * 4, a0_1) }
        if (mm0 + 1 < M) { st_f32(SK + (ks * total + (mm0 + 1) * N + nn + 0) * 4, a1_0) }
        if (mm0 + 1 < M) { st_f32(SK + (ks * total + (mm0 + 1) * N + nn + 1) * 4, a1_1) }
        if (mm0 + 2 < M) { st_f32(SK + (ks * total + (mm0 + 2) * N + nn + 0) * 4, a2_0) }
        if (mm0 + 2 < M) { st_f32(SK + (ks * total + (mm0 + 2) * N + nn + 1) * 4, a2_1) }
        if (mm0 + 3 < M) { st_f32(SK + (ks * total + (mm0 + 3) * N + nn + 0) * 4, a3_0) }
        if (mm0 + 3 < M) { st_f32(SK + (ks * total + (mm0 + 3) * N + nn + 1) * 4, a3_1) }
    }
}

// f32 -> f16 elementwise (load-time expansion of the weights). Params: +0 src (f32), +8 dst (f16), +16 n.
cast16(p<Int>) -> {
    SRC<Int> = ld_i64(p + 0)
    DST<Int> = ld_i64(p + 8)
    N<Int> = ld_i64(p + 16)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < N) {
        v<Float32> = ld_f32(SRC + gid * 4)
        st_f16(DST + gid * 2, v)
    }
}

// Softmax split out of attn_cx (Ursela). attn_cx made each of the HD threads of a (row, head) evaluate
// 2 x (P0+s+1) f64 vexp and a f64 divide per position -- HD-fold redundant transcendental work at the
// 1/64 f64 rate of sm_86 (nsys, 3090, GEN=64: attn_cx 31% of GPU time, ~10 ms/token). The softmax is
// now its own short pipeline, each step once per (row, head[, position]), with the SAME expressions in
// the SAME order, so the weights -- and the context -- are bit-identical to attn_cx:
//   attn_mx   (s,h):   mx = max_t SC                      -> MS[2*sh]
//   attn_ex   (s,h,t): E = vexp(SC - mx)                  -> EW
//   attn_sum  (s,h):   ssum = sum_t E (t ascending)       -> MS[2*sh+1]
//   attn_nrm  (s,h,t): W = E / ssum                       -> EW (in place)
//   attn_cxw  (s,h,ii): acc = sum_t W * V (t ascending)   -> Ctx
// Params: the ATT block (+96 V cache, +104 Ctx, +184 S, +200 HD, +208 H, +216 KVH, +224 P0, +232 SC,
// +240 T) plus +248 EW ([S, H, T] f64) and +256 MS ([S, H, 2] f64).
attn_mx(p<Int>) -> {
    S<Int> = ld_i64(p + 184)
    H<Int> = ld_i64(p + 208)
    P0<Int> = ld_i64(p + 224)
    SC<Int> = ld_i64(p + 232)
    T<Int> = ld_i64(p + 240)
    MS<Int> = ld_i64(p + 256)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < S * H) {
        s<Int> = gid / H
        sa<Int> = P0 + s
        sb<Int> = SC + gid * T * 8
        mx<Float> = -1000000000000000000000000000000.0
        ta<Int> = 0
        for (ta in 0..sa) {
            sc<Float> = ld_f64(sb + ta * 8)
            if (sc > mx) { mx = sc }
        }
        st_f64(MS + gid * 16, mx)
    }
}
attn_ex(p<Int>) -> {
    S<Int> = ld_i64(p + 184)
    H<Int> = ld_i64(p + 208)
    P0<Int> = ld_i64(p + 224)
    SC<Int> = ld_i64(p + 232)
    T<Int> = ld_i64(p + 240)
    EW<Int> = ld_i64(p + 248)
    MS<Int> = ld_i64(p + 256)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < S * H * T) {
        t<Int> = gid % T
        sh<Int> = gid / T
        s<Int> = sh / H
        if (t <= P0 + s) {
            mx<Float> = ld_f64(MS + sh * 16)
            sc<Float> = ld_f64(SC + gid * 8)
            st_f64(EW + gid * 8, vexp(sc - mx))
        }
    }
}
attn_sum(p<Int>) -> {
    S<Int> = ld_i64(p + 184)
    H<Int> = ld_i64(p + 208)
    P0<Int> = ld_i64(p + 224)
    T<Int> = ld_i64(p + 240)
    EW<Int> = ld_i64(p + 248)
    MS<Int> = ld_i64(p + 256)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < S * H) {
        s<Int> = gid / H
        sa<Int> = P0 + s
        eb<Int> = EW + gid * T * 8
        ssum<Float> = 0.0
        tb<Int> = 0
        for (tb in 0..sa) {
            ssum = ssum + ld_f64(eb + tb * 8)
        }
        st_f64(MS + gid * 16 + 8, ssum)
    }
}
attn_nrm(p<Int>) -> {
    S<Int> = ld_i64(p + 184)
    H<Int> = ld_i64(p + 208)
    P0<Int> = ld_i64(p + 224)
    T<Int> = ld_i64(p + 240)
    EW<Int> = ld_i64(p + 248)
    MS<Int> = ld_i64(p + 256)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < S * H * T) {
        t<Int> = gid % T
        sh<Int> = gid / T
        s<Int> = sh / H
        if (t <= P0 + s) {
            ssum<Float> = ld_f64(MS + sh * 16 + 8)
            e<Float> = ld_f64(EW + gid * 8)
            st_f64(EW + gid * 8, e / ssum)
        }
    }
}
attn_cxw(p<Int>) -> {
    V<Int> = ld_i64(p + 96)
    Ctx<Int> = ld_i64(p + 104)
    S<Int> = ld_i64(p + 184)
    HD<Int> = ld_i64(p + 200)
    H<Int> = ld_i64(p + 208)
    KVH<Int> = ld_i64(p + 216)
    P0<Int> = ld_i64(p + 224)
    T<Int> = ld_i64(p + 240)
    EW<Int> = ld_i64(p + 248)
    hkv<Int> = H / KVH
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < S * H * HD) {
        ii<Int> = gid % HD
        gsh<Int> = gid / HD
        h<Int> = gsh % H
        s<Int> = gsh / H
        sa<Int> = P0 + s
        kvh<Int> = h / hkv
        wb<Int> = EW + gsh * T * 8
        acc<Float> = 0.0
        tc<Int> = 0
        for (tc in 0..sa) {
            w<Float> = ld_f64(wb + tc * 8)
            vv<Float> = ld_f64(V + (tc * KVH * HD + kvh * HD + ii) * 8)
            acc = acc + w * vv
        }
        st_f64(Ctx + (s * H * HD + h * HD + ii) * 8, acc)
    }
}

// Block-per-row RMSNorm with a shared-memory reduction (Ursela). nsys, 3090, GEN=64, after 7f6dfdd: the
// norms were 26% of GPU time (rmsnorm 15%, rms_apply 6%, rms_ss 5%). rmsnorm has every thread re-sum
// the whole row and every thread runs vsqrt(.., 24) -- a 24-step f64 software sqrt at the 1/64 f64
// rate; the two-pass pair still runs the sqrt per element. Here ONE block (256 threads) owns a row:
// strided coalesced sum of squares, a shared-memory tree reduce, ONE sqrt per row by thread 0, then
// each thread scales its elements. Optional fused f32 copy of the output (Y32 != 0) feeds the f32/f16
// gemm directly and removes the separate cast32 launch. Summation order differs from rmsnorm (strided
// partials + tree), so outputs differ at f64 rounding (~1e-16 relative); the gold stream is the gate.
// Params: +0 X, +8 W, +16 Y, +24 M (rows), +32 N (row length), +40 eps, +48 Y32 (0 = none).
// Grid = M blocks of 256 threads. Shared slots 0..255 partials, 256 the row's 1/rms.
rms_blk(p<Int>) -> {
    X<Int> = ld_i64(p + 0)
    W<Int> = ld_i64(p + 8)
    Y<Int> = ld_i64(p + 16)
    N<Int> = ld_i64(p + 32)
    eps<Float> = ld_f64(p + 40)
    Y32<Int> = ld_i64(p + 48)
    row<Int> = blk_x()
    t<Int> = tid_x()
    xb<Int> = X + row * N * 8
    ss<Float> = 0.0
    d<Int> = t
    # 4 loads in flight per trip (Ursela): same elements, same summation order -> bit-identical
    while (d + 768 < N) {
        a0<Float> = ld_f64(xb + d * 8)
        a1<Float> = ld_f64(xb + (d + 256) * 8)
        a2<Float> = ld_f64(xb + (d + 512) * 8)
        a3<Float> = ld_f64(xb + (d + 768) * 8)
        ss = ss + a0 * a0
        ss = ss + a1 * a1
        ss = ss + a2 * a2
        ss = ss + a3 * a3
        d = d + 1024
    }
    while (d < N) {
        v<Float> = ld_f64(xb + d * 8)
        ss = ss + v * v
        d = d + 256
    }
    st_shared_f64(t, ss)
    kernel_barrier()
    st2<Int> = 128
    # strides 128/64/32 through shared, 16..1 by warp shuffle: lane t adds lane t+st exactly as the
    # shared tree did (same pairs, same order) -> bit-identical, 5 fewer block barriers (2026-10-26).
    while (st2 > 16) {
        if (t < st2) { st_shared_f64(t, ld_shared_f64(t) + ld_shared_f64(t + st2)) }
        kernel_barrier()
        st2 = st2 / 2
    }
    if (t < 32) {
        sw<Float> = ld_shared_f64(t)
        sw = sw + shfl_down_f64(sw, 16)
        sw = sw + shfl_down_f64(sw, 8)
        sw = sw + shfl_down_f64(sw, 4)
        sw = sw + shfl_down_f64(sw, 2)
        sw = sw + shfl_down_f64(sw, 1)
        if (t == 0) { st_shared_f64(0, sw) }
    }
    if (t == 0) {
        # Seeded Newton (Ursela): vsqrt(x, 24) from y0=x is 24 dependent f64 divides on one thread
        # (~6 us on the 3090, half of this kernel). Seed with the classic rsqrt bit trick instead and
        # take 6 steps: identical result for x in [1e-9, 1e9] (checked against the 24-step loop on
        # 300k random x, where both have converged to the same fixed point); outside that range the
        # old loop runs unchanged, so the result is bit-identical everywhere.
        x<Float> = ld_shared_f64(0) / (N as Float) + eps
        sq<Float> = 0.0
        if (x > 0.000000001) {
            if (x < 1000000000.0) {
                # f64_bits / f64_from_bits (Vyb kernel intrinsics, 2026-10-26): register bit casts; was a
                # st_f64 / ld_i64 / st_i64 / ld_f64 round trip through global memory (same bits).
                y<Float> = x * f64_from_bits(6910469410427058089 - f64_bits(x) / 2)
                y = 0.5 * (y + x / y)
                y = 0.5 * (y + x / y)
                y = 0.5 * (y + x / y)
                y = 0.5 * (y + x / y)
                y = 0.5 * (y + x / y)
                y = 0.5 * (y + x / y)
                sq = y
            }
        }
        if (sq == 0.0) { sq = vsqrt(x, 24) }
        st_shared_f64(256, 1.0 / sq)
    }
    kernel_barrier()
    r<Float> = ld_shared_f64(256)
    yb<Int> = Y + row * N * 8
    d2<Int> = t
    while (d2 + 256 < N) {
        xa<Float> = ld_f64(xb + d2 * 8)
        xc<Float> = ld_f64(xb + (d2 + 256) * 8)
        wa<Float> = ld_f64(W + d2 * 8)
        wc<Float> = ld_f64(W + (d2 + 256) * 8)
        ya<Float> = xa * r * wa
        yc<Float> = xc * r * wc
        st_f64(yb + d2 * 8, ya)
        st_f64(yb + (d2 + 256) * 8, yc)
        if (Y32 != 0) {
            st_f32(Y32 + (row * N + d2) * 4, ya)
            st_f32(Y32 + (row * N + d2 + 256) * 4, yc)
        }
        d2 = d2 + 512
    }
    while (d2 < N) {
        xv<Float> = ld_f64(xb + d2 * 8)
        wv<Float> = ld_f64(W + d2 * 8)
        y<Float> = xv * r * wv
        st_f64(yb + d2 * 8, y)
        if (Y32 != 0) { st_f32(Y32 + (row * N + d2) * 4, y) }
        d2 = d2 + 256
    }
}

// ---- rms_blkg (Ursela, 2026-10-26): single-row rms_blk spread over 5 blocks. rms_blk runs on ONE SM,
// where f64 math is 2 FMA/clk: the x*r*w scale pass alone is ~3 us of the ~13 us. Every block repeats the
// identical sum / tree / seeded-Newton (same bits of r), then scales only the 256-element chunks j with
// j % 5 == blk_x(). Same y = x * r * w per element -> bit-identical to rms_blk. X must not alias Y
// (blocks read all of X while others write Y); decode's three hidden-size norms are XC/XM -> XN.
rms_blkg(p<Int>) -> {
    X<Int> = ld_i64(p + 0)
    W<Int> = ld_i64(p + 8)
    Y<Int> = ld_i64(p + 16)
    N<Int> = ld_i64(p + 32)
    eps<Float> = ld_f64(p + 40)
    Y32<Int> = ld_i64(p + 48)
    row<Int> = 0
    g<Int> = blk_x()
    t<Int> = tid_x()
    xb<Int> = X + row * N * 8
    ss<Float> = 0.0
    d<Int> = t
    # 4 loads in flight per trip (Ursela): same elements, same summation order -> bit-identical
    while (d + 768 < N) {
        a0<Float> = ld_f64(xb + d * 8)
        a1<Float> = ld_f64(xb + (d + 256) * 8)
        a2<Float> = ld_f64(xb + (d + 512) * 8)
        a3<Float> = ld_f64(xb + (d + 768) * 8)
        ss = ss + a0 * a0
        ss = ss + a1 * a1
        ss = ss + a2 * a2
        ss = ss + a3 * a3
        d = d + 1024
    }
    while (d < N) {
        v<Float> = ld_f64(xb + d * 8)
        ss = ss + v * v
        d = d + 256
    }
    st_shared_f64(t, ss)
    kernel_barrier()
    st2<Int> = 128
    # strides 128/64/32 through shared, 16..1 by warp shuffle: lane t adds lane t+st exactly as the
    # shared tree did (same pairs, same order) -> bit-identical, 5 fewer block barriers (2026-10-26).
    while (st2 > 16) {
        if (t < st2) { st_shared_f64(t, ld_shared_f64(t) + ld_shared_f64(t + st2)) }
        kernel_barrier()
        st2 = st2 / 2
    }
    if (t < 32) {
        sw<Float> = ld_shared_f64(t)
        sw = sw + shfl_down_f64(sw, 16)
        sw = sw + shfl_down_f64(sw, 8)
        sw = sw + shfl_down_f64(sw, 4)
        sw = sw + shfl_down_f64(sw, 2)
        sw = sw + shfl_down_f64(sw, 1)
        if (t == 0) { st_shared_f64(0, sw) }
    }
    if (t == 0) {
        # Seeded Newton (Ursela): vsqrt(x, 24) from y0=x is 24 dependent f64 divides on one thread
        # (~6 us on the 3090, half of this kernel). Seed with the classic rsqrt bit trick instead and
        # take 6 steps: identical result for x in [1e-9, 1e9] (checked against the 24-step loop on
        # 300k random x, where both have converged to the same fixed point); outside that range the
        # old loop runs unchanged, so the result is bit-identical everywhere.
        x<Float> = ld_shared_f64(0) / (N as Float) + eps
        sq<Float> = 0.0
        if (x > 0.000000001) {
            if (x < 1000000000.0) {
                # f64_bits / f64_from_bits (Vyb kernel intrinsics, 2026-10-26): register bit casts; was a
                # st_f64 / ld_i64 / st_i64 / ld_f64 round trip through global memory (same bits).
                y<Float> = x * f64_from_bits(6910469410427058089 - f64_bits(x) / 2)
                y = 0.5 * (y + x / y)
                y = 0.5 * (y + x / y)
                y = 0.5 * (y + x / y)
                y = 0.5 * (y + x / y)
                y = 0.5 * (y + x / y)
                y = 0.5 * (y + x / y)
                sq = y
            }
        }
        if (sq == 0.0) { sq = vsqrt(x, 24) }
        st_shared_f64(256, 1.0 / sq)
    }
    kernel_barrier()
    r<Float> = ld_shared_f64(256)
    yb<Int> = Y + row * N * 8
    d2<Int> = t + 256 * g
    while (d2 < N) {
        xv<Float> = ld_f64(xb + d2 * 8)
        wv<Float> = ld_f64(W + d2 * 8)
        y<Float> = xv * r * wv
        st_f64(yb + d2 * 8, y)
        if (Y32 != 0) { st_f32(Y32 + (row * N + d2) * 4, y) }
        d2 = d2 + 1280
    }
}

// ---- Parallel KV attention (Ursela, queue item 22). The attn_mx/attn_sum pair ran ONE thread per
// (row, head) -- 32 threads on the whole GPU at decode -- looping serially over all T positions, and
// attn_cxw one thread per (row, head, dim) looping over T; attn_sc read each K row with one thread
// (8-byte loads 8 KB apart across a warp, 25% sector use). Cost grew linearly with position at very
// low parallelism. Same math, still f64 throughout, only reduction ORDER changes (tree / chunked):
// attn_sc2  block = 8 warps = 8 positions of one (row, head); lane l takes dims l, l+32, l+64, l+96
//           (coalesced K reads), 32-lane tree in shared memory.        grid S*H*ceil(T/8) x 256
// attn_smx  block per (row, head): tree max (exact), vexp as attn_ex, tree sum, normalize -- the four
//           mx/ex/sum/nrm launches in one.                              grid S*H x 256
// attn_cx2  block per (row, head, chunk of positions), thread per dim: serial f64 sum over its
//           chunk into PC.                                              grid S*H*CS x HD
// attn_cxr  Ctx = sum of the CS chunk partials in chunk order.          grid ceil(S*H*HD/256) x 256
// Params as attn_sc/attn_cxw, plus PC (chunk partials) @264; CS is fixed at 8.
attn_sc2(p<Int>) -> {
    Q<Int> = ld_i64(p + 80)
    K<Int> = ld_i64(p + 88)
    S<Int> = ld_i64(p + 184)
    HD<Int> = ld_i64(p + 200)
    H<Int> = ld_i64(p + 208)
    KVH<Int> = ld_i64(p + 216)
    P0<Int> = ld_i64(p + 224)
    SC<Int> = ld_i64(p + 232)
    T<Int> = ld_i64(p + 240)
    KE<Int> = ld_i64(p + 272)
    scale<Float> = 0.08838834764831845
    if (HD != 128) { scale = 1.0 / vsqrt(HD as Float, 16) }
    hkv<Int> = H / KVH
    TB<Int> = (T + 7) / 8
    gsh<Int> = blk_x() / TB
    tb<Int> = blk_x() % TB
    s<Int> = gsh / H
    h<Int> = gsh % H
    tid<Int> = tid_x()
    l<Int> = tid % 32
    t<Int> = tb * 8 + tid / 32
    ok<Int> = 0
    if (t < T) { if (t <= P0 + s) { ok = 1 } }
    part<Float> = 0.0
    if (ok == 1) {
        qb<Int> = Q + (s * H * HD + h * HD) * 8
        ia<Int> = l
        if (KE == 4) {
            # f32 K cache (VYB_KV32): widen each element, the dot stays f64
            kb4<Int> = K + (t * KVH * HD + (h / hkv) * HD) * 4
            while (ia < HD) {
                kv4<Float32> = ld_f32(kb4 + ia * 4)
                part = part + ld_f64(qb + ia * 8) * (kv4 as Float)
                ia = ia + 32
            }
        } else {
            kb<Int> = K + (t * KVH * HD + (h / hkv) * HD) * 8
            while (ia < HD) {
                part = part + ld_f64(qb + ia * 8) * ld_f64(kb + ia * 8)
                ia = ia + 32
            }
        }
    }
    st_shared_f64(tid, part)
    kernel_barrier()
    st2<Int> = 16
    while (st2 > 0) {
        if (l < st2) { st_shared_f64(tid, ld_shared_f64(tid) + ld_shared_f64(tid + st2)) }
        kernel_barrier()
        st2 = st2 / 2
    }
    if (l == 0) { if (ok == 1) { st_f64(SC + (gsh * T + t) * 8, ld_shared_f64(tid) * scale) } }
}
attn_smx(p<Int>) -> {
    S<Int> = ld_i64(p + 184)
    H<Int> = ld_i64(p + 208)
    P0<Int> = ld_i64(p + 224)
    SC<Int> = ld_i64(p + 232)
    T<Int> = ld_i64(p + 240)
    EW<Int> = ld_i64(p + 248)
    gsh<Int> = blk_x()
    s<Int> = gsh / H
    n<Int> = P0 + s + 1
    tid<Int> = tid_x()
    sb<Int> = SC + gsh * T * 8
    eb<Int> = EW + gsh * T * 8
    mx<Float> = -1000000000000000000000000000000.0
    t<Int> = tid
    while (t < n) {
        v<Float> = ld_f64(sb + t * 8)
        if (v > mx) { mx = v }
        t = t + 256
    }
    st_shared_f64(tid, mx)
    kernel_barrier()
    st2<Int> = 128
    while (st2 > 0) {
        if (tid < st2) {
            a<Float> = ld_shared_f64(tid)
            b<Float> = ld_shared_f64(tid + st2)
            if (b > a) { st_shared_f64(tid, b) }
        }
        kernel_barrier()
        st2 = st2 / 2
    }
    gm<Float> = ld_shared_f64(0)
    kernel_barrier()
    ss<Float> = 0.0
    t2<Int> = tid
    while (t2 < n) {
        e<Float> = vexp(ld_f64(sb + t2 * 8) - gm)
        st_f64(eb + t2 * 8, e)
        ss = ss + e
        t2 = t2 + 256
    }
    st_shared_f64(tid, ss)
    kernel_barrier()
    st3<Int> = 128
    while (st3 > 0) {
        if (tid < st3) { st_shared_f64(tid, ld_shared_f64(tid) + ld_shared_f64(tid + st3)) }
        kernel_barrier()
        st3 = st3 / 2
    }
    tot<Float> = ld_shared_f64(0)
    E32<Int> = ld_i64(p + 280)
    t3<Int> = tid
    if (E32 != 0) {
        e3<Int> = E32 + gsh * T * 4
        while (t3 < n) {
            st_f32(e3 + t3 * 4, (ld_f64(eb + t3 * 8) / tot) as Float32)
            t3 = t3 + 256
        }
    } else {
        while (t3 < n) {
            st_f64(eb + t3 * 8, ld_f64(eb + t3 * 8) / tot)
            t3 = t3 + 256
        }
    }
}
attn_cx2(p<Int>) -> {
    V<Int> = ld_i64(p + 96)
    S<Int> = ld_i64(p + 184)
    HD<Int> = ld_i64(p + 200)
    H<Int> = ld_i64(p + 208)
    KVH<Int> = ld_i64(p + 216)
    P0<Int> = ld_i64(p + 224)
    T<Int> = ld_i64(p + 240)
    EW<Int> = ld_i64(p + 248)
    PC<Int> = ld_i64(p + 264)
    KE<Int> = ld_i64(p + 272)
    gsh<Int> = blk_x() / 8
    c<Int> = blk_x() % 8
    s<Int> = gsh / H
    h<Int> = gsh % H
    ii<Int> = tid_x()
    n<Int> = P0 + s + 1
    cl<Int> = (n + 7) / 8
    t0<Int> = c * cl
    t1<Int> = t0 + cl
    if (t1 > n) { t1 = n }
    kvh<Int> = h / (H / KVH)
    wb<Int> = EW + gsh * T * 8
    acc<Float> = 0.0
    tc<Int> = t0
    if (KE == 4) {
        while (tc < t1) {
            vv4<Float32> = ld_f32(V + (tc * KVH * HD + kvh * HD + ii) * 4)
            acc = acc + ld_f64(wb + tc * 8) * (vv4 as Float)
            tc = tc + 1
        }
    } else {
        while (tc < t1) {
            acc = acc + ld_f64(wb + tc * 8) * ld_f64(V + (tc * KVH * HD + kvh * HD + ii) * 8)
            tc = tc + 1
        }
    }
    st_f64(PC + ((gsh * 8 + c) * HD + ii) * 8, acc)
}
attn_cxr(p<Int>) -> {
    Ctx<Int> = ld_i64(p + 104)
    S<Int> = ld_i64(p + 184)
    HD<Int> = ld_i64(p + 200)
    H<Int> = ld_i64(p + 208)
    PC<Int> = ld_i64(p + 264)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < S * H * HD) {
        gsh<Int> = gid / HD
        ii<Int> = gid % HD
        acc<Float> = 0.0
        c<Int> = 0
        for (c in 0..7) { acc = acc + ld_f64(PC + ((gsh * 8 + c) * HD + ii) * 8) }
        st_f64(Ctx + gid * 8, acc)
    }
}

// GQA-grouped twins (Ursela): the H/KVH = 4 query heads of a KV group share each K/V row, so one warp
// reads K row t ONCE and forms all 4 head dots (4 partials per lane, one tree for the 4), and one
// thread per dim reads V[t] once into 4 head accumulators. Positions are chunked CS = 32 ways for V.
// attn_sc3 grid S*KVH*ceil(T/8) x 256 (warp = position);  attn_cx3 grid S*KVH*32 x HD;
// attn_cxr3 grid ceil(S*H*HD/256) x 256 (sums the 32 chunk partials in order). Requires H/KVH == 4.
attn_sc3(p<Int>) -> {
    Q<Int> = ld_i64(p + 80)
    K<Int> = ld_i64(p + 88)
    S<Int> = ld_i64(p + 184)
    HD<Int> = ld_i64(p + 200)
    H<Int> = ld_i64(p + 208)
    KVH<Int> = ld_i64(p + 216)
    P0<Int> = ld_i64(p + 224)
    SC<Int> = ld_i64(p + 232)
    T<Int> = ld_i64(p + 240)
    KE<Int> = ld_i64(p + 272)
    scale<Float> = 0.08838834764831845
    if (HD != 128) { scale = 1.0 / vsqrt(HD as Float, 16) }
    TB<Int> = (T + 7) / 8
    gk<Int> = blk_x() / TB
    tb<Int> = blk_x() % TB
    s<Int> = gk / KVH
    g<Int> = gk % KVH
    tid<Int> = tid_x()
    l<Int> = tid % 32
    t<Int> = tb * 8 + tid / 32
    ok<Int> = 0
    if (t < T) { if (t <= P0 + s) { ok = 1 } }
    p0<Float> = 0.0
    p1<Float> = 0.0
    p2<Float> = 0.0
    p3<Float> = 0.0
    if (ok == 1) {
        qb<Int> = Q + (s * H * HD + g * 4 * HD) * 8
        kb<Int> = K + (t * KVH * HD + g * HD) * KE
        ia<Int> = l
        while (ia < HD) {
            kv<Float> = 0.0
            if (KE == 4) {
                k4<Float32> = ld_f32(kb + ia * 4)
                kv = k4 as Float
            } else { kv = ld_f64(kb + ia * 8) }
            p0 = p0 + ld_f64(qb + ia * 8) * kv
            p1 = p1 + ld_f64(qb + (HD + ia) * 8) * kv
            p2 = p2 + ld_f64(qb + (2 * HD + ia) * 8) * kv
            p3 = p3 + ld_f64(qb + (3 * HD + ia) * 8) * kv
            ia = ia + 32
        }
    }
    st_shared_f64(tid * 4, p0)
    st_shared_f64(tid * 4 + 1, p1)
    st_shared_f64(tid * 4 + 2, p2)
    st_shared_f64(tid * 4 + 3, p3)
    kernel_barrier()
    st2<Int> = 16
    while (st2 > 0) {
        if (l < st2) {
            j<Int> = 0
            for (j in 0..3) { st_shared_f64(tid * 4 + j, ld_shared_f64(tid * 4 + j) + ld_shared_f64((tid + st2) * 4 + j)) }
        }
        kernel_barrier()
        st2 = st2 / 2
    }
    if (l < 4) {
        if (ok == 1) {
            hh<Int> = g * 4 + l
            st_f64(SC + ((s * H + hh) * T + t) * 8, ld_shared_f64((tid - l) * 4 + l) * scale)
        }
    }
}
attn_cx3(p<Int>) -> {
    V<Int> = ld_i64(p + 96)
    S<Int> = ld_i64(p + 184)
    HD<Int> = ld_i64(p + 200)
    H<Int> = ld_i64(p + 208)
    KVH<Int> = ld_i64(p + 216)
    P0<Int> = ld_i64(p + 224)
    T<Int> = ld_i64(p + 240)
    EW<Int> = ld_i64(p + 248)
    PC<Int> = ld_i64(p + 264)
    KE<Int> = ld_i64(p + 272)
    gk<Int> = blk_x() / 32
    c<Int> = blk_x() % 32
    s<Int> = gk / KVH
    g<Int> = gk % KVH
    ii<Int> = tid_x()
    n<Int> = P0 + s + 1
    cl<Int> = (n + 31) / 32
    t0<Int> = c * cl
    t1<Int> = t0 + cl
    if (t1 > n) { t1 = n }
    w0<Int> = EW + (s * H + g * 4) * T * 8
    a0<Float> = 0.0
    a1<Float> = 0.0
    a2<Float> = 0.0
    a3<Float> = 0.0
    tc<Int> = t0
    while (tc < t1) {
        vv<Float> = 0.0
        if (KE == 4) {
            v4<Float32> = ld_f32(V + (tc * KVH * HD + g * HD + ii) * 4)
            vv = v4 as Float
        } else { vv = ld_f64(V + (tc * KVH * HD + g * HD + ii) * 8) }
        a0 = a0 + ld_f64(w0 + tc * 8) * vv
        a1 = a1 + ld_f64(w0 + (T + tc) * 8) * vv
        a2 = a2 + ld_f64(w0 + (2 * T + tc) * 8) * vv
        a3 = a3 + ld_f64(w0 + (3 * T + tc) * 8) * vv
        tc = tc + 1
    }
    hb<Int> = s * H + g * 4
    st_f64(PC + (((hb + 0) * 32 + c) * HD + ii) * 8, a0)
    st_f64(PC + (((hb + 1) * 32 + c) * HD + ii) * 8, a1)
    st_f64(PC + (((hb + 2) * 32 + c) * HD + ii) * 8, a2)
    st_f64(PC + (((hb + 3) * 32 + c) * HD + ii) * 8, a3)
}
attn_cxr3(p<Int>) -> {
    Ctx<Int> = ld_i64(p + 104)
    S<Int> = ld_i64(p + 184)
    HD<Int> = ld_i64(p + 200)
    H<Int> = ld_i64(p + 208)
    PC<Int> = ld_i64(p + 264)
    C32<Int> = ld_i64(p + 192)   # optional f32 copy of the context (replaces the cast32 launch)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < S * H * HD) {
        gsh<Int> = gid / HD
        ii<Int> = gid % HD
        acc<Float> = 0.0
        c<Int> = 0
        for (c in 0..31) { acc = acc + ld_f64(PC + ((gsh * 32 + c) * HD + ii) * 8) }
        st_f64(Ctx + gid * 8, acc)
        if (C32 != 0) { st_f32(C32 + gid * 4, acc) }
    }
}

// f32-math attention (Ursela, item 22, VYB_ATTN=4; needs the f32 K/V cache). GB10 runs f64 at a small
// fraction of f32, and at T ~ 1k the f64 FMAs of the score dots and the weighted V sum were the cost
// (KV bytes were not: halving them changed nothing). Scores: Q narrowed to f32 per lane, f32 dots, then
// the tree on the widened partials (Vyb has no f32 shared-memory ops), stored f64 for the (unchanged, f64) softmax; the softmax also writes f32
// weights (EW32) that attn_cx4 consumes with f32 V into f32 accumulators; chunk partials are stored f64
// and attn_cxr3 sums them as before. Same grids as attn_sc3 / attn_cx3.
attn_sc4(p<Int>) -> {
    Q<Int> = ld_i64(p + 80)
    K<Int> = ld_i64(p + 88)
    S<Int> = ld_i64(p + 184)
    HD<Int> = ld_i64(p + 200)
    H<Int> = ld_i64(p + 208)
    KVH<Int> = ld_i64(p + 216)
    P0<Int> = ld_i64(p + 224)
    SC<Int> = ld_i64(p + 232)
    T<Int> = ld_i64(p + 240)
    scale<Float> = 0.08838834764831845
    if (HD != 128) { scale = 1.0 / vsqrt(HD as Float, 16) }
    TB<Int> = (T + 7) / 8
    gk<Int> = blk_x() / TB
    tb<Int> = blk_x() % TB
    s<Int> = gk / KVH
    g<Int> = gk % KVH
    # causal early exit (Ursela, prefill): a block whose first position is past every query row it serves
    # has nothing to store; it now skips the dot products and the shared tree (block-uniform branch)
    if (tb * 8 <= P0 + s) {
        tid<Int> = tid_x()
        l<Int> = tid % 32
        t<Int> = tb * 8 + tid / 32
        ok<Int> = 0
        if (t < T) { if (t <= P0 + s) { ok = 1 } }
        z<Float32> = 0.0 as Float32
        p0<Float32> = z
        p1<Float32> = z
        p2<Float32> = z
        p3<Float32> = z
        if (ok == 1) {
            qb<Int> = Q + (s * H * HD + g * 4 * HD) * 8
            kb<Int> = K + (t * KVH * HD + g * HD) * 4
            ia<Int> = l
            while (ia < HD) {
                kv<Float32> = ld_f32(kb + ia * 4)
                q0<Float32> = ld_f64(qb + ia * 8) as Float32
                q1<Float32> = ld_f64(qb + (HD + ia) * 8) as Float32
                q2<Float32> = ld_f64(qb + (2 * HD + ia) * 8) as Float32
                q3<Float32> = ld_f64(qb + (3 * HD + ia) * 8) as Float32
                p0 = p0 + q0 * kv
                p1 = p1 + q1 * kv
                p2 = p2 + q2 * kv
                p3 = p3 + q3 * kv
                ia = ia + 32
            }
        }
        // no f32 shared-memory intrinsics in Vyb (only ld/st_shared_f64): the tree runs on the widened partials
        st_shared_f64(tid * 4, p0 as Float)
        st_shared_f64(tid * 4 + 1, p1 as Float)
        st_shared_f64(tid * 4 + 2, p2 as Float)
        st_shared_f64(tid * 4 + 3, p3 as Float)
        kernel_barrier()
        # packed tree (Ursela): the 4 values' active pairs share the 32 lanes (2+1+1+1+1 warp steps instead of
        # 5 x 4 serial f64 adds); same pairs, same order -> bit-identical
        wb<Int> = (tid - l) * 4
        st2<Int> = 16
        while (st2 > 0) {
            pc<Int> = l
            while (pc < 4 * st2) {
                jv<Int> = pc / st2
                li<Int> = pc % st2
                st_shared_f64(wb + li * 4 + jv, ld_shared_f64(wb + li * 4 + jv) + ld_shared_f64(wb + (li + st2) * 4 + jv))
                pc = pc + 32
            }
            kernel_barrier()
            st2 = st2 / 2
        }
        if (l < 4) {
            if (ok == 1) {
                hh<Int> = g * 4 + l
                st_f64(SC + ((s * H + hh) * T + t) * 8, ld_shared_f64((tid - l) * 4 + l) * scale)
            }
        }
    }
}
attn_cx4(p<Int>) -> {
    V<Int> = ld_i64(p + 96)
    S<Int> = ld_i64(p + 184)
    HD<Int> = ld_i64(p + 200)
    H<Int> = ld_i64(p + 208)
    KVH<Int> = ld_i64(p + 216)
    P0<Int> = ld_i64(p + 224)
    T<Int> = ld_i64(p + 240)
    PC<Int> = ld_i64(p + 264)
    E32<Int> = ld_i64(p + 280)
    gk<Int> = blk_x() / 32
    c<Int> = blk_x() % 32
    s<Int> = gk / KVH
    g<Int> = gk % KVH
    ii<Int> = tid_x()
    n<Int> = P0 + s + 1
    cl<Int> = (n + 31) / 32
    t0<Int> = c * cl
    t1<Int> = t0 + cl
    if (t1 > n) { t1 = n }
    w0<Int> = E32 + (s * H + g * 4) * T * 4
    z<Float32> = 0.0 as Float32
    a0<Float32> = z
    a1<Float32> = z
    a2<Float32> = z
    a3<Float32> = z
    tc<Int> = t0
    while (tc < t1) {
        vv<Float32> = ld_f32(V + (tc * KVH * HD + g * HD + ii) * 4)
        e0<Float32> = ld_f32(w0 + tc * 4)
        e1<Float32> = ld_f32(w0 + (T + tc) * 4)
        e2<Float32> = ld_f32(w0 + (2 * T + tc) * 4)
        e3<Float32> = ld_f32(w0 + (3 * T + tc) * 4)
        a0 = a0 + e0 * vv
        a1 = a1 + e1 * vv
        a2 = a2 + e2 * vv
        a3 = a3 + e3 * vv
        tc = tc + 1
    }
    hb<Int> = s * H + g * 4
    st_f64(PC + (((hb + 0) * 32 + c) * HD + ii) * 8, a0 as Float)
    st_f64(PC + (((hb + 1) * 32 + c) * HD + ii) * 8, a1 as Float)
    st_f64(PC + (((hb + 2) * 32 + c) * HD + ii) * 8, a2 as Float)
    st_f64(PC + (((hb + 3) * 32 + c) * HD + ii) * 8, a3 as Float)
}

// silu with the f32 store (Ursela, launch fusion): the same f64 silu value, narrowed like cast32 does, so
// the down-projection input is bit-identical and the separate cast32 launch disappears.
silu32(g<Int>, u<Int>, h<Int>, n<Int>) -> {
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < n) {
        gv<Float> = ld_f64(g + gid * 8)
        uv<Float> = ld_f64(u + gid * 8)
        sg<Float> = 1.0 / (1.0 + vexp(0.0 - gv))
        hv<Float> = gv * sg * uv
        st_f32(h + gid * 4, hv)
    }
}

// q-norm + k-norm + RoPE in ONE launch (Ursela, launch fusion; was rms_blk x2 + qwen3rope). One block of
// HD = 128 threads per (row, head) over the S*H q heads then the S*KVH k heads. Same f64 math as
// rms_blk (its 256-thread tree's first step only adds the +0.0 partials of idle threads, exact) and
// as qwen3rope's table path (TB != 0), so the rotated q/k are bit-identical. RoPE params at ROP+80
// (RPB) plus z2 = q src, z3 = k src, z4 = q-norm weight, z5 = k-norm weight, z6 = a rms_blk param
// block (eps at +40). q/k-norm outputs (xn rows) double as the rsqrt bit-trick scratch, as in rms_blk.
qknrope(p<Int>) -> {
    XQ<Int> = ld_i64(p + 80)
    XK<Int> = ld_i64(p + 88)
    Qd<Int> = ld_i64(p + 96)
    Kd<Int> = ld_i64(p + 104)
    TB<Int> = ld_i64(p + 112)
    KE4<Int> = ld_i64(p + 120)
    SQ<Int> = ld_i64(p + 128)
    SK<Int> = ld_i64(p + 136)
    WQ<Int> = ld_i64(p + 144)
    WK<Int> = ld_i64(p + 152)
    eps<Float> = ld_f64(ld_i64(p + 160) + 40)
    S<Int> = ld_i64(p + 184)
    HD<Int> = ld_i64(p + 200)
    H<Int> = ld_i64(p + 208)
    KVH<Int> = ld_i64(p + 216)
    POS<Int> = ld_i64(p + 224)
    half<Int> = HD / 2
    b<Int> = blk_x()
    t<Int> = tid_x()
    isq<Int> = 1
    rb<Int> = b
    if (b >= S * H) { isq = 0; rb = b - S * H }
    src<Int> = SQ + rb * HD * 8
    wt<Int> = WQ
    xn<Int> = XQ + rb * HD * 8
    s<Int> = rb / H
    if (isq == 0) {
        src = SK + rb * HD * 8
        wt = WK
        xn = XK + rb * HD * 8
        s = rb / KVH
    }
    v<Float> = ld_f64(src + t * 8)
    ss<Float> = 0.0
    ss = ss + v * v
    st_shared_f64(t, ss)
    kernel_barrier()
    st2<Int> = 64
    while (st2 > 0) {
        if (t < st2) { st_shared_f64(t, ld_shared_f64(t) + ld_shared_f64(t + st2)) }
        kernel_barrier()
        st2 = st2 / 2
    }
    if (t == 0) {
        x<Float> = ld_shared_f64(0) / (HD as Float) + eps
        sq<Float> = 0.0
        if (x > 0.000000001) {
            if (x < 1000000000.0) {
                # f64_bits / f64_from_bits (Vyb kernel intrinsics, 2026-10-26): register bit casts; was a
                # st_f64 / ld_i64 / st_i64 / ld_f64 round trip through global memory (same bits).
                y<Float> = x * f64_from_bits(6910469410427058089 - f64_bits(x) / 2)
                y = 0.5 * (y + x / y)
                y = 0.5 * (y + x / y)
                y = 0.5 * (y + x / y)
                y = 0.5 * (y + x / y)
                y = 0.5 * (y + x / y)
                y = 0.5 * (y + x / y)
                sq = y
            }
        }
        if (sq == 0.0) { sq = vsqrt(x, 24) }
        st_shared_f64(256, 1.0 / sq)
    }
    kernel_barrier()
    r<Float> = ld_shared_f64(256)
    xv<Float> = ld_f64(src + t * 8)
    wv<Float> = ld_f64(wt + t * 8)
    yn<Float> = xv * r * wv
    st_shared_f64(t, yn)
    kernel_barrier()
    tix<Int> = TB + ((POS + s) * half + t % half) * 16
    c<Float> = ld_f64(tix)
    sn<Float> = ld_f64(tix + 8)
    o<Float> = 0.0
    if (t < half) {
        v1<Float> = ld_shared_f64(t + half)
        o = yn * c - v1 * sn
    } else {
        v1b<Float> = ld_shared_f64(t - half)
        o = yn * c + v1b * sn
    }
    if (isq == 1) {
        st_f64(Qd + (rb * HD + t) * 8, o)
    } else {
        if (KE4 == 4) { st_f32(Kd + (rb * HD + t) * 4, o as Float32) } else { st_f64(Kd + (rb * HD + t) * 8, o) }
    }
}

// Register-tiled prefill GEMM pass 1 (Ursela, long-prompt prefill): drop-in for gemm16_p (same params,
// same split-K ranges, same SK partial layout -> gemm32_r unchanged). One warp computes 8 rows x 256
// columns: lane l owns columns c0 + l + 32 j (j < 8), so every f16 B load is one coalesced 64-byte line
// and every A load is a warp broadcast; 64 accumulators per thread. Each output still accumulates
// a*b over k = k0..k1-1 in order with the same f32 expressions -> bit-identical to gemm16_p.
// Needs N % 256 == 0 (all Qwen3-4B shapes: 1024, 2560, 4096, 9728).
gemm16_t(p<Int>) -> {
    A<Int> = ld_i64(p + 0)
    B<Int> = ld_i64(p + 8)
    SK<Int> = ld_i64(p + 16)
    M<Int> = ld_i64(p + 24)
    N<Int> = ld_i64(p + 32)
    K<Int> = ld_i64(p + 40)
    KSP<Int> = ld_i64(p + 56)
