            a2_2 = a2_2 + a1v2 * b1v2
            a2_3 = a2_3 + a1v2 * b1v3
            a2_4 = a2_4 + a1v2 * b1v4
            a2_5 = a2_5 + a1v2 * b1v5
            a2_6 = a2_6 + a1v2 * b1v6
            a2_7 = a2_7 + a1v2 * b1v7
            a3_0 = a3_0 + a1v3 * b1v0
            a3_1 = a3_1 + a1v3 * b1v1
            a3_2 = a3_2 + a1v3 * b1v2
            a3_3 = a3_3 + a1v3 * b1v3
            a3_4 = a3_4 + a1v3 * b1v4
