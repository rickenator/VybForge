            a3_4 = a3_4 + a0v3 * b0v4
            a3_5 = a3_5 + a0v3 * b0v5
            a3_6 = a3_6 + a0v3 * b0v6
            a3_7 = a3_7 + a0v3 * b0v7
            a4_0 = a4_0 + a0v4 * b0v0
            a4_1 = a4_1 + a0v4 * b0v1
            a4_2 = a4_2 + a0v4 * b0v2
            a4_3 = a4_3 + a0v4 * b0v3
            a4_4 = a4_4 + a0v4 * b0v4
            a4_5 = a4_5 + a0v4 * b0v5
            a4_6 = a4_6 + a0v4 * b0v6
            a4_7 = a4_7 + a0v4 * b0v7
            a5_0 = a5_0 + a0v5 * b0v0
            a5_1 = a5_1 + a0v5 * b0v1
            a5_2 = a5_2 + a0v5 * b0v2
            a5_3 = a5_3 + a0v5 * b0v3
            a5_4 = a5_4 + a0v5 * b0v4
            a5_5 = a5_5 + a0v5 * b0v5
            a5_6 = a5_6 + a0v5 * b0v6
            a5_7 = a5_7 + a0v5 * b0v7
            a6_0 = a6_0 + a0v6 * b0v0
            a6_1 = a6_1 + a0v6 * b0v1
            a6_2 = a6_2 + a0v6 * b0v2
            a6_3 = a6_3 + a0v6 * b0v3
            a6_4 = a6_4 + a0v6 * b0v4
            a6_5 = a6_5 + a0v6 * b0v5
            a6_6 = a6_6 + a0v6 * b0v6
            a6_7 = a6_7 + a0v6 * b0v7
            a7_0 = a7_0 + a0v7 * b0v0
            a7_1 = a7_1 + a0v7 * b0v1
            a7_2 = a7_2 + a0v7 * b0v2
            a7_3 = a7_3 + a0v7 * b0v3
            a7_4 = a7_4 + a0v7 * b0v4
            a7_5 = a7_5 + a0v7 * b0v5
            a7_6 = a7_6 + a0v7 * b0v6
            a7_7 = a7_7 + a0v7 * b0v7
            b1v0<Float32> = ld_f16(pb1 + 0)
            b1v1<Float32> = ld_f16(pb1 + 64)
            b1v2<Float32> = ld_f16(pb1 + 128)
            b1v3<Float32> = ld_f16(pb1 + 192)
            b1v4<Float32> = ld_f16(pb1 + 256)
            b1v5<Float32> = ld_f16(pb1 + 320)
            b1v6<Float32> = ld_f16(pb1 + 384)
            b1v7<Float32> = ld_f16(pb1 + 448)
            a1v0<Float32> = ld_f32(pa + 32)
            a1v1<Float32> = ld_f32(pa + 36)
            a1v2<Float32> = ld_f32(pa + 40)
            a1v3<Float32> = ld_f32(pa + 44)
            a1v4<Float32> = ld_f32(pa + 48)
            a1v5<Float32> = ld_f32(pa + 52)
