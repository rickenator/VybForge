            a0v1<Float32> = ld_f32(pa + 4)
            a0v2<Float32> = ld_f32(pa + 8)
            a0v3<Float32> = ld_f32(pa + 12)
            a0v4<Float32> = ld_f32(pa + 16)
            a0v5<Float32> = ld_f32(pa + 20)
            a0v6<Float32> = ld_f32(pa + 24)
            a0v7<Float32> = ld_f32(pa + 28)
            a0_0 = a0_0 + a0v0 * b0v0
            a0_1 = a0_1 + a0v0 * b0v1
            a0_2 = a0_2 + a0v0 * b0v2
            a0_3 = a0_3 + a0v0 * b0v3
            a0_4 = a0_4 + a0v0 * b0v4
            a0_5 = a0_5 + a0v0 * b0v5
            a0_6 = a0_6 + a0v0 * b0v6
            a0_7 = a0_7 + a0v0 * b0v7
