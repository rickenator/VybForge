        p2_31 = p2_31 + q2_127 * k127
        q3_127<Float32> = ld_f32(qb + 2044)
        p3_31 = p3_31 + q3_127 * k127
        v0_0<Float> = (p0_0 as Float) + (p0_16 as Float)
        v0_1<Float> = (p0_1 as Float) + (p0_17 as Float)
        v0_2<Float> = (p0_2 as Float) + (p0_18 as Float)
        v0_3<Float> = (p0_3 as Float) + (p0_19 as Float)
        v0_4<Float> = (p0_4 as Float) + (p0_20 as Float)
        v0_5<Float> = (p0_5 as Float) + (p0_21 as Float)
        v0_6<Float> = (p0_6 as Float) + (p0_22 as Float)
        v0_7<Float> = (p0_7 as Float) + (p0_23 as Float)
        v0_8<Float> = (p0_8 as Float) + (p0_24 as Float)
        v0_9<Float> = (p0_9 as Float) + (p0_25 as Float)
        v0_10<Float> = (p0_10 as Float) + (p0_26 as Float)
        v0_11<Float> = (p0_11 as Float) + (p0_27 as Float)
        v0_12<Float> = (p0_12 as Float) + (p0_28 as Float)
        v0_13<Float> = (p0_13 as Float) + (p0_29 as Float)
        v0_14<Float> = (p0_14 as Float) + (p0_30 as Float)
        v0_15<Float> = (p0_15 as Float) + (p0_31 as Float)
        v0_0 = v0_0 + v0_8
        v0_1 = v0_1 + v0_9
        v0_2 = v0_2 + v0_10
        v0_3 = v0_3 + v0_11
        v0_4 = v0_4 + v0_12
        v0_5 = v0_5 + v0_13
        v0_6 = v0_6 + v0_14
        v0_7 = v0_7 + v0_15
        v0_0 = v0_0 + v0_4
        v0_1 = v0_1 + v0_5
        v0_2 = v0_2 + v0_6
        v0_3 = v0_3 + v0_7
        v0_0 = v0_0 + v0_2
        v0_1 = v0_1 + v0_3
        v0_0 = v0_0 + v0_1
        st_f64(SC + ((s * H + g * 4 + 0) * T + t) * 8, v0_0 * scale)
        v1_0<Float> = (p1_0 as Float) + (p1_16 as Float)
        v1_1<Float> = (p1_1 as Float) + (p1_17 as Float)
        v1_2<Float> = (p1_2 as Float) + (p1_18 as Float)
        v1_3<Float> = (p1_3 as Float) + (p1_19 as Float)
        v1_4<Float> = (p1_4 as Float) + (p1_20 as Float)
        v1_5<Float> = (p1_5 as Float) + (p1_21 as Float)
        v1_6<Float> = (p1_6 as Float) + (p1_22 as Float)
        v1_7<Float> = (p1_7 as Float) + (p1_23 as Float)
        v1_8<Float> = (p1_8 as Float) + (p1_24 as Float)
        v1_9<Float> = (p1_9 as Float) + (p1_25 as Float)
        v1_10<Float> = (p1_10 as Float) + (p1_26 as Float)
        v1_11<Float> = (p1_11 as Float) + (p1_27 as Float)
        v1_12<Float> = (p1_12 as Float) + (p1_28 as Float)
        v1_13<Float> = (p1_13 as Float) + (p1_29 as Float)
        v1_14<Float> = (p1_14 as Float) + (p1_30 as Float)
        v1_15<Float> = (p1_15 as Float) + (p1_31 as Float)
        v1_0 = v1_0 + v1_8
        v1_1 = v1_1 + v1_9
        v1_2 = v1_2 + v1_10
        v1_3 = v1_3 + v1_11
        v1_4 = v1_4 + v1_12
        v1_5 = v1_5 + v1_13
        v1_6 = v1_6 + v1_14
        v1_7 = v1_7 + v1_15
        v1_0 = v1_0 + v1_4
        v1_1 = v1_1 + v1_5
        v1_2 = v1_2 + v1_6
        v1_3 = v1_3 + v1_7
        v1_0 = v1_0 + v1_2
        v1_1 = v1_1 + v1_3
        v1_0 = v1_0 + v1_1
        st_f64(SC + ((s * H + g * 4 + 1) * T + t) * 8, v1_0 * scale)
        v2_0<Float> = (p2_0 as Float) + (p2_16 as Float)
        v2_1<Float> = (p2_1 as Float) + (p2_17 as Float)
        v2_2<Float> = (p2_2 as Float) + (p2_18 as Float)
        v2_3<Float> = (p2_3 as Float) + (p2_19 as Float)
        v2_4<Float> = (p2_4 as Float) + (p2_20 as Float)
        v2_5<Float> = (p2_5 as Float) + (p2_21 as Float)
        v2_6<Float> = (p2_6 as Float) + (p2_22 as Float)
        v2_7<Float> = (p2_7 as Float) + (p2_23 as Float)
        v2_8<Float> = (p2_8 as Float) + (p2_24 as Float)
        v2_9<Float> = (p2_9 as Float) + (p2_25 as Float)
        v2_10<Float> = (p2_10 as Float) + (p2_26 as Float)
        v2_11<Float> = (p2_11 as Float) + (p2_27 as Float)
        v2_12<Float> = (p2_12 as Float) + (p2_28 as Float)
        v2_13<Float> = (p2_13 as Float) + (p2_29 as Float)
        v2_14<Float> = (p2_14 as Float) + (p2_30 as Float)
        v2_15<Float> = (p2_15 as Float) + (p2_31 as Float)
        v2_0 = v2_0 + v2_8
        v2_1 = v2_1 + v2_9
        v2_2 = v2_2 + v2_10
        v2_3 = v2_3 + v2_11
        v2_4 = v2_4 + v2_12
        v2_5 = v2_5 + v2_13
        v2_6 = v2_6 + v2_14
        v2_7 = v2_7 + v2_15
        v2_0 = v2_0 + v2_4
        v2_1 = v2_1 + v2_5
        v2_2 = v2_2 + v2_6
        v2_3 = v2_3 + v2_7
        v2_0 = v2_0 + v2_2
        v2_1 = v2_1 + v2_3
        v2_0 = v2_0 + v2_1
        st_f64(SC + ((s * H + g * 4 + 2) * T + t) * 8, v2_0 * scale)
        v3_0<Float> = (p3_0 as Float) + (p3_16 as Float)
        v3_1<Float> = (p3_1 as Float) + (p3_17 as Float)
        v3_2<Float> = (p3_2 as Float) + (p3_18 as Float)
        v3_3<Float> = (p3_3 as Float) + (p3_19 as Float)
        v3_4<Float> = (p3_4 as Float) + (p3_20 as Float)
        v3_5<Float> = (p3_5 as Float) + (p3_21 as Float)
        v3_6<Float> = (p3_6 as Float) + (p3_22 as Float)
        v3_7<Float> = (p3_7 as Float) + (p3_23 as Float)
        v3_8<Float> = (p3_8 as Float) + (p3_24 as Float)
        v3_9<Float> = (p3_9 as Float) + (p3_25 as Float)
        v3_10<Float> = (p3_10 as Float) + (p3_26 as Float)
        v3_11<Float> = (p3_11 as Float) + (p3_27 as Float)
        v3_12<Float> = (p3_12 as Float) + (p3_28 as Float)
        v3_13<Float> = (p3_13 as Float) + (p3_29 as Float)
        v3_14<Float> = (p3_14 as Float) + (p3_30 as Float)
        v3_15<Float> = (p3_15 as Float) + (p3_31 as Float)
        v3_0 = v3_0 + v3_8
        v3_1 = v3_1 + v3_9
        v3_2 = v3_2 + v3_10
        v3_3 = v3_3 + v3_11
        v3_4 = v3_4 + v3_12
        v3_5 = v3_5 + v3_13
        v3_6 = v3_6 + v3_14
        v3_7 = v3_7 + v3_15
        v3_0 = v3_0 + v3_4
        v3_1 = v3_1 + v3_5
        v3_2 = v3_2 + v3_6
        v3_3 = v3_3 + v3_7
        v3_0 = v3_0 + v3_2
        v3_1 = v3_1 + v3_3
        v3_0 = v3_0 + v3_1
        st_f64(SC + ((s * H + g * 4 + 3) * T + t) * 8, v3_0 * scale)
    } }
}

// attn_kt (Ursela): K cache rows [t][g][128] f32 -> PC as [g][128][T] f32 for attn_sc5. Grid over T*KVH*128.
attn_kt(p<Int>) -> {
    K<Int> = ld_i64(p + 88)
    KVH<Int> = ld_i64(p + 216)
    T<Int> = ld_i64(p + 240)
    PC<Int> = ld_i64(p + 264)
    gid<Int> = blk_x() * dim_x() + tid_x()
    NK<Int> = T * KVH * 128
    if (gid < NK) {
        t<Int> = gid % T
        r<Int> = gid / T
        v<Float32> = ld_f32(K + (t * KVH * 128 + r) * 4)
        st_f32(PC + gid * 4, v)
    } else {
        # then Q (f64, [S][H][128]) -> f32 right after it (same value attn_sc4 rounds to)
        Q<Int> = ld_i64(p + 80)
        S<Int> = ld_i64(p + 184)
        H<Int> = ld_i64(p + 208)
        qi<Int> = gid - NK
        if (qi < S * H * 128) {
            qv<Float32> = ld_f64(Q + qi * 8) as Float32
            st_f32(PC + ((NK * 4 + 255) / 256) * 256 + qi * 4, qv)
        }
    }
}

// attn_cx5 (Ursela): attn_cx4 + attn_cxr3 in one pass with no [S, H, 32, HD] f64 partial buffer (537 MB
// at S=512). Thread (s, g, ii) walks attn_cx4's 32 position chunks in order, sums each in f32 exactly as
// attn_cx4 did, and adds the chunk sums in f64 in chunk order as attn_cxr3 did -> bit-identical context.
// Grid: S * KVH blocks of HD threads.
attn_cx5(p<Int>) -> {
    V<Int> = ld_i64(p + 96)
    Ctx<Int> = ld_i64(p + 104)
    S<Int> = ld_i64(p + 184)
    C32<Int> = ld_i64(p + 192)
    HD<Int> = ld_i64(p + 200)
    H<Int> = ld_i64(p + 208)
    KVH<Int> = ld_i64(p + 216)
    P0<Int> = ld_i64(p + 224)
    T<Int> = ld_i64(p + 240)
    E32<Int> = ld_i64(p + 280)
    gk<Int> = blk_x()
    s<Int> = gk / KVH
    g<Int> = gk % KVH
    ii<Int> = tid_x()
    n<Int> = P0 + s + 1
    cl<Int> = (n + 31) / 32
    w0<Int> = E32 + (s * H + g * 4) * T * 4
    z<Float32> = 0.0 as Float32
    c0<Float> = 0.0
    c1<Float> = 0.0
    c2<Float> = 0.0
    c3<Float> = 0.0
    c<Int> = 0
    for (c in 0..31) {
        t0<Int> = c * cl
        t1<Int> = t0 + cl
        if (t1 > n) { t1 = n }
        a0<Float32> = z
        a1<Float32> = z
        a2<Float32> = z
        a3<Float32> = z
        tc<Int> = t0
        while (tc < t1) {
            vv<Float32> = ld_f32(V + (tc * KVH * HD + g * HD + ii) * 4)
            e0<Float32> = ld_f32(w0 + tc * 4)
            e1<Float32> = ld_f32(w0 + (T + tc) * 4)
            e2<Float32> = ld_f32(w0 + (2 * T + tc) * 4)
            e3<Float32> = ld_f32(w0 + (3 * T + tc) * 4)
            a0 = a0 + e0 * vv
            a1 = a1 + e1 * vv
            a2 = a2 + e2 * vv
            a3 = a3 + e3 * vv
            tc = tc + 1
        }
        c0 = c0 + (a0 as Float)
        c1 = c1 + (a1 as Float)
        c2 = c2 + (a2 as Float)
        c3 = c3 + (a3 as Float)
    }
    hb<Int> = s * H + g * 4
    st_f64(Ctx + ((hb + 0) * HD + ii) * 8, c0)
    st_f64(Ctx + ((hb + 1) * HD + ii) * 8, c1)
    st_f64(Ctx + ((hb + 2) * HD + ii) * 8, c2)
    st_f64(Ctx + ((hb + 3) * HD + ii) * 8, c3)
    if (C32 != 0) {
        st_f32(C32 + ((hb + 0) * HD + ii) * 4, c0)
        st_f32(C32 + ((hb + 1) * HD + ii) * 4, c1)
        st_f32(C32 + ((hb + 2) * HD + ii) * 4, c2)
        st_f32(C32 + ((hb + 3) * HD + ii) * 4, c3)
    }
}
