            a2_5 = a2_5 + a0v2 * b0v5
            a2_6 = a2_6 + a0v2 * b0v6
            a2_7 = a2_7 + a0v2 * b0v7
            a3_0 = a3_0 + a0v3 * b0v0
            a3_1 = a3_1 + a0v3 * b0v1
            a3_2 = a3_2 + a0v3 * b0v2
