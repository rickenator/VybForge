// GGUF block_q4_K dequant kernel (Q4_K_M model weights), ported faithfully from
// llama.cpp ggml-quants.c dequantize_row_q4_K / get_scale_min_k4.
// Derived from llama.cpp (MIT License, https://github.com/ggml-org/llama.cpp):
// ggml-quants.c, dequantize_row_q4_K / get_scale_min_k4. See THIRD-PARTY.md.
// block layout (144 B): d f16 @0, dmin f16 @2, scales[12] @4, qs[128] @16.
//   256 values/block; 8 groups of 32; group is: sc,m = 6-bit scale & min packed
//   in scales[]; element uses low (is even) or high (is odd) 4-bit nibble of qs.
// Thread = one output element (Float, 8 bytes). Launch via cuda_launch4i.
q4kdeq(q<Int>, o<Int>, n<Int>, z<Int>) -> {
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < n) {
        # Thread->element mapping (VybForge#23): the destination is the TRANSPOSED [in,out] copy, so
        # exactly one side of the transpose can be coalesced. Take the WRITE: consecutive gid map to
        # consecutive rr (the destination's fast index), which makes the 8-byte f64 stores contiguous
        # and pushes the scatter onto the packed source (~0.56 B/element, ~14x less traffic). The
        # element's source position is gsrc = rr*z + cc, decoded exactly as before.
        #
        # z == 0 IS A DIFFERENT CONTRACT: a flat, untransposed output written at o + gid*8, with the
        # element taken straight from gid. It must be guarded — the transposed mapping divides by z, so
        # running it with z = 0 is an integer division by zero (garbage), which is exactly how this
        # kernel broke the GDN layer gate (native/host/gdn_layer_driver.vyb launches it with z = 0 three
        # times). Every dequant kernel here has both paths for that reason; do not collapse them.
        cw<Int> = 0
        cc<Int> = 0
        rr<Int> = 0
        gsrc<Int> = gid
        if (z > 0) {
            cw = n / z
            cc = gid / cw
            rr = gid % cw
            gsrc = rr * z + cc
        }
        block<Int> = gsrc / 256
        e<Int> = gsrc % 256
        bb<Int> = q + block * 144
        t<Int> = e / 64          # 0..3
        qbase<Int> = t * 32
        l<Int> = e % 32
        half<Int> = (e / 32) % 2
        is<Int> = t * 2 + half   # group 0..7
        d<Float> = ld_f16(bb + 0)
        min<Float> = ld_f16(bb + 2)
        # get_scale_min_k4(is, scales, &sc, &m)  (mask bytes to unsigned 0..255)
        sc<Int> = 0
        m<Int> = 0
        if (is < 4) {
            sc = (ld_i8(bb + 4 + is) as Int) & 63
            m = (ld_i8(bb + 4 + is + 4) as Int) & 63
        } else {
            a<Int> = (ld_i8(bb + 4 + is + 4) as Int) & 255
            b<Int> = (ld_i8(bb + 4 + is - 4) as Int) & 255
            c<Int> = (ld_i8(bb + 4 + is) as Int) & 255
            sc = (a & 15) | ((b >> 6) << 4)
            m = (a >> 4) | ((c >> 6) << 4)
        }
        bq<Int> = (ld_i8(bb + 16 + qbase + l) as Int) & 255
        bqb<Int> = 0
        if (half == 0) { bqb = bq & 15 } else { bqb = bq >> 4 }
        scf<Float> = sc as Float
        mf<Float> = m as Float
        nbf<Float> = (bqb) as Float
        val<Float> = d * scf * nbf - min * mf
        # GGUF dequant emits out-major; gemm needs [in,out] (VybForge#11). When
        # z (= in-dim) > 0, write transposed: element (r=gid/z, c=gid%z) lands at
        # (c, r) -> dst[c*(n/z)+r]. n must be divisible by z (always true here).
        if (z > 0) {
            st_f64(o + (cc * cw + rr) * 8, val)
        } else {
            st_f64(o + gid * 8, val)
        }
    }
}

// f32 twin of `q4kdeq` (VybForge#23): same decode, same mapping, both z contracts, 4-byte store.
// Halves the dequant's write traffic, which nsys says is 111 ms of a 342 ms token in f64.
q4kdeq32(q<Int>, o<Int>, n<Int>, z<Int>) -> {
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < n) {
        cw<Int> = 0
        cc<Int> = 0
        rr<Int> = 0
        gsrc<Int> = gid
        if (z > 0) {
            cw = n / z
            cc = gid / cw
            rr = gid % cw
            gsrc = rr * z + cc
        }
        block<Int> = gsrc / 256
        e<Int> = gsrc % 256
        bb<Int> = q + block * 144
        t<Int> = e / 64
        qbase<Int> = t * 32
        l<Int> = e % 32
        half<Int> = (e / 32) % 2
        is<Int> = t * 2 + half
        # f32 DECODE ARITHMETIC (VybForge#23): the decode is 4 f64 ops per element and f64 runs at
        # 1/64 rate on sm_86. nsys says this kernel is 52% of a token, and halving the STORE width did
        # not help (the extra cvt cost more than the bytes saved) -- so it is COMPUTE-bound, not
        # store-bound. Narrow the operands to Float32 first (the f16 scales by assignment, the 6-bit
        # integers via Float then assignment) and run the mul/sub at full FP32 rate. The stored value
        # is f32 either way; the only change is where the rounding happens.
        d<Float> = ld_f16(bb + 0)
        min<Float> = ld_f16(bb + 2)
        sc<Int> = 0
        m<Int> = 0
        if (is < 4) {
            sc = (ld_i8(bb + 4 + is) as Int) & 63
            m = (ld_i8(bb + 4 + is + 4) as Int) & 63
        } else {
            a<Int> = (ld_i8(bb + 4 + is + 4) as Int) & 255
            b<Int> = (ld_i8(bb + 4 + is - 4) as Int) & 255
            c<Int> = (ld_i8(bb + 4 + is) as Int) & 255
            sc = (a & 15) | ((b >> 6) << 4)
            m = (a >> 4) | ((c >> 6) << 4)
        }
        bq<Int> = (ld_i8(bb + 16 + qbase + l) as Int) & 255
        bqb<Int> = 0
        if (half == 0) { bqb = bq & 15 } else { bqb = bq >> 4 }
        scf64<Float> = sc as Float
        mf64<Float> = m as Float
        nbf64<Float> = (bqb) as Float
        df<Float32> = d
        mnf<Float32> = min
        scf<Float32> = scf64
        mf<Float32> = mf64
        nbf<Float32> = nbf64
        val<Float32> = df * scf * nbf - mnf * mf
        if (z > 0) {
            st_f32(o + (cc * cw + rr) * 4, val)
        } else {
            st_f32(o + gid * 4, val)
        }
    }
}

// f16-store twin (item 18): the QONLY long-prefill scratch takes f16 straight from the decode; the
// value is the f32 `val` rounded once, exactly what q*deq32 + cast16 produced.
q4kdeq16(q<Int>, o<Int>, n<Int>, z<Int>) -> {
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < n) {
        # 32-bit index math (64-bit div/mod by a runtime divisor is a long emulated sequence; every
        # value here is < 2^31). Same indices, so the same element lands in the same place.
        cw<Int> = 0
        cc<Int> = 0
        rr<Int> = 0
        gsrc<Int> = gid
        if (z > 0) {
            g32<Int32> = gid as Int32
            z32<Int32> = z as Int32
            cw32<Int32> = (n as Int32) / z32
            cc32<Int32> = g32 / cw32
            rr32<Int32> = g32 - cc32 * cw32
            cw = cw32 as Int
            cc = cc32 as Int
            rr = rr32 as Int
            gsrc = (rr32 * z32 + cc32) as Int
        }
        block<Int> = gsrc / 256
        e<Int> = gsrc % 256
        bb<Int> = q + block * 144
        t<Int> = e / 64
        qbase<Int> = t * 32
        l<Int> = e % 32
        half<Int> = (e / 32) % 2
        is<Int> = t * 2 + half
        # f32 DECODE ARITHMETIC (VybForge#23): the decode is 4 f64 ops per element and f64 runs at
        # 1/64 rate on sm_86. nsys says this kernel is 52% of a token, and halving the STORE width did
        # not help (the extra cvt cost more than the bytes saved) -- so it is COMPUTE-bound, not
        # store-bound. Narrow the operands to Float32 first (the f16 scales by assignment, the 6-bit
        # integers via Float then assignment) and run the mul/sub at full FP32 rate. The stored value
        # is f32 either way; the only change is where the rounding happens.
        # all-f32 converts (no f64 hop: ~5 f64-pipe cvts per element made this 0.4 ms per tensor on GA102)
        d<Float32> = ld_f16(bb + 0)
        min<Float32> = ld_f16(bb + 2)
        sc<Int> = 0
        m<Int> = 0
        if (is < 4) {
            sc = (ld_i8(bb + 4 + is) as Int) & 63
            m = (ld_i8(bb + 4 + is + 4) as Int) & 63
        } else {
            a<Int> = (ld_i8(bb + 4 + is + 4) as Int) & 255
            b<Int> = (ld_i8(bb + 4 + is - 4) as Int) & 255
            c<Int> = (ld_i8(bb + 4 + is) as Int) & 255
            sc = (a & 15) | ((b >> 6) << 4)
            m = (a >> 4) | ((c >> 6) << 4)
        }
        bq<Int> = (ld_i8(bb + 16 + qbase + l) as Int) & 255
        bqb<Int> = 0
        if (half == 0) { bqb = bq & 15 } else { bqb = bq >> 4 }
        scf64<Float32> = (sc as Int32) as Float32
        mf64<Float32> = (m as Int32) as Float32
        nbf64<Float32> = (bqb as Int32) as Float32
        df<Float32> = d
        mnf<Float32> = min
        scf<Float32> = scf64
        mf<Float32> = mf64
        nbf<Float32> = nbf64
        val<Float32> = df * scf * nbf - mnf * mf
        if (z > 0) {
            st_f16(o + (cc * cw + rr) * 2, val)
        } else {
            st_f16(o + gid * 2, val)
        }
    }
}

// Tiled transposing twin of q4kdeq16 (item 18): one block = 16 output rows x 256 output columns. Phase 1
// decodes 16 source rows x one 256-value super-block (coalesced reads; q4kdeq16 walked the source with
// stride z, one scattered sector per byte load), into the f64 shared array (exact for f32 values),
// XOR-swizzled; phase 2 writes 16 consecutive f16 (32 bytes) per output column. Same per-element
// expression, so the same f16 values. Needs (n/z) % 16 == 0 and z % 256 == 0; grid n/4096 x 256.
q4kdeqT(q<Int>, o<Int>, n<Int>, z<Int>) -> {
    tx<Int> = tid_x()
    cw<Int> = n / z
    nbc<Int> = z / 256
    rb<Int> = blk_x() / nbc
    cb<Int> = blk_x() - rb * nbc
    r<Int> = 0
    while (r < 16) {
        gsrc<Int> = (rb * 16 + r) * z + cb * 256 + tx
            block<Int> = gsrc / 256
            e<Int> = gsrc % 256
            bb<Int> = q + block * 144
            t<Int> = e / 64
            qbase<Int> = t * 32
            l<Int> = e % 32
            half<Int> = (e / 32) % 2
            is<Int> = t * 2 + half
            # f32 DECODE ARITHMETIC (VybForge#23): the decode is 4 f64 ops per element and f64 runs at
            # 1/64 rate on sm_86. nsys says this kernel is 52% of a token, and halving the STORE width did
            # not help (the extra cvt cost more than the bytes saved) -- so it is COMPUTE-bound, not
            # store-bound. Narrow the operands to Float32 first (the f16 scales by assignment, the 6-bit
            # integers via Float then assignment) and run the mul/sub at full FP32 rate. The stored value
            # is f32 either way; the only change is where the rounding happens.
            # all-f32 converts (no f64 hop: ~5 f64-pipe cvts per element made this 0.4 ms per tensor on GA102)
            d<Float32> = ld_f16(bb + 0)
            min<Float32> = ld_f16(bb + 2)
            sc<Int> = 0
            m<Int> = 0
            if (is < 4) {
                sc = (ld_i8(bb + 4 + is) as Int) & 63
                m = (ld_i8(bb + 4 + is + 4) as Int) & 63
            } else {
                a<Int> = (ld_i8(bb + 4 + is + 4) as Int) & 255
                b<Int> = (ld_i8(bb + 4 + is - 4) as Int) & 255
                c<Int> = (ld_i8(bb + 4 + is) as Int) & 255
                sc = (a & 15) | ((b >> 6) << 4)
                m = (a >> 4) | ((c >> 6) << 4)
            }
            bq<Int> = (ld_i8(bb + 16 + qbase + l) as Int) & 255
            bqb<Int> = 0
            if (half == 0) { bqb = bq & 15 } else { bqb = bq >> 4 }
            scf64<Float32> = (sc as Int32) as Float32
            mf64<Float32> = (m as Int32) as Float32
            nbf64<Float32> = (bqb as Int32) as Float32
            df<Float32> = d
            mnf<Float32> = min
            scf<Float32> = scf64
            mf<Float32> = mf64
            nbf<Float32> = nbf64
            val<Float32> = df * scf * nbf - mnf * mf
        vv<Float> = val as Float
        st_shared_f64(r * 256 + (tx ^ r), vv)
        r = r + 1
    }
    kernel_barrier()
    ii<Int> = 0
    while (ii < 16) {
        idx<Int> = ii * 256 + tx
        rr<Int> = idx % 16
        c<Int> = idx / 16
        w<Float32> = ld_shared_f64(rr * 256 + (c ^ rr))
        st_f16(o + ((cb * 256 + c) * cw + rb * 16 + rr) * 2, w)
        ii = ii + 1
    }
}
