// Fused EXL3 dequant + column transform, SHARED-MEMORY COOPERATIVE version.
// Block = one 64-row x 128-col What tile: phase 1 cooperatively dequantizes the
// packed slab into shared memory (32 KB f32), kernel_barrier, phase 2 runs the
// 128-tap column transform reading shared — the expanded What is never
// materialized in global memory and each packed element is dequantized EXACTLY
// ONCE (the naive per-output variant paid 128x redundant dequant).
// Bit-exact vs exl3deq32+exl3had132: same f32 values, same c-ascending order.
// Compile: --kernel-shared 32768. Params (launch4i, all through the p buffer):
// p: +0 q(trellis dev)  +8 td(map body + inverse map)  +16 H(f32)  +24 T(f32)
//    +32 cw             +40 invbase (td + 16 + nbody)
// Grid: (rows/64) * (cw/128) blocks x 256 threads; rows = ntiles*256/cw.
share(all) fp16_to_f64(b<Int>)<Float> -> {
    sb<Int> = (b >> 15) & 1
    eb<Int> = (b >> 10) & 31
    mb<Int> = b & 1023
    v<Float> = 0.0
    if (eb == 0) {
        # subnormal: mb * 2^-24 in ONE multiply (was a 24-step halving loop);
        # the product is exact, so the value is bit-identical
        v = (mb as Float) * 0.000000059604644775390625
    } else {
        if (eb == 31) {
            v = 65504.0
        } else {
            v = (1024 + mb) as Float
            e<Int> = eb - 25
            # 2^e exactly via binary exponentiation (<=5 squarings): every
            # intermediate is a power of two, so the result is bit-identical
            # to the old stepwise doubling/halving loops (<=24 iterations)
            k<Int> = e
            if (k < 0) { k = 0 - k }
            r<Float> = 1.0
            b2<Float> = 2.0
            while (k > 0) {
                if ((k - ((k >> 1) * 2)) == 1) { r = r * b2 }
                b2 = b2 * b2
                k = k >> 1
            }
            if (e < 0) {
                v = v / r
            } else {
                v = v * r
            }
        }
    }
    if (sb == 1) {
        v = 0.0 - v
    }
    return v
}

exl3dq1s(p<Int>) -> {
    tid<Int> = blk_x() * dim_x() + tid_x()
    cw<Int> = ld_i64(p + 32)
    nbc128<Int> = cw / 128
    nbc16<Int> = cw / 16
    block<Int> = tid / 8192
    rem<Int> = tid - block * 8192
    rb64<Int> = block / nbc128
    nb128<Int> = block - rb64 * nbc128
    q<Int> = ld_i64(p + 0)
    td<Int> = ld_i64(p + 8)
    H<Int> = ld_i64(p + 16)
    T<Int> = ld_i64(p + 24)
    inv<Int> = ld_i64(p + 40)

    # ---- phase 1: one element per thread (8192 threads = 8192 elements) ----
    e<Int> = rem
    b<Int> = e / 128
    c<Int> = e - b * 128
    row<Int> = rb64 * 64 + b
    col<Int> = nb128 * 128 + c
    kb16<Int> = row / 16
    r16<Int> = row - kb16 * 16
    nb16<Int> = col / 16
    c16<Int> = col - nb16 * 16
    tile16<Int> = kb16 * nbc16 + nb16
    slotU<UInt32> = ld_u32(inv + (r16 * 16 + c16) * 4)
    slot<Int> = slotU as Int
    base<Int> = td + 16 + slot * 16
    w16<Int> = 0
    i<Int> = 0
    while (i < 4) {
        nidx<Int> = ld_u16(base + i * 2) as Int
        pp<Int> = (ld_i8(base + 8 + i) as Int) & 255
        wb<Int> = q + tile16 * 128 + (nidx / 4) * 2 + (nidx % 4) / 2
        by<Int> = (ld_i8(wb) as Int) & 255
        sh<Int> = ((nidx % 4) % 2) * 4
        nib<Int> = (by >> sh) & 15
        w16 = w16 | (nib << (pp * 4))
        i = i + 1
    }
    prod<Int> = (w16 * 3417055213) & 4294967295
    y<Int> = (prod & 2415890431) ^ 996162400
    lo<Float> = fp16_to_f64(y & 65535)
    hi<Float> = fp16_to_f64((y >> 16) & 65535)
    st_shared_f32(b * 512 + c * 4, (lo + hi) as Float32)

    kernel_barrier()

    # ---- phase 2: one output per thread ----
    # (A 4-rows-per-thread variant — loading the 128-tap vector once per c2
    # for four rows — measured a 28x deq speedup but broke the DECODE_MTP gate
    # with max_abs exactly 8388608 = kn; reverted pending a fresh debugging
    # session. The fp16_to_f64 exponentiation fix above is kept: bit-identical.)
    e2<Int> = rem
    b2<Int> = e2 / 128
    d<Int> = e2 - b2 * 128
    acc<Float32> = 0.0
    c2<Int> = 0
    while (c2 < 128) {
        acc = acc + ld_shared_f32(b2 * 512 + c2 * 4) * ld_f32n(H + (c2 * 128 + d) * 4)
        c2 = c2 + 1
    }
    # T uses the consumer's gid-linear convention (exl3had132/had232):
    # gid = (kbv*nbc128 + nbv)*16384 + (row%128)*128 + d. The 64-row block
    # numbering used here for scheduling must NOT leak into the T address.
    rowT<Int> = rb64 * 64 + b2
    kbvT<Int> = rowT / 128
    bT<Int> = rowT - kbvT * 128
    gidT<Int> = (kbvT * nbc128 + nb128) * 16384 + bT * 128 + d
    st_f32(T + gidT * 4, acc)
}

