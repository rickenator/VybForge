        xn0_6<Float32> = ld_v4_f32(xr + sbp0 * 1024 + 16, 2)
        xn0_7<Float32> = ld_v4_f32(xr + sbp0 * 1024 + 16, 3)
        dn0_0<Float32> = ld_f16(rb0 + sbp0 * 110)
        scbn0_0<Int> = (ld_i8(rb0 + sbp0 * 110 + 106 + g) as Int) & 255
        qhbn0_0<Int> = (ld_i8(rb0 + sbp0 * 110 + 66 + 2 * g + hf) as Int) & 255
        qwn0_0<Int> = (ld_u16(rb0 + sbp0 * 110 + qo) as Int) & 65535
        sgbn0_0<Int> = (ld_i8(rb0 + sbp0 * 110 + 74 + 8 * g + 4 * hf + l3) as Int) & 255
        sbp1<Int> = 1
        if (sbp1 >= nsb) { sbp1 = nsb - 1 }
        xn1_0<Float32> = ld_v4_f32(xr + sbp1 * 1024 + 0, 0)
