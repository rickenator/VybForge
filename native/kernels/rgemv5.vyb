        sh1<Int> = 8 - 2 * l3
        sh2<Int> = 7 - 2 * l3
        qo<Int> = 2 + 16 * g + 8 * hf + 2 * l3
        xr<Int> = X + l * 32
        rbs<Int> = nsb * 110
        rb0<Int> = W + (n0 + 0) * rbs
        sbp0<Int> = 0
