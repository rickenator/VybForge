            xn0_4 = xn1_4
            xn0_5 = xn1_5
            xn0_6 = xn1_6
            xn0_7 = xn1_7
            dn0_0 = dn1_0
            scbn0_0 = scbn1_0
            qhbn0_0 = qhbn1_0
            qwn0_0 = qwn1_0
            sgbn0_0 = sgbn1_0
