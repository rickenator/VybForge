            pt0 = pt0 + x3 * w3_0
            pt0 = pt0 + x4 * w4_0
            pt0 = pt0 + x5 * w5_0
            pt0 = pt0 + x6 * w6_0
            pt0 = pt0 + x7 * w7_0
            acc0 = acc0 + db0 * pt0
