// GENERATED by gen_rgemv5.py (R=1 rows per warp, PF=1). Ridge IQ decode GEMVs, third generation.
// Launch ceil(N/16) blocks x 512 (same as rgemv4). Same params as rgemv.vyb. Bit-identical to
// gen_rgemv2.py output (same per-lane sums, same reduction pairing). Derived from llama.cpp (MIT).

gemv_iq2s_r(p<Int>) -> {
    W<Int> = ld_i64(p + 0)
    X<Int> = ld_i64(p + 8)
    Y<Int> = ld_i64(p + 16)
    N<Int> = ld_i64(p + 32)
    K<Int> = ld_i64(p + 40)
    YE<Int> = ld_i64(p + 48)
    RS<Int> = ld_i64(p + 120)
    G<Int> = ld_i64(p + 128)
    tid<Int> = tid_x()
    l<Int> = tid % 32
    n0<Int> = blk_x() * 16 + (tid / 32) * 1
    nsb<Int> = K / 256
    c1<Float32> = 1.0 as Float32
    c2<Float32> = 2.0 as Float32
    ch<Float32> = 0.5 as Float32
    cq<Float32> = 0.25 as Float32
    acc0<Float32> = 0.0
    if (tid < 512) {
        st_shared_v4_u32(tid * 16, ld_v4_u32(G + tid * 16, 0), ld_v4_u32(G + tid * 16, 1), ld_v4_u32(G + tid * 16, 2), ld_v4_u32(G + tid * 16, 3))
    }
    kernel_barrier()
    if (n0 < N) {
        ib<Int> = l / 4
        l2<Int> = l % 4
        shs<Int> = (l2 / 2) * 4
        shq<Int> = 8 - 2 * l2
        xr<Int> = X + l * 32
        rbs<Int> = nsb * 82
        rb0<Int> = W + (n0 + 0) * rbs
        sbp0<Int> = 0
        if (sbp0 >= nsb) { sbp0 = nsb - 1 }
        xn0_0<Float32> = ld_v4_f32(xr + sbp0 * 1024 + 0, 0)
        xn0_1<Float32> = ld_v4_f32(xr + sbp0 * 1024 + 0, 1)
        xn0_2<Float32> = ld_v4_f32(xr + sbp0 * 1024 + 0, 2)
        xn0_3<Float32> = ld_v4_f32(xr + sbp0 * 1024 + 0, 3)
        xn0_4<Float32> = ld_v4_f32(xr + sbp0 * 1024 + 16, 0)
        xn0_5<Float32> = ld_v4_f32(xr + sbp0 * 1024 + 16, 1)
        xn0_6<Float32> = ld_v4_f32(xr + sbp0 * 1024 + 16, 2)
        xn0_7<Float32> = ld_v4_f32(xr + sbp0 * 1024 + 16, 3)
        dn0_0<Float32> = ld_f16(rb0 + sbp0 * 82)
        scbn0_0<Int> = (ld_i8(rb0 + sbp0 * 82 + 74 + ib) as Int) & 255
        qsbn0_0<Int> = (ld_i8(rb0 + sbp0 * 82 + 2 + l) as Int) & 255
        qhbn0_0<Int> = (ld_i8(rb0 + sbp0 * 82 + 66 + ib) as Int) & 255
        sgbn0_0<Int> = (ld_i8(rb0 + sbp0 * 82 + 34 + l) as Int) & 255
        sbp1<Int> = 1
        if (sbp1 >= nsb) { sbp1 = nsb - 1 }
        xn1_0<Float32> = ld_v4_f32(xr + sbp1 * 1024 + 0, 0)
        xn1_1<Float32> = ld_v4_f32(xr + sbp1 * 1024 + 0, 1)
        xn1_2<Float32> = ld_v4_f32(xr + sbp1 * 1024 + 0, 2)
        xn1_3<Float32> = ld_v4_f32(xr + sbp1 * 1024 + 0, 3)
        xn1_4<Float32> = ld_v4_f32(xr + sbp1 * 1024 + 16, 0)
        xn1_5<Float32> = ld_v4_f32(xr + sbp1 * 1024 + 16, 1)
        xn1_6<Float32> = ld_v4_f32(xr + sbp1 * 1024 + 16, 2)
        xn1_7<Float32> = ld_v4_f32(xr + sbp1 * 1024 + 16, 3)
        dn1_0<Float32> = ld_f16(rb0 + sbp1 * 82)
        scbn1_0<Int> = (ld_i8(rb0 + sbp1 * 82 + 74 + ib) as Int) & 255
        qsbn1_0<Int> = (ld_i8(rb0 + sbp1 * 82 + 2 + l) as Int) & 255
        qhbn1_0<Int> = (ld_i8(rb0 + sbp1 * 82 + 66 + ib) as Int) & 255
        sgbn1_0<Int> = (ld_i8(rb0 + sbp1 * 82 + 34 + l) as Int) & 255
        sb<Int> = 0
        while (sb < nsb) {
            x0<Float32> = xn0_0
            x1<Float32> = xn0_1
            x2<Float32> = xn0_2
            x3<Float32> = xn0_3
            x4<Float32> = xn0_4
            x5<Float32> = xn0_5
            x6<Float32> = xn0_6
            x7<Float32> = xn0_7
            d0<Float32> = dn0_0
            scb0<Int> = scbn0_0
            qsb0<Int> = qsbn0_0
            qhb0<Int> = qhbn0_0
            sgb0<Int> = sgbn0_0
            xn0_0 = xn1_0
            xn0_1 = xn1_1
            xn0_2 = xn1_2
            xn0_3 = xn1_3
            xn0_4 = xn1_4
            xn0_5 = xn1_5
            xn0_6 = xn1_6
            xn0_7 = xn1_7
            dn0_0 = dn1_0
            scbn0_0 = scbn1_0
            qsbn0_0 = qsbn1_0
            qhbn0_0 = qhbn1_0
            sgbn0_0 = sgbn1_0
            sbn<Int> = sb + 2
            if (sbn >= nsb) { sbn = nsb - 1 }
            xn1_0 = ld_v4_f32(xr + sbn * 1024 + 0, 0)
            xn1_1 = ld_v4_f32(xr + sbn * 1024 + 0, 1)
            xn1_2 = ld_v4_f32(xr + sbn * 1024 + 0, 2)
            xn1_3 = ld_v4_f32(xr + sbn * 1024 + 0, 3)
            xn1_4 = ld_v4_f32(xr + sbn * 1024 + 16, 0)
            xn1_5 = ld_v4_f32(xr + sbn * 1024 + 16, 1)
            xn1_6 = ld_v4_f32(xr + sbn * 1024 + 16, 2)
            xn1_7 = ld_v4_f32(xr + sbn * 1024 + 16, 3)
            bn0<Int> = rb0 + sbn * 82
            dn1_0 = ld_f16(bn0)
            scbn1_0 = (ld_i8(bn0 + 74 + ib) as Int) & 255
            qsbn1_0 = (ld_i8(bn0 + 2 + l) as Int) & 255
            qhbn1_0 = (ld_i8(bn0 + 66 + ib) as Int) & 255
            sgbn1_0 = (ld_i8(bn0 + 34 + l) as Int) & 255
            dl0<Float32> = d0 * ((((scb0 >> shs) & 15) as Float32) + ch) * cq
            idx0<Int> = qsb0 | ((qhb0 << shq) & 768)
            g0_0<UInt32> = ld_shared_v2_u32(idx0 * 8, 0)
            g1_0<UInt32> = ld_shared_v2_u32(idx0 * 8, 1)
            sg_0<UInt32> = sgb0 as UInt32
            w0_0<Float32> = (((g0_0) & 255) as Float32) * (c1 - c2 * ((sg_0 & 1) as Float32))
            w1_0<Float32> = (((g0_0 >> 8) & 255) as Float32) * (c1 - c2 * (((sg_0 >> 1) & 1) as Float32))
            w2_0<Float32> = (((g0_0 >> 16) & 255) as Float32) * (c1 - c2 * (((sg_0 >> 2) & 1) as Float32))
            w3_0<Float32> = (((g0_0 >> 24) & 255) as Float32) * (c1 - c2 * (((sg_0 >> 3) & 1) as Float32))
            w4_0<Float32> = (((g1_0) & 255) as Float32) * (c1 - c2 * (((sg_0 >> 4) & 1) as Float32))
            w5_0<Float32> = (((g1_0 >> 8) & 255) as Float32) * (c1 - c2 * (((sg_0 >> 5) & 1) as Float32))
            w6_0<Float32> = (((g1_0 >> 16) & 255) as Float32) * (c1 - c2 * (((sg_0 >> 6) & 1) as Float32))
            w7_0<Float32> = (((g1_0 >> 24) & 255) as Float32) * (c1 - c2 * (((sg_0 >> 7) & 1) as Float32))
            pt0<Float32> = x0 * w0_0
            pt0 = pt0 + x1 * w1_0
            pt0 = pt0 + x2 * w2_0
            pt0 = pt0 + x3 * w3_0
            pt0 = pt0 + x4 * w4_0
            pt0 = pt0 + x5 * w5_0
            pt0 = pt0 + x6 * w6_0
            pt0 = pt0 + x7 * w7_0
            acc0 = acc0 + dl0 * pt0
            sb = sb + 1
        }
    }
    if (n0 < N) {
        s0<Float> = acc0 as Float
        s0 = s0 + shfl_down_f64(s0, 16)
        s0 = s0 + shfl_down_f64(s0, 8)
        s0 = s0 + shfl_down_f64(s0, 4)
        s0 = s0 + shfl_down_f64(s0, 2)
        s0 = s0 + shfl_down_f64(s0, 1)
        if (l == 0) {
            if (n0 + 0 < N) {
                if (YE == 4) { st_f32(Y + (n0 + 0) * 4, s0 as Float32) } else {
                    if (RS != 0) { s0 = ld_f64(RS + (n0 + 0) * 8) + s0 }
                    st_f64(Y + (n0 + 0) * 8, s0)
                }
            }
        }
    }
}

gemv_iq3s_r(p<Int>) -> {
    W<Int> = ld_i64(p + 0)
    X<Int> = ld_i64(p + 8)
    Y<Int> = ld_i64(p + 16)
    N<Int> = ld_i64(p + 32)
    K<Int> = ld_i64(p + 40)
    YE<Int> = ld_i64(p + 48)
    RS<Int> = ld_i64(p + 120)
