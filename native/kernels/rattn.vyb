// Decode attention context, split so the softmax is computed once per (s, h) row instead of once per
// output lane (attn_cx recomputes max/sum/exp for each of the HD lanes). Same expressions, same
// summation order as attn_cx -> bit-identical. Params block is attn_cx's (V@96 Ctx@104 S@184 HD@200
// H@208 KVH@216 P0@224 SC@232 T@240); M = rows*2 f64 scratch (mx, ssum). SC is overwritten with exp.
import vmath::{vexp}

rax_mx(p<Int>, M<Int>, z0<Int>, z1<Int>) -> {
    S<Int> = ld_i64(p + 184)
    H<Int> = ld_i64(p + 208)
    P0<Int> = ld_i64(p + 224)
    SC<Int> = ld_i64(p + 232)
    T<Int> = ld_i64(p + 240)
    gsh<Int> = blk_x() * dim_x() + tid_x()
    if (gsh < S * H) {
        s<Int> = gsh / H
        h<Int> = gsh % H
        sa<Int> = P0 + s
        sb<Int> = SC + (s * H + h) * T * 8
        mx<Float> = -1000000000000000000000000000000.0
        ta<Int> = 0
        for (ta in 0..sa) {
            sc<Float> = ld_f64(sb + ta * 8)
            if (sc > mx) { mx = sc }
        }
        st_f64(M + gsh * 16, mx)
    }
}

// warp-parallel row max (max is exact in any order): one 32-thread block per row
rax_mx2(p<Int>, M<Int>, z0<Int>, z1<Int>) -> {
    H<Int> = ld_i64(p + 208)
    P0<Int> = ld_i64(p + 224)
    SC<Int> = ld_i64(p + 232)
    T<Int> = ld_i64(p + 240)
    gsh<Int> = blk_x()
    lane<Int> = tid_x()
    s<Int> = gsh / H
    h<Int> = gsh % H
    n<Int> = P0 + s + 1
    sb<Int> = SC + (s * H + h) * T * 8
    mx<Float> = -1000000000000000000000000000000.0
    ta<Int> = lane
    while (ta < n) {
        sc<Float> = ld_f64(sb + ta * 8)
        if (sc > mx) { mx = sc }
        ta = ta + 32
    }
    o<Float> = shfl_down_f64(mx, 16)
    if (o > mx) { mx = o }
    o = shfl_down_f64(mx, 8)
    if (o > mx) { mx = o }
    o = shfl_down_f64(mx, 4)
    if (o > mx) { mx = o }
    o = shfl_down_f64(mx, 2)
    if (o > mx) { mx = o }
    o = shfl_down_f64(mx, 1)
    if (o > mx) { mx = o }
    if (lane == 0) { st_f64(M + gsh * 16, mx) }
}

// rax_sum with the loads batched 8 ahead; adds stay sequential in tb order
rax_sum8(p<Int>, M<Int>, z0<Int>, z1<Int>) -> {
    S<Int> = ld_i64(p + 184)
    H<Int> = ld_i64(p + 208)
    P0<Int> = ld_i64(p + 224)
    SC<Int> = ld_i64(p + 232)
    T<Int> = ld_i64(p + 240)
    gsh<Int> = blk_x() * dim_x() + tid_x()
    if (gsh < S * H) {
        s<Int> = gsh / H
        h<Int> = gsh % H
        n<Int> = P0 + s + 1
        sb<Int> = SC + (s * H + h) * T * 8
        ssum<Float> = 0.0
        tb<Int> = 0
        while (tb + 8 <= n) {
            a<Int> = sb + tb * 8
            v0<Float> = ld_f64(a)
            v1<Float> = ld_f64(a + 8)
            v2<Float> = ld_f64(a + 16)
            v3<Float> = ld_f64(a + 24)
            v4<Float> = ld_f64(a + 32)
            v5<Float> = ld_f64(a + 40)
            v6<Float> = ld_f64(a + 48)
            v7<Float> = ld_f64(a + 56)
            ssum = ssum + v0
            ssum = ssum + v1
            ssum = ssum + v2
            ssum = ssum + v3
            ssum = ssum + v4
            ssum = ssum + v5
            ssum = ssum + v6
            ssum = ssum + v7
            tb = tb + 8
        }
        while (tb < n) {
            ssum = ssum + ld_f64(sb + tb * 8)
            tb = tb + 1
        }
        st_f64(M + gsh * 16 + 8, ssum)
    }
}

rax_e(p<Int>, M<Int>, z0<Int>, z1<Int>) -> {
    S<Int> = ld_i64(p + 184)
    H<Int> = ld_i64(p + 208)
    SC<Int> = ld_i64(p + 232)
    T<Int> = ld_i64(p + 240)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < S * H * T) {
        gsh<Int> = gid / T
        mx<Float> = ld_f64(M + gsh * 16)
        a<Int> = SC + gid * 8
        st_f64(a, vexp(ld_f64(a) - mx))
    }
}

rax_sum(p<Int>, M<Int>, z0<Int>, z1<Int>) -> {
    S<Int> = ld_i64(p + 184)
    H<Int> = ld_i64(p + 208)
    P0<Int> = ld_i64(p + 224)
    SC<Int> = ld_i64(p + 232)
    T<Int> = ld_i64(p + 240)
    gsh<Int> = blk_x() * dim_x() + tid_x()
    if (gsh < S * H) {
        s<Int> = gsh / H
        h<Int> = gsh % H
        sa<Int> = P0 + s
        sb<Int> = SC + (s * H + h) * T * 8
        ssum<Float> = 0.0
        tb<Int> = 0
        for (tb in 0..sa) {
            ssum = ssum + ld_f64(sb + tb * 8)
        }
        st_f64(M + gsh * 16 + 8, ssum)
    }
}

// w = e / ssum in place (same expression as attn_cx's per-lane w)
rax_w(p<Int>, M<Int>, z0<Int>, z1<Int>) -> {
    S<Int> = ld_i64(p + 184)
    H<Int> = ld_i64(p + 208)
    SC<Int> = ld_i64(p + 232)
    T<Int> = ld_i64(p + 240)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < S * H * T) {
        gsh<Int> = gid / T
        ssum<Float> = ld_f64(M + gsh * 16 + 8)
        a<Int> = SC + gid * 8
        st_f64(a, ld_f64(a) / ssum)
    }
}

// SC holds w already (rax_w)
rax_cw(p<Int>, M<Int>, z0<Int>, z1<Int>) -> {
    V<Int> = ld_i64(p + 96)
    Ctx<Int> = ld_i64(p + 104)
    S<Int> = ld_i64(p + 184)
    HD<Int> = ld_i64(p + 200)
    H<Int> = ld_i64(p + 208)
    KVH<Int> = ld_i64(p + 216)
    P0<Int> = ld_i64(p + 224)
    SC<Int> = ld_i64(p + 232)
    T<Int> = ld_i64(p + 240)
    hkv<Int> = H / KVH
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < S * H * HD) {
        ii<Int> = gid % HD
        gsh<Int> = gid / HD
        h<Int> = gsh % H
        s<Int> = gsh / H
        sa<Int> = P0 + s
        kvh<Int> = h / hkv
        sb<Int> = SC + (s * H + h) * T * 8
        acc<Float> = 0.0
        tc<Int> = 0
        for (tc in 0..sa) {
            acc = acc + ld_f64(sb + tc * 8) * ld_f64(V + (tc * KVH * HD + kvh * HD + ii) * 8)
        }
        st_f64(Ctx + (s * H * HD + h * HD + ii) * 8, acc)
    }
}

rax_cx(p<Int>, M<Int>, z0<Int>, z1<Int>) -> {
    V<Int> = ld_i64(p + 96)
    Ctx<Int> = ld_i64(p + 104)
    S<Int> = ld_i64(p + 184)
    HD<Int> = ld_i64(p + 200)
    H<Int> = ld_i64(p + 208)
    KVH<Int> = ld_i64(p + 216)
    P0<Int> = ld_i64(p + 224)
    SC<Int> = ld_i64(p + 232)
    T<Int> = ld_i64(p + 240)
    hkv<Int> = H / KVH
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < S * H * HD) {
        ii<Int> = gid % HD
        gsh<Int> = gid / HD
        h<Int> = gsh % H
        s<Int> = gsh / H
        sa<Int> = P0 + s
        kvh<Int> = h / hkv
        sb<Int> = SC + (s * H + h) * T * 8
        ssum<Float> = ld_f64(M + gsh * 16 + 8)
        acc<Float> = 0.0
        tc<Int> = 0
        for (tc in 0..sa) {
            e<Float> = ld_f64(sb + tc * 8)
            w<Float> = e / ssum
            vv<Float> = ld_f64(V + (tc * KVH * HD + kvh * HD + ii) * 8)
            acc = acc + w * vv
        }
        st_f64(Ctx + (s * H * HD + h * HD + ii) * 8, acc)
    }
}
