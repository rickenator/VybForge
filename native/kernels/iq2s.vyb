// GGUF block_iq2_s dequant kernel — the FFN middle stack of Qwen3.8-27B Ridge (160 tensors,
// 4.25 GiB, the largest type in the file).
// Ported faithfully from llama.cpp ggml-quants.c dequantize_row_iq2_s.
// Derived from llama.cpp (MIT License, https://github.com/ggml-org/llama.cpp):
// ggml-quants.c, dequantize_row_iq2_s; ggml-common.h iq2s_grid/kmask_iq2xs. See THIRD-PARTY.md.
//
// block layout (82 B): d f16 @0, qs[64] @2, qh[8] @66, scales[8] @74.
//   256 values/block in 8 groups of 32. qs holds the 2-bit indices in its first 32 bytes and the
//   SIGN BITS in bytes 32..64. Per group ib32 and sub-group l (0..3, 8 values each):
//     dl  = d * (0.5 + nibble(scales[ib32], l<2 ? low : high)) * 0.25
//     idx = qs[4*ib32+l] | ((qh[ib32] << (8-2l)) & 768)      // 10 bits -> 1024 grid entries
//     val = dl * grid[idx][j] * (sign bit j of qs[32+4*ib32+l] ? -1 : 1)
//
// `grid` is an ORDINARY FIFTH ARGUMENT: 8192 bytes (1024 entries x 8), uploaded once and passed by
// pointer through the generic launcher `cuda_launch_n`, which packs a caller-built parameter
// array. This kernel previously had to pack the grid as a PREFIX of its own weight buffer and read
// its blocks at q + 8192, because the only launchers took four scalars (Vyb#476). That convention
// is gone: with the table as a real argument, two different tables (IQ2_S's and IQ3_S's) can
// coexist in one kernel, and no caller has to know a private buffer layout.
// Thread = one output element (Float, 8 bytes).
iq2sdeq(grid<Int>, q<Int>, o<Int>, n<Int>, z<Int>) -> {
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < n) {
        block<Int> = gid / 256
        e<Int> = gid % 256
        bb<Int> = q + block * 82
        ib32<Int> = e / 32
        r<Int> = e % 32
        l<Int> = r / 8
        j<Int> = r % 8
        d<Float> = ld_f16(bb + 0)
        sc<Int> = (ld_i8(bb + 74 + ib32) as Int) & 255
        nib<Int> = 0
        if (l < 2) { nib = sc & 15 } else { nib = sc >> 4 }
        dl<Float> = d * (0.5 + (nib as Float)) * 0.25
        qsb<Int> = (ld_i8(bb + 2 + 4 * ib32 + l) as Int) & 255
        qhb<Int> = (ld_i8(bb + 66 + ib32) as Int) & 255
        idx<Int> = qsb | ((qhb << (8 - 2 * l)) & 768)
        gv<Int> = (ld_i8(grid + idx * 8 + j) as Int) & 255
        sb<Int> = (ld_i8(bb + 2 + 32 + 4 * ib32 + l) as Int) & 255
        sgn<Int> = (sb >> j) & 1
        val<Float> = dl * (gv as Float)
        if (sgn == 1) { val = 0.0 - val }
        # GGUF dequant emits out-major; gemm needs [in,out] (VybForge#11). When z (= in-dim) > 0,
        # write transposed (see q4kdeq's comment for why).
        if (z > 0) {
            rr<Int> = gid / z
            cc<Int> = gid % z
            st_f64(o + cc * n / z * 8 + rr * 8, val)
        } else {
            st_f64(o + gid * 8, val)
        }
    }
}
