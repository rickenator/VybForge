// GGUF block_q6_K dequant kernel (Qwen3 attn_v / ffn_down / token_embd bodies),
// ported from llama.cpp ggml-quants.c dequantize_row_q6_K.
// Derived from llama.cpp (MIT License, https://github.com/ggml-org/llama.cpp):
// ggml-quants.c, dequantize_row_q6_K. See THIRD-PARTY.md.
// block layout (210 B): ql[128]@0 (low 4 bits), qh[64]@128 (upper 2 bits),
// scales[16] int8 @192, d f16 @208. 256 values/block, 2x 128 groups.
q6kdeq(q<Int>, o<Int>, n<Int>, z<Int>) -> {
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < n) {
        block<Int> = gid / 256
        bb<Int> = q + block * 210
        g<Int> = (gid % 256) / 128
        yl<Int> = gid % 128
        quad<Int> = yl / 32        # 0..3
        l<Int> = yl % 32
        is2<Int> = l / 16
        sidx<Int> = g * 8 + is2 + quad * 2
        qlbase<Int> = g * 64
        qhbase<Int> = g * 32
        qloff<Int> = qlbase + (quad % 2) * 32 + l
        d<Float> = ld_f16(bb + 208)
        sc0<Int> = (ld_i8(bb + 192 + sidx) as Int)          # signed scale
        qlb<Int> = (ld_i8(bb + 0 + qloff) as Int) & 255
        qhb<Int> = (ld_i8(bb + 128 + qhbase + l) as Int) & 255
        nib<Int> = 0
        if (quad < 2) { nib = qlb & 15 } else { nib = qlb >> 4 }
        hib<Int> = 0
        if (quad == 0) { hib = (qhb >> 0) & 3 }
        if (quad == 1) { hib = (qhb >> 2) & 3 }
        if (quad == 2) { hib = (qhb >> 4) & 3 }
        if (quad == 3) { hib = (qhb >> 6) & 3 }
        qs<Int> = (nib | (hib << 4)) - 32
        sf<Float> = sc0 as Float
        qf<Float> = qs as Float
        val<Float> = d * sf * qf
        # GGUF dequant emits out-major; gemm needs [in,out] (VybForge#11). When
        # z (= in-dim) > 0, write transposed (see q4kdeq comment).
        if (z > 0) {
            rr<Int> = gid / z
            cc<Int> = gid % z
            st_f64(o + cc * n / z * 8 + rr * 8, val)
        } else {
            st_f64(o + gid * 8, val)
        }
    }
}

// Row gather of `q6kdeq` for the decode-step embed inside the CUDA graph: the row index is read
// from device cell ip (a pinned-slot copy captured in the graph), so a replay needs no new launch
// args. q = matrix base, n = row length. Same decode arithmetic as q6kdeq with z = 0 (bit-identical).
q6kdeq_ix(q<Int>, ip<Int>, o<Int>, n<Int>) -> {
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < n) {
        row<Int> = ld_i64(ip)
        block<Int> = gid / 256
        bb<Int> = q + row * (n / 256) * 210 + block * 210
        g<Int> = (gid % 256) / 128
        yl<Int> = gid % 128
        quad<Int> = yl / 32
        l<Int> = yl % 32
        is2<Int> = l / 16
        sidx<Int> = g * 8 + is2 + quad * 2
        qlbase<Int> = g * 64
        qhbase<Int> = g * 32
        qloff<Int> = qlbase + (quad % 2) * 32 + l
        d<Float> = ld_f16(bb + 208)
        sc0<Int> = (ld_i8(bb + 192 + sidx) as Int)
        qlb<Int> = (ld_i8(bb + 0 + qloff) as Int) & 255
        qhb<Int> = (ld_i8(bb + 128 + qhbase + l) as Int) & 255
        nib<Int> = 0
        if (quad < 2) { nib = qlb & 15 } else { nib = qlb >> 4 }
        hib<Int> = 0
        if (quad == 0) { hib = (qhb >> 0) & 3 }
        if (quad == 1) { hib = (qhb >> 2) & 3 }
        if (quad == 2) { hib = (qhb >> 4) & 3 }
        if (quad == 3) { hib = (qhb >> 6) & 3 }
        qs<Int> = (nib | (hib << 4)) - 32
        sf<Float> = sc0 as Float
        qf<Float> = qs as Float
        val<Float> = d * sf * qf
        st_f64(o + gid * 8, val)
    }
}

// f32 twin of `q6kdeq` (VybForge#23): same decode, both z contracts, 4-byte store.
q6kdeq32(q<Int>, o<Int>, n<Int>, z<Int>) -> {
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < n) {
        cw<Int> = 0
        cc<Int> = 0
        rr<Int> = 0
        gsrc<Int> = gid
        if (z > 0) {
            cw = n / z
            cc = gid / cw
            rr = gid % cw
            gsrc = rr * z + cc
        }
        block<Int> = gsrc / 256
        bb<Int> = q + block * 210
        g<Int> = (gsrc % 256) / 128
        yl<Int> = gsrc % 128
        quad<Int> = yl / 32
        l<Int> = yl % 32
        is2<Int> = l / 16
        sidx<Int> = g * 8 + is2 + quad * 2
        qlbase<Int> = g * 64
        qhbase<Int> = g * 32
        qloff<Int> = qlbase + (quad % 2) * 32 + l
        # f32 decode arithmetic -- see q4kdeq32 for the measurement that motivates it.
        d<Float> = ld_f16(bb + 208)
        sc0<Int> = (ld_i8(bb + 192 + sidx) as Int)
        qlb<Int> = (ld_i8(bb + 0 + qloff) as Int) & 255
        qhb<Int> = (ld_i8(bb + 128 + qhbase + l) as Int) & 255
        nib<Int> = 0
        if (quad < 2) { nib = qlb & 15 } else { nib = qlb >> 4 }
        hib<Int> = 0
        if (quad == 0) { hib = (qhb >> 0) & 3 }
        if (quad == 1) { hib = (qhb >> 2) & 3 }
        if (quad == 2) { hib = (qhb >> 4) & 3 }
        if (quad == 3) { hib = (qhb >> 6) & 3 }
        qs<Int> = (nib | (hib << 4)) - 32
        sf64<Float> = sc0 as Float
        qf64<Float> = qs as Float
        df<Float32> = d
        sf<Float32> = sf64
        qf<Float32> = qf64
        val<Float32> = df * sf * qf
        if (z > 0) {
            st_f32(o + (cc * cw + rr) * 4, val)
        } else {
            st_f32(o + gid * 4, val)
        }
    }
}

// f16-store twin (item 18): the QONLY long-prefill scratch takes f16 straight from the decode; the
// value is the f32 `val` rounded once, exactly what q*deq32 + cast16 produced.
q6kdeq16(q<Int>, o<Int>, n<Int>, z<Int>) -> {
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < n) {
        # 32-bit index math (64-bit div/mod by a runtime divisor is a long emulated sequence; every
        # value here is < 2^31). Same indices, so the same element lands in the same place.
        cw<Int> = 0
        cc<Int> = 0
        rr<Int> = 0
        gsrc<Int> = gid
        if (z > 0) {
            g32<Int32> = gid as Int32
            z32<Int32> = z as Int32
            cw32<Int32> = (n as Int32) / z32
            cc32<Int32> = g32 / cw32
            rr32<Int32> = g32 - cc32 * cw32
            cw = cw32 as Int
            cc = cc32 as Int
            rr = rr32 as Int
            gsrc = (rr32 * z32 + cc32) as Int
        }
        block<Int> = gsrc / 256
        bb<Int> = q + block * 210
        g<Int> = (gsrc % 256) / 128
        yl<Int> = gsrc % 128
        quad<Int> = yl / 32
        l<Int> = yl % 32
        is2<Int> = l / 16
        sidx<Int> = g * 8 + is2 + quad * 2
        qlbase<Int> = g * 64
        qhbase<Int> = g * 32
        qloff<Int> = qlbase + (quad % 2) * 32 + l
        # all-f32 converts (no f64 hop: ~5 f64-pipe cvts per element made this 0.4 ms per tensor on GA102)
        # f32 decode arithmetic -- see q4kdeq32 for the measurement that motivates it.
        d<Float32> = ld_f16(bb + 208)
        sc0<Int> = (ld_i8(bb + 192 + sidx) as Int)
        qlb<Int> = (ld_i8(bb + 0 + qloff) as Int) & 255
        qhb<Int> = (ld_i8(bb + 128 + qhbase + l) as Int) & 255
        nib<Int> = 0
        if (quad < 2) { nib = qlb & 15 } else { nib = qlb >> 4 }
        hib<Int> = 0
        if (quad == 0) { hib = (qhb >> 0) & 3 }
        if (quad == 1) { hib = (qhb >> 2) & 3 }
        if (quad == 2) { hib = (qhb >> 4) & 3 }
        if (quad == 3) { hib = (qhb >> 6) & 3 }
        qs<Int> = (nib | (hib << 4)) - 32
        sf64<Float32> = (sc0 as Int32) as Float32
        qf64<Float32> = (qs as Int32) as Float32
        df<Float32> = d
        sf<Float32> = sf64
        qf<Float32> = qf64
        val<Float32> = df * sf * qf
        if (z > 0) {
            st_f16(o + (cc * cw + rr) * 2, val)
        } else {
            st_f16(o + gid * 2, val)
        }
    }
}

// Tiled transposing twin of q6kdeq16 (item 18): one block = 16 output rows x 256 output columns. Phase 1
// decodes 16 source rows x one 256-value super-block (coalesced reads; q6kdeq16 walked the source with
// stride z, one scattered sector per byte load), into the f64 shared array (exact for f32 values),
// XOR-swizzled; phase 2 writes 16 consecutive f16 (32 bytes) per output column. Same per-element
// expression, so the same f16 values. Needs (n/z) % 16 == 0 and z % 256 == 0; grid n/4096 x 256.
q6kdeqT(q<Int>, o<Int>, n<Int>, z<Int>) -> {
    tx<Int> = tid_x()
    cw<Int> = n / z
    nbc<Int> = z / 256
    rb<Int> = blk_x() / nbc
    cb<Int> = blk_x() - rb * nbc
    r<Int> = 0
    while (r < 16) {
        gsrc<Int> = (rb * 16 + r) * z + cb * 256 + tx
            block<Int> = gsrc / 256
            bb<Int> = q + block * 210
            g<Int> = (gsrc % 256) / 128
            yl<Int> = gsrc % 128
            quad<Int> = yl / 32
            l<Int> = yl % 32
            is2<Int> = l / 16
            sidx<Int> = g * 8 + is2 + quad * 2
            qlbase<Int> = g * 64
            qhbase<Int> = g * 32
            qloff<Int> = qlbase + (quad % 2) * 32 + l
            # all-f32 converts (no f64 hop: ~5 f64-pipe cvts per element made this 0.4 ms per tensor on GA102)
            # f32 decode arithmetic -- see q4kdeq32 for the measurement that motivates it.
            d<Float32> = ld_f16(bb + 208)
            sc0<Int> = (ld_i8(bb + 192 + sidx) as Int)
            qlb<Int> = (ld_i8(bb + 0 + qloff) as Int) & 255
            qhb<Int> = (ld_i8(bb + 128 + qhbase + l) as Int) & 255
            nib<Int> = 0
            if (quad < 2) { nib = qlb & 15 } else { nib = qlb >> 4 }
            hib<Int> = 0
            if (quad == 0) { hib = (qhb >> 0) & 3 }
            if (quad == 1) { hib = (qhb >> 2) & 3 }
            if (quad == 2) { hib = (qhb >> 4) & 3 }
            if (quad == 3) { hib = (qhb >> 6) & 3 }
            qs<Int> = (nib | (hib << 4)) - 32
            sf64<Float32> = (sc0 as Int32) as Float32
            qf64<Float32> = (qs as Int32) as Float32
            df<Float32> = d
            sf<Float32> = sf64
            qf<Float32> = qf64
            val<Float32> = df * sf * qf
        vv<Float> = val as Float
        st_shared_f64(r * 256 + (tx ^ r), vv)
        r = r + 1
    }
    kernel_barrier()
    ii<Int> = 0
    while (ii < 16) {
        idx<Int> = ii * 256 + tx
        rr<Int> = idx % 16
        c<Int> = idx / 16
        w<Float32> = ld_shared_f64(rr * 256 + (c ^ rr))
        st_f16(o + ((cb * 256 + c) * cw + rb * 16 + rr) * 2, w)
        ii = ii + 1
    }
}
