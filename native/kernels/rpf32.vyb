attn_pf2(p<Int>) -> {
    Q<Int> = ld_i64(p + 0)
    KC<Int> = ld_i64(p + 8)
    VC<Int> = ld_i64(p + 16)
    CTX<Int> = ld_i64(p + 24)
    H<Int> = ld_i64(p + 32)
    KVH<Int> = ld_i64(p + 40)
    HDp<Int> = ld_i64(p + 48)
    P0<Int> = ld_i64(p + 56)
    S<Int> = ld_i64(p + 64)
    scl<Float32> = ((1.0 / vsqrt(HDp as Float, 40)) * 1.4426950408889634) as Float32
    b<Int> = blk_x()
    g<Int> = b % KVH
    tid<Int> = tid_x()
    lane<Int> = tid % 32
    s<Int> = (b / KVH) * 8 + tid / 32
    if (s < S) {
        T<Int> = P0 + s + 1
        NKV<Int> = KVH * HDp
        kb<Int> = KC + (g * HDp + lane) * 8
        vb<Int> = VC + (g * HDp + lane) * 8
        qb0<Int> = Q + (s * H * HDp + (g * 6 + 0) * HDp + lane) * 8
        q0_0<Float32> = (ld_f64(qb0 + 0) as Float32) * scl
        a0_0<Float32> = (0.0 as Float32)
        q0_1<Float32> = (ld_f64(qb0 + 256) as Float32) * scl
        a0_1<Float32> = (0.0 as Float32)
        q0_2<Float32> = (ld_f64(qb0 + 512) as Float32) * scl
        a0_2<Float32> = (0.0 as Float32)
        q0_3<Float32> = (ld_f64(qb0 + 768) as Float32) * scl
        a0_3<Float32> = (0.0 as Float32)
        q0_4<Float32> = (ld_f64(qb0 + 1024) as Float32) * scl
        a0_4<Float32> = (0.0 as Float32)
        q0_5<Float32> = (ld_f64(qb0 + 1280) as Float32) * scl
        a0_5<Float32> = (0.0 as Float32)
        q0_6<Float32> = (ld_f64(qb0 + 1536) as Float32) * scl
        a0_6<Float32> = (0.0 as Float32)
        q0_7<Float32> = (ld_f64(qb0 + 1792) as Float32) * scl
        a0_7<Float32> = (0.0 as Float32)
        mx0<Float32> = (-1e+30 as Float32)
        ls0<Float32> = (0.0 as Float32)
        qb1<Int> = Q + (s * H * HDp + (g * 6 + 1) * HDp + lane) * 8
        q1_0<Float32> = (ld_f64(qb1 + 0) as Float32) * scl
        a1_0<Float32> = (0.0 as Float32)
        q1_1<Float32> = (ld_f64(qb1 + 256) as Float32) * scl
        a1_1<Float32> = (0.0 as Float32)
        q1_2<Float32> = (ld_f64(qb1 + 512) as Float32) * scl
        a1_2<Float32> = (0.0 as Float32)
        q1_3<Float32> = (ld_f64(qb1 + 768) as Float32) * scl
        a1_3<Float32> = (0.0 as Float32)
        q1_4<Float32> = (ld_f64(qb1 + 1024) as Float32) * scl
        a1_4<Float32> = (0.0 as Float32)
        q1_5<Float32> = (ld_f64(qb1 + 1280) as Float32) * scl
        a1_5<Float32> = (0.0 as Float32)
        q1_6<Float32> = (ld_f64(qb1 + 1536) as Float32) * scl
        a1_6<Float32> = (0.0 as Float32)
        q1_7<Float32> = (ld_f64(qb1 + 1792) as Float32) * scl
        a1_7<Float32> = (0.0 as Float32)
        mx1<Float32> = (-1e+30 as Float32)
        ls1<Float32> = (0.0 as Float32)
        qb2<Int> = Q + (s * H * HDp + (g * 6 + 2) * HDp + lane) * 8
        q2_0<Float32> = (ld_f64(qb2 + 0) as Float32) * scl
        a2_0<Float32> = (0.0 as Float32)
        q2_1<Float32> = (ld_f64(qb2 + 256) as Float32) * scl
        a2_1<Float32> = (0.0 as Float32)
        q2_2<Float32> = (ld_f64(qb2 + 512) as Float32) * scl
        a2_2<Float32> = (0.0 as Float32)
        q2_3<Float32> = (ld_f64(qb2 + 768) as Float32) * scl
        a2_3<Float32> = (0.0 as Float32)
        q2_4<Float32> = (ld_f64(qb2 + 1024) as Float32) * scl
        a2_4<Float32> = (0.0 as Float32)
        q2_5<Float32> = (ld_f64(qb2 + 1280) as Float32) * scl
        a2_5<Float32> = (0.0 as Float32)
        q2_6<Float32> = (ld_f64(qb2 + 1536) as Float32) * scl
        a2_6<Float32> = (0.0 as Float32)
        q2_7<Float32> = (ld_f64(qb2 + 1792) as Float32) * scl
        a2_7<Float32> = (0.0 as Float32)
        mx2<Float32> = (-1e+30 as Float32)
        ls2<Float32> = (0.0 as Float32)
        qb3<Int> = Q + (s * H * HDp + (g * 6 + 3) * HDp + lane) * 8
        q3_0<Float32> = (ld_f64(qb3 + 0) as Float32) * scl
        a3_0<Float32> = (0.0 as Float32)
        q3_1<Float32> = (ld_f64(qb3 + 256) as Float32) * scl
        a3_1<Float32> = (0.0 as Float32)
        q3_2<Float32> = (ld_f64(qb3 + 512) as Float32) * scl
        a3_2<Float32> = (0.0 as Float32)
        q3_3<Float32> = (ld_f64(qb3 + 768) as Float32) * scl
        a3_3<Float32> = (0.0 as Float32)
        q3_4<Float32> = (ld_f64(qb3 + 1024) as Float32) * scl
        a3_4<Float32> = (0.0 as Float32)
        q3_5<Float32> = (ld_f64(qb3 + 1280) as Float32) * scl
        a3_5<Float32> = (0.0 as Float32)
        q3_6<Float32> = (ld_f64(qb3 + 1536) as Float32) * scl
        a3_6<Float32> = (0.0 as Float32)
        q3_7<Float32> = (ld_f64(qb3 + 1792) as Float32) * scl
        a3_7<Float32> = (0.0 as Float32)
        mx3<Float32> = (-1e+30 as Float32)
        ls3<Float32> = (0.0 as Float32)
        qb4<Int> = Q + (s * H * HDp + (g * 6 + 4) * HDp + lane) * 8
        q4_0<Float32> = (ld_f64(qb4 + 0) as Float32) * scl
        a4_0<Float32> = (0.0 as Float32)
        q4_1<Float32> = (ld_f64(qb4 + 256) as Float32) * scl
        a4_1<Float32> = (0.0 as Float32)
        q4_2<Float32> = (ld_f64(qb4 + 512) as Float32) * scl
        a4_2<Float32> = (0.0 as Float32)
        q4_3<Float32> = (ld_f64(qb4 + 768) as Float32) * scl
        a4_3<Float32> = (0.0 as Float32)
        q4_4<Float32> = (ld_f64(qb4 + 1024) as Float32) * scl
        a4_4<Float32> = (0.0 as Float32)
        q4_5<Float32> = (ld_f64(qb4 + 1280) as Float32) * scl
        a4_5<Float32> = (0.0 as Float32)
        q4_6<Float32> = (ld_f64(qb4 + 1536) as Float32) * scl
        a4_6<Float32> = (0.0 as Float32)
        q4_7<Float32> = (ld_f64(qb4 + 1792) as Float32) * scl
        a4_7<Float32> = (0.0 as Float32)
        mx4<Float32> = (-1e+30 as Float32)
        ls4<Float32> = (0.0 as Float32)
        qb5<Int> = Q + (s * H * HDp + (g * 6 + 5) * HDp + lane) * 8
        q5_0<Float32> = (ld_f64(qb5 + 0) as Float32) * scl
        a5_0<Float32> = (0.0 as Float32)
        q5_1<Float32> = (ld_f64(qb5 + 256) as Float32) * scl
        a5_1<Float32> = (0.0 as Float32)
        q5_2<Float32> = (ld_f64(qb5 + 512) as Float32) * scl
        a5_2<Float32> = (0.0 as Float32)
        q5_3<Float32> = (ld_f64(qb5 + 768) as Float32) * scl
        a5_3<Float32> = (0.0 as Float32)
        q5_4<Float32> = (ld_f64(qb5 + 1024) as Float32) * scl
        a5_4<Float32> = (0.0 as Float32)
        q5_5<Float32> = (ld_f64(qb5 + 1280) as Float32) * scl
        a5_5<Float32> = (0.0 as Float32)
        q5_6<Float32> = (ld_f64(qb5 + 1536) as Float32) * scl
        a5_6<Float32> = (0.0 as Float32)
        q5_7<Float32> = (ld_f64(qb5 + 1792) as Float32) * scl
        a5_7<Float32> = (0.0 as Float32)
        mx5<Float32> = (-1e+30 as Float32)
        ls5<Float32> = (0.0 as Float32)
        t<Int> = 0
        while (t < T) {
            ko<Int> = t * NKV * 8
            k0<Float32> = (ld_f64(kb + ko + 0) as Float32)
            k1<Float32> = (ld_f64(kb + ko + 256) as Float32)
            k2<Float32> = (ld_f64(kb + ko + 512) as Float32)
            k3<Float32> = (ld_f64(kb + ko + 768) as Float32)
            k4<Float32> = (ld_f64(kb + ko + 1024) as Float32)
            k5<Float32> = (ld_f64(kb + ko + 1280) as Float32)
            k6<Float32> = (ld_f64(kb + ko + 1536) as Float32)
            k7<Float32> = (ld_f64(kb + ko + 1792) as Float32)
            v0<Float32> = (ld_f64(vb + ko + 0) as Float32)
            v1<Float32> = (ld_f64(vb + ko + 256) as Float32)
            v2<Float32> = (ld_f64(vb + ko + 512) as Float32)
            v3<Float32> = (ld_f64(vb + ko + 768) as Float32)
            v4<Float32> = (ld_f64(vb + ko + 1024) as Float32)
            v5<Float32> = (ld_f64(vb + ko + 1280) as Float32)
            v6<Float32> = (ld_f64(vb + ko + 1536) as Float32)
            v7<Float32> = (ld_f64(vb + ko + 1792) as Float32)
            d0<Float32> = q0_0 * k0
            d0 = fma_f32(q0_1, k1, d0)
            d0 = fma_f32(q0_2, k2, d0)
            d0 = fma_f32(q0_3, k3, d0)
            d0 = fma_f32(q0_4, k4, d0)
            d0 = fma_f32(q0_5, k5, d0)
            d0 = fma_f32(q0_6, k6, d0)
            d0 = fma_f32(q0_7, k7, d0)
            d1<Float32> = q1_0 * k0
            d1 = fma_f32(q1_1, k1, d1)
            d1 = fma_f32(q1_2, k2, d1)
            d1 = fma_f32(q1_3, k3, d1)
            d1 = fma_f32(q1_4, k4, d1)
            d1 = fma_f32(q1_5, k5, d1)
            d1 = fma_f32(q1_6, k6, d1)
            d1 = fma_f32(q1_7, k7, d1)
            d2<Float32> = q2_0 * k0
            d2 = fma_f32(q2_1, k1, d2)
            d2 = fma_f32(q2_2, k2, d2)
            d2 = fma_f32(q2_3, k3, d2)
            d2 = fma_f32(q2_4, k4, d2)
            d2 = fma_f32(q2_5, k5, d2)
            d2 = fma_f32(q2_6, k6, d2)
            d2 = fma_f32(q2_7, k7, d2)
            d3<Float32> = q3_0 * k0
            d3 = fma_f32(q3_1, k1, d3)
            d3 = fma_f32(q3_2, k2, d3)
            d3 = fma_f32(q3_3, k3, d3)
            d3 = fma_f32(q3_4, k4, d3)
            d3 = fma_f32(q3_5, k5, d3)
            d3 = fma_f32(q3_6, k6, d3)
            d3 = fma_f32(q3_7, k7, d3)
            d4<Float32> = q4_0 * k0
            d4 = fma_f32(q4_1, k1, d4)
            d4 = fma_f32(q4_2, k2, d4)
            d4 = fma_f32(q4_3, k3, d4)
            d4 = fma_f32(q4_4, k4, d4)
            d4 = fma_f32(q4_5, k5, d4)
            d4 = fma_f32(q4_6, k6, d4)
            d4 = fma_f32(q4_7, k7, d4)
            d5<Float32> = q5_0 * k0
            d5 = fma_f32(q5_1, k1, d5)
            d5 = fma_f32(q5_2, k2, d5)
            d5 = fma_f32(q5_3, k3, d5)
            d5 = fma_f32(q5_4, k4, d5)
            d5 = fma_f32(q5_5, k5, d5)
            d5 = fma_f32(q5_6, k6, d5)
            d5 = fma_f32(q5_7, k7, d5)
            d0 = d0 + shfl_xor_f32(d0, 16)
            d1 = d1 + shfl_xor_f32(d1, 16)
            d2 = d2 + shfl_xor_f32(d2, 16)
            d3 = d3 + shfl_xor_f32(d3, 16)
            d4 = d4 + shfl_xor_f32(d4, 16)
            d5 = d5 + shfl_xor_f32(d5, 16)
            d0 = d0 + shfl_xor_f32(d0, 8)
            d1 = d1 + shfl_xor_f32(d1, 8)
            d2 = d2 + shfl_xor_f32(d2, 8)
            d3 = d3 + shfl_xor_f32(d3, 8)
            d4 = d4 + shfl_xor_f32(d4, 8)
            d5 = d5 + shfl_xor_f32(d5, 8)
            d0 = d0 + shfl_xor_f32(d0, 4)
            d1 = d1 + shfl_xor_f32(d1, 4)
            d2 = d2 + shfl_xor_f32(d2, 4)
            d3 = d3 + shfl_xor_f32(d3, 4)
            d4 = d4 + shfl_xor_f32(d4, 4)
            d5 = d5 + shfl_xor_f32(d5, 4)
            d0 = d0 + shfl_xor_f32(d0, 2)
            d1 = d1 + shfl_xor_f32(d1, 2)
            d2 = d2 + shfl_xor_f32(d2, 2)
            d3 = d3 + shfl_xor_f32(d3, 2)
            d4 = d4 + shfl_xor_f32(d4, 2)
            d5 = d5 + shfl_xor_f32(d5, 2)
            d0 = d0 + shfl_xor_f32(d0, 1)
            d1 = d1 + shfl_xor_f32(d1, 1)
            d2 = d2 + shfl_xor_f32(d2, 1)
            d3 = d3 + shfl_xor_f32(d3, 1)
            d4 = d4 + shfl_xor_f32(d4, 1)
            d5 = d5 + shfl_xor_f32(d5, 1)
            mn0<Float32> = max_f32(mx0, d0)
            c0<Float32> = ex2_f32(mx0 - mn0)
            pe0<Float32> = ex2_f32(d0 - mn0)
            mx0 = mn0
            ls0 = fma_f32(ls0, c0, pe0)
            a0_0 = fma_f32(a0_0, c0, pe0 * v0)
            a0_1 = fma_f32(a0_1, c0, pe0 * v1)
            a0_2 = fma_f32(a0_2, c0, pe0 * v2)
            a0_3 = fma_f32(a0_3, c0, pe0 * v3)
            a0_4 = fma_f32(a0_4, c0, pe0 * v4)
            a0_5 = fma_f32(a0_5, c0, pe0 * v5)
            a0_6 = fma_f32(a0_6, c0, pe0 * v6)
            a0_7 = fma_f32(a0_7, c0, pe0 * v7)
            mn1<Float32> = max_f32(mx1, d1)
            c1<Float32> = ex2_f32(mx1 - mn1)
            pe1<Float32> = ex2_f32(d1 - mn1)
            mx1 = mn1
            ls1 = fma_f32(ls1, c1, pe1)
            a1_0 = fma_f32(a1_0, c1, pe1 * v0)
            a1_1 = fma_f32(a1_1, c1, pe1 * v1)
            a1_2 = fma_f32(a1_2, c1, pe1 * v2)
            a1_3 = fma_f32(a1_3, c1, pe1 * v3)
            a1_4 = fma_f32(a1_4, c1, pe1 * v4)
            a1_5 = fma_f32(a1_5, c1, pe1 * v5)
            a1_6 = fma_f32(a1_6, c1, pe1 * v6)
            a1_7 = fma_f32(a1_7, c1, pe1 * v7)
            mn2<Float32> = max_f32(mx2, d2)
            c2<Float32> = ex2_f32(mx2 - mn2)
            pe2<Float32> = ex2_f32(d2 - mn2)
            mx2 = mn2
            ls2 = fma_f32(ls2, c2, pe2)
            a2_0 = fma_f32(a2_0, c2, pe2 * v0)
            a2_1 = fma_f32(a2_1, c2, pe2 * v1)
            a2_2 = fma_f32(a2_2, c2, pe2 * v2)
            a2_3 = fma_f32(a2_3, c2, pe2 * v3)
            a2_4 = fma_f32(a2_4, c2, pe2 * v4)
            a2_5 = fma_f32(a2_5, c2, pe2 * v5)
            a2_6 = fma_f32(a2_6, c2, pe2 * v6)
            a2_7 = fma_f32(a2_7, c2, pe2 * v7)
            mn3<Float32> = max_f32(mx3, d3)
            c3<Float32> = ex2_f32(mx3 - mn3)
            pe3<Float32> = ex2_f32(d3 - mn3)
            mx3 = mn3
            ls3 = fma_f32(ls3, c3, pe3)
            a3_0 = fma_f32(a3_0, c3, pe3 * v0)
            a3_1 = fma_f32(a3_1, c3, pe3 * v1)
            a3_2 = fma_f32(a3_2, c3, pe3 * v2)
            a3_3 = fma_f32(a3_3, c3, pe3 * v3)
            a3_4 = fma_f32(a3_4, c3, pe3 * v4)
            a3_5 = fma_f32(a3_5, c3, pe3 * v5)
            a3_6 = fma_f32(a3_6, c3, pe3 * v6)
            a3_7 = fma_f32(a3_7, c3, pe3 * v7)
            mn4<Float32> = max_f32(mx4, d4)
            c4<Float32> = ex2_f32(mx4 - mn4)
            pe4<Float32> = ex2_f32(d4 - mn4)
            mx4 = mn4
            ls4 = fma_f32(ls4, c4, pe4)
            a4_0 = fma_f32(a4_0, c4, pe4 * v0)
            a4_1 = fma_f32(a4_1, c4, pe4 * v1)
            a4_2 = fma_f32(a4_2, c4, pe4 * v2)
            a4_3 = fma_f32(a4_3, c4, pe4 * v3)
            a4_4 = fma_f32(a4_4, c4, pe4 * v4)
            a4_5 = fma_f32(a4_5, c4, pe4 * v5)
            a4_6 = fma_f32(a4_6, c4, pe4 * v6)
            a4_7 = fma_f32(a4_7, c4, pe4 * v7)
            mn5<Float32> = max_f32(mx5, d5)
            c5<Float32> = ex2_f32(mx5 - mn5)
            pe5<Float32> = ex2_f32(d5 - mn5)
            mx5 = mn5
            ls5 = fma_f32(ls5, c5, pe5)
            a5_0 = fma_f32(a5_0, c5, pe5 * v0)
            a5_1 = fma_f32(a5_1, c5, pe5 * v1)
            a5_2 = fma_f32(a5_2, c5, pe5 * v2)
            a5_3 = fma_f32(a5_3, c5, pe5 * v3)
            a5_4 = fma_f32(a5_4, c5, pe5 * v4)
            a5_5 = fma_f32(a5_5, c5, pe5 * v5)
            a5_6 = fma_f32(a5_6, c5, pe5 * v6)
            a5_7 = fma_f32(a5_7, c5, pe5 * v7)
            t = t + 1
        }
        inv0<Float32> = (1.0 as Float32) / ls0
        ob0<Int> = CTX + (s * H * HDp + (g * 6 + 0) * HDp + lane) * 8
        st_f64(ob0 + 0, (a0_0 * inv0) as Float)
        st_f64(ob0 + 256, (a0_1 * inv0) as Float)
        st_f64(ob0 + 512, (a0_2 * inv0) as Float)
        st_f64(ob0 + 768, (a0_3 * inv0) as Float)
        st_f64(ob0 + 1024, (a0_4 * inv0) as Float)
        st_f64(ob0 + 1280, (a0_5 * inv0) as Float)
        st_f64(ob0 + 1536, (a0_6 * inv0) as Float)
        st_f64(ob0 + 1792, (a0_7 * inv0) as Float)
        inv1<Float32> = (1.0 as Float32) / ls1
        ob1<Int> = CTX + (s * H * HDp + (g * 6 + 1) * HDp + lane) * 8
        st_f64(ob1 + 0, (a1_0 * inv1) as Float)
        st_f64(ob1 + 256, (a1_1 * inv1) as Float)
        st_f64(ob1 + 512, (a1_2 * inv1) as Float)
        st_f64(ob1 + 768, (a1_3 * inv1) as Float)
        st_f64(ob1 + 1024, (a1_4 * inv1) as Float)
        st_f64(ob1 + 1280, (a1_5 * inv1) as Float)
        st_f64(ob1 + 1536, (a1_6 * inv1) as Float)
        st_f64(ob1 + 1792, (a1_7 * inv1) as Float)
        inv2<Float32> = (1.0 as Float32) / ls2
        ob2<Int> = CTX + (s * H * HDp + (g * 6 + 2) * HDp + lane) * 8
        st_f64(ob2 + 0, (a2_0 * inv2) as Float)
        st_f64(ob2 + 256, (a2_1 * inv2) as Float)
        st_f64(ob2 + 512, (a2_2 * inv2) as Float)
        st_f64(ob2 + 768, (a2_3 * inv2) as Float)
        st_f64(ob2 + 1024, (a2_4 * inv2) as Float)
        st_f64(ob2 + 1280, (a2_5 * inv2) as Float)
        st_f64(ob2 + 1536, (a2_6 * inv2) as Float)
        st_f64(ob2 + 1792, (a2_7 * inv2) as Float)
        inv3<Float32> = (1.0 as Float32) / ls3
        ob3<Int> = CTX + (s * H * HDp + (g * 6 + 3) * HDp + lane) * 8
        st_f64(ob3 + 0, (a3_0 * inv3) as Float)
        st_f64(ob3 + 256, (a3_1 * inv3) as Float)
        st_f64(ob3 + 512, (a3_2 * inv3) as Float)
        st_f64(ob3 + 768, (a3_3 * inv3) as Float)
        st_f64(ob3 + 1024, (a3_4 * inv3) as Float)
        st_f64(ob3 + 1280, (a3_5 * inv3) as Float)
        st_f64(ob3 + 1536, (a3_6 * inv3) as Float)
        st_f64(ob3 + 1792, (a3_7 * inv3) as Float)
        inv4<Float32> = (1.0 as Float32) / ls4
        ob4<Int> = CTX + (s * H * HDp + (g * 6 + 4) * HDp + lane) * 8
        st_f64(ob4 + 0, (a4_0 * inv4) as Float)
        st_f64(ob4 + 256, (a4_1 * inv4) as Float)
        st_f64(ob4 + 512, (a4_2 * inv4) as Float)
        st_f64(ob4 + 768, (a4_3 * inv4) as Float)
        st_f64(ob4 + 1024, (a4_4 * inv4) as Float)
        st_f64(ob4 + 1280, (a4_5 * inv4) as Float)
        st_f64(ob4 + 1536, (a4_6 * inv4) as Float)
        st_f64(ob4 + 1792, (a4_7 * inv4) as Float)
        inv5<Float32> = (1.0 as Float32) / ls5
        ob5<Int> = CTX + (s * H * HDp + (g * 6 + 5) * HDp + lane) * 8
        st_f64(ob5 + 0, (a5_0 * inv5) as Float)
        st_f64(ob5 + 256, (a5_1 * inv5) as Float)
        st_f64(ob5 + 512, (a5_2 * inv5) as Float)
        st_f64(ob5 + 768, (a5_3 * inv5) as Float)
        st_f64(ob5 + 1024, (a5_4 * inv5) as Float)
        st_f64(ob5 + 1280, (a5_5 * inv5) as Float)
        st_f64(ob5 + 1536, (a5_6 * inv5) as Float)
        st_f64(ob5 + 1792, (a5_7 * inv5) as Float)
    }
}


// norm_gated_b in f32, one warp per row of D = 128 (4 elements per lane), f32 output (fuses cast32).
// Params X@0 Z@8 W@16 (f64) Y@24 (f32) NR@32 rows D@40 eps@48. Grid ceil(NR/8) x 256.
ng_b32(p<Int>) -> {
    X<Int> = ld_i64(p + 0)
    Z<Int> = ld_i64(p + 8)
    W<Int> = ld_i64(p + 16)
    Y<Int> = ld_i64(p + 24)
    NR<Int> = ld_i64(p + 32)
    D<Int> = ld_i64(p + 40)
    eps<Float32> = (ld_f64(p + 48) as Float32)
    tid<Int> = tid_x()
    lane<Int> = tid % 32
    r<Int> = blk_x() * 8 + tid / 32
    l2e<Float32> = (1.4426950408889634 as Float32)
    one<Float32> = (1.0 as Float32)
    if (r < NR) {
        xb<Int> = X + (r * D + lane) * 8
        zb<Int> = Z + (r * D + lane) * 8
        v0<Float32> = (ld_f64(xb) as Float32)
        v1<Float32> = (ld_f64(xb + 256) as Float32)
        v2<Float32> = (ld_f64(xb + 512) as Float32)
        v3<Float32> = (ld_f64(xb + 768) as Float32)
        ss<Float32> = v0 * v0 + v1 * v1 + v2 * v2 + v3 * v3
        ss = ss + shfl_xor_f32(ss, 16)
        ss = ss + shfl_xor_f32(ss, 8)
        ss = ss + shfl_xor_f32(ss, 4)
        ss = ss + shfl_xor_f32(ss, 2)
        ss = ss + shfl_xor_f32(ss, 1)
        ri<Float32> = one / sqrt_f32(ss / (D as Float32) + eps)
        yb<Int> = Y + (r * D + lane) * 4
        z0<Float32> = (ld_f64(zb) as Float32)
        z1<Float32> = (ld_f64(zb + 256) as Float32)
        z2<Float32> = (ld_f64(zb + 512) as Float32)
        z3<Float32> = (ld_f64(zb + 768) as Float32)
        st_f32n(yb, v0 * ri * (ld_f64(W + lane * 8) as Float32) * (z0 / (one + ex2_f32(z0 * (0.0 - l2e)))))
        st_f32n(yb + 128, v1 * ri * (ld_f64(W + (lane + 32) * 8) as Float32) * (z1 / (one + ex2_f32(z1 * (0.0 - l2e)))))
        st_f32n(yb + 256, v2 * ri * (ld_f64(W + (lane + 64) * 8) as Float32) * (z2 / (one + ex2_f32(z2 * (0.0 - l2e)))))
        st_f32n(yb + 384, v3 * ri * (ld_f64(W + (lane + 96) * 8) as Float32) * (z3 / (one + ex2_f32(z3 * (0.0 - l2e)))))
    }
}

// l2n_bs in f32, one warp per q/k head vector of D = 128. Params = l2n_bs + NR@64 (= S*2*HK).
// Grid ceil(NR/8) x 256.
l2n_b32(p<Int>) -> {
    X<Int> = ld_i64(p + 0)
    QN<Int> = ld_i64(p + 8)
    KN<Int> = ld_i64(p + 16)
    HK<Int> = ld_i64(p + 24)
    D<Int> = ld_i64(p + 32)
    QKS<Int> = ld_i64(p + 40)
    GK<Int> = ld_i64(p + 48)
    eps<Float32> = (ld_f64(p + 56) as Float32)
    NR<Int> = ld_i64(p + 64)
    tid<Int> = tid_x()
    lane<Int> = tid % 32
    b<Int> = blk_x() * 8 + tid / 32
    if (b < NR) {
        s<Int> = b / (2 * HK)
        r<Int> = b % (2 * HK)
        src<Int> = X + (s * QKS + r * D + lane) * 8
        dst<Int> = QN + (s * GK + r * D + lane) * 8
        if (r >= HK) { dst = KN + (s * GK + (r - HK) * D + lane) * 8 }
        v0<Float32> = (ld_f64(src) as Float32)
        v1<Float32> = (ld_f64(src + 256) as Float32)
        v2<Float32> = (ld_f64(src + 512) as Float32)
        v3<Float32> = (ld_f64(src + 768) as Float32)
        ss<Float32> = v0 * v0 + v1 * v1 + v2 * v2 + v3 * v3
        ss = ss + shfl_xor_f32(ss, 16)
        ss = ss + shfl_xor_f32(ss, 8)
        ss = ss + shfl_xor_f32(ss, 4)
        ss = ss + shfl_xor_f32(ss, 2)
        ss = ss + shfl_xor_f32(ss, 1)
        sq<Float32> = max_f32(sqrt_f32(ss), eps)
        iv<Float32> = (1.0 as Float32) / sq
        st_f64(dst, (v0 * iv) as Float)
        st_f64(dst + 256, (v1 * iv) as Float)
        st_f64(dst + 512, (v2 * iv) as Float)
        st_f64(dst + 768, (v3 * iv) as Float)
    }
}

// silu32 in f32: h = silu(g) * u (g, u f64; h f32).
silu_b32(g<Int>, u<Int>, h<Int>, n<Int>) -> {
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < n) {
        gv<Float32> = (ld_f64(g + gid * 8) as Float32)
        uv<Float32> = (ld_f64(u + gid * 8) as Float32)
        st_f32n(h + gid * 4, gv * uv / ((1.0 as Float32) + ex2_f32(gv * (-1.4426950408889634 as Float32))))
    }
}

