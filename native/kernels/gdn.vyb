// Gated DeltaNet recurrent-layer kernels (phase 4 item 1, unit 6).
//
// The three pieces of a qwen35 linear-attention layer that are NOT gemms and therefore have no
// existing kernel to reuse: the l2 normalisation on q/k, the delta-rule step itself, and the gated
// RMS epilogue. Everything is fp64; the reference for the gate is therefore fp64 too, so the
// comparison measures the kernels rather than a precision floor.
//
// Layouts are ggml's (ne0 fastest), all fp64, one token (T=1), one sequence (B=1) — the geometry the
// op's sequential kernel covers:
//   q, k : ne (S, H_k)      element (i, h)      at i + S*h
//   v    : ne (S, H_v)      element (i, h)      at i + S*h
//   gate, beta : ne (1, H_v) at h
//   state: ne (S, S, H_v)   element (j, i, h)   at i + S*(j + S*h)      (i fastest, then j, then h)
//   out  : ne (S, H_v)
//
// The maths, as established against ggml's own op in unit 1 (MAXREL 1.55e-07):
//   dec[j,i] = gexp * state[j,i]                  gexp = exp(gate[h])
//   delta[j] = (v[j] - sum_i dec[j,i] * k_hk[i]) * beta[h]
//   state'[j,i] = dec[j,i] + delta[j] * k_hk[i]
//   out[i] = scale * sum_j state'[j,i] * q_hk[j]        scale = 1/sqrt(S)
// with the q/k -> v head broadcast k_hk = h % H_k (interleaved), established by data, not by reading
// the header.
//
// Written out per head rather than per state element so the whole head is one thread's sequential
// work — no cross-thread reduction, no barrier, no shared memory.
//
// The read-out contraction is the one place this kernel can silently transpose: the op computes
// out = m @ q, contracting q with the state's SECOND axis (out lives on the first), and delta with
// the same axis against k. Expanding it avoids a second state sweep and makes the axis explicit:
//   kq = sum_i k[i]*q[i]
//   out[j] = scale * (gexp * sum_i state[j,i]*q[i] + delta[j] * kq)
import vmath::{vexp, vsqrt}

// ---- l2 normalisation along ne0 (per head), eps as a FLOOR after the sqrt (ops.cpp:4198-4206) ----
// Params (device, 40 B): +0 X, +8 Y, +16 rows, +24 D, +32 eps(Float).
l2norm(p<Int>) -> {
    X<Int> = ld_i64(p + 0)
    Y<Int> = ld_i64(p + 8)
    rows<Int> = ld_i64(p + 16)
    D<Int> = ld_i64(p + 24)
    eps<Float> = ld_f64(p + 32)
    total<Int> = rows * D
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < total) {
        rw<Int> = gid / D
        d<Int> = gid % D
        ss<Float> = 0.0
        j<Int> = 0
        for (j in 0..D - 1) {
            v<Float> = ld_f64(X + (rw * D + j) * 8)
            ss = ss + v * v
        }
        s<Float> = vsqrt(ss, 40)
        if (s < eps) { s = eps }
        xv<Float> = ld_f64(X + (rw * D + d) * 8)
        st_f64(Y + (rw * D + d) * 8, xv / s)
    }
}

// ---- the delta-rule step, one thread per head ------------------------------------------------
// Params (device, 104 B): +0 Q, +8 K, +16 V, +24 G, +32 BETA, +40 SIN, +48 SOUT, +56 OUT,
//                         +64 DEL (scratch S*H_v), +72 S, +80 H_k, +88 H_v, +96 scale(Float).
delta_step(p<Int>) -> {
    Q<Int> = ld_i64(p + 0)
    K<Int> = ld_i64(p + 8)
    V<Int> = ld_i64(p + 16)
    G<Int> = ld_i64(p + 24)
    BE<Int> = ld_i64(p + 32)
    SIN<Int> = ld_i64(p + 40)
    SOUT<Int> = ld_i64(p + 48)
    OUT<Int> = ld_i64(p + 56)
    DEL<Int> = ld_i64(p + 64)
    S<Int> = ld_i64(p + 72)
    Hk<Int> = ld_i64(p + 80)
    Hv<Int> = ld_i64(p + 88)
    sc<Float> = ld_f64(p + 96)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < Hv) {
        h<Int> = gid
        hk<Int> = h % Hk
        gexp<Float> = vexp(ld_f64(G + h * 8))
        be<Float> = ld_f64(BE + h * 8)
        stb<Int> = S * S * h
        # kq = sum_i k[i]*q[i] — the scalar the state update contributes to the read-out
        kq<Float> = 0.0
        i<Int> = 0
        for (i in 0..S - 1) {
            kq = kq + ld_f64(K + (i + S * hk) * 8) * ld_f64(Q + (i + S * hk) * 8)
        }
        # pass A: for each output row j, the pre-update prediction over the state's second axis,
        # delta, and the read-out row — all three from one sweep of that row.
        j<Int> = 0
        for (j in 0..S - 1) {
            acc<Float> = 0.0
            acq<Float> = 0.0
            i = 0
            for (i in 0..S - 1) {
                sv<Float> = ld_f64(SIN + (stb + j * S + i) * 8)
                acc = acc + sv * ld_f64(K + (i + S * hk) * 8)
                acq = acq + sv * ld_f64(Q + (i + S * hk) * 8)
            }
            del<Float> = (ld_f64(V + (j + S * h) * 8) - gexp * acc) * be
            st_f64(DEL + (j + S * h) * 8, del)
            st_f64(OUT + (j + S * h) * 8, sc * (gexp * acq + del * kq))
        }
        # pass B: the state update
        j = 0
        for (j in 0..S - 1) {
            del2<Float> = ld_f64(DEL + (j + S * h) * 8)
            i = 0
            for (i in 0..S - 1) {
                sv3<Float> = ld_f64(SIN + (stb + j * S + i) * 8)
                kv3<Float> = ld_f64(K + (i + S * hk) * 8)
                st_f64(SOUT + (stb + j * S + i) * 8, gexp * sv3 + del2 * kv3)
            }
        }
    }
}

// ---- the gated RMS epilogue: y = RMSNorm(x, w) * SiLU(z), along ne0 --------------------------
// Params (device, 56 B): +0 X, +8 Z, +16 W, +24 Y, +32 rows, +40 D, +48 eps(Float).
norm_gated(p<Int>) -> {
    X<Int> = ld_i64(p + 0)
    Z<Int> = ld_i64(p + 8)
    W<Int> = ld_i64(p + 16)
    Y<Int> = ld_i64(p + 24)
    rows<Int> = ld_i64(p + 32)
    D<Int> = ld_i64(p + 40)
    eps<Float> = ld_f64(p + 48)
    total<Int> = rows * D
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < total) {
        rw<Int> = gid / D
        d<Int> = gid % D
        ss<Float> = 0.0
        j<Int> = 0
        for (j in 0..D - 1) {
            v<Float> = ld_f64(X + (rw * D + j) * 8)
            ss = ss + v * v
        }
        r<Float> = 1.0 / vsqrt(ss / (D as Float) + eps, 40)
        xv<Float> = ld_f64(X + (rw * D + d) * 8)
        wv<Float> = ld_f64(W + d * 8)
        zv<Float> = ld_f64(Z + (rw * D + d) * 8)
        sg<Float> = 1.0 + vexp(0.0 - zv)
        st_f64(Y + (rw * D + d) * 8, xv * r * wv * (zv / sg))
    }
}

// ---- the rest of the block: projections, gates, conv, residual -------------------------------
// One params-buffer kernel per piece, in the same style as the three above.

// log, built from +,-,*,/ because the libm builtin does not lower in kernel mode. Range-reduce to
// m in [1,2) with x = m * 2^k, then the atanh series ln m = 2 z (1 + z^2/3 + z^4/5 + ...), z =
// (m-1)/(m+1) <= 1/3. Twelve terms put the truncation below 1e-13 relative.
vlog(x<Float>)<Float> -> {
    m<Float> = x
    k<Int> = 0
    i<Int> = 0
    for (i in 0..63) {
        if (m >= 2.0) { m = m * 0.5 ; k = k + 1 }
    }
    for (i in 0..63) {
        if (m < 1.0) { m = m * 2.0 ; k = k - 1 }
    }
    z<Float> = (m - 1.0) / (m + 1.0)
    z2<Float> = z * z
    s<Float> = 1.0
    p<Float> = z2
    j<Int> = 0
    for (j in 1..12) {
        s = s + p / (2.0 * (j as Float) + 1.0)
        p = p * z2
    }
    return (k as Float) * 0.6931471805599453 + 2.0 * z * s
}

// softplus, ggml's form (unary-ops.cpp op_softplus): (x > 20) ? x : log(1 + exp(x))
vsoftplus(x<Float>)<Float> -> {
    if (x > 20.0) { return x }
    return vlog(1.0 + vexp(x))
}

// out[m,n] = sum_k x[m,k] * w[n,k] — both operands row-major, which is what a ggml weight of ne
// (K, N) is (its memory is a numpy (N, K) array). Avoids transposing either operand on the host.
// Params (device, 48 B): +0 X, +8 W, +16 Y, +24 M, +32 N, +40 K.
mm_nt(p<Int>) -> {
    X<Int> = ld_i64(p + 0)
    W<Int> = ld_i64(p + 8)
    Y<Int> = ld_i64(p + 16)
    M<Int> = ld_i64(p + 24)
    N<Int> = ld_i64(p + 32)
    K<Int> = ld_i64(p + 40)
    total<Int> = M * N
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < total) {
        m<Int> = gid / N
        n<Int> = gid % N
        acc<Float> = 0.0
        k<Int> = 0
        for (k in 0..K - 1) {
            acc = acc + ld_f64(X + (m * K + k) * 8) * ld_f64(W + (n * K + k) * 8)
        }
        st_f64(Y + (m * N + n) * 8, acc)
    }
}

// beta = sigmoid(alpha_projection). Params (device, 24 B): +0 X, +8 Y, +16 n.
sigmoid_k(p<Int>) -> {
    X<Int> = ld_i64(p + 0)
    Y<Int> = ld_i64(p + 8)
    n<Int> = ld_i64(p + 16)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < n) {
        v<Float> = ld_f64(X + gid * 8)
        st_f64(Y + gid * 8, 1.0 / (1.0 + vexp(0.0 - v)))
    }
}

// the alpha gate: softplus(alpha + ssm_dt) * ssm_a, per head.
// Params (device, 40 B): +0 A, +8 DT, +16 SA, +24 OUT, +32 n.
alpha_gate(p<Int>) -> {
    A<Int> = ld_i64(p + 0)
    DT<Int> = ld_i64(p + 8)
    SA<Int> = ld_i64(p + 16)
    OUT<Int> = ld_i64(p + 24)
    n<Int> = ld_i64(p + 32)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < n) {
        v<Float> = ld_f64(A + gid * 8) + ld_f64(DT + gid * 8)
        st_f64(OUT + gid * 8, vsoftplus(v) * ld_f64(SA + gid * 8))
    }
}

// y = x * sigmoid(x), elementwise. Params (device, 24 B): +0 X, +8 Y, +16 n.
silu_k(p<Int>) -> {
    X<Int> = ld_i64(p + 0)
    Y<Int> = ld_i64(p + 8)
    n<Int> = ld_i64(p + 16)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < n) {
        v<Float> = ld_f64(X + gid * 8)
        st_f64(Y + gid * 8, v / (1.0 + vexp(0.0 - v)))
    }
}

// y = a + b, elementwise. Params (device, 32 B): +0 A, +8 B, +16 Y, +24 n.
add_k(p<Int>) -> {
    A<Int> = ld_i64(p + 0)
    B<Int> = ld_i64(p + 8)
    Y<Int> = ld_i64(p + 16)
    n<Int> = ld_i64(p + 24)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < n) {
        st_f64(Y + gid * 8, ld_f64(A + gid * 8) + ld_f64(B + gid * 8))
    }
}

// the causal depthwise short convolution over all qkv_dim channels, on exactly the buffer
// ggml_ssm_conv takes: ne (ncs, qkv_dim) with the FRAME fastest (memory ncs*ch + frame), the window
// occupying frames 0..d_conv-2 and the tokens the rest. numpy shape is (qkv_dim, ncs).
//   S: ne (ncs, qkv_dim)    memory index frame + ncs*ch        ncs = d_conv-1+T
//   W: ne (d_conv, qkv_dim) memory index j + d_conv*ch         (numpy (qkv_dim, d_conv))
//   Y: ne (qkv_dim, T)      memory index ch + QKV*t
// Params (device, 48 B): +0 S, +8 W, +16 Y, +24 QKV, +32 D_CONV, +40 T.
conv1d_k(p<Int>) -> {
    S<Int> = ld_i64(p + 0)
    W<Int> = ld_i64(p + 8)
    Y<Int> = ld_i64(p + 16)
    QKV<Int> = ld_i64(p + 24)
    DC<Int> = ld_i64(p + 32)
    T<Int> = ld_i64(p + 40)
    ncs<Int> = DC - 1 + T
    total<Int> = QKV * T
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < total) {
        ch<Int> = gid % QKV
        t<Int> = gid / QKV
        acc<Float> = 0.0
        j<Int> = 0
        for (j in 0..DC - 1) {
            acc = acc + ld_f64(S + (ncs * ch + t + j) * 8) * ld_f64(W + (ch * DC + j) * 8)
        }
        st_f64(Y + (ch + QKV * t) * 8, acc)
    }
}

// the token frames into the conv buffer: what build_conv_state's ggml_concat produces, since the
// concat's ne0 axis is the frame and the window slots sit at ncs*ch + 0..d_conv-2.
//   Q: ne (qkv_dim, T)      memory ch + QKV*t      (a projection's output)
//   S: ne (ncs, qkv_dim)    memory frame + ncs*ch
// Params (device, 40 B): +0 Q, +8 S, +16 QKV, +24 D_CONV, +32 T.
interleave_qkv(p<Int>) -> {
    Q<Int> = ld_i64(p + 0)
    S<Int> = ld_i64(p + 8)
    QKV<Int> = ld_i64(p + 16)
    DC<Int> = ld_i64(p + 24)
    T<Int> = ld_i64(p + 32)
    ncs<Int> = DC - 1 + T
    total<Int> = QKV * T
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < total) {
        ch<Int> = gid % QKV
        t<Int> = gid / QKV
        st_f64(S + (ncs * ch + DC - 1 + t) * 8, ld_f64(Q + (ch + QKV * t) * 8))
    }
}
