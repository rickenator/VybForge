// dbg_sh — dump device-side inputs the fused path consumes, as f32.
// p: +0 out(f32 x 12), +8 H(f32 128x128), +16 su(f16), +24 x(f32)
// out[0..3] = H[0..3], out[4..7] = su[0..3], out[8..11] = x[0..3]
dbg_sh(p<Int>) -> {
    O<Int> = ld_i64(p + 0)
    H<Int> = ld_i64(p + 8)
    SU<Int> = ld_i64(p + 16)
    X<Int> = ld_i64(p + 24)
    t<Int> = tid_x()
    if (t < 4) {
        st_f32(O + t * 4, ld_f32n(H + t * 4))
        st_f32(O + 16 + t * 4, ld_f16(SU + t * 2) as Float32)
        st_f32(O + 32 + t * 4, ld_f32n(X + t * 4))
    }
}

// f32t64 — copy n f32 elements to an f64 buffer (so bulk_dtoh can read them
// honestly; the earlier "values are zero" readings were f32 read as f64).
// p: +0 src(f32), +8 dst(f64), +16 n
f32t64(p<Int>) -> {
    S<Int> = ld_i64(p + 0)
    D<Int> = ld_i64(p + 8)
    N<Int> = ld_i64(p + 16)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < N) { st_f64(D + gid * 8, ld_f32n(S + gid * 4)) }
}

// cmp32 — elementwise |a-b| over n f32: count of diffs > 1e-4 plus the sum of
// |diff| (atomic_max_f32 does not exist in the dialect; a sum is enough to tell
// "identical" from "shifted").
// p: +0 a(f32), +8 b(f32), +16 n, +24 cnt(i32), +32 sum(f64)
cmp32(p<Int>) -> {
    A<Int> = ld_i64(p + 0)
    B<Int> = ld_i64(p + 8)
    N<Int> = ld_i64(p + 16)
    C<Int> = ld_i64(p + 24)
    M<Int> = ld_i64(p + 32)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < N) {
        d<Float32> = ld_f32n(A + gid * 4) - ld_f32n(B + gid * 4)
        ad<Float32> = d
        if (ad < 0.0) { ad = 0.0 - ad }
        if (ad > 0.0001) { atomic_add_i32(C, 1) }
        atomic_add_f64(M, ad as Float)
    }
}

// refu — the plainest reference matvec: u[n] = sum_k T[k][n] xp[k], then x sv.
refmatvec(p<Int>) -> {
    T<Int> = ld_i64(p + 0)
    X<Int> = ld_i64(p + 8)
    cw<Int> = ld_i64(p + 16)
    nin<Int> = ld_i64(p + 24)
    O<Int> = ld_i64(p + 32)
    SV<Int> = ld_i64(p + 40)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < cw) {
        acc<Float32> = 0.0
        k<Int> = 0
        while (k < nin) {
            acc = acc + ld_f32n(T + (k * cw + gid) * 4) * ld_f32n(X + k * 4)
            k = k + 1
        }
        sv<Float32> = ld_f16(SV + gid * 2) as Float32
        st_f32(O + gid * 4, acc * sv)
    }
}

