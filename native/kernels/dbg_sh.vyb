// dbg_sh — dump device-side inputs the fused path consumes, as f32.
// p: +0 out(f32 x 12), +8 H(f32 128x128), +16 su(f16), +24 x(f32)
// out[0..3] = H[0..3], out[4..7] = su[0..3], out[8..11] = x[0..3]
dbg_sh(p<Int>) -> {
    O<Int> = ld_i64(p + 0)
    H<Int> = ld_i64(p + 8)
    SU<Int> = ld_i64(p + 16)
    X<Int> = ld_i64(p + 24)
    t<Int> = tid_x()
    if (t < 4) {
        st_f32(O + t * 4, ld_f32n(H + t * 4))
        st_f32(O + 16 + t * 4, ld_f16(SU + t * 2) as Float32)
        st_f32(O + 32 + t * 4, ld_f32n(X + t * 4))
    }
}

// f32t64 — copy n f32 elements to an f64 buffer (so bulk_dtoh can read them
// honestly; the earlier "values are zero" readings were f32 read as f64).
// p: +0 src(f32), +8 dst(f64), +16 n
f32t64(p<Int>) -> {
    S<Int> = ld_i64(p + 0)
    D<Int> = ld_i64(p + 8)
    N<Int> = ld_i64(p + 16)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < N) { st_f64(D + gid * 8, ld_f32n(S + gid * 4)) }
}
