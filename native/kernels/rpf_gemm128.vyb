        acc = acc + shfl_xor_f64(acc, 2)
        acq = acq + shfl_xor_f64(acq, 1)
        acq = acq + shfl_xor_f64(acq, 2)
        kq = kq + shfl_xor_f64(kq, 1)
        kq = kq + shfl_xor_f64(kq, 2)
        gg<Float> = vexp(ld_f64(G + (t * HV + h) * 8))
        be<Float> = ld_f64(BE + (t * HV + h) * 8)
        del<Float> = (ld_f64(V + (t * QKS + h * SSd + j) * 8) - gg * acc) * be
        if (qt == 0) { st_f64(OUT + (t * HV * SSd + h * SSd + j) * 8, sc * (gg * acq + del * kq)) }
        s0 = gg * s0 + del * k0
        s1 = gg * s1 + del * k1
        s2 = gg * s2 + del * k2
        s3 = gg * s3 + del * k3
        s4 = gg * s4 + del * k4
        s5 = gg * s5 + del * k5
        s6 = gg * s6 + del * k6
        s7 = gg * s7 + del * k7
        s8 = gg * s8 + del * k8
        s9 = gg * s9 + del * k9
        s10 = gg * s10 + del * k10
        s11 = gg * s11 + del * k11
        s12 = gg * s12 + del * k12
        s13 = gg * s13 + del * k13
        s14 = gg * s14 + del * k14
        s15 = gg * s15 + del * k15
        s16 = gg * s16 + del * k16
        s17 = gg * s17 + del * k17
        s18 = gg * s18 + del * k18
        s19 = gg * s19 + del * k19
        s20 = gg * s20 + del * k20
        s21 = gg * s21 + del * k21
        s22 = gg * s22 + del * k22
        s23 = gg * s23 + del * k23
        s24 = gg * s24 + del * k24
        s25 = gg * s25 + del * k25
        s26 = gg * s26 + del * k26
        s27 = gg * s27 + del * k27
        s28 = gg * s28 + del * k28
        s29 = gg * s29 + del * k29
        s30 = gg * s30 + del * k30
        s31 = gg * s31 + del * k31
        kernel_barrier()
        t = t + 1
    }
    st_f64(sb + 0, s0)
    st_f64(sb + 8, s1)
    st_f64(sb + 16, s2)
    st_f64(sb + 24, s3)
    st_f64(sb + 32, s4)
    st_f64(sb + 40, s5)
    st_f64(sb + 48, s6)
    st_f64(sb + 56, s7)
    st_f64(sb + 64, s8)
    st_f64(sb + 72, s9)
    st_f64(sb + 80, s10)
    st_f64(sb + 88, s11)
    st_f64(sb + 96, s12)
    st_f64(sb + 104, s13)
    st_f64(sb + 112, s14)
    st_f64(sb + 120, s15)
    st_f64(sb + 128, s16)
    st_f64(sb + 136, s17)
    st_f64(sb + 144, s18)
    st_f64(sb + 152, s19)
    st_f64(sb + 160, s20)
    st_f64(sb + 168, s21)
    st_f64(sb + 176, s22)
    st_f64(sb + 184, s23)
    st_f64(sb + 192, s24)
    st_f64(sb + 200, s25)
    st_f64(sb + 208, s26)
    st_f64(sb + 216, s27)
    st_f64(sb + 224, s28)
    st_f64(sb + 232, s29)
    st_f64(sb + 240, s30)
    st_f64(sb + 248, s31)
}

