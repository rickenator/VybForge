delta_seq(p<Int>) -> {
    Q<Int> = ld_i64(p + 0)
    K<Int> = ld_i64(p + 8)
    V<Int> = ld_i64(p + 16)
    G<Int> = ld_i64(p + 24)
    BE<Int> = ld_i64(p + 32)
    ST<Int> = ld_i64(p + 40)
    OUT<Int> = ld_i64(p + 48)
    NT<Int> = ld_i64(p + 56)
    SSd<Int> = ld_i64(p + 64)
    HK<Int> = ld_i64(p + 72)
    HV<Int> = ld_i64(p + 80)
    QKS<Int> = ld_i64(p + 96)
    GKS<Int> = ld_i64(p + 104)
    sc<Float> = ld_f64(p + 88)
    tid<Int> = tid_x()
    b<Int> = blk_x()
    h<Int> = b / 4
    j<Int> = (b % 4) * 32 + tid / 4
    qt<Int> = tid % 4
    hk<Int> = h % HK
    ib<Int> = qt * 32
    sb<Int> = ST + (SSd * SSd * h + j * SSd + ib) * 8
    s0<Float> = ld_f64(sb + 0)
    s1<Float> = ld_f64(sb + 8)
    s2<Float> = ld_f64(sb + 16)
    s3<Float> = ld_f64(sb + 24)
    s4<Float> = ld_f64(sb + 32)
    s5<Float> = ld_f64(sb + 40)
    s6<Float> = ld_f64(sb + 48)
    s7<Float> = ld_f64(sb + 56)
    s8<Float> = ld_f64(sb + 64)
    s9<Float> = ld_f64(sb + 72)
    s10<Float> = ld_f64(sb + 80)
    s11<Float> = ld_f64(sb + 88)
    s12<Float> = ld_f64(sb + 96)
    s13<Float> = ld_f64(sb + 104)
    s14<Float> = ld_f64(sb + 112)
    s15<Float> = ld_f64(sb + 120)
    s16<Float> = ld_f64(sb + 128)
    s17<Float> = ld_f64(sb + 136)
    s18<Float> = ld_f64(sb + 144)
    s19<Float> = ld_f64(sb + 152)
    s20<Float> = ld_f64(sb + 160)
    s21<Float> = ld_f64(sb + 168)
    s22<Float> = ld_f64(sb + 176)
    s23<Float> = ld_f64(sb + 184)
    s24<Float> = ld_f64(sb + 192)
    s25<Float> = ld_f64(sb + 200)
    s26<Float> = ld_f64(sb + 208)
    s27<Float> = ld_f64(sb + 216)
    s28<Float> = ld_f64(sb + 224)
    s29<Float> = ld_f64(sb + 232)
    s30<Float> = ld_f64(sb + 240)
    s31<Float> = ld_f64(sb + 248)
    t<Int> = 0
    while (t < NT) {
        st_shared_f64(tid, ld_f64(K + (t * GKS + hk * SSd + tid) * 8))
        st_shared_f64(128 + tid, ld_f64(Q + (t * GKS + hk * SSd + tid) * 8))
        kernel_barrier()
        acc<Float> = 0.0
        acq<Float> = 0.0
        kq<Float> = 0.0
        k0<Float> = ld_shared_f64(ib + 0)
        q0<Float> = ld_shared_f64(128 + ib + 0)
        acc = acc + s0 * k0
        acq = acq + s0 * q0
        kq = kq + k0 * q0
        k1<Float> = ld_shared_f64(ib + 1)
        q1<Float> = ld_shared_f64(128 + ib + 1)
        acc = acc + s1 * k1
        acq = acq + s1 * q1
        kq = kq + k1 * q1
