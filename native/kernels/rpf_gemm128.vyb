gemm_iq2s(p<Int>) -> {
    W<Int> = ld_i64(p + 0)
    X<Int> = ld_i64(p + 8)
    Y<Int> = ld_i64(p + 16)
    S<Int> = ld_i64(p + 24)
    N<Int> = ld_i64(p + 32)
    K<Int> = ld_i64(p + 40)
    LDY<Int> = ld_i64(p + 48)
    RS<Int> = ld_i64(p + 56)
    G<Int> = ld_i64(p + 64)
    NMT<Int> = ld_i64(p + 72)
    tid<Int> = tid_x()
    lane<Int> = tid % 32
    wp<Int> = tid / 32
    wm<Int> = wp / 4
    wn<Int> = wp % 4
    g<Int> = lane / 4
    t4<Int> = lane % 4
    bid<Int> = blk_x()
    m0<Int> = (bid % NMT) * 128
    n0<Int> = (bid / NMT) * 128
    ar<Int> = tid / 4
    akq<Int> = (tid % 4) * 16
    arow<Int> = m0 + ar
    nl<Int> = tid / 2
    hf<Int> = tid % 2
    nrow<Int> = n0 + nl
    rb<Int> = W + nrow * (K / 256) * 82
    aso<Int> = ar * 144 + akq * 2
    bso<Int> = 18432 + nl * 144 + hf * 64
    fa<Int> = (wm * 64 + g) * 144 + t4 * 4
    fb<Int> = 18432 + (wn * 32 + g) * 144 + t4 * 4
    if (tid + 0 < 512) {
        st_shared_v4_u32(36864 + (tid + 0) * 16, ld_v4_u32(G + (tid + 0) * 16, 0), ld_v4_u32(G + (tid + 0) * 16, 1), ld_v4_u32(G + (tid + 0) * 16, 2), ld_v4_u32(G + (tid + 0) * 16, 3))
    }
    if (tid + 256 < 512) {
        st_shared_v4_u32(36864 + (tid + 256) * 16, ld_v4_u32(G + (tid + 256) * 16, 0), ld_v4_u32(G + (tid + 256) * 16, 1), ld_v4_u32(G + (tid + 256) * 16, 2), ld_v4_u32(G + (tid + 256) * 16, 3))
    }
    kernel_barrier()
    c000<Float32> = 0.0
    c001<Float32> = 0.0
    c002<Float32> = 0.0
    c003<Float32> = 0.0
    c010<Float32> = 0.0
    c011<Float32> = 0.0
    c012<Float32> = 0.0
    c013<Float32> = 0.0
