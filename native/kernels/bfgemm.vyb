// bfgemm — split-K GEMM with BF16 WEIGHTS, f32 activations.
//
// Same structure as gemm32_p (layer.vyb): 4 output rows per thread, split-K over
// the reduction, f32 partials reduced by gemm32_r (layer.ptx, unchanged). The
// only difference is that the weight matrix is read as BF16 and converted with
// the language's own ld_bf16 -- no dequant pass, no f32 copy of the weights.
// This is the primitive the batched ATTENTION path was missing: GLM-5.3's
// attention is BF16 (o_proj alone is 134 MB), and the engine currently widens it
// to f32 with gemm32, doubling the traffic.
//
// TRANSP: the checkpoint stores attention weights as [N][K] (PyTorch [out][in]),
// while gemm32_p wants [K][N]. TRANSP=1 reads [N][K] directly (correct but
// uncoalesced across threads); production should transpose once at load.
//
// Params: +0 A (f32 [M][K] activations), +8 B (bf16 weights),
//         +16 SK (f32 [KSP][M][N] partials), +24 M, +32 N, +40 K, +56 KSP,
//         +64 TRANSP.
bfgemm_p(p<Int>) -> {
    A<Int> = ld_i64(p + 0)
    B<Int> = ld_i64(p + 8)
    SK<Int> = ld_i64(p + 16)
    M<Int> = ld_i64(p + 24)
    N<Int> = ld_i64(p + 32)
    K<Int> = ld_i64(p + 40)
    KSP<Int> = ld_i64(p + 56)
    TRANSP<Int> = ld_i64(p + 64)
    MB<Int> = (M + 3) / 4
    NBLK<Int> = (MB * N + 255) / 256
    bx<Int> = blk_x()
    ks<Int> = bx / NBLK
    nb<Int> = bx % NBLK
    gid<Int> = nb * dim_x() + tid_x()
    total<Int> = M * N
    if (gid < MB * N) {
        mb<Int> = gid / N
        nn<Int> = gid % N
        mm0<Int> = mb * 4
        kl<Int> = (K + KSP - 1) / KSP
        k0<Int> = ks * kl
        k1<Int> = k0 + kl
        if (k1 > K) { k1 = K }
        a0<Float32> = 0.0
        a1<Float32> = 0.0
        a2<Float32> = 0.0
        a3<Float32> = 0.0
        pa0<Int> = A + (mm0 * K + k0) * 4
        pa1<Int> = pa0 + K * 4
        pa2<Int> = pa0 + K * 8
        pa3<Int> = pa0 + K * 12
        pb<Int> = B + (k0 * N + nn) * 2
        pbx<Int> = N * 2
        if (TRANSP != 0) {
            pb = B + (nn * K + k0) * 2
            pbx = 2
        }
        kk<Int> = k0
        while (kk < k1) {
            # bind every load to a <Float32> local before the multiply, exactly as
            # gemm32_p does, so the MAC stays a native mul.rn.f32
            bv<Float32> = ld_bf16(pb) as Float32
            av0<Float32> = ld_f32(pa0)
            av1<Float32> = ld_f32(pa1)
            av2<Float32> = ld_f32(pa2)
            av3<Float32> = ld_f32(pa3)
            a0 = a0 + av0 * bv
            a1 = a1 + av1 * bv
            a2 = a2 + av2 * bv
            a3 = a3 + av3 * bv
            pa0 = pa0 + 4
            pa1 = pa1 + 4
            pa2 = pa2 + 4
            pa3 = pa3 + 4
            pb = pb + pbx
            kk = kk + 1
        }
        st_f32(SK + (ks * total + mm0 * N + nn) * 4, a0)
        if (mm0 + 1 < M) { st_f32(SK + (ks * total + (mm0 + 1) * N + nn) * 4, a1) }
        if (mm0 + 2 < M) { st_f32(SK + (ks * total + (mm0 + 2) * N + nn) * 4, a2) }
        if (mm0 + 3 < M) { st_f32(SK + (ks * total + (mm0 + 3) * N + nn) * 4, a3) }
    }
}

bfgemm_1s(p<Int>) -> {
    A<Int> = ld_i64(p + 0)
    B<Int> = ld_i64(p + 8)
    SK<Int> = ld_i64(p + 16)
    M<Int> = ld_i64(p + 24)
    N<Int> = ld_i64(p + 32)
    K<Int> = ld_i64(p + 40)
    KSP<Int> = ld_i64(p + 56)
    TRANSP<Int> = ld_i64(p + 64)
    MB<Int> = (M + 3) / 4
    NBLK<Int> = (MB * N + 255) / 256
    bx<Int> = blk_x()
    ks<Int> = bx / NBLK
    nb<Int> = bx % NBLK
    gid<Int> = nb * dim_x() + tid_x()
    total<Int> = M * N
    if (gid < MB * N) {
        mb<Int> = gid / N
        nn<Int> = gid % N
        mm0<Int> = mb * 4
        kl<Int> = (K + KSP - 1) / KSP
        k0<Int> = ks * kl
        k1<Int> = k0 + kl
        if (k1 > K) { k1 = K }
        a0<Float32> = 0.0
        a1<Float32> = 0.0
        a2<Float32> = 0.0
        a3<Float32> = 0.0
        pa0<Int> = A + (mm0 * K + k0) * 4
        pa1<Int> = pa0 + K * 4
        pa2<Int> = pa0 + K * 8
        pa3<Int> = pa0 + K * 12
        pb<Int> = B + (k0 * N + nn) * 2
        pbx<Int> = N * 2
        if (TRANSP != 0) {
            pb = B + (nn * K + k0) * 2
            pbx = 2
        }
        kk<Int> = k0
        while (kk < k1) {
            # bind every load to a <Float32> local before the multiply, exactly as
            # gemm32_p does, so the MAC stays a native mul.rn.f32
            bv<Float32> = ld_bf16(pb) as Float32
            av0<Float32> = ld_f32(pa0)
            av1<Float32> = ld_f32(pa1)
            av2<Float32> = ld_f32(pa2)
            av3<Float32> = ld_f32(pa3)
            a0 = a0 + av0 * bv
            a1 = a1 + av1 * bv
            a2 = a2 + av2 * bv
            a3 = a3 + av3 * bv
            pa0 = pa0 + 4
            pa1 = pa1 + 4
            pa2 = pa2 + 4
            pa3 = pa3 + 4
            pb = pb + pbx
            kk = kk + 1
        }
        # BISECT: one unguarded store only
        st_f32(SK + (mm0 * N + nn) * 4, a0)
    }
}

// widen32 — f32 -> f64, for reading an f32 kernel's output with bulk_dtoh
// (which copies n*8 bytes and reads f64). Probe-only helper.
// p: +0 src(f32), +8 dst(f64), +16 n
widen32(p<Int>) -> {
    S<Int> = ld_i64(p + 0)
    D<Int> = ld_i64(p + 8)
    N<Int> = ld_i64(p + 16)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < N) {
        v<Float> = ld_f32(S + gid * 4)
        st_f64(D + gid * 8, v)
    }
}

// b2d — bf16 (device) -> f64, so a probe can verify bf16 weights that were
// written with wr_pdev (no String involved). p: +0 src, +8 dst, +16 n
b2d(p<Int>) -> {
    S<Int> = ld_i64(p + 0)
    D<Int> = ld_i64(p + 8)
    N<Int> = ld_i64(p + 16)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < N) {
        v<Float> = ld_bf16(S + gid * 2)
        st_f64(D + gid * 8, v)
    }
}
