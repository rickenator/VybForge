            acq = acq + s4 * ld_shared_f64(256 + ib + 4)
            acc = acc + s5 * ld_shared_f64(ib + 5)
            acq = acq + s5 * ld_shared_f64(256 + ib + 5)
            acc = acc + s6 * ld_shared_f64(ib + 6)
            acq = acq + s6 * ld_shared_f64(256 + ib + 6)
            acc = acc + s7 * ld_shared_f64(ib + 7)
            acq = acq + s7 * ld_shared_f64(256 + ib + 7)
            ib = ib + 8
        }
        del<Float> = (ld_f64(V + (j + S * h) * 8) - gexp * acc) * be
        st_f64(OUT + (j + S * h) * 8, sc * (gexp * acq + del * kq))
        ww<Int> = SOUT + (S * S * h + j) * 4
        ib = 0
        while (ib < S) {
            a2<Int> = rw + ib * st
            b2<Int> = ww + ib * st
            r0<Float> = (ld_f32(a2 + 0 * st) as Float)
            r1<Float> = (ld_f32(a2 + 1 * st) as Float)
            r2<Float> = (ld_f32(a2 + 2 * st) as Float)
            r3<Float> = (ld_f32(a2 + 3 * st) as Float)
            r4<Float> = (ld_f32(a2 + 4 * st) as Float)
            r5<Float> = (ld_f32(a2 + 5 * st) as Float)
            r6<Float> = (ld_f32(a2 + 6 * st) as Float)
            r7<Float> = (ld_f32(a2 + 7 * st) as Float)
            st_f32(b2 + 0 * st, ((gexp * r0 + del * ld_shared_f64(ib + 0)) as Float32))
            st_f32(b2 + 1 * st, ((gexp * r1 + del * ld_shared_f64(ib + 1)) as Float32))
            st_f32(b2 + 2 * st, ((gexp * r2 + del * ld_shared_f64(ib + 2)) as Float32))
            st_f32(b2 + 3 * st, ((gexp * r3 + del * ld_shared_f64(ib + 3)) as Float32))
            st_f32(b2 + 4 * st, ((gexp * r4 + del * ld_shared_f64(ib + 4)) as Float32))
            st_f32(b2 + 5 * st, ((gexp * r5 + del * ld_shared_f64(ib + 5)) as Float32))
            st_f32(b2 + 6 * st, ((gexp * r6 + del * ld_shared_f64(ib + 6)) as Float32))
            st_f32(b2 + 7 * st, ((gexp * r7 + del * ld_shared_f64(ib + 7)) as Float32))
            ib = ib + 8
        }
    }
}

delta_step_w(p<Int>) -> {
    Q<Int> = ld_i64(p + 0)
    Kp<Int> = ld_i64(p + 8)
    V<Int> = ld_i64(p + 16)
    G<Int> = ld_i64(p + 24)
    BE<Int> = ld_i64(p + 32)
    SIN<Int> = ld_i64(p + 40)
    SOUT<Int> = ld_i64(p + 48)
    OUT<Int> = ld_i64(p + 56)
    S<Int> = ld_i64(p + 72)
    Hk<Int> = ld_i64(p + 80)
    sc<Float> = ld_f64(p + 96)
    nb<Int> = S / 32
    h<Int> = blk_x() / nb
    j<Int> = (blk_x() % nb) * 32 + tid_x()
    hk<Int> = h % Hk
    t0<Int> = tid_x()
    while (t0 < S) {
        st_shared_f64(t0, ld_f64(Kp + (t0 + S * hk) * 8))
        st_shared_f64(256 + t0, ld_f64(Q + (t0 + S * hk) * 8))
        t0 = t0 + 32
    }
    kernel_barrier()
    if (j < S) {
        gexp<Float> = vexp(ld_f64(G + h * 8))
        be<Float> = ld_f64(BE + h * 8)
        kq<Float> = 0.0
        i<Int> = 0
        for (i in 0..S - 1) { kq = kq + ld_shared_f64(i) * ld_shared_f64(256 + i) }
        rw<Int> = SIN + (S * S * h + j) * 8
        st<Int> = S * 8
        acc<Float> = 0.0
        acq<Float> = 0.0
        ib<Int> = 0
        while (ib < S) {
            a<Int> = rw + ib * st
            s0<Float> = ld_f64(a + 0 * st)
            st_shared_f64(512 + (ib + 0) * 32 + tid_x(), s0)
            s1<Float> = ld_f64(a + 1 * st)
            st_shared_f64(512 + (ib + 1) * 32 + tid_x(), s1)
            s2<Float> = ld_f64(a + 2 * st)
            st_shared_f64(512 + (ib + 2) * 32 + tid_x(), s2)
            s3<Float> = ld_f64(a + 3 * st)
            st_shared_f64(512 + (ib + 3) * 32 + tid_x(), s3)
            s4<Float> = ld_f64(a + 4 * st)
            st_shared_f64(512 + (ib + 4) * 32 + tid_x(), s4)
            s5<Float> = ld_f64(a + 5 * st)
            st_shared_f64(512 + (ib + 5) * 32 + tid_x(), s5)
            s6<Float> = ld_f64(a + 6 * st)
            st_shared_f64(512 + (ib + 6) * 32 + tid_x(), s6)
            s7<Float> = ld_f64(a + 7 * st)
            st_shared_f64(512 + (ib + 7) * 32 + tid_x(), s7)
            acc = acc + s0 * ld_shared_f64(ib + 0)
            acq = acq + s0 * ld_shared_f64(256 + ib + 0)
            acc = acc + s1 * ld_shared_f64(ib + 1)
            acq = acq + s1 * ld_shared_f64(256 + ib + 1)
            acc = acc + s2 * ld_shared_f64(ib + 2)
            acq = acq + s2 * ld_shared_f64(256 + ib + 2)
            acc = acc + s3 * ld_shared_f64(ib + 3)
            acq = acq + s3 * ld_shared_f64(256 + ib + 3)
            acc = acc + s4 * ld_shared_f64(ib + 4)
            acq = acq + s4 * ld_shared_f64(256 + ib + 4)
            acc = acc + s5 * ld_shared_f64(ib + 5)
            acq = acq + s5 * ld_shared_f64(256 + ib + 5)
            acc = acc + s6 * ld_shared_f64(ib + 6)
            acq = acq + s6 * ld_shared_f64(256 + ib + 6)
            acc = acc + s7 * ld_shared_f64(ib + 7)
            acq = acq + s7 * ld_shared_f64(256 + ib + 7)
            ib = ib + 8
        }
        del<Float> = (ld_f64(V + (j + S * h) * 8) - gexp * acc) * be
        st_f64(OUT + (j + S * h) * 8, sc * (gexp * acq + del * kq))
        ww<Int> = SOUT + (S * S * h + j) * 8
        ib = 0
        while (ib < S) {
            a2<Int> = rw + ib * st
            b2<Int> = ww + ib * st
            r0<Float> = ld_shared_f64(512 + (ib + 0) * 32 + tid_x())
            r1<Float> = ld_shared_f64(512 + (ib + 1) * 32 + tid_x())
            r2<Float> = ld_shared_f64(512 + (ib + 2) * 32 + tid_x())
            r3<Float> = ld_shared_f64(512 + (ib + 3) * 32 + tid_x())
            r4<Float> = ld_shared_f64(512 + (ib + 4) * 32 + tid_x())
            r5<Float> = ld_shared_f64(512 + (ib + 5) * 32 + tid_x())
            r6<Float> = ld_shared_f64(512 + (ib + 6) * 32 + tid_x())
            r7<Float> = ld_shared_f64(512 + (ib + 7) * 32 + tid_x())
            st_f64(b2 + 0 * st, gexp * r0 + del * ld_shared_f64(ib + 0))
            st_f64(b2 + 1 * st, gexp * r1 + del * ld_shared_f64(ib + 1))
            st_f64(b2 + 2 * st, gexp * r2 + del * ld_shared_f64(ib + 2))
            st_f64(b2 + 3 * st, gexp * r3 + del * ld_shared_f64(ib + 3))
            st_f64(b2 + 4 * st, gexp * r4 + del * ld_shared_f64(ib + 4))
            st_f64(b2 + 5 * st, gexp * r5 + del * ld_shared_f64(ib + 5))
            st_f64(b2 + 6 * st, gexp * r6 + del * ld_shared_f64(ib + 6))
            st_f64(b2 + 7 * st, gexp * r7 + del * ld_shared_f64(ib + 7))
            ib = ib + 8
        }
    }
}

delta_step_w32(p<Int>) -> {
    Q<Int> = ld_i64(p + 0)
    Kp<Int> = ld_i64(p + 8)
    V<Int> = ld_i64(p + 16)
    G<Int> = ld_i64(p + 24)
    BE<Int> = ld_i64(p + 32)
    SIN<Int> = ld_i64(p + 40)
    SOUT<Int> = ld_i64(p + 48)
    OUT<Int> = ld_i64(p + 56)
    S<Int> = ld_i64(p + 72)
    Hk<Int> = ld_i64(p + 80)
    sc<Float> = ld_f64(p + 96)
    nb<Int> = S / 32
    h<Int> = blk_x() / nb
    j<Int> = (blk_x() % nb) * 32 + tid_x()
    hk<Int> = h % Hk
    t0<Int> = tid_x()
    while (t0 < S) {
        st_shared_f64(t0, ld_f64(Kp + (t0 + S * hk) * 8))
        st_shared_f64(256 + t0, ld_f64(Q + (t0 + S * hk) * 8))
        t0 = t0 + 32
    }
    kernel_barrier()
    if (j < S) {
        gexp<Float> = vexp(ld_f64(G + h * 8))
        be<Float> = ld_f64(BE + h * 8)
        kq<Float> = 0.0
        i<Int> = 0
        for (i in 0..S - 1) { kq = kq + ld_shared_f64(i) * ld_shared_f64(256 + i) }
        rw<Int> = SIN + (S * S * h + j) * 4
        st<Int> = S * 4
        acc<Float> = 0.0
        acq<Float> = 0.0
        ib<Int> = 0
        while (ib < S) {
            a<Int> = rw + ib * st
            s0<Float> = (ld_f32(a + 0 * st) as Float)
            st_shared_f64(512 + (ib + 0) * 32 + tid_x(), s0)
            s1<Float> = (ld_f32(a + 1 * st) as Float)
            st_shared_f64(512 + (ib + 1) * 32 + tid_x(), s1)
            s2<Float> = (ld_f32(a + 2 * st) as Float)
            st_shared_f64(512 + (ib + 2) * 32 + tid_x(), s2)
            s3<Float> = (ld_f32(a + 3 * st) as Float)
            st_shared_f64(512 + (ib + 3) * 32 + tid_x(), s3)
            s4<Float> = (ld_f32(a + 4 * st) as Float)
            st_shared_f64(512 + (ib + 4) * 32 + tid_x(), s4)
            s5<Float> = (ld_f32(a + 5 * st) as Float)
            st_shared_f64(512 + (ib + 5) * 32 + tid_x(), s5)
            s6<Float> = (ld_f32(a + 6 * st) as Float)
            st_shared_f64(512 + (ib + 6) * 32 + tid_x(), s6)
            s7<Float> = (ld_f32(a + 7 * st) as Float)
            st_shared_f64(512 + (ib + 7) * 32 + tid_x(), s7)
            acc = acc + s0 * ld_shared_f64(ib + 0)
            acq = acq + s0 * ld_shared_f64(256 + ib + 0)
            acc = acc + s1 * ld_shared_f64(ib + 1)
            acq = acq + s1 * ld_shared_f64(256 + ib + 1)
            acc = acc + s2 * ld_shared_f64(ib + 2)
            acq = acq + s2 * ld_shared_f64(256 + ib + 2)
            acc = acc + s3 * ld_shared_f64(ib + 3)
            acq = acq + s3 * ld_shared_f64(256 + ib + 3)
            acc = acc + s4 * ld_shared_f64(ib + 4)
            acq = acq + s4 * ld_shared_f64(256 + ib + 4)
            acc = acc + s5 * ld_shared_f64(ib + 5)
            acq = acq + s5 * ld_shared_f64(256 + ib + 5)
            acc = acc + s6 * ld_shared_f64(ib + 6)
            acq = acq + s6 * ld_shared_f64(256 + ib + 6)
            acc = acc + s7 * ld_shared_f64(ib + 7)
            acq = acq + s7 * ld_shared_f64(256 + ib + 7)
            ib = ib + 8
        }
        del<Float> = (ld_f64(V + (j + S * h) * 8) - gexp * acc) * be
        st_f64(OUT + (j + S * h) * 8, sc * (gexp * acq + del * kq))
        ww<Int> = SOUT + (S * S * h + j) * 4
        ib = 0
        while (ib < S) {
            a2<Int> = rw + ib * st
            b2<Int> = ww + ib * st
            r0<Float> = ld_shared_f64(512 + (ib + 0) * 32 + tid_x())
            r1<Float> = ld_shared_f64(512 + (ib + 1) * 32 + tid_x())
            r2<Float> = ld_shared_f64(512 + (ib + 2) * 32 + tid_x())
            r3<Float> = ld_shared_f64(512 + (ib + 3) * 32 + tid_x())
            r4<Float> = ld_shared_f64(512 + (ib + 4) * 32 + tid_x())
            r5<Float> = ld_shared_f64(512 + (ib + 5) * 32 + tid_x())
            r6<Float> = ld_shared_f64(512 + (ib + 6) * 32 + tid_x())
            r7<Float> = ld_shared_f64(512 + (ib + 7) * 32 + tid_x())
            st_f32(b2 + 0 * st, ((gexp * r0 + del * ld_shared_f64(ib + 0)) as Float32))
            st_f32(b2 + 1 * st, ((gexp * r1 + del * ld_shared_f64(ib + 1)) as Float32))
            st_f32(b2 + 2 * st, ((gexp * r2 + del * ld_shared_f64(ib + 2)) as Float32))
            st_f32(b2 + 3 * st, ((gexp * r3 + del * ld_shared_f64(ib + 3)) as Float32))
            st_f32(b2 + 4 * st, ((gexp * r4 + del * ld_shared_f64(ib + 4)) as Float32))
            st_f32(b2 + 5 * st, ((gexp * r5 + del * ld_shared_f64(ib + 5)) as Float32))
            st_f32(b2 + 6 * st, ((gexp * r6 + del * ld_shared_f64(ib + 6)) as Float32))
            st_f32(b2 + 7 * st, ((gexp * r7 + del * ld_shared_f64(ib + 7)) as Float32))
            ib = ib + 8
        }
    }
}
