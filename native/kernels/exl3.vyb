// EXL3 4bpw dequant kernel — the routed experts of GLM-5.3-Flash (the only EXL3
// tensors in the checkpoint: quantization_config.scope = glm53_routed_experts_only,
// bits=4, codebook mcg). Emits the ROTATED-basis tile values What; the per-128-block
// Hadamard + suh/svh scales are a separate generic stage (see native/exl3/README.md).
//
// Format per weight matrix [in, out] (all pinned against the exllamav3 oracle,
// native/exl3/README.md):
//   trellis  i16 [in/16, out/16, 64]   64 u16 = 1024 bits = 256 nibbles / 16x16 tile
//   one 16-bit window per output value: window j covers nibbles j..j+3 of the
//   tile's nibble stream (LSB-first in each u16), BUT the placement of window
//   value -> tile (row, col) is a fixed pipeline quirk, not a clean formula —
//   it is pinned empirically and passed in as the `tab` map (one 16-byte entry
//   per slot: 4x u16 nibble index, 4x u8 bit position, u16 row, u16 col).
//   Map header: [0..7] cw (i64, out columns), [8..15] ntiles (i64).
// Value decode (codebook.cuh decode_3inst, cb=1 "mcg"), bit-exact vs oracle:
//   prod = (w16 * 0xCBAC1FED) mod 2^32
//   y    = (prod & 0x8fff8fff) ^ 0x3b603b60
//   val  = f16(y & 0xffff) + f16(y >> 16)
// The fp16 halves are converted arithmetically (sign/exp/mantissa, subnormals
// included) — an earlier st_i64+ld_f16 bitcast through a scratch buffer read
// stale/reordered memory under -O2 and is not trustworthy for load-after-store.
//
// Thread = one (tile, slot) output value (f64 store, q4kdeq convention; the
// DtoH gate reads exact f64).
// Per-128-block Hadamard + scale stages — the halves of reconstruction that follow
// exl3deq:  W = diag(suh) . (H/8) What (H/8) . diag(svh), H = natural-order
// Sylvester Hadamard-128, 1/8 = 1/sqrt(128). Stages:
//   exl3hgen  builds H/8 on the device (sign = parity of popcount(i & j))
//   exl3had1  tmp[b,d] = sum_c What[b,c] * Hs[c,d]      (column transform)
//   exl3had2  out[a,d] = suh[row]*svh[col]* sum_b Hs[a,b] * tmp[b,d]  (row + scales)
// Params are passed in a p-buffer (qwen3rope idiom): all entries are i64.
// Thread mapping is one output element per thread; no shared memory, so the
// transform is a plain 128-tap loop per element (2 x 128 f64 ops per output).

// p: +0 H, and the scale constant is baked in.
exl3hgen(p<Int>) -> {
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < 16384) {
        i<Int> = gid / 128
        j<Int> = gid - i * 128
        t<Int> = i & j
        acc<Int> = 0
        k<Int> = 0
        while (k < 7) {
            acc = acc + ((t >> k) & 1)
            k = k + 1
        }
        v<Float> = 0.08838834764831845
        if ((acc % 2) == 1) {
            v = 0.0 - v
        }
        H<Int> = ld_i64(p + 0)
        st_f64(H + gid * 8, v)
    }
}

// p: +0 what, +8 tmp, +16 H, +24 cw, +32 nbc, +40 nblocks
exl3had1(p<Int>) -> {
    W<Int> = ld_i64(p + 0)
    T<Int> = ld_i64(p + 8)
    H<Int> = ld_i64(p + 16)
    cw<Int> = ld_i64(p + 24)
    nbc<Int> = ld_i64(p + 32)
    nblocks<Int> = ld_i64(p + 40)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < nblocks * 16384) {
        # block = 128x128 tile index; nbc (blocks per row) MUST be n/128, not the
        # n/16 subtile count — the wrong constant gave every block a bogus (kb, nb)
        # and collapsed the output onto the first column blocks.
        block<Int> = gid / 16384
        b<Int> = (gid % 16384) / 128
        d<Int> = gid % 128
        kbv<Int> = block / nbc
        nbv<Int> = block - kbv * nbc
        row<Int> = kbv * 128 + b
        colbase<Int> = nbv * 128
        acc<Float> = 0.0
        c<Int> = 0
        while (c < 128) {
            acc = acc + ld_f64(W + (row * cw + colbase + c) * 8) * ld_f64(H + (c * 128 + d) * 8)
            c = c + 1
        }
        st_f64(T + (block * 16384 + b * 128 + d) * 8, acc)
    }
}

// p: +0 tmp, +8 out, +16 H, +24 suh, +32 svh, +40 cw, +48 nbc, +56 nblocks
exl3had2(p<Int>) -> {
    T<Int> = ld_i64(p + 0)
    O<Int> = ld_i64(p + 8)
    H<Int> = ld_i64(p + 16)
    SU<Int> = ld_i64(p + 24)
    SV<Int> = ld_i64(p + 32)
    cw<Int> = ld_i64(p + 40)
    nbc<Int> = ld_i64(p + 48)
    nblocks<Int> = ld_i64(p + 56)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < nblocks * 16384) {
        # see exl3had1: nbc must be the 128-wide block count (n/128)
        block<Int> = gid / 16384
        a<Int> = (gid % 16384) / 128
        d<Int> = gid % 128
        acc<Float> = 0.0
        b<Int> = 0
        while (b < 128) {
            acc = acc + ld_f64(H + (a * 128 + b) * 8) * ld_f64(T + (block * 16384 + b * 128 + d) * 8)
            b = b + 1
        }
        kbv<Int> = block / nbc
        nbv<Int> = block - kbv * nbc
        row<Int> = kbv * 128 + a
        col<Int> = nbv * 128 + d
        su<Float> = ld_f16(SU + row * 2)
        sv<Float> = ld_f16(SV + col * 2)
        st_f64(O + (row * cw + col) * 8, acc * su * sv)
    }
}

// ---- f32 variants (option: f64 is 1/64-rate on GA102; the transform is the
// remaining MoE-deq cost). Same geometry/params as the f64 kernels, all
// buffers f32 (4-byte elements). Tolerance vs numpy re-baselines separately —
// these are NOT drop-in bit-compatible with the f64 path.
// p: +0 H  (f32, 16384 elements = 64 KB)
exl3hgen32(p<Int>) -> {
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < 16384) {
        i<Int> = gid / 128
        j<Int> = gid - i * 128
        t<Int> = i & j
        acc<Int> = 0
        k<Int> = 0
        while (k < 7) {
            acc = acc + ((t >> k) & 1)
            k = k + 1
        }
        v<Float32> = 0.08838834764831845 as Float32
        if ((acc % 2) == 1) {
            neg<Float32> = 0.0 - 1.0 as Float32
            v = neg * v
        }
        H<Int> = ld_i64(p + 0)
        st_f32(H + gid * 4, v)
    }
}

// p: +0 what(f32), +8 tmp(f32), +16 H(f32), +24 cw, +32 nbc, +40 nblocks
exl3had132(p<Int>) -> {
    W<Int> = ld_i64(p + 0)
    T<Int> = ld_i64(p + 8)
    H<Int> = ld_i64(p + 16)
    cw<Int> = ld_i64(p + 24)
    nbc<Int> = ld_i64(p + 32)
    nblocks<Int> = ld_i64(p + 40)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < nblocks * 16384) {
        block<Int> = gid / 16384
        b<Int> = (gid % 16384) / 128
        d<Int> = gid % 128
        kbv<Int> = block / nbc
        nbv<Int> = block - kbv * nbc
        row<Int> = kbv * 128 + b
        colbase<Int> = nbv * 128
        acc<Float32> = 0.0
        c<Int> = 0
        while (c < 128) {
            acc = acc + ld_f32n(W + (row * cw + colbase + c) * 4) * ld_f32n(H + (c * 128 + d) * 4)
            c = c + 1
        }
        st_f32(T + (block * 16384 + b * 128 + d) * 4, acc)
    }
}

// p: +0 tmp(f32), +8 out(f32), +16 H(f32), +24 suh, +32 svh, +40 cw, +48 nbc, +56 nblocks
exl3had232(p<Int>) -> {
    T<Int> = ld_i64(p + 0)
    O<Int> = ld_i64(p + 8)
    H<Int> = ld_i64(p + 16)
    SU<Int> = ld_i64(p + 24)
    SV<Int> = ld_i64(p + 32)
    cw<Int> = ld_i64(p + 40)
    nbc<Int> = ld_i64(p + 48)
    nblocks<Int> = ld_i64(p + 56)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < nblocks * 16384) {
        block<Int> = gid / 16384
        a<Int> = (gid % 16384) / 128
        d<Int> = gid % 128
        acc<Float32> = 0.0
        b<Int> = 0
        while (b < 128) {
            acc = acc + ld_f32n(H + (a * 128 + b) * 4) * ld_f32n(T + (block * 16384 + b * 128 + d) * 4)
            b = b + 1
        }
        kbv<Int> = block / nbc
        nbv<Int> = block - kbv * nbc
        row<Int> = kbv * 128 + a
        col<Int> = nbv * 128 + d
        su<Float32> = ld_f16(SU + row * 2) as Float32
        sv<Float32> = ld_f16(SV + col * 2) as Float32
        st_f32(O + (row * cw + col) * 4, acc * su * sv)
    }
}

// f32-output deq: identical decode math (mcg + fp16 pair, f64 intermediate),
// the result is narrowed to f32 on store. Buffer is kn*4 bytes. Paired with
// had132/had232 so the transform runs at f32 rate (see exl3had132 note).
exl3deq32(q<Int>, tab<Int>, o<Int>) -> {
    gid<Int> = blk_x() * dim_x() + tid_x()
    ntiles<Int> = ld_i64(tab + 8)
    total<Int> = ntiles * 256
    if (gid < total) {
        tile<Int> = gid / 256
        slot<Int> = gid - tile * 256
        base<Int> = tab + 16 + slot * 16
        w16<Int> = 0
        i<Int> = 0
        while (i < 4) {
            nidx<Int> = ld_u16(base + i * 2) as Int
            p<Int> = (ld_i8(base + 8 + i) as Int) & 255
            wb<Int> = q + tile * 128 + (nidx / 4) * 2 + (nidx % 4) / 2
            by<Int> = (ld_i8(wb) as Int) & 255
            sh<Int> = ((nidx % 4) % 2) * 4
            nib<Int> = (by >> sh) & 15
            w16 = w16 | (nib << (p * 4))
            i = i + 1
        }
        prod<Int> = (w16 * 3417055213) & 4294967295
        y<Int> = (prod & 2415890431) ^ 996162400
        lo<Float> = fp16_to_f64(y & 65535)
        hi<Float> = fp16_to_f64((y >> 16) & 65535)
        val<Float> = lo + hi
        cw<Int> = ld_i64(tab + 0)
        nbc<Int> = cw / 16
        r<Int> = ld_u16(base + 12) as Int
        c<Int> = ld_u16(base + 14) as Int
        kbv<Int> = tile / nbc
        nbv<Int> = tile - kbv * nbc
        row<Int> = kbv * 16 + r
        col<Int> = nbv * 16 + c
        st_f32(o + (row * cw + col) * 4, val as Float32)
    }
}

// f32->f64 widen: one thread per element. Lets the f32 transform result flow into
// the unchanged f64 host readback (bulk_dtoh) and downstream mm/digest contract.
// p: +0 src(f32), +8 dst(f64), +16 n(elements)
exl3cvt32(p<Int>) -> {
    gid<Int> = blk_x() * dim_x() + tid_x()
    n<Int> = ld_i64(p + 16)
    if (gid < n) {
        S<Int> = ld_i64(p + 0)
        D<Int> = ld_i64(p + 8)
        st_f64(D + gid * 8, ld_f32n(S + gid * 4) as Float)
    }
}

// fp16 bit pattern -> f64 by pure arithmetic (no libm, no memory round-trip).
// Normal: (1024+mant) * 2^(exp-25) by doubling/halving loops (<= 24 steps).
// Subnormal: mant * 2^-24 by 24 halvings. exp==31 (inf/nan) never occurs on the
// verified fixture — the numpy reference has no non-finite values — and is
// clamped to the fp16 max as a stand-in so a surprise shows up as a finite
// mismatch in the gate rather than poisoning the whole tile.
share(all) fp16_to_f64(b<Int>)<Float> -> {
    sb<Int> = (b >> 15) & 1
    eb<Int> = (b >> 10) & 31
    mb<Int> = b & 1023
    v<Float> = 0.0
    if (eb == 0) {
        v = mb as Float
        k<Int> = 0
        while (k < 24) {
            v = v * 0.5
            k = k + 1
        }
    } else {
        if (eb == 31) {
            v = 65504.0
        } else {
            v = (1024 + mb) as Float
            sh<Int> = eb - 25
            while (sh > 0) {
                v = v * 2.0
                sh = sh - 1
            }
            while (sh < 0) {
                v = v * 0.5
                sh = sh + 1
            }
        }
    }
    if (sb == 1) {
        v = 0.0 - v
    }
    return v
}

exl3deq(q<Int>, tab<Int>, o<Int>) -> {
    gid<Int> = blk_x() * dim_x() + tid_x()
    ntiles<Int> = ld_i64(tab + 8)
    total<Int> = ntiles * 256
    if (gid < total) {
        tile<Int> = gid / 256
        slot<Int> = gid - tile * 256
        base<Int> = tab + 16 + slot * 16
        # compose this slot's 16-bit window from its 4 (nibble, bitpos) pairs
        w16<Int> = 0
        i<Int> = 0
        while (i < 4) {
            nidx<Int> = ld_u16(base + i * 2) as Int
            p<Int> = (ld_i8(base + 8 + i) as Int) & 255
            # nibble nidx of this tile: u16 word nidx/4, nib-in-word nidx%4 ->
            # byte (nidx/4)*2 + (nidx%4)/2, low/high nibble by (nidx%4)%2
            wb<Int> = q + tile * 128 + (nidx / 4) * 2 + (nidx % 4) / 2
            by<Int> = (ld_i8(wb) as Int) & 255
            sh<Int> = ((nidx % 4) % 2) * 4
            nib<Int> = (by >> sh) & 15
            w16 = w16 | (nib << (p * 4))
            i = i + 1
        }
        # mcg decode; constants are the DECIMAL forms of 0xCBAC1FED / 0x8FFF8FFF /
        # 0x3B603B60 (computed, not eyeballed — a hand conversion here silently
        # decodes every window wrong). All positive so Int (64-bit) arithmetic
        # never goes negative: w16 <= 65535, product <= 2.24e14 < 2^63, mask = mod 2^32
        prod<Int> = (w16 * 3417055213) & 4294967295
        y<Int> = (prod & 2415890431) ^ 996162400
        # fp16 halves -> f64 arithmetically (sign/exp/mantissa, subnormals by
        # halving; exp==31 cannot occur on the verified fixture — reference has
        # no inf/nan — and is clamped to a huge finite so the gate stays honest)
        lo<Float> = fp16_to_f64(y & 65535)
        hi<Float> = fp16_to_f64((y >> 16) & 65535)
        val<Float> = lo + hi
        # place: tile (kb, nb) covers rows 16kb+r, cols 16*nb+c; nbc = cw/16
        cw<Int> = ld_i64(tab + 0)
        nbc<Int> = cw / 16
        r<Int> = ld_u16(base + 12) as Int
        c<Int> = ld_u16(base + 14) as Int
        kbv<Int> = tile / nbc
        nbv<Int> = tile - kbv * nbc
        row<Int> = kbv * 16 + r
        col<Int> = nbv * 16 + c
        vv<Float> = val as Float
        st_f64(o + (row * cw + col) * 8, vv)
    }
}
