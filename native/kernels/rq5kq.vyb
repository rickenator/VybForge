// Ridge Q5_K decode GEMV on q8_1 activations with dp4a (default on CC 8 like Q4Q8; VYB_Q5Q8=0 or
// VYB_EXACT=1 off; not bit-exact -> KLD-checked). Same row/lane layout as gemv_q4k_q (rq4kq.vyb): 16 warps
// x 1 row, lane l owns the 4 qs bytes at 48 + 4l of each 176-byte super-block (low nibbles -> sub-block 2t,
// high nibbles -> 2t+1, t = l / 8) and the qh bytes at 16 + 4(l%8) (bit 2t / 2t+1 = the 5th bit).
// q5 values are 0..31, so dp4a_s32 on them is exact. X is the xq8 layout: K int8 then K/32 f32 scales.
// Q5_K layout from ggml-quants.c (MIT, see THIRD-PARTY.md).

gemv_q5k_q(p<Int>) -> {
    W<Int> = ld_i64(p + 0)
    X<Int> = ld_i64(p + 8)
    Y<Int> = ld_i64(p + 16)
    N<Int> = ld_i64(p + 32)
    K<Int> = ld_i64(p + 40)
    YE<Int> = ld_i64(p + 48)
    RS<Int> = ld_i64(p + 120)
    tid<Int> = tid_x()
    l<Int> = tid % 32
    n0<Int> = blk_x() * 16 + tid / 32
    nsb<Int> = K / 256
    t<Int> = l / 8
    l4<Int> = l * 4
    sh<UInt32> = ((t % 2) * 16) as UInt32
    mk<UInt32> = (0 as UInt32) - ((t / 2) as UInt32)
    nmk<UInt32> = (0 as UInt32) - ((1 - t / 2) as UInt32)
    hsl<UInt32> = (2 * t) as UInt32
    hsh<UInt32> = (2 * t + 1) as UInt32
    one4<UInt32> = 16843009 as UInt32
    m4<UInt32> = 252645135 as UInt32
    acc0<Float32> = 0.0
    if (n0 < N) {
        xq<Int> = X + t * 64 + (l % 8) * 4
        xs<Int> = X + K + (2 * t) * 4
        rb0<Int> = W + n0 * nsb * 176
        sb<Int> = 0
        while (sb < nsb) {
            bb<Int> = rb0 + sb * 176
            df0<Float32> = ld_f16(bb)
            mnf0<Float32> = ld_f16(bb + 2)
            ba0<UInt32> = ld_u32(bb + 4)
            bc0<UInt32> = ld_u32(bb + 8)
            be0<UInt32> = ld_u32(bb + 12)
            qh0<UInt32> = ld_u32(bb + 16 + (l % 8) * 4)
            qw0<UInt32> = ld_u32(bb + 48 + l4)
            xl<UInt32> = ldg_u32(xq + sb * 256)
            xh<UInt32> = ldg_u32(xq + sb * 256 + 32)
            dxl<Float32> = ld_f32(xs + sb * 32)
            dxh<Float32> = ld_f32(xs + sb * 32 + 4)
            b00<UInt32> = ba0 >> sh
            b10<UInt32> = bc0 >> sh
            b20<UInt32> = be0 >> sh
            sc00<UInt32> = ((b00 & 63) & nmk) | (((b20 & 15) | (((b00 >> 6) & 3) << 4)) & mk)
            m00<UInt32> = ((b10 & 63) & nmk) | ((((b20 >> 4) & 15) | (((b10 >> 6) & 3) << 4)) & mk)
            sc10<UInt32> = (((b00 >> 8) & 63) & nmk) | ((((b20 >> 8) & 15) | (((b00 >> 14) & 3) << 4)) & mk)
            m10<UInt32> = (((b10 >> 8) & 63) & nmk) | ((((b20 >> 12) & 15) | (((b10 >> 14) & 3) << 4)) & mk)
            ql<UInt32> = (qw0 & m4) | (((qh0 >> hsl) & one4) << 4)
            qhh<UInt32> = ((qw0 >> 4) & m4) | (((qh0 >> hsh) & one4) << 4)
            dl<CInt> = dp4a_s32(ql, xl, 0)
            dh<CInt> = dp4a_s32(qhh, xh, 0)
            sl<CInt> = dp4a_s32(one4, xl, 0)
            shh<CInt> = dp4a_s32(one4, xh, 0)
            acc0 = acc0 + dxl * (df0 * (sc00 as Float32) * (dl as Float32) - mnf0 * (m00 as Float32) * (sl as Float32))
            acc0 = acc0 + dxh * (df0 * (sc10 as Float32) * (dh as Float32) - mnf0 * (m10 as Float32) * (shh as Float32))
            sb = sb + 1
        }
        s0<Float> = acc0 as Float
        s0 = s0 + shfl_down_f64(s0, 16)
        s0 = s0 + shfl_down_f64(s0, 8)
        s0 = s0 + shfl_down_f64(s0, 4)
        s0 = s0 + shfl_down_f64(s0, 2)
        s0 = s0 + shfl_down_f64(s0, 1)
        if (l == 0) {
            if (YE == 4) { st_f32(Y + n0 * 4, s0 as Float32) } else {
                if (RS != 0) { s0 = ld_f64(RS + n0 * 8) + s0 }
                st_f64(Y + n0 * 8, s0)
            }
        }
    }
}
