// R = 1 originals (16 warps, 1 row per warp, one convert per value): faster than the R = 2 pair on GB10
// (sm_12x), so the driver keeps them there (VYB_GEMVR=1|2 overrides).
gemv_q4k_r1(p<Int>) -> {
    W<Int> = ld_i64(p + 0)
    X<Int> = ld_i64(p + 8)
    Y<Int> = ld_i64(p + 16)
    M<Int> = ld_i64(p + 24)
    N<Int> = ld_i64(p + 32)
    K<Int> = ld_i64(p + 40)
    YE<Int> = ld_i64(p + 48)
    tid<Int> = tid_x()
    l<Int> = tid % 32
    n<Int> = blk_x() * 16 + tid / 32
    nsb<Int> = K / 256
    t<Int> = l / 8
    l4<Int> = l * 4
    sh<UInt32> = ((t % 2) * 16) as UInt32
    mk<UInt32> = (0 as UInt32) - ((t / 2) as UInt32)
    nmk<UInt32> = (0 as UInt32) - ((1 - t / 2) as UInt32)
    st2<Int> = 16
    mm<Int> = 0
    for (mm in 0..M - 1) {
        acc<Float32> = 0.0
        if (n < N) {
            rb<Int> = W + n * nsb * 144
            xr<Int> = X + (mm * K + (l / 8) * 64 + (l % 8) * 4) * 4
            sb<Int> = 0
            while (sb < nsb) {
                bb0<Int> = rb + (sb + 0) * 144
                xb0<Int> = xr + (sb + 0) * 1024
                df0<Float32> = ld_f16(bb0)
                mnf0<Float32> = ld_f16(bb0 + 2)
                # get_scale_min_k4, branchless (see header): 3 aligned scale words, shifted to the lane's pair
                b00<UInt32> = (ld_i32(bb0 + 4) as UInt32) >> sh
                b10<UInt32> = (ld_i32(bb0 + 8) as UInt32) >> sh
                b20<UInt32> = (ld_i32(bb0 + 12) as UInt32) >> sh
                sc00<UInt32> = ((b00 & 63) & nmk) | (((b20 & 15) | (((b00 >> 6) & 3) << 4)) & mk)
                m00<UInt32> = ((b10 & 63) & nmk) | ((((b20 >> 4) & 15) | (((b10 >> 6) & 3) << 4)) & mk)
                sc10<UInt32> = (((b00 >> 8) & 63) & nmk) | ((((b20 >> 8) & 15) | (((b00 >> 14) & 3) << 4)) & mk)
                m10<UInt32> = (((b10 >> 8) & 63) & nmk) | ((((b20 >> 12) & 15) | (((b10 >> 14) & 3) << 4)) & mk)
                ds00<Float32> = df0 * (sc00 as Float32)
                dm00<Float32> = mnf0 * (m00 as Float32)
                ds10<Float32> = df0 * (sc10 as Float32)
                dm10<Float32> = mnf0 * (m10 as Float32)
                qw0<UInt32> = ld_i32(bb0 + 16 + l4) as UInt32
                xv10<Float32> = ld_f32(xb0)
                acc = acc + xv10 * (ds00 * ((qw0 & 15) as Float32) - dm00)
                xv20<Float32> = ld_f32(xb0 + 4)
                acc = acc + xv20 * (ds00 * (((qw0 >> 8) & 15) as Float32) - dm00)
                xv30<Float32> = ld_f32(xb0 + 8)
                acc = acc + xv30 * (ds00 * (((qw0 >> 16) & 15) as Float32) - dm00)
                xv40<Float32> = ld_f32(xb0 + 12)
                acc = acc + xv40 * (ds00 * (((qw0 >> 24) & 15) as Float32) - dm00)
                xv50<Float32> = ld_f32(xb0 + 128)
                acc = acc + xv50 * (ds10 * (((qw0 >> 4) & 15) as Float32) - dm10)
                xv60<Float32> = ld_f32(xb0 + 132)
                acc = acc + xv60 * (ds10 * (((qw0 >> 12) & 15) as Float32) - dm10)
                xv70<Float32> = ld_f32(xb0 + 136)
                acc = acc + xv70 * (ds10 * (((qw0 >> 20) & 15) as Float32) - dm10)
                xv80<Float32> = ld_f32(xb0 + 140)
                acc = acc + xv80 * (ds10 * (((qw0 >> 28) & 15) as Float32) - dm10)
                sb = sb + 1
            }
        }
        st_shared_f64(tid, acc as Float)
        kernel_barrier()
        st2 = 16
        while (st2 > 0) {
            if (l < st2) { st_shared_f64(tid, ld_shared_f64(tid) + ld_shared_f64(tid + st2)) }
            kernel_barrier()
            st2 = st2 / 2
        }
        if (l == 0) {
            if (n < N) {
                if (YE == 4) { st_f32(Y + (mm * N + n) * 4, ld_shared_f64(tid) as Float32) } else { st_f64(Y + (mm * N + n) * 8, ld_shared_f64(tid)) }
            }
        }
        kernel_barrier()
    }
}
