                q4e00<Int32> = ((((qlb0 >> 4) & 15) | ((((qhw0 >> 6) & 3)) << 4)) as Int32) - (32 as Int32)
                xv4e00<Float32> = ld_f32(xq0 + 384)
                acc = acc + xv4e00 * (dd0 * (q4e00 as Float32))
                q1e10<Int32> = ((((qla0 >> 8) & 15) | ((((qhw0 >> 8) & 3)) << 4)) as Int32) - (32 as Int32)
                xv1e10<Float32> = ld_f32(xq0 + 4)
                acc = acc + xv1e10 * (da0 * (q1e10 as Float32))
                q2e10<Int32> = ((((qlb0 >> 8) & 15) | ((((qhw0 >> 10) & 3)) << 4)) as Int32) - (32 as Int32)
                xv2e10<Float32> = ld_f32(xq0 + 132)
                acc = acc + xv2e10 * (db0 * (q2e10 as Float32))
