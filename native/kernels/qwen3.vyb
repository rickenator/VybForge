        st2 = 16
        while (st2 > 0) {
            if (l < st2) { st_shared_f64(tid, ld_shared_f64(tid) + ld_shared_f64(tid + st2)) }
            kernel_barrier()
            st2 = st2 / 2
        }
        if (l == 0) {
            if (n < N) {
                if (YE == 4) { st_f32(Y + (mm * N + n) * 4, ld_shared_f64(tid) as Float32) } else { st_f64(Y + (mm * N + n) * 8, ld_shared_f64(tid)) }
            }
        }
        kernel_barrier()
    }
}

// Prefill twins (S > 1) of gemv_q4k / gemv_q6k: each decoded weight is applied to 8 activation rows
// at once (8 f32 accumulators), so a prompt of S rows streams the quantized weights ceil(S/8) times
// instead of S times. Rows past M are clamped for the loads and not stored. Same decode, same
// per-row reduction order as the M=1 kernels.

// Item 18 (Ursela): prefill twins. (a) Packed f64 tree: the 8 per-row trees ran 40 warp-wide f64 adds
// per warp (f64 is 1/64 rate on GA102), now the active pairs of all 8 rows share the 32 lanes: 4+2+1+1+1
// steps, same pairs in the same order: both kernels bit-identical to before. (b) gemv_q4k_m8 runs 8-warp
// blocks (grid N/8 x 256): at 80 registers a 16-warp block fits once per SM. 3090, 9728x2560, M=5:
// q4 0.326 -> 0.198 ms, q6 0.248 -> 0.137 ms. (A coalesced lane map -- lane l owns quant byte l, so
// x loads are whole 128-byte lines -- made q4 0.146 ms but changes the f32 partial sums, and on the
// France prompt the QONLY stream lost the ',' at token 2 vs gold: not adopted; see the log.)
gemv_q4k_m8(p<Int>) -> {
    W<Int> = ld_i64(p + 0)
    X<Int> = ld_i64(p + 8)
    Y<Int> = ld_i64(p + 16)
    M<Int> = ld_i64(p + 24)
    N<Int> = ld_i64(p + 32)
    K<Int> = ld_i64(p + 40)
    YE<Int> = ld_i64(p + 48)
    tid<Int> = tid_x()
    l<Int> = tid % 32
    n<Int> = blk_x() * 8 + tid / 32
    nsb<Int> = K / 256
    t<Int> = l / 8
    l4<Int> = l * 4
    sh<UInt32> = ((t % 2) * 16) as UInt32
    mk<UInt32> = (0 as UInt32) - ((t / 2) as UInt32)
    nmk<UInt32> = (0 as UInt32) - ((1 - t / 2) as UInt32)
    st2<Int> = 16
    mm0<Int> = 0
    while (mm0 < M) {
        acc0<Float32> = 0.0
        acc1<Float32> = 0.0
        acc2<Float32> = 0.0
        acc3<Float32> = 0.0
        acc4<Float32> = 0.0
        acc5<Float32> = 0.0
        acc6<Float32> = 0.0
        acc7<Float32> = 0.0
        rr0<Int> = mm0 + 0
        if (rr0 > M - 1) { rr0 = M - 1 }
        xr0<Int> = X + (rr0 * K + (l / 8) * 64 + (l % 8) * 4) * 4
        rr1<Int> = mm0 + 1
        if (rr1 > M - 1) { rr1 = M - 1 }
        xr1<Int> = X + (rr1 * K + (l / 8) * 64 + (l % 8) * 4) * 4
        rr2<Int> = mm0 + 2
        if (rr2 > M - 1) { rr2 = M - 1 }
        xr2<Int> = X + (rr2 * K + (l / 8) * 64 + (l % 8) * 4) * 4
        rr3<Int> = mm0 + 3
        if (rr3 > M - 1) { rr3 = M - 1 }
        xr3<Int> = X + (rr3 * K + (l / 8) * 64 + (l % 8) * 4) * 4
        rr4<Int> = mm0 + 4
        if (rr4 > M - 1) { rr4 = M - 1 }
        xr4<Int> = X + (rr4 * K + (l / 8) * 64 + (l % 8) * 4) * 4
        rr5<Int> = mm0 + 5
        if (rr5 > M - 1) { rr5 = M - 1 }
        xr5<Int> = X + (rr5 * K + (l / 8) * 64 + (l % 8) * 4) * 4
        rr6<Int> = mm0 + 6
        if (rr6 > M - 1) { rr6 = M - 1 }
        xr6<Int> = X + (rr6 * K + (l / 8) * 64 + (l % 8) * 4) * 4
        rr7<Int> = mm0 + 7
        if (rr7 > M - 1) { rr7 = M - 1 }
        xr7<Int> = X + (rr7 * K + (l / 8) * 64 + (l % 8) * 4) * 4

        if (n < N) {
            rb<Int> = W + n * nsb * 144
            sb<Int> = 0
            for (sb in 0..nsb - 1) {
                bb<Int> = rb + sb * 144
                so<Int> = sb * 1024
                df<Float32> = ld_f16(bb)
                mnf<Float32> = ld_f16(bb + 2)
                b0<UInt32> = (ld_i32(bb + 4) as UInt32) >> sh
                b1<UInt32> = (ld_i32(bb + 8) as UInt32) >> sh
                b2<UInt32> = (ld_i32(bb + 12) as UInt32) >> sh
                sc0<UInt32> = ((b0 & 63) & nmk) | (((b2 & 15) | (((b0 >> 6) & 3) << 4)) & mk)
                m0<UInt32> = ((b1 & 63) & nmk) | ((((b2 >> 4) & 15) | (((b1 >> 6) & 3) << 4)) & mk)
                sc1<UInt32> = (((b0 >> 8) & 63) & nmk) | ((((b2 >> 8) & 15) | (((b0 >> 14) & 3) << 4)) & mk)
                m1<UInt32> = (((b1 >> 8) & 63) & nmk) | ((((b2 >> 12) & 15) | (((b1 >> 14) & 3) << 4)) & mk)
                ds0<Float32> = df * (sc0 as Float32)
                dm0<Float32> = mnf * (m0 as Float32)
                ds1<Float32> = df * (sc1 as Float32)
                dm1<Float32> = mnf * (m1 as Float32)
                qw<UInt32> = ld_i32(bb + 16 + l4) as UInt32
                wl0<Float32> = ds0 * (((qw >> 0) & 15) as Float32) - dm0
                xv0_wl0<Float32> = ld_f32(xr0 + so + 0)
                acc0 = acc0 + xv0_wl0 * wl0
                xv1_wl0<Float32> = ld_f32(xr1 + so + 0)
                acc1 = acc1 + xv1_wl0 * wl0
                xv2_wl0<Float32> = ld_f32(xr2 + so + 0)
                acc2 = acc2 + xv2_wl0 * wl0
                xv3_wl0<Float32> = ld_f32(xr3 + so + 0)
                acc3 = acc3 + xv3_wl0 * wl0
                xv4_wl0<Float32> = ld_f32(xr4 + so + 0)
                acc4 = acc4 + xv4_wl0 * wl0
                xv5_wl0<Float32> = ld_f32(xr5 + so + 0)
                acc5 = acc5 + xv5_wl0 * wl0
                xv6_wl0<Float32> = ld_f32(xr6 + so + 0)
                acc6 = acc6 + xv6_wl0 * wl0
                xv7_wl0<Float32> = ld_f32(xr7 + so + 0)
                acc7 = acc7 + xv7_wl0 * wl0
                wh0<Float32> = ds1 * (((qw >> 4) & 15) as Float32) - dm1
                xv0_wh0<Float32> = ld_f32(xr0 + so + 128)
                acc0 = acc0 + xv0_wh0 * wh0
                xv1_wh0<Float32> = ld_f32(xr1 + so + 128)
                acc1 = acc1 + xv1_wh0 * wh0
                xv2_wh0<Float32> = ld_f32(xr2 + so + 128)
                acc2 = acc2 + xv2_wh0 * wh0
                xv3_wh0<Float32> = ld_f32(xr3 + so + 128)
                acc3 = acc3 + xv3_wh0 * wh0
                xv4_wh0<Float32> = ld_f32(xr4 + so + 128)
                acc4 = acc4 + xv4_wh0 * wh0
                xv5_wh0<Float32> = ld_f32(xr5 + so + 128)
                acc5 = acc5 + xv5_wh0 * wh0
                xv6_wh0<Float32> = ld_f32(xr6 + so + 128)
                acc6 = acc6 + xv6_wh0 * wh0
                xv7_wh0<Float32> = ld_f32(xr7 + so + 128)
                acc7 = acc7 + xv7_wh0 * wh0
                wl1<Float32> = ds0 * (((qw >> 8) & 15) as Float32) - dm0
                xv0_wl1<Float32> = ld_f32(xr0 + so + 4)
                acc0 = acc0 + xv0_wl1 * wl1
                xv1_wl1<Float32> = ld_f32(xr1 + so + 4)
                acc1 = acc1 + xv1_wl1 * wl1
                xv2_wl1<Float32> = ld_f32(xr2 + so + 4)
                acc2 = acc2 + xv2_wl1 * wl1
                xv3_wl1<Float32> = ld_f32(xr3 + so + 4)
                acc3 = acc3 + xv3_wl1 * wl1
                xv4_wl1<Float32> = ld_f32(xr4 + so + 4)
                acc4 = acc4 + xv4_wl1 * wl1
                xv5_wl1<Float32> = ld_f32(xr5 + so + 4)
                acc5 = acc5 + xv5_wl1 * wl1
                xv6_wl1<Float32> = ld_f32(xr6 + so + 4)
                acc6 = acc6 + xv6_wl1 * wl1
                xv7_wl1<Float32> = ld_f32(xr7 + so + 4)
                acc7 = acc7 + xv7_wl1 * wl1
                wh1<Float32> = ds1 * (((qw >> 12) & 15) as Float32) - dm1
                xv0_wh1<Float32> = ld_f32(xr0 + so + 132)
                acc0 = acc0 + xv0_wh1 * wh1
                xv1_wh1<Float32> = ld_f32(xr1 + so + 132)
                acc1 = acc1 + xv1_wh1 * wh1
                xv2_wh1<Float32> = ld_f32(xr2 + so + 132)
                acc2 = acc2 + xv2_wh1 * wh1
                xv3_wh1<Float32> = ld_f32(xr3 + so + 132)
                acc3 = acc3 + xv3_wh1 * wh1
                xv4_wh1<Float32> = ld_f32(xr4 + so + 132)
                acc4 = acc4 + xv4_wh1 * wh1
                xv5_wh1<Float32> = ld_f32(xr5 + so + 132)
                acc5 = acc5 + xv5_wh1 * wh1
                xv6_wh1<Float32> = ld_f32(xr6 + so + 132)
                acc6 = acc6 + xv6_wh1 * wh1
                xv7_wh1<Float32> = ld_f32(xr7 + so + 132)
                acc7 = acc7 + xv7_wh1 * wh1
                wl2<Float32> = ds0 * (((qw >> 16) & 15) as Float32) - dm0
                xv0_wl2<Float32> = ld_f32(xr0 + so + 8)
                acc0 = acc0 + xv0_wl2 * wl2
                xv1_wl2<Float32> = ld_f32(xr1 + so + 8)
                acc1 = acc1 + xv1_wl2 * wl2
                xv2_wl2<Float32> = ld_f32(xr2 + so + 8)
                acc2 = acc2 + xv2_wl2 * wl2
                xv3_wl2<Float32> = ld_f32(xr3 + so + 8)
                acc3 = acc3 + xv3_wl2 * wl2
                xv4_wl2<Float32> = ld_f32(xr4 + so + 8)
                acc4 = acc4 + xv4_wl2 * wl2
                xv5_wl2<Float32> = ld_f32(xr5 + so + 8)
                acc5 = acc5 + xv5_wl2 * wl2
                xv6_wl2<Float32> = ld_f32(xr6 + so + 8)
                acc6 = acc6 + xv6_wl2 * wl2
                xv7_wl2<Float32> = ld_f32(xr7 + so + 8)
                acc7 = acc7 + xv7_wl2 * wl2
                wh2<Float32> = ds1 * (((qw >> 20) & 15) as Float32) - dm1
                xv0_wh2<Float32> = ld_f32(xr0 + so + 136)
                acc0 = acc0 + xv0_wh2 * wh2
                xv1_wh2<Float32> = ld_f32(xr1 + so + 136)
                acc1 = acc1 + xv1_wh2 * wh2
                xv2_wh2<Float32> = ld_f32(xr2 + so + 136)
                acc2 = acc2 + xv2_wh2 * wh2
                xv3_wh2<Float32> = ld_f32(xr3 + so + 136)
                acc3 = acc3 + xv3_wh2 * wh2
                xv4_wh2<Float32> = ld_f32(xr4 + so + 136)
                acc4 = acc4 + xv4_wh2 * wh2
                xv5_wh2<Float32> = ld_f32(xr5 + so + 136)
                acc5 = acc5 + xv5_wh2 * wh2
                xv6_wh2<Float32> = ld_f32(xr6 + so + 136)
                acc6 = acc6 + xv6_wh2 * wh2
                xv7_wh2<Float32> = ld_f32(xr7 + so + 136)
                acc7 = acc7 + xv7_wh2 * wh2
                wl3<Float32> = ds0 * (((qw >> 24) & 15) as Float32) - dm0
                xv0_wl3<Float32> = ld_f32(xr0 + so + 12)
                acc0 = acc0 + xv0_wl3 * wl3
                xv1_wl3<Float32> = ld_f32(xr1 + so + 12)
                acc1 = acc1 + xv1_wl3 * wl3
                xv2_wl3<Float32> = ld_f32(xr2 + so + 12)
                acc2 = acc2 + xv2_wl3 * wl3
                xv3_wl3<Float32> = ld_f32(xr3 + so + 12)
                acc3 = acc3 + xv3_wl3 * wl3
                xv4_wl3<Float32> = ld_f32(xr4 + so + 12)
                acc4 = acc4 + xv4_wl3 * wl3
                xv5_wl3<Float32> = ld_f32(xr5 + so + 12)
                acc5 = acc5 + xv5_wl3 * wl3
                xv6_wl3<Float32> = ld_f32(xr6 + so + 12)
                acc6 = acc6 + xv6_wl3 * wl3
                xv7_wl3<Float32> = ld_f32(xr7 + so + 12)
                acc7 = acc7 + xv7_wl3 * wl3
                wh3<Float32> = ds1 * (((qw >> 28) & 15) as Float32) - dm1
                xv0_wh3<Float32> = ld_f32(xr0 + so + 140)
                acc0 = acc0 + xv0_wh3 * wh3
                xv1_wh3<Float32> = ld_f32(xr1 + so + 140)
                acc1 = acc1 + xv1_wh3 * wh3
                xv2_wh3<Float32> = ld_f32(xr2 + so + 140)
                acc2 = acc2 + xv2_wh3 * wh3
                xv3_wh3<Float32> = ld_f32(xr3 + so + 140)
                acc3 = acc3 + xv3_wh3 * wh3
                xv4_wh3<Float32> = ld_f32(xr4 + so + 140)
                acc4 = acc4 + xv4_wh3 * wh3
                xv5_wh3<Float32> = ld_f32(xr5 + so + 140)
                acc5 = acc5 + xv5_wh3 * wh3
                xv6_wh3<Float32> = ld_f32(xr6 + so + 140)
                acc6 = acc6 + xv6_wh3 * wh3
                xv7_wh3<Float32> = ld_f32(xr7 + so + 140)
                acc7 = acc7 + xv7_wh3 * wh3

            }
        }
        wb<Int> = (tid / 32) * 256
        st_shared_f64(wb + 0 + l, acc0 as Float)
        st_shared_f64(wb + 32 + l, acc1 as Float)
        st_shared_f64(wb + 64 + l, acc2 as Float)
        st_shared_f64(wb + 96 + l, acc3 as Float)
        st_shared_f64(wb + 128 + l, acc4 as Float)
        st_shared_f64(wb + 160 + l, acc5 as Float)
        st_shared_f64(wb + 192 + l, acc6 as Float)
        st_shared_f64(wb + 224 + l, acc7 as Float)
        kernel_barrier()
        st2 = 16
        while (st2 > 0) {
            pc<Int> = l
            while (pc < 8 * st2) {
                pix<Int> = wb + (pc / st2) * 32 + pc % st2
                st_shared_f64(pix, ld_shared_f64(pix) + ld_shared_f64(pix + st2))
                pc = pc + 32
            }
            kernel_barrier()
            st2 = st2 / 2
        }
        if (l < 8) {
            if (n < N) { if (mm0 + l < M) {
                vo<Float> = ld_shared_f64(wb + l * 32)
                if (YE == 4) { st_f32(Y + ((mm0 + l) * N + n) * 4, vo as Float32) } else { st_f64(Y + ((mm0 + l) * N + n) * 8, vo) }
            } }
        }
        kernel_barrier()
        mm0 = mm0 + 8
    }
}

gemv_q6k_m8(p<Int>) -> {
    W<Int> = ld_i64(p + 0)
    X<Int> = ld_i64(p + 8)
    Y<Int> = ld_i64(p + 16)
    M<Int> = ld_i64(p + 24)
    N<Int> = ld_i64(p + 32)
    K<Int> = ld_i64(p + 40)
    YE<Int> = ld_i64(p + 48)
    tid<Int> = tid_x()
    l<Int> = tid % 32
    n<Int> = blk_x() * 16 + tid / 32
    nsb<Int> = K / 256
    g<Int> = l / 16
    jj<Int> = (l % 16) * 2
    g8is<Int> = g * 8 + jj / 16
    g64jj<Int> = g * 64 + jj
    g32jj<Int> = g * 32 + jj
    st2<Int> = 16
    mm0<Int> = 0
    while (mm0 < M) {
        acc0<Float32> = 0.0
        acc1<Float32> = 0.0
        acc2<Float32> = 0.0
        acc3<Float32> = 0.0
        acc4<Float32> = 0.0
        acc5<Float32> = 0.0
        acc6<Float32> = 0.0
        acc7<Float32> = 0.0
        rr0<Int> = mm0 + 0
        if (rr0 > M - 1) { rr0 = M - 1 }
        xr0<Int> = X + (rr0 * K + g * 128 + jj) * 4
        rr1<Int> = mm0 + 1
        if (rr1 > M - 1) { rr1 = M - 1 }
        xr1<Int> = X + (rr1 * K + g * 128 + jj) * 4
        rr2<Int> = mm0 + 2
        if (rr2 > M - 1) { rr2 = M - 1 }
        xr2<Int> = X + (rr2 * K + g * 128 + jj) * 4
        rr3<Int> = mm0 + 3
        if (rr3 > M - 1) { rr3 = M - 1 }
        xr3<Int> = X + (rr3 * K + g * 128 + jj) * 4
        rr4<Int> = mm0 + 4
        if (rr4 > M - 1) { rr4 = M - 1 }
        xr4<Int> = X + (rr4 * K + g * 128 + jj) * 4
        rr5<Int> = mm0 + 5
        if (rr5 > M - 1) { rr5 = M - 1 }
        xr5<Int> = X + (rr5 * K + g * 128 + jj) * 4
        rr6<Int> = mm0 + 6
        if (rr6 > M - 1) { rr6 = M - 1 }
        xr6<Int> = X + (rr6 * K + g * 128 + jj) * 4
        rr7<Int> = mm0 + 7
        if (rr7 > M - 1) { rr7 = M - 1 }
        xr7<Int> = X + (rr7 * K + g * 128 + jj) * 4

        if (n < N) {
            rb<Int> = W + n * nsb * 210
            sb<Int> = 0
            for (sb in 0..nsb - 1) {
                bb<Int> = rb + sb * 210
                so<Int> = sb * 1024
                df<Float32> = ld_f16(bb + 208)
                sbase<Int> = bb + 192 + g8is
                da<Float32> = df * ((ld_i8(sbase) as Int32) as Float32)
                db<Float32> = df * ((ld_i8(sbase + 2) as Int32) as Float32)
                dc<Float32> = df * ((ld_i8(sbase + 4) as Int32) as Float32)
                dd<Float32> = df * ((ld_i8(sbase + 6) as Int32) as Float32)
                qla<UInt32> = (ld_u16(bb + g64jj) as UInt32) & 65535
                qlb<UInt32> = (ld_u16(bb + g64jj + 32) as UInt32) & 65535
                qhw<UInt32> = (ld_u16(bb + 128 + g32jj) as UInt32) & 65535
                q1e0<Int32> = ((((qla >> 0) & 15) | ((((qhw >> 0) & 3)) << 4)) as Int32) - (32 as Int32)
                w1e0<Float32> = da * (q1e0 as Float32)
                xv0_w1e0<Float32> = ld_f32(xr0 + so + 0)
                acc0 = acc0 + xv0_w1e0 * w1e0
                xv1_w1e0<Float32> = ld_f32(xr1 + so + 0)
                acc1 = acc1 + xv1_w1e0 * w1e0
                xv2_w1e0<Float32> = ld_f32(xr2 + so + 0)
                acc2 = acc2 + xv2_w1e0 * w1e0
                xv3_w1e0<Float32> = ld_f32(xr3 + so + 0)
                acc3 = acc3 + xv3_w1e0 * w1e0
                xv4_w1e0<Float32> = ld_f32(xr4 + so + 0)
                acc4 = acc4 + xv4_w1e0 * w1e0
                xv5_w1e0<Float32> = ld_f32(xr5 + so + 0)
                acc5 = acc5 + xv5_w1e0 * w1e0
                xv6_w1e0<Float32> = ld_f32(xr6 + so + 0)
                acc6 = acc6 + xv6_w1e0 * w1e0
                xv7_w1e0<Float32> = ld_f32(xr7 + so + 0)
                acc7 = acc7 + xv7_w1e0 * w1e0
                q2e0<Int32> = ((((qlb >> 0) & 15) | ((((qhw >> 2) & 3)) << 4)) as Int32) - (32 as Int32)
                w2e0<Float32> = db * (q2e0 as Float32)
                xv0_w2e0<Float32> = ld_f32(xr0 + so + 128)
                acc0 = acc0 + xv0_w2e0 * w2e0
                xv1_w2e0<Float32> = ld_f32(xr1 + so + 128)
                acc1 = acc1 + xv1_w2e0 * w2e0
                xv2_w2e0<Float32> = ld_f32(xr2 + so + 128)
                acc2 = acc2 + xv2_w2e0 * w2e0
                xv3_w2e0<Float32> = ld_f32(xr3 + so + 128)
                acc3 = acc3 + xv3_w2e0 * w2e0
                xv4_w2e0<Float32> = ld_f32(xr4 + so + 128)
                acc4 = acc4 + xv4_w2e0 * w2e0
                xv5_w2e0<Float32> = ld_f32(xr5 + so + 128)
                acc5 = acc5 + xv5_w2e0 * w2e0
                xv6_w2e0<Float32> = ld_f32(xr6 + so + 128)
                acc6 = acc6 + xv6_w2e0 * w2e0
                xv7_w2e0<Float32> = ld_f32(xr7 + so + 128)
                acc7 = acc7 + xv7_w2e0 * w2e0
                q3e0<Int32> = ((((qla >> 4) & 15) | ((((qhw >> 4) & 3)) << 4)) as Int32) - (32 as Int32)
                w3e0<Float32> = dc * (q3e0 as Float32)
                xv0_w3e0<Float32> = ld_f32(xr0 + so + 256)
                acc0 = acc0 + xv0_w3e0 * w3e0
                xv1_w3e0<Float32> = ld_f32(xr1 + so + 256)
                acc1 = acc1 + xv1_w3e0 * w3e0
                xv2_w3e0<Float32> = ld_f32(xr2 + so + 256)
                acc2 = acc2 + xv2_w3e0 * w3e0
                xv3_w3e0<Float32> = ld_f32(xr3 + so + 256)
                acc3 = acc3 + xv3_w3e0 * w3e0
                xv4_w3e0<Float32> = ld_f32(xr4 + so + 256)
                acc4 = acc4 + xv4_w3e0 * w3e0
                xv5_w3e0<Float32> = ld_f32(xr5 + so + 256)
                acc5 = acc5 + xv5_w3e0 * w3e0
                xv6_w3e0<Float32> = ld_f32(xr6 + so + 256)
                acc6 = acc6 + xv6_w3e0 * w3e0
                xv7_w3e0<Float32> = ld_f32(xr7 + so + 256)
                acc7 = acc7 + xv7_w3e0 * w3e0
                q4e0<Int32> = ((((qlb >> 4) & 15) | ((((qhw >> 6) & 3)) << 4)) as Int32) - (32 as Int32)
                w4e0<Float32> = dd * (q4e0 as Float32)
                xv0_w4e0<Float32> = ld_f32(xr0 + so + 384)
                acc0 = acc0 + xv0_w4e0 * w4e0
                xv1_w4e0<Float32> = ld_f32(xr1 + so + 384)
                acc1 = acc1 + xv1_w4e0 * w4e0
                xv2_w4e0<Float32> = ld_f32(xr2 + so + 384)
                acc2 = acc2 + xv2_w4e0 * w4e0
                xv3_w4e0<Float32> = ld_f32(xr3 + so + 384)
                acc3 = acc3 + xv3_w4e0 * w4e0
                xv4_w4e0<Float32> = ld_f32(xr4 + so + 384)
                acc4 = acc4 + xv4_w4e0 * w4e0
                xv5_w4e0<Float32> = ld_f32(xr5 + so + 384)
                acc5 = acc5 + xv5_w4e0 * w4e0
                xv6_w4e0<Float32> = ld_f32(xr6 + so + 384)
                acc6 = acc6 + xv6_w4e0 * w4e0
                xv7_w4e0<Float32> = ld_f32(xr7 + so + 384)
                acc7 = acc7 + xv7_w4e0 * w4e0
                q1e1<Int32> = ((((qla >> 8) & 15) | ((((qhw >> 8) & 3)) << 4)) as Int32) - (32 as Int32)
                w1e1<Float32> = da * (q1e1 as Float32)
                xv0_w1e1<Float32> = ld_f32(xr0 + so + 4)
                acc0 = acc0 + xv0_w1e1 * w1e1
                xv1_w1e1<Float32> = ld_f32(xr1 + so + 4)
                acc1 = acc1 + xv1_w1e1 * w1e1
                xv2_w1e1<Float32> = ld_f32(xr2 + so + 4)
                acc2 = acc2 + xv2_w1e1 * w1e1
                xv3_w1e1<Float32> = ld_f32(xr3 + so + 4)
                acc3 = acc3 + xv3_w1e1 * w1e1
                xv4_w1e1<Float32> = ld_f32(xr4 + so + 4)
                acc4 = acc4 + xv4_w1e1 * w1e1
                xv5_w1e1<Float32> = ld_f32(xr5 + so + 4)
                acc5 = acc5 + xv5_w1e1 * w1e1
                xv6_w1e1<Float32> = ld_f32(xr6 + so + 4)
                acc6 = acc6 + xv6_w1e1 * w1e1
                xv7_w1e1<Float32> = ld_f32(xr7 + so + 4)
                acc7 = acc7 + xv7_w1e1 * w1e1
                q2e1<Int32> = ((((qlb >> 8) & 15) | ((((qhw >> 10) & 3)) << 4)) as Int32) - (32 as Int32)
                w2e1<Float32> = db * (q2e1 as Float32)
                xv0_w2e1<Float32> = ld_f32(xr0 + so + 132)
                acc0 = acc0 + xv0_w2e1 * w2e1
                xv1_w2e1<Float32> = ld_f32(xr1 + so + 132)
                acc1 = acc1 + xv1_w2e1 * w2e1
                xv2_w2e1<Float32> = ld_f32(xr2 + so + 132)
                acc2 = acc2 + xv2_w2e1 * w2e1
                xv3_w2e1<Float32> = ld_f32(xr3 + so + 132)
                acc3 = acc3 + xv3_w2e1 * w2e1
                xv4_w2e1<Float32> = ld_f32(xr4 + so + 132)
                acc4 = acc4 + xv4_w2e1 * w2e1
                xv5_w2e1<Float32> = ld_f32(xr5 + so + 132)
                acc5 = acc5 + xv5_w2e1 * w2e1
                xv6_w2e1<Float32> = ld_f32(xr6 + so + 132)
                acc6 = acc6 + xv6_w2e1 * w2e1
                xv7_w2e1<Float32> = ld_f32(xr7 + so + 132)
                acc7 = acc7 + xv7_w2e1 * w2e1
                q3e1<Int32> = ((((qla >> 12) & 15) | ((((qhw >> 12) & 3)) << 4)) as Int32) - (32 as Int32)
                w3e1<Float32> = dc * (q3e1 as Float32)
                xv0_w3e1<Float32> = ld_f32(xr0 + so + 260)
                acc0 = acc0 + xv0_w3e1 * w3e1
                xv1_w3e1<Float32> = ld_f32(xr1 + so + 260)
                acc1 = acc1 + xv1_w3e1 * w3e1
                xv2_w3e1<Float32> = ld_f32(xr2 + so + 260)
                acc2 = acc2 + xv2_w3e1 * w3e1
                xv3_w3e1<Float32> = ld_f32(xr3 + so + 260)
                acc3 = acc3 + xv3_w3e1 * w3e1
                xv4_w3e1<Float32> = ld_f32(xr4 + so + 260)
                acc4 = acc4 + xv4_w3e1 * w3e1
                xv5_w3e1<Float32> = ld_f32(xr5 + so + 260)
                acc5 = acc5 + xv5_w3e1 * w3e1
                xv6_w3e1<Float32> = ld_f32(xr6 + so + 260)
                acc6 = acc6 + xv6_w3e1 * w3e1
                xv7_w3e1<Float32> = ld_f32(xr7 + so + 260)
                acc7 = acc7 + xv7_w3e1 * w3e1
                q4e1<Int32> = ((((qlb >> 12) & 15) | ((((qhw >> 14) & 3)) << 4)) as Int32) - (32 as Int32)
                w4e1<Float32> = dd * (q4e1 as Float32)
                xv0_w4e1<Float32> = ld_f32(xr0 + so + 388)
                acc0 = acc0 + xv0_w4e1 * w4e1
                xv1_w4e1<Float32> = ld_f32(xr1 + so + 388)
                acc1 = acc1 + xv1_w4e1 * w4e1
                xv2_w4e1<Float32> = ld_f32(xr2 + so + 388)
                acc2 = acc2 + xv2_w4e1 * w4e1
                xv3_w4e1<Float32> = ld_f32(xr3 + so + 388)
                acc3 = acc3 + xv3_w4e1 * w4e1
                xv4_w4e1<Float32> = ld_f32(xr4 + so + 388)
                acc4 = acc4 + xv4_w4e1 * w4e1
                xv5_w4e1<Float32> = ld_f32(xr5 + so + 388)
                acc5 = acc5 + xv5_w4e1 * w4e1
                xv6_w4e1<Float32> = ld_f32(xr6 + so + 388)
                acc6 = acc6 + xv6_w4e1 * w4e1
                xv7_w4e1<Float32> = ld_f32(xr7 + so + 388)
                acc7 = acc7 + xv7_w4e1 * w4e1

            }
        }
        wb<Int> = (tid / 32) * 256
        st_shared_f64(wb + 0 + l, acc0 as Float)
        st_shared_f64(wb + 32 + l, acc1 as Float)
        st_shared_f64(wb + 64 + l, acc2 as Float)
        st_shared_f64(wb + 96 + l, acc3 as Float)
        st_shared_f64(wb + 128 + l, acc4 as Float)
        st_shared_f64(wb + 160 + l, acc5 as Float)
        st_shared_f64(wb + 192 + l, acc6 as Float)
        st_shared_f64(wb + 224 + l, acc7 as Float)
        kernel_barrier()
        st2 = 16
        while (st2 > 0) {
            pc<Int> = l
            while (pc < 8 * st2) {
                pix<Int> = wb + (pc / st2) * 32 + pc % st2
                st_shared_f64(pix, ld_shared_f64(pix) + ld_shared_f64(pix + st2))
                pc = pc + 32
            }
            kernel_barrier()
            st2 = st2 / 2
        }
        if (l < 8) {
            if (n < N) { if (mm0 + l < M) {
                vo<Float> = ld_shared_f64(wb + l * 32)
                if (YE == 4) { st_f32(Y + ((mm0 + l) * N + n) * 4, vo as Float32) } else { st_f64(Y + ((mm0 + l) * N + n) * 8, vo) }
            } }
        }
        kernel_barrier()
        mm0 = mm0 + 8
    }
}

// GEMV bandwidth (Ursela): software-pipelined M=1 twins of gemv_q4k_r1 / gemv_q6k_r1 (8-warp blocks).
// The loads of the NEXT two super-blocks (weights + x, register double buffer) are issued before the
// math of the current two, so a warp keeps ~2x the bytes in flight. Per-lane math and accumulation order
// are unchanged -> bit-identical outputs (harness bitdiff=0 on all shapes). Needs K/256 even.
// GB10 cold-L2 single launch, GB/s q4 [4096x2560, 1024x2560, 2560x4096, 9728x2560, 2560x9728]:
// r1 79/52/74/128/105 -> 86/50/87/134/129; q6 101/53/99/167/142 -> 109/66/111/173/168.

gemv_q4k_p2(p<Int>) -> {
    W<Int> = ld_i64(p + 0)
    X<Int> = ld_i64(p + 8)
    Y<Int> = ld_i64(p + 16)
    M<Int> = ld_i64(p + 24)
    N<Int> = ld_i64(p + 32)
    K<Int> = ld_i64(p + 40)
    YE<Int> = ld_i64(p + 48)
    tid<Int> = tid_x()
    l<Int> = tid % 32
    n0<Int> = (blk_x() * 8 + tid / 32) * 1
    nsb<Int> = K / 256
    c16<Float32> = 0.0000152587890625 as Float32
    c8<Float32> = 0.00390625 as Float32
    c65<Float32> = 65536.0 as Float32
    c256<Float32> = 256.0 as Float32
    c32<Float32> = 32.0 as Float32
    cmg<Float32> = 12582912.0 as Float32
    t<Int> = l / 8
    l4<Int> = l * 4
    sh<UInt32> = ((t % 2) * 16) as UInt32
    mk<UInt32> = (0 as UInt32) - ((t / 2) as UInt32)
    nmk<UInt32> = (0 as UInt32) - ((1 - t / 2) as UInt32)
    cAx0<Float32> = 0.0
    cAx1<Float32> = 0.0
    cAx2<Float32> = 0.0
    cAx3<Float32> = 0.0
    cAx4<Float32> = 0.0
    cAx5<Float32> = 0.0
    cAx6<Float32> = 0.0
    cAx7<Float32> = 0.0
    cAdf0<Float32> = 0.0
    cAmn0<Float32> = 0.0
    cAb00<UInt32> = 0 as UInt32
    cAb10<UInt32> = 0 as UInt32
    cAb20<UInt32> = 0 as UInt32
    cAqw0<UInt32> = 0 as UInt32
    cBx0<Float32> = 0.0
    cBx1<Float32> = 0.0
    cBx2<Float32> = 0.0
    cBx3<Float32> = 0.0
    cBx4<Float32> = 0.0
    cBx5<Float32> = 0.0
    cBx6<Float32> = 0.0
    cBx7<Float32> = 0.0
    cBdf0<Float32> = 0.0
    cBmn0<Float32> = 0.0
    cBb00<UInt32> = 0 as UInt32
    cBb10<UInt32> = 0 as UInt32
    cBb20<UInt32> = 0 as UInt32
    cBqw0<UInt32> = 0 as UInt32
    nAx0<Float32> = 0.0
    nAx1<Float32> = 0.0
    nAx2<Float32> = 0.0
    nAx3<Float32> = 0.0
    nAx4<Float32> = 0.0
    nAx5<Float32> = 0.0
    nAx6<Float32> = 0.0
    nAx7<Float32> = 0.0
    nAdf0<Float32> = 0.0
    nAmn0<Float32> = 0.0
    nAb00<UInt32> = 0 as UInt32
    nAb10<UInt32> = 0 as UInt32
    nAb20<UInt32> = 0 as UInt32
    nAqw0<UInt32> = 0 as UInt32
    nBx0<Float32> = 0.0
    nBx1<Float32> = 0.0
    nBx2<Float32> = 0.0
    nBx3<Float32> = 0.0
    nBx4<Float32> = 0.0
    nBx5<Float32> = 0.0
    nBx6<Float32> = 0.0
    nBx7<Float32> = 0.0
    nBdf0<Float32> = 0.0
    nBmn0<Float32> = 0.0
    nBb00<UInt32> = 0 as UInt32
    nBb10<UInt32> = 0 as UInt32
    nBb20<UInt32> = 0 as UInt32
    nBqw0<UInt32> = 0 as UInt32
    rb0<Int> = 0
    st2<Int> = 16
    mm<Int> = 0
    for (mm in 0..M - 1) {
        acc0<Float32> = 0.0
        if (n0 < N) {
            rb0<Int> = W + (n0 + 0) * nsb * 144
            xr<Int> = X + (mm * K + (l / 8) * 64 + (l % 8) * 4) * 4
            xbcA<Int> = xr + (0) * 1024
            cAx0 = ld_f32(xbcA + 0)
            cAx1 = ld_f32(xbcA + 4)
            cAx2 = ld_f32(xbcA + 8)
            cAx3 = ld_f32(xbcA + 12)
            cAx4 = ld_f32(xbcA + 128)
            cAx5 = ld_f32(xbcA + 132)
            cAx6 = ld_f32(xbcA + 136)
            cAx7 = ld_f32(xbcA + 140)
            bbcA0<Int> = rb0 + (0) * 144
            cAdf0 = ld_f16(bbcA0)
            cAmn0 = ld_f16(bbcA0 + 2)
            cAb00 = ld_i32(bbcA0 + 4) as UInt32
            cAb10 = ld_i32(bbcA0 + 8) as UInt32
            cAb20 = ld_i32(bbcA0 + 12) as UInt32
            cAqw0 = ld_i32(bbcA0 + 16 + l4) as UInt32
            xbcB<Int> = xr + (1) * 1024
            cBx0 = ld_f32(xbcB + 0)
            cBx1 = ld_f32(xbcB + 4)
            cBx2 = ld_f32(xbcB + 8)
            cBx3 = ld_f32(xbcB + 12)
            cBx4 = ld_f32(xbcB + 128)
            cBx5 = ld_f32(xbcB + 132)
            cBx6 = ld_f32(xbcB + 136)
            cBx7 = ld_f32(xbcB + 140)
            bbcB0<Int> = rb0 + (1) * 144
            cBdf0 = ld_f16(bbcB0)
            cBmn0 = ld_f16(bbcB0 + 2)
            cBb00 = ld_i32(bbcB0 + 4) as UInt32
            cBb10 = ld_i32(bbcB0 + 8) as UInt32
            cBb20 = ld_i32(bbcB0 + 12) as UInt32
            cBqw0 = ld_i32(bbcB0 + 16 + l4) as UInt32
            sb<Int> = 0
            while (sb < nsb) {
                if (sb + 2 < nsb) {
                    xbnA<Int> = xr + (sb + 2) * 1024
                    nAx0 = ld_f32(xbnA + 0)
                    nAx1 = ld_f32(xbnA + 4)
                    nAx2 = ld_f32(xbnA + 8)
                    nAx3 = ld_f32(xbnA + 12)
                    nAx4 = ld_f32(xbnA + 128)
                    nAx5 = ld_f32(xbnA + 132)
                    nAx6 = ld_f32(xbnA + 136)
                    nAx7 = ld_f32(xbnA + 140)
                    bbnA0<Int> = rb0 + (sb + 2) * 144
                    nAdf0 = ld_f16(bbnA0)
                    nAmn0 = ld_f16(bbnA0 + 2)
                    nAb00 = ld_i32(bbnA0 + 4) as UInt32
                    nAb10 = ld_i32(bbnA0 + 8) as UInt32
                    nAb20 = ld_i32(bbnA0 + 12) as UInt32
                    nAqw0 = ld_i32(bbnA0 + 16 + l4) as UInt32
                    xbnB<Int> = xr + (sb + 3) * 1024
                    nBx0 = ld_f32(xbnB + 0)
                    nBx1 = ld_f32(xbnB + 4)
                    nBx2 = ld_f32(xbnB + 8)
                    nBx3 = ld_f32(xbnB + 12)
                    nBx4 = ld_f32(xbnB + 128)
                    nBx5 = ld_f32(xbnB + 132)
                    nBx6 = ld_f32(xbnB + 136)
                    nBx7 = ld_f32(xbnB + 140)
                    bbnB0<Int> = rb0 + (sb + 3) * 144
                    nBdf0 = ld_f16(bbnB0)
                    nBmn0 = ld_f16(bbnB0 + 2)
                    nBb00 = ld_i32(bbnB0 + 4) as UInt32
                    nBb10 = ld_i32(bbnB0 + 8) as UInt32
                    nBb20 = ld_i32(bbnB0 + 12) as UInt32
                    nBqw0 = ld_i32(bbnB0 + 16 + l4) as UInt32
                }
                b0_0a<UInt32> = cAb00 >> sh
                b1_0a<UInt32> = cAb10 >> sh
                b2_0a<UInt32> = cAb20 >> sh
                sc0_0a<UInt32> = ((b0_0a & 63) & nmk) | (((b2_0a & 15) | (((b0_0a >> 6) & 3) << 4)) & mk)
                m0_0a<UInt32> = ((b1_0a & 63) & nmk) | ((((b2_0a >> 4) & 15) | (((b1_0a >> 6) & 3) << 4)) & mk)
                sc1_0a<UInt32> = (((b0_0a >> 8) & 63) & nmk) | ((((b2_0a >> 8) & 15) | (((b0_0a >> 14) & 3) << 4)) & mk)
                m1_0a<UInt32> = (((b1_0a >> 8) & 63) & nmk) | ((((b2_0a >> 12) & 15) | (((b1_0a >> 14) & 3) << 4)) & mk)
                ds0_0a<Float32> = cAdf0 * (sc0_0a as Float32)
                dm0_0a<Float32> = cAmn0 * (m0_0a as Float32)
                ds1_0a<Float32> = cAdf0 * (sc1_0a as Float32)
                dm1_0a<Float32> = cAmn0 * (m1_0a as Float32)
                qw_0a<UInt32> = cAqw0
                acc0 = acc0 + cAx0 * (ds0_0a * (((qw_0a >> 0) & 15) as Float32) - dm0_0a)
                acc0 = acc0 + cAx1 * (ds0_0a * (((qw_0a >> 8) & 15) as Float32) - dm0_0a)
                acc0 = acc0 + cAx2 * (ds0_0a * (((qw_0a >> 16) & 15) as Float32) - dm0_0a)
                acc0 = acc0 + cAx3 * (ds0_0a * (((qw_0a >> 24) & 15) as Float32) - dm0_0a)
                acc0 = acc0 + cAx4 * (ds1_0a * (((qw_0a >> 4) & 15) as Float32) - dm1_0a)
                acc0 = acc0 + cAx5 * (ds1_0a * (((qw_0a >> 12) & 15) as Float32) - dm1_0a)
                acc0 = acc0 + cAx6 * (ds1_0a * (((qw_0a >> 20) & 15) as Float32) - dm1_0a)
                acc0 = acc0 + cAx7 * (ds1_0a * (((qw_0a >> 28) & 15) as Float32) - dm1_0a)
                b0_0b<UInt32> = cBb00 >> sh
                b1_0b<UInt32> = cBb10 >> sh
                b2_0b<UInt32> = cBb20 >> sh
                sc0_0b<UInt32> = ((b0_0b & 63) & nmk) | (((b2_0b & 15) | (((b0_0b >> 6) & 3) << 4)) & mk)
                m0_0b<UInt32> = ((b1_0b & 63) & nmk) | ((((b2_0b >> 4) & 15) | (((b1_0b >> 6) & 3) << 4)) & mk)
                sc1_0b<UInt32> = (((b0_0b >> 8) & 63) & nmk) | ((((b2_0b >> 8) & 15) | (((b0_0b >> 14) & 3) << 4)) & mk)
                m1_0b<UInt32> = (((b1_0b >> 8) & 63) & nmk) | ((((b2_0b >> 12) & 15) | (((b1_0b >> 14) & 3) << 4)) & mk)
                ds0_0b<Float32> = cBdf0 * (sc0_0b as Float32)
                dm0_0b<Float32> = cBmn0 * (m0_0b as Float32)
                ds1_0b<Float32> = cBdf0 * (sc1_0b as Float32)
                dm1_0b<Float32> = cBmn0 * (m1_0b as Float32)
                qw_0b<UInt32> = cBqw0
                acc0 = acc0 + cBx0 * (ds0_0b * (((qw_0b >> 0) & 15) as Float32) - dm0_0b)
                acc0 = acc0 + cBx1 * (ds0_0b * (((qw_0b >> 8) & 15) as Float32) - dm0_0b)
                acc0 = acc0 + cBx2 * (ds0_0b * (((qw_0b >> 16) & 15) as Float32) - dm0_0b)
                acc0 = acc0 + cBx3 * (ds0_0b * (((qw_0b >> 24) & 15) as Float32) - dm0_0b)
                acc0 = acc0 + cBx4 * (ds1_0b * (((qw_0b >> 4) & 15) as Float32) - dm1_0b)
                acc0 = acc0 + cBx5 * (ds1_0b * (((qw_0b >> 12) & 15) as Float32) - dm1_0b)
                acc0 = acc0 + cBx6 * (ds1_0b * (((qw_0b >> 20) & 15) as Float32) - dm1_0b)
                acc0 = acc0 + cBx7 * (ds1_0b * (((qw_0b >> 28) & 15) as Float32) - dm1_0b)
                cAx0 = nAx0
                cAx1 = nAx1
                cAx2 = nAx2
                cAx3 = nAx3
                cAx4 = nAx4
                cAx5 = nAx5
                cAx6 = nAx6
                cAx7 = nAx7
                cAdf0 = nAdf0
                cAmn0 = nAmn0
                cAb00 = nAb00
                cAb10 = nAb10
                cAb20 = nAb20
                cAqw0 = nAqw0
                cBx0 = nBx0
                cBx1 = nBx1
                cBx2 = nBx2
                cBx3 = nBx3
                cBx4 = nBx4
                cBx5 = nBx5
                cBx6 = nBx6
                cBx7 = nBx7
                cBdf0 = nBdf0
                cBmn0 = nBmn0
                cBb00 = nBb00
                cBb10 = nBb10
                cBb20 = nBb20
                cBqw0 = nBqw0
                sb = sb + 2
            }
        }
        st_shared_f64(tid, acc0 as Float)
        kernel_barrier()
        st2 = 16
        while (st2 > 0) {
            if (l < st2) { st_shared_f64(tid, ld_shared_f64(tid) + ld_shared_f64(tid + st2)) }
            kernel_barrier()
            st2 = st2 / 2
        }
        if (l == 0) {
            if (n0 + 0 < N) {
                if (YE == 4) { st_f32(Y + (mm * N + n0 + 0) * 4, ld_shared_f64(tid) as Float32) } else { st_f64(Y + (mm * N + n0 + 0) * 8, ld_shared_f64(tid)) }
            }
        }
        kernel_barrier()
    }
}

gemv_q6k_p2(p<Int>) -> {
    W<Int> = ld_i64(p + 0)
    X<Int> = ld_i64(p + 8)
    Y<Int> = ld_i64(p + 16)
    M<Int> = ld_i64(p + 24)
    N<Int> = ld_i64(p + 32)
