                acc = acc + xv80 * (ds10 * (((qw0 >> 28) & 15) as Float32) - dm10)
                sb = sb + 1
            }
        }
        st_shared_f64(tid, acc as Float)
        kernel_barrier()
        st2 = 16
        while (st2 > 0) {
            if (l < st2) { st_shared_f64(tid, ld_shared_f64(tid) + ld_shared_f64(tid + st2)) }
            kernel_barrier()
