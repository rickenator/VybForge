                xv3e10<Float32> = ld_f32(xq0 + 260)
                acc = acc + xv3e10 * (dc0 * (q3e10 as Float32))
                q4e10<Int32> = ((((qlb0 >> 12) & 15) | ((((qhw0 >> 14) & 3)) << 4)) as Int32) - (32 as Int32)
                xv4e10<Float32> = ld_f32(xq0 + 388)
