// Qwen3-specific kernels (sm_86) — the pieces the shared layer.vyb set can't
// express. layer.vyb's rope is the PAIRS (LLaMA) form; Qwen3 uses the SPLIT-HALF
// rotary (transformers rotate_half: out = x*cos + cat(-xR, xL)*sin) with
// cos/sin = cos/sin(cat(freqs,freqs)), freqs[i]=pos*base^(-2i/HD), base=5e6.
import vmath::{vexp, vsin, vcos, vsqrt}

// Qwen3 split-half rotary on Q[S,H,HD] and K[S,KVH,HD], reading srcs, writing
// dsts (separate buffers avoid read/write races). Each thread = one output
// element. Theta repeats every HD/2: cos/sin angle for index i uses FR[i%half].
// Params buffer:
//   +80 Qsrc +88 Ksrc +96 Qdst +104 Kdst +176 FR(inv_freq[half])
//   +184 S +200 HD +208 H +216 KVH +224 POS (absolute position base; row r -> pos POS+r)
qwen3rope(p<Int>) -> {
    Q<Int> = ld_i64(p + 80)
    K<Int> = ld_i64(p + 88)
    Qd<Int> = ld_i64(p + 96)
    Kd<Int> = ld_i64(p + 104)
    FR<Int> = ld_i64(p + 176)
    S<Int> = ld_i64(p + 184)
    HD<Int> = ld_i64(p + 200)
    H<Int> = ld_i64(p + 208)
    KVH<Int> = ld_i64(p + 216)
    POS<Int> = ld_i64(p + 224)
    TB<Int> = ld_i64(p + 112)
    KE4<Int> = ld_i64(p + 120)
    half<Int> = HD / 2
    shd<Int> = S * H * HD
    skd<Int> = S * KVH * HD
    total<Int> = shd + skd
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < total) {
        if (gid < shd) {
            s<Int> = gid / (H * HD)
            rem<Int> = gid % (H * HD)
            hh<Int> = rem / HD
            i<Int> = rem % HD
            c<Float> = 0.0
            sn<Float> = 0.0
            if (TB != 0) {
                tix<Int> = TB + ((POS + s) * half + i % half) * 16
                c = ld_f64(tix)
                sn = ld_f64(tix + 8)
            } else {
                ang<Float> = ((POS + s) as Float) * ld_f64(FR + (i % half) * 8)
                c = vcos(ang)
                sn = vsin(ang)
            }
            src<Int> = Q + (s * H * HD + hh * HD) * 8
            v0<Float> = ld_f64(src + i * 8)
            if (i < half) {
                v1<Float> = ld_f64(src + (i + half) * 8)
                st_f64(Qd + gid * 8, v0 * c - v1 * sn)
            } else {
                v1<Float> = ld_f64(src + (i - half) * 8)
                st_f64(Qd + gid * 8, v0 * c + v1 * sn)
            }
        } else {
            g2<Int> = gid - shd
            s2<Int> = g2 / (KVH * HD)
            rem2<Int> = g2 % (KVH * HD)
            hh2<Int> = rem2 / HD
            i2<Int> = rem2 % HD
            c2<Float> = 0.0
            sn2<Float> = 0.0
            if (TB != 0) {
                tix2<Int> = TB + ((POS + s2) * half + i2 % half) * 16
                c2 = ld_f64(tix2)
                sn2 = ld_f64(tix2 + 8)
            } else {
                ang2<Float> = ((POS + s2) as Float) * ld_f64(FR + (i2 % half) * 8)
                c2 = vcos(ang2)
                sn2 = vsin(ang2)
            }
            src2<Int> = K + (s2 * KVH * HD + hh2 * HD) * 8
            v0<Float> = ld_f64(src2 + i2 * 8)
            if (i2 < half) {
                v1<Float> = ld_f64(src2 + (i2 + half) * 8)
                krm<Float> = v0 * c2 - v1 * sn2
                if (KE4 == 4) { st_f32(Kd + g2 * 4, krm as Float32) } else { st_f64(Kd + g2 * 8, krm) }
            } else {
                v1<Float> = ld_f64(src2 + (i2 - half) * 8)
                krp<Float> = v0 * c2 + v1 * sn2
                if (KE4 == 4) { st_f32(Kd + g2 * 4, krp as Float32) } else { st_f64(Kd + g2 * 8, krp) }
            }
        }
    }
}

// Expand F32 norm weights to f64 device buffer: out[gid] = f32(src[gid]).
// Params: +0 src, +8 dst, +16 n.
f32expand(p<Int>) -> {
    src<Int> = ld_i64(p + 0)
    dst<Int> = ld_i64(p + 8)
    n<Int> = ld_i64(p + 16)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < n) {
        v<Float> = ld_f32(src + gid * 4)
        st_f64(dst + gid * 8, v)
    }
}

// Transpose the tied lm_head embedding [V,D] (vocab-major) into [D,V] so the
// shared row-major gemm can compute hidden @ emb^T. Params: +0 src, +8 dst,
// +16 D, +24 V. Thread = one element: v = gid/D, d = gid%D.
trans_emb(p<Int>) -> {
    src<Int> = ld_i64(p + 0)
    dst<Int> = ld_i64(p + 8)
    D<Int> = ld_i64(p + 16)
    V<Int> = ld_i64(p + 24)
    gid<Int> = blk_x() * dim_x() + tid_x()
    nn<Int> = D * V
    if (gid < nn) {
        v<Int> = gid / D
        d<Int> = gid % D
        st_f64(dst + (d * V + v) * 8, ld_f64(src + gid * 8))
    }
}

// Per-token logits for a vocab slice, reading emb [V,D] directly (no transpose):
// Log[s, Vstart+gid] = sum_{d<D} H[s*D+d] * Emb[(Vstart+gid)*D+d].
// Chunked launches keep each grid <= a few dozen blocks (large multi-block
// launches silently truncate in this build). Params: +0 H +8 Emb +16 Log
// +24 s +32 D +40 Vstart +48 Vend +56 V (full vocab stride).
logits_slice(p<Int>) -> {
    H<Int> = ld_i64(p + 0)
    Emb<Int> = ld_i64(p + 8)
    Log<Int> = ld_i64(p + 16)
    s<Int> = ld_i64(p + 24)
    D<Int> = ld_i64(p + 32)
    Vstart<Int> = ld_i64(p + 40)
    Vend<Int> = ld_i64(p + 48)
    V<Int> = ld_i64(p + 56)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < Vend - Vstart) {
        vs<Int> = Vstart + gid
        # The MAC is done in f32, narrowed in register. f64 is 1/64 rate on sm_86, so an f64-MAC loop
        # cannot be fast no matter how it is unrolled: this kernel measured 14.1 ms/token for ~39M MACs
        # (28 GFLOP/s) while being 23.6% of a token. The VALUES are still f64 and the result is still
        # stored f64 -- only the multiply/add is f32, exactly as the f32 weight path already is, and the
        # gold stream (identical greedy output) is the gate that it costs nothing that matters.
        acc<Float32> = 0.0
        d<Int> = 0
        for (d in 0..D - 1) {
            hv<Float> = ld_f64(H + (s * D + d) * 8)
            ev<Float> = ld_f64(Emb + (vs * D + d) * 8)
            hv32<Float32> = hv
            ev32<Float32> = ev
            acc = acc + hv32 * ev32
        }
        st_f64(Log + (s * V + vs) * 8, acc)
    }
}
// Running argmax over a vocab CHUNK, for an untied lm_head whose table cannot be dequantised whole
// (Ridge: output.weight is Q6_K 5120x248320 -> 10.2 GB as f64, so the head runs chunk by chunk and
// the winner is carried across chunks). Reads C[S,CH] (this chunk's logits for every position),
// updates BV[S] (the running best value) and Out[S] (the running best index) with the GLOBAL index
// base+i. One thread per row, grid = S. The caller seeds BV = -inf (or the first chunk's row max) and
// Out = 0 before the first call. Strict `>` on purpose: a tie keeps the EARLIER index, which is what
// argmax_row does, so a chunked head and a whole-table head agree on ties.
// Params: +0 C +8 BV +16 Out +24 S +32 CH +40 base
argmax_acc(p<Int>) -> {
    C<Int> = ld_i64(p + 0)
    BV<Int> = ld_i64(p + 8)
    Out<Int> = ld_i64(p + 16)
    S<Int> = ld_i64(p + 24)
    CH<Int> = ld_i64(p + 32)
    base<Int> = ld_i64(p + 40)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < S) {
        rbase<Int> = C + gid * CH * 8
        bv<Float> = ld_f64(BV + gid * 8)
        best<Int> = ld_i64(Out + gid * 8)
        i<Int> = 0
        for (i in 0..CH - 1) {
            v2<Float> = ld_f64(rbase + i * 8)
            if (v2 > bv) { bv = v2; best = base + i }
        }
        st_f64(BV + gid * 8, bv)
        st_i64(Out + gid * 8, best)
    }
}

// Token-embedding gather (Qwen3 token_embd): OUT[s*D+d] = EMB[ids[s]*D+d].
// EMB f64 [VOCAB,D], ids f64-width Int per row (as stored in an Int device buf).
// Params: +0 EMB +8 IDS +16 OUT +24 S +32 D. Grid = S*D.
embed(p<Int>) -> {
    EMB<Int> = ld_i64(p + 0); IDS<Int> = ld_i64(p + 8); OUT<Int> = ld_i64(p + 16)
    S<Int> = ld_i64(p + 24); D<Int> = ld_i64(p + 32)
    tot<Int> = S * D
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < tot) {
        s<Int> = gid / D; d<Int> = gid % D
        id<Int> = ld_i64(IDS + s * 8)
        st_f64(OUT + gid * 8, ld_f64(EMB + (id * D + d) * 8))
    }
}

// Per-token argmax over a [S,V] f64 logits buffer -> S ints (tied lm_head top-1).
// Params: +0 C, +8 Out, +16 S, +24 V. Grid = S.
argmax_row(p<Int>) -> {
    C<Int> = ld_i64(p + 0)
    Out<Int> = ld_i64(p + 8)
    S<Int> = ld_i64(p + 16)
    V<Int> = ld_i64(p + 24)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < S) {
        rbase<Int> = C + gid * V * 8
        best<Int> = 0
        bv<Float> = ld_f64(rbase + 0)
        i<Int> = 0
        for (i in 1..V - 1) {
            v2<Float> = ld_f64(rbase + i * 8)
            if (v2 > bv) { bv = v2; best = i }
        }
        st_i64(Out + gid * 8, best)
    }
}

// Two-pass argmax over ONE logits row (VybForge#23). `argmax_row` launches S threads — for the decode
// head S=1 — so that single thread scans V=151936 f64 values in a dependent chain: measured 14.4 ms for
// one launch, ~1.4% of the f64 peak. Same shape as the old attn: not enough threads.
//   argmax1_p  one thread per CHUNK of CH elements -> PV[g], PI[g] (value, absolute index)
//   argmax1_r  ONE thread over the partials (V/CH ~ 594, not 151936) picks the winner
// Ties: both passes compare strictly-greater over ascending indices, which reproduces the serial scan's
// result exactly (earliest index attaining the max).
// Params: argmax1_p +0 C, +8 PV, +16 PI, +24 V, +32 CH.  argmax1_r +0 PV, +8 PI, +16 Out, +24 NCH.
argmax1_p(p<Int>) -> {
    C<Int> = ld_i64(p + 0)
    PV<Int> = ld_i64(p + 8)
    PI<Int> = ld_i64(p + 16)
    V<Int> = ld_i64(p + 24)
    CH<Int> = ld_i64(p + 32)
    gid<Int> = blk_x() * dim_x() + tid_x()
    nch<Int> = (V + CH - 1) / CH
    if (gid < nch) {
        i0<Int> = gid * CH
        i1<Int> = i0 + CH
        if (i1 > V) { i1 = V }
        best<Int> = i0
        bv<Float> = ld_f64(C + i0 * 8)
        i<Int> = i0 + 1
        for (i in i0 + 1..i1 - 1) {
            v2<Float> = ld_f64(C + i * 8)
            if (v2 > bv) { bv = v2; best = i }
        }
        st_f64(PV + gid * 8, bv)
        st_i64(PI + gid * 8, best)
    }
}

argmax1_r(p<Int>) -> {
    PV<Int> = ld_i64(p + 0)
    PI<Int> = ld_i64(p + 8)
    Out<Int> = ld_i64(p + 16)
    NCH<Int> = ld_i64(p + 24)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < 1) {
        best<Int> = ld_i64(PI + 0)
        bv<Float> = ld_f64(PV + 0)
        k<Int> = 1
        for (k in 1..NCH - 1) {
            v2<Float> = ld_f64(PV + k * 8)
            if (v2 > bv) { bv = v2; best = ld_i64(PI + k * 8) }
        }
        st_i64(Out + 0, best)
    }
}

// Coalesced tied-head logits (Ursela, VybForge#23 follow-up). logits_slice gives each vocab row to ONE
// thread that walks its 2560-element row of the f64 table alone: neighbouring threads touch addresses D*8
// bytes apart, so every load is its own cache line, and on the GB10 it ran at ~107 GB/s -- 29 ms of a
// ~120 ms token -- while the gemms run near DRAM peak. Making it one launch instead of ten chunks
// changed nothing (measured), so the grid was not the problem; the access pattern was.
// Here 32 consecutive threads share one row (lane = gid % 32) and read d = lane, lane+32, ... -- one
// 128-byte line per warp step -- from an f32 COPY of the table (1.55 GB instead of 3.1 GB per token; the
// copy is the f64 table narrowed, the same values logits_slice narrows in register). Pass 2 sums the
// 32 lane partials per row in lane order and stores the f64 logit. The summation ORDER differs from
// logits_slice (lane-strided partials), so logits differ at f32 rounding; the gold stream is the gate.
// logits32_p params: +0 H (f64 [*, D]), +8 E32 (f32 [V, D]), +16 PART (f32 [V, 32]), +24 s, +32 D, +40 V
logits32_p(p<Int>) -> {
    H<Int> = ld_i64(p + 0)
    E<Int> = ld_i64(p + 8)
    PART<Int> = ld_i64(p + 16)
    s<Int> = ld_i64(p + 24)
    D<Int> = ld_i64(p + 32)
    V<Int> = ld_i64(p + 40)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < V * 32) {
        v<Int> = gid / 32
        ln<Int> = gid % 32
        acc<Float32> = 0.0
        hb<Int> = H + s * D * 8
        eb<Int> = E + v * D * 4
        d<Int> = ln
        while (d < D) {
            hv<Float> = ld_f64(hb + d * 8)
            hv32<Float32> = hv
            ev32<Float32> = ld_f32(eb + d * 4)
            acc = acc + hv32 * ev32
            d = d + 32
        }
        st_f32(PART + gid * 4, acc)
    }
}
// logits32_r params: +0 PART, +8 Log (f64 [*, V]), +16 s, +24 V
logits32_r(p<Int>) -> {
    PART<Int> = ld_i64(p + 0)
    Log<Int> = ld_i64(p + 8)
    s<Int> = ld_i64(p + 16)
    V<Int> = ld_i64(p + 24)
    v<Int> = blk_x() * dim_x() + tid_x()
    if (v < V) {
        acc<Float32> = 0.0
        ln<Int> = 0
        for (ln in 0..31) {
            pv<Float32> = ld_f32(PART + (v * 32 + ln) * 4)
            acc = acc + pv
        }
        st_f64(Log + (s * V + v) * 8, acc)
    }
}

// logits32_p over an f16 copy of the tied embedding (Ursela): 0.78 GB per token instead of 1.55 GB.
// Same lanes, same order; only the table element is rounded to half. VYB_HEAD32=1 keeps the f32 table.
logits16_p(p<Int>) -> {
    H<Int> = ld_i64(p + 0)
    E<Int> = ld_i64(p + 8)
    PART<Int> = ld_i64(p + 16)
    s<Int> = ld_i64(p + 24)
    D<Int> = ld_i64(p + 32)
    V<Int> = ld_i64(p + 40)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < V * 32) {
        v<Int> = gid / 32
        ln<Int> = gid % 32
        acc<Float32> = 0.0
        hb<Int> = H + s * D * 8
        eb<Int> = E + v * D * 2
        d<Int> = ln
        while (d < D) {
            hv<Float> = ld_f64(hb + d * 8)
            hv32<Float32> = hv
            ev32<Float32> = ld_f16(eb + d * 2)
            acc = acc + hv32 * ev32
            d = d + 32
        }
        st_f32(PART + gid * 4, acc)
    }
}

// Rotary cos/sin table (Ursela): TB[pos*64 + i] = {vcos(pos*FR[i]), vsin(pos*FR[i])} for pos < MAXS,
// built once at load with exactly the angle expression qwen3rope uses, so values are bit-identical.
// qwen3rope reads it when its +112 slot is non-zero (HD=128 only). Params: GP3 {FR, TB, n = MAXS*64}.
rope_tab(p<Int>) -> {
    FR<Int> = ld_i64(p + 0)
    TB<Int> = ld_i64(p + 8)
    n<Int> = ld_i64(p + 16)
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < n) {
        pos<Int> = gid / 64
        i<Int> = gid % 64
        ang<Float> = (pos as Float) * ld_f64(FR + i * 8)
        st_f64(TB + gid * 16, vcos(ang))
        st_f64(TB + gid * 16 + 8, vsin(ang))
    }
}

// ---- Fused quantized GEMV (VybForge#23, Ursela): Y[m, n] = sum_k X[m, k] * W[n, k], read straight
// from the resident GGUF Q4_K / Q6_K blocks -- the decode never touches an expanded weight copy.
// Derived from llama.cpp (MIT License, https://github.com/ggml-org/llama.cpp), commit 4df29be
// (2026-08-16): ggml-cuda/mmvq.cu mul_mat_vec_q (one warp per output row, lanes striding the
// row's 256-value super-blocks, warp reduce at the end) and vecdotq.cuh vec_dot_q4_K_q8_1 /
// vec_dot_q6_K_q8_1 for the per-lane block/scale layout; the float (non-dp4a, unquantized x)
// formulation follows the older ggml-cuda dmmv.cu dequantize_mul_mat_vec_q4_k / _q6_k (since
// removed upstream); block decode from ggml-quants.c dequantize_row_q4_K / get_scale_min_k4 /
// dequantize_row_q6_K. See THIRD-PARTY.md.
// Differences from llama.cpp:
//  * no warp shuffle in Vyb device code -> the 32 lane partials are reduced through shared memory
//    (f64, fixed order), and the row's result is stored f64 (the driver's activation type);
//  * get_scale_min_k4 is branchless: the 12 scale bytes are loaded as 3 aligned 32-bit words and a
//    per-lane mask picks the low-group (6-bit) or high-group (4+2-bit) formula;
//  * each weight is decoded with q4kdeq32's / q6kdeq32's f32 expression (d*sc*q - dmin*m, d*sc*q),
//    so per-weight values equal the f32 resident path's; accumulation is f32 per lane.
// Vyb notes (see the log): decode ints are UInt32/Int32 (Int is 64-bit and 64-bit shifts/masks/
// int->float cost ~2-4x); every ld_f32 goes into a Float32 local first, because ld_f32 returns Float
// (f64) and an inline `acc + ld_f32(..) * w` silently promotes the whole product to f64 (4x slower).
// Params (p): W@0 (row n at W + n*(K/256)*BS), X@8 (f32 [M,K]), Y@16 (f64 [M,N]), M@24, N@32, K@40.
// Launch: ceil(N/16) blocks x 512 threads (16 warps = 16 rows per block; 512 rather than 256 because
// Vyb's shared array is a fixed 32 KB per block, which caps residency at 3 blocks/SM on sm_86).
// Q4_K lane map (144 B block: d@0 dmin@2 scales[12]@4 qs[128]@16): lane l loads qs word l (bytes
//   4l..4l+3): low nibbles = elements (l/8)*64 + (l%8)*4 + {0..3} (group 2(l/8)), high nibbles the
//   same +32 (group 2(l/8)+1). One aligned 4-byte load per lane, 128 contiguous bytes per warp.
// Q6_K lane map (210 B block: ql[128]@0 qh[64]@128 scales[16]@192 d@208): lane l takes half
//   g = l/16 and positions ll = (l%16)*2 + {0,1}; each ll yields elements g*128 + ll + {0,32,64,96}.

// Item 19 (Ursela): the M=1 kernels now take R = 2 weight rows per warp (the 8 x values of a lane are
// loaded once for both rows) and convert quant values to f32 two at a time: two nibbles (Q4_K) or two
// 6-bit values (Q6_K) sit 16 / 8 bits apart in one u32, one exact int->f32 convert, then the pair is
// split with the round-to-integer magic hi = (v * 2^-s + 1.5*2^23) - 1.5*2^23 (exact: lo * 2^-s < 0.5),
// lo = v - hi * 2^s. Ampere converts int->f32 at 1/4 of the f32 FMA rate; that convert was the limiter
// (dropping the x loads changed nothing, dropping the decode gave +40%). Same values, same per-row
// accumulation order: outputs bit-identical to the R = 1 kernels (checked bitwise on all 5 shapes).
// gemv_q4k / gemv_q6k: 16 warps x 2 rows per block (grid N/32 x 512); the _s twins: 4 warps x 2 rows
// (grid N/8 x 128) for N <= 1024, where 16-warp blocks leave SMs idle. N must be even.
gemv_q4k(p<Int>) -> {
    W<Int> = ld_i64(p + 0)
    X<Int> = ld_i64(p + 8)
    Y<Int> = ld_i64(p + 16)
    M<Int> = ld_i64(p + 24)
    N<Int> = ld_i64(p + 32)
    K<Int> = ld_i64(p + 40)
    YE<Int> = ld_i64(p + 48)
    tid<Int> = tid_x()
    l<Int> = tid % 32
    n0<Int> = (blk_x() * 16 + tid / 32) * 2
    nsb<Int> = K / 256
    c16<Float32> = 0.0000152587890625 as Float32
    c8<Float32> = 0.00390625 as Float32
    c65<Float32> = 65536.0 as Float32
    c256<Float32> = 256.0 as Float32
    c32<Float32> = 32.0 as Float32
    cmg<Float32> = 12582912.0 as Float32
    t<Int> = l / 8
    l4<Int> = l * 4
    sh<UInt32> = ((t % 2) * 16) as UInt32
    mk<UInt32> = (0 as UInt32) - ((t / 2) as UInt32)
    nmk<UInt32> = (0 as UInt32) - ((1 - t / 2) as UInt32)
    st2<Int> = 16
    mm<Int> = 0
    for (mm in 0..M - 1) {
        acc0_0<Float32> = 0.0
        acc1_0<Float32> = 0.0
        if (n0 < N) {
            rb0<Int> = W + (n0 + 0) * nsb * 144
            rb1<Int> = W + (n0 + 1) * nsb * 144
            xr<Int> = X + (mm * K + (l / 8) * 64 + (l % 8) * 4) * 4
            sb<Int> = 0
            while (sb < nsb) {
                if (sb + 0 < nsb) {
                    xb_0<Int> = xr + (sb + 0) * 1024
                    xv0_0<Float32> = ld_f32(xb_0 + 0)
