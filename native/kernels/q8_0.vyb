// GGUF block_q8_0 dequant kernel — the Gated-DeltaNet state path of Qwen3.8-27B
// Ridge (ssm_alpha/ssm_beta are the 96 Q8_0 tensors in that file).
// Ported faithfully from llama.cpp ggml-quants.c dequantize_row_q8_0.
// Derived from llama.cpp (MIT License, https://github.com/ggml-org/llama.cpp):
// ggml-quants.c, dequantize_row_q8_0. See THIRD-PARTY.md.
// block layout (34 B): d f16 @0, qs[32] int8 @2. 32 values/block, 1 block = 1 row
// segment; NO scales[], NO min, and the quants are SIGNED with no offset — the
// simplest of the family (contrast q4kdeq's 6-bit packed scale/min and q6kdeq's
// split nibble/high-bit pairs). Thread = one output element (Float, 8 bytes).
// Launch via cuda_launch4i.
q8_0deq(q<Int>, o<Int>, n<Int>, z<Int>) -> {
    gid<Int> = blk_x() * dim_x() + tid_x()
    if (gid < n) {
        block<Int> = gid / 32
        e<Int> = gid % 32
        bb<Int> = q + block * 34
        d<Float> = ld_f16(bb + 0)
        qv<Int> = ld_i8(bb + 2 + e) as Int      # signed int8, used as-is
        val<Float> = d * (qv as Float)
        # GGUF dequant emits out-major; gemm needs [in,out] (VybForge#11). When
        # z (= in-dim) > 0, write transposed (see q4kdeq's comment for why).
        if (z > 0) {
            rr<Int> = gid / z
            cc<Int> = gid % z
            st_f64(o + cc * n / z * 8 + rr * 8, val)
        } else {
            st_f64(o + gid * 8, val)
        }
    }
}
