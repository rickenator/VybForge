// core — the host-side tensor core (S0.2b): shape, strides, dtype and the memory model.
//
// PURE on purpose: no CUDA, no allocation, no device handle. native/tensor/tensor.vyb owns the
// device calls, and importing THAT drags cuda_binding into the importer (Vyb#442), which a
// shape library must not do to its consumers. Everything here is therefore checkable against
// numpy on the CPU, and the gate does exactly that.
//
// The rules are numpy's, deliberately and exactly:
//   * strides are in ELEMENTS, row-major (C order) unless a view says otherwise;
//   * broadcasting is right-aligned; a dimension of 1 expands, a missing leading dimension
//     counts as 1, and anything else is REFUSED — a broadcast that cannot work must not
//     quietly produce a shape;
//   * numel of a rank-0 tensor is 1 (numpy's ()-shaped array) and of a shape containing a 0
//     is 0; the two are different facts and both are represented.
//
// Consumers: the drivers (S0.2c) get buffer sizes and strided coordinates from here instead of
// spelling byte arithmetic out by hand. Gate: native/legit/run_tensor_gate.sh (case table
// generated by numpy — native/tensor/ts_ref.py).

import dtype::{dt_width, dt_name}

// A device buffer's *description*. `ptr`/`off` are the address and an element offset, so a
// view (slice, transpose) is a new description pointing into the same allocation — no data
// moves, which is the whole point of having strides.
share(all)
struct TT {
    name<String>,
    dtype<Int>,
    dev<Int>,          // device address of the allocation this describes (0 = not attached yet)
    off<Int>,          // element offset into that allocation
    dims<Vec<Int>>,
    strides<Vec<Int>>
}

// ─────────────────────────── shape and strides ───────────────────────────

// Row-major (C order) element strides for a shape: the innermost dimension is contiguous.
share(all) tt_rowmajor_strides(dims<Vec<Int>>)<Vec<Int>> -> {
    n<Int> = dims.len()
    rev<Vec<Int>> = Vec()
    if (n == 0) { return rev }
    acc<Int> = 1
    i<Int> = 0
    for (i in 0..n - 1) {
        rev.push(acc)
        acc = acc * dims.get(n - 1 - i)
    }
    out<Vec<Int>> = Vec()
    k<Int> = 0
    for (k in 0..n - 1) { out.push(rev.get(n - 1 - k)) }
    return out
}

share(all) tt_numel(dims<Vec<Int>>)<Int> -> {
    n<Int> = dims.len()
    if (n == 0) { return 1 }
    p<Int> = 1
    i<Int> = 0
    for (i in 0..n - 1) { p = p * dims.get(i) }
    return p
}

// Bytes this shape needs at this dtype (0 for an unknown dtype).
share(all) tt_nbytes(dims<Vec<Int>>, d<Int>)<Int> -> {
    return tt_numel(dims) * dt_width(d)
}

share(all) tt_dtype_name(d<Int>)<String> -> { return dt_name(d) }

// A description is contiguous when its strides are exactly the row-major ones. A size-1 axis
// imposes no constraint (numpy agrees: any stride on a length-1 dim is contiguous), and rank 0
// is trivially contiguous. Rank 1 is NOT a special case — a column view is (4,) with stride 6
// and numpy calls that non-contiguous, which is how the gate caught this.
share(all) tt_is_contig(dims<Vec<Int>>, strides<Vec<Int>>)<Bool> -> {
    n<Int> = dims.len()
    if (n != strides.len()) { return false }
    if (n == 0) { return true }
    if (n > 1) {
        want<Vec<Int>> = tt_rowmajor_strides(dims)
        i<Int> = 0
        for (i in 0..n - 2) {
            // a size-1 axis does not constrain its own stride
            if (dims.get(i) > 1) {
                if (strides.get(i) != want.get(i)) { return false }
            }
        }
    }
    if (dims.get(n - 1) > 1) {
        if (strides.get(n - 1) != 1) { return false }
    }
    return true
}

// Element offset of a coordinate, -1 when the coordinate does not match the rank or is out of
// bounds in any axis. (Strided, so it is the same expression for a view and for a fresh
// tensor — which is what makes views cheap.)
share(all) tt_offset_of(dims<Vec<Int>>, strides<Vec<Int>>, coords<Vec<Int>>)<Int> -> {
    n<Int> = dims.len()
    if (n != strides.len()) { return -1 }
    if (n != coords.len()) { return -1 }
    off<Int> = 0
    i<Int> = 0
    for (i in 0..n - 1) {
        c<Int> = coords.get(i)
        if (c < 0) { return -1 }
        if (c >= dims.get(i)) { return -1 }
        off = off + c * strides.get(i)
    }
    return off
}

// ─────────────────────────── broadcasting (numpy's rules) ───────────────────────────

// Can these two shapes broadcast? Equal dims align, a 1 expands, a missing leading dim is 1.
share(all) tt_bcastable(a<Vec<Int>>, b<Vec<Int>>)<Bool> -> {
    la<Int> = a.len()
    lb<Int> = b.len()
    n<Int> = la
    if (lb > n) { n = lb }
    if (n == 0) { return true }
    i<Int> = 0
    for (i in 0..n - 1) {
        da<Int> = 1
        db<Int> = 1
        if (i < la) { da = a.get(la - 1 - i) }
        if (i < lb) { db = b.get(lb - 1 - i) }
        if (da != db) {
            if (da != 1) {
                if (db != 1) { return false }
            }
        }
    }
    return true
}

// The result shape. Rank 0 when either input refuses to broadcast — the caller must check
// tt_bcastable() first; an empty vector is the refusal signal, not a valid scalar.
share(all) tt_bcast_shape(a<Vec<Int>>, b<Vec<Int>>)<Vec<Int>> -> {
    out<Vec<Int>> = Vec()
    if (!tt_bcastable(a, b)) { return out }
    la<Int> = a.len()
    lb<Int> = b.len()
    n<Int> = la
    if (lb > n) { n = lb }
    if (n == 0) { return out }
    rev<Vec<Int>> = Vec()
    i<Int> = 0
    for (i in 0..n - 1) {
        da<Int> = 1
        db<Int> = 1
        if (i < la) { da = a.get(la - 1 - i) }
        if (i < lb) { db = b.get(lb - 1 - i) }
        d<Int> = da
        if (db > d) { d = db }
        rev.push(d)
    }
    k<Int> = 0
    for (k in 0..n - 1) { out.push(rev.get(n - 1 - k)) }
    return out
}

// The strides that view `dims` as `out_shape`: right-aligned, and ZERO on every axis whose
// source dimension is 1 — numpy's rule even when the target axis happens to be 1 as well
// (np.broadcast_to reports 0 there), and the reason a broadcast axis reads the same element
// again. Returns an empty vector when the view is not possible.
share(all) tt_bcast_strides(dims<Vec<Int>>, strides<Vec<Int>>, out_shape<Vec<Int>>)<Vec<Int>> -> {
    n<Int> = dims.len()
    m<Int> = out_shape.len()
    res<Vec<Int>> = Vec()
    if (n != strides.len()) { return res }
    if (m < n) { return res }
    if (m == 0) { return res }
    rev<Vec<Int>> = Vec()
    i<Int> = 0
    for (i in 0..m - 1) {
        od<Int> = out_shape.get(m - 1 - i)
        if (i < n) {
            sd<Int> = dims.get(n - 1 - i)
            st<Int> = strides.get(n - 1 - i)
            if (sd == 1) { rev.push(0) } else {
                if (sd == od) { rev.push(st) } else { return Vec() }
            }
        } else {
            rev.push(0)      // a leading axis the source does not have
        }
    }
    k<Int> = 0
    for (k in 0..m - 1) { res.push(rev.get(m - 1 - k)) }
    return res
}

// ─────────────────────────── printing (for probes and logs) ───────────────────────────

share(all) tt_print_vec(label<String>, v<Vec<Int>>) -> {
    if (v.len() == 0) { println(label + "=empty") } else {
        s<String> = ""
        i<Int> = 0
        for (i in 0..v.len() - 1) {
            if (i > 0) { s = s + "," }
            s = s + v.get(i).to_string()
        }
        println(label + "=" + s)
    }
}

share(all) tt_print(t<TT>) -> {
    println("TT_NAME=" + t.name)
    println("TT_DTYPE=" + tt_dtype_name(t.dtype))
    tt_print_vec("TT_DIMS", t.dims)
    tt_print_vec("TT_STRIDES", t.strides)
    println("TT_NUMEL=" + tt_numel(t.dims).to_string())
    println("TT_NBYTES=" + tt_nbytes(t.dims, t.dtype).to_string())
    if (tt_is_contig(t.dims, t.strides)) { println("TT_CONTIG=1") } else { println("TT_CONTIG=0") }
}
