// G-gguf-data slice: parse the GGUF tensor index to locate tensor 't2' (Q4_0),
// read its 18-byte block from the file, copy to device memory, dequantize
// on-GPU with deq_q4_0, and verify every element vs the fixture's known values
// ((nibble-8)*1.0). Vyb-native GPU path; no Python in the runtime.
import io::{open_read, read_all}

extern "C" {
    cuInit(flags<CUInt>)<CInt>
    cuDeviceGetCount(count<loc<CInt>>)<CInt>
    cuDeviceGet(device<loc<CInt>>, ordinal<CInt>)<CInt>
    cuCtxCreate_v2(pctx<loc<loc<CVoid>>>, flags<CUInt>, dev<CInt>)<CInt>
    cuModuleLoadData(hmod<loc<loc<CVoid>>>, image<CString>)<CInt>
    cuModuleGetFunction(hfunc<loc<loc<CVoid>>>, hmod<loc<CVoid>>, name<CString>)<CInt>
    cuMemAlloc_v2(dptr<loc<Int>>, bytesize<Int>)<CInt>
    cuMemcpyHtoD_v2(dstDevice<Int>, srcHost<loc<CVoid>>, ByteCount<Int>)<CInt>
    cuMemcpyDtoH_v2(dstHost<loc<CVoid>>, srcDevice<Int>, ByteCount<Int>)<CInt>
    cuMemFree_v2(dptr<Int>)<CInt>
    cuCtxSynchronize()<CInt>
    cuda_launch4i(f<loc<CVoid>>, gridX<CUInt>, gridY<CUInt>, gridZ<CUInt>,
                  blockX<CUInt>, blockY<CUInt>, blockZ<CUInt>,
                  a0<Int>, a1<Int>, a2<Int>, a3<Int>)<CInt>
}

u8v(s<String>, off<Int>)<Int> -> {
    return (s.char_at(off) as Int) & 255
}
u32le(s<String>, off<Int>)<Int> -> {
    return u8v(s, off) | (u8v(s, off + 1) << 8) | (u8v(s, off + 2) << 16) | (u8v(s, off + 3) << 24)
}
u64le(s<String>, off<Int>)<Int> -> {
    return u8v(s, off) | (u8v(s, off + 1) << 8) | (u8v(s, off + 2) << 16) | (u8v(s, off + 3) << 24) |
           (u8v(s, off + 4) << 32) | (u8v(s, off + 5) << 40) | (u8v(s, off + 6) << 48) | (u8v(s, off + 7) << 56)
}

main()<Int> -> {
    data<String> = ""
    match (open_read("native/gguf/test.gguf")) {
        f -> { match (read_all(f)) { g -> { data = g } ? -> { return 13 } } }
        ? -> { return 13 }
    }
    ver<Int> = u32le(data, 4)
    nti<Int> = u64le(data, 8)
    nkv<Int> = u64le(data, 16)
    off<Int> = 24
    # skip metadata kv (first: string key, u32 type=8, string val)
    klen<Int> = u64le(data, off)
    off = off + 8 + klen
    off = off + 4
    vlen<Int> = u64le(data, off)
    off = off + 8 + vlen
    # scan tensor infos; remember the last one's offset + type (the fixture's
    # final tensor is t2 = Q4_0)
    toff<Int> = 0
    ty<Int> = 0
    t<Int> = 0
    for (t in 0..nti - 1) {
        nl<Int> = u64le(data, off)
        off = off + 8 + nl
        nd<Int> = u32le(data, off)
        off = off + 4
        d2<Int> = 0
        for (d2 in 0..nd - 1) { off = off + 8 }
        ty = u32le(data, off)
        off = off + 4
        toff = u64le(data, off)
        off = off + 8
    }

    # read 18 bytes of Q4_0 block data at toff
    qb<Vec<Int>> = Vec()
    b0<Int> = 0
    for (b0 in 0..17) { qb.push(u8v(data, toff + b0)) }

    freedom {
        if (cuInit(0) != 0) { println("SKIP: no CUDA"); return 0 }
        var<CInt> ndev = 0
        if (cuDeviceGetCount(loc(ndev)) != 0 || ndev < 1) { println("SKIP: no CUDA device"); return 0 }
        var<CInt> dev = 0
        if (cuDeviceGet(loc(dev), 0) != 0) { return 14 }
        ctx<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuCtxCreate_v2(loc(ctx), 0, dev) != 0) { return 14 }
    }

    ptx<String> = ""
    match (open_read("native/build/deq.ptx")) {
        f -> { match (read_all(f)) { g -> { ptx = g } ? -> { return 13 } } }
        ? -> { return 13 }
    }

    freedom {
        hmod<loc<CVoid>> = from<loc<CVoid>>(0)
        lrc<CInt> = cuModuleLoadData(loc(hmod), ptx)
        if (lrc != 0) {
            ptx2<String> = ""
            match (open_read("native/build/deq.ptx")) { f -> { match (read_all(f)) { g -> { ptx2 = g } ? -> { return 20 } } } ? -> { return 20 } }
            hmod = from<loc<CVoid>>(0)
            lrc = cuModuleLoadData(loc(hmod), ptx2)
        }
        if (lrc != 0) { return 9 }
        hf<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(hf), hmod, "q4deq") != 0) { return 10 }

        qd<Int> = 0
        od<Int> = 0
        if (cuMemAlloc_v2(loc(qd), 18) != 0) { return 11 }
        if (cuMemAlloc_v2(loc(od), 32 * 8) != 0) { return 11 }

        pb<Int> = 0
        for (pb in 0..17) {
            by<Int> = qb.get(pb)
            if (cuMemcpyHtoD_v2(qd + pb, loc(by), 1) != 0) { return 15 }
        }

        rc<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(hf)), 1, 1, 1, 256, 1, 1, qd, od, 32, 0)
        if (rc != 0) { println("launch rc "); println_int(rc); return 12 }
        cuCtxSynchronize()

        bad<Int> = 0
        i2<Int> = 0
        for (i2 in 0..31) {
            rv<Float> = 0.0
            if (cuMemcpyDtoH_v2(loc(rv), od + i2 * 8, 8) != 0) { return 16 }
            exp2<Float> = (i2 % 16 - 8) as Float
            d3<Float> = rv - exp2
            if (d3 < 0.0) { d3 = 0.0 - d3 }
            if (d3 > 0.000001) { bad = bad + 1 }
        }

        cuMemFree_v2(qd)
        cuMemFree_v2(od)

        println("Q4_0 DEQUANT bad=")
        println_int(bad)
        println(" (tensor t2 off=")
        println_int(toff)
        println(" ty=")
        println_int(ty)
        println(")")
        if (bad != 0) { return 1 }
        println("DEQUANT_OK")
        return 0
    }
}
