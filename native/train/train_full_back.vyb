                    cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(D),8); cuMemcpyHtoD_v2(DGP+40,loc(EPS),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dnw)),(D+255)/256,1,1,256,1,1,DGP,0,0,0)   # dnormw
                    cuMemcpyHtoD_v2(PB+0,loc(DX1),8); cuMemcpyHtoD_v2(PB+8,loc(dX1la),8); cuMemcpyHtoD_v2(PB+16,loc(ONE2),8); cuMemcpyHtoD_v2(PB+24,loc(S*D),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(ads)),(S*D+255)/256,1,1,256,1,1,PB,0,0,0)   # DX1 += dX1la
                    # 8) o proj: dctx2 = do@Wo^T + lora,  do = DX1
                    cuMemcpyHtoD_v2(PB+0,loc(gvo),8); cuMemcpyHtoD_v2(PB+8,loc(DX1),8); cuMemcpyHtoD_v2(PB+16,loc(AR2),8); cuMemcpyHtoD_v2(PB+24,loc(S*D),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(sc2)),(S*D+255)/256,1,1,256,1,1,PB,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(gvo),8); cuMemcpyHtoD_v2(DGP+8,loc(Vo),8); cuMemcpyHtoD_v2(DGP+16,loc(ds_o2),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(R2),8); cuMemcpyHtoD_v2(DGP+40,loc(D),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dga)),(SR+255)/256,1,1,256,1,1,DGP,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(DCtx),8); cuMemcpyHtoD_v2(DGP+8,loc(ds_o2),8); cuMemcpyHtoD_v2(DGP+16,loc(dU_o2),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(NQ),8); cuMemcpyHtoD_v2(DGP+40,loc(R2),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dgb)),(NQ*R2+255)/256,1,1,256,1,1,DGP,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(so),8); cuMemcpyHtoD_v2(DGP+8,loc(gvo),8); cuMemcpyHtoD_v2(DGP+16,loc(dV_o2),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(R2),8); cuMemcpyHtoD_v2(DGP+40,loc(D),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dgb)),(R2*D+255)/256,1,1,256,1,1,DGP,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(ds_o2),8); cuMemcpyHtoD_v2(DGP+8,loc(Uo),8); cuMemcpyHtoD_v2(DGP+16,loc(dxlo),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(NQ),8); cuMemcpyHtoD_v2(DGP+40,loc(R2),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dga)),(SNQ+255)/256,1,1,256,1,1,DGP,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(DX1),8); cuMemcpyHtoD_v2(DGP+8,loc(Wo),8); cuMemcpyHtoD_v2(DGP+16,loc(dxbo),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(NQ),8); cuMemcpyHtoD_v2(DGP+40,loc(D),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dga)),(SNQ+255)/256,1,1,256,1,1,DGP,0,0,0)
                    cuda_launch4i(from<loc<CVoid>>(addr(zbf)),(SNQ+255)/256,1,1,256,1,1,dCtx2,SNQ,0,0)  # zero dCtx2
                    cuMemcpyHtoD_v2(PB+0,loc(dCtx2),8); cuMemcpyHtoD_v2(PB+8,loc(dxbo),8); cuMemcpyHtoD_v2(PB+16,loc(ONE2),8); cuMemcpyHtoD_v2(PB+24,loc(SNQ),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(ads)),(SNQ+255)/256,1,1,256,1,1,PB,0,0,0)   # dCtx2 += dxbo
                    cuMemcpyHtoD_v2(PB+0,loc(dCtx2),8); cuMemcpyHtoD_v2(PB+8,loc(dxlo),8); cuMemcpyHtoD_v2(PB+16,loc(ONE2),8); cuMemcpyHtoD_v2(PB+24,loc(SNQ),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(ads)),(SNQ+255)/256,1,1,256,1,1,PB,0,0,0)  # dCtx2 += dxlo
                    # 9) attention backward (zero dKr2,dVu2 first)
                    cuda_launch4i(from<loc<CVoid>>(addr(zbf)),(SNKV+255)/256,1,1,256,1,1,dKr2,SNKV,0,0)
                    cuda_launch4i(from<loc<CVoid>>(addr(zbf)),(SNKV+255)/256,1,1,256,1,1,dVu2,SNKV,0,0)
                    cuMemcpyHtoD_v2(ATT+80,loc(DQr),8); cuMemcpyHtoD_v2(ATT+88,loc(DKr),8); cuMemcpyHtoD_v2(ATT+96,loc(DV),8); cuMemcpyHtoD_v2(ATT+104,loc(dCtx2),8)
                    cuMemcpyHtoD_v2(ATT+112,loc(dQr2),8); cuMemcpyHtoD_v2(ATT+120,loc(dKr2),8); cuMemcpyHtoD_v2(ATT+128,loc(dVu2),8)
                    cuMemcpyHtoD_v2(ATT+184,loc(S),8); cuMemcpyHtoD_v2(ATT+200,loc(HD),8); cuMemcpyHtoD_v2(ATT+208,loc(H),8); cuMemcpyHtoD_v2(ATT+216,loc(KVH),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dat2)),(S*H+255)/256,1,1,256,1,1,ATT,0,0,0)
                    # 10) rope adjoint
                    cuMemcpyHtoD_v2(ROP+80,loc(dQr2),8); cuMemcpyHtoD_v2(ROP+88,loc(dKr2),8); cuMemcpyHtoD_v2(ROP+96,loc(dQn2),8); cuMemcpyHtoD_v2(ROP+104,loc(dKn2),8)
                    cuMemcpyHtoD_v2(ROP+176,loc(DF),8); cuMemcpyHtoD_v2(ROP+184,loc(S),8); cuMemcpyHtoD_v2(ROP+200,loc(HD),8)
                    cuMemcpyHtoD_v2(ROP+208,loc(H),8); cuMemcpyHtoD_v2(ROP+216,loc(KVH),8); cuMemcpyHtoD_v2(ROP+224,loc(POS),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(drp)),(SHP*HD+SKP*HD+255)/256,1,1,256,1,1,ROP,0,0,0)
                    # 11) q,norm,k,norm backward
                    cuMemcpyHtoD_v2(GM+0,loc(DQ),8); cuMemcpyHtoD_v2(GM+8,loc(Nq),8); cuMemcpyHtoD_v2(GM+16,loc(dQn2),8)
                    cuMemcpyHtoD_v2(GM+24,loc(dq2),8); cuMemcpyHtoD_v2(GM+32,loc(dNqb),8)
                    cuMemcpyHtoD_v2(GM+40,loc(SHP),8); cuMemcpyHtoD_v2(GM+48,loc(HD),8); cuMemcpyHtoD_v2(GM+56,loc(EPS),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(drn)),(SHP*HD+255)/256,1,1,256,1,1,GM,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(DQ),8); cuMemcpyHtoD_v2(DGP+8,loc(dQn2),8); cuMemcpyHtoD_v2(DGP+16,loc(dNqb),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(SHP),8); cuMemcpyHtoD_v2(DGP+32,loc(HD),8); cuMemcpyHtoD_v2(DGP+40,loc(EPS),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dnw)),(HD+255)/256,1,1,256,1,1,DGP,0,0,0)
                    cuMemcpyHtoD_v2(GM+0,loc(DK),8); cuMemcpyHtoD_v2(GM+8,loc(Nk),8); cuMemcpyHtoD_v2(GM+16,loc(dKn2),8)
                    cuMemcpyHtoD_v2(GM+24,loc(dk2),8); cuMemcpyHtoD_v2(GM+32,loc(dNkb),8)
                    cuMemcpyHtoD_v2(GM+40,loc(SKP),8); cuMemcpyHtoD_v2(GM+48,loc(HD),8); cuMemcpyHtoD_v2(GM+56,loc(EPS),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(drn)),(SKP*HD+255)/256,1,1,256,1,1,GM,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(DK),8); cuMemcpyHtoD_v2(DGP+8,loc(dKn2),8); cuMemcpyHtoD_v2(DGP+16,loc(dNkb),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(SKP),8); cuMemcpyHtoD_v2(DGP+32,loc(HD),8); cuMemcpyHtoD_v2(DGP+40,loc(EPS),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dnw)),(HD+255)/256,1,1,256,1,1,DGP,0,0,0)
                    # 12) q,k,v proj backward -> dXN
                    cuMemcpyHtoD_v2(PB+0,loc(gvq),8); cuMemcpyHtoD_v2(PB+8,loc(dq2),8); cuMemcpyHtoD_v2(PB+16,loc(AR2),8); cuMemcpyHtoD_v2(PB+24,loc(SNQ),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(sc2)),(SNQ+255)/256,1,1,256,1,1,PB,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(gvq),8); cuMemcpyHtoD_v2(DGP+8,loc(Vq),8); cuMemcpyHtoD_v2(DGP+16,loc(ds_q),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(R2),8); cuMemcpyHtoD_v2(DGP+40,loc(NQ),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dga)),(SR+255)/256,1,1,256,1,1,DGP,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(XN),8); cuMemcpyHtoD_v2(DGP+8,loc(ds_q),8); cuMemcpyHtoD_v2(DGP+16,loc(dU_q2),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(D),8); cuMemcpyHtoD_v2(DGP+40,loc(R2),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dgb)),(D*R2+255)/256,1,1,256,1,1,DGP,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(sq),8); cuMemcpyHtoD_v2(DGP+8,loc(gvq),8); cuMemcpyHtoD_v2(DGP+16,loc(dV_q2),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(R2),8); cuMemcpyHtoD_v2(DGP+40,loc(NQ),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dgb)),(R2*NQ+255)/256,1,1,256,1,1,DGP,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(ds_q),8); cuMemcpyHtoD_v2(DGP+8,loc(Uq),8); cuMemcpyHtoD_v2(DGP+16,loc(dxlq),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(D),8); cuMemcpyHtoD_v2(DGP+40,loc(R2),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dga)),(S*D+255)/256,1,1,256,1,1,DGP,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(dq2),8); cuMemcpyHtoD_v2(DGP+8,loc(Wq),8); cuMemcpyHtoD_v2(DGP+16,loc(dxbq),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(D),8); cuMemcpyHtoD_v2(DGP+40,loc(NQ),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dga)),(S*D+255)/256,1,1,256,1,1,DGP,0,0,0)
                    # k proj
                    cuMemcpyHtoD_v2(PB+0,loc(gvk),8); cuMemcpyHtoD_v2(PB+8,loc(dk2),8); cuMemcpyHtoD_v2(PB+16,loc(AR2),8); cuMemcpyHtoD_v2(PB+24,loc(SNKV),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(sc2)),(SNKV+255)/256,1,1,256,1,1,PB,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(gvk),8); cuMemcpyHtoD_v2(DGP+8,loc(Vk),8); cuMemcpyHtoD_v2(DGP+16,loc(ds_k),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(R2),8); cuMemcpyHtoD_v2(DGP+40,loc(NKV),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dga)),(SR+255)/256,1,1,256,1,1,DGP,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(XN),8); cuMemcpyHtoD_v2(DGP+8,loc(ds_k),8); cuMemcpyHtoD_v2(DGP+16,loc(dU_k2),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(D),8); cuMemcpyHtoD_v2(DGP+40,loc(R2),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dgb)),(D*R2+255)/256,1,1,256,1,1,DGP,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(sk),8); cuMemcpyHtoD_v2(DGP+8,loc(gvk),8); cuMemcpyHtoD_v2(DGP+16,loc(dV_k2),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(R2),8); cuMemcpyHtoD_v2(DGP+40,loc(NKV),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dgb)),(R2*NKV+255)/256,1,1,256,1,1,DGP,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(ds_k),8); cuMemcpyHtoD_v2(DGP+8,loc(Uk),8); cuMemcpyHtoD_v2(DGP+16,loc(dxlk),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(D),8); cuMemcpyHtoD_v2(DGP+40,loc(R2),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dga)),(S*D+255)/256,1,1,256,1,1,DGP,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(dk2),8); cuMemcpyHtoD_v2(DGP+8,loc(Wk),8); cuMemcpyHtoD_v2(DGP+16,loc(dxbk),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(D),8); cuMemcpyHtoD_v2(DGP+40,loc(NKV),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dga)),(S*D+255)/256,1,1,256,1,1,DGP,0,0,0)
                    # v proj (use dVu2 as dout)
                    cuMemcpyHtoD_v2(PB+0,loc(gvv),8); cuMemcpyHtoD_v2(PB+8,loc(dVu2),8); cuMemcpyHtoD_v2(PB+16,loc(AR2),8); cuMemcpyHtoD_v2(PB+24,loc(SNKV),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(sc2)),(SNKV+255)/256,1,1,256,1,1,PB,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(gvv),8); cuMemcpyHtoD_v2(DGP+8,loc(Vv),8); cuMemcpyHtoD_v2(DGP+16,loc(ds_v),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(R2),8); cuMemcpyHtoD_v2(DGP+40,loc(NKV),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dga)),(SR+255)/256,1,1,256,1,1,DGP,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(XN),8); cuMemcpyHtoD_v2(DGP+8,loc(ds_v),8); cuMemcpyHtoD_v2(DGP+16,loc(dU_v2),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(D),8); cuMemcpyHtoD_v2(DGP+40,loc(R2),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dgb)),(D*R2+255)/256,1,1,256,1,1,DGP,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(sv),8); cuMemcpyHtoD_v2(DGP+8,loc(gvv),8); cuMemcpyHtoD_v2(DGP+16,loc(dV_v2),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(R2),8); cuMemcpyHtoD_v2(DGP+40,loc(NKV),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dgb)),(R2*NKV+255)/256,1,1,256,1,1,DGP,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(ds_v),8); cuMemcpyHtoD_v2(DGP+8,loc(Uv),8); cuMemcpyHtoD_v2(DGP+16,loc(dxlv),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(D),8); cuMemcpyHtoD_v2(DGP+40,loc(R2),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dga)),(S*D+255)/256,1,1,256,1,1,DGP,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(dVu2),8); cuMemcpyHtoD_v2(DGP+8,loc(Wv),8); cuMemcpyHtoD_v2(DGP+16,loc(dxbv),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(D),8); cuMemcpyHtoD_v2(DGP+40,loc(NKV),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dga)),(S*D+255)/256,1,1,256,1,1,DGP,0,0,0)
                    # accumulate dXN = q+k+v (dxbq,dxbk,dxbv + dxl*)
                    cuda_launch4i(from<loc<CVoid>>(addr(zbf)),(S*D+255)/256,1,1,256,1,1,dXN2,S*D,0,0)  # zero dXN2
                    cuMemcpyHtoD_v2(PB+0,loc(dXN2),8); cuMemcpyHtoD_v2(PB+8,loc(dxbq),8); cuMemcpyHtoD_v2(PB+16,loc(ONE2),8); cuMemcpyHtoD_v2(PB+24,loc(S*D),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(ads)),(S*D+255)/256,1,1,256,1,1,PB,0,0,0)   # dXN2 += dxbq
                    cuMemcpyHtoD_v2(PB+0,loc(dXN2),8); cuMemcpyHtoD_v2(PB+8,loc(dxlq),8); cuMemcpyHtoD_v2(PB+16,loc(ONE2),8); cuMemcpyHtoD_v2(PB+24,loc(S*D),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(ads)),(S*D+255)/256,1,1,256,1,1,PB,0,0,0)
                    cuMemcpyHtoD_v2(PB+0,loc(dXN2),8); cuMemcpyHtoD_v2(PB+8,loc(dxbk),8); cuMemcpyHtoD_v2(PB+16,loc(ONE2),8); cuMemcpyHtoD_v2(PB+24,loc(S*D),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(ads)),(S*D+255)/256,1,1,256,1,1,PB,0,0,0)
                    cuMemcpyHtoD_v2(PB+0,loc(dXN2),8); cuMemcpyHtoD_v2(PB+8,loc(dxlk),8); cuMemcpyHtoD_v2(PB+16,loc(ONE2),8); cuMemcpyHtoD_v2(PB+24,loc(S*D),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(ads)),(S*D+255)/256,1,1,256,1,1,PB,0,0,0)
                    cuMemcpyHtoD_v2(PB+0,loc(dXN2),8); cuMemcpyHtoD_v2(PB+8,loc(dxbv),8); cuMemcpyHtoD_v2(PB+16,loc(ONE2),8); cuMemcpyHtoD_v2(PB+24,loc(S*D),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(ads)),(S*D+255)/256,1,1,256,1,1,PB,0,0,0)
                    cuMemcpyHtoD_v2(PB+0,loc(dXN2),8); cuMemcpyHtoD_v2(PB+8,loc(dxlv),8); cuMemcpyHtoD_v2(PB+16,loc(ONE2),8); cuMemcpyHtoD_v2(PB+24,loc(S*D),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(ads)),(S*D+255)/256,1,1,256,1,1,PB,0,0,0)
                    # 13) input rmsnorm backward -> dx
                    cuMemcpyHtoD_v2(GM+0,loc(x),8); cuMemcpyHtoD_v2(GM+8,loc(N1),8); cuMemcpyHtoD_v2(GM+16,loc(dXN2),8)
                    cuMemcpyHtoD_v2(GM+24,loc(dX1la),8); cuMemcpyHtoD_v2(GM+32,loc(dN1b),8)
                    cuMemcpyHtoD_v2(GM+40,loc(S),8); cuMemcpyHtoD_v2(GM+48,loc(D),8); cuMemcpyHtoD_v2(GM+56,loc(EPS),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(drn)),(S*D+255)/256,1,1,256,1,1,GM,0,0,0)
                    cuMemcpyHtoD_v2(DGP+0,loc(x),8); cuMemcpyHtoD_v2(DGP+8,loc(dXN2),8); cuMemcpyHtoD_v2(DGP+16,loc(dN1b),8)
                    cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(D),8); cuMemcpyHtoD_v2(DGP+40,loc(EPS),8)
                    cuda_launch4i(from<loc<CVoid>>(addr(dnw)),(D+255)/256,1,1,256,1,1,DGP,0,0,0)
                    cuCtxSynchronize()
            e=dumpf(dU_q2,5120,"native/out/m2e_L"+L.to_string()+"_Uq_vyb.txt"); if(e!=0){ return 90 }
            e=dumpf(dV_q2,8192,"native/out/m2e_L"+L.to_string()+"_Vq_vyb.txt"); if(e!=0){ return 90 }
            e=dumpf(dU_k2,5120,"native/out/m2e_L"+L.to_string()+"_Uk_vyb.txt"); if(e!=0){ return 90 }
            e=dumpf(dV_k2,2048,"native/out/m2e_L"+L.to_string()+"_Vk_vyb.txt"); if(e!=0){ return 90 }
            e=dumpf(dU_v2,5120,"native/out/m2e_L"+L.to_string()+"_Uv_vyb.txt"); if(e!=0){ return 90 }
            e=dumpf(dV_v2,2048,"native/out/m2e_L"+L.to_string()+"_Vv_vyb.txt"); if(e!=0){ return 90 }
            e=dumpf(dU_o2,8192,"native/out/m2e_L"+L.to_string()+"_Uo_vyb.txt"); if(e!=0){ return 90 }
            e=dumpf(dV_o2,5120,"native/out/m2e_L"+L.to_string()+"_Vo_vyb.txt"); if(e!=0){ return 90 }
            e=dumpf(dU_g2,5120,"native/out/m2e_L"+L.to_string()+"_Ug_vyb.txt"); if(e!=0){ return 90 }
            e=dumpf(dV_g2,19456,"native/out/m2e_L"+L.to_string()+"_Vg_vyb.txt"); if(e!=0){ return 90 }
            e=dumpf(dU_u2,5120,"native/out/m2e_L"+L.to_string()+"_Uu_vyb.txt"); if(e!=0){ return 90 }
            e=dumpf(dV_u2,19456,"native/out/m2e_L"+L.to_string()+"_Vu_vyb.txt"); if(e!=0){ return 90 }
            e=dumpf(dU_d2,19456,"native/out/m2e_L"+L.to_string()+"_Ud_vyb.txt"); if(e!=0){ return 90 }
            e=dumpf(dV_d2,5120,"native/out/m2e_L"+L.to_string()+"_Vd_vyb.txt"); if(e!=0){ return 90 }
            e=dumpf(dX1la,S*D,"native/out/m2e_L"+L.to_string()+"_dx_vyb.txt"); if(e!=0){ return 90 }
            i2<Int> = 0; fv<Float> = 0.0
            for (i2 in 0..S*D-1){ fv=0.0; cuMemcpyDtoH_v2(loc(fv),dX1la+i2*8,8); cuMemcpyHtoD_v2(DG+i2*8,loc(fv),8) }
            cuCtxSynchronize()
            println("M2E bwd layer "+L.to_string()+" done")
        }
        println("M2E2_DONE layers="+MAXL.to_string())
        return 0
    }
    return 0
}
