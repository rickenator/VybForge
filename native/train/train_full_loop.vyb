            cuda_launch4i(from<loc<CVoid>>(addr(aw2)),(5120+255)/256,1,1,256,1,1,AW,0,0,0)
            cuMemcpyHtoD_v2(AW+0,loc(LSLB+Lb*917504+327680),8); cuMemcpyHtoD_v2(AW+8,loc(dU_g2),8)
            cuMemcpyHtoD_v2(AW+16,loc(MSLB+Lb*917504+327680),8); cuMemcpyHtoD_v2(AW+24,loc(VSLB+Lb*917504+327680),8)
            cuMemcpyHtoD_v2(AW+32,loc(LR),8); cuMemcpyHtoD_v2(AW+40,loc(B1),8); cuMemcpyHtoD_v2(AW+48,loc(B2),8); cuMemcpyHtoD_v2(AW+56,loc(EPP),8)
            cuMemcpyHtoD_v2(AW+64,loc(WDD),8); cuMemcpyHtoD_v2(AW+72,loc(b1tc),8); cuMemcpyHtoD_v2(AW+80,loc(b2tc),8); cuMemcpyHtoD_v2(AW+88,loc(5120),8)
            cuda_launch4i(from<loc<CVoid>>(addr(aw2)),(5120+255)/256,1,1,256,1,1,AW,0,0,0)
            cuMemcpyHtoD_v2(AW+0,loc(LSLB+Lb*917504+368640),8); cuMemcpyHtoD_v2(AW+8,loc(dV_g2),8)
            cuMemcpyHtoD_v2(AW+16,loc(MSLB+Lb*917504+368640),8); cuMemcpyHtoD_v2(AW+24,loc(VSLB+Lb*917504+368640),8)
            cuMemcpyHtoD_v2(AW+32,loc(LR),8); cuMemcpyHtoD_v2(AW+40,loc(B1),8); cuMemcpyHtoD_v2(AW+48,loc(B2),8); cuMemcpyHtoD_v2(AW+56,loc(EPP),8)
            cuMemcpyHtoD_v2(AW+64,loc(WDD),8); cuMemcpyHtoD_v2(AW+72,loc(b1tc),8); cuMemcpyHtoD_v2(AW+80,loc(b2tc),8); cuMemcpyHtoD_v2(AW+88,loc(19456),8)
            cuda_launch4i(from<loc<CVoid>>(addr(aw2)),(19456+255)/256,1,1,256,1,1,AW,0,0,0)
            cuMemcpyHtoD_v2(AW+0,loc(LSLB+Lb*917504+524288),8); cuMemcpyHtoD_v2(AW+8,loc(dU_u2),8)
            cuMemcpyHtoD_v2(AW+16,loc(MSLB+Lb*917504+524288),8); cuMemcpyHtoD_v2(AW+24,loc(VSLB+Lb*917504+524288),8)
            cuMemcpyHtoD_v2(AW+32,loc(LR),8); cuMemcpyHtoD_v2(AW+40,loc(B1),8); cuMemcpyHtoD_v2(AW+48,loc(B2),8); cuMemcpyHtoD_v2(AW+56,loc(EPP),8)
            cuMemcpyHtoD_v2(AW+64,loc(WDD),8); cuMemcpyHtoD_v2(AW+72,loc(b1tc),8); cuMemcpyHtoD_v2(AW+80,loc(b2tc),8); cuMemcpyHtoD_v2(AW+88,loc(5120),8)
            cuda_launch4i(from<loc<CVoid>>(addr(aw2)),(5120+255)/256,1,1,256,1,1,AW,0,0,0)
            cuMemcpyHtoD_v2(AW+0,loc(LSLB+Lb*917504+565248),8); cuMemcpyHtoD_v2(AW+8,loc(dV_u2),8)
            cuMemcpyHtoD_v2(AW+16,loc(MSLB+Lb*917504+565248),8); cuMemcpyHtoD_v2(AW+24,loc(VSLB+Lb*917504+565248),8)
            cuMemcpyHtoD_v2(AW+32,loc(LR),8); cuMemcpyHtoD_v2(AW+40,loc(B1),8); cuMemcpyHtoD_v2(AW+48,loc(B2),8); cuMemcpyHtoD_v2(AW+56,loc(EPP),8)
            cuMemcpyHtoD_v2(AW+64,loc(WDD),8); cuMemcpyHtoD_v2(AW+72,loc(b1tc),8); cuMemcpyHtoD_v2(AW+80,loc(b2tc),8); cuMemcpyHtoD_v2(AW+88,loc(19456),8)
            cuda_launch4i(from<loc<CVoid>>(addr(aw2)),(19456+255)/256,1,1,256,1,1,AW,0,0,0)
            cuMemcpyHtoD_v2(AW+0,loc(LSLB+Lb*917504+720896),8); cuMemcpyHtoD_v2(AW+8,loc(dU_d2),8)
            cuMemcpyHtoD_v2(AW+16,loc(MSLB+Lb*917504+720896),8); cuMemcpyHtoD_v2(AW+24,loc(VSLB+Lb*917504+720896),8)
            cuMemcpyHtoD_v2(AW+32,loc(LR),8); cuMemcpyHtoD_v2(AW+40,loc(B1),8); cuMemcpyHtoD_v2(AW+48,loc(B2),8); cuMemcpyHtoD_v2(AW+56,loc(EPP),8)
            cuMemcpyHtoD_v2(AW+64,loc(WDD),8); cuMemcpyHtoD_v2(AW+72,loc(b1tc),8); cuMemcpyHtoD_v2(AW+80,loc(b2tc),8); cuMemcpyHtoD_v2(AW+88,loc(19456),8)
            cuda_launch4i(from<loc<CVoid>>(addr(aw2)),(19456+255)/256,1,1,256,1,1,AW,0,0,0)
            cuMemcpyHtoD_v2(AW+0,loc(LSLB+Lb*917504+876544),8); cuMemcpyHtoD_v2(AW+8,loc(dV_d2),8)
            cuMemcpyHtoD_v2(AW+16,loc(MSLB+Lb*917504+876544),8); cuMemcpyHtoD_v2(AW+24,loc(VSLB+Lb*917504+876544),8)
            cuMemcpyHtoD_v2(AW+32,loc(LR),8); cuMemcpyHtoD_v2(AW+40,loc(B1),8); cuMemcpyHtoD_v2(AW+48,loc(B2),8); cuMemcpyHtoD_v2(AW+56,loc(EPP),8)
            cuMemcpyHtoD_v2(AW+64,loc(WDD),8); cuMemcpyHtoD_v2(AW+72,loc(b1tc),8); cuMemcpyHtoD_v2(AW+80,loc(b2tc),8); cuMemcpyHtoD_v2(AW+88,loc(5120),8)
            cuda_launch4i(from<loc<CVoid>>(addr(aw2)),(5120+255)/256,1,1,256,1,1,AW,0,0,0)

        }
        # ---- chain dx -> dG for next (lower) layer ----
        # (dG already correct: next iteration reads dG; forward recomputes activations each step
        #  so backward uses its OWN per-layer cached activations + current LoRA. dx from bwd is
        #  already chained inside the block via dX1la -> but here we recompute forward each step,
        #  so dG must be the fresh output grad for THIS step, which it is (set once before bwd).)
        stp_d = stp_d + 1
        }
        # ---- write per-step losses ----

        # ---- dump representative final Adapters + moments (parity gate) ----
        SELN<Int> = 3
        SELV<Vec<Int>> = Vec()
        SELV.push(0); SELV.push(17); SELV.push(35)
        sj<Int> = 0
        for (sj in 0..SELN-1){
            LL<Int> = SELV.get(sj)
            # Uq slice (5120 f64 = 40960 B at LORA_BYTES*LL + 0); dump first 128 f64
            e=dumpf(LSLB+LL*917504+0,128,"native/out/m2e3_L"+LL.to_string()+"_Uq_U_final_vyb.txt"); if(e!=0){ return 92 }
            e=dumpf(LSLB+LL*917504+40960,128,"native/out/m2e3_L"+LL.to_string()+"_Vq_V_final_vyb.txt"); if(e!=0){ return 92 }
            e=dumpf(MSLB+LL*917504+0,128,"native/out/m2e3_L"+LL.to_string()+"_Uq_mU_vyb.txt"); if(e!=0){ return 92 }
            e=dumpf(VSLB+LL*917504+0,128,"native/out/m2e3_L"+LL.to_string()+"_Uq_vU_vyb.txt"); if(e!=0){ return 92 }
            e=dumpf(MSLB+LL*917504+40960,128,"native/out/m2e3_L"+LL.to_string()+"_Vq_mV_vyb.txt"); if(e!=0){ return 92 }
            e=dumpf(VSLB+LL*917504+40960,128,"native/out/m2e3_L"+LL.to_string()+"_Vq_vV_vyb.txt"); if(e!=0){ return 92 }
        }
        freedom { match(open_write("native/out/m2e3_loss.txt")){ w->{ write_str(w,losstr); close(w) } ?->{ return 71 } } }
        println("M2E3_DONE steps="+NSTP.to_string())
        return 0
    }
    return 0
}
