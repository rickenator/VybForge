// STANDALONE Qwen3RoPE isolation: does qwen3rope apply a real rotation for a SINGLE row at
// POS=9 when given a row-offset input/output pointer and S=1? (This is the response-forward usage
// that produces IDENTITY on the real driver.) No weight load -> ~2 min.
import io::{open_read, read_at, read_all, close}
extern "C" {
    cuInit(flags<CUInt>)<CInt>
    cuDeviceGetCount(count<loc<CInt>>)<CInt>
    cuDeviceGet(device<loc<CInt>>, ordinal<CInt>)<CInt>
    cuCtxCreate_v2(pctx<loc<loc<CVoid>>>, flags<CUInt>, dev<CInt>)<CInt>
    cuModuleLoadData(hmod<loc<loc<CVoid>>>, image<CString>)<CInt>
    cuModuleGetFunction(hfunc<loc<loc<CVoid>>>, hmod<loc<CVoid>>, name<CString>)<CInt>
    cuMemAlloc_v2(dptr<loc<Int>>, bytesize<Int>)<CInt>
    cuMemcpyHtoD_v2(dstDevice<Int>, srcHost<loc<CVoid>>, ByteCount<Int>)<CInt>
    cuMemcpyDtoH_v2(dstHost<loc<CVoid>>, srcDevice<Int>, ByteCount<Int>)<CInt>
    cuCtxSynchronize()<CInt>
    cuda_launch4i(f<loc<CVoid>>, gx<CUInt>, gy<CUInt>, gz<CUInt>, bx<CUInt>, by<CUInt>, bz<CUInt>, a0<Int>, a1<Int>, a2<Int>, a3<Int>)<CInt>
}
read_bin(p<String>)<String> -> { r<String> = ""; match(open_read(p)){ f -> { match(read_all(f)){ s -> { r = s } ? -> { r = "" } } close(f) } ? -> { r = "" } }; return r }
main()<Int> -> {
    D<Int> = 2560; H<Int> = 32; HD<Int> = 128; KVH<Int> = 8; NQ<Int> = H * HD; P<Int> = 9; NR<Int> = 16
    freedom { cuInit(0); var<CInt> nd = 0; cuDeviceGetCount(loc(nd)); var<CInt> dv = 0; cuDeviceGet(loc(dv),0); ctx<loc<CVoid>> = from<loc<CVoid>>(0); cuCtxCreate_v2(loc(ctx),0,dv) }
    freedom { rc<CInt> = -1; t4<Int> = 0; m<loc<CVoid>> = from<loc<CVoid>>(0); for(t4 in 0..5){ if(rc != 0){ m = from<loc<CVoid>>(0); rc = cuModuleLoadData(loc(m), read_bin("native/build/train.ptx")) } } }
    if(rc != 0){ println("MODLOAD_FAIL"); return 9 }
    freedom { rp<loc<CVoid>> = from<loc<CVoid>>(0); ROP<Int> = 0; DQN<Int> = 0; DQr<Int> = 0; FR<Int> = 0
        if(cuModuleGetFunction(loc(rp),m,"qwen3rope") != 0){ return 10 }
        if(cuMemAlloc_v2(loc(ROP),232) != 0){ return 11 }
        if(cuMemAlloc_v2(loc(DQN),NR * NQ * 8) != 0){ return 11 }
        if(cuMemAlloc_v2(loc(DQr),NR * NQ * 8) != 0){ return 11 }
        if(cuMemAlloc_v2(loc(FR),2560 * 8) != 0){ return 11 }
        # fill DQN row P = cos(0.01*j) so rotation is obvious; others 0
        kk<Int> = 0; vv<Float> = 0.0
        for(kk in 0..(P * NQ) - 1){ vv = 0.0; if(cuMemcpyHtoD_v2(DQN + kk * 8, loc(vv), 8) != 0){ return 20 } }
        for(kk in (P * NQ)..(P + 1) * NQ - 1){
            vv = 0.0
            jj<Int> = kk - P * NQ
            vv = (jj as Float) * 0.01
            if(cuMemcpyHtoD_v2(DQN + kk * 8, loc(vv), 8) != 0){ return 21 }
        }
        for(kk in (P + 1) * NQ..NR * NQ - 1){ vv = 0.0; if(cuMemcpyHtoD_v2(DQN + kk * 8, loc(vv), 8) != 0){ return 20 } }
        # invfreq pattern: FR[i] = 0.1 (nonzero so a POS offset must rotate)
        fv<Float> = 0.1
        kf<Int> = 0
        for(kf in 0..63){ if(cuMemcpyHtoD_v2(FR + kf * 8, loc(fv), 8) != 0){ return 31 } }
        # ---- CASE A: row-offset + S=1 + POS=P (the driver usage) ----
        dqnP<Int> = DQN + P * NQ * 8; dqrP<Int> = DQr + P * NQ * 8; one<Int> = 1
        cuMemcpyHtoD_v2(ROP + 80, loc(dqnP), 8); cuMemcpyHtoD_v2(ROP + 88, loc(dqnP), 8); cuMemcpyHtoD_v2(ROP + 96, loc(dqrP), 8); cuMemcpyHtoD_v2(ROP + 104, loc(dqrP), 8)
        cuMemcpyHtoD_v2(ROP + 176, loc(FR), 8); cuMemcpyHtoD_v2(ROP + 184, loc(one), 8); cuMemcpyHtoD_v2(ROP + 200, loc(HD), 8); cuMemcpyHtoD_v2(ROP + 208, loc(H), 8); cuMemcpyHtoD_v2(ROP + 216, loc(KVH), 8); cuMemcpyHtoD_v2(ROP + 224, loc(P), 8)
        cuda_launch4i(from<loc<CVoid>>(addr(rp)),(NQ + KVH * HD + 255) / 256,1,1,256,1,1,ROP,0,0,0)
        cuCtxSynchronize()
        f0<Float> = 0.0; o0<Float> = 0.0
        cuMemcpyDtoH_v2(loc(f0), DQN + P * NQ * 8, 8); cuMemcpyDtoH_v2(loc(o0), DQr + P * NQ * 8, 8)
        println("CASE_A row-offset S=1 POS=9: in=" + f0.to_string() + " out=" + o0.to_string() + " (if out==in -> IDENTITY bug)")
    }
    println("PROBE_DONE")
    return 0
}
