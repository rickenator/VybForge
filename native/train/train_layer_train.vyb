        cuMemcpyHtoD_v2(AW+32,loc(LR),8); cuMemcpyHtoD_v2(AW+40,loc(B1),8); cuMemcpyHtoD_v2(AW+48,loc(B2),8); cuMemcpyHtoD_v2(AW+56,loc(EPP),8)
        cuMemcpyHtoD_v2(AW+64,loc(WDD),8); cuMemcpyHtoD_v2(AW+72,loc(b1tc),8); cuMemcpyHtoD_v2(AW+80,loc(b2tc),8); cuMemcpyHtoD_v2(AW+88,loc(R2*NQ),8)
        cuda_launch4i(from<loc<CVoid>>(addr(aw2)),(R2*NQ+255)/256,1,1,256,1,1,AW,0,0,0)
        cuMemcpyHtoD_v2(AW+0,loc(Uk),8); cuMemcpyHtoD_v2(AW+8,loc(dU_k2),8); cuMemcpyHtoD_v2(AW+16,loc(mUk),8); cuMemcpyHtoD_v2(AW+24,loc(vUk),8)
        cuMemcpyHtoD_v2(AW+32,loc(LR),8); cuMemcpyHtoD_v2(AW+40,loc(B1),8); cuMemcpyHtoD_v2(AW+48,loc(B2),8); cuMemcpyHtoD_v2(AW+56,loc(EPP),8)
