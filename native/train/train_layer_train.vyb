        cuda_launch4i(from<loc<CVoid>>(addr(ads)),(S*D+255)/256,1,1,256,1,1,PB,0,0,0)
        cuda_launch4i(from<loc<CVoid>>(addr(rs)),(S*D+255)/256,1,1,256,1,1,X1,M2,XO,S*D)
        cuCtxSynchronize()
        # DG = xo - t (sub) ; host loss readback
        cuda_launch4i(from<loc<CVoid>>(addr(sbb)),(SB+255)/256,1,1,256,1,1,XO,TGT,DG,SB)
        cuCtxSynchronize()
        lv<Float> = 0.0; rl<Int> = 0; rvv<Float> = 0.0
        for (rl in 0..SB-1){ rvv=0.0; cuMemcpyDtoH_v2(loc(rvv),DG+rl*8,8); lv=lv+rvv*rvv }
        lsv<Float> = (0.5 * lv) / (S as Float) / (D as Float)
        println("M2D loss step " + stp_d.to_string() + " = " + lsv.to_string())
        losstr = losstr + lsv.to_string() + "\n"
        # ================= BACKWARD =====================
        SB<Int> = S*D; SF<Int> = S*FF; SNQ<Int> = S*NQ; SNKV<Int> = S*NKV; SR<Int> = S*R
        ONE2<Float> = 1.0; AR2<Float> = 2.0; ZR2<Float> = 0.0
        # 1) residual xo = x1 + m  -> dx1, dm
        rr<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(dres)),(SB+255)/256,1,1,256,1,1,DG,DX1,DM,SB); if(rr!=0){ println("E dres "+ (rr as Int).to_string()); return 90 }
        cuCtxSynchronize()
        # 2) down proj m = Hu@Wd + LoRA_d
        cuMemcpyHtoD_v2(PB+0,loc(gvd),8); cuMemcpyHtoD_v2(PB+8,loc(DM),8); cuMemcpyHtoD_v2(PB+16,loc(AR2),8); cuMemcpyHtoD_v2(PB+24,loc(SB),8)
        rr=cuda_launch4i(from<loc<CVoid>>(addr(sc2)),(SB+255)/256,1,1,256,1,1,PB,0,0,0); if(rr!=0){ println("E sc2 "+ (rr as Int).to_string()); return 90 }   # gvd
        cuMemcpyHtoD_v2(DGP+0,loc(gvd),8); cuMemcpyHtoD_v2(DGP+8,loc(Vd),8); cuMemcpyHtoD_v2(DGP+16,loc(ds_d),8)
        cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(R2),8); cuMemcpyHtoD_v2(DGP+40,loc(D),8)
        rr=cuda_launch4i(from<loc<CVoid>>(addr(dga)),(SR+255)/256,1,1,256,1,1,DGP,0,0,0); if(rr!=0){ println("E dga "+ (rr as Int).to_string()); return 90 }  # ds_d
        cuMemcpyHtoD_v2(DGP+0,loc(Hu),8); cuMemcpyHtoD_v2(DGP+8,loc(ds_d),8); cuMemcpyHtoD_v2(DGP+16,loc(dU_d2),8)
        cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(FF),8); cuMemcpyHtoD_v2(DGP+40,loc(R2),8)
        cuda_launch4i(from<loc<CVoid>>(addr(dgb)),(FF*R2+255)/256,1,1,256,1,1,DGP,0,0,0)  # dU_d = Hu^T ds_d
        cuCtxSynchronize()
        cuMemcpyHtoD_v2(DGP+0,loc(sd),8); cuMemcpyHtoD_v2(DGP+8,loc(gvd),8); cuMemcpyHtoD_v2(DGP+16,loc(dV_d2),8)
        cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(R2),8); cuMemcpyHtoD_v2(DGP+40,loc(D),8)
        cuda_launch4i(from<loc<CVoid>>(addr(dgb)),(R2*D+255)/256,1,1,256,1,1,DGP,0,0,0)  # dV_d = s_d^T gvd
        cuMemcpyHtoD_v2(DGP+0,loc(ds_d),8); cuMemcpyHtoD_v2(DGP+8,loc(Ud),8); cuMemcpyHtoD_v2(DGP+16,loc(dxld),8)
        cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(FF),8); cuMemcpyHtoD_v2(DGP+40,loc(R2),8)
        cuda_launch4i(from<loc<CVoid>>(addr(dga)),(SF+255)/256,1,1,256,1,1,DGP,0,0,0)    # dxld=ds_d@Ud^T
        cuMemcpyHtoD_v2(DGP+0,loc(DM),8); cuMemcpyHtoD_v2(DGP+8,loc(Wd),8); cuMemcpyHtoD_v2(DGP+16,loc(dxbd),8)
        cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(FF),8); cuMemcpyHtoD_v2(DGP+40,loc(D),8)
        cuda_launch4i(from<loc<CVoid>>(addr(dga)),(SF+255)/256,1,1,256,1,1,DGP,0,0,0)    # dxbd=DM@Wd^T
        cuMemcpyHtoD_v2(PB+0,loc(dxbd),8); cuMemcpyHtoD_v2(PB+8,loc(dxld),8); cuMemcpyHtoD_v2(PB+16,loc(ONE2),8); cuMemcpyHtoD_v2(PB+24,loc(SF),8)
        cuda_launch4i(from<loc<CVoid>>(addr(ads)),(SF+255)/256,1,1,256,1,1,PB,0,0,0)     # dHu = dxbd + dxld
        # 3) silu
        cuMemcpyHtoD_v2(DGP+0,loc(Gr),8); cuMemcpyHtoD_v2(DGP+8,loc(Up),8); cuMemcpyHtoD_v2(DGP+16,loc(dxbd),8)
        cuMemcpyHtoD_v2(DGP+24,loc(dgate),8); cuMemcpyHtoD_v2(DGP+32,loc(dup),8); cuMemcpyHtoD_v2(DGP+40,loc(SF),8)
        cuda_launch4i(from<loc<CVoid>>(addr(dsl)),(SF+255)/256,1,1,256,1,1,DGP,0,0,0)   # dgate,dup = dsilu(Gr,Up,dHu)
        # 4) gate proj
        cuMemcpyHtoD_v2(PB+0,loc(gvg),8); cuMemcpyHtoD_v2(PB+8,loc(dgate),8); cuMemcpyHtoD_v2(PB+16,loc(AR2),8); cuMemcpyHtoD_v2(PB+24,loc(SF),8)
        cuda_launch4i(from<loc<CVoid>>(addr(sc2)),(SF+255)/256,1,1,256,1,1,PB,0,0,0)   # gvg=AR*dgate
        cuMemcpyHtoD_v2(DGP+0,loc(gvg),8); cuMemcpyHtoD_v2(DGP+8,loc(Vg),8); cuMemcpyHtoD_v2(DGP+16,loc(ds_g),8)
        cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(R2),8); cuMemcpyHtoD_v2(DGP+40,loc(FF),8)
        cuda_launch4i(from<loc<CVoid>>(addr(dga)),(SR+255)/256,1,1,256,1,1,DGP,0,0,0)   # ds_g
        cuMemcpyHtoD_v2(DGP+0,loc(X1N),8); cuMemcpyHtoD_v2(DGP+8,loc(ds_g),8); cuMemcpyHtoD_v2(DGP+16,loc(dU_g2),8)
        cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(D),8); cuMemcpyHtoD_v2(DGP+40,loc(R2),8)
        cuda_launch4i(from<loc<CVoid>>(addr(dgb)),(D*R2+255)/256,1,1,256,1,1,DGP,0,0,0)  # dU_g
        cuMemcpyHtoD_v2(DGP+0,loc(sg),8); cuMemcpyHtoD_v2(DGP+8,loc(gvg),8); cuMemcpyHtoD_v2(DGP+16,loc(dV_g2),8)
        cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(R2),8); cuMemcpyHtoD_v2(DGP+40,loc(FF),8)
        cuda_launch4i(from<loc<CVoid>>(addr(dgb)),(R2*FF+255)/256,1,1,256,1,1,DGP,0,0,0) # dV_g
