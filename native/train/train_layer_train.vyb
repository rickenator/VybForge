        cuMemcpyHtoD_v2(PB+0,loc(Up),8); cuMemcpyHtoD_v2(PB+8,loc(eu),8); cuMemcpyHtoD_v2(PB+16,loc(AR),8); cuMemcpyHtoD_v2(PB+24,loc(S*FF),8)
        cuda_launch4i(from<loc<CVoid>>(addr(ads)),(S*FF+255)/256,1,1,256,1,1,PB,0,0,0)
        cuda_launch4i(from<loc<CVoid>>(addr(sl)),(S*FF+255)/256,1,1,256,1,1,Gr,Up,Hu,S*FF)
        # m = Hu@Wd + LoRA ; xo = X1 + M
        cuMemcpyHtoD_v2(GM+0,loc(Hu),8); cuMemcpyHtoD_v2(GM+8,loc(Wd),8); cuMemcpyHtoD_v2(GM+16,loc(M2),8)
        cuMemcpyHtoD_v2(GM+24,loc(S),8); cuMemcpyHtoD_v2(GM+32,loc(D),8); cuMemcpyHtoD_v2(GM+40,loc(FF),8)
