// M2b: ONE real Qwen3 blk.0 forward WITH LoRA on all 7 projections, teacher-forced S=2,
// using the combined training module (train.ptx, single-module rule). Caches every
// activation + the LoRA s-intermediates so the backward pass can consume them, and dumps
// them for the numpy reference (train_layer_ref.py / verify_train_layer.py).
// LoRA: proj = x@W + alpha_r*((x@U)@V), U [in,r], V [r,out]. W and norms are the REAL blk.0.
import io::{open_read, read_at, read_all, open_write, write_str, close}

extern "C" {
    cuInit(flags<CUInt>)<CInt>
    cuDeviceGetCount(count<loc<CInt>>)<CInt>
    cuDeviceGet(device<loc<CInt>>, ordinal<CInt>)<CInt>
    cuCtxCreate_v2(pctx<loc<loc<CVoid>>>, flags<CUInt>, dev<CInt>)<CInt>
    cuModuleLoadData(hmod<loc<loc<CVoid>>>, image<CString>)<CInt>
    cuModuleGetFunction(hfunc<loc<loc<CVoid>>>, hmod<loc<CVoid>>, name<CString>)<CInt>
    cuMemAlloc_v2(dptr<loc<Int>>, bytesize<Int>)<CInt>
    cuMemcpyHtoD_v2(dstDevice<Int>, srcHost<loc<CVoid>>, ByteCount<Int>)<CInt>
    cuMemcpyDtoH_v2(dstHost<loc<CVoid>>, srcDevice<Int>, ByteCount<Int>)<CInt>
    cuMemFree_v2(dptr<Int>)<CInt>
    cuCtxSynchronize()<CInt>
    cuda_launch4i(f<loc<CVoid>>, gridX<CUInt>, gridY<CUInt>, gridZ<CUInt>,
                  blockX<CUInt>, blockY<CUInt>, blockZ<CUInt>,
                  a0<Int>, a1<Int>, a2<Int>, a3<Int>)<CInt>
}

u8(s<String>, o<Int>)<Int> -> { return (s.char_at(o) as Int) & 255 }
strchr(s<String>, nd<Int>, st<Int>)<Int> -> { i<Int> = st; for (i in st..s.len()-1){ if((s.char_at(i) as Int)==nd){ return i } }; return -1 }
parse_u(s<String>, frm<Int>, endp<Int>)<Int> -> { a<Int> = 0; i<Int> = frm; for (i in frm..endp-1){ c<Int> = (s.char_at(i) as Int); if(c>=48){ if(c<=57){ a=a*10+(c-48) } } }; return a }
parse_numel(s<String>, frm<Int>, endp<Int>)<Int> -> { n<Int> = 1; seg<Int> = frm; i<Int> = frm; for (i in frm..endp-1){ if((s.char_at(i) as Int)==120){ n=n*parse_u(s,seg,i); seg=i+1 } }; n=n*parse_u(s,seg,endp); return n }
packed_bytes(numel<Int>, ty<Int>)<Int> -> { if(ty==12){ return numel*144/256 }; if(ty==14){ return numel*210/256 }; return numel*4 }
find_nm(nmv<Vec<String>>, nm<String>)<Int> -> { i<Int> = 0; for (i in 0..nmv.len()-1){ if(nmv.get(i)==nm){ return i } }; return -1 }
download(data<String>, dst<Int>, nbytes<Int>)<Int> -> {
    freedom {
        npb<Int> = nbytes-(nbytes%8); ci<Int> = 0
        for (ci in 0..(npb/8)-1){ o8<Int> = ci*8; ch<Int> = 0; bj<Int> = 0; for (bj in 0..7){ bv<Int> = u8(data,o8+bj); ch=ch|(bv<<(bj*8)) }; if(cuMemcpyHtoD_v2(dst+o8,loc(ch),8)!=0){ return 15 } }
        tj<Int> = npb; while(tj<nbytes){ by<Int> = u8(data,tj); if(cuMemcpyHtoD_v2(dst+tj,loc(by),1)!=0){ return 15 }; tj=tj+1 }
        return 0
    }
    return 0
}
read_model(path<String>, off<Int>, nbytes<Int>)<String> -> { r<String> = ""; match(open_read(path)){ f->{ match(read_at(f,off,nbytes)){ s->{ r=s } ?->{ r="" } } close(f) } ?->{ r="" } }; return r }
read_bin(path<String>)<String> -> { r<String> = ""; match(open_read(path)){ f->{ match(read_all(f)){ s->{ r=s } ?->{ r="" } } close(f) } ?->{ r="" } }; return r }
dumpf(src<Int>, count<Int>, path<String>)<Int> -> { freedom { match(open_write(path)){ w->{ rv<Float> = 0.0; k<Int> = 0; for (k in 0..count-1){ rv=0.0; cuMemcpyDtoH_v2(loc(rv),src+k*8,8); write_str(w,rv.to_string()+"\n") } close(w) } ?->{ return 17 } } }; return 0 }
load_quant(path<String>, dpack<Int>, dout<Int>, off<Int>, nb<Int>, numel<Int>, hq<loc<CVoid>>)<Int> -> {
    data<String> = read_model(path,off,nb); if(data.len()<nb){ return 32 }
    freedom { e<Int> = download(data,dpack,nb); if(e!=0){ return e }; rc<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(hq)),(numel+255)/256,1,1,256,1,1,dpack,dout,numel,0); if(rc!=0){ return 33 }; return 0 }
    return 0
}
load_norm(path<String>, pf<Int>, dpack<Int>, dout<Int>, off<Int>, numel<Int>, he<loc<CVoid>>)<Int> -> {
    data<String> = read_model(path,off,numel*4); if(data.len()<numel*4){ return 32 }
    freedom { e<Int> = download(data,dpack,numel*4); if(e!=0){ return e }; cuMemcpyHtoD_v2(pf+0,loc(dpack),8); cuMemcpyHtoD_v2(pf+8,loc(dout),8); cuMemcpyHtoD_v2(pf+16,loc(numel),8); rc<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(he)),(numel+255)/256,1,1,256,1,1,pf,0,0,0); if(rc!=0){ return 33 }; return 0 }
    return 0
}
stage_one(path<String>, nmv<Vec<String>>, ofv<Vec<Int>>, nlv<Vec<Int>>, tyv<Vec<Int>>, nm<String>, dpk<Int>, pf<Int>, dout<Int>, q4fn<loc<CVoid>>, q6fn<loc<CVoid>>, efn<loc<CVoid>>)<Int> -> {
    idx<Int> = find_nm(nmv,nm); if(idx<0){ return 60 }
    off<Int> = ofv.get(idx); numel<Int> = nlv.get(idx); ty<Int> = tyv.get(idx)
    if(ty==12){ return load_quant(path,dpk,dout,off,packed_bytes(numel,ty),numel,q4fn) }
    if(ty==14){ return load_quant(path,dpk,dout,off,packed_bytes(numel,ty),numel,q6fn) }
    return load_norm(path,pf,dpk,dout,off,numel,efn)
}

main()<Int> -> {
    S<Int> = 2; D<Int> = 2560; H<Int> = 32; KVH<Int> = 8; HD<Int> = 128; FF<Int> = 9728; R<Int> = 2
    NQ<Int> = H*HD; NKV<Int> = KVH*HD; EPS<Float> = 0.000001
    MODEL<String> = "/home/rick/Models/qwen3/Qwen3-4B-Q4_K_M.gguf"
    TSV<String> = "native/out/qwen3_4b_tensors.tsv"
    freedom {
        if(cuInit(0)!=0){ println("SKIP"); return 0 }
        var<CInt> ndev=0
        if(cuDeviceGetCount(loc(ndev))!=0 || ndev<1){ println("SKIP"); return 0 }
        var<CInt> dev=0; if(cuDeviceGet(loc(dev),0)!=0){ return 14 }
        ctx<loc<CVoid>> = from<loc<CVoid>>(0)
        if(cuCtxCreate_v2(loc(ctx),0,dev)!=0){ return 14 }
    }
    freedom {
        # ---- TSV ----
        nmv<Vec<String>> = Vec(); tyv<Vec<Int>> = Vec(); nlv<Vec<Int>> = Vec(); ofv<Vec<Int>> = Vec()
        bff<String> = read_bin(TSV); ln<Int> = bff.len(); st<Int> = 0; i<Int> = 0
        for (i in 0..ln-1){ if((bff.char_at(i) as Int)==10){ t1<Int> = strchr(bff,9,st); if(t1>=st){ t2<Int> = strchr(bff,9,t1+1); if(t2<0){ t2=i }; nm<String> = bff.substring(st,t1); keep<Int> = 0; if(nm.substring(0,4)=="blk."){ keep=1 }; if(keep==1){ t3<Int> = strchr(bff,9,t2+1); if(t3<0){ t3=i }; t4<Int> = strchr(bff,9,t3+1); if(t4<0){ t4=i }; nmv.push(nm); tyv.push(parse_u(bff,t2+1,t3)); nlv.push(parse_numel(bff,t1+1,t2)); ofv.push(parse_u(bff,t3+1,t4)) } }; st=i+1 } }
        println("TSV="+nmv.len().to_string())
        # ---- module load (single) ----
        m<loc<CVoid>> = from<loc<CVoid>>(0); rc<CInt> = -1; t4<Int> = 0
        for (t4 in 0..5){ if(rc!=0){ m=from<loc<CVoid>>(0); rc=cuModuleLoadData(loc(m),read_bin("native/build/train.ptx")) } }
        if(rc!=0){ println("MODLOAD_FAIL"); return 9 }
        gf<loc<CVoid>> = from<loc<CVoid>>(0); ads<loc<CVoid>> = from<loc<CVoid>>(0); rn<loc<CVoid>> = from<loc<CVoid>>(0)
        rp<loc<CVoid>> = from<loc<CVoid>>(0); att<loc<CVoid>> = from<loc<CVoid>>(0); sl<loc<CVoid>> = from<loc<CVoid>>(0); rs<loc<CVoid>> = from<loc<CVoid>>(0)
        q4fn<loc<CVoid>> = from<loc<CVoid>>(0); q6fn<loc<CVoid>> = from<loc<CVoid>>(0); efn<loc<CVoid>> = from<loc<CVoid>>(0)
        if(cuModuleGetFunction(loc(gf),m,"gemmf")!=0){ return 10 }
        if(cuModuleGetFunction(loc(ads),m,"addscaled")!=0){ return 10 }
        if(cuModuleGetFunction(loc(rn),m,"rmsnorm")!=0){ return 10 }
        if(cuModuleGetFunction(loc(rp),m,"qwen3rope")!=0){ return 10 }
        if(cuModuleGetFunction(loc(att),m,"attn")!=0){ return 10 }
        if(cuModuleGetFunction(loc(sl),m,"silu")!=0){ return 10 }
        if(cuModuleGetFunction(loc(rs),m,"resid")!=0){ return 10 }
        if(cuModuleGetFunction(loc(q4fn),m,"q4kdeq")!=0){ return 10 }
        if(cuModuleGetFunction(loc(q6fn),m,"q6kdeq")!=0){ return 10 }
        if(cuModuleGetFunction(loc(efn),m,"f32expand")!=0){ return 10 }
        dres<loc<CVoid>> = from<loc<CVoid>>(0); dga<loc<CVoid>> = from<loc<CVoid>>(0); dgb<loc<CVoid>> = from<loc<CVoid>>(0)
        sc2<loc<CVoid>> = from<loc<CVoid>>(0); dsl<loc<CVoid>> = from<loc<CVoid>>(0); drn<loc<CVoid>> = from<loc<CVoid>>(0); dnw<loc<CVoid>> = from<loc<CVoid>>(0)
        drp<loc<CVoid>> = from<loc<CVoid>>(0); dat2<loc<CVoid>> = from<loc<CVoid>>(0); zbf<loc<CVoid>> = from<loc<CVoid>>(0)
        if(cuModuleGetFunction(loc(dres),m,"dresid")!=0){ return 10 }
        if(cuModuleGetFunction(loc(dga),m,"dgemm_at")!=0){ return 10 }
        if(cuModuleGetFunction(loc(dgb),m,"dgemm_bt")!=0){ return 10 }
        if(cuModuleGetFunction(loc(sc2),m,"scalec")!=0){ return 10 }
        if(cuModuleGetFunction(loc(dsl),m,"dsilu")!=0){ return 10 }
        if(cuModuleGetFunction(loc(drn),m,"drmsnorm")!=0){ return 10 }
        if(cuModuleGetFunction(loc(dnw),m,"dnormw")!=0){ return 10 }
        if(cuModuleGetFunction(loc(drp),m,"drope")!=0){ return 10 }
        if(cuModuleGetFunction(loc(dat2),m,"dattn")!=0){ return 10 }
        if(cuModuleGetFunction(loc(zbf),m,"zbuf")!=0){ return 10 }
        aw2<loc<CVoid>> = from<loc<CVoid>>(0); if(cuModuleGetFunction(loc(aw2),m,"adamw")!=0){ return 10 }
        sbb<loc<CVoid>> = from<loc<CVoid>>(0); if(cuModuleGetFunction(loc(sbb),m,"sub")!=0){ return 10 }

        # ---- allocate ----
        x<Int> = 0; Wq<Int> = 0; Wk<Int> = 0; Wv<Int> = 0; Wo<Int> = 0; Wg<Int> = 0; Wu<Int> = 0; Wd<Int> = 0
        N1<Int> = 0; Nq<Int> = 0; Nk<Int> = 0; N2<Int> = 0; DF<Int> = 0
        XN<Int> = 0; DQ<Int> = 0; DK<Int> = 0; DV<Int> = 0; DQN<Int> = 0; DKN<Int> = 0; DQr<Int> = 0; DKr<Int> = 0
        DCtx<Int> = 0; DO<Int> = 0; X1<Int> = 0; X1N<Int> = 0; Gr<Int> = 0; Up<Int> = 0; Hu<Int> = 0; M2<Int> = 0; XO<Int> = 0
        DPK<Int> = 0; GM<Int> = 0; RN<Int> = 0; ROP<Int> = 0; ATT<Int> = 0; PB<Int> = 0; PF<Int> = 0
        # LoRA U/V (7 each) + s-intermediates + ex
        Uq<Int> = 0; Vq<Int> = 0; Uk<Int> = 0; Vk<Int> = 0; Uv<Int> = 0; Vv<Int> = 0; Uo<Int> = 0; Vo<Int> = 0
        Ug<Int> = 0; Vg<Int> = 0; Uu<Int> = 0; Vu<Int> = 0; Ud<Int> = 0; Vd<Int> = 0
        sq<Int> = 0; sk<Int> = 0; sv<Int> = 0; so<Int> = 0; sg<Int> = 0; su<Int> = 0; sd<Int> = 0
        eq<Int> = 0; ek<Int> = 0; ev<Int> = 0; eo<Int> = 0; eg<Int> = 0; eu<Int> = 0; ed<Int> = 0
        if(cuMemAlloc_v2(loc(x),S*D*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(N1),D*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Nq),HD*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Nk),HD*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(N2),D*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(DF),64*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(XN),S*D*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(DQ),S*NQ*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(DK),S*NKV*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(DV),S*NKV*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(DQN),S*NQ*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(DKN),S*NKV*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(DQr),S*NQ*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(DKr),S*NKV*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(DCtx),S*NQ*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(DO),S*D*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(X1),S*D*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(X1N),S*D*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Gr),S*FF*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Up),S*FF*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Hu),S*FF*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(M2),S*D*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(XO),S*D*8)!=0){ return 11 }
        # big weights sized by numel
        nnq<Int> = 0;  # scratch
        i0<Int> = find_nm(nmv,"blk.0.attn_q.weight"); wq_nl<Int> = nlv.get(i0)
        i0=find_nm(nmv,"blk.0.attn_k.weight"); wk_nl<Int> = nlv.get(i0)
        i0=find_nm(nmv,"blk.0.attn_v.weight"); wv_nl<Int> = nlv.get(i0)
        i0=find_nm(nmv,"blk.0.attn_output.weight"); wo_nl<Int> = nlv.get(i0)
        i0=find_nm(nmv,"blk.0.ffn_gate.weight"); wg_nl<Int> = nlv.get(i0)
        i0=find_nm(nmv,"blk.0.ffn_up.weight"); wu_nl<Int> = nlv.get(i0)
        i0=find_nm(nmv,"blk.0.ffn_down.weight"); wd_nl<Int> = nlv.get(i0)
        if(cuMemAlloc_v2(loc(Wq),wq_nl*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Wk),wk_nl*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Wv),wv_nl*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Wo),wo_nl*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Wg),wg_nl*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Wu),wu_nl*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Wd),wd_nl*8)!=0){ return 11 }
        i0=find_nm(nmv,"blk.0.ffn_down.weight"); pkmax<Int> = packed_bytes(nlv.get(i0),tyv.get(i0))
        if(cuMemAlloc_v2(loc(DPK),pkmax)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(GM),64)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(RN),48)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(ROP),232)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(ATT),224)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(PB),32)!=0){ return 11 }
        DGP<Int> = 0; if(cuMemAlloc_v2(loc(DGP),48)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(PF),24)!=0){ return 11 }
        # LoRA alloc (bins[in,r],[r,out])
        if(cuMemAlloc_v2(loc(Uq),D*R*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Vq),R*NQ*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Uk),D*R*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Vk),R*NKV*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Uv),D*R*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Vv),R*NKV*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Uo),NQ*R*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Vo),R*D*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Ug),D*R*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Vg),R*FF*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Uu),D*R*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Vu),R*FF*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Ud),FF*R*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(Vd),R*D*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(sq),S*R*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(sk),S*R*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(sv),S*R*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(so),S*R*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(sg),S*R*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(su),S*R*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(sd),S*R*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(eq),S*NQ*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(ek),S*NKV*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(ev),S*NKV*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(eo),S*D*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(eg),S*FF*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(eu),S*FF*8)!=0){ return 11 }
        if(cuMemAlloc_v2(loc(ed),S*D*8)!=0){ return 11 }
        # ---- load input + weights + norms ----
        e<Int> = download(read_bin("native/out/layer0_input.bin"),x,S*D*8); if(e!=0){ return 20 }
        e=download(read_bin("native/out/layer0_invfreq.bin"),DF,64*8); if(e!=0){ return 21 }
        e=stage_one(MODEL,nmv,ofv,nlv,tyv,"blk.0.attn_q.weight",DPK,PF,Wq,q4fn,q6fn,efn); if(e!=0){ return 30 }
        e=stage_one(MODEL,nmv,ofv,nlv,tyv,"blk.0.attn_k.weight",DPK,PF,Wk,q4fn,q6fn,efn); if(e!=0){ return 31 }
        e=stage_one(MODEL,nmv,ofv,nlv,tyv,"blk.0.attn_v.weight",DPK,PF,Wv,q4fn,q6fn,efn); if(e!=0){ return 32 }
        e=stage_one(MODEL,nmv,ofv,nlv,tyv,"blk.0.attn_output.weight",DPK,PF,Wo,q4fn,q6fn,efn); if(e!=0){ return 33 }
        e=stage_one(MODEL,nmv,ofv,nlv,tyv,"blk.0.ffn_gate.weight",DPK,PF,Wg,q4fn,q6fn,efn); if(e!=0){ return 34 }
        e=stage_one(MODEL,nmv,ofv,nlv,tyv,"blk.0.ffn_up.weight",DPK,PF,Wu,q4fn,q6fn,efn); if(e!=0){ return 35 }
        e=stage_one(MODEL,nmv,ofv,nlv,tyv,"blk.0.ffn_down.weight",DPK,PF,Wd,q4fn,q6fn,efn); if(e!=0){ return 36 }
        e=stage_one(MODEL,nmv,ofv,nlv,tyv,"blk.0.attn_norm.weight",DPK,PF,N1,q4fn,q6fn,efn); if(e!=0){ return 37 }
        e=stage_one(MODEL,nmv,ofv,nlv,tyv,"blk.0.attn_q_norm.weight",DPK,PF,Nq,q4fn,q6fn,efn); if(e!=0){ return 38 }
        e=stage_one(MODEL,nmv,ofv,nlv,tyv,"blk.0.attn_k_norm.weight",DPK,PF,Nk,q4fn,q6fn,efn); if(e!=0){ return 39 }
        e=stage_one(MODEL,nmv,ofv,nlv,tyv,"blk.0.ffn_norm.weight",DPK,PF,N2,q4fn,q6fn,efn); if(e!=0){ return 40 }
        # LoRA bins
        e=download(read_bin("native/out/tl_Uq.bin"),Uq,D*R*8); if(e!=0){ return 45 }
        # ---- backward buffers ----
        DG<Int> = 0; DX1<Int> = 0; DM<Int> = 0; dHu<Int> = 0; dgate<Int> = 0; dup<Int> = 0
        dUo2<Int> = 0; dVp2<Int> = 0; dCtx2<Int> = 0; dX1n2<Int> = 0; dX1la<Int> = 0
        gvd<Int> = 0; ds_d<Int> = 0; dU_d2<Int> = 0; dV_d2<Int> = 0; dxld<Int> = 0; dxbd<Int> = 0
        gvg<Int> = 0; ds_g<Int> = 0; dU_g2<Int> = 0; dV_g2<Int> = 0; dxlg<Int> = 0; dxbg<Int> = 0
        gvu<Int> = 0; ds_u<Int> = 0; dU_u2<Int> = 0; dV_u2<Int> = 0; dxlu<Int> = 0; dxbu<Int> = 0
        gvo<Int> = 0; ds_o2<Int> = 0; dU_o2<Int> = 0; dV_o2<Int> = 0; dxlo<Int> = 0; dxbo<Int> = 0
        gvq<Int> = 0; ds_q<Int> = 0; dU_q2<Int> = 0; dV_q2<Int> = 0; dxlq<Int> = 0; dxbq<Int> = 0
