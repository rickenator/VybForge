        cuMemcpyHtoD_v2(GM+24,loc(S),8); cuMemcpyHtoD_v2(GM+32,loc(FF),8); cuMemcpyHtoD_v2(GM+40,loc(R2),8)
        cuMemcpyHtoD_v2(GM+48,loc(ONE),8); cuMemcpyHtoD_v2(GM+56,loc(ZR),8)
