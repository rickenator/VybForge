        cuMemcpyHtoD_v2(AW+32,loc(LR),8); cuMemcpyHtoD_v2(AW+40,loc(B1),8); cuMemcpyHtoD_v2(AW+48,loc(B2),8); cuMemcpyHtoD_v2(AW+56,loc(EPP),8)
        cuMemcpyHtoD_v2(AW+64,loc(WDD),8); cuMemcpyHtoD_v2(AW+72,loc(b1tc),8); cuMemcpyHtoD_v2(AW+80,loc(b2tc),8); cuMemcpyHtoD_v2(AW+88,loc(R2*FF),8)
        cuda_launch4i(from<loc<CVoid>>(addr(aw2)),(R2*FF+255)/256,1,1,256,1,1,AW,0,0,0)
        cuMemcpyHtoD_v2(AW+0,loc(Ud),8); cuMemcpyHtoD_v2(AW+8,loc(dU_d2),8); cuMemcpyHtoD_v2(AW+16,loc(mUd2),8); cuMemcpyHtoD_v2(AW+24,loc(vUd2),8)
        cuMemcpyHtoD_v2(AW+32,loc(LR),8); cuMemcpyHtoD_v2(AW+40,loc(B1),8); cuMemcpyHtoD_v2(AW+48,loc(B2),8); cuMemcpyHtoD_v2(AW+56,loc(EPP),8)
        cuMemcpyHtoD_v2(AW+64,loc(WDD),8); cuMemcpyHtoD_v2(AW+72,loc(b1tc),8); cuMemcpyHtoD_v2(AW+80,loc(b2tc),8); cuMemcpyHtoD_v2(AW+88,loc(FF*R2),8)
        cuda_launch4i(from<loc<CVoid>>(addr(aw2)),(FF*R2+255)/256,1,1,256,1,1,AW,0,0,0)
        cuMemcpyHtoD_v2(AW+0,loc(Vd),8); cuMemcpyHtoD_v2(AW+8,loc(dV_d2),8); cuMemcpyHtoD_v2(AW+16,loc(mVd2),8); cuMemcpyHtoD_v2(AW+24,loc(vVd2),8)
        cuMemcpyHtoD_v2(AW+32,loc(LR),8); cuMemcpyHtoD_v2(AW+40,loc(B1),8); cuMemcpyHtoD_v2(AW+48,loc(B2),8); cuMemcpyHtoD_v2(AW+56,loc(EPP),8)
        cuMemcpyHtoD_v2(AW+64,loc(WDD),8); cuMemcpyHtoD_v2(AW+72,loc(b1tc),8); cuMemcpyHtoD_v2(AW+80,loc(b2tc),8); cuMemcpyHtoD_v2(AW+88,loc(R2*D),8)
        cuda_launch4i(from<loc<CVoid>>(addr(aw2)),(R2*D+255)/256,1,1,256,1,1,AW,0,0,0)
        cuCtxSynchronize()
        if (stp_d == 1) { e=dumpf(Uq,D*R2,"native/out/m2d_Uq_s1.txt"); if(e!=0){ return 70 }
                          e=dumpf(XO,S*D,"native/out/m2d_xo_s1.txt"); if(e!=0){ return 70 } }
        stp_d = stp_d + 1
        }
        # ---- write per-step losses for the gate ----
        freedom { match(open_write("native/out/m2d_loss.txt")){ w->{ write_str(w,losstr); close(w) } ?->{ return 71 } } }
        # ---- dump grad outputs ----
        e=dumpf(dU_d2,FF*R2,"native/out/b_dU_d.txt"); if(e!=0){ return 70 }
        e=dumpf(dV_d2,R2*D,"native/out/b_dV_d.txt"); if(e!=0){ return 70 }
