        cuMemcpyHtoD_v2(DGP+0,loc(x),8); cuMemcpyHtoD_v2(DGP+8,loc(dXN2),8); cuMemcpyHtoD_v2(DGP+16,loc(dN1b),8)
        cuMemcpyHtoD_v2(DGP+24,loc(S),8); cuMemcpyHtoD_v2(DGP+32,loc(D),8); cuMemcpyHtoD_v2(DGP+40,loc(EPS),8)
        cuda_launch4i(from<loc<CVoid>>(addr(dnw)),(D+255)/256,1,1,256,1,1,DGP,0,0,0)
        cuCtxSynchronize()
        # ---- AdamW on U/V (7 pairs) ----
        b1tc = b1tc * B1; b2tc = b2tc * B2
        cuMemcpyHtoD_v2(AW+0,loc(Uq),8); cuMemcpyHtoD_v2(AW+8,loc(dU_q2),8); cuMemcpyHtoD_v2(AW+16,loc(mUq),8); cuMemcpyHtoD_v2(AW+24,loc(vUq),8)
        cuMemcpyHtoD_v2(AW+32,loc(LR),8); cuMemcpyHtoD_v2(AW+40,loc(B1),8); cuMemcpyHtoD_v2(AW+48,loc(B2),8); cuMemcpyHtoD_v2(AW+56,loc(EPP),8)
        cuMemcpyHtoD_v2(AW+64,loc(WDD),8); cuMemcpyHtoD_v2(AW+72,loc(b1tc),8); cuMemcpyHtoD_v2(AW+80,loc(b2tc),8); cuMemcpyHtoD_v2(AW+88,loc(D*R2),8)
        cuda_launch4i(from<loc<CVoid>>(addr(aw2)),(D*R2+255)/256,1,1,256,1,1,AW,0,0,0)
