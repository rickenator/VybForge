        cuMemcpyHtoD_v2(GM+24,loc(S),8); cuMemcpyHtoD_v2(GM+32,loc(R2),8); cuMemcpyHtoD_v2(GM+40,loc(D),8)
        cuMemcpyHtoD_v2(GM+48,loc(ONE),8); cuMemcpyHtoD_v2(GM+56,loc(ZR),8)
        cuda_launch4i(from<loc<CVoid>>(addr(gf)),(S*R2+255)/256,1,1,256,1,1,GM,0,0,0)
