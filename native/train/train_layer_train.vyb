        cuda_launch4i(from<loc<CVoid>>(addr(ads)),(S*D+255)/256,1,1,256,1,1,PB,0,0,0)   # dXN2 += dxbq
        cuMemcpyHtoD_v2(PB+0,loc(dXN2),8); cuMemcpyHtoD_v2(PB+8,loc(dxlq),8); cuMemcpyHtoD_v2(PB+16,loc(ONE2),8); cuMemcpyHtoD_v2(PB+24,loc(S*D),8)
