        # ---- dump cache ----
        e=dumpf(XN,S*D,"native/out/tl_xn.txt"); if(e!=0){ return 70 }
        e=dumpf(DQ,S*NQ,"native/out/tl_q.txt"); if(e!=0){ return 70 }
        e=dumpf(DK,S*NKV,"native/out/tl_k.txt"); if(e!=0){ return 70 }
        e=dumpf(DV,S*NKV,"native/out/tl_v.txt"); if(e!=0){ return 70 }
        e=dumpf(DQN,S*NQ,"native/out/tl_qn.txt"); if(e!=0){ return 70 }
        e=dumpf(DKN,S*NKV,"native/out/tl_kn.txt"); if(e!=0){ return 70 }
        e=dumpf(DQr,S*NQ,"native/out/tl_qr.txt"); if(e!=0){ return 70 }
        e=dumpf(DKr,S*NKV,"native/out/tl_kr.txt"); if(e!=0){ return 70 }
        e=dumpf(DCtx,S*NQ,"native/out/tl_ctx.txt"); if(e!=0){ return 70 }
        e=dumpf(DO,S*D,"native/out/tl_o.txt"); if(e!=0){ return 70 }
        e=dumpf(X1,S*D,"native/out/tl_x1.txt"); if(e!=0){ return 70 }
        e=dumpf(X1N,S*D,"native/out/tl_x1n.txt"); if(e!=0){ return 70 }
        e=dumpf(Gr,S*FF,"native/out/tl_gate.txt"); if(e!=0){ return 70 }
        e=dumpf(Up,S*FF,"native/out/tl_up.txt"); if(e!=0){ return 70 }
        e=dumpf(Hu,S*FF,"native/out/tl_hu.txt"); if(e!=0){ return 70 }
        e=dumpf(M2,S*D,"native/out/tl_m.txt"); if(e!=0){ return 70 }
        e=dumpf(XO,S*D,"native/out/tl_xo.txt"); if(e!=0){ return 70 }
        e=dumpf(sq,S*R2,"native/out/tl_s_q.txt"); if(e!=0){ return 70 }
        e=dumpf(sk,S*R2,"native/out/tl_s_k.txt"); if(e!=0){ return 70 }
        e=dumpf(sv,S*R2,"native/out/tl_s_v.txt"); if(e!=0){ return 70 }
        e=dumpf(so,S*R2,"native/out/tl_s_o.txt"); if(e!=0){ return 70 }
        e=dumpf(sg,S*R2,"native/out/tl_s_g.txt"); if(e!=0){ return 70 }
        e=dumpf(su,S*R2,"native/out/tl_s_u.txt"); if(e!=0){ return 70 }
        e=dumpf(sd,S*R2,"native/out/tl_s_d.txt"); if(e!=0){ return 70 }
        println("TRAIN_LAYER_DONE")
        return 0
    }
    return 0
}
