        cuda_launch4i(from<loc<CVoid>>(addr(rp)),(SHP*HD+SKP*HD+255)/256,1,1,256,1,1,ROP,0,0,0)
        # attn
        cuMemcpyHtoD_v2(ATT+80,loc(DQr),8); cuMemcpyHtoD_v2(ATT+88,loc(DKr),8); cuMemcpyHtoD_v2(ATT+96,loc(DV),8); cuMemcpyHtoD_v2(ATT+104,loc(DCtx),8)
        cuMemcpyHtoD_v2(ATT+184,loc(S),8); cuMemcpyHtoD_v2(ATT+200,loc(HD),8); cuMemcpyHtoD_v2(ATT+208,loc(H),8); cuMemcpyHtoD_v2(ATT+216,loc(KVH),8)
        cuda_launch4i(from<loc<CVoid>>(addr(att)),(S*H+255)/256,1,1,256,1,1,ATT,0,0,0)
        # o = DCtx@Wo + LoRA
        cuMemcpyHtoD_v2(GM+0,loc(DCtx),8); cuMemcpyHtoD_v2(GM+8,loc(Wo),8); cuMemcpyHtoD_v2(GM+16,loc(DO),8)
        cuMemcpyHtoD_v2(GM+24,loc(S),8); cuMemcpyHtoD_v2(GM+32,loc(D),8); cuMemcpyHtoD_v2(GM+40,loc(NQ),8)
        cuMemcpyHtoD_v2(GM+48,loc(ONE),8); cuMemcpyHtoD_v2(GM+56,loc(ZR),8)
        cuda_launch4i(from<loc<CVoid>>(addr(gf)),(S*D+255)/256,1,1,256,1,1,GM,0,0,0)
        cuMemcpyHtoD_v2(GM+0,loc(DCtx),8); cuMemcpyHtoD_v2(GM+8,loc(Uo),8); cuMemcpyHtoD_v2(GM+16,loc(so),8)
        cuMemcpyHtoD_v2(GM+24,loc(S),8); cuMemcpyHtoD_v2(GM+32,loc(R2),8); cuMemcpyHtoD_v2(GM+40,loc(NQ),8)
        cuMemcpyHtoD_v2(GM+48,loc(ONE),8); cuMemcpyHtoD_v2(GM+56,loc(ZR),8)
        cuda_launch4i(from<loc<CVoid>>(addr(gf)),(S*R2+255)/256,1,1,256,1,1,GM,0,0,0)
        cuMemcpyHtoD_v2(GM+0,loc(so),8); cuMemcpyHtoD_v2(GM+8,loc(Vo),8); cuMemcpyHtoD_v2(GM+16,loc(eo),8)
        cuMemcpyHtoD_v2(GM+24,loc(S),8); cuMemcpyHtoD_v2(GM+32,loc(D),8); cuMemcpyHtoD_v2(GM+40,loc(R2),8)
