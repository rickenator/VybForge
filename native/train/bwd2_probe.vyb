// T3.2 dGEMM + LoRA grads probe. Reads synthetic LoRA-layer inputs (bwd2_*.bin), runs
// the gradient GEMM kernels composing the LoRA backward (ds, dU, dV, dx_lora, dx_base),
// writes native/out/bwd2_*.txt for the numpy verifier.
import io::{open_read, read_at, read_all, open_write, write_str, close}

extern "C" {
    cuInit(flags<CUInt>)<CInt>
    cuDeviceGetCount(count<loc<CInt>>)<CInt>
    cuDeviceGet(device<loc<CInt>>, ordinal<CInt>)<CInt>
    cuCtxCreate_v2(pctx<loc<loc<CVoid>>>, flags<CUInt>, dev<CInt>)<CInt>
    cuModuleLoadData(hmod<loc<loc<CVoid>>>, image<CString>)<CInt>
    cuModuleGetFunction(hfunc<loc<loc<CVoid>>>, hmod<loc<CVoid>>, name<CString>)<CInt>
    cuMemAlloc_v2(dptr<loc<Int>>, bytesize<Int>)<CInt>
    cuMemcpyHtoD_v2(dstDevice<Int>, srcHost<loc<CVoid>>, ByteCount<Int>)<CInt>
    cuMemcpyDtoH_v2(dstHost<loc<CVoid>>, srcDevice<Int>, ByteCount<Int>)<CInt>
    cuMemFree_v2(dptr<Int>)<CInt>
    cuCtxSynchronize()<CInt>
    cuda_launch4i(f<loc<CVoid>>, gridX<CUInt>, gridY<CUInt>, gridZ<CUInt>,
                  blockX<CUInt>, blockY<CUInt>, blockZ<CUInt>,
                  a0<Int>, a1<Int>, a2<Int>, a3<Int>)<CInt>
}

u8(s<String>, o<Int>)<Int> -> { return (s.char_at(o) as Int) & 255 }
download(data<String>, dst<Int>, nbytes<Int>)<Int> -> {
    freedom {
        npb<Int> = nbytes - (nbytes % 8); ci<Int> = 0
        for (ci in 0..(npb / 8) - 1) {
            o8<Int> = ci * 8; ch<Int> = 0; bj<Int> = 0
            for (bj in 0..7) { bv<Int> = u8(data, o8 + bj); ch = ch | (bv << (bj * 8)) }
            if (cuMemcpyHtoD_v2(dst + o8, loc(ch), 8) != 0) { return 15 }
        }
        tj<Int> = npb
        while (tj < nbytes) { by<Int> = u8(data, tj); if (cuMemcpyHtoD_v2(dst + tj, loc(by), 1) != 0) { return 15 }; tj = tj + 1 }
        return 0
    }
    return 0
}
read_bin(path<String>)<String> -> {
    r<String> = ""
    match (open_read(path)) { f -> { match (read_all(f)) { s -> { r = s } ? -> { r = "" } } close(f) } ? -> { r = "" } }
    return r
}
dumpf(src<Int>, count<Int>, path<String>)<Int> -> {
    freedom {
        match (open_write(path)) {
            w -> {
                rv<Float> = 0.0; k<Int> = 0
                for (k in 0..count - 1) { rv = 0.0; cuMemcpyDtoH_v2(loc(rv), src + k * 8, 8); write_str(w, rv.to_string() + "\n") }
                close(w)
            }
            ? -> { return 17 }
        }
    }
    return 0
}

// set a 6-word dgemm params buffer and launch (at or bt). pbuf + 0..40. count = grid threads.
setlaunch(kfun<loc<CVoid>>, pbuf<Int>, X<Int>, Y<Int>, Z<Int>, S<Int>, K<Int>, O<Int>, cnt<Int>)<CInt> -> {
    freedom {
        cuMemcpyHtoD_v2(pbuf + 0, loc(X), 8); cuMemcpyHtoD_v2(pbuf + 8, loc(Y), 8); cuMemcpyHtoD_v2(pbuf + 16, loc(Z), 8)
        cuMemcpyHtoD_v2(pbuf + 24, loc(S), 8); cuMemcpyHtoD_v2(pbuf + 32, loc(K), 8); cuMemcpyHtoD_v2(pbuf + 40, loc(O), 8)
        rc<CInt> = cuda_launch4i(from<loc<CVoid>>(addr(kfun)), (cnt + 255) / 256, 1, 1, 256, 1, 1, pbuf, 0, 0, 0)
        return rc
    }
    return 0
}

main()<Int> -> {
    S<Int> = 4; IN<Int> = 16; R<Int> = 8; O<Int> = 32
    freedom {
        if (cuInit(0) != 0) { println("SKIP"); return 0 }
        var<CInt> ndev = 0
        if (cuDeviceGetCount(loc(ndev)) != 0 || ndev < 1) { println("SKIP"); return 0 }
        var<CInt> dev = 0; if (cuDeviceGet(loc(dev), 0) != 0) { return 14 }
        ctx<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuCtxCreate_v2(loc(ctx), 0, dev) != 0) { return 14 }
    }
    freedom {
        m<loc<CVoid>> = from<loc<CVoid>>(0); rc<CInt> = -1; t4<Int> = 0
        for (t4 in 0..5) { if (rc != 0) { m = from<loc<CVoid>>(0); rc = cuModuleLoadData(loc(m), read_bin("native/build/backprop.ptx")) } }
        if (rc != 0) { println("MODLOAD_FAIL"); return 9 }
        gat<loc<CVoid>> = from<loc<CVoid>>(0); gbt<loc<CVoid>> = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(gat), m, "dgemm_at") != 0) { return 10 }
        if (cuModuleGetFunction(loc(gbt), m, "dgemm_bt") != 0) { return 10 }

        x<Int> = 0; U<Int> = 0; V<Int> = 0; W<Int> = 0; dY<Int> = 0; s<Int> = 0; gv<Int> = 0
        ds<Int> = 0; dU<Int> = 0; dV<Int> = 0; dxl<Int> = 0; dxb<Int> = 0; PB<Int> = 0
        if (cuMemAlloc_v2(loc(x), S*IN*8)!=0) { return 11 }
        if (cuMemAlloc_v2(loc(U), IN*R*8)!=0) { return 11 }
        if (cuMemAlloc_v2(loc(V), R*O*8)!=0) { return 11 }
        if (cuMemAlloc_v2(loc(W), IN*O*8)!=0) { return 11 }
        if (cuMemAlloc_v2(loc(dY), S*O*8)!=0) { return 11 }
        if (cuMemAlloc_v2(loc(s), S*R*8)!=0) { return 11 }
        if (cuMemAlloc_v2(loc(gv), S*O*8)!=0) { return 11 }
        if (cuMemAlloc_v2(loc(ds), S*R*8)!=0) { return 11 }
        if (cuMemAlloc_v2(loc(dU), IN*R*8)!=0) { return 11 }
        if (cuMemAlloc_v2(loc(dV), R*O*8)!=0) { return 11 }
        if (cuMemAlloc_v2(loc(dxl), S*IN*8)!=0) { return 11 }
        if (cuMemAlloc_v2(loc(dxb), S*IN*8)!=0) { return 11 }
        if (cuMemAlloc_v2(loc(PB), 48)!=0) { return 11 }
        e<Int> = download(read_bin("native/out/bwd2_x.bin"), x, S*IN*8); if (e!=0) { return 20 }
        e = download(read_bin("native/out/bwd2_U.bin"), U, IN*R*8); if (e!=0) { return 21 }
        e = download(read_bin("native/out/bwd2_V.bin"), V, R*O*8); if (e!=0) { return 22 }
        e = download(read_bin("native/out/bwd2_W.bin"), W, IN*O*8); if (e!=0) { return 23 }
        e = download(read_bin("native/out/bwd2_dY.bin"), dY, S*O*8); if (e!=0) { return 24 }
        e = download(read_bin("native/out/bwd2_s.bin"), s, S*R*8); if (e!=0) { return 25 }
        e = download(read_bin("native/out/bwd2_gv.bin"), gv, S*O*8); if (e!=0) { return 26 }

        rc = setlaunch(gat, PB, gv, V, ds, S, R, O, S*R); if (rc != 0) { return 40 }   # ds = gv @ V^T
        rc = setlaunch(gbt, PB, x, ds, dU, S, IN, R, IN*R); if (rc != 0) { return 41 }  # dU = x^T ds
        rc = setlaunch(gbt, PB, s, gv, dV, S, R, O, R*O); if (rc != 0) { return 42 }    # dV = s^T gv
        rc = setlaunch(gat, PB, ds, U, dxl, S, IN, R, S*IN); if (rc != 0) { return 43 } # dx_lora = ds @ U^T
        rc = setlaunch(gat, PB, dY, W, dxb, S, IN, O, S*IN); if (rc != 0) { return 44 } # dx_base = dY @ W^T
        cuCtxSynchronize()
        e = dumpf(ds, S*R, "native/out/bwd2_ds.txt"); if (e!=0) { return 50 }
        e = dumpf(dU, IN*R, "native/out/bwd2_dU.txt"); if (e!=0) { return 51 }
        e = dumpf(dV, R*O, "native/out/bwd2_dV.txt"); if (e!=0) { return 52 }
        e = dumpf(dxl, S*IN, "native/out/bwd2_dx_lora.txt"); if (e!=0) { return 53 }
        e = dumpf(dxb, S*IN, "native/out/bwd2_dx_base.txt"); if (e!=0) { return 54 }
        println("BWD2_PROBE_DONE")
        return 0
    }
    return 0
}
