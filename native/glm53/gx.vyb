# gx.vyb — the GLM-5.3 checkpoint index, Vyb-only (no Python in the path).
#
# Resolves tensor names to (shard, offset, length, dtype) via:
#   1. model.safetensors.index.json (15.5 MB, 150,226 entries) parsed ONCE into a
#      name -> shard table. NOTE: JsonDoc.get(id, key) is a LINEAR scan over an
#      object's children, so a keyed lookup per name is O(n^2) (>5 min, killed);
#      gx_index walks the children by index (elem + ckey_at) and is O(n) (~200 ms);
#   2. that shard's safetensors header (native/torchload/safetensors.vyb, already
#      gated byte-identical against an independent Python oracle) for the byte range.
#
# Scanning all 83 headers instead was measured too slow (>7 min) in Vyb — the
# index-first order is what makes this practical.
#
# Nothing here touches CUDA: gx answers WHERE the bytes are. A host driver opens the
# shard, reads the range and uploads it (the native/host/*_driver pattern).
import safetensors
import json_parse
import io::{open_read, read_all, read_at, close}
import env::{env_get}
import time::{time_mono_millis}

share(all)
struct GxLoc {
    found<Vec<Int>>,
    shard<Vec<Int>>,
    tix<Vec<Int>>,
    off<Vec<Int>>,
    nbytes<Vec<Int>>,
    dts<Vec<String>>,
    paths<Vec<String>>
}

share(all)
gx_pad5(n<Int>)<String> -> {
    s<String> = n.to_string()
    while (s.len() < 5) { s = "0" + s }
    return s
}

share(all)
gx_shard_path(dir<String>, shard<Int>, total<Int>)<String> -> {
    return dir + "/model-" + gx_pad5(shard) + "-of-" + gx_pad5(total) + ".safetensors"
}

share(all)
gx_read_index(dir<String>)<String> -> {
    r<String> = ""
    match (open_read(dir + "/model.safetensors.index.json")) {
        f -> {
            match (read_all(f)) {
                s -> { r = s }
                ? -> { r = "" }
            }
            close(f)
        }
        ? -> { r = "" }
    }
    return r
}

# Shard number for a tensor name, from the index text; 0 when absent.
# The weight_map entries read `"<name>": "model-00003-of-00083.safetensors"`.
share(all)
gx_shard_for(index<String>, name<String>)<Int> -> {
    if (index.len() == 0) { return 0 }
    key<String> = "\"" + name + "\": \"model-"
    p<Int> = index.index_of(key)
    if (p < 0) { return 0 }
    d0<Int> = p + key.len()
    n<Int> = 0
    i<Int> = 0
    while (i < 5) {
        c<Int> = (index.char_at(d0 + i) as Int) & 255
        if (c < 48 || c > 57) { return 0 }
        n = n * 10 + (c - 48)
        i = i + 1
    }
    return n
}

# (A module-level st_open memo was attempted here and parked: assigning a global
# StIndex crashed glibc — see the note in gx_resolve_idx. The JsonDoc string leak
# needs a runtime-side fix first.)

# Resolve every wanted name: index -> shard -> header -> byte range.
#
# st_open() parses one shard's header (~8 ms, 1185 tensors). Opening it per NAME was
# 9 opens (73 ms) per expert resolve -> 8 s per MoE layer and ~1.2 GB of retained header
# structs per layer in the 45-layer prefill. Names are shard-ordered, so keep the last
# opened header and reopen only when the shard changes.
share(all)
gx_resolve(dir<String>, total<Int>, want<Vec<String>>)<GxLoc> -> {
    return gx_resolve_idx(gx_read_index(dir), dir, total, want)
}

# Same resolution with the index text already in hand. A hot loop that resolves many batches
# (one per expert) was re-reading and re-parsing the 15.5 MB index every call: hold it once.
share(all)
gx_resolve_idx(index<String>, dir<String>, total<Int>, want<Vec<String>>)<GxLoc> -> {
    g<GxLoc> = GxLoc { found = Vec(), shard = Vec(), tix = Vec(), off = Vec(), nbytes = Vec(),
                       dts = Vec(), paths = Vec() }
    println("MARK resolve-enter")
    i<Int> = 0
    for (i in 0..want.len() - 1) {
        g.found.push(0)
        g.shard.push(0)
        g.tix.push(-1)
        g.off.push(-1)
        g.nbytes.push(0)
        g.dts.push("")
        g.paths.push("")
    }
    lastsh<Int> = 0
    ix<StIndex> = st_open("")
    w<Int> = 0
    while (w < want.len()) {
        sh<Int> = gx_shard_for(index, want.get(w))
        if (sh > 0) {
            if (sh != lastsh || ix.n == 0) {
                path<String> = gx_shard_path(dir, sh, total)
                # NOTE: a module-level memo (g_stc_ix reassignment) crashes glibc
                # ("double free or corruption") — global struct assignment appears
                # to release a value whose strings are still shared. Parked; the
                # proper fix is JsonDoc string release in the runtime.
                ix = st_open(path)
                lastsh = sh
            }
            if (ix.n > 0) {
                println("MARK post-st-open-shard w" + w.to_string())
                t<Int> = st_find(view(ix), want.get(w))
                if (t >= 0) {
                    g.found.set(w, 1)
                    g.shard.set(w, sh)
                    g.tix.set(w, t)
                    g.off.set(w, ix.data_base + ix.doff.get(t))
                    g.nbytes.set(w, ix.dlen.get(t))
                    g.dts.set(w, ix.dtypes.get(t))
                    g.paths.set(w, ix.path)
                }
            }
        }
        w = w + 1
    }
    println("MARK resolve-exit")
    return g
}

# One layer's expert block inside the index text. The expert entries of a layer are
# CONTIGUOUS in the index (measured 358,501 bytes between layers.3 and layers.4), so a
# single index_of finds the block and every per-expert name lookup can then search a
# ~400 KB window instead of the whole 15.5 MB index. This is not a micro-optimisation:
# per-NAME scans over the full index cost 19 MINUTES per MoE layer (T_MOE
# resolve=1145661 ms for one layer, ~13.5 h for the 45-layer run); inside the window
# the same 9 lookups are ~30x cheaper.
share(all)
gx_expert_window(index<String>, layer_prefix<String>)<Vec<Int>> -> {
    w<Vec<Int>> = Vec()
    ws<Int> = 0
    we<Int> = 0
    p<Int> = index.index_of("\"" + layer_prefix + "mlp.experts.")
    if (p >= 0) {
        ws = p
        we = p + 400000
        if (we > index.len()) { we = index.len() }
    }
    w.push(ws)
    w.push(we)
    return w
}

# gx_resolve_idx with the shard lookup narrowed to [ws, we) of the index text; a name
# that falls outside the window still resolves (falls back to the full-index scan).
share(all)
gx_resolve_win(index<String>, dir<String>, total<Int>, want<Vec<String>>,
               ws<Int>, we<Int>)<GxLoc> -> {
    g<GxLoc> = GxLoc { found = Vec(), shard = Vec(), tix = Vec(), off = Vec(), nbytes = Vec(),
                       dts = Vec(), paths = Vec() }
    win<String> = ""
    if (ws > 0 && we > ws) { win = index.substring(ws, we) }
    i<Int> = 0
    for (i in 0..want.len() - 1) {
        g.found.push(0)
        g.shard.push(0)
        g.tix.push(-1)
        g.off.push(-1)
        g.nbytes.push(0)
        g.dts.push("")
        g.paths.push("")
    }
    lastsh<Int> = 0
    ix<StIndex> = st_open("")
    w<Int> = 0
    while (w < want.len()) {
        sh<Int> = 0
        if (win.len() > 0) { sh = gx_shard_for(win, want.get(w)) }
        if (sh == 0) { sh = gx_shard_for(index, want.get(w)) }
        if (sh > 0) {
            if (sh != lastsh || ix.n == 0) {
                path<String> = gx_shard_path(dir, sh, total)
                ix = st_open(path)
                lastsh = sh
            }
            if (ix.n > 0) {
                t<Int> = st_find(view(ix), want.get(w))
                if (t >= 0) {
                    g.found.set(w, 1)
                    g.shard.set(w, sh)
                    g.tix.set(w, t)
                    g.off.set(w, ix.data_base + ix.doff.get(t))
                    g.nbytes.set(w, ix.dlen.get(t))
                    g.dts.set(w, ix.dtypes.get(t))
                    g.paths.set(w, ix.path)
                }
            }
        }
        w = w + 1
    }
    return g
}


# Resolve names against an ALREADY-OPEN shard header. st_open() re-parses a shard
# header (~757 ms measured on shard 3 of the 83-shard checkpoint) and the MoE loops
# were paying it once PER EXPERT — 288 experts x 0.757 s = 3.6 min per layer, i.e.
# the whole 13.5 h of the 45-layer run. The caller keeps one StIndex for the shard it
# is currently in and only re-opens when the expert's shard changes (3 shards per
# layer, 2 of 288 experts straddle two). `sh` is the shard the header belongs to.
share(all)
gx_resolve_ix(ix<their<StIndex const>>, sh<Int>, want<Vec<String>>)<GxLoc> -> {
    g<GxLoc> = GxLoc { found = Vec(), shard = Vec(), tix = Vec(), off = Vec(), nbytes = Vec(),
                       dts = Vec(), paths = Vec() }
    i<Int> = 0
    for (i in 0..want.len() - 1) {
        g.found.push(0)
        g.shard.push(0)
        g.tix.push(-1)
        g.off.push(-1)
        g.nbytes.push(0)
        g.dts.push("")
        g.paths.push("")
    }
    if (ix.n > 0) {
        w<Int> = 0
        while (w < want.len()) {
            t<Int> = st_find(ix, want.get(w))
            if (t >= 0) {
                g.found.set(w, 1)
                g.shard.set(w, sh)
                g.tix.set(w, t)
                g.off.set(w, ix.data_base + ix.doff.get(t))
                g.nbytes.set(w, ix.dlen.get(t))
                g.dts.set(w, ix.dtypes.get(t))
                g.paths.set(w, ix.path)
            }
            w = w + 1
        }
    }
    return g
}

# Cached-header resolve with the straddle case handled: when every wanted name is in
# the cached shard `sh` the open header is reused (no st_open); the ~2-in-288 experts
# whose tensors split across two shards go down the full path instead.
share(all)
gx_resolve_maybe(ix<their<StIndex const>>, sh<Int>, index<String>, dir<String>, total<Int>,
                 want<Vec<String>>, win<String>, ws<Int>, we<Int>)<GxLoc> -> {
    if (ix.n > 0) {
        g<GxLoc> = gx_resolve_ix(ix, sh, want)
        miss<Int> = 0
        i<Int> = 0
        while (i < g.found.len()) {
            if (g.found.get(i) != 1) { miss = 1 }
            i = i + 1
        }
        if (miss == 0) { return g }
    }
    return gx_resolve_win(index, dir, total, want, ws, we)
}

# Cached-header resolve; any name the cached header does not hold (the ~2-in-288 experts
# whose tensors straddle two shards) is looked up by scanning the layer's expert-block
# window and opening that shard for the lookup. Takes NO full-index parameter: passing
# the 15.5 MB index text into a per-expert call was 288 deep copies per layer.
share(all)
gx_resolve_ix2(ix<their<StIndex const>>, sh<Int>, want<Vec<String>>,
               win<String>, dir<String>, total<Int>)<GxLoc> -> {
    g<GxLoc> = gx_resolve_ix(ix, sh, want)
    w<Int> = 0
    while (w < want.len()) {
        if (g.found.get(w) != 1) {
            sh2<Int> = gx_shard_for(win, want.get(w))
            if (sh2 > 0) {
                ix2<StIndex> = st_open(gx_shard_path(dir, sh2, total))
                t<Int> = st_find(view(ix2), want.get(w))
                if (t >= 0) {
                    g.found.set(w, 1)
                    g.shard.set(w, sh2)
                    g.tix.set(w, t)
                    g.off.set(w, ix2.data_base + ix2.doff.get(t))
                    g.nbytes.set(w, ix2.dlen.get(t))
                    g.dts.set(w, ix2.dtypes.get(t))
                    g.paths.set(w, ix2.path)
                }
            }
        }
        w = w + 1
    }
    return g
}

share(all)
gx_bytes(g<GxLoc>, i<Int>)<Int> -> {
    if (i < 0 || i >= g.nbytes.len()) { return 0 }
    return g.nbytes.get(i)
}

# Read a byte range straight from a shard (the layer-load path already has the
# offsets from the header and does not need a GxLoc round trip).
share(all)
gx_read_at(path<String>, off<Int>, n<Int>)<String> -> {
    r<String> = ""
    match (open_read(path)) {
        f -> {
            match (read_at(f, off, n)) {
                s -> { r = s }
                ? -> { r = "" }
            }
            close(f)
        }
        ? -> { r = "" }
    }
    return r
}

# Read a resolved tensor's bytes. The caller uploads or hashes immediately: a
# multi-GB read must not be held twice.
share(all)
gx_read(g<GxLoc>, i<Int>)<String> -> {
    r<String> = ""
    if (i < 0 || i >= g.found.len()) { return r }
    if (g.found.get(i) != 1) { return r }
    match (open_read(g.paths.get(i))) {
        f -> {
            match (read_at(f, g.off.get(i), g.nbytes.get(i))) {
                s -> { r = s }
                ? -> { r = "" }
            }
            close(f)
        }
        ? -> { r = "" }
    }
    return r
}

# ---- fast whole-model plan (loader path) -------------------------------------------
#
# gx_shard_for above re-reads the index text per name and st_open()s a shard header per
# tensor: fine for a probe, unusable for a load (150k tensors). gx_plan resolves the
# WHOLE checkpoint in two linear passes: the weight_map once (name -> shard), then each
# of the 83 shard headers once (shard-major), filling a dense plan the loader then walks
# layer by layer.

share(all)
struct GxIndex {
    n<Int>,
    names<Vec<String>>,
    shard<Vec<Int>>
}

share(all)
struct GxTensor {
    name<String>,
    shard<Int>,
    off<Int>,
    nbytes<Int>,
    dtype<String>
}

share(all)
struct GxPlan {
    n<Int>,
    found<Int>,
    tensors<Vec<GxTensor>>
}

share(all)
gx_digits(s<String>)<Int> -> {
    n<Int> = 0
    i<Int> = 0
    while (i < s.len()) {
        c<Int> = (s.char_at(i) as Int) & 255
        if (c >= 48 && c <= 57) { n = n * 10 + (c - 48) }
        i = i + 1
    }
    return n
}

# weight_map: name -> shard number, one linear walk of the object's children.
share(all)
gx_index(dir<String>)<GxIndex> -> {
    ix<GxIndex> = GxIndex { n = 0, names = Vec(), shard = Vec() }
    text<String> = gx_read_index(dir)
    if (text.len() == 0) { return ix }
    match (json_parse(text)) {
        d -> {
            rid<Int> = d.rootid()
            wm<Int> = d.get(rid, "weight_map")
            if (wm >= 0) {
                cnt<Int> = d.nchildren(wm)
                i<Int> = 0
                while (i < cnt) {
                    ix.names.push(d.ckey_at(wm, i))
                    # "model-00007-of-00083.safetensors" -> 7
                    ix.shard.push(gx_digits(d.hstr(d.elem(wm, i))))
                    i = i + 1
                }
                ix.n = ix.names.len()
            }
        }
        ? -> { }
    }
    return ix
}

# NOTE: this module deliberately does NOT offer a whole-model plan function. Building
# a 150k-entry plan struct in memory and walking it repeatedly crashed the Vyb runtime
# (SIGSEGV, position varies) and degraded progressively as the heap grew. The loader
# streams instead: see native/host/gx_plan.vyb, which walks the shards and writes the
# plan out as it goes, holding only per-layer counters.
