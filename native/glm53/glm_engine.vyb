# glm_decode_chain.vyb -- the FULL 45-layer GLM-5.3-Flash decode chain in one Vyb
# process: a 20-token batched prefill (phase 1) followed by two teacher-forced decode
# steps through all 45 layers (phase 2), with every cache built and carried in-process
# (HANDOFF section 11).
#
#   phase 1  (R = 20): the glm_prefill.vyb sites verbatim -- kda_attn_site /
#            dsa_attn_site / ffn_dense_site / tail_site -- over prompt tokens 0..19,
#            saving as it goes:
#              KDA layers (34): recurrence state [64,128,128] + conv rings [3,8192]
#                               per tensor q/k/v (the last 3 PRE-conv rows)
#              DSA layers (11): ckv [20,512], indexer k [20,128], gsc [20,128]
#   phase 2  (R = 1): tokens ids[20] and ids[21] walked through all 45 layers in
#            order, KDA/DSA dispatch by layer index, appending to the DSA caches and
#            updating the KDA state/rings. The decode math is the gated
#            glm_decode_step.vyb (KDA) / glm_decode_l3.vyb (DSA) step bodies.
#
# The gate is free and exact: prefill token t's per-layer streams equal decode step
# t's per-layer streams element-wise (causal attention makes the stepwise walk
# exact). The reference is the modified prefill's `chain<N>` dumps() lines (last two
# tokens' per-layer streams, 2^40-scaled ints) in native/out/prefill_vyb.txt; this
# driver dumps `d<t>l<n>s2` dumps() lines to native/out/decchain_vyb.txt.
# native/glm53/verify_decode_chain.py compares element-wise and prints
# DECODE_CHAIN_MATCH.
#
# Generated by native/glm53/build_decode_chain.py -- do not hand-edit the copied
# blocks; edit the sources and regenerate.
import io::{open_read, read_at, read_all, open_write, open_append, write_str, close}
import env::{env_get}
import safetensors
import gx
import collections::{HashMap}
import tensor::{tensor_init, module_load_path, module_func, dev_alloc, bulk_htod, bulk_dtoh, sync, gemm}
import vmath::{vexp, vsqrt}
import time::{time_mono_millis}

# The driver-API calls that bindings/cuda/cuda_binding.vyb already declares are IMPORTED
# rather than re-declared: a second declaration in this file makes any module that imports
# BOTH fail with "Duplicate symbol after splice: 'cuModuleLoadData'". Only the four
# functions the binding does not carry are declared here.
import cuda_binding::{cuMemFree_v2, cuMemAlloc_v2, cuMemcpyHtoD_v2, cuCtxSynchronize,
                      cuModuleLoadData, cuModuleGetFunction}

extern "C" {
    cuMemGetInfo_v2(free<loc<Int>>, total<loc<Int>>)<CInt>
    vyb_str_stats()<CInt>
    cuda_launch4i(f<loc<CVoid>>, gridX<CUInt>, gridY<CUInt>, gridZ<CUInt>,
                  blockX<CUInt>, blockY<CUInt>, blockZ<CUInt>,
                  a0<Int>, a1<Int>, a2<Int>, a3<Int>)<CInt>
    malloc_trim(pad<Int>)<CInt>
}

# phase 1 runs R = 20 prompt tokens (the decode steps re-walk tokens 20 and 21, so
# the caches must NOT contain them); phase 2 runs with R = 1 (set in main).
share(all)
R<Int> = 20
share(all)
CAPT<Int> = 22          # DSA cache rows per layer slot: 20 prefill + 2 decode
share(all)
NLAY<Int> = 45
share(all)
NSLOT<Int> = 34         # KDA layer slots
share(all)
NDSLOT<Int> = 11        # DSA layer slots
share(all)
H<Int> = 4096
share(all)
HC<Int> = 4
share(all)
HEADS<Int> = 64
share(all)
KD<Int> = 128
share(all)
NOPE<Int> = 256
share(all)
VDIM<Int> = 256
share(all)
KV_LORA<Int> = 512
share(all)
Q_LORA<Int> = 1536
share(all)
IHEADS<Int> = 32
share(all)
IDIM<Int> = 128
share(all)
KPOOL<Int> = 4
share(all)
TOPK<Int> = 2048        # indexer: top-k pool columns
share(all)
ROUTE_TOPK<Int> = 8     # MoE: experts per token -- the attn site's TOPK is 2048, and
                        # shadowing it here silently made the router pick 288 experts
share(all)
INTER<Int> = 12288
share(all)
NE<Int> = 288
share(all)
EINTER<Int> = 2048
share(all)
EPS<Float> = 1e-5
share(all)
LN_EPS<Float> = 1e-6
share(all)
HC_EPS<Float> = 1e-6
share(all)
L2_EPS<Float> = 1e-6
share(all)
GATE_LB<Float> = -5.0
share(all)
CONV_K<Int> = 4
share(all)
SCALE40<Float> = 1099511627776.0
share(all)
SWIGLU_LIMIT<Float> = 10.0
share(all)
ROUTED_SCALE<Float> = 2.5

# ============================================================ prefill helpers (verbatim)

share(all)
trim_heap()<Int> -> {
    r<Int> = 0
    freedom {
        r = malloc_trim(0) as Int
    }
    return r
}

share(all)
vecf()<Vec<Float>> -> {          # a typed empty Vec<Float> (a bare `x = Vec()` infers Vec<Int>)
    e<Vec<Float>> = Vec()
    return e
}

share(all)
di(v<Float>)<Int> -> {
    return (v * SCALE40) as Int
}

share(all)
digest(name<String>, v<Vec<Float>>)<String> -> {
    println("DIGESTENTRY " + name + " len=" + v.len().to_string() + " v0=" + v.get(0).to_string())
    s<Float> = 0.0
    a<Float> = 0.0
    q<Float> = 0.0
    m<Float> = 0.0
    i<Int> = 0
    while (i < v.len()) {
        x<Float> = v.get(i)
        if (name == "x" && (i < 3 || i == 100 || i == 1000 || i == 10000 || i == 45056 || i == 90111)) {
            println("ONSET i=" + i.to_string() + " v=" + x.to_string() + " s=" + s.to_string()) }
        s = s + x
        if (x < 0.0) { a = a - x } else { a = a + x }
        q = q + x * x
        t<Float> = x
        if (t < 0.0) { t = 0.0 - t }
        if (t > m) { m = t }
        i = i + 1
    }
    out<String> = name + " n=" + v.len().to_string() + " sum=" + di(s).to_string() +
                  " abs=" + di(a).to_string() + " sq=" + di(q).to_string() +
                  " max=" + di(m).to_string()
    i = 0
    while (i < 8) {
        hv<Float> = 0.0
        if (i < v.len()) { hv = v.get(i) }
        out = out + " v" + i.to_string() + "=" + di(hv).to_string()
        i = i + 1
    }
    return out
}

share(all)
sigmoid(x<Float>)<Float> -> {
    return 1.0 / (1.0 + vexp(0.0 - x))
}

# per-row rms over width D, times w when w.len() == D

share(all)
rms_rows(x<their<Vec<Float> const>>, rows<Int>, D<Int>, w<Vec<Float>>)<Vec<Float>> -> {
    dst<Vec<Float>> = Vec()
    r<Int> = 0
    i<Int> = 0
    while (r < rows) {
        ss<Float> = 0.0
        i = 0
        base<Int> = r * D
        while (i < D) {
            v<Float> = x.get(base + i)
            ss = ss + v * v
            i = i + 1
        }
        inv<Float> = 1.0 / vsqrt(ss / (D as Float) + EPS, 40)
        i = 0
        while (i < D) {
            vv<Float> = x.get(base + i) * inv
            if (w.len() == D) { vv = vv * w.get(i) }
            dst.push(vv)
            i = i + 1
        }
        r = r + 1
    }
    return dst
}

# LayerNorm (mean/variance, weight + bias) — the indexer's k_norm is a real LayerNorm

share(all)
ln_rows(x<Vec<Float>>, rows<Int>, D<Int>, w<Vec<Float>>, b<Vec<Float>>)<Vec<Float>> -> {
    dst<Vec<Float>> = Vec()
    r<Int> = 0
    i<Int> = 0
    while (r < rows) {
        mu<Float> = 0.0
        i = 0
        while (i < D) {
            mu = mu + x.get(r * D + i)
            i = i + 1
        }
        mu = mu / (D as Float)
        vr<Float> = 0.0
        i = 0
        while (i < D) {
            dv<Float> = x.get(r * D + i) - mu
            vr = vr + dv * dv
            i = i + 1
        }
        vr = vr / (D as Float)
        inv<Float> = 1.0 / vsqrt(vr + LN_EPS, 40)
        i = 0
        while (i < D) {
            dst.push((x.get(r * D + i) - mu) * inv * w.get(i) + b.get(i))
            i = i + 1
        }
        r = r + 1
    }
    return dst
}

share(all)
f32_at(raw<String>, idx<Int>)<Float> -> {
    w<Int> = 0
    b<Int> = 0
    while (b < 4) {
        c<Int> = (raw.char_at(idx * 4 + b) as Int) & 255
        w = w | (c << (b * 8))
        b = b + 1
    }
    sign<Float> = 1.0
    if ((w & 2147483648) != 0) { sign = 0.0 - 1.0 }
    ex<Int> = (w >> 23) & 255
    man<Int> = w & 8388607
    v<Float> = 0.0
    if (ex > 0) {
        den<Float> = 1.0 + (man as Float) / 8388608.0
        p2<Float> = 1.0
        e2<Int> = 0
        while (e2 < (ex - 127)) {
            p2 = p2 * 2.0
            e2 = e2 + 1
        }
        while (e2 > (ex - 127)) {
            p2 = p2 / 2.0
            e2 = e2 - 1
        }
        v = sign * den * p2
    }
    return v
}

# ---------------------------------------------------------------- device plumbing

share(all)
alloc_dev(n<Int>)<Int> -> {
    var<Int> p = 0
    freedom {
        if (cuMemAlloc_v2(loc(p), n) != 0) { return 0 }
    }
    return p
}

share(all)
free_dev(p<Int>)<Int> -> {
    if (p == 0) { return 0 }
    freedom {
        cuMemFree_v2(p)
    }
    return 0
}

share(all)
deq_bf16(faddr<Int>, raw<String>, n<Int>, z<Int>)<Int> -> {
    var<Int> out = 0
    freedom {
        var<Int> q = 0
        var<Int> o = 0
        qrc<Int> = cuMemAlloc_v2(loc(q), raw.len()) as Int
        if (qrc != 0) { println("DEQFAIL alloc q rc=" + qrc.to_string() + " len=" + raw.len().to_string()); return 0 }
        orc<Int> = cuMemAlloc_v2(loc(o), n * 8) as Int
        if (orc != 0) { println("DEQFAIL alloc o rc=" + orc.to_string() + " n=" + n.to_string()); return 0 }
        hrc<Int> = cuMemcpyHtoD_v2(q, raw, raw.len()) as Int
        if (hrc != 0) { println("DEQFAIL htod rc=" + hrc.to_string() + " len=" + raw.len().to_string()); return 0 }

        blocks<Int> = (n + 255) / 256
        lrc<Int> = cuda_launch4i(from<loc<CVoid>>(faddr), blocks, 1, 1, 256, 1, 1, q, o, n, z) as Int
        if (lrc != 0) {
            println("DEQFAIL launch rc=" + lrc.to_string() + " blocks=" + blocks.to_string() + " len=" + raw.len().to_string())
            return 0
        }
        cuCtxSynchronize()
        cuMemFree_v2(q)
        out = o
    }
    return out
}

// deq_bf16f — the f32-output twin of deq_bf16: same bf16 raw htod + launch,
// but the output is n*4 bytes of f32 (bf16deq32) and the caller must consume
// it with an f32 gemm (mm_host32 / gemm32_p) or cast32 it back to f64.
share(all)
deq_bf16f(faddr32<Int>, raw<String>, n<Int>, z<Int>)<Int> -> {
    var<Int> outf = 0
    freedom {
        var<Int> qf = 0
        var<Int> of = 0
        qrcf<Int> = cuMemAlloc_v2(loc(qf), raw.len()) as Int
        if (qrcf != 0) { println("DEQFAILF alloc q rc=" + qrcf.to_string()); return 0 }
        orcf<Int> = cuMemAlloc_v2(loc(of), n * 4) as Int
        if (orcf != 0) { println("DEQFAILF alloc o rc=" + orcf.to_string()); return 0 }
        hrcf<Int> = cuMemcpyHtoD_v2(qf, raw, raw.len()) as Int
        if (hrcf != 0) { println("DEQFAILF htod rc=" + hrcf.to_string()); return 0 }
        blocksf<Int> = (n + 255) / 256
        lrcf<Int> = cuda_launch4i(from<loc<CVoid>>(faddr32), blocksf, 1, 1, 256, 1, 1, qf, of, n, z) as Int
        if (lrcf != 0) {
            println("DEQFAILF launch rc=" + lrcf.to_string())
            return 0
        }
        cuCtxSynchronize()
        cuMemFree_v2(qf)
        outf = of
    }
    return outf
}

// mapdev_build — the serve's map setup, exported for drivers: allocates the
// 8 KB map buffer, copies the map.bin bytes, and runs exl3inv to build the
// inverse map at mapdev + 16 + nbody. Returns the mapdev handle (0 on failure)
// -- the caller computes invbase = mapdev + 16 + (mapd.len() - 16).
share(all)
mapdev_build(finvk<Int>, mapd<String>)<Int> -> {
    var<Int> out = 0
    freedom {
        md<Int> = 0
        if (cuMemAlloc_v2(loc(md), 8192) == 0) {
            if (cuMemcpyHtoD_v2(md, mapd, mapd.len()) == 0) {
                nb<Int> = mapd.len() - 16
                hp<Int> = 0
                if (cuMemAlloc_v2(loc(hp), 64) == 0) {
                    cuMemcpyHtoD_v2(hp + 0, loc(md), 8)
                    cuMemcpyHtoD_v2(hp + 8, loc(nb), 8)
                    lrc<Int> = cuda_launch4i(from<loc<CVoid>>(finvk), 1, 1, 1, 256, 1, 1, hp, 0, 0, 0) as Int
                    srl<Int> = cuCtxSynchronize() as Int
                    if (lrc == 0 && srl == 0) { out = md }
                    cuMemFree_v2(hp)
                }
            }
            if (out == 0) { cuMemFree_v2(md) }
        }
    }
    return out
}

// launch_kernel — a single-params-buffer launch for callers outside the engine
// (the engine's own sites inline cuda_launch4i; the FFI decl is file-private).
share(all)
launch_kernel(faddr<Int>, grid<Int>, pb<Int>)<Int> -> {
    freedom {
        rc<Int> = cuda_launch4i(from<loc<CVoid>>(faddr), grid, 1, 1, 256, 1, 1, pb, 0, 0, 0) as Int
        return rc
    }
    return 1
}

share(all)
load_fn(ptx_path<String>, fn_name<String>)<Int> -> {
    ptx<String> = ""
    match (open_read(ptx_path)) {
        f -> { match (read_all(f)) { s -> { ptx = s } ? -> { return 0 } } close(f) }
        ? -> { return 0 }
    }
    var<Int> addr_out = 0
    freedom {
        var<loc<loc<CVoid>>> m = from<loc<loc<CVoid>>>(0)
        if (cuModuleLoadData(loc(m), ptx) != 0) { return 0 }
        var<loc<CVoid>> f = from<loc<CVoid>>(0)
        if (cuModuleGetFunction(loc(f), m, fn_name) != 0) { return 0 }
        addr_out = addr(f)
    }
    return addr_out
}

share(all)
mm_dev(A<Int>, B<Int>, M<Int>, N<Int>, K<Int>, faddr<Int>)<Int> -> {
    var<Int> C = 0
    var<Int> scr = 0
    C = alloc_dev(M * N * 8)
    scr = alloc_dev(64)
    if (C == 0 || scr == 0) { return 0 }
    if (gemm(faddr, scr, A, B, C, M, N, K, 1.0, 0.0) != 0) { return 0 }
    sync()
    freedom {
        mmrrc<Int> = cuCtxSynchronize() as Int
        if (mmrrc != 0) { println("MMSYNC rc=" + mmrrc.to_string() + " M=" + M.to_string() + " N=" + N.to_string() + " K=" + K.to_string()) }
    }
    free_dev(scr)
    return C
}

share(all)
mm_host(x<Vec<Float>>, rows<Int>, K<Int>, B<Int>, N<Int>, faddr<Int>)<Vec<Float>> -> {
    out<Vec<Float>> = Vec()
    var<Int> dA = 0
    dA = alloc_dev(rows * K * 8)
    if (dA == 0) { return out }
    bulk_htod(dA, view(x))
    var<Int> dC = 0
    dC = mm_dev(dA, B, rows, N, K, faddr)
    free_dev(dA)
    if (dC == 0) { return out }
    out = bulk_dtoh(dC, rows * N)
    free_dev(dC)
    return out
}

// wr_pdev — write one Int into a device params buffer (the loc(v) traffic is
// freedom-only, so this is a fn not an inline).
share(all)
wr_pdev(p<Int>, off<Int>, v<Int>)<Int> -> {
    rcw<Int> = 1
    freedom { rcw = cuMemcpyHtoD_v2(p + off, loc(v), 8) as Int }
    return rcw
}

// mm_host32 — the f32-path twin of mm_host: A comes in as a host f64 Vec,
// is htod'd and cast32'd to f32 (the same cast path the layer uses for
// activations), B is already f32 on device (from exl3_deq32f), and the gemm
// runs the f32 split-K triple (gemm32_p + gemm32_r, f64 output) from
// layer.ptx. Returns the host f64 Vec like mm_host so callers are unchanged.
// pb must be a >=192-byte device params buffer. KSP=32 fixed, matching the
// verified gemm32_real probe (native/host/gemm32_real.vyb, rel <= 1.3e-5).
share(all)
mm_host32(x<Vec<Float>>, rows<Int>, K<Int>, B32<Int>, N<Int>, fcast32<Int>, fgp<Int>, fgr<Int>, pb<Int>)<Vec<Float>> -> {
    out32<Vec<Float>> = Vec()
    dA64<Int> = 0
    dA32<Int> = 0
    dSK<Int> = 0
    dCC<Int> = 0
    dA64 = alloc_dev(rows * K * 8)
    dA32 = alloc_dev((rows + 4) * K * 4)
    dSK = alloc_dev(32 * rows * N * 4)
    dCC = alloc_dev(rows * N * 8)
    if (dA64 == 0 || dA32 == 0 || dSK == 0 || dCC == 0) {
        if (dA64 != 0) { free_dev(dA64) }
        if (dA32 != 0) { free_dev(dA32) }
        if (dSK != 0) { free_dev(dSK) }
        if (dCC != 0) { free_dev(dCC) }
        return out32
    }
    bulk_htod(dA64, view(x))
    // cast32: params (src64, dst32, n) at pb[0..2]
    if (wr_pdev(pb, 0, dA64) != 0) { return out32 }
    if (wr_pdev(pb, 8, dA32) != 0) { return out32 }
    if (wr_pdev(pb, 16, rows * K) != 0) { return out32 }
    freedom {
        clrc<Int> = cuda_launch4i(from<loc<CVoid>>(fcast32), (rows * K + 255) / 256, 1, 1, 256, 1, 1, pb, 0, 0, 0) as Int
        csyn<Int> = cuCtxSynchronize() as Int
        if (clrc != 0 || csyn != 0) { println("MM32FAIL cast lrc=" + clrc.to_string() + " sync=" + csyn.to_string()) }
    }
    // gemm32_p: params (A, B, SK, M, N, K, NBLK, KSP) at pb[0..7]
    nblk<Int> = ((rows + 3) / 4 * N + 255) / 256
    if (wr_pdev(pb, 0, dA32) != 0) { return out32 }
    if (wr_pdev(pb, 8, B32) != 0) { return out32 }
    if (wr_pdev(pb, 16, dSK) != 0) { return out32 }
    if (wr_pdev(pb, 24, rows) != 0) { return out32 }
    if (wr_pdev(pb, 32, N) != 0) { return out32 }
    if (wr_pdev(pb, 40, K) != 0) { return out32 }
    if (wr_pdev(pb, 48, nblk) != 0) { return out32 }
    if (wr_pdev(pb, 56, 32) != 0) { return out32 }
    freedom {
        plrc<Int> = cuda_launch4i(from<loc<CVoid>>(fgp), nblk * 32, 1, 1, 256, 1, 1, pb, 0, 0, 0) as Int
        psyn<Int> = cuCtxSynchronize() as Int
        if (plrc != 0 || psyn != 0) { println("MM32FAIL p1 lrc=" + plrc.to_string() + " sync=" + psyn.to_string()) }
    }
    // gemm32_r: params (SK, CC, M, N, [gap], KSP) — KSP sits at +48, matching
    // the harness/probe layout (the +32/+40 slots are the legacy alpha/beta).
    if (wr_pdev(pb, 0, dSK) != 0) { return out32 }
    if (wr_pdev(pb, 8, dCC) != 0) { return out32 }
    if (wr_pdev(pb, 16, rows) != 0) { return out32 }
    if (wr_pdev(pb, 24, N) != 0) { return out32 }
    if (wr_pdev(pb, 48, 32) != 0) { return out32 }
    freedom {
        rlrc<Int> = cuda_launch4i(from<loc<CVoid>>(fgr), (rows * N + 255) / 256, 1, 1, 256, 1, 1, pb, 0, 0, 0) as Int
        rsyn<Int> = cuCtxSynchronize() as Int
        if (rlrc != 0 || rsyn != 0) { println("MM32FAIL p2 lrc=" + rlrc.to_string() + " sync=" + rsyn.to_string()) }
    }
    out32 = bulk_dtoh(dCC, rows * N)
    free_dev(dA64)
    free_dev(dA32)
    free_dev(dSK)
    free_dev(dCC)
    return out32
}

share(all)
silu(x<Float>)<Float> -> {
    return x * (1.0 / (1.0 + vexp(0.0 - x)))
}

share(all)
l2_rows(x<Vec<Float>>, rows<Int>, D<Int>)<Vec<Float>> -> {
    dst<Vec<Float>> = Vec()
    r<Int> = 0
    i<Int> = 0
    while (r < rows) {
        ss<Float> = 0.0
        i = 0
        while (i < D) {
            v<Float> = x.get(r * D + i)
            ss = ss + v * v
            i = i + 1
        }
        nrm<Float> = vsqrt(ss + L2_EPS, 40)
        i = 0
        while (i < D) {
            dst.push(x.get(r * D + i) / nrm)
            i = i + 1
        }
        r = r + 1
    }
    return dst
}

# NOTE the loop order: `dst` is built by PUSH, so the pushes must follow the array's
# row-major (t*C + c) order — iterating channels outside tokens silently produced a
# transposed result whose digests (sum/abs/sq/max) still matched.

share(all)
conv_silu(x<Vec<Float>>, rows<Int>, C<Int>, w<Vec<Float>>)<Vec<Float>> -> {
    dst<Vec<Float>> = Vec()
    c<Int> = 0
    t<Int> = 0
    j<Int> = 0
    while (t < rows) {
        c = 0
        while (c < C) {
            acc<Float> = 0.0
            j = 0
            while (j < CONV_K) {
                src<Int> = t + j - (CONV_K - 1)
                if (src >= 0) { acc = acc + x.get(src * C + c) * w.get(c * CONV_K + j) }
                j = j + 1
            }
            dst.push(silu(acc))
            c = c + 1
        }
        t = t + 1
    }
    return dst
}

# f32 -> f64 by hand (host Vyb has no bitcast)

share(all)
up_bytes(raw<String>, dst<Int>)<Int> -> {
    var<CInt> rc = 0
    freedom {
        rc = cuMemcpyHtoD_v2(dst, raw, raw.len())
    }
    return rc
}

# bf16 -> f64 on the device; z > 0 means the stored layout is (out,in) with in = z,
# so bf16deq writes the transpose [in,out]. Returns the device pointer (0 = failure).

share(all)
hc_glue(mv<Vec<Float>>, base<Vec<Float>>, scale<Vec<Float>>, streams<Vec<Float>>)<Vec<Float>> -> {
    pre<Vec<Float>> = Vec()
    post<Vec<Float>> = Vec()
    comb<Vec<Float>> = Vec()
    r<Int> = 0
    j<Int> = 0
    n0<Int> = 0
    a<Int> = 0
    b<Int> = 0
    mx<Float> = 0.0
    sm<Float> = 0.0
    it<Int> = 0
    h<Int> = 0
    d<Int> = 0
    p<Float> = 0.0
    v<Float> = 0.0
    n1<Int> = 0
    while (r < R) {
        j = 0
        while (j < HC) {
            pre.push(sigmoid(mv.get(r * 24 + j) * scale.get(0) + base.get(j)) + HC_EPS)
            post.push(2.0 * sigmoid(mv.get(r * 24 + HC + j) * scale.get(1) + base.get(HC + j)))
            j = j + 1
        }
        r = r + 1
    }
    n0 = 0
    while (n0 < R * HC * HC) {
        comb.push(0.0)
        n0 = n0 + 1
    }
    r = 0
    while (r < R) {
        a = 0
        while (a < HC) {
            b = 0
            while (b < HC) {
                comb.set((r * HC + a) * HC + b,
                         mv.get(r * 24 + 2 * HC + a * HC + b) * scale.get(2) +
                         base.get(2 * HC + a * HC + b))
                b = b + 1
            }
            a = a + 1
        }
        r = r + 1
    }
    r = 0
    while (r < R) {
        a = 0
        while (a < HC) {
            # per-ROW max, like gold's softmax(axis=-1, keepdims): a global max underflows
            # the smaller entries of a row whose logits sit far below the global peak, which
            # then differ by whole multiples after the eps floor.
            mx = 0.0 - 1e30
            b<Int> = 0
            while (b < HC) {
                v = comb.get((r * HC + a) * HC + b)
                if (v > mx) { mx = v }
                b = b + 1
            }
            sm = 0.0
            b = 0
            while (b < HC) {
                sm = sm + vexp(comb.get((r * HC + a) * HC + b) - mx)
                b = b + 1
            }
            b = 0
            while (b < HC) {
                comb.set((r * HC + a) * HC + b,
                         vexp(comb.get((r * HC + a) * HC + b) - mx) / sm)
                b = b + 1
            }
            a = a + 1
        }
        a = 0
        while (a < HC) {
            b = 0
            while (b < HC) {
                comb.set((r * HC + a) * HC + b, comb.get((r * HC + a) * HC + b) + HC_EPS)
                b = b + 1
            }
            a = a + 1
        }
        b = 0
        while (b < HC) {
            sm = 0.0
            a = 0
            while (a < HC) {
                sm = sm + comb.get((r * HC + a) * HC + b)
                a = a + 1
            }
            a = 0
            while (a < HC) {
                comb.set((r * HC + a) * HC + b, comb.get((r * HC + a) * HC + b) / (sm + HC_EPS))
                a = a + 1
            }
            b = b + 1
        }
        it = 1
        # gold: softmax -> colsum -> (sinkhorn_iters-1) x {rowsum, colsum}. One colsum pass
        # already happened above and `it` starts at 1, so < 20 is exactly 19 pairs.
        while (it < 20) {
            a = 0
            while (a < HC) {
                sm = 0.0
                b = 0
                while (b < HC) {
                    sm = sm + comb.get((r * HC + a) * HC + b)
                    b = b + 1
                }
                b = 0
                while (b < HC) {
                    comb.set((r * HC + a) * HC + b, comb.get((r * HC + a) * HC + b) / (sm + HC_EPS))
                    b = b + 1
                }
                a = a + 1
            }
            b = 0
            while (b < HC) {
                sm = 0.0
                a = 0
                while (a < HC) {
                    sm = sm + comb.get((r * HC + a) * HC + b)
                    a = a + 1
                }
                a = 0
                while (a < HC) {
                    comb.set((r * HC + a) * HC + b, comb.get((r * HC + a) * HC + b) / (sm + HC_EPS))
                    a = a + 1
                }
                b = b + 1
            }
            it = it + 1
        }
        r = r + 1
    }
    col<Vec<Float>> = Vec()
    n1 = 0
    while (n1 < R * H) {
        col.push(0.0)
        n1 = n1 + 1
    }
    r = 0
    while (r < R) {
        h = 0
        while (h < HC) {
            p = pre.get(r * HC + h)
            d = 0
            while (d < H) {
                col.set(r * H + d, col.get(r * H + d) + p * streams.get((r * HC + h) * H + d))
                d = d + 1
            }
            h = h + 1
        }
        r = r + 1
    }
    res<Vec<Float>> = Vec()
    n1 = 0
    while (n1 < col.len()) {
        res.push(col.get(n1))
        n1 = n1 + 1
    }
    n1 = 0
    while (n1 < post.len()) {
        res.push(post.get(n1))
        n1 = n1 + 1
    }
    n1 = 0
    while (n1 < comb.len()) {
        res.push(comb.get(n1))
        n1 = n1 + 1
    }
    return res
}

share(all)
dumps(name<String>, v<Vec<Float>>)<String> -> {
    out<String> = name
    i<Int> = 0
    while (i < v.len()) {
        out = out + " " + di(v.get(i)).to_string()
        i = i + 1
    }
    return out
}

# The streaming form of dumps: writes the same content in bounded chunks
# straight to an append-mode file instead of building one String by repeated
# concat. dumps() on a Vec of 180224 elements is O(n^2) in the concat (~360 GB
# of churn per call — it WAS the 83 GB RSS / 12 GB/s allocator storm that
# OOM-killed the 45-layer prefill); this form is O(n). The target file is the
# driver's PREFILL_OUT (the same file `lines` is written to at the end).
share(all)
dump_to(name<String>, v<Vec<Float>>)<Int> -> {
    path<String> = env_get("VYBFORGE_PREFILL_OUT") else "native/out/prefill_vyb.txt"
    dt0<Int> = now_ms()
    match (open_append(path)) {
        f -> {
            write_str(f, name)
            i<Int> = 0
            chunk<String> = ""
            while (i < v.len()) {
                chunk = chunk + " " + di(v.get(i)).to_string()
                if (chunk.len() > 2048) { write_str(f, chunk); chunk = "" }
                i = i + 1
            }
            if (chunk.len() > 0) { write_str(f, chunk) }
            write_str(f, "\n")
            close(f)
            println("DUMPTIME " + name + " " + v.len().to_string() + " " + (now_ms() - dt0).to_string())
            return 0
        }
        ? -> { return 1 }
    }
}

# ---------------------------------------------------------------- GPU matmul helpers
# C[M,N] = A[M,K] @ B[K,N] on the device; returns the device pointer (0 on failure).

share(all)
log_decay(f<their<Vec<Float> const>>, dt<Vec<Float>>, alog<Vec<Float>>)<Vec<Float>> -> {
    out<Vec<Float>> = Vec()
    r<Int> = 0
    h<Int> = 0
    c<Int> = 0
    while (r < R) {
        h = 0
        while (h < HEADS) {
            dec<Float> = vexp(alog.get(h))
            c = 0
            while (c < KD) {
                idx<Int> = (r * HEADS + h) * KD + c
                tix<Int> = h * KD + c
                out.push(sigmoid((f.get(idx) + dt.get(tix)) * dec) * GATE_LB)
                c = c + 1
            }
            h = h + 1
        }
        r = r + 1
    }
    return out
}

# the KDA delta-rule recurrence (gdn_ref.kda_recurrent): q,k,v [R,HEADS,KD], g [R,HEADS,KD],
# beta [R,HEADS]; q is already l2-normalised and scaled by 1/sqrt(KD), k l2-normalised.

share(all)
delta_rule(q<their<Vec<Float> const>>, k<their<Vec<Float> const>>, v<their<Vec<Float> const>>, g<their<Vec<Float> const>>, beta<Vec<Float>>)<Vec<Float>> -> {
    out<Vec<Float>> = Vec()
    st<Vec<Float>> = Vec()
    var<Int> n = 0
    while (n < HEADS * KD * KD) {
        st.push(0.0)
        n = n + 1
    }
    n = 0
    while (n < R * HEADS * KD) {
        out.push(0.0)
        n = n + 1
    }
    r<Int> = 0
    h<Int> = 0
    a<Int> = 0
    b<Int> = 0
    while (r < R) {
        h = 0
        while (h < HEADS) {
            # decay the whole state block by exp(g)
            a = 0
            while (a < KD) {
                ge<Float> = vexp(g.get((r * HEADS + h) * KD + a))
                b = 0
                while (b < KD) {
                    st.set((h * KD + a) * KD + b, st.get((h * KD + a) * KD + b) * ge)
                    b = b + 1
                }
                a = a + 1
            }
            be<Float> = beta.get(r * HEADS + h)
            # one sweep over v-channels: delta, state update, read-out (numpy's order)
            b = 0
            while (b < KD) {
                kvb<Float> = 0.0
                a = 0
                while (a < KD) {
                    kvb = kvb + st.get((h * KD + a) * KD + b) * k.get((r * HEADS + h) * KD + a)
                    a = a + 1
                }
                dl<Float> = (v.get((r * HEADS + h) * KD + b) - kvb) * be
                a = 0
                while (a < KD) {
                    st.set((h * KD + a) * KD + b,
                           st.get((h * KD + a) * KD + b) + k.get((r * HEADS + h) * KD + a) * dl)
                    a = a + 1
                }
                rd<Float> = 0.0
                a = 0
                while (a < KD) {
                    rd = rd + st.get((h * KD + a) * KD + b) * q.get((r * HEADS + h) * KD + a)
                    a = a + 1
                }
                out.set((r * HEADS + h) * KD + b, rd)
                b = b + 1
            }
            h = h + 1
        }
        r = r + 1
    }
    return out
}

# gated RMSNorm with the sigmoid (KDA) activation, per (token, head) row of KD, times w

share(all)
gated_norm(x<Vec<Float>>, z<Vec<Float>>, w<Vec<Float>>)<Vec<Float>> -> {
    out<Vec<Float>> = Vec()
    r<Int> = 0
    h<Int> = 0
    i<Int> = 0
    while (r < R) {
        h = 0
        while (h < HEADS) {
            ss<Float> = 0.0
            i = 0
            while (i < KD) {
                vv<Float> = x.get((r * HEADS + h) * KD + i)
                ss = ss + vv * vv
                i = i + 1
            }
            inv<Float> = 1.0 / vsqrt(ss / (KD as Float) + EPS, 40)
            i = 0
            while (i < KD) {
                idx<Int> = (r * HEADS + h) * KD + i
                out.push(x.get(idx) * inv * w.get(i) * sigmoid(z.get(idx)))
                i = i + 1
            }
            h = h + 1
        }
        r = r + 1
    }
    return out
}

# hyper-connection apply: dst = post ⊗ y + comb^T streams

share(all)
hc_apply(streams<Vec<Float>>, y<Vec<Float>>, post<Vec<Float>>, comb<Vec<Float>>)<Vec<Float>> -> {
    dst<Vec<Float>> = Vec()
    r<Int> = 0
    h<Int> = 0
    d<Int> = 0
    j<Int> = 0
    n<Int> = 0
    while (n < R * HC * H) {
        dst.push(0.0)
        n = n + 1
    }
    while (r < R) {
        h = 0
        while (h < HC) {
            d = 0
            while (d < H) {
                acc<Float> = post.get(r * HC + h) * y.get(r * H + d)
                j = 0
                while (j < HC) {
                    acc = acc + comb.get((r * HC + j) * HC + h) * streams.get((r * HC + j) * H + d)
                    j = j + 1
                }
                dst.set((r * HC + h) * H + d, acc)
                d = d + 1
            }
            h = h + 1
        }
        r = r + 1
    }
    return dst
}

share(all)
share(all)
slowget(v<their<Vec<Float> const>>, n<Int>)<Float> -> {
    # the diagnostic: n plain .get calls, no formatting — isolates the get cost
    s<Float> = 0.0
    i<Int> = 0
    while (i < n) { s = s + v.get(i); i = i + 1 }
    return s
}

share(all)
set_engine_R(n<Int>)<Int> -> {
    # rebind THIS module's R (the decode steps run R=1; the prefill R=20).
    # The importer's `R = 1` only shadows — the engine's fns read their own
    # module global, so the rebinding must happen here.
    R = n
    return 0
}

share(all)
now_ms()<Int> -> {
    st<String> = ""
    match (open_read("/proc/uptime")) {
        f -> { match (read_all(f)) { s -> { st = s } ? -> { return 0 } } close(f) }
        ? -> { return 0 }
    }
    # "12345.67 0.00" -> ms
    v<Int> = 0
    ms<Int> = 0
    seenDot<Int> = 0
    digits<Int> = 0
    i<Int> = 0
    while (i < st.len()) {
        c<Int> = (st.char_at(i) as Int) & 255
        if (c == 46) { seenDot = 1; digits = 0 }
        if (c >= 48 && c <= 57) {
            if (seenDot == 0) { v = v * 10 + (c - 48) }
            if (seenDot == 1 && digits < 2) { ms = ms * 10 + (c - 48); digits = digits + 1 }
        }
        if (c == 32) { break }
        i = i + 1
    }
    while (digits < 2) { ms = ms * 10; digits = digits + 1 }
    return v * 1000 + ms
}

share(all)
rss_mb()<Int> -> {
    st<String> = ""
    match (open_read("/proc/self/statm")) {
        f -> { match (read_all(f)) { s -> { st = s } ? -> { return 0 } } close(f) }
        ? -> { return 0 }
    }
    fld<Int> = 0
    v<Int> = 0
    i<Int> = 0
    while (i < st.len()) {
        c<Int> = (st.char_at(i) as Int) & 255
        if (c == 32) { fld = fld + 1 }
        if (fld == 1 && c >= 48 && c <= 57) { v = v * 10 + (c - 48) }
        i = i + 1
    }
    freedom {
        vyb_str_stats()
    }
    return v * 4 / 1000
}


share(all)
gx_resolve_tab(tab<String>, dir<String>, total<Int>, want<Vec<String>>)<GxLoc> -> {
    key<String> = ""
    p<Int> = 0
    k<Int> = 0
    c<Int> = 0
    fld<Int> = 0
    shv<Int> = 0
    ov<Int> = 0
    lv<Int> = 0
    done<Int> = 0
    pth<String> = ""
    pad<String> = ""

    g<GxLoc> = GxLoc { found = Vec(), shard = Vec(), tix = Vec(), off = Vec(), nbytes = Vec(),
                       dts = Vec(), paths = Vec() }
    i<Int> = 0
    while (i < want.len()) {
        g.found.push(0)
        g.shard.push(0)
        g.tix.push(-1)
        g.off.push(-1)
        g.nbytes.push(0)
        g.dts.push("")
        g.paths.push("")
        i = i + 1
    }
    i = 0
    while (i < want.len()) {
        key = want.get(i) + " "
        p = tab.index_of(key)
        if (p >= 0) {
            k = p
            fld = 0
            shv = 0
            ov = 0
            lv = 0
            done = 0
            while (done == 0) {
                c = (tab.char_at(k) as Int) & 255
                if (c == 10) { done = 1 }
                if (c == 32) { fld = fld + 1 }
                if (fld == 1 && c >= 48 && c <= 57) { shv = shv * 10 + (c - 48) }
                if (fld == 2 && c >= 48 && c <= 57) { ov = ov * 10 + (c - 48) }
                if (fld == 3 && c >= 48 && c <= 57) { lv = lv * 10 + (c - 48) }
                k = k + 1
            }
            pad = shv.to_string()
            while (pad.len() < 5) { pad = "0" + pad }
            pth = dir + "/model-" + pad + "-of-00083.safetensors"
            g.found.set(i, 1)
            g.tix.set(i, 0)
            g.shard.set(i, shv)
            g.off.set(i, ov)
            g.nbytes.set(i, lv)
            g.dts.set(i, "BF16")
            g.paths.set(i, pth)
        }
        i = i + 1
    }
    return g
}

share(all)
exl3_deq(fdeq<Int>, fhgen<Int>, fhad1<Int>, fhad2<Int>,
         trellis<String>, suh<String>, svh<String>, body<String>,
         cw<Int>, ntiles<Int>, hd_pre<Int>)<Int> -> {
    tb<Int> = 0
    kn<Int> = 0
    krows<Int> = 0
    nbc<Int> = 0
    nblocks<Int> = 0
    mb<Int> = 0
    hwide<Int> = 0
    bq<Int> = 0
    u<Int> = 0
    ch<Int> = 0
    b<Int> = 0
    pq<Int> = 0
    chq<Int> = 0
    var<Int> out = 0
    tb = trellis.len()
    nbody<Int> = body.len()
    nsuh<Int> = suh.len()
    nsvh<Int> = svh.len()
    if (tb < ntiles * 128) { println("EXL3FAIL size tb=" + tb.to_string() + " need=" + (ntiles * 128).to_string() + " cw=" + cw.to_string()); return 0 }
    kn = (ntiles / (cw / 16)) * 16 * cw
    krows = kn / cw
    if ((suh.len() % 8) != 0 || (svh.len() % 8) != 0) { println("EXL3FAIL mod suh=" + suh.len().to_string() + " svh=" + svh.len().to_string()); return 0 }
    if (suh.len() != krows * 2 || svh.len() != cw * 2) { println("EXL3FAIL suh=" + suh.len().to_string() + " krows2=" + (krows * 2).to_string() + " svh=" + svh.len().to_string() + " cw2=" + (cw * 2).to_string()); return 0 }
    nbc = cw / 128
    nblocks = (kn / cw / 128) * nbc
    mb = 16 + body.len()
    freedom {
        var<Int> qd = 0
        var<Int> td = 0
        var<Int> od = 0
        var<Int> hd = 0
        var<Int> td2 = 0
        var<Int> fd = 0
        var<Int> pd = 0
        var<Int> sud = 0
        var<Int> svd = 0
        xrc101<Int> = cuMemAlloc_v2(loc(qd), tb) as Int
        if (xrc101 != 0) { println("EXL3FAIL cuda1 rc=" + xrc101.to_string()); return 0 }
        xrc102<Int> = cuMemAlloc_v2(loc(td), mb) as Int
        if (xrc102 != 0) { println("EXL3FAIL cuda2 rc=" + xrc102.to_string()); return 0 }
        xrc103<Int> = cuMemAlloc_v2(loc(od), kn * 8) as Int
        if (xrc103 != 0) { println("EXL3FAIL cuda3 rc=" + xrc103.to_string()); return 0 }
        # H is a run-constant 128x128 Sylvester Hadamard/8: when the caller passes a
        # prebuilt buffer (hd_pre != 0, built once by had_hoist) skip the per-call
        # exl3hgen launch entirely (~8.7 ms x hundreds of deqs per layer).
        hd = hd_pre
        if (hd == 0) {
            xrc104<Int> = cuMemAlloc_v2(loc(hd), 128 * 128 * 8) as Int
            if (xrc104 != 0) { println("EXL3FAIL cuda4 rc=" + xrc104.to_string()); return 0 }
        }
        xrc105<Int> = cuMemAlloc_v2(loc(td2), kn * 8) as Int
        if (xrc105 != 0) { println("EXL3FAIL cuda5 rc=" + xrc105.to_string()); return 0 }
        xrc106<Int> = cuMemAlloc_v2(loc(fd), kn * 8) as Int
        if (xrc106 != 0) { println("EXL3FAIL cuda6 rc=" + xrc106.to_string()); return 0 }
        xrc107<Int> = cuMemAlloc_v2(loc(pd), 64) as Int
        if (xrc107 != 0) { println("EXL3FAIL cuda7 rc=" + xrc107.to_string()); return 0 }
        xrc108<Int> = cuMemAlloc_v2(loc(sud), krows * 2) as Int
        if (xrc108 != 0) { println("EXL3FAIL cuda8 rc=" + xrc108.to_string()); return 0 }
        xrc109<Int> = cuMemAlloc_v2(loc(svd), cw * 2) as Int
        if (xrc109 != 0) { println("EXL3FAIL cuda9 rc=" + xrc109.to_string()); return 0 }

        # trellis: bulk copy straight from the String
        if (cuMemcpyHtoD_v2(qd, trellis, tb) != 0) { return 0 }
        # map: 16-byte header + the 256-slot body
        var<CInt> rc = 0
        hwide = 0
        bq = 0
        while (bq < 8) {
            hwide = hwide | (((cw >> (bq * 8)) & 255) << (bq * 8))
            bq = bq + 1
        }
        if (cuMemcpyHtoD_v2(td, loc(hwide), 8) != 0) { return 0 }
        hwide = 0
        bq = 0
        while (bq < 8) {
            hwide = hwide | (((ntiles >> (bq * 8)) & 255) << (bq * 8))
            bq = bq + 1
        }
        if (cuMemcpyHtoD_v2(td + 8, loc(hwide), 8) != 0) { println("EXL3FAIL cuda11"); return 0 }
        # map body: ONE copy from the String's own buffer (per-8-byte copies cost ~2 us each)
        if (cuMemcpyHtoD_v2(td + 16, body, nbody) != 0) { println("EXL3FAIL cuda12"); return 0 }
        # dequant
        lrc829<Int> = cuda_launch4i(from<loc<CVoid>>(fdeq), ntiles, 1, 1, 256, 1, 1, qd, td, od, 0) as Int
        srrc829<Int> = cuCtxSynchronize() as Int
        if (srrc829 != 0) { println("EXL3SYNC deq sync rc=" + srrc829.to_string()); return 0 }
        cuCtxSynchronize()
        cuMemFree_v2(qd)
        cuMemFree_v2(td)
        # scales (fp16) to the device: one copy each, same reason as the map body
        if (cuMemcpyHtoD_v2(sud, suh, nsuh) != 0) { println("EXL3FAIL cuda14"); return 0 }
        if (cuMemcpyHtoD_v2(svd, svh, nsvh) != 0) { println("EXL3FAIL cuda15"); return 0 }
        # hgen: H at pd+0 (skipped when H was prebuilt by had_hoist)
        if (hd_pre == 0) {
            if (cuMemcpyHtoD_v2(pd + 0, loc(hd), 8) != 0) { println("EXL3FAIL cuda16"); return 0 }
            lrc840<Int> = cuda_launch4i(from<loc<CVoid>>(fhgen), 64, 1, 1, 256, 1, 1, pd, 0, 0, 0) as Int
            srrc840<Int> = cuCtxSynchronize() as Int
            if (srrc840 != 0) { println("EXL3SYNC hgen sync rc=" + srrc840.to_string()); return 0 }
            cuCtxSynchronize()
        }
        # had1: what=od, tmp=td2, H=hd, cw, nbc, nblocks
        pq = 0
        while (pq < 6) {
            chq = 0
            if (pq == 0) { chq = od }
            if (pq == 1) { chq = td2 }
            if (pq == 2) { chq = hd }
            if (pq == 3) { chq = cw }
            if (pq == 4) { chq = nbc }
            if (pq == 5) { chq = nblocks }
            if (cuMemcpyHtoD_v2(pd + pq * 8, loc(chq), 8) != 0) { println("EXL3FAIL cuda18"); return 0 }
            pq = pq + 1
        }
        lrc857<Int> = cuda_launch4i(from<loc<CVoid>>(fhad1), nblocks * 64, 1, 1, 256, 1, 1, pd, 0, 0, 0) as Int
        srrc857<Int> = cuCtxSynchronize() as Int
        if (srrc857 != 0) { println("EXL3SYNC had1 sync rc=" + srrc857.to_string()); return 0 }
        cuCtxSynchronize()
        # had2: tmp=td2, out=fd, H=hd, suh, svh, cw, nbc, nblocks
        pq = 0
        while (pq < 8) {
            chq = 0
            if (pq == 0) { chq = td2 }
            if (pq == 1) { chq = fd }
            if (pq == 2) { chq = hd }
            if (pq == 3) { chq = sud }
            if (pq == 4) { chq = svd }
            if (pq == 5) { chq = cw }
            if (pq == 6) { chq = nbc }
            if (pq == 7) { chq = nblocks }
            if (cuMemcpyHtoD_v2(pd + pq * 8, loc(chq), 8) != 0) { println("EXL3FAIL cuda20"); return 0 }
            pq = pq + 1
        }
        lrc876<Int> = cuda_launch4i(from<loc<CVoid>>(fhad2), nblocks * 64, 1, 1, 256, 1, 1, pd, 0, 0, 0) as Int
        srrc876<Int> = cuCtxSynchronize() as Int
        if (srrc876 != 0) { println("EXL3SYNC had2 sync rc=" + srrc876.to_string()); return 0 }
        cuCtxSynchronize()
        # qd (the trellis staging copy) is the per-call leak — free it.
        # fd is the RETURNED dequantized weights (out = fd): freeing it here
        # dangles the caller's dWg/dWu/dWd and the expert gemm faults on
        # freed device memory (Xid 31 -> context reset -> rc=2/700).
        cuMemFree_v2(qd)
        cuMemFree_v2(od)
        if (hd_pre == 0) { cuMemFree_v2(hd) }
        cuMemFree_v2(td2)
        cuMemFree_v2(pd)
        cuMemFree_v2(sud)
        cuMemFree_v2(svd)
        out = fd
    }
    return out
}

share(all)
exl3_deq32(fdeq32<Int>, fdqs<Int>, fhad132<Int>, fhad232<Int>, fcvt32<Int>,
         trellis<String>, suh<String>, svh<String>, body<String>,
         cw<Int>, ntiles<Int>, hd_pre32<Int>,
         qda<Int>, tda<Int>, oda<Int>, td2a<Int>,
         suda<Int>, svda<Int>, pda<Int>, mda<Int>, ivb<Int>)<Int> -> {
    tb<Int> = 0
    kn<Int> = 0
    krows<Int> = 0
    nbc<Int> = 0
    nblocks<Int> = 0
    mb<Int> = 0
    hwide<Int> = 0
    bq<Int> = 0
    u<Int> = 0
    ch<Int> = 0
    b<Int> = 0
    pq<Int> = 0
    chq<Int> = 0
    var<Int> out = 0
    tb = trellis.len()
    nbody<Int> = body.len()
    nsuh<Int> = suh.len()
    nsvh<Int> = svh.len()
    if (tb < ntiles * 128) { println("EXL3FAIL32 size"); return 0 }
    if (tb > 8388608) { println("EXL3FAIL32 trellis arena"); return 0 }
    kn = (ntiles / (cw / 16)) * 16 * cw
    krows = kn / cw
    if ((nsuh % 8) != 0 || (nsvh % 8) != 0) { println("EXL3FAIL32 mod"); return 0 }
    if (nsuh != krows * 2 || nsvh != cw * 2) { println("EXL3FAIL32 scales"); return 0 }
    nbc = cw / 128
    nblocks = (kn / cw / 128) * nbc
    mb = 16 + body.len()
    freedom {
        qd<Int> = qda
        td<Int> = tda
        od<Int> = oda
        td2<Int> = td2a
        pd<Int> = pda
        sud<Int> = suda
        svd<Int> = svda
        fd<Int> = 0
        fdc<Int> = 0
        frc1<Int> = cuMemAlloc_v2(loc(fd), kn * 4) as Int
        frc2<Int> = cuMemAlloc_v2(loc(fdc), kn * 8) as Int
        if (frc1 != 0 || frc2 != 0) { println("EXL3FAIL32 fdalloc"); return 0 }
        if (cuMemcpyHtoD_v2(qd, trellis, tb) != 0) { println("EXL3FAIL32 htod1"); return 0 }
        if (cuMemcpyHtoD_v2(sud, suh, nsuh) != 0) { println("EXL3FAIL32 htod5"); return 0 }
        if (cuMemcpyHtoD_v2(svd, svh, nsvh) != 0) { println("EXL3FAIL32 htod6"); return 0 }
        # fused dq1s: dequant-in-registers + had1 in ONE launch (od never materialized)
        pq = 0
        while (pq < 6) {
            chq = 0
            if (pq == 0) { chq = qd }
            if (pq == 1) { chq = mda }
            if (pq == 2) { chq = hd_pre32 }
            if (pq == 3) { chq = td2 }
            if (pq == 4) { chq = cw }
            if (pq == 5) { chq = ivb }
            if (cuMemcpyHtoD_v2(pd + pq * 8, loc(chq), 8) != 0) { println("EXL3FAIL32 p1"); return 0 }
            pq = pq + 1
        }
        dqgrid<Int> = ntiles
        lrcB<Int> = cuda_launch4i(from<loc<CVoid>>(fdqs), dqgrid, 1, 1, 256, 1, 1, pd, 0, 0, 0) as Int
        srB<Int> = cuCtxSynchronize() as Int
        if (lrcB != 0 || srB != 0) { println("EXL3FAIL32 dq1s"); return 0 }
        pq = 0
        while (pq < 8) {
            chq = 0
            if (pq == 0) { chq = td2 }
            if (pq == 1) { chq = fd }
            if (pq == 2) { chq = hd_pre32 }
            if (pq == 3) { chq = sud }
            if (pq == 4) { chq = svd }
            if (pq == 5) { chq = cw }
            if (pq == 6) { chq = nbc }
            if (pq == 7) { chq = nblocks }
            if (cuMemcpyHtoD_v2(pd + pq * 8, loc(chq), 8) != 0) { println("EXL3FAIL32 p2"); return 0 }
            pq = pq + 1
        }
        lrcC<Int> = cuda_launch4i(from<loc<CVoid>>(fhad232), nblocks * 64, 1, 1, 256, 1, 1, pd, 0, 0, 0) as Int
        srC<Int> = cuCtxSynchronize() as Int
        if (lrcC != 0 || srC != 0) { println("EXL3FAIL32 had2"); return 0 }
        pq = 0
        while (pq < 3) {
            chq = 0
            if (pq == 0) { chq = fd }
            if (pq == 1) { chq = fdc }
            if (pq == 2) { chq = kn }
            if (cuMemcpyHtoD_v2(pd + pq * 8, loc(chq), 8) != 0) { println("EXL3FAIL32 p3"); return 0 }
            pq = pq + 1
        }
        lrcD<Int> = cuda_launch4i(from<loc<CVoid>>(fcvt32), (kn + 255) / 256, 1, 1, 256, 1, 1, pd, 0, 0, 0) as Int
        srD<Int> = cuCtxSynchronize() as Int
        if (lrcD != 0 || srD != 0) { println("EXL3FAIL32 cvt lrc=" + lrcD.to_string() + " sync=" + srD.to_string()); return 0 }
        cuMemFree_v2(fd)
        out = fdc
    }
    return out
}

// exl3_deq32f — the deq32 chain with the F32 OUTPUT: identical to exl3_deq32
// but the final f32->f64 cvt launch is skipped and the f32 intermediate (fd)
// is returned directly (the caller frees it). Halves the deq write traffic and
// drops the cvt kernel; the consumer must be an f32 gemm (gemm32_p/gemm32_r).
share(all)
exl3_deq32f(fdeq32<Int>, fdqs<Int>, fdqs4<Int>, fhad132<Int>, fhad232<Int>,
         trellis<String>, suh<String>, svh<String>, body<String>,
         cw<Int>, ntiles<Int>, hd_pre32<Int>,
         qda<Int>, tda<Int>, oda<Int>, td2a<Int>,
         suda<Int>, svda<Int>, pda<Int>, mda<Int>, ivb<Int>)<Int> -> {
    var<Int> outf = 0
    tb2<Int> = trellis.len()
    nbody2<Int> = body.len()
    nsuh2<Int> = suh.len()
    nsvh2<Int> = svh.len()
    if (tb2 < ntiles * 128) { println("EXL3FAIL32F size"); return 0 }
    if (tb2 > 8388608) { println("EXL3FAIL32F trellis arena"); return 0 }
    kn2<Int> = (ntiles / (cw / 16)) * 16 * cw
    krows2<Int> = kn2 / cw
    if ((nsuh2 % 8) != 0 || (nsvh2 % 8) != 0) { println("EXL3FAIL32F mod"); return 0 }
    if (nsuh2 != krows2 * 2 || nsvh2 != cw * 2) { println("EXL3FAIL32F scales"); return 0 }
    nbc2<Int> = cw / 128
    nblocks2<Int> = (kn2 / cw / 128) * nbc2
    freedom {
        qd2<Int> = qda
        td2f<Int> = tda
        od2<Int> = oda
        td2x<Int> = td2a
        pd2<Int> = pda
        sud2<Int> = suda
        svd2<Int> = svda
        fdx<Int> = 0
        frcf<Int> = cuMemAlloc_v2(loc(fdx), kn2 * 4) as Int
        if (frcf != 0) { println("EXL3FAIL32F fdalloc"); return 0 }
        if (cuMemcpyHtoD_v2(qd2, trellis, tb2) != 0) { println("EXL3FAIL32F htod1"); return 0 }
        if (cuMemcpyHtoD_v2(sud2, suh, nsuh2) != 0) { println("EXL3FAIL32F htod5"); return 0 }
        if (cuMemcpyHtoD_v2(svd2, svh, nsvh2) != 0) { println("EXL3FAIL32F htod6"); return 0 }
        pqf<Int> = 0
        chqf<Int> = 0
        while (pqf < 6) {
            chqf = 0
            if (pqf == 0) { chqf = qd2 }
            if (pqf == 1) { chqf = mda }
            if (pqf == 2) { chqf = hd_pre32 }
            if (pqf == 3) { chqf = td2x }
            if (pqf == 4) { chqf = cw }
            if (pqf == 5) { chqf = ivb }
            if (cuMemcpyHtoD_v2(pd2 + pqf * 8, loc(chqf), 8) != 0) { println("EXL3FAIL32F p1"); return 0 }
            pqf = pqf + 1
        }
        lrcBf<Int> = cuda_launch4i(from<loc<CVoid>>(fdqs4), ntiles / 4, 1, 1, 256, 1, 1, pd2, 0, 0, 0) as Int
        srBf<Int> = cuCtxSynchronize() as Int
        if (lrcBf != 0 || srBf != 0) { println("EXL3FAIL32F dq1s"); return 0 }
        pqf = 0
        while (pqf < 8) {
            chqf = 0
            if (pqf == 0) { chqf = td2x }
            if (pqf == 1) { chqf = fdx }
            if (pqf == 2) { chqf = hd_pre32 }
            if (pqf == 3) { chqf = sud2 }
            if (pqf == 4) { chqf = svd2 }
            if (pqf == 5) { chqf = cw }
            if (pqf == 6) { chqf = nbc2 }
            if (pqf == 7) { chqf = nblocks2 }
            if (cuMemcpyHtoD_v2(pd2 + pqf * 8, loc(chqf), 8) != 0) { println("EXL3FAIL32F p2"); return 0 }
            pqf = pqf + 1
        }
        lrcCf<Int> = cuda_launch4i(from<loc<CVoid>>(fhad232), nblocks2 * 64, 1, 1, 256, 1, 1, pd2, 0, 0, 0) as Int
        srCf<Int> = cuCtxSynchronize() as Int
        if (lrcCf != 0 || srCf != 0) { println("EXL3FAIL32F had2"); return 0 }
        outf = fdx
    }
    return outf
}

// exl3_deq32f_into — the caller owns the f32 output buffer. Same math, same
// kernels, same order; the only difference is that the 33.5 MB f32 output is
// NOT allocated per call (the per-call cuMemAlloc measured ~1 ms of a 4 ms
// deq, ~15% of the expert's dequant). The CALLER must not hold the buffer
// across two deqs: the next call overwrites it. Sequential deq->consume loops
// (deq, gemm, deq, gemm...) are the intended use.
share(all)
exl3_deq32f_into(fdeq32<Int>, fdqs<Int>, fdqs4<Int>, fhad132<Int>, fhad232<Int>,
         trellis<String>, suh<String>, svh<String>, body<String>,
         cw<Int>, ntiles<Int>, hd_pre32<Int>,
         qda<Int>, tda<Int>, oda<Int>, td2a<Int>,
         suda<Int>, svda<Int>, pda<Int>, mda<Int>, ivb<Int>, outb<Int>)<Int> -> {
    tb2<Int> = trellis.len()
    nsuh2<Int> = suh.len()
    nsvh2<Int> = svh.len()
    if (tb2 < ntiles * 128) { println("EXL3FAIL32F size"); return 0 }
    if (tb2 > 8388608) { println("EXL3FAIL32F trellis arena"); return 0 }
    kn2<Int> = (ntiles / (cw / 16)) * 16 * cw
    krows2<Int> = kn2 / cw
    if ((nsuh2 % 8) != 0 || (nsvh2 % 8) != 0) { println("EXL3FAIL32F mod"); return 0 }
    if (nsuh2 != krows2 * 2 || nsvh2 != cw * 2) { println("EXL3FAIL32F scales"); return 0 }
    nbc2<Int> = cw / 128
    nblocks2<Int> = (kn2 / cw / 128) * nbc2
    freedom {
        qd2<Int> = qda
        td2f<Int> = tda
        td2x<Int> = td2a
        pd2<Int> = pda
        sud2<Int> = suda
        svd2<Int> = svda
        fdx<Int> = outb
        if (cuMemcpyHtoD_v2(qd2, trellis, tb2) != 0) { println("EXL3FAIL32F htod1"); return 0 }
        if (cuMemcpyHtoD_v2(sud2, suh, nsuh2) != 0) { println("EXL3FAIL32F htod5"); return 0 }
        if (cuMemcpyHtoD_v2(svd2, svh, nsvh2) != 0) { println("EXL3FAIL32F htod6"); return 0 }
        pqf<Int> = 0
        chqf<Int> = 0
        while (pqf < 6) {
            chqf = 0
            if (pqf == 0) { chqf = qd2 }
            if (pqf == 1) { chqf = mda }
            if (pqf == 2) { chqf = hd_pre32 }
            if (pqf == 3) { chqf = td2x }
            if (pqf == 4) { chqf = cw }
            if (pqf == 5) { chqf = ivb }
            if (cuMemcpyHtoD_v2(pd2 + pqf * 8, loc(chqf), 8) != 0) { println("EXL3FAIL32F p1"); return 0 }
            pqf = pqf + 1
        }
        lrcBf<Int> = cuda_launch4i(from<loc<CVoid>>(fdqs4), ntiles / 4, 1, 1, 256, 1, 1, pd2, 0, 0, 0) as Int
        srBf<Int> = cuCtxSynchronize() as Int
        if (lrcBf != 0 || srBf != 0) { println("EXL3FAIL32F dq1s"); return 0 }
        pqf = 0
        while (pqf < 8) {
            chqf = 0
            if (pqf == 0) { chqf = td2x }
            if (pqf == 1) { chqf = fdx }
            if (pqf == 2) { chqf = hd_pre32 }
            if (pqf == 3) { chqf = sud2 }
            if (pqf == 4) { chqf = svd2 }
            if (pqf == 5) { chqf = cw }
            if (pqf == 6) { chqf = nbc2 }
            if (pqf == 7) { chqf = nblocks2 }
            if (cuMemcpyHtoD_v2(pd2 + pqf * 8, loc(chqf), 8) != 0) { println("EXL3FAIL32F p2"); return 0 }
            pqf = pqf + 1
        }
        lrcCf<Int> = cuda_launch4i(from<loc<CVoid>>(fhad232), nblocks2 * 64, 1, 1, 256, 1, 1, pd2, 0, 0, 0) as Int
        srCf<Int> = cuCtxSynchronize() as Int
        if (lrcCf != 0 || srCf != 0) { println("EXL3FAIL32F had2"); return 0 }
    }
    return outb
}

// exl3_deq32f_into_h — same as exl3_deq32f_into but the Hadamard epilogue is
// exl3had232h (exl3h.ptx): the 128x128 T tile is staged in shared by two CTAs
// per block instead of being re-read from L2 128 times. Bit-identical math;
// pass the exl3had232h function handle in the fhad232 slot.
share(all)
exl3_deq32f_into_h(fdeq32<Int>, fdqs<Int>, fdqs4<Int>, fhad132<Int>, fhad232<Int>,
         trellis<String>, suh<String>, svh<String>, body<String>,
         cw<Int>, ntiles<Int>, hd_pre32<Int>,
         qda<Int>, tda<Int>, oda<Int>, td2a<Int>,
         suda<Int>, svda<Int>, pda<Int>, mda<Int>, ivb<Int>, outb<Int>)<Int> -> {
    tb2<Int> = trellis.len()
    nsuh2<Int> = suh.len()
    nsvh2<Int> = svh.len()
    if (tb2 < ntiles * 128) { println("EXL3FAIL32F size"); return 0 }
    if (tb2 > 8388608) { println("EXL3FAIL32F trellis arena"); return 0 }
    kn2<Int> = (ntiles / (cw / 16)) * 16 * cw
    krows2<Int> = kn2 / cw
    if ((nsuh2 % 8) != 0 || (nsvh2 % 8) != 0) { println("EXL3FAIL32F mod"); return 0 }
    if (nsuh2 != krows2 * 2 || nsvh2 != cw * 2) { println("EXL3FAIL32F scales"); return 0 }
    nbc2<Int> = cw / 128
    nblocks2<Int> = (kn2 / cw / 128) * nbc2
    freedom {
        qd2<Int> = qda
        td2f<Int> = tda
        td2x<Int> = td2a
        pd2<Int> = pda
        sud2<Int> = suda
        svd2<Int> = svda
        fdx<Int> = outb
        if (cuMemcpyHtoD_v2(qd2, trellis, tb2) != 0) { println("EXL3FAIL32F htod1"); return 0 }
        if (cuMemcpyHtoD_v2(sud2, suh, nsuh2) != 0) { println("EXL3FAIL32F htod5"); return 0 }
        if (cuMemcpyHtoD_v2(svd2, svh, nsvh2) != 0) { println("EXL3FAIL32F htod6"); return 0 }
        pqf<Int> = 0
        chqf<Int> = 0
        while (pqf < 6) {
            chqf = 0
            if (pqf == 0) { chqf = qd2 }
            if (pqf == 1) { chqf = mda }
            if (pqf == 2) { chqf = hd_pre32 }
            if (pqf == 3) { chqf = td2x }
            if (pqf == 4) { chqf = cw }
            if (pqf == 5) { chqf = ivb }
            if (cuMemcpyHtoD_v2(pd2 + pqf * 8, loc(chqf), 8) != 0) { println("EXL3FAIL32F p1"); return 0 }
            pqf = pqf + 1
        }
        lrcBf<Int> = cuda_launch4i(from<loc<CVoid>>(fdqs4), ntiles / 4, 1, 1, 256, 1, 1, pd2, 0, 0, 0) as Int
        srBf<Int> = cuCtxSynchronize() as Int
        if (lrcBf != 0 || srBf != 0) { println("EXL3FAIL32F dq1s"); return 0 }
        pqf = 0
        while (pqf < 8) {
            chqf = 0
            if (pqf == 0) { chqf = td2x }
            if (pqf == 1) { chqf = fdx }
            if (pqf == 2) { chqf = hd_pre32 }
            if (pqf == 3) { chqf = sud2 }
            if (pqf == 4) { chqf = svd2 }
            if (pqf == 5) { chqf = cw }
            if (pqf == 6) { chqf = nbc2 }
            if (pqf == 7) { chqf = nblocks2 }
            if (cuMemcpyHtoD_v2(pd2 + pqf * 8, loc(chqf), 8) != 0) { println("EXL3FAIL32F p2"); return 0 }
            pqf = pqf + 1
        }
        # the staged-shared had: TWO CTAs per 128x128 block (32 KB tile half each)
        lrcCf<Int> = cuda_launch4i(from<loc<CVoid>>(fhad232), nblocks2 * 2, 1, 1, 256, 1, 1, pd2, 0, 0, 0) as Int
        srCf<Int> = cuCtxSynchronize() as Int
        if (lrcCf != 0 || srCf != 0) { println("EXL3FAIL32F had2"); return 0 }
    }
    return outb
}
share(all)
had_hoist(fhgen<Int>)<Int> -> {
    var<Int> out = 0
    freedom {
        var<Int> hd = 0
        var<Int> pd = 0
        hrc1<Int> = cuMemAlloc_v2(loc(hd), 128 * 128 * 8) as Int
        if (hrc1 == 0) {
            hrc2<Int> = cuMemAlloc_v2(loc(pd), 64) as Int
            if (hrc2 == 0) {
                if (cuMemcpyHtoD_v2(pd + 0, loc(hd), 8) == 0) {
                    hlrc<Int> = cuda_launch4i(from<loc<CVoid>>(fhgen), 64, 1, 1, 256, 1, 1, pd, 0, 0, 0) as Int
                    hsync<Int> = cuCtxSynchronize() as Int
                    if (hlrc == 0 && hsync == 0) { out = hd }
                }
                cuMemFree_v2(pd)
            }
            if (out == 0) { cuMemFree_v2(hd) }
        }
    }
    return out
}
share(all)
had_hoist32(fhgen32<Int>)<Int> -> {
    var<Int> out = 0
    freedom {
        var<Int> hd = 0
        var<Int> pd = 0
        hrc1<Int> = cuMemAlloc_v2(loc(hd), 16384 * 4) as Int
        if (hrc1 == 0) {
            hrc2<Int> = cuMemAlloc_v2(loc(pd), 64) as Int
            if (hrc2 == 0) {
                if (cuMemcpyHtoD_v2(pd + 0, loc(hd), 8) == 0) {
                    hlrc<Int> = cuda_launch4i(from<loc<CVoid>>(fhgen32), 64, 1, 1, 256, 1, 1, pd, 0, 0, 0) as Int
                    hsync<Int> = cuCtxSynchronize() as Int
                    if (hlrc == 0 && hsync == 0) { out = hd }
                }
                cuMemFree_v2(pd)
            }
            if (out == 0) { cuMemFree_v2(hd) }
        }
    }
    return out
}

# ============================================================ phase-1 sites with state capture
# The prefill sites verbatim, plus borrows that copy the carried decode state out as
# the batched pass goes. The copies are read-only additions: the batched arithmetic
# is untouched, so phase 1's digests are the prefill's.

# delta_rule + the final recurrence state copied to st_out at slot offset
# slot * HEADS * KD * KD (the state after the LAST token of the batch).

share(all)
delta_rule_cap(q<their<Vec<Float> const>>, k<their<Vec<Float> const>>, v<their<Vec<Float> const>>, g<their<Vec<Float> const>>, beta<Vec<Float>>, st_out<their<Vec<Float>>>, capslot<Int>)<Vec<Float>> -> {
    out<Vec<Float>> = Vec()
    st<Vec<Float>> = Vec()
    var<Int> n = 0
    while (n < HEADS * KD * KD) {
        st.push(0.0)
        n = n + 1
    }
    n = 0
    while (n < R * HEADS * KD) {
        out.push(0.0)
        n = n + 1
    }
    r<Int> = 0
    h<Int> = 0
    a<Int> = 0
    b<Int> = 0
    while (r < R) {
        h = 0
        while (h < HEADS) {
            # decay the whole state block by exp(g)
            a = 0
            while (a < KD) {
                ge<Float> = vexp(g.get((r * HEADS + h) * KD + a))
                b = 0
                while (b < KD) {
                    st.set((h * KD + a) * KD + b, st.get((h * KD + a) * KD + b) * ge)
                    b = b + 1
                }
                a = a + 1
            }
            be<Float> = beta.get(r * HEADS + h)
            # one sweep over v-channels: delta, state update, read-out (numpy's order)
            b = 0
            while (b < KD) {
                kvb<Float> = 0.0
                a = 0
                while (a < KD) {
                    kvb = kvb + st.get((h * KD + a) * KD + b) * k.get((r * HEADS + h) * KD + a)
                    a = a + 1
                }
                dl<Float> = (v.get((r * HEADS + h) * KD + b) - kvb) * be
                a = 0
                while (a < KD) {
                    st.set((h * KD + a) * KD + b,
                           st.get((h * KD + a) * KD + b) + k.get((r * HEADS + h) * KD + a) * dl)
                    a = a + 1
                }
                rd<Float> = 0.0
                a = 0
                while (a < KD) {
                    rd = rd + st.get((h * KD + a) * KD + b) * q.get((r * HEADS + h) * KD + a)
                    a = a + 1
                }
                out.set((r * HEADS + h) * KD + b, rd)
                b = b + 1
            }
            h = h + 1
        }
        r = r + 1
    }
    cap<Int> = 0
    while (cap < st.len()) {
        st_out.set(capslot * HEADS * KD * KD + cap, st.get(cap))
        cap = cap + 1
    }
    return out
}

# attn_site + the DSA cache rows (ckv / indexer k / gsc) copied to the layer slot.

share(all)
attn_site_c(h_a<Vec<Float>>, tab<String>, lpre<String>, fgemm<Int>, fbf<Int>, ckv_out<their<Vec<Float>>>, ik_out<their<Vec<Float>>>, gsc_out<their<Vec<Float>>>, capslot<Int>)<Vec<Float>> -> {
    nonev<Vec<Float>> = Vec()
    a<Int> = 0
    acc<Float> = 0.0
    best<Float> = 0.0
    bestp<Int> = 0
    c<Int> = 0
    d2<Int> = 0
    d_knb<Int> = 0
    d_knw<Int> = 0
    dir<String> = ""
    dot<Float> = 0.0
    first<Int> = 0
    hapath<String> = ""
    hh<Int> = 0
    i<Int> = 0
    j2<Int> = 0
    k2<Int> = 0
    k3<Int> = 0
    last<Int> = 0
    lg<Float> = 0.0
    lines<String> = ""
    mx<Float> = 0.0
    nf<Int> = 0
    npools<Int> = 0
    out<String> = ""
    p<Int> = 0
    pr<Float> = 0.0
    pv<Float> = 0.0
    q2<Int> = 0
    raw_ape<String> = ""
    rl<Float> = 0.0
    sc<Float> = 0.0
    sc_scale<Float> = 0.0
    scale_iq<Float> = 0.0
    select_k<Int> = 0
    selline<String> = ""
    slot<Int> = 0
    sm<Float> = 0.0
    sv<Float> = 0.0
    tcount<Int> = 0
    total<Int> = 0
    tstart<Int> = 0
    tv<Int> = 0
    used<Int> = 0
    vcount<Int> = 0
    total = 0
    nf = 0
    i = 0
    d_knw = 0
    d_knb = 0
    d2 = 0
    hh = 0
    j2 = 0
    npools = 0
    p = 0
    c = 0
    mx = 0.0
    a = 0
    lg = 0.0
    sm = 0.0
    acc = 0.0
    pr = 0.0
    scale_iq = 0.0
    q2 = 0
    dot = 0.0
    rl = 0.0
    select_k = 0
    k2 = 0
    bestp = 0
    best = 0.0
    last = 0
    used = 0
    k3 = 0
    sc = 0.0
    vcount = 0
    tcount = 0
    tstart = 0
    slot = 0
    first = 0
    tv = 0
    sc_scale = 0.0
    sv = 0.0
    pv = 0.0
    dir = env_get("VYBFORGE_GX_DIR") else "/mnt/apex/rick/vybforge/glm53-checkpoint"
    out = env_get("VYBFORGE_L3_OUT") else "native/out/l3_vyb.txt"
    hapath = env_get("VYBFORGE_L3_HA") else "native/out/gold_l3_ha.txt"
    total = 83

    want<Vec<String>> = Vec()
    want.push(lpre + "self_attn.q_a_proj.weight")
    want.push(lpre + "self_attn.q_a_layernorm.weight")
    want.push(lpre + "self_attn.q_b_proj.weight")
    want.push(lpre + "self_attn.kv_a_proj_with_mqa.weight")
    want.push(lpre + "self_attn.kv_a_layernorm.weight")
    want.push(lpre + "self_attn.kv_b_proj.weight")
    want.push(lpre + "self_attn.o_proj.weight")
    want.push(lpre + "self_attn.indexer.wq_b.weight")
    want.push(lpre + "self_attn.indexer.wk.weight")
    want.push(lpre + "self_attn.indexer.k_norm.weight")
    want.push(lpre + "self_attn.indexer.k_norm.bias")
    want.push(lpre + "self_attn.indexer.weights_proj.weight")
    want.push(lpre + "self_attn.indexer.index_kpool_compress_ape")
    want.push(lpre + "self_attn.indexer.index_kpool_compress_gate")

    g<GxLoc> = gx_resolve_tab(tab, dir, total, want)
    nf = 0
    i = 0
    while (i < want.len()) {
        if (g.found.get(i) == 1) { nf = nf + 1 }
        i = i + 1
    }
    if (nf != want.len()) { println("L3_FAIL resolve " + nf.to_string()); return nonev }

    if (tensor_init() != 0) { println("L3_FAIL no cuda"); return nonev }
    fgemm = load_fn("native/build/gemm.ptx", "gemm")
    fbf = load_fn("native/build/bf16.ptx", "bf16deq")
    if (fgemm == 0 || fbf == 0) { println("L3_FAIL kernels"); return nonev }

    lines = ""
    # ---- q_a latent, q_b, kv_a latent ----
    var<Int> d_qa = 0
    var<Int> d_qb = 0
    var<Int> d_kva = 0
    var<Int> d_kvb = 0
    var<Int> d_o = 0
    g_g_0 = gx_read(g, 0)
    d_qa = deq_bf16(fbf, g_g_0, Q_LORA * H, H)
    g_g_2 = gx_read(g, 2)
    d_qb = deq_bf16(fbf, g_g_2, HEADS * NOPE * Q_LORA, Q_LORA)
    g_g_3 = gx_read(g, 3)
    d_kva = deq_bf16(fbf, g_g_3, KV_LORA * H, H)
    g_g_5 = gx_read(g, 5)
    d_kvb = deq_bf16(fbf, g_g_5, HEADS * (NOPE + VDIM) * KV_LORA, 0)
    g_g_6 = gx_read(g, 6)
    d_o = deq_bf16(fbf, g_g_6, HEADS * VDIM * H, HEADS * VDIM)
    if (d_qa == 0 || d_qb == 0 || d_kva == 0 || d_kvb == 0 || d_o == 0) { return nonev }

    qres<Vec<Float>> = mm_host(h_a, R, H, d_qa, Q_LORA, fgemm)
    dg0<String> = digest("qres", qres)
    println(dg0)
    lines = lines + dg0 + "\n"

    var<Int> d_qaln = 0
    g_g_1 = gx_read(g, 1)
    d_qaln = deq_bf16(fbf, g_g_1, Q_LORA, 0)
    if (d_qaln == 0) { return nonev }
    qaln_w<Vec<Float>> = bulk_dtoh(d_qaln, Q_LORA)
    free_dev(d_qaln)
    qa_ln<Vec<Float>> = rms_rows(view(qres), R, Q_LORA, qaln_w)
    qfull<Vec<Float>> = mm_host(qa_ln, R, Q_LORA, d_qb, HEADS * NOPE, fgemm)
    dg1<String> = digest("qb", qfull)
    println(dg1)
    lines = lines + dg1 + "\n"

    ckraw<Vec<Float>> = mm_host(h_a, R, H, d_kva, KV_LORA, fgemm)
    var<Int> d_kvaln = 0
    g_g_4 = gx_read(g, 4)
    d_kvaln = deq_bf16(fbf, g_g_4, KV_LORA, 0)
    if (d_kvaln == 0) { return nonev }
    kvaln_w<Vec<Float>> = bulk_dtoh(d_kvaln, KV_LORA)
    free_dev(d_kvaln)
    ckv<Vec<Float>> = rms_rows(view(ckraw), R, KV_LORA, kvaln_w)
    dg2<String> = digest("ckv", ckv)
    println(dg2)
    lines = lines + dg2 + "\n"

    # ---- per-head absorbed keys/values from kv_b ----
    kvb<Vec<Float>> = bulk_dtoh(d_kvb, HEADS * (NOPE + VDIM) * KV_LORA)
    free_dev(d_kvb)
    dg3<String> = digest("kvb", kvb)
    println(dg3)
    lines = lines + dg3 + "\n"

    # ---- indexer: projections ----
    var<Int> d_wqb = 0
    var<Int> d_wk = 0
    var<Int> d_wproj = 0
    var<Int> d_gate = 0
    g_g_7 = gx_read(g, 7)
    d_wqb = deq_bf16(fbf, g_g_7, Q_LORA * IHEADS * IDIM, Q_LORA)
    g_g_8 = gx_read(g, 8)
    d_wk = deq_bf16(fbf, g_g_8, H * IDIM, H)
    g_g_11 = gx_read(g, 11)
    d_wproj = deq_bf16(fbf, g_g_11, H * IHEADS, H)
    g_g_13 = gx_read(g, 13)
    d_gate = deq_bf16(fbf, g_g_13, H * IDIM, H)
    if (d_wqb == 0 || d_wk == 0 || d_wproj == 0 || d_gate == 0) { return nonev }

    qidx<Vec<Float>> = mm_host(qres, R, Q_LORA, d_wqb, IHEADS * IDIM, fgemm)
    kraw<Vec<Float>> = mm_host(h_a, R, H, d_wk, IDIM, fgemm)
    knw<Vec<Float>> = Vec()
    knb<Vec<Float>> = Vec()
    g_g_9 = gx_read(g, 9)
    d_knw = deq_bf16(fbf, g_g_9, IDIM, 0)
    g_g_10 = gx_read(g, 10)
    d_knb = deq_bf16(fbf, g_g_10, IDIM, 0)
    if (d_knw == 0 || d_knb == 0) { return nonev }
    knw = bulk_dtoh(d_knw, IDIM)
    knb = bulk_dtoh(d_knb, IDIM)
    free_dev(d_knw)
    free_dev(d_knb)
    kn<Vec<Float>> = ln_rows(borrow(kraw), R, IDIM, knw, knb)
    gsc<Vec<Float>> = mm_host(h_a, R, H, d_gate, IDIM, fgemm)
    # chained-decode capture: this layer's cache rows for the phase-2 walk
    capi<Int> = 0
    while (capi < R * KV_LORA) {
        ckv_out.set(capslot * CAPT * KV_LORA + capi, ckv.get(capi))
        capi = capi + 1
    }
    capi = 0
    while (capi < R * IDIM) {
        ik_out.set(capslot * CAPT * IDIM + capi, kn.get(capi))
        gsc_out.set(capslot * CAPT * IDIM + capi, gsc.get(capi))
        capi = capi + 1
    }
    wproj<Vec<Float>> = mm_host(h_a, R, H, d_wproj, IHEADS, fgemm)
    dg4<String> = digest("kidx", kn)
    println(dg4)
    lines = lines + dg4 + "\n"
    dg5<String> = digest("gsc", gsc)
    println(dg5)
    lines = lines + dg5 + "\n"
    dg6<String> = digest("wproj", wproj)
    println(dg6)
    lines = lines + dg6 + "\n"

    # ---- absorbed per-head keys/values: K = ckv @ [uk_h | ...], V = ckv @ [uv_h | ...] ----
    # kvb holds [heads, nope+v, kv_lora]; uk[h] = kvb[h][:NOPE], uv[h] = kvb[h][NOPE:]
    ukm<Vec<Float>> = Vec()          # [KV_LORA, HEADS*NOPE]
    uvm<Vec<Float>> = Vec()          # [KV_LORA, HEADS*VDIM]
    d2 = 0
    while (d2 < KV_LORA * HEADS * NOPE) {
        ukm.push(0.0)
        uvm.push(0.0)
        d2 = d2 + 1
    }
    hh = 0
    while (hh < HEADS) {
        j2 = 0
        while (j2 < NOPE) {
            d2 = 0
            while (d2 < KV_LORA) {
                ukm.set(d2 * (HEADS * NOPE) + hh * NOPE + j2,
                        kvb.get((hh * (NOPE + VDIM) + j2) * KV_LORA + d2))
                uvm.set(d2 * (HEADS * VDIM) + hh * VDIM + j2,
                        kvb.get((hh * (NOPE + VDIM) + NOPE + j2) * KV_LORA + d2))
                d2 = d2 + 1
            }
            j2 = j2 + 1
        }
        hh = hh + 1
    }
    var<Int> d_ukm = 0
    var<Int> d_uvm = 0
    d_ukm = alloc_dev(KV_LORA * HEADS * NOPE * 8)
    d_uvm = alloc_dev(KV_LORA * HEADS * VDIM * 8)
    if (d_ukm == 0 || d_uvm == 0) { return nonev }
    bulk_htod(d_ukm, view(ukm))
    bulk_htod(d_uvm, view(uvm))
    K<Vec<Float>> = mm_host(ckv, R, KV_LORA, d_ukm, HEADS * NOPE, fgemm)
    V<Vec<Float>> = mm_host(ckv, R, KV_LORA, d_uvm, HEADS * VDIM, fgemm)
    free_dev(d_ukm)
    free_dev(d_uvm)
    dg7<String> = digest("K", K)
    println(dg7)
    lines = lines + dg7 + "\n"

    # ---- indexer: gpool pooling + per-query pool scores (dsa_ref.indexer_topk) ----
    ape<Vec<Float>> = Vec()
    raw_ape = gx_read(g, 12)
    i = 0
    while (i < KPOOL * IDIM) {
        ape.push(f32_at(raw_ape, i))
        i = i + 1
    }
    npools = R / KPOOL                    # complete pools (a partial tail pool is dropped)
    poolk<Vec<Float>> = Vec()                  # [npools, IDIM]
    d2 = 0
    while (d2 < npools * IDIM) {
        poolk.push(0.0)
        d2 = d2 + 1
    }
    p = 0
    while (p < npools) {
        c = 0
        while (c < IDIM) {
            # softmax over the pool's slots of (gate + ape), per channel
            mx = 0.0 - 1e30
            a = 0
            while (a < KPOOL) {
                lg = gsc.get((p * KPOOL + a) * IDIM + c) + ape.get(a * IDIM + c)
                if (lg > mx) { mx = lg }
                a = a + 1
            }
            sm = 0.0
            a = 0
            while (a < KPOOL) {
                sm = sm + vexp(gsc.get((p * KPOOL + a) * IDIM + c) + ape.get(a * IDIM + c) - mx)
                a = a + 1
            }
            acc = 0.0
            a = 0
            while (a < KPOOL) {
                pr = vexp(gsc.get((p * KPOOL + a) * IDIM + c) + ape.get(a * IDIM + c) - mx) / sm
                acc = acc + pr * kn.get((p * KPOOL + a) * IDIM + c)
                a = a + 1
            }
            poolk.set(p * IDIM + c, acc)
            c = c + 1
        }
        p = p + 1
    }
    dg8<String> = digest("poolk", poolk)
    println(dg8)
    lines = lines + dg8 + "\n"

    # index_scores[q][p] = sum_h w[q][h] * relu(dot(q_idx[q,h], poolk[p]) / sqrt(IDIM))
    isc<Vec<Float>> = Vec()
    d2 = 0
    while (d2 < R * npools) {
        isc.push(0.0)
        d2 = d2 + 1
    }
    scale_iq = 1.0 / vsqrt(IDIM as Float, 40)
    q2 = 0
    while (q2 < R) {
        p = 0
        while (p < npools) {
            acc = 0.0
            hh = 0
            while (hh < IHEADS) {
                dot = 0.0
                c = 0
                while (c < IDIM) {
                    dot = dot + qidx.get((q2 * IHEADS + hh) * IDIM + c) * poolk.get(p * IDIM + c)
                    c = c + 1
                }
                rl = dot * scale_iq
                if (rl < 0.0) { rl = 0.0 }
                acc = acc + wproj.get(q2 * IHEADS + hh) * (1.0 / vsqrt(IHEADS as Float, 40)) * rl
                hh = hh + 1
            }
            isc.set(q2 * npools + p, acc)
            p = p + 1
        }
        q2 = q2 + 1
    }

    # selection per query: candidate pools are those whose LAST token is visible, top
    # select_k = min(TOPK/KPOOL, npools); then the visible tail; -1 pads. One line per
    # query so verify_l3_vyb.py can diff the token sets against the gold's topk.
    sel<Vec<Int>> = Vec()
    d2 = 0
    while (d2 < R * R) {
        sel.push(-1)
        d2 = d2 + 1
    }
    select_k = TOPK / KPOOL
    if (select_k > npools) { select_k = npools }
    q2 = 0
    while (q2 < R) {
        # order candidate pools by score desc (candidates only; partial pools already dropped)
        taken<Vec<Int>> = Vec()
        k2 = 0
        while (k2 < select_k) {
            bestp = -1
            best = 0.0 - 1e30
            p = 0
            while (p < npools) {
                last = p * KPOOL + KPOOL - 1
                used = 0
                k3 = 0
                while (k3 < taken.len()) {
                    if (taken.get(k3) == p) { used = 1 }
                    k3 = k3 + 1
                }
                if (last <= q2 && used == 0) {
                    sc = isc.get(q2 * npools + p)
                    if (sc > best) {
                        best = sc
                        bestp = p
                    }
                }
                p = p + 1
            }
            if (bestp < 0) { k2 = select_k } else {
                taken.push(bestp)
                a = 0
                while (a < KPOOL) {
                    sel.set(q2 * R + taken.len() * KPOOL - KPOOL + a, bestp * KPOOL + a)
                    a = a + 1
                }
                k2 = k2 + 1
            }
        }
        # visible tail: the tokens after the last complete selected pool region
        vcount = q2 + 1
        tcount = vcount % KPOOL
        tstart = vcount - tcount
        a = 0
        while (a < tcount) {
            slot = taken.len() * KPOOL + a
            if (slot < R) { sel.set(q2 * R + slot, tstart + a) }
            a = a + 1
        }
        q2 = q2 + 1
    }
    selline = "sel"
    q2 = 0
    while (q2 < R) {
        selline = selline + " q" + q2.to_string() + "=["
        first = 1
        i = 0
        while (i < R) {
            tv = sel.get(q2 * R + i)
            if (tv >= 0) {
                if (first == 0) { selline = selline + "," }
                selline = selline + tv.to_string()
                first = 0
            }
            i = i + 1
        }
        selline = selline + "]"
        q2 = q2 + 1
    }
    lines = lines + selline + "\n"
    println(selline)

    # ---- masked MLA attention per head, then o_proj ----
    # probs[q][h][i] is materialised once per (query, head): the naive form recomputed the
    # q·k dot inside the value loop, which is O(R^2 * H * VDIM * NOPE) and never finishes.
    sc_scale = 1.0 / vsqrt(NOPE as Float, 40)
    probs<Vec<Float>> = Vec()
    d2 = 0
    while (d2 < R * HEADS * R) {
        probs.push(0.0)
        d2 = d2 + 1
    }
    hh = 0
    while (hh < HEADS) {
        q2 = 0
        while (q2 < R) {
            mx = 0.0 - 1e30
            i = 0
            while (i < R) {
                if (sel.get(q2 * R + i) >= 0) {
                    dot = 0.0
                    c = 0
                    while (c < NOPE) {
                        dot = dot + qfull.get((q2 * HEADS + hh) * NOPE + c) *
                                    K.get((i * HEADS + hh) * NOPE + c)
                        c = c + 1
                    }
                    sv = dot * sc_scale
                    if (sv > mx) { mx = sv }
                }
                i = i + 1
            }
            sm = 0.0
            i = 0
            while (i < R) {
                if (sel.get(q2 * R + i) >= 0) {
                    dot = 0.0
                    c = 0
                    while (c < NOPE) {
                        dot = dot + qfull.get((q2 * HEADS + hh) * NOPE + c) *
                                    K.get((i * HEADS + hh) * NOPE + c)
                        c = c + 1
                    }
                    sm = sm + vexp(dot * sc_scale - mx)
                }
                i = i + 1
            }
            i = 0
            while (i < R) {
                if (sel.get(q2 * R + i) >= 0) {
                    dot = 0.0
                    c = 0
                    while (c < NOPE) {
                        dot = dot + qfull.get((q2 * HEADS + hh) * NOPE + c) *
                                    K.get((i * HEADS + hh) * NOPE + c)
                        c = c + 1
                    }
                    probs.set((q2 * HEADS + hh) * R + i, vexp(dot * sc_scale - mx) / sm)
                }
                i = i + 1
            }
            q2 = q2 + 1
        }
        hh = hh + 1
    }
    ao<Vec<Float>> = Vec()
    d2 = 0
    while (d2 < R * HEADS * VDIM) {
        ao.push(0.0)
        d2 = d2 + 1
    }
    hh = 0
    while (hh < HEADS) {
        q2 = 0
        while (q2 < R) {
            c = 0
            while (c < VDIM) {
                acc = 0.0
                i = 0
                while (i < R) {
                    pv = probs.get((q2 * HEADS + hh) * R + i)
                    if (pv != 0.0) {
                        acc = acc + pv * V.get((i * HEADS + hh) * VDIM + c)
                    }
                    i = i + 1
                }
                ao.set((q2 * HEADS + hh) * VDIM + c, acc)
                c = c + 1
            }
            q2 = q2 + 1
        }
        hh = hh + 1
    }
    dg9<String> = digest("ao", ao)
    println(dg9)
    lines = lines + dg9 + "\n"
    attn<Vec<Float>> = mm_host(ao, R, HEADS * VDIM, d_o, H, fgemm)
    dg10<String> = digest("attn", attn)
    println(dg10)
    lines = lines + dg10 + "\n"

    return attn
}

# dsa_attn_site, passing the cache borrows through to attn_site_c.

share(all)
dsa_attn_site_c(streams0<Vec<Float>>, tab<String>, dir<String>, total<Int>, lpre<String>, fgemm<Int>, fbf<Int>, fdeq<Int>, fhgen<Int>, fhad1<Int>, fhad2<Int>, mapbody<String>, ckv_out<their<Vec<Float>>>, ik_out<their<Vec<Float>>>, gsc_out<their<Vec<Float>>>, slot<Int>)<Vec<Float>> -> {
    nonev<Vec<Float>> = Vec()
    i<Int> = 0
    j<Int> = 0
    nfound<Int> = 0
    d_fnA<Int> = 0
    d_flat<Int> = 0
    d_mv<Int> = 0
    d_scr<Int> = 0
    # ---- hc_attn mix -> collapsed -> input_layernorm -> h_a ----
    w<Vec<String>> = Vec()
    w.push(lpre + "hc_attn_fn")
    w.push(lpre + "hc_attn_base")
    w.push(lpre + "hc_attn_scale")
    w.push(lpre + "input_layernorm.weight")
    g<GxLoc> = gx_resolve_tab(tab, dir, total, w)
    j = 0
    while (j < w.len()) {
        if (g.found.get(j) == 1) { nfound = nfound + 1 }
        j = j + 1
    }
    if (nfound != w.len()) { println("FULL_FAIL resolve " + nfound.to_string()); return nonev }


    g_g_0 = gx_read(g, 0)
    d_fnA = deq_bf16(fbf, g_g_0, 24 * HC * H, HC * H)
    if (d_fnA == 0) { return nonev }
    baseA<Vec<Float>> = Vec()
    raw_baseA = gx_read(g, 1)
    j = 0
    while (j < 24) {
        baseA.push(f32_at(raw_baseA, j))
        j = j + 1
    }
    scaleA<Vec<Float>> = Vec()
    raw_scaleA = gx_read(g, 2)
    j = 0
    while (j < 3) {
        scaleA.push(f32_at(raw_scaleA, j))
        j = j + 1
    }
    g_g_3 = gx_read(g, 3)
    d_lnA = deq_bf16(fbf, g_g_3, H, 0)
    in_ln<Vec<Float>> = bulk_dtoh(d_lnA, H)

    flat<Vec<Float>> = rms_rows(view(streams0), R, HC * H, Vec())
    d_flat = alloc_dev(R * HC * H * 8)
    d_mv = alloc_dev(R * 24 * 8)
    d_scr = alloc_dev(64)
    if (d_flat == 0 || d_mv == 0 || d_scr == 0) { return nonev }
    bulk_htod(d_flat, view(flat))
    if (gemm(fgemm, d_scr, d_flat, d_fnA, d_mv, R, 24, HC * H, 1.0, 0.0) != 0) { return nonev }
    sync()
    mv<Vec<Float>> = bulk_dtoh(d_mv, R * 24)
    free_dev(d_flat)
    free_dev(d_mv)
    free_dev(d_scr)
    free_dev(d_fnA)

    resA<Vec<Float>> = hc_glue(mv, baseA, scaleA, streams0)
    collapsed<Vec<Float>> = Vec()
    i = 0
    while (i < R * H) {
        collapsed.push(resA.get(i))
        i = i + 1
    }
    postA<Vec<Float>> = Vec()
    i = 0
    while (i < R * HC) {
        postA.push(resA.get(R * H + i))
        i = i + 1
    }
    combA<Vec<Float>> = Vec()
    i = 0
    while (i < R * HC * HC) {
        combA.push(resA.get(R * H + R * HC + i))
        i = i + 1
    }
    h_a<Vec<Float>> = rms_rows(view(collapsed), R, H, in_ln)
    lines<String> = ""

    # ---- attention site (verbatim from glm_l3_attn_fwd.vyb) ----
    attn<Vec<Float>> = attn_site_c(h_a, tab, lpre, fgemm, fbf, ckv_out, ik_out, gsc_out, slot)
    dg36<String> = digest("h_a", h_a)
    dg37<String> = digest("attn", attn)
    println(dg37)
    lines = lines + dg36 + "\n" + dg37 + "\n"

    # ---- join: hc_apply -> streams1 ----
    streams1<Vec<Float>> = hc_apply(streams0, attn, postA, combA)
    dg31<String> = digest("streams1", streams1)
    println(dg31)
    lines = lines + dg31 + "\n"
    return streams1
}

# kda_attn_site + conv-ring capture (the last 3 PRE-conv rows, oldest first) and the
# recurrence-state capture through delta_rule_cap.

share(all)
kda_attn_site_c(streams<their<Vec<Float> const>>, tab<String>, dir<String>, total<Int>, lpre<String>, fgemm<Int>, fbf<Int>, st_out<their<Vec<Float>>>, capslot<Int>, rq_out<their<Vec<Float>>>, rk_out<their<Vec<Float>>>, rv_out<their<Vec<Float>>>)<Vec<Float>> -> {
    nonev<Vec<Float>> = Vec()
    lines<String> = ""
    nf<Int> = 0
    idtxt<String> = ""
    cur<String> = ""
    ch<String> = ""
    emb_off<Int> = 0
    emb_path<String> = ""
    raw_emb<String> = ""
    r<Int> = 0
    hh<Int> = 0
    d<Int> = 0
    raw_base<String> = ""
    raw_scale<String> = ""
    d_q<Int> = 0
    d_k<Int> = 0
    d_v<Int> = 0
    d_o<Int> = 0
    d_b<Int> = 0
    d_fa<Int> = 0
    d_fb<Int> = 0
    d_ga<Int> = 0
    d_gb<Int> = 0
    raw_dt<String> = ""
    raw_alog<String> = ""
    d_onorm<Int> = 0
    d_ln2<Int> = 0
    d_gate<Int> = 0
    d_up<Int> = 0
    d_down<Int> = 0
    lines = ""
    nf = 0
    want<Vec<String>> = Vec()
    want.push(lpre + "self_attn.q_proj.weight")
    want.push(lpre + "self_attn.k_proj.weight")
    want.push(lpre + "self_attn.v_proj.weight")
    want.push(lpre + "self_attn.o_proj.weight")
    want.push(lpre + "self_attn.b_proj.weight")
    want.push(lpre + "self_attn.f_a_proj.weight")
    want.push(lpre + "self_attn.f_b_proj.weight")
    want.push(lpre + "self_attn.g_a_proj.weight")
    want.push(lpre + "self_attn.g_b_proj.weight")
    want.push(lpre + "self_attn.o_norm.weight")
    want.push(lpre + "self_attn.dt_bias")
    want.push(lpre + "self_attn.A_log")
    want.push(lpre + "input_layernorm.weight")
    want.push(lpre + "post_attention_layernorm.weight")
    want.push(lpre + "hc_attn_fn")
    want.push(lpre + "hc_attn_base")
    want.push(lpre + "hc_attn_scale")
    want.push(lpre + "hc_ffn_fn")
    want.push(lpre + "hc_ffn_base")
    want.push(lpre + "hc_ffn_scale")
    want.push("model.language_model.embed_tokens.weight")
    want.push(lpre + "self_attn.q_conv1d.weight")
    want.push(lpre + "self_attn.k_conv1d.weight")
    want.push(lpre + "self_attn.v_conv1d.weight")

    g<GxLoc> = gx_resolve_tab(tab, dir, total, want)
    i = 0
    while (i < want.len()) {
        if (g.found.get(i) == 1) { nf = nf + 1 }
        i = i + 1
    }
    if (nf != want.len()) {
        i = 0
        while (i < want.len()) {
            if (g.found.get(i) != 1) { println("L0_UNFOUND " + want.get(i)) }
            i = i + 1
        }
        println("L0_FAIL resolve " + nf.to_string())
        return nonev
    }

    if (tensor_init() != 0) { println("L0_FAIL no cuda"); return nonev }
    fgemm = load_fn("native/build/gemm.ptx", "gemm")
    fbf = load_fn("native/build/bf16.ptx", "bf16deq")
    if (fgemm == 0) { println("L0_FAIL gemm.ptx (make gemm)"); return nonev }
    if (fbf == 0) { println("L0_FAIL bf16.ptx (make bf16)"); return nonev }

# ---------------------------------------------------------------- hc mix (attn)
    t0<Int> = time_mono_millis()
    t1<Int> = 0
    tr<Int> = 0
    td<Int> = 0
    tp<Int> = 0
    tf<Int> = 0
    tg<Int> = 0
    tm<Int> = 0
    var<Int> d_fnA = 0
    var<Int> d_fnF = 0
    g_g_14 = gx_read(g, 14)
    d_fnA = deq_bf16(fbf, g_g_14, 24 * HC * H, HC * H)
    t1 = time_mono_millis()
    td = td + (t1 - t0)
    t0 = t1
    g_g_14 = gx_read(g, 14)
    if (d_fnA == 0) { println("KFAIL fnA rawlen=" + g_g_14.len().to_string()); return nonev }
    g_g_17 = gx_read(g, 17)
    d_fnF = deq_bf16(fbf, g_g_17, 24 * HC * H, HC * H)
    t1 = time_mono_millis()
    td = td + (t1 - t0)
    t0 = t1
    g_g_17 = gx_read(g, 17)
    if (d_fnF == 0) { println("KFAIL fnF rawlen=" + g_g_17.len().to_string()); return nonev }
    base<Vec<Float>> = Vec()
    raw_base = gx_read(g, 15)
    j = 0
    while (j < 24) {
        base.push(f32_at(raw_base, j))
        j = j + 1
    }
    scale<Vec<Float>> = Vec()
    raw_scale = gx_read(g, 16)
    j = 0
    while (j < 3) {
        scale.push(f32_at(raw_scale, j))
        j = j + 1
    }
    baseF<Vec<Float>> = Vec()
    g_g_18 = gx_read(g, 18)
    raw_baseF<String> = g_g_18
    j = 0
    while (j < 24) {
        baseF.push(f32_at(raw_baseF, j))
        j = j + 1
    }
    scaleF<Vec<Float>> = Vec()
    g_g_19 = gx_read(g, 19)
    raw_scaleF<String> = g_g_19
    j = 0
    while (j < 3) {
        scaleF.push(f32_at(raw_scaleF, j))
        j = j + 1
    }
    println("hc attn base0=" + di(base.get(0)).to_string() + " scale0=" + di(scale.get(0)).to_string())

    # ---------------------------------------------------------------- hc mix via gemm
    t0 = time_mono_millis()
    # flat = rms(streams flat) ; mv = flat @ fn^T  ([R,4H] @ [4H,24])
    flat<Vec<Float>> = Vec()
    i = 0
    while (i < streams.len()) {
        flat.push(streams.get(i))
        i = i + 1
    }
    t1 = time_mono_millis()
    tp = tp + (t1 - t0)
    t0 = t1
    flat = rms_rows(view(flat), R, HC * H, Vec())
    t1 = time_mono_millis()
    tp = tp + (t1 - t0)
    t0 = t1
    var<Int> d_flat = 0
    var<Int> d_mv = 0
    var<Int> d_scr = 0
    d_flat = alloc_dev(R * HC * H * 8)
    d_mv = alloc_dev(R * 24 * 8)
    d_scr = alloc_dev(64)
    if (d_flat == 0 || d_mv == 0 || d_scr == 0) { println("L0_FAIL alloc"); return nonev }
    bulk_htod(d_flat, view(flat))
    t1 = time_mono_millis()
    tf = tf + (t1 - t0)
    t0 = t1
    if (gemm(fgemm, d_scr, d_flat, d_fnA, d_mv, R, 24, HC * H, 1.0, 0.0) != 0) { println("KFAIL gemm"); return nonev }
    sync()
    t1 = time_mono_millis()
    tg = tg + (t1 - t0)
    t0 = t1
    mv<Vec<Float>> = bulk_dtoh(d_mv, R * 24)
    free_dev(d_flat)
    free_dev(d_mv)
    free_dev(d_scr)
    t1 = time_mono_millis()
    tm = tm + (t1 - t0)
    t0 = t1
    dg11<String> = digest("mv_attn", mv)
    println(dg11)
    lines = lines + dg11 + "\n"

    res<Vec<Float>> = hc_glue(mv, base, scale, streams)
    t1 = time_mono_millis()
    tp = tp + (t1 - t0)
    t0 = t1
    collapsed<Vec<Float>> = Vec()
    i = 0
    while (i < R * H) {
        collapsed.push(res.get(i))
        i = i + 1
    }
    postA<Vec<Float>> = Vec()
    i = 0
    while (i < R * HC) {
        postA.push(res.get(R * H + i))
        i = i + 1
    }
    combA<Vec<Float>> = Vec()
    i = 0
    while (i < R * HC * HC) {
        combA.push(res.get(R * H + R * HC + i))
        i = i + 1
    }
    dg12<String> = digest("collapsed", collapsed)
    println(dg12)
    lines = lines + dg12 + "\n"
    dg13<String> = digest("post_attn", postA)
    println(dg13)
    lines = lines + dg13 + "\n"
    dg14<String> = digest("comb_attn", combA)
    println(dg14)
    lines = lines + dg14 + "\n"
    var<Int> dump_rc = 0
    t1 = time_mono_millis()
    tr = tr + (t1 - t0)
    println("T_HCA deq=" + td.to_string() + " hostpush+glue=" + tp.to_string() +
        " htod=" + tf.to_string() + " gemm=" + tg.to_string() + " dtoh+free=" + tm.to_string() +
        " tail=" + tr.to_string())

    # ---------------------------------------------------------------- input_layernorm
    var<Int> d_ln = 0
    g_g_12 = gx_read(g, 12)
    d_ln = deq_bf16(fbf, g_g_12, H, 0)
    if (d_ln == 0) { return nonev }
    in_ln<Vec<Float>> = bulk_dtoh(d_ln, H)
    free_dev(d_ln)
    h_a<Vec<Float>> = rms_rows(view(collapsed), R, H, in_ln)
    dg15<String> = digest("h", h_a)
    println(dg15)
    lines = lines + dg15 + "\n"
    # =============================================================== KDA attention
    t0 = time_mono_millis()
    kd1<Int> = 0
    kd2<Int> = 0
    kd3<Int> = 0
    kd4<Int> = 0
    kd5<Int> = 0
    # projections (host batch [R,H] @ [H,out] on the GPU)
    g_g_0 = gx_read(g, 0)
    d_q = deq_bf16(fbf, g_g_0, H * HEADS * KD, H)
    g_g_1 = gx_read(g, 1)
    d_k = deq_bf16(fbf, g_g_1, H * HEADS * KD, H)
    g_g_2 = gx_read(g, 2)
    d_v = deq_bf16(fbf, g_g_2, H * HEADS * KD, H)
    g_g_3 = gx_read(g, 3)
    d_o = deq_bf16(fbf, g_g_3, HEADS * KD * H, HEADS * KD)
    g_g_4 = gx_read(g, 4)
    d_b = deq_bf16(fbf, g_g_4, H * HEADS, H)
    g_g_5 = gx_read(g, 5)
    d_fa = deq_bf16(fbf, g_g_5, H * 128, H)
    g_g_6 = gx_read(g, 6)
    d_fb = deq_bf16(fbf, g_g_6, 128 * HEADS * KD, 128)
    g_g_7 = gx_read(g, 7)
    d_ga = deq_bf16(fbf, g_g_7, H * 128, H)
    g_g_8 = gx_read(g, 8)
    d_gb = deq_bf16(fbf, g_g_8, 128 * HEADS * KD, 128)
    if (d_q == 0 || d_k == 0 || d_v == 0 || d_o == 0 || d_b == 0 || d_fa == 0 || d_fb == 0 || d_ga == 0 || d_gb == 0) {
        println("L0_FAIL weight deq")
        return nonev
    }
    kd1 = kd1 + (time_mono_millis() - t0)
    t0 = time_mono_millis()
    qp<Vec<Float>> = mm_host(h_a, R, H, d_q, HEADS * KD, fgemm)
    kp<Vec<Float>> = mm_host(h_a, R, H, d_k, HEADS * KD, fgemm)
    vp<Vec<Float>> = mm_host(h_a, R, H, d_v, HEADS * KD, fgemm)
    kd2 = kd2 + (time_mono_millis() - t0)
    # chained-decode capture: the k=4 conv's 3-row PRE-conv ring = the last three
    # rows of the batched pre-conv projections (oldest first), per tensor q/k/v.
    capr<Int> = 0
    while (capr < CONV_K - 1) {
        capc<Int> = 0
        while (capc < HEADS * KD) {
            rq_out.set(capslot * (CONV_K - 1) * HEADS * KD + capr * HEADS * KD + capc,
                       qp.get((R - (CONV_K - 1) + capr) * HEADS * KD + capc))
            rk_out.set(capslot * (CONV_K - 1) * HEADS * KD + capr * HEADS * KD + capc,
                       kp.get((R - (CONV_K - 1) + capr) * HEADS * KD + capc))
            rv_out.set(capslot * (CONV_K - 1) * HEADS * KD + capr * HEADS * KD + capc,
                       vp.get((R - (CONV_K - 1) + capr) * HEADS * KD + capc))
            capc = capc + 1
        }
        capr = capr + 1
    }
    dg16<String> = digest("qpre", qp)
    println(dg16)
    lines = lines + dg16 + "\n"

    # conv+silu over the token axis, then l2-normalise (q also scaled by 1/sqrt(KD))
    # conv1d weights are BF16 (only dt_bias / A_log / hc base+scale are FP32 here)
    var<Int> t2 = 0
    var<Int> d_cq = 0
    var<Int> d_ck = 0
    var<Int> d_cv = 0
    g_g_21 = gx_read(g, 21)
    d_cq = deq_bf16(fbf, g_g_21, HEADS * KD * CONV_K, 0)
    g_g_22 = gx_read(g, 22)
    d_ck = deq_bf16(fbf, g_g_22, HEADS * KD * CONV_K, 0)
    g_g_23 = gx_read(g, 23)
    d_cv = deq_bf16(fbf, g_g_23, HEADS * KD * CONV_K, 0)
    if (d_cq == 0 || d_ck == 0 || d_cv == 0) { return nonev }
    convq<Vec<Float>> = bulk_dtoh(d_cq, HEADS * KD * CONV_K)
    convk<Vec<Float>> = bulk_dtoh(d_ck, HEADS * KD * CONV_K)
    convv<Vec<Float>> = bulk_dtoh(d_cv, HEADS * KD * CONV_K)
    free_dev(d_cq)
    free_dev(d_ck)
    free_dev(d_cv)
    qc<Vec<Float>> = conv_silu(qp, R, HEADS * KD, convq)
    kc<Vec<Float>> = conv_silu(kp, R, HEADS * KD, convk)
    vc<Vec<Float>> = conv_silu(vp, R, HEADS * KD, convv)
    kd3 = kd3 + (time_mono_millis() - t0)
    t0 = time_mono_millis()
    tq0<Int> = time_mono_millis()
    dg17<String> = digest("qc", qc)
    tq1<Int> = time_mono_millis()
    println(dg17)
    lines = lines + dg17 + "\n"
    dg18<String> = digest("vc", vc)
    tq2<Int> = time_mono_millis()
    println(dg18)
    lines = lines + dg18 + "\n"
    qn<Vec<Float>> = l2_rows(qc, R * HEADS, KD)
    kn<Vec<Float>> = l2_rows(kc, R * HEADS, KD)
    t2 = 0
    while (t2 < qn.len()) {
        qn.set(t2, qn.get(t2) * (1.0 / vsqrt(KD as Float, 40)))
        t2 = t2 + 1
    }

    dg19<String> = digest("qn", qn)
    tq3<Int> = time_mono_millis()
    println(dg19)
    lines = lines + dg19 + "\n"
    tq4<Int> = time_mono_millis()
    dump_rc = 0
    tq5<Int> = time_mono_millis()
    dg20<String> = digest("kn", kn)
    tq6<Int> = time_mono_millis()
    println(dg20)
    lines = lines + dg20 + "\n"
    kd4 = kd4 + (time_mono_millis() - t0)
    println("T_KDD qc=" + (tq1 - tq0).to_string() + " vc=" + (tq2 - tq1).to_string() +
        " qn=" + (tq3 - tq2).to_string() + " dump=" + (tq5 - tq4).to_string() +
        " kn=" + (tq6 - tq5).to_string())
    t0 = time_mono_millis()
    bet<Vec<Float>> = mm_host(h_a, R, H, d_b, HEADS, fgemm)
    t2 = 0
    while (t2 < bet.len()) {
        bet.set(t2, sigmoid(bet.get(t2)))
        t2 = t2 + 1
    }

    dg21<String> = digest("beta", bet)
    println(dg21)
    lines = lines + dg21 + "\n"
    fa<Vec<Float>> = mm_host(h_a, R, H, d_fa, 128, fgemm)
    fraw<Vec<Float>> = mm_host(fa, R, 128, d_fb, HEADS * KD, fgemm)
    ga<Vec<Float>> = mm_host(h_a, R, H, d_ga, 128, fgemm)
    zraw<Vec<Float>> = mm_host(ga, R, 128, d_gb, HEADS * KD, fgemm)

    raw_dt = gx_read(g, 10)          # FP32 in the checkpoint
    dt<Vec<Float>> = Vec()
    t2 = 0
    while (t2 < HEADS * KD) {
        dt.push(f32_at(raw_dt, t2))
        t2 = t2 + 1
    }
    raw_alog = gx_read(g, 11)
    alog<Vec<Float>> = Vec()
    t2 = 0
    while (t2 < HEADS) {
        alog.push(f32_at(raw_alog, t2))
        t2 = t2 + 1
    }
    dg22<String> = digest("fraw", fraw)
    println(dg22)
    lines = lines + dg22 + "\n"
    dg23<String> = digest("zraw", zraw)
    println(dg23)
    lines = lines + dg23 + "\n"
    kd5 = kd5 + (time_mono_millis() - t0)
    t0 = time_mono_millis()
    gdec<Vec<Float>> = log_decay(view(fraw), dt, alog)
    dg24<String> = digest("gdec", gdec)
    println(dg24)
    lines = lines + dg24 + "\n"
    kd5 = kd5 + (time_mono_millis() - t0)
    t0 = time_mono_millis()

    att<Vec<Float>> = delta_rule(view(qn), view(kn), view(vc), view(gdec), bet)
    kd6<Int> = time_mono_millis() - t0
    t0 = time_mono_millis()
    dg25<String> = digest("delta", att)
    println(dg25)
    lines = lines + dg25 + "\n"

    println("G9PROBE found=" + g.found.get(9).to_string() + " off=" + g.off.get(9).to_string() +
            " nbytes=" + g.nbytes.get(9).to_string() + " pathlen=" + g.paths.get(9).len().to_string() +
            " path=" + g.paths.get(9))
    g_g_9 = gx_read(g, 9)
    d_onorm = deq_bf16(fbf, g_g_9, KD, 0)
    if (d_onorm == 0) { return nonev }
    onorm<Vec<Float>> = bulk_dtoh(d_onorm, KD)
    free_dev(d_onorm)
    gnorm<Vec<Float>> = gated_norm(att, zraw, onorm)
    attn<Vec<Float>> = mm_host(gnorm, R, HEADS * KD, d_o, H, fgemm)
    kd7<Int> = time_mono_millis() - t0
    println("T_KDB deq=" + kd1.to_string() + " mm_qkv=" + kd2.to_string() +
        " conv=" + kd3.to_string() + " digests1=" + kd4.to_string() +
        " mm_bfz+parse=" + kd5.to_string() + " delta=" + kd6.to_string() +
        " tail=" + kd7.to_string())
    dg26<String> = digest("attn", attn)
    println(dg26)
    lines = lines + dg26 + "\n"

    streams1<Vec<Float>> = hc_apply(streams, attn, postA, combA)
    kd8<Int> = time_mono_millis() - t0
    t0 = time_mono_millis()
    dg27<String> = digest("streams1", streams1)
    println(dg27)
    lines = lines + dg27 + "\n"
    kd9<Int> = time_mono_millis() - t0
    println("T_KDC hc_apply=" + kd8.to_string() + " digest_streams1=" + kd9.to_string())
    free_dev(d_q)
    free_dev(d_k)
    free_dev(d_v)
    free_dev(d_o)
    free_dev(d_b)
    free_dev(d_fa)
    free_dev(d_fb)
    free_dev(d_ga)
    free_dev(d_gb)
    free_dev(d_fnA)


    return streams1
}

# ffn_dense_site / tail_site: verbatim (no carried state).

share(all)
ffn_dense_site(streams1<Vec<Float>>, tab<String>, dir<String>, total<Int>, lpre<String>, fgemm<Int>, fbf<Int>)<Vec<Float>> -> {
    nonev<Vec<Float>> = Vec()
    lines<String> = ""
    nf<Int> = 0
    idtxt<String> = ""
    cur<String> = ""
    ch<String> = ""
    emb_off<Int> = 0
    emb_path<String> = ""
    raw_emb<String> = ""
    r<Int> = 0
    hh<Int> = 0
    d<Int> = 0
    raw_base<String> = ""
    raw_scale<String> = ""
    d_q<Int> = 0
    d_k<Int> = 0
    d_v<Int> = 0
    d_o<Int> = 0
    d_b<Int> = 0
    d_fa<Int> = 0
    d_fb<Int> = 0
    d_ga<Int> = 0
    d_gb<Int> = 0
    raw_dt<String> = ""
    raw_alog<String> = ""
    d_onorm<Int> = 0
    d_ln2<Int> = 0
    d_gate<Int> = 0
    d_up<Int> = 0
    d_down<Int> = 0
    lines = ""
    nf = 0
    want<Vec<String>> = Vec()
    want.push(lpre + "mlp.gate_proj.weight")
    want.push(lpre + "mlp.up_proj.weight")
    want.push(lpre + "mlp.down_proj.weight")
    want.push(lpre + "post_attention_layernorm.weight")
    want.push(lpre + "hc_ffn_fn")
    want.push(lpre + "hc_ffn_base")
    want.push(lpre + "hc_ffn_scale")

    g<GxLoc> = gx_resolve_tab(tab, dir, total, want)
    i = 0
    while (i < want.len()) {
        if (g.found.get(i) == 1) { nf = nf + 1 }
        i = i + 1
    }
    if (nf != want.len()) { println("L0_FAIL resolve " + nf.to_string()); return nonev }

    if (tensor_init() != 0) { println("L0_FAIL no cuda"); return nonev }
    fgemm = load_fn("native/build/gemm.ptx", "gemm")
    fbf = load_fn("native/build/bf16.ptx", "bf16deq")
    if (fgemm == 0) { println("L0_FAIL gemm.ptx (make gemm)"); return nonev }
    if (fbf == 0) { println("L0_FAIL bf16.ptx (make bf16)"); return nonev }

    g_g_4 = gx_read(g, 4)
    d_fnF<Int> = deq_bf16(fbf, g_g_4, 24 * HC * H, HC * H)
    if (d_fnF == 0) { return nonev }
    baseF<Vec<Float>> = Vec()
    raw_baseF = gx_read(g, 5)
    j = 0
    while (j < 24) {
        baseF.push(f32_at(raw_baseF, j))
        j = j + 1
    }
    scaleF<Vec<Float>> = Vec()
    raw_scaleF = gx_read(g, 6)
    j = 0
    while (j < 3) {
        scaleF.push(f32_at(raw_scaleF, j))
        j = j + 1
    }

    # =============================================================== ffn site + MLP
    g_g_3 = gx_read(g, 3)
    d_ln2 = deq_bf16(fbf, g_g_3, H, 0)
    if (d_ln2 == 0) { return nonev }
    post_ln<Vec<Float>> = bulk_dtoh(d_ln2, H)
    free_dev(d_ln2)

    var<Int> d_flat2 = 0
    var<Int> d_mv2 = 0
    var<Int> d_scr2 = 0
    reflat<Vec<Float>> = Vec()
    t2 = 0
    while (t2 < streams1.len()) {
        reflat.push(streams1.get(t2))
        t2 = t2 + 1
    }
    reflat = rms_rows(view(reflat), R, HC * H, Vec())
    d_flat2 = alloc_dev(R * HC * H * 8)
    d_mv2 = alloc_dev(R * 24 * 8)
    d_scr2 = alloc_dev(64)
    if (d_flat2 == 0 || d_mv2 == 0 || d_scr2 == 0) { return nonev }
    bulk_htod(d_flat2, view(reflat))
    if (gemm(fgemm, d_scr2, d_flat2, d_fnF, d_mv2, R, 24, HC * H, 1.0, 0.0) != 0) { return nonev }
    sync()
    mv2<Vec<Float>> = bulk_dtoh(d_mv2, R * 24)
    free_dev(d_flat2)
    free_dev(d_mv2)
    free_dev(d_scr2)
    free_dev(d_fnF)

    res2<Vec<Float>> = hc_glue(mv2, baseF, scaleF, streams1)
    collapsed2<Vec<Float>> = Vec()
    t2 = 0
    while (t2 < R * H) {
        collapsed2.push(res2.get(t2))
        t2 = t2 + 1
    }
    postF<Vec<Float>> = Vec()
    t2 = 0
    while (t2 < R * HC) {
        postF.push(res2.get(R * H + t2))
        t2 = t2 + 1
    }
    combF<Vec<Float>> = Vec()
    t2 = 0
    while (t2 < R * HC * HC) {
        combF.push(res2.get(R * H + R * HC + t2))
        t2 = t2 + 1
    }
    h2<Vec<Float>> = rms_rows(view(collapsed2), R, H, post_ln)
    dg28<String> = digest("h2", h2)
    println(dg28)
    lines = lines + dg28 + "\n"

    g_g_0 = gx_read(g, 0)
    d_gate = deq_bf16(fbf, g_g_0, H * INTER, H)
    g_g_1 = gx_read(g, 1)
    d_up = deq_bf16(fbf, g_g_1, H * INTER, H)
    g_g_2 = gx_read(g, 2)
    d_down = deq_bf16(fbf, g_g_2, INTER * H, INTER)
    if (d_gate == 0 || d_up == 0 || d_down == 0) { return nonev }
    mg<Vec<Float>> = mm_host(h2, R, H, d_gate, INTER, fgemm)
    mu<Vec<Float>> = mm_host(h2, R, H, d_up, INTER, fgemm)
    act<Vec<Float>> = Vec()
    t2 = 0
    while (t2 < mg.len()) {
        act.push(silu(mg.get(t2)) * mu.get(t2))
        t2 = t2 + 1
    }
    mlp<Vec<Float>> = mm_host(act, R, INTER, d_down, H, fgemm)
    dg29<String> = digest("mlp", mlp)
    println(dg29)
    lines = lines + dg29 + "\n"
    free_dev(d_gate)
    free_dev(d_up)
    free_dev(d_down)

    streams2<Vec<Float>> = hc_apply(streams1, mlp, postF, combF)
    dg30<String> = digest("streams2", streams2)
    println(dg30)
    lines = lines + dg30 + "\n"

    return streams2
    return streams2
}
share(all)
tail_site(streams1<Vec<Float>>, tab<String>, lpre<String>, fgemm<Int>, fbf<Int>, fdeq<Int>, fhgen<Int>, fhad1<Int>, fhad2<Int>, mapbody<String>, hdg<Int>, fdeq32<Int>, fdqs<Int>, fdqs4<Int>, fhad132<Int>, fhad232<Int>, fcvt32<Int>, hdg32<Int>, arA<Int>, arB<Int>, arC<Int>, arD<Int>, arG<Int>, arH<Int>, arI<Int>, mapdev<Int>, invbase<Int>, fcast32<Int>, fgp<Int>, fgr<Int>, pb32<Int>)<Vec<Float>> -> {
    nonev<Vec<Float>> = Vec()
    best<Int> = 0
    bestv<Float> = 0.0
    cv<Float> = 0.0
    d2<Int> = 0
    d_flat2<Int> = 0
    d_ln2<Int> = 0
    d_mv2<Int> = 0
    d_scr2<Int> = 0
    dir<String> = ""
    dup<Int> = 0
    e<Int> = 0
    epre<String> = ""
    g1<Float> = 0.0
    i<Int> = 0
    j<Int> = 0
    k<Int> = 0
    lane<Int> = 0
    lines<String> = ""
    nex<Int> = 0
    nfound<Int> = 0
    nt<Int> = 0
    out<String> = ""
    r<Int> = 0
    raw_bias<String> = ""
    sm<Float> = 0.0
    spath<String> = ""
    tix<Int> = 0
    tk<Int> = 0
    total<Int> = 0
    u1<Float> = 0.0
    wt<Float> = 0.0
    i = 0
    j = 0
    k = 0
    r = 0
    lane = 0
    d2 = 0
    e = 0
    nex = 0
    nt = 0
    g1 = 0.0
    u1 = 0.0
    bestv = 0.0
    cv = 0.0
    sm = 0.0
    best = 0
    total = 0
    nfound = 0
    tix = 0
    tk = 0
    wt = 0.0
    d_flat2 = 0
    d_mv2 = 0
    d_scr2 = 0
    d_fnF<Int> = 0
    d_ln2 = 0
    dup = 0
    ee<Int> = 0
    i0<Int> = 0
    acc_res<Int> = 0
    acc_scan<Int> = 0
    acc_open<Int> = 0
    nopen<Int> = 0
    acc_deq<Int> = 0
    acc_mm<Int> = 0
    acc_host<Int> = 0
    tA<Int> = 0
    tt0<Int> = 0
    tB<Int> = 0
    allw<Vec<String>> = Vec()
    galle<GxLoc> = GxLoc { found = Vec(), shard = Vec(), tix = Vec(), off = Vec(), nbytes = Vec(),
                           dts = Vec(), paths = Vec() }
    dir = env_get("VYBFORGE_GX_DIR") else "/mnt/apex/rick/vybforge/glm53-checkpoint"
    out = env_get("VYBFORGE_L3TAIL_OUT") else "native/out/l3tail_vyb.txt"
    spath = env_get("VYBFORGE_L3_STREAMS1") else "native/out/gold_l3_streams1.txt"
    total = 83

    if (tensor_init() != 0) { println("TAIL_FAIL no cuda"); return nonev }
    if (fgemm == 0 || fdeq == 0 || fhgen == 0 || fhad1 == 0 || fhad2 == 0 || fbf == 0) {
        println("TAIL_FAIL kernels")
        return nonev
    }
    mapd = ""
    match (open_read("native/exl3/map.bin")) {
        f -> { match (read_all(f)) { s -> { mapd = s } ? -> { return nonev } } close(f) }
        ? -> { println("TAIL_FAIL no map.bin"); return nonev }
    }
    body = mapd.substring(16, mapd.len())

    lines = ""
    w<Vec<String>> = Vec()
    w.push(lpre + "hc_ffn_fn")
    w.push(lpre + "hc_ffn_base")
    w.push(lpre + "hc_ffn_scale")
    w.push(lpre + "post_attention_layernorm.weight")
    gt<GxLoc> = gx_resolve_tab(tab, dir, total, w)
    nfound = 0
    j = 0
    while (j < w.len()) {
        if (gt.found.get(j) == 1) { nfound = nfound + 1 }
        j = j + 1
    }
    if (nfound != w.len()) { println("TAIL_FAIL resolve " + nfound.to_string()); return nonev }

    g_gt_0 = gx_read(gt, 0)
    d_fnF = deq_bf16(fbf, g_gt_0, 24 * HC * H, HC * H)
    if (d_fnF == 0) { return nonev }
    baseF<Vec<Float>> = Vec()
    raw_baseF = gx_read(gt, 1)
    j = 0
    while (j < 24) {
        baseF.push(f32_at(raw_baseF, j))
        j = j + 1
    }
    scaleF<Vec<Float>> = Vec()
    raw_scaleF = gx_read(gt, 2)
    j = 0
    while (j < 3) {
        scaleF.push(f32_at(raw_scaleF, j))
        j = j + 1
    }
    g_gt_3 = gx_read(gt, 3)
    d_ln2 = deq_bf16(fbf, g_gt_3, H, 0)
    post_ln<Vec<Float>> = bulk_dtoh(d_ln2, H)

    flat<Vec<Float>> = rms_rows(view(streams1), R, HC * H, Vec())
    d_flat2 = alloc_dev(R * HC * H * 8)
    d_mv2 = alloc_dev(R * 24 * 8)
    d_scr2 = alloc_dev(64)
    if (d_flat2 == 0 || d_mv2 == 0 || d_scr2 == 0) { return nonev }
    bulk_htod(d_flat2, view(flat))
    if (gemm(fgemm, d_scr2, d_flat2, d_fnF, d_mv2, R, 24, HC * H, 1.0, 0.0) != 0) { return nonev }
    sync()
    mv2<Vec<Float>> = bulk_dtoh(d_mv2, R * 24)
    free_dev(d_flat2)
    free_dev(d_mv2)
    free_dev(d_scr2)
    free_dev(d_fnF)

    res2<Vec<Float>> = hc_glue(mv2, baseF, scaleF, streams1)
    collapsed2<Vec<Float>> = Vec()
    i = 0
    while (i < R * H) {
        collapsed2.push(res2.get(i))
        i = i + 1
    }
    post2<Vec<Float>> = Vec()
    i = 0
    while (i < R * HC) {
        post2.push(res2.get(R * H + i))
        i = i + 1
    }
    comb2<Vec<Float>> = Vec()
    i = 0
    while (i < R * HC * HC) {
        comb2.push(res2.get(R * H + R * HC + i))
        i = i + 1
    }
    h2<Vec<Float>> = rms_rows(view(collapsed2), R, H, post_ln)
    dg35<String> = digest("h2", h2)
    println(dg35)
    lines = dg35 + "\n"

    tt0 = time_mono_millis()
    # ---- router (same code path as L3_MOE_ROUTE_VYB) ----
    want<Vec<String>> = Vec()
    want.push(lpre + "mlp.gate.weight")
    want.push(lpre + "mlp.gate.e_score_correction_bias")
    g<GxLoc> = gx_resolve_tab(tab, dir, total, want)
    g_g_0 = gx_read(g, 0)
    d_gw = deq_bf16(fbf, g_g_0, NE * H, H)
    if (d_gw == 0) { return nonev }
    logits<Vec<Float>> = mm_host(h2, R, H, d_gw, NE, fgemm)
    freedom {
        cuMemFree_v2(d_gw)
    }
    raw_bias = gx_read(g, 1)
    bias<Vec<Float>> = Vec()
    i = 0
    while (i < NE) {
        bias.push(f32_at(raw_bias, i))
        i = i + 1
    }
    scores<Vec<Float>> = Vec()
    i = 0
    while (i < logits.len()) {
        scores.push(sigmoid(logits.get(i)))
        i = i + 1
    }

    # top-8 per token + renormed weights
    rsel<Vec<Int>> = Vec()        # [R, 8]
    rwt<Vec<Float>> = Vec()       # [R, 8]
    i = 0
    while (i < R * ROUTE_TOPK) {
        rsel.push(-1)
        rwt.push(0.0)
        i = i + 1
    }
    r = 0
    while (r < R) {
        lane = 0
        while (lane < ROUTE_TOPK) {
            best = -1
            bestv = 0.0 - 1e30
            j = 0
            while (j < NE) {
                dup = 0
                k = 0
                while (k < lane) {
                    if (rsel.get(r * ROUTE_TOPK + k) == j) { dup = 1 }
                    k = k + 1
                }
                if (dup == 0) {
                    cv = scores.get(r * NE + j) + bias.get(j)
                    if (cv > bestv) {
                        bestv = cv
                        best = j
                    }
                }
                j = j + 1
            }
            rsel.set(r * ROUTE_TOPK + lane, best)
            lane = lane + 1
        }
        sm = 0.0
        lane = 0
        while (lane < ROUTE_TOPK) {
            sm = sm + scores.get(r * NE + rsel.get(r * ROUTE_TOPK + lane))
            lane = lane + 1
        }
        lane = 0
        while (lane < ROUTE_TOPK) {
            rwt.set(r * ROUTE_TOPK + lane,
                    scores.get(r * NE + rsel.get(r * ROUTE_TOPK + lane)) / (sm + 1e-20) * ROUTED_SCALE)
            lane = lane + 1
        }
        r = r + 1
    }

    # ---- routed experts: one dequant per (expert, projection), FFN on that expert's tokens
    accr<Vec<Float>> = Vec()
    i = 0
    while (i < R * H) {
        accr.push(0.0)
        i = i + 1
    }
    # per expert: which (token, lane) pairs chose it
    done<Vec<Int>> = Vec()
    i = 0
    while (i < NE) {
        done.push(0)
        i = i + 1
    }
    nex = 0
    # NOTE: resolving all 288 experts' 9 tensors in ONE gx_resolve is ~40% cheaper at a single
    # layer (1.4 s vs 2.4 s), but measured in the 12-layer prefill it grows ~1 s per layer
    # (1.7 -> 9.5 s) from the String churn, so at 45 layers it loses badly. Keep per-expert
    # resolution here; the win came from caching the shard header inside gx_resolve and from
    # reading the 15.5 MB index ONCE per layer instead of once per expert.
            # ---- the fast resolve: build the local name map from this layer's
            # tab ONCE per layer (~17ms; ~1185 entries stays cache-hot), then
            # O(1) HashMap lookups per expert instead of ~9 full-tab index_of
            # scans (~130ms) each. Measured FASTER than a process-wide map
            # (0.7s vs 1.5s per request — the small map stays hot) and leak-
            # free, unlike the setup-built map passed by borrow (which balloons
            # phase 2 by ~60GB — mechanism unknown; the borrow call path itself
            # probes clean, so the leak is in the runtime's long-lived-map
            # interaction with the phase-2 String churn). Any miss falls back
            # to the legacy resolve; the fallback ASSIGNS (no redeclare).
            nm<HashMap<String, String>> = HashMap<String, String>(2048)
            nmP<Int> = 0
            while (nmP < tab.len()) {
                nmLE<Int> = nmP
                nmSP<Int> = 0 - 1
                nmC<Int> = 0
                nmD<Int> = 0
                while (nmLE < tab.len() && nmD == 0) {
                    nmC = (tab.char_at(nmLE) as Int) & 255
                    if (nmC == 10) { nmD = 1 } else {
                        if (nmSP < 0 && nmC == 32) { nmSP = nmLE }
                        nmLE = nmLE + 1
                    }
                }
                if (nmSP > nmP && nmLE > nmSP) {
                    nmTN<String> = tab.substring(nmP, nmSP)
                    nmS1<Int> = 0
                    nmS2<Int> = 0
                    nmS3<Int> = 0
                    nmF<Int> = 0
                    nmK<Int> = nmSP + 1
                    while (nmK < nmLE) {
                        nmC = (tab.char_at(nmK) as Int) & 255
                        if (nmC == 32) { nmF = nmF + 1 }
                        if (nmF == 0 && nmC >= 48 && nmC <= 57) { nmS1 = nmS1 * 10 + (nmC - 48) }
                        if (nmF == 1 && nmC >= 48 && nmC <= 57) { nmS2 = nmS2 * 10 + (nmC - 48) }
                        if (nmF == 2 && nmC >= 48 && nmC <= 57) { nmS3 = nmS3 * 10 + (nmC - 48) }
                        nmK = nmK + 1
                    }
                    if (nmF >= 2) {
                        dummyB<Bool> = nm.put(nmTN, nmS1.to_string() + " " + nmS2.to_string() + " " + nmS3.to_string())
                    }
                }
                nmP = nmLE + 1
            }
    # (the fast-path map is built here, at LAYER scope: one build per layer, not per expert)
    ixL<StIndex> = st_open("")
    shL<Int> = 0
    e = 0
    while (e < NE) {
        # collect this expert's (token, lane) pairs
        toks<Vec<Int>> = Vec()
        lanes<Vec<Int>> = Vec()
        r = 0
        while (r < R) {
            lane = 0
            while (lane < ROUTE_TOPK) {
                if (rsel.get(r * ROUTE_TOPK + lane) == e) {
                    toks.push(r)
                    lanes.push(lane)
                }
                lane = lane + 1
            }
            r = r + 1
        }
        nt = toks.len()
        if (nt > 0) {
            nex = nex + 1
            tA = time_mono_millis()
            epre = lpre + "mlp.experts." + e.to_string() + "."
            w2<Vec<String>> = Vec()
            w2.push(epre + "gate_proj.trellis")
            w2.push(epre + "gate_proj.suh")
            w2.push(epre + "gate_proj.svh")
            w2.push(epre + "up_proj.trellis")
            w2.push(epre + "up_proj.suh")
            w2.push(epre + "up_proj.svh")
            w2.push(epre + "down_proj.trellis")
            w2.push(epre + "down_proj.suh")
            w2.push(epre + "down_proj.svh")
            ge<GxLoc> = GxLoc { found = Vec(), shard = Vec(), tix = Vec(), off = Vec(), nbytes = Vec(),
                               dts = Vec(), paths = Vec() }
            fastR<Int> = 1
            j2<Int> = 0
            nkR<String> = ""
            e0R<String> = ""
            while (j2 < w2.len()) {
                nkR = w2.get(j2)
                e0R = nm.get(nkR) else ""
                if (e0R.len() == 0) { fastR = 0 }
                j2 = j2 + 1
            }
            if (fastR == 1) {
                j2 = 0
                while (j2 < w2.len()) {
                    nkR = w2.get(j2)
                    e0R = nm.get(nkR) else ""
                    shv<Int> = 0
                    ov<Int> = 0
                    lv<Int> = 0
                    fld<Int> = 0
                    k4<Int> = 0
                    while (k4 < e0R.len()) {
                        c4<Int> = (e0R.char_at(k4) as Int) & 255
                        if (c4 == 32) { fld = fld + 1 }
                        if (fld == 0 && c4 >= 48 && c4 <= 57) { shv = shv * 10 + (c4 - 48) }
                        if (fld == 1 && c4 >= 48 && c4 <= 57) { ov = ov * 10 + (c4 - 48) }
                        if (fld == 2 && c4 >= 48 && c4 <= 57) { lv = lv * 10 + (c4 - 48) }
                        k4 = k4 + 1
                    }
                    padR<String> = shv.to_string()
                    while (padR.len() < 5) { padR = "0" + padR }
                    ge.found.push(1)
                    ge.tix.push(0)
                    ge.shard.push(shv)
                    ge.off.push(ov)
                    ge.nbytes.push(lv)
                    ge.dts.push("BF16")
                    ge.paths.push(dir + "/model-" + padR + "-of-00083.safetensors")
                    j2 = j2 + 1
                }
            } else {
                ge = gx_resolve_tab(tab, dir, total, w2)
            }
            tR = time_mono_millis()
            acc_res = acc_res + (tR - tA)
            nfound = 0
            j = 0
            while (j < w2.len()) {
                if (ge.found.get(j) == 1) { nfound = nfound + 1 }
                j = j + 1
            }
            if (nfound != w2.len()) {
                return nonev
            }

            tA = time_mono_millis()
            g_ge_2 = gx_read(ge, 2)
            g_ge_1 = gx_read(ge, 1)
            g_ge_0 = gx_read(ge, 0)
            dWg<Int> = exl3_deq32f(fdeq32, fdqs, fdqs4, fhad132, fhad232, g_ge_0, g_ge_1,
                                g_ge_2, body, EINTER, 32768, hdg32, arA, arB, arC, arD, arG, arH, arI, mapdev, invbase)
            g_ge_5 = gx_read(ge, 5)
            g_ge_4 = gx_read(ge, 4)
            g_ge_3 = gx_read(ge, 3)
            dWu<Int> = exl3_deq32f(fdeq32, fdqs, fdqs4, fhad132, fhad232, g_ge_3, g_ge_4,
                                g_ge_5, body, EINTER, 32768, hdg32, arA, arB, arC, arD, arG, arH, arI, mapdev, invbase)
            g_ge_8 = gx_read(ge, 8)
            g_ge_7 = gx_read(ge, 7)
            g_ge_6 = gx_read(ge, 6)
            dWd<Int> = exl3_deq32f(fdeq32, fdqs, fdqs4, fhad132, fhad232, g_ge_6, g_ge_7,
                                g_ge_8, body, H, 32768, hdg32, arA, arB, arC, arD, arG, arH, arI, mapdev, invbase)
            acc_deq = acc_deq + (time_mono_millis() - tA)
            if (dWg == 0 || dWu == 0 || dWd == 0) {
                println("ALL_FAIL deq expert " + e.to_string())
                return nonev
            }
            devfree<Int> = 0
            devtot<Int> = 0
            freedom { cuMemGetInfo_v2(loc(devfree), loc(devtot)) }
            println("DEVMEM expert " + e.to_string() + " used=" + (devtot - devfree).to_string())

            # gather this expert's token rows
            sub<Vec<Float>> = Vec()
            j = 0
            while (j < nt) {
                tix = toks.get(j) * H
                d2 = 0
                while (d2 < H) {
                    sub.push(h2.get(tix + d2))
                    d2 = d2 + 1
                }
                j = j + 1
            }
            tA = time_mono_millis()
            var<Vec<Float>> gv = mm_host32(sub, nt, H, dWg, EINTER, fcast32, fgp, fgr, pb32)
            var<Vec<Float>> uv = mm_host32(sub, nt, H, dWu, EINTER, fcast32, fgp, fgr, pb32)
            # ---- FUSED-GATE VERIFICATION (flag-gated; the deq path stays authoritative) ----
            # P6_FUSED_GATE=1 computes the gate projection a second way -- straight from the
            # packed weights (xhatB -> mvnodB -> yhatB), never materialising f32 -- and prints
            # the difference against the deq+gemm result above. Nothing downstream uses FV.
            # Verified equal at the production shape in p6r10 (nt=4, 8192 outputs, 1.01e-06).
            fgate<String> = env_get("P6_FUSED_GATE") else "0"
            if (fgate == "1" && nt > 0) {
                fxb<Int> = load_fn("native/build/exl3mv.ptx", "xhatB")
                fyb<Int> = load_fn("native/build/exl3mv.ptx", "yhatB")
                fmb<Int> = load_fn("native/build/exl3mv.ptx", "mvnodB")
                flt<Int> = load_fn("native/build/exl3mv.ptx", "f16lut")
                if (fxb != 0 && fyb != 0 && fmb != 0 && flt != 0) {
                    dLUT<Int> = dev_alloc(262144)
                    dsu<Int> = dev_alloc(g_ge_1.len())
                    dsv<Int> = dev_alloc(g_ge_2.len())
                    dQ<Int> = dev_alloc(g_ge_0.len())
                    dsub64<Int> = dev_alloc(nt * H * 8)
                    dxf<Int> = dev_alloc(nt * H * 4)
                    dxh<Int> = dev_alloc(nt * H * 4)
                    dyr<Int> = dev_alloc(nt * EINTER * 4)
                    dyp<Int> = dev_alloc(nt * EINTER * 8)
                    if (dLUT != 0 && dsu != 0 && dsv != 0 && dQ != 0 && dsub64 != 0 && dxf != 0 && dxh != 0 && dyr != 0 && dyp != 0) {
                        # the f16 LUT the fused kernel needs (the engine builds none today)
                        wr_pdev(pb32, 0, dLUT)
                        launch_kernel(flt, 256, pb32)
                        sync()
                        cuMemcpyHtoD_v2(dsu, g_ge_1, g_ge_1.len())
                        cuMemcpyHtoD_v2(dsv, g_ge_2, g_ge_2.len())
                        # the trellis must be uploaded HERE: arA is the deq's arena and by the time
                        # this block runs (after the up and down deqs) it holds the DOWN trellis,
                        # which is why the fused pass disagreed while the deq path still worked.
                        cuMemcpyHtoD_v2(dQ, g_ge_0, g_ge_0.len())
                        bulk_htod(dsub64, view(sub))
                        sync()
                        # f64 activations -> f32
                        wr_pdev(pb32, 0, dsub64)
                        wr_pdev(pb32, 8, dxf)
                        wr_pdev(pb32, 16, nt * H)
                        launch_kernel(fcast32, (nt * H + 255) / 256, pb32)
                        sync()
                        # xhatB: +0 x, +8 out, +16 H, +24 su, +32 nin, +40 B
                        wr_pdev(pb32, 0, dxf)
                        wr_pdev(pb32, 8, dxh)
                        wr_pdev(pb32, 16, hdg32)
                        wr_pdev(pb32, 24, dsu)
                        wr_pdev(pb32, 32, H)
                        wr_pdev(pb32, 40, nt)
                        launch_kernel(fxb, nt * (H / 128), pb32)
                        sync()
                        # mvnodB: +0 T, +8 X, +24 cw, +40 q, +48 td, +56 inv, +144 LUT,
                        #         +168 B, +176 nin   (atomics, so T starts zeroed)
                        # zero T for the atomics (zero_bytes is not available in this module)
                        var<Int> zw = 0
                        while (zw < nt * EINTER * 4) { wr_pdev(dyr, zw, 0) ; zw = zw + 8 }
                        wr_pdev(pb32, 0, dyr)
                        wr_pdev(pb32, 8, dxh)
                        wr_pdev(pb32, 24, EINTER)
                        wr_pdev(pb32, 40, dQ)
                        wr_pdev(pb32, 48, mapdev)
                        wr_pdev(pb32, 56, invbase)
                        wr_pdev(pb32, 144, dLUT)
                        wr_pdev(pb32, 168, nt)
                        wr_pdev(pb32, 176, H)
                        launch_kernel(fmb, (H / 64) * (EINTER / 128) * 8, pb32)
                        sync()
                        # yhatB: +0 YR, +8 Y, +16 H, +24 cw, +32 SV, +40 B
                        wr_pdev(pb32, 0, dyr)
                        wr_pdev(pb32, 8, dyp)
                        wr_pdev(pb32, 16, hdg32)
                        wr_pdev(pb32, 24, EINTER)
                        wr_pdev(pb32, 32, dsv)
                        wr_pdev(pb32, 40, nt)
                        launch_kernel(fyb, nt * (EINTER / 128), pb32)
                        sync()
                        FV<Vec<Float>> = bulk_dtoh(dyp, nt * EINTER)
                        var<Int> nb2 = 0
                        var<Float> mx2 = 0.0
                        var<Int> zz = 0
                        while (zz < nt * EINTER) {
                            dvv<Float> = FV.get(zz) - gv.get(zz)
                            if (dvv < 0.0) { dvv = 0.0 - dvv }
                            if (dvv > 1e-4) { nb2 = nb2 + 1 }
                            if (dvv > mx2) { mx2 = dvv }
                            zz = zz + 1
                        }
                        println("FGATE expert=" + e.to_string() + " nt=" + nt.to_string() + " count_over_1e-4=" + nb2.to_string() + " max_abs=" + mx2.to_string_precise() + " of " + (nt * EINTER).to_string())
                        # ---- STEP 2: adopt the fused projection as the real result.
                        # The comparison above must pass first; FGATEFIXED=0 keeps deq authoritative.
                        ffixed<String> = env_get("P6_FUSED_USE") else "1"
                        if (ffixed == "1" && nb2 == 0) { gv = FV }
                        println("FGATEDBG h=" + hdg32.to_string() + " lut=" + dLUT.to_string() + " su=" + dsu.to_string() + " sv=" + dsv.to_string() + " su_len=" + g_ge_1.len().to_string() + " sv_len=" + g_ge_2.len().to_string())
                        println("FGATEDBG fused0=" + FV.get(0).to_string_precise() + " ref0=" + gv.get(0).to_string_precise() + " sub0=" + sub.get(0).to_string_precise())

                        # ---- DISCRIMINATOR: same chain, SYNTHETIC input (p6r10's pattern).
                        # It answered its question (round 114) and costs a whole extra fused pass
                        # plus an mm_host32, which distorts any timing measured with the flag on.
                        # Now opt-in: P6_FUSED_SYN=1.
                        synFlag<String> = env_get("P6_FUSED_SYN") else "0"
                        if (synFlag == "1") {
                        xs<Vec<Float>> = Vec()
                        var<Int> si = 0
                        while (si < nt * H) {
                            xs.push(((si % 11) as Float) * 0.0625 - 0.25)
                            si = si + 1
                        }
                        bulk_htod(dsub64, view(xs))
                        wr_pdev(pb32, 0, dsub64)
                        wr_pdev(pb32, 8, dxf)
                        wr_pdev(pb32, 16, nt * H)
                        launch_kernel(fcast32, (nt * H + 255) / 256, pb32)
                        sync()
                        wr_pdev(pb32, 0, dxf)
                        wr_pdev(pb32, 8, dxh)
                        wr_pdev(pb32, 16, hdg32)
                        wr_pdev(pb32, 24, dsu)
                        wr_pdev(pb32, 32, H)
                        wr_pdev(pb32, 40, nt)
                        launch_kernel(fxb, nt * (H / 128), pb32)
                        sync()
                        var<Int> zw2 = 0
                        while (zw2 < nt * EINTER * 4) { wr_pdev(dyr, zw2, 0) ; zw2 = zw2 + 8 }
                        wr_pdev(pb32, 0, dyr)
                        wr_pdev(pb32, 8, dxh)
                        wr_pdev(pb32, 24, EINTER)
                        wr_pdev(pb32, 40, dQ)
                        wr_pdev(pb32, 48, mapdev)
                        wr_pdev(pb32, 56, invbase)
                        wr_pdev(pb32, 144, dLUT)
                        wr_pdev(pb32, 168, nt)
                        wr_pdev(pb32, 176, H)
                        launch_kernel(fmb, (H / 64) * (EINTER / 128) * 8, pb32)
                        sync()
                        wr_pdev(pb32, 0, dyr)
                        wr_pdev(pb32, 8, dyp)
                        wr_pdev(pb32, 16, hdg32)
                        wr_pdev(pb32, 24, EINTER)
                        wr_pdev(pb32, 32, dsv)
                        wr_pdev(pb32, 40, nt)
                        launch_kernel(fyb, nt * (EINTER / 128), pb32)
                        sync()
                        FS<Vec<Float>> = bulk_dtoh(dyp, nt * EINTER)
                        RS<Vec<Float>> = mm_host32(xs, nt, H, dWg, EINTER, fcast32, fgp, fgr, pb32)
                        var<Int> nbs = 0
                        var<Float> mxs = 0.0
                        var<Int> zz2 = 0
                        while (zz2 < nt * EINTER) {
                            dvs<Float> = FS.get(zz2) - RS.get(zz2)
                            if (dvs < 0.0) { dvs = 0.0 - dvs }
                            if (dvs > 1e-4) { nbs = nbs + 1 }
                            if (dvs > mxs) { mxs = dvs }
                            zz2 = zz2 + 1
                        }
                        println("FGATESYN expert=" + e.to_string() + " nt=" + nt.to_string() + " count_over_1e-4=" + nbs.to_string() + " max_abs=" + mxs.to_string_precise() + " fused0=" + FS.get(0).to_string_precise() + " ref0=" + RS.get(0).to_string_precise())
                        }

                        # ================= UP PROJECTION (same chain, up's own tensors) =================
                        # g_ge_3/4/5 are up's trellis/suh/svh; dWu is up's dequantised weights.
                        # Its trellis goes into dQ again -- the arena lesson: never borrow arA here.
                        dQu<Int> = dev_alloc(g_ge_3.len())
                        dsuU<Int> = dev_alloc(g_ge_4.len())
                        dsvU<Int> = dev_alloc(g_ge_5.len())
                        if (dQu != 0 && dsuU != 0 && dsvU != 0) {
                            cuMemcpyHtoD_v2(dQu, g_ge_3, g_ge_3.len())
                            cuMemcpyHtoD_v2(dsuU, g_ge_4, g_ge_4.len())
                            cuMemcpyHtoD_v2(dsvU, g_ge_5, g_ge_5.len())
                            bulk_htod(dsub64, view(sub))
                            wr_pdev(pb32, 0, dsub64)
                            wr_pdev(pb32, 8, dxf)
                            wr_pdev(pb32, 16, nt * H)
                            launch_kernel(fcast32, (nt * H + 255) / 256, pb32)
                            sync()
                            wr_pdev(pb32, 0, dxf)
                            wr_pdev(pb32, 8, dxh)
                            wr_pdev(pb32, 16, hdg32)
                            wr_pdev(pb32, 24, dsuU)
                            wr_pdev(pb32, 32, H)
                            wr_pdev(pb32, 40, nt)
                            launch_kernel(fxb, nt * (H / 128), pb32)
                            sync()
                            var<Int> zwu = 0
                            while (zwu < nt * EINTER * 4) { wr_pdev(dyr, zwu, 0) ; zwu = zwu + 8 }
                            wr_pdev(pb32, 0, dyr)
                            wr_pdev(pb32, 8, dxh)
                            wr_pdev(pb32, 24, EINTER)
                            wr_pdev(pb32, 40, dQu)
                            wr_pdev(pb32, 48, mapdev)
                            wr_pdev(pb32, 56, invbase)
                            wr_pdev(pb32, 144, dLUT)
                            wr_pdev(pb32, 168, nt)
                            wr_pdev(pb32, 176, H)
                            launch_kernel(fmb, (H / 64) * (EINTER / 128) * 8, pb32)
                            sync()
                            wr_pdev(pb32, 0, dyr)
                            wr_pdev(pb32, 8, dyp)
                            wr_pdev(pb32, 16, hdg32)
                            wr_pdev(pb32, 24, EINTER)
                            wr_pdev(pb32, 32, dsvU)
                            wr_pdev(pb32, 40, nt)
                            launch_kernel(fyb, nt * (EINTER / 128), pb32)
                            sync()
                            FU2<Vec<Float>> = bulk_dtoh(dyp, nt * EINTER)
                            var<Int> nbu = 0
                            var<Float> mxu = 0.0
                            var<Int> zzu = 0
                            while (zzu < nt * EINTER) {
                                dvu<Float> = FU2.get(zzu) - uv.get(zzu)
                                if (dvu < 0.0) { dvu = 0.0 - dvu }
                                if (dvu > 1e-4) { nbu = nbu + 1 }
                                if (dvu > mxu) { mxu = dvu }
                                zzu = zzu + 1
                            }
                            println("FGATEUP expert=" + e.to_string() + " nt=" + nt.to_string() + " count_over_1e-4=" + nbu.to_string() + " max_abs=" + mxu.to_string_precise() + " of " + (nt * EINTER).to_string())
                            if (nbu == 0) { uv = FU2 }
                        }
                        free_dev(dQu)
                        free_dev(dsuU)
                        free_dev(dsvU)
                    } else {
                        println("FGATE alloc failed")
                    }
                    # free every temporary: this runs per expert, so a leak here would be fatal
                    free_dev(dLUT)
                    free_dev(dsu)
                    free_dev(dsv)
                    free_dev(dQ)
                    free_dev(dsub64)
                    free_dev(dxf)
                    free_dev(dxh)
                    free_dev(dyr)
                    free_dev(dyp)
                } else {
                    println("FGATE handles fxb=" + fxb.to_string() + " fyb=" + fyb.to_string() + " fmb=" + fmb.to_string() + " flt=" + flt.to_string())
                }
            }
            act<Vec<Float>> = Vec()
            j = 0
            while (j < gv.len()) {
                g1 = gv.get(j)
                if (g1 > SWIGLU_LIMIT) { g1 = SWIGLU_LIMIT }
                u1 = uv.get(j)
                if (u1 > SWIGLU_LIMIT) { u1 = SWIGLU_LIMIT }
                if (u1 < 0.0 - SWIGLU_LIMIT) { u1 = 0.0 - SWIGLU_LIMIT }
                act.push(silu(g1) * u1)
                j = j + 1
            }
            var<Vec<Float>> yv = mm_host32(act, nt, EINTER, dWd, H, fcast32, fgp, fgr, pb32)

            # ---- DOWN PROJECTION: reversed shape (nin=EINTER, cw=H) ----
            # Same fused chain, its own buffers and its own trellis (g_ge_6/7/8).
            fgateD<String> = env_get("P6_FUSED_GATE") else "0"
            if (fgateD == "1" && nt > 0) {
                fxbD<Int> = load_fn("native/build/exl3mv.ptx", "xhatB")
                fybD<Int> = load_fn("native/build/exl3mv.ptx", "yhatB")
                fmbD<Int> = load_fn("native/build/exl3mv.ptx", "mvnodB")
                fltD<Int> = load_fn("native/build/exl3mv.ptx", "f16lut")
                if (fxbD != 0 && fybD != 0 && fmbD != 0 && fltD != 0) {
                    dLUTD<Int> = dev_alloc(262144)
                    dQD<Int> = dev_alloc(g_ge_6.len())
                    dsuD<Int> = dev_alloc(g_ge_7.len())
                    dsvD<Int> = dev_alloc(g_ge_8.len())
                    dX64<Int> = dev_alloc(nt * EINTER * 8)
                    dXf<Int> = dev_alloc(nt * EINTER * 4)
                    dXh<Int> = dev_alloc(nt * EINTER * 4)
                    dYr<Int> = dev_alloc(nt * H * 4)
                    dYp<Int> = dev_alloc(nt * H * 8)
                    if (dLUTD != 0 && dQD != 0 && dsuD != 0 && dsvD != 0 && dX64 != 0 && dXf != 0 && dXh != 0 && dYr != 0 && dYp != 0) {
                        wr_pdev(pb32, 0, dLUTD)
                        launch_kernel(fltD, 256, pb32)
                        sync()
                        cuMemcpyHtoD_v2(dQD, g_ge_6, g_ge_6.len())
                        cuMemcpyHtoD_v2(dsuD, g_ge_7, g_ge_7.len())
                        cuMemcpyHtoD_v2(dsvD, g_ge_8, g_ge_8.len())
                        bulk_htod(dX64, view(act))
                        wr_pdev(pb32, 0, dX64)
                        wr_pdev(pb32, 8, dXf)
                        wr_pdev(pb32, 16, nt * EINTER)
                        launch_kernel(fcast32, (nt * EINTER + 255) / 256, pb32)
                        sync()
                        wr_pdev(pb32, 0, dXf)
                        wr_pdev(pb32, 8, dXh)
                        wr_pdev(pb32, 16, hdg32)
                        wr_pdev(pb32, 24, dsuD)
                        wr_pdev(pb32, 32, EINTER)
                        wr_pdev(pb32, 40, nt)
                        launch_kernel(fxbD, nt * (EINTER / 128), pb32)
                        sync()
                        var<Int> zwd = 0
                        while (zwd < nt * H * 4) { wr_pdev(dYr, zwd, 0) ; zwd = zwd + 8 }
                        wr_pdev(pb32, 0, dYr)
                        wr_pdev(pb32, 8, dXh)
                        wr_pdev(pb32, 24, H)
                        wr_pdev(pb32, 40, dQD)
                        wr_pdev(pb32, 48, mapdev)
                        wr_pdev(pb32, 56, invbase)
                        wr_pdev(pb32, 144, dLUTD)
                        wr_pdev(pb32, 168, nt)
                        wr_pdev(pb32, 176, EINTER)
                        launch_kernel(fmbD, (EINTER / 64) * (H / 128) * 8, pb32)
                        sync()
                        wr_pdev(pb32, 0, dYr)
                        wr_pdev(pb32, 8, dYp)
                        wr_pdev(pb32, 16, hdg32)
                        wr_pdev(pb32, 24, H)
                        wr_pdev(pb32, 32, dsvD)
                        wr_pdev(pb32, 40, nt)
                        launch_kernel(fybD, nt * (H / 128), pb32)
                        sync()
                        FD<Vec<Float>> = bulk_dtoh(dYp, nt * H)
                        var<Int> nbd = 0
                        var<Float> mxd = 0.0
                        var<Int> zzd = 0
                        while (zzd < nt * H) {
                            dvd<Float> = FD.get(zzd) - yv.get(zzd)
                            if (dvd < 0.0) { dvd = 0.0 - dvd }
                            if (dvd > 1e-4) { nbd = nbd + 1 }
                            if (dvd > mxd) { mxd = dvd }
                            zzd = zzd + 1
                        }
                        println("FGATEDN expert=" + e.to_string() + " nt=" + nt.to_string() + " count_over_1e-4=" + nbd.to_string() + " max_abs=" + mxd.to_string_precise() + " of " + (nt * H).to_string())
                        if (nbd == 0) { yv = FD }
                    }
                    free_dev(dLUTD)
                    free_dev(dQD)
                    free_dev(dsuD)
                    free_dev(dsvD)
                    free_dev(dX64)
                    free_dev(dXf)
                    free_dev(dXh)
                    free_dev(dYr)
                    free_dev(dYp)
                }
            }
            acc_mm = acc_mm + (time_mono_millis() - tA)
            # scatter w*y back
            j = 0
            while (j < nt) {
                tk = toks.get(j)
                wt = rwt.get(tk * ROUTE_TOPK + lanes.get(j))
                d2 = 0
                while (d2 < H) {
                    accr.set(tk * H + d2, accr.get(tk * H + d2) + wt * yv.get(j * H + d2))
                    d2 = d2 + 1
                }
                j = j + 1
            }
            freedom {
                cuMemFree_v2(dWg)
                cuMemFree_v2(dWu)
                cuMemFree_v2(dWd)
            }
            if (nex % 10 == 0) {
                println("  experts done " + nex.to_string() + " (last id " + e.to_string() + ")")
            }
        }
        e = e + 1
    }
    println("routed experts used: " + nex.to_string())
    println("T_RSLV nopen=" + nopen.to_string() + " scan=" + acc_scan.to_string() + " open=" + acc_open.to_string() +
            " lookup=" + (acc_res - acc_scan - acc_open).to_string())
    println("T_MOE layer resolve=" + acc_res.to_string() + " deq=" + acc_deq.to_string() + " mm=" + acc_mm.to_string() + " host=" + acc_host.to_string())
    freedom {
    }

    # ---- shared expert ----
    w3<Vec<String>> = Vec()
    w3.push(lpre + "mlp.shared_experts.gate_proj.weight")
    w3.push(lpre + "mlp.shared_experts.up_proj.weight")
    w3.push(lpre + "mlp.shared_experts.down_proj.weight")
    gs<GxLoc> = gx_resolve_tab(tab, dir, total, w3)
    g_gs_0 = gx_read(gs, 0)
    d_sg = deq_bf16(fbf, g_gs_0, EINTER * H, H)
    g_gs_1 = gx_read(gs, 1)
    d_su = deq_bf16(fbf, g_gs_1, EINTER * H, H)
    g_gs_2 = gx_read(gs, 2)
    d_sd = deq_bf16(fbf, g_gs_2, H * EINTER, EINTER)
    if (d_sg == 0 || d_su == 0 || d_sd == 0) { return nonev }
    sgate<Vec<Float>> = mm_host(h2, R, H, d_sg, EINTER, fgemm)
    sup<Vec<Float>> = mm_host(h2, R, H, d_su, EINTER, fgemm)
    sact<Vec<Float>> = Vec()
    i = 0
    while (i < sgate.len()) {
        g1 = sgate.get(i)
        if (g1 > SWIGLU_LIMIT) { g1 = SWIGLU_LIMIT }
        u1 = sup.get(i)
        if (u1 > SWIGLU_LIMIT) { u1 = SWIGLU_LIMIT }
        if (u1 < 0.0 - SWIGLU_LIMIT) { u1 = 0.0 - SWIGLU_LIMIT }
        sact.push(silu(g1) * u1)
        i = i + 1
    }
    shared<Vec<Float>> = mm_host(sact, R, EINTER, d_sd, H, fgemm)
    freedom {
        cuMemFree_v2(d_sg)
        cuMemFree_v2(d_su)
        cuMemFree_v2(d_sd)
    }

    mlp<Vec<Float>> = Vec()
    i = 0
    while (i < R * H) {
        mlp.push(accr.get(i) + shared.get(i))
        i = i + 1
    }


    streams2<Vec<Float>> = hc_apply(streams1, mlp, post2, comb2)
    dg33<String> = digest("mlp", mlp)
    dg34<String> = digest("streams2", streams2)
    println(dg34)
    lines = lines + dg33 + "\n" + dg34 + "\n"
    match (open_write("native/out/l3tail_vyb.txt")) {
        f -> { write_str(f, lines); close(f) }
        ? -> { }
    }

    println("T_TAIL total=" + (time_mono_millis() - tt0).to_string() +
            " (router+MoE+shared+hc_apply)")
    return streams2
}

# ============================================================ phase-2 KDA step math
# Verbatim from glm_decode_step.vyb (DEC_STEP_VYB gated): the one-token causal conv
# step and the recurrence step that takes the carried state in. Both are R-generic;
# phase 2 runs them with the global R = 1.

# ONE token through the causal k=4 depthwise conv + silu.
# x is the current token's PRE-conv vector [C]; ring is [CONV_K-1, C], oldest first.
# weight[c*CONV_K + j], j = CONV_K-1 applies to the current token (pinned by the gold).
# Returns out [C] followed by the new ring [CONV_K-1, C].
share(all)
conv1_step(x<Vec<Float>>, ring<Vec<Float>>, w<Vec<Float>>)<Vec<Float>> -> {
    res<Vec<Float>> = Vec()
    c<Int> = 0
    j<Int> = 0
    while (c < HEADS * KD) {
        acc<Float> = 0.0
        j = 0
        while (j < CONV_K) {
            src<Int> = j - (CONV_K - 1)
            xv<Float> = x.get(c)
            if (src < 0) { xv = ring.get((src + CONV_K - 1) * (HEADS * KD) + c) }
            acc = acc + xv * w.get(c * CONV_K + j)
            j = j + 1
        }
        res.push(silu(acc))
        c = c + 1
    }
    j = 1
    while (j < CONV_K) {
        c = 0
        while (c < HEADS * KD) {
            xv<Float> = x.get(c)
            if (j < CONV_K - 1) { xv = ring.get(j * (HEADS * KD) + c) }
            res.push(xv)
            c = c + 1
        }
        j = j + 1
    }
    return res
}

# the KDA delta-rule recurrence for ONE token, taking the carried state in and returning it.
# q,k,v,g [R,HEADS,KD] (R=1), beta [R,HEADS]; st0 [HEADS,KD,KD] row-major.
# Returns out [R*HEADS*KD] followed by the updated state [HEADS*KD*KD].
share(all)
delta_rule_step(q<Vec<Float>>, k<Vec<Float>>, v<Vec<Float>>, g<Vec<Float>>,
                beta<Vec<Float>>, st0<their<Vec<Float> const>>)<Vec<Float>> -> {
    out<Vec<Float>> = Vec()
    st<Vec<Float>> = Vec()
    var<Int> n = 0
    while (n < HEADS * KD * KD) {
        st.push(st0.get(n))
        n = n + 1
    }
    n = 0
    while (n < R * HEADS * KD) {
        out.push(0.0)
        n = n + 1
    }
    r<Int> = 0
    h<Int> = 0
    a<Int> = 0
    b<Int> = 0
    while (r < R) {
        h = 0
        while (h < HEADS) {
            # decay the whole state block by exp(g)
            a = 0
            while (a < KD) {
                ge<Float> = vexp(g.get((r * HEADS + h) * KD + a))
                b = 0
                while (b < KD) {
                    st.set((h * KD + a) * KD + b, st.get((h * KD + a) * KD + b) * ge)
                    b = b + 1
                }
                a = a + 1
            }
            be<Float> = beta.get(r * HEADS + h)
            # one sweep over v-channels: delta, state update, read-out (numpy's order)
            b = 0
            while (b < KD) {
                kvb<Float> = 0.0
                a = 0
                while (a < KD) {
                    kvb = kvb + st.get((h * KD + a) * KD + b) * k.get((r * HEADS + h) * KD + a)
                    a = a + 1
                }
                dl<Float> = (v.get((r * HEADS + h) * KD + b) - kvb) * be
                a = 0
                while (a < KD) {
                    st.set((h * KD + a) * KD + b,
                           st.get((h * KD + a) * KD + b) + k.get((r * HEADS + h) * KD + a) * dl)
                    a = a + 1
                }
                rd<Float> = 0.0
                a = 0
                while (a < KD) {
                    rd = rd + st.get((h * KD + a) * KD + b) * q.get((r * HEADS + h) * KD + a)
                    a = a + 1
                }
                out.set((r * HEADS + h) * KD + b, rd)
                b = b + 1
            }
            h = h + 1
        }
        r = r + 1
    }
    n = 0
    while (n < st.len()) {
        out.push(st.get(n))
        n = n + 1
    }
    return out
}

# ============================================================ phase-2 MoE tail (one token)
# tail_site's body for R = 1, with the map body passed in (no re-read per layer) and
# no file writes. Resolves the hc_ffn triple + post LN from `gt` (the caller's layer
# GxLoc, KDA-MoE want-list order), the router and shared expert by their own small
# resolves, and each USED expert lazily by 9 names (the drift-safe per-expert form).
share(all)
moe_tail_step(streams1<Vec<Float>>, lpre<String>, tab<String>, dir<String>, total<Int>, mapbody<String>,
              gt<GxLoc>, fgemm<Int>, fbf<Int>, fdeq32<Int>, fdqs<Int>, fhad132<Int>, fhad232<Int>, fcvt32<Int>, hdg32<Int>,
              arA<Int>, arB<Int>, arC<Int>, arD<Int>, arG<Int>, arH<Int>, arI<Int>, mapdev<Int>, invbase<Int>,
              fcast32<Int>, fgp<Int>, fgr<Int>, pb32<Int>)<Vec<Float>> -> {
    ms0<Int> = time_mono_millis()
    nonev<Vec<Float>> = Vec()
    best<Int> = 0
    bestv<Float> = 0.0
    cv<Float> = 0.0
    d2<Int> = 0
    d_flat2<Int> = 0
    d_mv2<Int> = 0
    d_scr2<Int> = 0
    dup<Int> = 0
    e<Int> = 0
    epre<String> = ""
    g1<Float> = 0.0
    i<Int> = 0
    j<Int> = 0
    k<Int> = 0
    lane<Int> = 0
    nex<Int> = 0
    nfound<Int> = 0
    nt<Int> = 0
    r<Int> = 0
    raw_bias<String> = ""
    sm<Float> = 0.0
    tix<Int> = 0
    tk<Int> = 0
    u1<Float> = 0.0
    wt<Float> = 0.0
    i0<Int> = 0
    d_fnF<Int> = 0
    d_ln2<Int> = 0
    body<String> = mapbody

    g_gt_17 = gx_read(gt, 17)
    d_fnF = deq_bf16(fbf, g_gt_17, 24 * HC * H, HC * H)
    if (d_fnF == 0) { return nonev }
    baseF<Vec<Float>> = Vec()
    g_gt_18 = gx_read(gt, 18)
    raw_baseF<String> = g_gt_18
    j = 0
    while (j < 24) {
        baseF.push(f32_at(raw_baseF, j))
        j = j + 1
    }
    scaleF<Vec<Float>> = Vec()
    g_gt_19 = gx_read(gt, 19)
    raw_scaleF<String> = g_gt_19
    j = 0
    while (j < 3) {
        scaleF.push(f32_at(raw_scaleF, j))
        j = j + 1
    }
    g_gt_13 = gx_read(gt, 13)
    d_ln2 = deq_bf16(fbf, g_gt_13, H, 0)
    if (d_ln2 == 0) { return nonev }
    post_ln<Vec<Float>> = bulk_dtoh(d_ln2, H)
    free_dev(d_ln2)

    flat<Vec<Float>> = rms_rows(borrow(streams1), R, HC * H, vecf())
    d_flat2 = alloc_dev(R * HC * H * 8)
    d_mv2 = alloc_dev(R * 24 * 8)
    d_scr2 = alloc_dev(64)
    if (d_flat2 == 0 || d_mv2 == 0 || d_scr2 == 0) { return nonev }
    bulk_htod(d_flat2, view(flat))
    if (gemm(fgemm, d_scr2, d_flat2, d_fnF, d_mv2, R, 24, HC * H, 1.0, 0.0) != 0) { return nonev }
    sync()
    mv2<Vec<Float>> = bulk_dtoh(d_mv2, R * 24)
    free_dev(d_flat2)
    free_dev(d_mv2)
    free_dev(d_scr2)
    free_dev(d_fnF)

    res2<Vec<Float>> = hc_glue(mv2, baseF, scaleF, streams1)
    collapsed2<Vec<Float>> = Vec()
    i = 0
    while (i < R * H) {
        collapsed2.push(res2.get(i))
        i = i + 1
    }
    post2<Vec<Float>> = Vec()
    i = 0
    while (i < R * HC) {
        post2.push(res2.get(R * H + i))
        i = i + 1
    }
    comb2<Vec<Float>> = Vec()
    i = 0
    while (i < R * HC * HC) {
        comb2.push(res2.get(R * H + R * HC + i))
        i = i + 1
    }
    h2<Vec<Float>> = rms_rows(borrow(collapsed2), R, H, post_ln)

    # ---- router (same code path as L3_MOE_ROUTE_VYB) ----
    want<Vec<String>> = Vec()
    want.push(lpre + "mlp.gate.weight")
    want.push(lpre + "mlp.gate.e_score_correction_bias")
    g<GxLoc> = gx_resolve_tab(tab, dir, total, want)
    g_g_0 = gx_read(g, 0)
    d_gw<Int> = deq_bf16(fbf, g_g_0, NE * H, H)
    if (d_gw == 0) { return nonev }
    logits<Vec<Float>> = mm_host(h2, R, H, d_gw, NE, fgemm)
    freedom {
        cuMemFree_v2(d_gw)
    }
    raw_bias = gx_read(g, 1)
    bias<Vec<Float>> = Vec()
    i = 0
    while (i < NE) {
        bias.push(f32_at(raw_bias, i))
        i = i + 1
    }
    scores<Vec<Float>> = Vec()
    i = 0
    while (i < logits.len()) {
        scores.push(sigmoid(logits.get(i)))
        i = i + 1
    }

    # top-8 per token + renormed weights
    rsel<Vec<Int>> = Vec()        # [R, 8]
    rwt<Vec<Float>> = Vec()       # [R, 8]
    i = 0
    while (i < R * ROUTE_TOPK) {
        rsel.push(-1)
        rwt.push(0.0)
        i = i + 1
    }
    r = 0
    while (r < R) {
        lane = 0
        while (lane < ROUTE_TOPK) {
            best = -1
            bestv = 0.0 - 1e30
            j = 0
            while (j < NE) {
                dup = 0
                k = 0
                while (k < lane) {
                    if (rsel.get(r * ROUTE_TOPK + k) == j) { dup = 1 }
                    k = k + 1
                }
                if (dup == 0) {
                    cv = scores.get(r * NE + j) + bias.get(j)
                    if (cv > bestv) {
                        bestv = cv
                        best = j
                    }
                }
                j = j + 1
            }
            rsel.set(r * ROUTE_TOPK + lane, best)
            lane = lane + 1
        }
        sm = 0.0
        lane = 0
        while (lane < ROUTE_TOPK) {
            sm = sm + scores.get(r * NE + rsel.get(r * ROUTE_TOPK + lane))
            lane = lane + 1
        }
        lane = 0
        while (lane < ROUTE_TOPK) {
            rwt.set(r * ROUTE_TOPK + lane,
                    scores.get(r * NE + rsel.get(r * ROUTE_TOPK + lane)) / (sm + 1e-20) * ROUTED_SCALE)
            lane = lane + 1
        }
        r = r + 1
    }

    # ---- routed experts: one dequant per (expert, projection), FFN on that expert's tokens
    accr<Vec<Float>> = Vec()
    i = 0
    while (i < R * H) {
        accr.push(0.0)
        i = i + 1
    }
    nex = 0
    msT<Int> = time_mono_millis()
    e = 0
    while (e < NE) {
        toks<Vec<Int>> = Vec()
        lanes<Vec<Int>> = Vec()
        r = 0
        while (r < R) {
            lane = 0
            while (lane < ROUTE_TOPK) {
                if (rsel.get(r * ROUTE_TOPK + lane) == e) {
                    toks.push(r)
                    lanes.push(lane)
                }
                lane = lane + 1
            }
            r = r + 1
        }
        nt = toks.len()
        if (nt > 0) {
            nex = nex + 1
            msA<Int> = time_mono_millis()
            epre = lpre + "mlp.experts." + e.to_string() + "."
            w2<Vec<String>> = Vec()
            w2.push(epre + "gate_proj.trellis")
            w2.push(epre + "gate_proj.suh")
            w2.push(epre + "gate_proj.svh")
            w2.push(epre + "up_proj.trellis")
            w2.push(epre + "up_proj.suh")
            w2.push(epre + "up_proj.svh")
            w2.push(epre + "down_proj.trellis")
            w2.push(epre + "down_proj.suh")
            w2.push(epre + "down_proj.svh")
            ge<GxLoc> = gx_resolve_tab(tab, dir, total, w2)
            nfound = 0
            j = 0
            while (j < w2.len()) {
                if (ge.found.get(j) == 1) { nfound = nfound + 1 }
                j = j + 1
            }
            if (nfound != w2.len()) { println("CHAIN_FAIL resolve expert " + e.to_string()); return nonev }

            g_ge_2 = gx_read(ge, 2)
            g_ge_1 = gx_read(ge, 1)
            g_ge_0 = gx_read(ge, 0)
            dWg<Int> = exl3_deq32(fdeq32, fdqs, fhad132, fhad232, fcvt32, g_ge_0, g_ge_1,
                                g_ge_2, body, EINTER, 32768, hdg32, arA, arB, arC, arD, arG, arH, arI, mapdev, invbase)
            g_ge_5 = gx_read(ge, 5)
            g_ge_4 = gx_read(ge, 4)
            g_ge_3 = gx_read(ge, 3)
            dWu<Int> = exl3_deq32(fdeq32, fdqs, fhad132, fhad232, fcvt32, g_ge_3, g_ge_4,
                                g_ge_5, body, EINTER, 32768, hdg32, arA, arB, arC, arD, arG, arH, arI, mapdev, invbase)
            g_ge_8 = gx_read(ge, 8)
            g_ge_7 = gx_read(ge, 7)
            g_ge_6 = gx_read(ge, 6)
            dWd<Int> = exl3_deq32(fdeq32, fdqs, fhad132, fhad232, fcvt32, g_ge_6, g_ge_7,
                                g_ge_8, body, H, 32768, hdg32, arA, arB, arC, arD, arG, arH, arI, mapdev, invbase)
            if (dWg == 0 || dWu == 0 || dWd == 0) {
                println("CHAIN_FAIL deq expert " + e.to_string())
                return nonev
            }

            sub<Vec<Float>> = Vec()
            j = 0
            while (j < nt) {
                tix = toks.get(j) * H
                d2 = 0
                while (d2 < H) {
                    sub.push(h2.get(tix + d2))
                    d2 = d2 + 1
                }
                j = j + 1
            }
            gv<Vec<Float>> = mm_host(sub, nt, H, dWg, EINTER, fgemm)
            uv<Vec<Float>> = mm_host(sub, nt, H, dWu, EINTER, fgemm)
            act<Vec<Float>> = Vec()
            j = 0
            while (j < gv.len()) {
                g1 = gv.get(j)
                if (g1 > SWIGLU_LIMIT) { g1 = SWIGLU_LIMIT }
                u1 = uv.get(j)
                if (u1 > SWIGLU_LIMIT) { u1 = SWIGLU_LIMIT }
                if (u1 < 0.0 - SWIGLU_LIMIT) { u1 = 0.0 - SWIGLU_LIMIT }
                act.push(silu(g1) * u1)
                j = j + 1
            }
            yv<Vec<Float>> = mm_host(act, nt, EINTER, dWd, H, fgemm)
            j = 0
            while (j < nt) {
                tk = toks.get(j)
                wt = rwt.get(tk * ROUTE_TOPK + lanes.get(j))
                d2 = 0
                while (d2 < H) {
                    accr.set(tk * H + d2, accr.get(tk * H + d2) + wt * yv.get(j * H + d2))
                    d2 = d2 + 1
                }
                j = j + 1
            }
            freedom {
                cuMemFree_v2(dWg)
                cuMemFree_v2(dWu)
                cuMemFree_v2(dWd)
            }
            println("SEC moexpert ms=" + (time_mono_millis() - msA).to_string() + " e=" + e.to_string())
        }
        e = e + 1
    }
    println("SEC moestage loop=" + (time_mono_millis() - msT).to_string() + " pre=" + (msT - ms0).to_string())
    msS<Int> = time_mono_millis()
    println("  routed experts used: " + nex.to_string())

    # ---- shared expert ----
    w3<Vec<String>> = Vec()
    w3.push(lpre + "mlp.shared_experts.gate_proj.weight")
    w3.push(lpre + "mlp.shared_experts.up_proj.weight")
    w3.push(lpre + "mlp.shared_experts.down_proj.weight")
    gs<GxLoc> = gx_resolve_tab(tab, dir, total, w3)
    g_gs_0 = gx_read(gs, 0)
    d_sg<Int> = deq_bf16(fbf, g_gs_0, EINTER * H, H)
    g_gs_1 = gx_read(gs, 1)
    d_su<Int> = deq_bf16(fbf, g_gs_1, EINTER * H, H)
    g_gs_2 = gx_read(gs, 2)
    d_sd<Int> = deq_bf16(fbf, g_gs_2, H * EINTER, EINTER)
    if (d_sg == 0 || d_su == 0 || d_sd == 0) { return nonev }
    sgate<Vec<Float>> = mm_host(h2, R, H, d_sg, EINTER, fgemm)
    sup<Vec<Float>> = mm_host(h2, R, H, d_su, EINTER, fgemm)
    sact<Vec<Float>> = Vec()
    i = 0
    while (i < sgate.len()) {
        g1 = sgate.get(i)
        if (g1 > SWIGLU_LIMIT) { g1 = SWIGLU_LIMIT }
        u1 = sup.get(i)
        if (u1 > SWIGLU_LIMIT) { u1 = SWIGLU_LIMIT }
        if (u1 < 0.0 - SWIGLU_LIMIT) { u1 = 0.0 - SWIGLU_LIMIT }
        sact.push(silu(g1) * u1)
        i = i + 1
    }
    shared<Vec<Float>> = mm_host(sact, R, EINTER, d_sd, H, fgemm)
    freedom {
        cuMemFree_v2(d_sg)
        cuMemFree_v2(d_su)
        cuMemFree_v2(d_sd)
    }

    mlp<Vec<Float>> = Vec()
    i = 0
    while (i < R * H) {
        mlp.push(accr.get(i) + shared.get(i))
        i = i + 1
    }

    streams2<Vec<Float>> = hc_apply(streams1, mlp, post2, comb2)
    println("SEC moestage share=" + (time_mono_millis() - msS).to_string())
    return streams2
}

# ============================================================ MTP head (layer 45)
# The MTP input row: trunk final norm (model.language_model.norm.weight) applied to the
# mean over the 4 layer-44 streams, then hnorm; e = enorm(embed(tid)); concat
# [enorm(emb), hnorm(h)] (EMBEDDING FIRST -- pinned from the shipped exllamav3
# Qwen3_5MTPInputLayer forward) -> eh_proj (BF16 [4096, 8192] out-in) -> [H].
# hnorm/enorm are PLAIN RMSNorms (scale = x_norm * w): the shipped GLM-5.3 MTP passes
# constant_bias=0.0 (architecture/glm5_next_mtp.py), overriding the rmsnorm.py default
# of 1.0 the older handoff note quoted.
share(all)
mtp_build_row(tvec<Vec<Float>>, raw_e<String>, tab<String>, dir<String>, total<Int>,
              fgemm<Int>, fbf<Int>)<Vec<Float>> -> {
    i<Int> = 0
    nf<Int> = 0
    wantM<Vec<String>> = Vec()
    wantM.push("model.language_model.norm.weight")
    wantM.push("model.language_model.layers.45.hnorm.weight")
    wantM.push("model.language_model.layers.45.enorm.weight")
    wantM.push("model.language_model.layers.45.eh_proj.weight")
    gm<GxLoc> = gx_resolve_tab(tab, dir, total, wantM)
    nf = 0
    i = 0
    while (i < 4) {
        if (gm.found.get(i) == 1) { nf = nf + 1 }
        i = i + 1
    }
    if (nf != 4) { println("CHAIN_FAIL mtp resolve input"); return vecf() }
    g_gm_0 = gx_read(gm, 0)
    d_tn<Int> = deq_bf16(fbf, g_gm_0, H, 0)
    g_gm_1 = gx_read(gm, 1)
    d_hn<Int> = deq_bf16(fbf, g_gm_1, H, 0)
    g_gm_2 = gx_read(gm, 2)
    d_en<Int> = deq_bf16(fbf, g_gm_2, H, 0)
    g_gm_3 = gx_read(gm, 3)
    d_eh<Int> = deq_bf16(fbf, g_gm_3, H * 2 * H, 2 * H)
    if (d_tn == 0 || d_hn == 0 || d_en == 0 || d_eh == 0) {
        println("CHAIN_FAIL mtp deq input")
        return vecf()
    }
    tn_w<Vec<Float>> = bulk_dtoh(d_tn, H)
    hn_w<Vec<Float>> = bulk_dtoh(d_hn, H)
    en_w<Vec<Float>> = bulk_dtoh(d_en, H)
    free_dev(d_tn)
    free_dev(d_hn)
    free_dev(d_en)
    d_ex<Int> = deq_bf16(fbf, raw_e, H, 0)
    if (d_ex == 0) { println("CHAIN_FAIL mtp emb deq"); return vecf() }
    ev<Vec<Float>> = bulk_dtoh(d_ex, H)
    free_dev(d_ex)
    hn1<Vec<Float>> = rms_rows(borrow(tvec), 1, H, tn_w)     # trunk final norm over the mean
    hp<Vec<Float>> = rms_rows(borrow(hn1), 1, H, hn_w)       # hnorm (plain scale)
    en<Vec<Float>> = rms_rows(borrow(ev), 1, H, en_w)        # enorm(embed) (plain scale)
    cat<Vec<Float>> = vecf()
    i = 0
    while (i < H) { cat.push(en.get(i)); i = i + 1 }
    i = 0
    while (i < H) { cat.push(hp.get(i)); i = i + 1 }
    hin<Vec<Float>> = mm_host(cat, 1, 2 * H, d_eh, H, fgemm)
    free_dev(d_eh)
    return hin
}

# Layer 45 as a PLAIN residual block (no hyper-connections), one token: input_layernorm
# -> DSA attention (no rope, own ckv/indexer-k/gsc cache appended at `row`) -> residual
# -> post_attention_layernorm -> dots-router MoE (sigmoid + noaux_tc bias, top-8,
# renorm * 2.5, lazy per-expert EXL3 resolve) -> residual. Returns the post-block hidden.
share(all)
mtp_stage_deqs(lpre<String>, tab<String>, dir<String>, total<Int>, fbf<Int>)<Vec<Int>> -> {
    novec<Vec<Int>> = Vec()
    wantL45<Vec<String>> = Vec()
    wantL45.push(lpre + "input_layernorm.weight")
    wantL45.push(lpre + "post_attention_layernorm.weight")
    wantL45.push(lpre + "self_attn.q_a_proj.weight")
    wantL45.push(lpre + "self_attn.q_a_layernorm.weight")
    wantL45.push(lpre + "self_attn.q_b_proj.weight")
    wantL45.push(lpre + "self_attn.kv_a_proj_with_mqa.weight")
    wantL45.push(lpre + "self_attn.kv_a_layernorm.weight")
    wantL45.push(lpre + "self_attn.kv_b_proj.weight")
    wantL45.push(lpre + "self_attn.o_proj.weight")
    wantL45.push(lpre + "self_attn.indexer.wq_b.weight")
    wantL45.push(lpre + "self_attn.indexer.wk.weight")
    wantL45.push(lpre + "self_attn.indexer.k_norm.weight")
    wantL45.push(lpre + "self_attn.indexer.k_norm.bias")
    wantL45.push(lpre + "self_attn.indexer.weights_proj.weight")
    wantL45.push(lpre + "self_attn.indexer.index_kpool_compress_ape")
    wantL45.push(lpre + "self_attn.indexer.index_kpool_compress_gate")
    wantL45.push(lpre + "mlp.gate.weight")
    wantL45.push(lpre + "mlp.gate.e_score_correction_bias")
    wantL45.push(lpre + "mlp.shared_experts.gate_proj.weight")
    wantL45.push(lpre + "mlp.shared_experts.up_proj.weight")
    wantL45.push(lpre + "mlp.shared_experts.down_proj.weight")
    gm45<GxLoc> = gx_resolve_tab(tab, dir, total, wantL45)
    nf<Int> = 0
    i<Int> = 0
    while (i < wantL45.len()) {
        if (gm45.found.get(i) == 1) { nf = nf + 1 }
        i = i + 1
    }
    if (nf != wantL45.len()) { println("CHAIN_FAIL mtp stage resolve"); return novec }
    g<String> = ""
    s0<Int> = 0
    s1<Int> = 0
    s2<Int> = 0
    s3<Int> = 0
    s4<Int> = 0
    s5<Int> = 0
    s6<Int> = 0
    s7<Int> = 0
    s8<Int> = 0
    s9<Int> = 0
    s10<Int> = 0
    s11<Int> = 0
    s12<Int> = 0
    s13<Int> = 0
    s14<Int> = 0
    s15<Int> = 0
    s16<Int> = 0
    s17<Int> = 0
    s18<Int> = 0
    g = gx_read(gm45, 0); s0 = deq_bf16(fbf, g, H, 0)
    g = gx_read(gm45, 1); s1 = deq_bf16(fbf, g, H, 0)
    g = gx_read(gm45, 2); s2 = deq_bf16(fbf, g, Q_LORA * H, H)
    g = gx_read(gm45, 3); s3 = deq_bf16(fbf, g, Q_LORA, 0)
    g = gx_read(gm45, 4); s4 = deq_bf16(fbf, g, HEADS * NOPE * Q_LORA, Q_LORA)
    g = gx_read(gm45, 5); s5 = deq_bf16(fbf, g, KV_LORA * H, H)
    g = gx_read(gm45, 6); s6 = deq_bf16(fbf, g, KV_LORA, 0)
    g = gx_read(gm45, 7); s7 = deq_bf16(fbf, g, HEADS * (NOPE + VDIM) * KV_LORA, 0)
    g = gx_read(gm45, 8); s8 = deq_bf16(fbf, g, HEADS * VDIM * H, HEADS * VDIM)
    g = gx_read(gm45, 9); s9 = deq_bf16(fbf, g, Q_LORA * IHEADS * IDIM, Q_LORA)
    g = gx_read(gm45, 10); s10 = deq_bf16(fbf, g, H * IDIM, H)
    g = gx_read(gm45, 11); s11 = deq_bf16(fbf, g, IDIM, 0)
    g = gx_read(gm45, 12); s12 = deq_bf16(fbf, g, IDIM, 0)
    g = gx_read(gm45, 13); s13 = deq_bf16(fbf, g, H * IHEADS, H)
    g = gx_read(gm45, 15); s14 = deq_bf16(fbf, g, H * IDIM, H)
    g = gx_read(gm45, 16); s15 = deq_bf16(fbf, g, 384 * H, H)
    g = gx_read(gm45, 18); s16 = deq_bf16(fbf, g, EINTER * H, H)
    g = gx_read(gm45, 19); s17 = deq_bf16(fbf, g, EINTER * H, H)
    g = gx_read(gm45, 20); s18 = deq_bf16(fbf, g, H * EINTER, EINTER)
    if (s0 == 0 || s1 == 0 || s2 == 0 || s3 == 0 || s4 == 0 || s5 == 0 || s6 == 0 ||
        s7 == 0 || s8 == 0 || s9 == 0 || s10 == 0 || s11 == 0 || s12 == 0 || s13 == 0 ||
        s14 == 0 || s15 == 0 || s16 == 0 || s17 == 0 || s18 == 0) {
        println("CHAIN_FAIL mtp stage deq")
        return novec
    }
    out<Vec<Int>> = Vec()
    out.push(s0); out.push(s1); out.push(s2); out.push(s3); out.push(s4)
    out.push(s5); out.push(s6); out.push(s7); out.push(s8); out.push(s9)
    out.push(s10); out.push(s11); out.push(s12); out.push(s13); out.push(s14)
    out.push(s15); out.push(s16); out.push(s17); out.push(s18)
    return out
}
share(all)
mtp_layer_step(hin<Vec<Float>>, row<Int>, lpre<String>, tab<String>, dir<String>, total<Int>,
               mapbody<String>, mckv<their<Vec<Float>>>,
               mik<their<Vec<Float>>>, migsc<their<Vec<Float>>>, dw<Vec<Int>>, fgemm<Int>, fbf<Int>,
               fdeq32<Int>, fdqs<Int>, fhad132<Int>, fhad232<Int>, fcvt32<Int>, hdg32<Int>,
               arA<Int>, arB<Int>, arC<Int>, arD<Int>, arG<Int>, arH<Int>, arI<Int>, mapdev<Int>, invbase<Int>,
               fcast32<Int>, fgp<Int>, fgr<Int>, pb32<Int>)<Vec<Float>> -> {
    nonev<Vec<Float>> = vecf()
    i<Int> = 0
    j<Int> = 0
    k<Int> = 0
    nf<Int> = 0
    nfound<Int> = 0
    d2<Int> = 0
    hh<Int> = 0
    p<Int> = 0
    c<Int> = 0
    a<Int> = 0
    e<Int> = 0
    lane<Int> = 0
    r<Int> = 0
    best<Int> = 0
    bestv<Float> = 0.0
    bestp<Int> = 0
    last<Int> = 0
    used<Int> = 0
    mx<Float> = 0.0
    sm<Float> = 0.0
    acc<Float> = 0.0
    pr<Float> = 0.0
    dot<Float> = 0.0
    rl<Float> = 0.0
    sc<Float> = 0.0
    sv<Float> = 0.0
    g1<Float> = 0.0
    u1<Float> = 0.0
    wt<Float> = 0.0
    cv<Float> = 0.0
    tk<Int> = 0
    nt<Int> = 0
    nex<Int> = 0
    nckv<Int> = 0
    npools<Int> = 0
    select_k<Int> = 0
    tstart<Int> = 0
    tcount<Int> = 0
    vcount<Int> = 0
    i0<Int> = 0
    epre<String> = ""
    body<String> = mapbody
    scale_iq<Float> = 1.0 / vsqrt(IDIM as Float, 40)
    sc_scale<Float> = 1.0 / vsqrt(NOPE as Float, 40)
    wscale<Float> = 1.0 / vsqrt(IHEADS as Float, 40)

    wantL45<Vec<String>> = Vec()
    wantL45.push(lpre + "input_layernorm.weight")
    wantL45.push(lpre + "post_attention_layernorm.weight")
    wantL45.push(lpre + "self_attn.q_a_proj.weight")
    wantL45.push(lpre + "self_attn.q_a_layernorm.weight")
    wantL45.push(lpre + "self_attn.q_b_proj.weight")
    wantL45.push(lpre + "self_attn.kv_a_proj_with_mqa.weight")
    wantL45.push(lpre + "self_attn.kv_a_layernorm.weight")
    wantL45.push(lpre + "self_attn.kv_b_proj.weight")
    wantL45.push(lpre + "self_attn.o_proj.weight")
    wantL45.push(lpre + "self_attn.indexer.wq_b.weight")
    wantL45.push(lpre + "self_attn.indexer.wk.weight")
    wantL45.push(lpre + "self_attn.indexer.k_norm.weight")
    wantL45.push(lpre + "self_attn.indexer.k_norm.bias")
    wantL45.push(lpre + "self_attn.indexer.weights_proj.weight")
    wantL45.push(lpre + "self_attn.indexer.index_kpool_compress_ape")
    wantL45.push(lpre + "self_attn.indexer.index_kpool_compress_gate")
    wantL45.push(lpre + "mlp.gate.weight")
    wantL45.push(lpre + "mlp.gate.e_score_correction_bias")
    wantL45.push(lpre + "mlp.shared_experts.gate_proj.weight")
    wantL45.push(lpre + "mlp.shared_experts.up_proj.weight")
    wantL45.push(lpre + "mlp.shared_experts.down_proj.weight")
    gm45<GxLoc> = gx_resolve_tab(tab, dir, total, wantL45)
    nf = 0
    i = 0
    while (i < wantL45.len()) {
        if (gm45.found.get(i) == 1) { nf = nf + 1 }
        i = i + 1
    }
    if (nf != wantL45.len()) { println("CHAIN_FAIL mtp resolve layer"); return nonev }

    d_ln<Int> = dw.get(0)
    d_ln2<Int> = dw.get(1)
    d_qa<Int> = dw.get(2)
    d_qaln<Int> = dw.get(3)
    d_qb<Int> = dw.get(4)
    d_kva<Int> = dw.get(5)
    d_kvaln<Int> = dw.get(6)
    d_kvb<Int> = dw.get(7)
    d_o<Int> = dw.get(8)
    d_wqb<Int> = dw.get(9)
    d_wk<Int> = dw.get(10)
    d_knw<Int> = dw.get(11)
    d_knb<Int> = dw.get(12)
    d_wproj<Int> = dw.get(13)
    d_gatei<Int> = dw.get(14)
    d_gw<Int> = dw.get(15)
    if (d_ln == 0 || d_ln2 == 0 || d_qa == 0 || d_qb == 0 || d_kva == 0 || d_kvb == 0 ||
        d_o == 0 || d_wqb == 0 || d_wk == 0 || d_wproj == 0 || d_gatei == 0 || d_gw == 0 ||
        d_qaln == 0 || d_kvaln == 0 || d_knw == 0 || d_knb == 0) {
        println("CHAIN_FAIL mtp staged weights")
        return nonev
    }
    in_ln<Vec<Float>> = bulk_dtoh(d_ln, H)
    post_ln<Vec<Float>> = bulk_dtoh(d_ln2, H)
    qaln_w<Vec<Float>> = bulk_dtoh(d_qaln, Q_LORA)
    kvaln_w<Vec<Float>> = bulk_dtoh(d_kvaln, KV_LORA)
    knw<Vec<Float>> = bulk_dtoh(d_knw, IDIM)
    knb<Vec<Float>> = bulk_dtoh(d_knb, IDIM)
    ape<Vec<Float>> = Vec()
    g_gm45_14 = gx_read(gm45, 14)
    raw_ape<String> = g_gm45_14
    i = 0
    while (i < KPOOL * IDIM) { ape.push(f32_at(raw_ape, i)); i = i + 1 }
    g_gm45_17 = gx_read(gm45, 17)
    raw_bias<String> = g_gm45_17
    bias<Vec<Float>> = Vec()
    i = 0
    while (i < NE) { bias.push(f32_at(raw_bias, i)); i = i + 1 }

    # absorbed per-head keys/values from kv_b (same as the trunk DSA step)
    kvb<Vec<Float>> = bulk_dtoh(d_kvb, HEADS * (NOPE + VDIM) * KV_LORA)
    ukm<Vec<Float>> = Vec()
    uvm<Vec<Float>> = Vec()
    d2 = 0
    while (d2 < KV_LORA * HEADS * NOPE) {
        ukm.push(0.0)
        uvm.push(0.0)
        d2 = d2 + 1
    }
    hh = 0
    while (hh < HEADS) {
        j = 0
        while (j < NOPE) {
            d2 = 0
            while (d2 < KV_LORA) {
                ukm.set(d2 * (HEADS * NOPE) + hh * NOPE + j,
                        kvb.get((hh * (NOPE + VDIM) + j) * KV_LORA + d2))
                uvm.set(d2 * (HEADS * VDIM) + hh * VDIM + j,
                        kvb.get((hh * (NOPE + VDIM) + NOPE + j) * KV_LORA + d2))
                d2 = d2 + 1
            }
            j = j + 1
        }
        hh = hh + 1
    }
    d_ukm<Int> = alloc_dev(KV_LORA * HEADS * NOPE * 8)
    d_uvm<Int> = alloc_dev(KV_LORA * HEADS * VDIM * 8)
    if (d_ukm == 0 || d_uvm == 0) { return nonev }
    bulk_htod(d_ukm, view(ukm))
    bulk_htod(d_uvm, view(uvm))

    # ---- input_layernorm (no hc: consumes the eh_proj output directly)
    h_a<Vec<Float>> = rms_rows(borrow(hin), 1, H, in_ln)

    # ---- latent projections; append this row to the MTP caches
    qres<Vec<Float>> = mm_host(h_a, 1, H, d_qa, Q_LORA, fgemm)
    qa_ln<Vec<Float>> = rms_rows(borrow(qres), 1, Q_LORA, qaln_w)
    qfull<Vec<Float>> = mm_host(qa_ln, 1, Q_LORA, d_qb, HEADS * NOPE, fgemm)
    ckraw<Vec<Float>> = mm_host(h_a, 1, H, d_kva, KV_LORA, fgemm)
    ckv_new<Vec<Float>> = rms_rows(borrow(ckraw), 1, KV_LORA, kvaln_w)
    nckv = row
    i = 0
    while (i < KV_LORA) {
        mckv.set(nckv * KV_LORA + i, ckv_new.get(i))
        i = i + 1
    }
    qidx<Vec<Float>> = mm_host(qres, 1, Q_LORA, d_wqb, IHEADS * IDIM, fgemm)
    kraw<Vec<Float>> = mm_host(h_a, 1, H, d_wk, IDIM, fgemm)
    k_new<Vec<Float>> = ln_rows(borrow(kraw), 1, IDIM, knw, knb)
    i = 0
    while (i < IDIM) {
        mik.set(nckv * IDIM + i, k_new.get(i))
        i = i + 1
    }
    gsc_new<Vec<Float>> = mm_host(h_a, 1, H, d_gatei, IDIM, fgemm)
    i = 0
    while (i < IDIM) {
        migsc.set(nckv * IDIM + i, gsc_new.get(i))
        i = i + 1
    }
    wproj<Vec<Float>> = mm_host(h_a, 1, H, d_wproj, IHEADS, fgemm)
    i = 0
    while (i < wproj.len()) {
        wproj.set(i, wproj.get(i) * wscale)
        i = i + 1
    }
    nckv = nckv + 1

    # ---- indexer: pool + topk over the cache (per-channel softmax over the 4 slots)
    ckv_t<Vec<Float>> = Vec()
    ik_t<Vec<Float>> = Vec()
    gsc_t<Vec<Float>> = Vec()
    i = 0
    while (i < nckv * KV_LORA) { ckv_t.push(mckv.get(i)); i = i + 1 }
    i = 0
    while (i < nckv * IDIM) {
        ik_t.push(mik.get(i))
        gsc_t.push(migsc.get(i))
        i = i + 1
    }
    npools = nckv / KPOOL
    poolk<Vec<Float>> = Vec()
    d2 = 0
    while (d2 < npools * IDIM) { poolk.push(0.0); d2 = d2 + 1 }
    p = 0
    while (p < npools) {
        c = 0
        while (c < IDIM) {
            mx = 0.0 - 1e30
            a = 0
            while (a < KPOOL) {
                lgf<Float> = gsc_t.get((p * KPOOL + a) * IDIM + c) + ape.get(a * IDIM + c)
                if (lgf > mx) { mx = lgf }
                a = a + 1
            }
            sm = 0.0
            a = 0
            while (a < KPOOL) {
                sm = sm + vexp(gsc_t.get((p * KPOOL + a) * IDIM + c) + ape.get(a * IDIM + c) - mx)
                a = a + 1
            }
            acc = 0.0
            a = 0
            while (a < KPOOL) {
                pr = vexp(gsc_t.get((p * KPOOL + a) * IDIM + c) + ape.get(a * IDIM + c) - mx) / sm
                acc = acc + pr * ik_t.get((p * KPOOL + a) * IDIM + c)
                a = a + 1
            }
            poolk.set(p * IDIM + c, acc)
            c = c + 1
        }
        p = p + 1
    }
    isc<Vec<Float>> = Vec()
    d2 = 0
    while (d2 < npools) { isc.push(0.0); d2 = d2 + 1 }
    p = 0
    while (p < npools) {
        acc = 0.0
        hh = 0
        while (hh < IHEADS) {
            dot = 0.0
            c = 0
            while (c < IDIM) {
                dot = dot + qidx.get(hh * IDIM + c) * poolk.get(p * IDIM + c)
                c = c + 1
            }
            rl = dot * scale_iq
            if (rl < 0.0) { rl = 0.0 }
            acc = acc + wproj.get(hh) * rl
            hh = hh + 1
        }
        isc.set(p, acc)
        p = p + 1
    }
    sel<Vec<Int>> = Vec()
    d2 = 0
    while (d2 < nckv) { sel.push(-1); d2 = d2 + 1 }
    select_k = TOPK / KPOOL
    if (select_k > npools) { select_k = npools }
    taken<Vec<Int>> = Vec()
    k = 0
    while (k < select_k) {
        bestp = -1
        bestv = 0.0 - 1e30
        p = 0
        while (p < npools) {
            last = p * KPOOL + KPOOL - 1
            used = 0
            j = 0
            while (j < taken.len()) {
                if (taken.get(j) == p) { used = 1 }
                j = j + 1
            }
            if (last <= nckv - 1 && used == 0) {
                sc = isc.get(p)
                if (sc > bestv) { bestv = sc; bestp = p }
            }
            p = p + 1
        }
        if (bestp < 0) { k = select_k } else {
            taken.push(bestp)
            a = 0
            while (a < KPOOL) {
                sel.set(bestp * KPOOL + a, bestp * KPOOL + a)
                a = a + 1
            }
            k = k + 1
        }
    }
    vcount = nckv
    tcount = vcount % KPOOL
    tstart = vcount - tcount
    a = 0
    while (a < tcount) {
        sel.set(tstart + a, tstart + a)
        a = a + 1
    }

    # ---- masked MLA over the selected cache rows
    Kv<Vec<Float>> = mm_host(ckv_t, nckv, KV_LORA, d_ukm, HEADS * NOPE, fgemm)
    Vm<Vec<Float>> = mm_host(ckv_t, nckv, KV_LORA, d_uvm, HEADS * VDIM, fgemm)
    probs<Vec<Float>> = Vec()
    d2 = 0
    while (d2 < HEADS * nckv) { probs.push(0.0); d2 = d2 + 1 }
    hh = 0
    while (hh < HEADS) {
        mx = 0.0 - 1e30
        i = 0
        while (i < nckv) {
            if (sel.get(i) >= 0) {
                dot = 0.0
                c = 0
                while (c < NOPE) {
                    dot = dot + qfull.get(hh * NOPE + c) * Kv.get((i * HEADS + hh) * NOPE + c)
                    c = c + 1
                }
                sv = dot * sc_scale
                if (sv > mx) { mx = sv }
            }
            i = i + 1
        }
        sm = 0.0
        i = 0
        while (i < nckv) {
            if (sel.get(i) >= 0) {
                dot = 0.0
                c = 0
                while (c < NOPE) {
                    dot = dot + qfull.get(hh * NOPE + c) * Kv.get((i * HEADS + hh) * NOPE + c)
                    c = c + 1
                }
                sm = sm + vexp(dot * sc_scale - mx)
            }
            i = i + 1
        }
        i = 0
        while (i < nckv) {
            if (sel.get(i) >= 0) {
                dot = 0.0
                c = 0
                while (c < NOPE) {
                    dot = dot + qfull.get(hh * NOPE + c) * Kv.get((i * HEADS + hh) * NOPE + c)
                    c = c + 1
                }
                probs.set(hh * nckv + i, vexp(dot * sc_scale - mx) / sm)
            }
            i = i + 1
        }
        hh = hh + 1
    }
    ao<Vec<Float>> = Vec()
    d2 = 0
    while (d2 < HEADS * VDIM) { ao.push(0.0); d2 = d2 + 1 }
    hh = 0
    while (hh < HEADS) {
        c = 0
        while (c < VDIM) {
            acc = 0.0
            i = 0
            while (i < nckv) {
                pv<Float> = probs.get(hh * nckv + i)
                if (pv != 0.0) {
                    acc = acc + pv * Vm.get((i * HEADS + hh) * VDIM + c)
                }
                i = i + 1
            }
            ao.set(hh * VDIM + c, acc)
            c = c + 1
        }
        hh = hh + 1
    }
    attn45<Vec<Float>> = mm_host(ao, 1, HEADS * VDIM, d_o, H, fgemm)
    free_dev(d_ukm)
    free_dev(d_uvm)

    # ---- plain residual, post_attention_layernorm
    x1<Vec<Float>> = vecf()
    i = 0
    while (i < H) { x1.push(hin.get(i) + attn45.get(i)); i = i + 1 }
    h2<Vec<Float>> = rms_rows(borrow(x1), 1, H, post_ln)

    # ---- router: sigmoid + noaux_tc bias + top-8 + renorm * 2.5
    logits45<Vec<Float>> = mm_host(h2, 1, H, d_gw, 384, fgemm)
    scores45<Vec<Float>> = Vec()
    i = 0
    while (i < logits45.len()) {
        scores45.push(sigmoid(logits45.get(i)))
        i = i + 1
    }
    rsel<Vec<Int>> = Vec()
    rwt<Vec<Float>> = Vec()
    i = 0
    while (i < ROUTE_TOPK) { rsel.push(-1); rwt.push(0.0); i = i + 1 }
    lane = 0
    while (lane < ROUTE_TOPK) {
        best = -1
        bestv = 0.0 - 1e30
        j = 0
        while (j < NE) {
            used = 0
            k = 0
            while (k < lane) {
                if (rsel.get(k) == j) { used = 1 }
                k = k + 1
            }
            if (used == 0) {
                cv = scores45.get(j) + bias.get(j)
                if (cv > bestv) { bestv = cv; best = j }
            }
            j = j + 1
        }
        rsel.set(lane, best)
        lane = lane + 1
    }
    sm = 0.0
    lane = 0
    while (lane < ROUTE_TOPK) {
        sm = sm + scores45.get(rsel.get(lane))
        lane = lane + 1
    }
    lane = 0
    while (lane < ROUTE_TOPK) {
        rwt.set(lane, scores45.get(rsel.get(lane)) / (sm + 1e-20) * ROUTED_SCALE)
        lane = lane + 1
    }

    # ---- routed experts: lazy per-expert resolve (9 names), EXL3 deq
    accr<Vec<Float>> = Vec()
    i = 0
    while (i < H) { accr.push(0.0); i = i + 1 }
    nex = 0
    e = 0
    while (e < NE) {
        nt = 0
        lane = 0
        while (lane < ROUTE_TOPK) {
            if (rsel.get(lane) == e) { nt = 1 }
            lane = lane + 1
        }
        if (nt == 1) {
            nex = nex + 1
            epre = lpre + "mlp.experts." + e.to_string() + "."
            w2<Vec<String>> = Vec()
            w2.push(epre + "gate_proj.trellis")
            w2.push(epre + "gate_proj.suh")
            w2.push(epre + "gate_proj.svh")
            w2.push(epre + "up_proj.trellis")
            w2.push(epre + "up_proj.suh")
            w2.push(epre + "up_proj.svh")
            w2.push(epre + "down_proj.trellis")
            w2.push(epre + "down_proj.suh")
            w2.push(epre + "down_proj.svh")
            gexp<GxLoc> = gx_resolve_tab(tab, dir, total, w2)
            nfound = 0
            j = 0
            while (j < 9) {
                if (gexp.found.get(j) == 1) { nfound = nfound + 1 }
                j = j + 1
            }
            if (nfound != 9) {
                println("CHAIN_FAIL mtp resolve expert " + e.to_string())
                return nonev
            }
            g_gexp_2 = gx_read(gexp, 2)
            g_gexp_1 = gx_read(gexp, 1)
            g_gexp_0 = gx_read(gexp, 0)
            dWg<Int> = exl3_deq32(fdeq32, fdqs, fhad132, fhad232, fcvt32, g_gexp_0,
                                g_gexp_1, g_gexp_2, body,
                                EINTER, 32768, hdg32, arA, arB, arC, arD, arG, arH, arI, mapdev, invbase)
            g_gexp_5 = gx_read(gexp, 5)
            g_gexp_4 = gx_read(gexp, 4)
            g_gexp_3 = gx_read(gexp, 3)
            dWu<Int> = exl3_deq32(fdeq32, fdqs, fhad132, fhad232, fcvt32, g_gexp_3,
                                g_gexp_4, g_gexp_5, body,
                                EINTER, 32768, hdg32, arA, arB, arC, arD, arG, arH, arI, mapdev, invbase)
            g_gexp_8 = gx_read(gexp, 8)
            g_gexp_7 = gx_read(gexp, 7)
            g_gexp_6 = gx_read(gexp, 6)
            dWd<Int> = exl3_deq32(fdeq32, fdqs, fhad132, fhad232, fcvt32, g_gexp_6,
                                g_gexp_7, g_gexp_8, body,
                                H, 32768, hdg32, arA, arB, arC, arD, arG, arH, arI, mapdev, invbase)
            if (dWg == 0 || dWu == 0 || dWd == 0) {
                println("CHAIN_FAIL mtp deq expert " + e.to_string())
                return nonev
            }
            gv<Vec<Float>> = mm_host(h2, 1, H, dWg, EINTER, fgemm)
            uv45<Vec<Float>> = mm_host(h2, 1, H, dWu, EINTER, fgemm)
            act45<Vec<Float>> = Vec()
            j = 0
            while (j < gv.len()) {
                g1 = gv.get(j)
                if (g1 > SWIGLU_LIMIT) { g1 = SWIGLU_LIMIT }
                u1 = uv45.get(j)
                if (u1 > SWIGLU_LIMIT) { u1 = SWIGLU_LIMIT }
                if (u1 < 0.0 - SWIGLU_LIMIT) { u1 = 0.0 - SWIGLU_LIMIT }
                act45.push(silu(g1) * u1)
                j = j + 1
            }
            yv<Vec<Float>> = mm_host(act45, 1, EINTER, dWd, H, fgemm)
            wt = 0.0
            lane = 0
            while (lane < ROUTE_TOPK) {
                if (rsel.get(lane) == e) { wt = rwt.get(lane) }
                lane = lane + 1
            }
            i = 0
            while (i < H) {
                accr.set(i, accr.get(i) + wt * yv.get(i))
                i = i + 1
            }
            freedom {
                cuMemFree_v2(dWg)
                cuMemFree_v2(dWu)
                cuMemFree_v2(dWd)
            }
        }
        e = e + 1
    }

    # ---- shared expert
    d_sg<Int> = dw.get(16)
    d_su<Int> = dw.get(17)
    d_sd<Int> = dw.get(18)
    if (d_sg == 0 || d_su == 0 || d_sd == 0) { return nonev }
    sgate<Vec<Float>> = mm_host(h2, 1, H, d_sg, EINTER, fgemm)
    sup<Vec<Float>> = mm_host(h2, 1, H, d_su, EINTER, fgemm)
    sact<Vec<Float>> = Vec()
    i = 0
    while (i < sgate.len()) {
        g1 = sgate.get(i)
        if (g1 > SWIGLU_LIMIT) { g1 = SWIGLU_LIMIT }
        u1 = sup.get(i)
        if (u1 > SWIGLU_LIMIT) { u1 = SWIGLU_LIMIT }
        if (u1 < 0.0 - SWIGLU_LIMIT) { u1 = 0.0 - SWIGLU_LIMIT }
        sact.push(silu(g1) * u1)
        i = i + 1
    }
    shared45<Vec<Float>> = mm_host(sact, 1, EINTER, d_sd, H, fgemm)

    mlp45<Vec<Float>> = vecf()
    i = 0
    while (i < H) { mlp45.push(accr.get(i) + shared45.get(i)); i = i + 1 }
    x2<Vec<Float>> = vecf()
    i = 0
    while (i < H) { x2.push(x1.get(i) + mlp45.get(i)); i = i + 1 }
    return x2
}

# ============================================================ main
# ---- the module-scope state: the weights, the handles, the caches, the config.
# The Vec state (the caches) is owned by the caller's scope (glm_serve's main /
# the chain's main) — only the scalars live here; the Vec module globals hit a
# type-inference gap in the current semantic (the member calls on the module
# Vec globals cannot be typed), so the Vecs stay in the caller. ----
