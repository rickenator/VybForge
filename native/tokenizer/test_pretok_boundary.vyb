# test_pretok_boundary.vyb — Qwen2 pre-tokenizer boundary fidelity, self-contained.
#
# Regression test for the bug class that P2.1b surfaced: the pre-tokenizer classified
# the remapped CR/LF/TAB byte-chars as letters, so "):\n" segmented as [")", ":", "\n"]
# instead of the single Qwen piece "):\n". The BPE merge `):` + `\n` -> `):\n` (id 982)
# was then unreachable and the full-manifest context came out 430 tokens against the
# oracle's 429 — one token, invisible unless you diff the whole id list.
#
# The existing corpus oracle (native/train/verify_encode_corpus.py) samples four records
# and happened not to contain such a boundary, so it stayed green through the bug. These
# cases pin the boundaries directly. Expectations are the ids from
#   AutoTokenizer.from_pretrained("artifacts/vybos-configurator-lora").encode(s, add_special_tokens=False)
# (transformers 5.17.0), captured 2026-10-02; the last four are real manifest lines.
#
# Run: "$VYB" native/tokenizer/test_pretok_boundary.vyb --module-path native/tokenizer
import collections
import tokenizer::{build_vocab, build_merges, encode_with, space_char}

fmt(ids<Vec<Int>>)<String> -> {
    out<String> = ""
    k<Int> = 0
    for (k in 0..ids.len() - 1) {
        if (k > 0) { out = out + "," }
        out = out + ids.get(k).to_string()
    }
    return out
}

main()<Int> -> {
    vocab<HashMap<String, Int>> = build_vocab()
    merges<HashMap<String, Int>> = build_merges()
    sp<String> = space_char()
    cases<Vec<String>> = Vec<String>()
    want<Vec<String>> = Vec<String>()
    cases.push("hello world")
    want.push("14990,1879")
    cases.push("):\n")
    want.push("982")
    cases.push("abc\n")
    want.push("13683,198")
    cases.push("\n")
    want.push("198")
    cases.push("\n\n")
    want.push("271")
    cases.push("\n-")
    want.push("198,12")
    cases.push("):\n\n")
    want.push("7731")
    cases.push(" x):\n")
    want.push("856,982")
    cases.push("42\n")
    want.push("19,17,198")
    cases.push("\n42")
    want.push("198,19,17")
    cases.push("):")
    want.push("1648")
    cases.push(":\n")
    want.push("510")
    cases.push("end.\n")
    want.push("408,624")
    cases.push("\ta\n")
    want.push("11323,198")
    cases.push("a\r\n")
    want.push("64,319")
    cases.push("\na\r")
    want.push("198,64,201")
    cases.push("You are the VybOS configuration interviewer. Return exactly one JSON object with kind, message, missing_fields.")
    want.push("2610,525,279,647,84307,3126,6546,86835,13,3411,6896,825,4718,1633,448,3093,11,1943,11,7402,12132,13")
    cases.push("current):\n- Targets proven to boot to READY: x86_64 container rootfs via bwrap (unprivileged), docker, and x86_64 QEMU kernel+initramfs self-boot (TCG, virtual/virtio-gpu; forked Alpine netboot vmlinuz-virt kernel cached locally). ARM64 and RISC-V are NOT proven; mark as open decisions.")
    want.push("3231,982,12,84947,16622,311,10459,311,85332,25,856,23,21,62,21,19,5476,3704,3848,4566,293,10097,320,359,97288,701,26588,11,323,856,23,21,62,21,19,1207,83606,10001,10,2327,2396,3848,656,88289,320,7749,38,11,4108,5457,2106,815,2371,5584,26,22435,291,81713,4179,4619,348,40926,5197,8273,2106,10001,20579,23490,568,30486,21,19,323,431,27629,19625,525,4183,16622,26,1868,438,1787,11181,13")
    cases.push(" \"OPEN DECISIONS (do not fabricate): graphical desktop stack (Hyprland/Wayland/mesa) is NOT a derived capability; ARM64/RISC-V toolchain+rootfs; systemd vs busybox init unification; full reproducible byte-for-byte store.\"")
    want.push("330,30933,42817,24211,50,320,2982,537,13055,349,1648,53143,17505,5611,320,30816,649,1933,22175,352,1933,3183,22371,8,374,4183,264,14257,22302,26,30486,21,19,19382,27629,19625,5392,8819,10,2888,3848,26,74966,6165,13028,2011,2930,650,2404,26,2480,52723,78285,4922,15193,53952,3553,1189")
    cases.push("a   b")
    want.push("64,256,293")
    cases.push("ab ")
    want.push("370,220")
    cases.push("- Linux kernel: 6.6 bzImage (out-of-tree build), kernel source pinned, modules/initramfs strategy configurable.\n")
    want.push("12,14340,10001,25,220,21,13,21,80167,1906,320,411,8668,40438,1936,701,10001,2530,47709,11,13454,42948,2396,3848,8282,43394,624")
    bad<Int> = 0
    k<Int> = 0
    for (k in 0..cases.len() - 1) {
        got<String> = fmt(encode_with(vocab, merges, sp, cases.get(k)))
        if (got != want.get(k)) {
            bad = bad + 1
            println("FAIL " + k.to_string() + " " + cases.get(k))
            println("  want [" + want.get(k) + "] got [" + got + "]")
        }
    }
    if (bad == 0) { println("PRETOK BOUNDARY: PASS (" + cases.len().to_string() + " cases)") }
    else { println("PRETOK BOUNDARY: FAIL (" + bad.to_string() + " of " + cases.len().to_string() + ")") }
    return 0
}
