# Delta (a): the param's source is itself a call-result clone.
acc(v<Vec<Float>>)<String> -> {
    s<Float> = 0.0
    a<Float> = 0.0
    q<Float> = 0.0
    m<Float> = 0.0
    j<Int> = 0
    while (j < v.len()) {
        x<Float> = v.get(j)
        s = s + x * x
        ax<Float> = x
        if (x < 0.0) { ax = 0.0 - x }
        a = a + ax
        q = q + x * x * x * x
        if (x > m) { m = x }
        if (j < 8) { println("BODY j=" + j.to_string() + " x=" + x.to_string()) }
        j = j + 1
    }
    hv<Int> = 0
    h<Float> = 0.0
    while (hv < 8) {
        if (hv < v.len()) { h = v.get(hv) }
        hv = hv + 1
    }
    return "census s=" + s.to_string() + " a=" + a.to_string() + " m=" + m.to_string() + " h=" + h.to_string()
}
makev()<Vec<Float>> -> {
    r<Vec<Float>> = Vec()
    i<Int> = 0
    while (i < 90112) {
        r.push(1.0)
        i = i + 1
    }
    return r
}
main()<Int> -> {
    v<Vec<Float>> = makev()
    println(acc(v))
    println(acc(v))
    return 0
}
