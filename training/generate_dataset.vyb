# Emits deterministic chat-format JSONL training data for the VybOS
# configurator. It contains no private host state and no model-generated text.
# stdout only: redirect it to data/vybos-configurator-{train,eval}.jsonl.
#
# Proposed changes are REAL SystemSpec operations a deterministic VybOS applier
# can merge onto config/default-state.json:
#   system  -> replace "x86_64-linux" | "aarch64-linux"
#   hostname-> replace <string>
#   pkgs    -> add {name,version,source} | remove {name}
#   services-> add {name,command}        | remove {name}

json_escape(value<String>)<String> -> {
    out<String> = value.replace("\\", "\\\\")
    out = out.replace("\"", "\\\"")
    out = out.replace("\n", "\\n")
    out = out.replace("\r", "\\r")
    return out.replace("\t", "\\t")
}

record(id<Int>, split<String>, topic<String>, user<String>, answer<String>)<String> -> {
    system<String> = "You are the VybOS configuration interviewer. Return exactly one JSON object with kind, message, missing_fields, proposed_changes, and requires_confirmation. VybOS builds a machine from a minimal SystemSpec: system, hostname, pkgs, services. A default baseline is in config/default-state.json. Each proposed_changes item is {path, op, value, reason}; paths are system|hostname|pkgs|services and values must be schema-conformant so a deterministic applier can merge them. Distinguish implemented capabilities from plans; never claim host changes were applied."
    return "{\"messages\":[{\"role\":\"system\",\"content\":\"" + json_escape(system) + "\"},{\"role\":\"user\",\"content\":\"" + json_escape(user) + "\"},{\"role\":\"assistant\",\"content\":\"" + json_escape(answer) + "\"}],\"metadata\":{\"id\":\"vybos-" + id.to_string() + "\",\"split\":\"" + split + "\",\"topic\":\"" + topic + "\",\"source\":\"VybOS STATUS snapshot 2026-08-26\"}}"
}

question(message<String>, missing<String>)<String> -> {
    return "{\"kind\":\"question\",\"message\":\"" + json_escape(message) + "\",\"missing_fields\":[\"" + json_escape(missing) + "\"],\"proposed_changes\":[],\"requires_confirmation\":false}"
}

summary(message<String>)<String> -> {
    return "{\"kind\":\"summary\",\"message\":\"" + json_escape(message) + "\",\"missing_fields\":[],\"proposed_changes\":[],\"requires_confirmation\":false}"
}

proposal(op<String>, path<String>, value_js<String>, reason<String>)<String> -> {
    return "{\"kind\":\"proposal\",\"message\":\"This is a desired-state proposal only; it will not build or apply anything.\",\"missing_fields\":[],\"proposed_changes\":[{\"path\":\"" + json_escape(path) + "\",\"op\":\"" + op + "\",\"value\":" + value_js + ",\"reason\":\"" + json_escape(reason) + "\"}],\"requires_confirmation\":true}"
}

target_for(n<Int>)<String> -> {
    k<Int> = n % 6
    if (k == 0) { return "a disposable container rootfs for CI" }
    if (k == 1) { return "a QEMU x86_64 boot test" }
    if (k == 2) { return "an x86_64 development VM" }
    if (k == 3) { return "an ARM64 appliance image" }
    if (k == 4) { return "a reproducible server image" }
    return "a rescue image with a serial console"
}

pkg_json(n<Int>)<String> -> {
    k<Int> = n % 6
    if (k == 0) { return "{\"name\":\"openssh\",\"version\":\"9.9p1\",\"source\":\"upstream\"}" }
    if (k == 1) { return "{\"name\":\"vim\",\"version\":\"9.1\",\"source\":\"upstream\"}" }
    if (k == 2) { return "{\"name\":\"nginx\",\"version\":\"1.26.2\",\"source\":\"upstream\"}" }
    if (k == 3) { return "{\"name\":\"busybox\",\"version\":\"1.37.0\",\"source\":\"upstream\"}" }
    if (k == 4) { return "{\"name\":\"linux\",\"version\":\"6.12.0\",\"source\":\"cdn.kernel.org\"}" }
    return "{\"name\":\"qemu\",\"version\":\"9.1.0\",\"source\":\"upstream\"}"
}

svc_json(n<Int>)<String> -> {
    k<Int> = n % 3
    if (k == 0) { return "{\"name\":\"sshd\",\"command\":\"/usr/sbin/sshd -D\"}" }
    if (k == 1) { return "{\"name\":\"nginx\",\"command\":\"nginx -g daemon off;\"}" }
    return "{\"name\":\"getty\",\"command\":\"getty 0 tty1\"}"
}

main()<Int> -> {
    i<Int> = 0
    while (i < 240) {
        split<String> = if (i % 10 == 0) { "eval" } else { "train" }
        target<String> = target_for(i)
        variant<Int> = i % 8
        user<String> = ""
        answer<String> = ""
        topic<String> = ""

        if (variant == 0) {
            topic = "interview"
            user = "I want " + target + ". What should we decide first?"
            answer = question("Which architecture and boot/runtime target must this configuration support? Existing VybOS proofs cover disposable rootfs and x86_64 QEMU; ARM64 needs an explicit decision.", "system")
        } else if (variant == 1) {
            topic = "packages"
            user = "Add a package to " + target + "."
            answer = proposal("add", "pkgs", pkg_json(i / 6), "Adding a package changes the desired closure and must be confirmed before deterministic planning.")
        } else if (variant == 2) {
            topic = "current-capability"
            user = "Can VybOS already build a kernel and boot it in QEMU?"
            answer = summary("Yes. Current VybOS status records a derived Linux kernel and a derived QEMU runtime that boot a rootfs to VYBOS_READY. This is a reproducible proof path, not authorization to modify the host.")
        } else if (variant == 3) {
            topic = "hostname"
            user = "Name this " + target + " host."
            answer = proposal("replace", "hostname", "\"vyb-appliance\"", "Hostname is part of the machine identity in the SystemSpec.")
        } else if (variant == 4) {
            topic = "safety"
            user = "Apply this configuration to the current machine now."
            answer = summary("I can draft and validate a desired state, but I will not apply it to a host. First choose the target, review the transition plan, and authorize a separate execution step.")
        } else if (variant == 5) {
            topic = "services"
            user = "Enable a service on " + target + "."
            answer = proposal("add", "services", svc_json(i / 6), "Enabling a service changes what runs and must be confirmed before deterministic planning.")
        } else if (variant == 6) {
            topic = "architecture"
            user = "Make this target an ARM64 image instead of x86_64."
            answer = proposal("replace", "system", "\"aarch64-linux\"", "Architecture is a SystemSpec field; changing it selects a different toolchain and kernel target.")
        } else {
            topic = "removal"
            user = "I no longer need interactive console access on " + target + "."
            answer = proposal("remove", "services", "{\"name\":\"getty\"}", "Removing a service from the desired state reduces the enabled service set.")
        }
        println(record(i, split, topic, user, answer))
        i += 1
    }
    return 0
}
