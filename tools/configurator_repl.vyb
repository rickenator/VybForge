# configurator_repl.vyb — interactive VybOS configurator REPL (P1.5 port of
# tools/configurator_repl.py).
#
# Type a VybOS goal; the served configurator model replies with the configurator
# JSON (question / proposal / summary). /quit exits. Nothing is ever applied.
#
# Python original: loaded base + LoRA adapter with torch on the 3090 and ran the
# interview loop locally. The Vyb port runs the same loop against a served model
# (same backend set as the other drivers) — no torch, no GPU-side Python.
#
# Vyb's JIT surface has no argv: flags are env vars (Python flag in parentheses):
#   VYBFORGE_BACKEND (ollama)  VYBFORGE_ENDPOINT (http://127.0.0.1:11434)
#   VYBFORGE_MODEL (qwen3:8b)  VYBFORGE_API_KEY / VYBFORGE_API_KEY_ENV
#   VYBFORGE_STRUCTURED_OUTPUT (json_schema|json_object|prompt)
#   VYBFORGE_RESPONSE_SCHEMA (config/agent-response.schema.json)
#   VYBFORGE_MAX_TOKENS (512, informational: the served model owns generation)
#
# stdout carries one JSON contract per answer; the banner, "config> " prompt and
# diagnostics go to stderr (src/main.vyb's rule).
#
# Run from the repo root:
#   $VYB tools/configurator_repl.vyb --module-path tools --module-path native/json

import env::{env_get}
import io::{open_read, read_all, close}
import term::{stdin_read_line, eprint, eprintln, flush}
import json_parse::{json_parse}
import reply_parse::{reply_text}
import chat_request::{post_chat, api_key_from_env}
import http_client::{PostResp}
import json_util::{json_compact}

read_file(path<String>)<String> -> {
    match (open_read(path)) {
        f -> { match (read_all(f)) { t -> { close(f); return t } ? -> { close(f); return "" } } }
        ? -> { return "" }
    }
}

# System prompt — verbatim from tools/configurator_repl.py.
system_prompt()<String> -> {
    return "You are the VybOS configuration interviewer. Return exactly one JSON object with kind, " +
           "message, missing_fields, proposed_changes, and requires_confirmation. VybOS builds a " +
           "machine from a minimal SystemSpec: system, hostname, pkgs, services. Each proposed_changes " +
           "item is {path, op, value, reason}. paths are system|hostname|pkgs|services. " +
           "hostname/system use op replace with a plain string value; pkgs add has value " +
           "{\"name\":..,\"version\":..,\"source\":..}; services add has value {\"name\":..,\"command\":..}. " +
           "Emit only valid JSON."
}

main() -> {
    backend<String> = env_get("VYBFORGE_BACKEND") else "ollama"
    endpoint<String> = env_get("VYBFORGE_ENDPOINT") else "http://127.0.0.1:11434"
    model<String> = env_get("VYBFORGE_MODEL") else "qwen3:8b"
    mode<String> = env_get("VYBFORGE_STRUCTURED_OUTPUT") else "json_schema"
    key_env<String> = env_get("VYBFORGE_API_KEY_ENV") else ""
    schema_path<String> = env_get("VYBFORGE_RESPONSE_SCHEMA") else "config/agent-response.schema.json"

    schema_text<String> = read_file(schema_path)
    if (schema_text.len() == 0) { eprintln("cannot read response schema " + schema_path); return }
    api_key<String> = api_key_from_env(key_env)

    eprintln("configurator REPL using " + backend + " / " + model + " (schema " + schema_path + "). /quit exits; no changes are applied.")
    while (true) {
        eprint("config> ")
        flush()
        raw_line<String> = stdin_read_line()
        line<String> = raw_line.trim()
        if (line.len() == 0 || line == "/quit") { eprintln(""); return }
        roles<Vec<String>> = Vec<String>()
        contents<Vec<String>> = Vec<String>()
        roles.push("system")
        contents.push(system_prompt())
        roles.push("user")
        contents.push(line)
        pr<PostResp> = post_chat(backend, endpoint, model, mode, json_compact(schema_text), roles, contents, api_key)
        if (pr.status != 200) {
            eprintln("backend error: HTTP " + pr.status.to_string() + " from " + backend + ": " + pr.body)
            return
        }
        answer<String> = reply_text(backend, pr.body)
        if (answer.len() == 0) {
            eprintln("backend error: " + backend + " reply carried no content")
            return
        }
        match (json_parse(answer)) {
            d -> { println(json_compact(answer)) }
            ? -> { println("RAW (not valid JSON): " + answer) }
        }
        println("")
    }
}
