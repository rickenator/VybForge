# propose_repair.vyb — VybForge adaptive-repair proposal driver (#7 model boundary).
#
# Vyb-native port of tools/propose_repair.py: backend-neutral shell around the
# repair-proposal pathway (mock / ollama / openai-chat / openai-responses)
# returning a single schema-constrained PatchProposal that the deterministic
# Vyb repair core (VybOS modules/repair.vyb) applies/validates/seals.
#
# The deterministic `mock` backend (no CPU/GPU model) renders a fixed,
# well-formed proposal so the FULL boundary is provable end-to-end on any
# machine; a real deployment picks a live backend.
#
# Vyb's JIT surface has no argv: all flags are env vars (same VYBFORGE_* names
# as the Python driver; defaults in parentheses):
#   VYBFORGE_BACKEND (mock)  VYBFORGE_ENDPOINT (http://127.0.0.1:11434)
#   VYBFORGE_MODEL (qwen3:8b)  VYBFORGE_API_KEY ()  VYBFORGE_STRUCTURED_OUTPUT (json_schema)
#   VYBFORGE_SCHEMA (config/repair-proposal.schema.json)
#   VYBFORGE_PROMPT (prompts/repair.md)  VYBFORGE_PRISTINE ()
#   VYBFORGE_REASON (deterministic mock repair)  VYBFORGE_DIFF ()
#   VYBFORGE_CLS (generated)  VYBFORGE_GENERATOR (mock)
#   VYBFORGE_FROM_FILE ()  VYBFORGE_OUT (out/proposal.json)
# Run from the repo root:
#   VYBFORGE_PRISTINE=... VYBFORGE_REASON=... $VYB tools/propose_repair.vyb --module-path tools --module-path native/json

import env::{env_get}
import io::{open_read, read_all, open_write, write_str, close}
import term::{eprintln}
import json_parse::{json_parse}
import reply_parse::{reply_text}
import json_util::{json_escape}
import http_client::{PostResp, http_post}

read_file(path<String>)<String> -> {
    match (open_read(path)) {
        f -> { match (read_all(f)) { t -> { close(f); return t } ? -> { close(f); return "" } } }
        ? -> { return "" }
    }
}

write_file(path<String>, data<String>)<Int> -> {
    match (open_write(path)) {
        w -> { match (write_str(w, data)) { q -> { close(w); return 0 } ? -> { close(w); return 1 } } }
        ? -> { return 1 }
    }
}

# Split on "\n" (no trailing empty piece).
split_lines(s<String>)<Vec<String>> -> {
    out<Vec<String>> = Vec<String>()
    start<Int> = 0
    n<Int> = s.len()
    while (start < n) {
        tail<String> = s.substring(start, n)
        q<Int> = tail.index_of("\n")
        if (q < 0) {
            out.push(s.substring(start, n))
            start = n
        } else {
            out.push(s.substring(start, start + q))
            start = start + q + 1
        }
    }
    return out
}

rstrip_newlines(s<String>)<String> -> {
    t<String> = s
    while (t.len() > 0 && (t.char_at(t.len() - 1) as Int) == 10) { t = t.substring(0, t.len() - 1) }
    return t
}

str_in(list<Vec<String>>, needle<String>)<Bool> -> {
    i<Int> = 0
    for (i in 0..list.len() - 1) { if (list.get(i) == needle) { return true } }
    return false
}

count_of(haystack<String>, needle<String>)<Int> -> {
    c<Int> = 0
    pos<Int> = 0
    n<Int> = haystack.len()
    m<Int> = needle.len()
    while (pos + m <= n) {
        if (haystack.substring(pos, pos + m) == needle) { c = c + 1; pos = pos + m } else { pos = pos + 1 }
    }
    return c
}


main()<Int> -> {
    backend<String> = env_get("VYBFORGE_BACKEND") else "mock"
    endpoint<String> = env_get("VYBFORGE_ENDPOINT") else "http://127.0.0.1:11434"
    model<String> = env_get("VYBFORGE_MODEL") else "qwen3:8b"
    api_key<String> = env_get("VYBFORGE_API_KEY") else ""
    structured<String> = env_get("VYBFORGE_STRUCTURED_OUTPUT") else "json_schema"
    schema_path<String> = env_get("VYBFORGE_SCHEMA") else "config/repair-proposal.schema.json"
    prompt_path<String> = env_get("VYBFORGE_PROMPT") else "prompts/repair.md"
    pristine<String> = env_get("VYBFORGE_PRISTINE") else ""
    reason<String> = env_get("VYBFORGE_REASON") else "deterministic mock repair"
    diff_arg<String> = env_get("VYBFORGE_DIFF") else ""
    cls<String> = env_get("VYBFORGE_CLS") else "generated"
    generator<String> = env_get("VYBFORGE_GENERATOR") else "mock"
    from_file<String> = env_get("VYBFORGE_FROM_FILE") else ""
    out_path<String> = env_get("VYBFORGE_OUT") else "out/proposal.json"

    # --from-file: re-emit a pre-written proposal (validated shape).
    if (from_file.len() > 0) {
        data<String> = read_file(from_file)
        if (data.len() == 0) { eprintln("cannot read " + from_file); return 2 }
        if (write_file(out_path, data) != 0) { eprintln("cannot write " + out_path); return 1 }
        println("re-emitted proposal from " + from_file + " (validated shape)")
    } else if (backend == "mock") {
        # Deterministic, GPU-free proposal: use --diff verbatim, else replace the
        # exact line containing `a - b` with its `a + b` twin.
        diff<String> = ""
        if (diff_arg.len() > 0) {
            diff = diff_arg.replace("\\n", "\n")
        } else {
            ptxt<String> = read_file(pristine)
            if (ptxt.len() == 0) { eprintln("cannot read pristine " + pristine); return 2 }
            plines<Vec<String>> = split_lines(rstrip_newlines(ptxt))
            old<String> = ""
            i<Int> = 0
            for (i in 0..plines.len() - 1) {
                if (plines.get(i).index_of("a - b") >= 0) { old = plines.get(i); break }
            }
            corrected<String> = ""
            if (old.len() > 0) {
                corrected = old.replace("a - b", "a + b")
            } else {
                if (plines.len() == 0) { eprintln("pristine is empty"); return 2 }
                old = plines.get(plines.len() - 1)
                corrected = old + "  // repaired"
            }
            diff = "-" + old + "\n+" + corrected
        }
        # matched: every `-` line must exist verbatim in the pristine source.
        full<String> = read_file(pristine)
        full_lines<Vec<String>> = split_lines(full)
        matched<Bool> = true
        dl<Vec<String>> = split_lines(diff)
        i2<Int> = 0
        for (i2 in 0..dl.len() - 1) {
            ln<String> = dl.get(i2)
            if (ln.starts_with("-") && ln.len() > 1) {
                if (!str_in(full_lines, ln.substring(1, ln.len()))) { matched = false }
            }
        }
        # Canonical shape (matches json.dumps(indent=2, sort_keys=True)).
        matched_str<String> = "false"
        if (matched) { matched_str = "true" }
        proposal<String> = "{\n  \"cls\": \"" + json_escape(cls) + "\",\n  \"diff\": \"" + json_escape(diff) +
                           "\",\n  \"generator\": \"" + json_escape(generator) + "\",\n  \"matched\": " +
                           matched_str + ",\n  \"reason\": \"" + json_escape(reason) + "\"\n}\n"
        if (write_file(out_path, proposal) != 0) { eprintln("cannot write " + out_path); return 1 }
        println("mock (deterministic, no model) proposal built")
    } else {
        # Live backend: build the messages, POST, extract the content JSON.
        system_prompt<String> = read_file(prompt_path)
        if (system_prompt.len() == 0) { eprintln("cannot read prompt " + prompt_path); return 2 }
        schema_text<String> = read_file(schema_path)
        if (schema_text.len() == 0) { eprintln("cannot read schema " + schema_path); return 2 }
        context<String> = "Constraint schema:\n" + schema_text +
                          "\n\nPristine source to repair:\n" + read_file(pristine) +
                          "\n\nBuild/test failure:\n" + reason
        msgs<String> = "[{\"role\":\"system\",\"content\":\"" + json_escape(system_prompt) +
                       "\"},{\"role\":\"user\",\"content\":\"" + json_escape(context) + "\"}]"
        headers<Vec<String>> = Vec<String>()
        headers.push("Content-Type: application/json")
        if (api_key.len() > 0) { headers.push("Authorization: Bearer " + api_key) }

        path<String> = ""
        body<String> = ""
        if (backend == "ollama") {
            path = "/api/chat"
            body = "{\"model\":\"" + json_escape(model) + "\",\"messages\":" + msgs +
                   ",\"stream\":false,\"format\":" + schema_text + ",\"options\":{\"temperature\":0.2}}"
        } else if (backend == "openai-chat") {
            path = "/chat/completions"
            body = "{\"model\":\"" + json_escape(model) + "\",\"messages\":" + msgs + ",\"temperature\":0.2"
            if (structured == "json_object") {
                body = body + ",\"response_format\":{\"type\":\"json_object\"}"
            } else if (structured == "json_schema") {
                body = body + ",\"response_format\":{\"type\":\"json_schema\",\"json_schema\":" +
                        "{\"name\":\"vybforge_proposal\",\"strict\":true,\"schema\":" + schema_text + "}}"
            }
            body = body + "}"
        } else if (backend == "openai-responses") {
            path = "/responses"
            transcript<String> = "SYSTEM:\n" + system_prompt + "\n\nUSER:\n" + context
            body = "{\"model\":\"" + json_escape(model) + "\",\"input\":\"" + json_escape(transcript) +
                   "\",\"store\":false,\"temperature\":0.2"
            if (structured == "json_object") {
                body = body + ",\"text\":{\"format\":{\"type\":\"json_object\"}}"
            } else if (structured == "json_schema") {
                body = body + ",\"text\":{\"format\":{\"type\":\"json_schema\",\"name\":\"vybforge_proposal\"," +
                        "\"strict\":true,\"schema\":" + schema_text + "}}"
            }
            body = body + "}"
        } else {
            eprintln("unknown backend: " + backend)
            return 2
        }

        pr<PostResp> = http_post(endpoint, path, headers, body)
        if (pr.status != 200) {
            eprintln("HTTP " + pr.status.to_string() + " from " + backend + ": " + pr.body)
            return 1
        }
        content<String> = reply_text(backend, pr.body)
        if (content.len() == 0) {
            eprintln("no proposal content in " + backend + " response")
            return 1
        }
        dbg<String> = env_get("VYBFORGE_DEBUG") else ""
        if (dbg.len() > 0) {
            # debug hook: dump the raw response envelope + the extracted content
            write_file(dbg + ".raw.json", pr.body)
            write_file(dbg + ".content.txt", content)
        }
        match (json_parse(content)) {
            d -> { }
            ? -> { eprintln("model returned invalid proposal JSON"); return 1 }
        }
        if (write_file(out_path, content + "\n") != 0) { eprintln("cannot write " + out_path); return 1 }
        println(backend + "/" + model + " proposal received")
    }

    # Report in a model-agnostic one-liner (parse the written proposal).
    cls_out<String> = ""
    matched_out<String> = ""
    diff_out<String> = ""
    pdata<String> = read_file(out_path)
    match (json_parse(pdata)) {
        d -> {
            n1<Int> = d.get(d.root, "cls")
            if (n1 >= 0) { cls_out = d.hstr(n1) }
            n2<Int> = d.get(d.root, "matched")
            if (n2 >= 0) {
                if (d.hstr(n2) == "true") { matched_out = "True" } else { matched_out = "False" }
            }
            n3<Int> = d.get(d.root, "diff")
            if (n3 >= 0) { diff_out = d.hstr(n3) }
        }
        ? -> { }
    }
    println("proposal → " + out_path + " cls=" + cls_out + " matched=" + matched_out +
            " diff_lines=" + (count_of(diff_out, "\n") + 1).to_string())
    return 0
}
